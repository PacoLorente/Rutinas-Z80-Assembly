 431+ C18C              ;   -------------------------------------------------------------------------------------------
 432+ C18C              ;
 433+ C18C              ;   23/9/26
 434+ C18C              ;
 435+ C18C              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C18C              ;
 437+ C18C              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C18C              ;   _ [Sound_Generator].
 439+ C18C              ;
 440+ C18C              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C18C              ;
 442+ C18C              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C18C              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C18C              ;
 445+ C18C              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C18C              ;
 447+ C18C              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C18C              ;
 449+ C18C              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C18C
 451+ C18C              Play_burst_sound_effect:
 452+ C18C
 453+ C18C              ;   Exclusiones:
 454+ C18C
 455+ C18C 3A BC 94         ld a,(Burst_sound)
 456+ C18F A7               and a
 457+ C190 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C191
 459+ C191 08               ex af,af
 460+ C192
 461+ C192 3A 8D 94         ld a,(Ctrl_6)
 462+ C195 CB 47            bit 0,a
 463+ C197 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C198
 465+ C198              ;   ----------------------
 466+ C198
 467+ C198 CB C7            set 0,a
 468+ C19A 32 8D 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C19D
 470+ C19D 08               ex af,af                ; Restore (Burst_sound).
 471+ C19E
 472+ C19E 67               ld h,a
 473+ C19F 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1A1
 475+ C1A1 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1A2
 477+ C1A2 22 B6 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1A5 0E 03            ld c,3
