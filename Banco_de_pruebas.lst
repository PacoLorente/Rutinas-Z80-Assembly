 537  94C6 00           Cola_de_desplazamiento db 0									; Este byte indica:
 538  94C7
 539  94C7              ;
 540  94C7              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 541  94C7              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 542  94C7              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 543  94C7              ;
 544  94C7              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 545  94C7              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 546  94C7              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 547  94C7              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 548  94C7              ;
 549  94C7              ;															;	"$ff" ..... Bucle infinito de repetición.
 550  94C7              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 551  94C7              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
