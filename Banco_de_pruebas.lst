   5+ 93E1              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93E1              ;   (XOR) bit a bit.
   7+ 93E1              ;
   8+ 93E1              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93E1
  10+ 93E1              Derivando_RND
  11+ 93E1
  12+ 93E1 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93E4
  14+ 93E4 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93E6 C5               push bc
  16+ 93E7              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93E7 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 93EA              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 93EA
  20+ 93EA A7           6 and a                                 ; Carry a "0".
  21+ 93EB CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 93ED 30 02            jr nc,1F
  23+ 93EF
  24+ 93EF CB C1            set 0,c
  25+ 93F1
  26+ 93F1 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 93F2 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 93F4 5F               ld e,a
  29+ 93F5
  30+ 93F5 7A               ld a,d
  31+ 93F6 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 93F8 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 93FA
  34+ 93FA CB 3F            srl a
  35+ 93FC
  36+ 93FC AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 93FD
  38+ 93FD 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 93FE 28 04            jr z,4F
  40+ 9400
  41+ 9400 CB FF            set 7,a
  42+ 9402 18 02            jr 5F
  43+ 9404
  44+ 9404 CB BF        4 res 7,a
  45+ 9406
  46+ 9406 CB 21        5 sla c
  47+ 9408 10 E0            djnz 6B
  48+ 940A
  49+ 940A 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 940B
  51+ 940B 77               ld (hl),a
  52+ 940C 23               inc hl
  53+ 940D C1               pop bc
  54+ 940E 10 D4            djnz 3B
