  22+ 9ECF
  23+ 9ECF CB C1            set 0,c
  24+ 9ED1
  25+ 9ED1 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9ED2 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9ED4 5F               ld e,a
  28+ 9ED5
  29+ 9ED5 7A               ld a,d
  30+ 9ED6 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9ED8 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9EDA
  33+ 9EDA CB 3F            srl a
  34+ 9EDC
  35+ 9EDC AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9EDD
  37+ 9EDD 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9EDE 28 04            jr z,4F
