3124  A183              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A183              ; ******************************************************************************************************************************************************************************************
   2+ A183              ;
   3+ A183              ;   3/4/25
   4+ A183              ;
   5+ A183              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A183              ;   (XOR) bit a bit.
   7+ A183              ;
   8+ A183              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A183              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A183
  11+ A183              Derivando_RND
  12+ A183
  13+ A183 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A185 C5               push bc
  15+ A186              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A186 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A189              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A189
  19+ A189 A7           6 and a                                 ; Carry a "0".
  20+ A18A CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A18C 30 02            jr nc,1F
  22+ A18E
  23+ A18E CB C1            set 0,c
  24+ A190
  25+ A190 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A191 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A193 5F               ld e,a
  28+ A194
  29+ A194 7A               ld a,d
  30+ A195 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A197 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A199
  33+ A199 CB 3F            srl a
  34+ A19B
  35+ A19B AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A19C
  37+ A19C 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A19D 28 04            jr z,4F
  39+ A19F
  40+ A19F CB FF            set 7,a
  41+ A1A1 18 02            jr 5F
  42+ A1A3
  43+ A1A3 CB BF        4 res 7,a
  44+ A1A5
  45+ A1A5 CB 21        5 sla c
  46+ A1A7 10 E0            djnz 6B
  47+ A1A9
  48+ A1A9 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A1AA
  50+ A1AA 77               ld (hl),a
  51+ A1AB 23               inc hl
  52+ A1AC C1               pop bc
  53+ A1AD 10 D4            djnz 3B
  54+ A1AF
  55+ A1AF C9               ret
  56+ A1B0
  57+ A1B0
  58+ A1B0
# file closed: RND_Derivando.asm
