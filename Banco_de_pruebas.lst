 614+ 9F23 7C               ld a,h
 615+ 9F24 B5               or l
 616+ 9F25 C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 617+ 9F26
 618+ 9F26 04               inc b
 619+ 9F27 05               dec b
 620+ 9F28 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
 621+ 9F2A
 622+ 9F2A              Loop_2:
 623+ 9F2A
 624+ 9F2A              ;   %xxxabccc
 625+ 9F2A
 626+ 9F2A              ;   %a ... Salida SPEAKER.
 627+ 9F2A              ;   %b ... MIC/EAR.
 628+ 9F2A              ;   %c ... BORDER Colour.
 629+ 9F2A
 630+ 9F2A
 631+ 9F2A 3E 10            ld a,%00010000          ; Borde negro.
 632+ 9F2C D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 633+ 9F2E
 634+ 9F2E              Delay_5:
 635+ 9F2E
 636+ 9F2E 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 637+ 9F2F
 638+ 9F2F 7C               ld a,h
 639+ 9F30 B5               or l
 640+ 9F31 20 FB            jr nz,Delay_5
 641+ 9F33
 642+ 9F33 2A B6 94         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 643+ 9F36
 644+ 9F36 AF               xor a                   ; Borde negro.    ---     4 tstates
 645+ 9F37 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 646+ 9F39
 647+ 9F39              Delay_6:
 648+ 9F39
 649+ 9F39 2B               dec hl
 650+ 9F3A
 651+ 9F3A 7C               ld a,h
 652+ 9F3B B5               or l
 653+ 9F3C 20 FB            jr nz,Delay_6
 654+ 9F3E
 655+ 9F3E              ; Hemos generado una onda sonora.
 656+ 9F3E              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 657+ 9F3E
 658+ 9F3E 2A B6 94         ld hl,(Sound)
 659+ 9F41
 660+ 9F41 1C               inc e
 661+ 9F42 1D               dec e
 662+ 9F43 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 663+ 9F45              ;                           ; (E)="0" indica que no hay variación en el tono.
 664+ 9F45
 665+ 9F45 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 666+ 9F46 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 667+ 9F47
 668+ 9F47              ; Rayo de entrada o de salida ???
 669+ 9F47
 670+ 9F47 A7               and a
 671+ 9F48 20 05            jr nz,Incrementa_delay
 672+ 9F4A
 673+ 9F4A              Decrementa_delay:
 674+ 9F4A
 675+ 9F4A 2B               dec hl
 676+ 9F4B 10 FD            djnz Decrementa_delay
 677+ 9F4D
 678+ 9F4D 18 03            jr 1F
 679+ 9F4F
