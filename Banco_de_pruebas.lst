  17  A4F3              	include "Variables_de_programa.asm"
# file opened: Variables_de_programa.asm
   1+ A4F3              ;	Variables de programa.
   2+ A4F3
   3+ A4F3              Bandeja_DRAW:
   4+ A4F3
   5+ A4F3 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
   6+ A4F4              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
   7+ A4F4              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
   8+ A4F4              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
   9+ A4F4
  10+ A4F4 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
  11+ A4F5              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
  12+ A4F5 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
  13+ A4F6 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
  14+ A4F7
  15+ A4F7 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
  16+ A4F8              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
  17+ A4F8              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
  18+ A4F8
  19+ A4F8              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
  20+ A4F8              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
  21+ A4F8
  22+ A4F8              ; Ejemplos:
  23+ A4F8
  24+ A4F8              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
  25+ A4F8              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
  26+ A4F8              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
  27+ A4F8              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
  28+ A4F8              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
  29+ A4F8
  30+ A4F8 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
  31+ A4F9              ;															  _ que esta entidad haya colisionado con Amadeus.
  32+ A4F9              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
  33+ A4F9
  34+ A4F9 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
  35+ A4FB              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
  36+ A4FB
  37+ A4FB 00 00        Puntero_de_almacen_de_mov_masticados defw 0
  38+ A4FD
  39+ A4FD              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
  40+ A4FD
  41+ A4FD 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
  42+ A4FF              ;															  _palabras que componen el "movimiento_masticado".
  43+ A4FF
  44+ A4FF              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
  45+ A4FF
  46+ A4FF 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
  47+ A500              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
  48+ A500              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
  49+ A500              ;																							 8 - 2 (4ª vuelta - velocidad 2)
  50+ A500              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
  51+ A500
  52+ A500 00           Attr db 0 													; Atributos de la entidad.
  53+ A501
  54+ A501              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
  55+ A501
  56+ A501
  57+ A501
  58+ A501 00           Ctrl_2 db 0
  59+ A502
  60+ A502              ; 															BIT 0, Este bit a "1" Indica que (Puntero_objeto) apuntará a un Sprite vacío, [Recompone_posicion_inicio].
  61+ A502              ;
  62+ A502              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
  63+ A502              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
  64+ A502              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
  65+ A502              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
  66+ A502              ;															_ el último MOVIMIENTO que hayamos ejecutado.
  67+ A502              ;															BIT 4, ???
  68+ A502              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
  69+ A502              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
  70+ A502              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
  71+ A502              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
  72+ A502              ;															- La rutina [Borra_escudo], inicializará el FLAG.
  73+ A502
  74+ A502 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
  75+ A503              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
  76+ A503              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
  77+ A503              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
  78+ A503              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
  79+ A503              ;
  80+ A503              ; 															DESCRIPCIÖN:
  81+ A503              ;
  82+ A503              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
  83+ A503              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
  84+ A503              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
  85+ A503              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
  86+ A503              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
  87+ A503              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
  88+ A503              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
  89+ A503              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
  90+ A503              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
  91+ A503              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
  92+ A503              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
  93+ A503              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
  94+ A503              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
  95+ A503              ;
  96+ A503              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
  97+ A503              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
  98+ A503              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
