 237+ 9E82 C6 20            add a,$20           							; Vamos a comprobarlo...
 238+ 9E84 6F               ld l,a
 239+ 9E85 D8               ret c               							; Salimos si se produce el cambio de tercio.
 240+ 9E86
 241+ 9E86 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 242+ 9E87 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 243+ 9E89 67               ld h,a
 244+ 9E8A C9               ret
