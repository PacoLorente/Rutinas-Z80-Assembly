1086+ C53D 28 0B            jr z,Retrocede_carro
1087+ C53F
1088+ C53F 3E 21            ld a,$21                                                ; "ENTER" KEYCODE.
1089+ C541 BE               cp (hl)
1090+ C542 28 06            jr z,Retrocede_carro
1091+ C544
1092+ C544 3E 27            ld a,$27                                                ; "CAPS SHIFT" KEYCODE.
1093+ C546 BE               cp (hl)
1094+ C547 28 01            jr z,Retrocede_carro
