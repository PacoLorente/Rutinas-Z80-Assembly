 495  93E5              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 496  93E5
 497  93E5 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 498  93E6              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 499  93E6              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 500  93E6              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 501  93E6
 502  93E6 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 503  93E7              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 504  93E7
 505  93E7 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 506  93E8              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 507  93E8              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 508  93E8
 509  93E8              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 510  93E8              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 511  93E8
 512  93E8              ; Ejemplos:
 513  93E8
 514  93E8              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 515  93E8              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 516  93E8              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 517  93E8              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 518  93E8              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 519  93E8
 520  93E8 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 521  93E9              ;															  _ que esta entidad haya colisionado con Amadeus.
 522  93E9              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 523  93E9
 524  93E9 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 525  93EB              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 526  93EB
 527  93EB 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 528  93ED
 529  93ED              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 530  93ED
 531  93ED 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 532  93EF              ;															  _palabras que componen el "movimiento_masticado".
 533  93EF
 534  93EF              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 535  93EF
 536  93EF 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 537  93F0              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 538  93F0              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 539  93F0              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 540  93F0              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 541  93F0
 542  93F0 00           Attr db 0 													; Atributos de la entidad.
 543  93F1
 544  93F1              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 545  93F1
 546  93F1
 547  93F1
 548  93F1 00           Ctrl_2 db 0
 549  93F2              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 550  93F2              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 551  93F2              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 552  93F2              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 553  93F2              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 554  93F2              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 555  93F2              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 556  93F2              ;
 557  93F2              ;															BIT 1, ???
 558  93F2              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 559  93F2              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 560  93F2              ;															BIT 3, ???
 561  93F2              ;															BIT 4, ???
 562  93F2              ;															BIT 5, ???
 563  93F2              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
 564  93F2              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
 565  93F2              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 566  93F2              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 567  93F2
 568  93F2 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 569  93F3              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_Sprite_completo],_
 570  93F3              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 571  93F3              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 572  93F3              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 573  93F3              ;
 574  93F3              ; 															DESCRIPCIÖN:
 575  93F3              ;
 576  93F3              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 577  93F3              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_Sprite_completo]).
 578  93F3              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 579  93F3              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_Sprite_completo]).
 580  93F3              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 581  93F3              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 582  93F3              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 583  93F3              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 584  93F3              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 585  93F3              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 586  93F3              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 587  93F3              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_Sprite_completo) justo después de `inicializar? un objeto.
 588  93F3              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 589  93F3              ;
 590  93F3              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 591  93F3              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 592  93F3              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 593  93F3
 594  93F3 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 595  93F4              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 596  93F4              ;															; _rojo - amarillo.
 597  93F4
 598  93F4 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 599  93F5              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 600  93F5
 601  93F5 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 602  93F6 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 603  93F7
 604  93F7 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 605  93F9 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
 606  93FB
 607  93FB              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 608  93FB
 609  93FB 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 610  93FC              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 611  93FC              ;
 612  93FC              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
 613  93FC
 614  93FC              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 615  93FC
 616  93FC 00 00        Indice_Sprite_der defw 0
 617  93FE 00 00        Indice_Sprite_izq defw 0
 618  9400 00 00        Puntero_DESPLZ_der defw 0
 619  9402 00 00        Puntero_DESPLZ_izq defw 0
 620  9404 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 621  9406
 622  9406 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 623  9407              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 624  9407              ;															; _baja de la pantalla cuando hemos superado el nivel.
 625  9407
 626  9407 00           Columnas db 0
 627  9408
 628  9408              ;	DRIVE
 629  9408
 630  9408 00           Sprite_completo db 0
 631  9409
 632  9409              ; Variables de control general.
 633  9409
 634  9409 00           Frames_explosion db 0 										; Nº de Frames que tiene la explosión.
 635  940A
 636  940A              ; Variables de funcionamiento, (No incluidas en base de datos de entidades), a partir de aquí!!!!!
 637  940A
 638  940A              Perfiles_de_velocidad:
 639  940A
 640  940A 00           Vel_left db 0 												; Velocidad izquierda. Nº de píxeles que desplazamos el objeto a izquierda. 1, 2, 4 u 8 px.
 641  940B 00           Vel_right db 0 												; Velocidad derecha. Nº de píxeles que desplazamos el objeto a derecha. 1, 2, 4 u 8 px.
 642  940C 00           Vel_up db 0 												; Velocidad subida. Nº de píxeles que desplazamos el objeto hacia arriba. (De 1 a 7px).
 643  940D 00           Vel_down db 0 												; Velocidad bajada. Nº de píxeles que desplazamos el objeto hacia abajo. (De 1 a 7px).
 644  940E
 645  940E              ; Movimiento. ------------------------------------------------------------------------------------------------------
 646  940E
 647  940E 00 00        Puntero_tabla_Random defw 0
 648  9410 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 649  9412 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 650  9414 00 00        Puntero_indice_mov_bucle defw 0
 651  9416              ;
 652  9416              ;
 653  9416 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 654  9417              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 655  9417              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 656  9417
 657  9417 00           Incrementa_puntero_backup db 0
 658  9418 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 659  9419              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 660  9419
 661  9419 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 662  941A 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 663  941B 00           Cola_de_desplazamiento db 0									; Este byte indica:
 664  941C
 665  941C              ;
 666  941C              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 667  941C              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 668  941C              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 669  941C              ;
 670  941C              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 671  941C              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 672  941C              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 673  941C              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 674  941C              ;
 675  941C              ;															;	"$ff" ..... Bucle infinito de repetición.
 676  941C              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 677  941C              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 678  941C
 679  941C 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 680  941D
 681  941D              ;																DESCRIPCIÓN:
 682  941D              ;
 683  941D              ;															BIT 0, "1" Habilita la impresión del msg. DONE en pantalla. La llamada a [Print_DONE] se efectúa desde el Reloj del juego,_
 684  941D              ; 															_ Rutina de interrupciones IM2.
 685  941D
 686  941D 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 687  941F              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 688  941F              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
