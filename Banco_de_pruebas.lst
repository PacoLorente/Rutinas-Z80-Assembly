 767  D324              ; ------------------------------------
 768  D324              ;
 769  D324              ; 	3/7/26
 770  D324              ;
 771  D324              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
 772  D324              ;
 773  D324              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
 774  D324              ;
 775  D324              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
 776  D324              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
 777  D324              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
 778  D324              ;
 779  D324              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
 780  D324              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
 781  D324              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
 782  D324              ;				  _medida que transcurre el tiempo.
 783  D324              ;
 784  D324              ;	OUTPUT: Define (Clock_next_entity).
 785  D324
 786  D324              Define_Clock_next_entity:
 787  D324
 788  D324 21 9B A5     	ld hl,Max_time_to_appear_entities
 789  D327 BE           	cp (hl)
 790  D328
 791  D328 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
 792  D329
 793  D329 38 03        	jr c,1F
 794  D32B
 795  D32B              ;	Por encima o igual que (Max_time_to_appear_entities).
 796  D32B
 797  D32B 4E           	ld c,(hl)
 798  D32C 18 06        	jr 2F
 799  D32E
 800  D32E              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
 801  D32E              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
 802  D32E
 803  D32E 23           1 inc hl
 804  D32F 23           	inc hl
 805  D330
 806  D330 BE           	cp (hl)
 807  D331
 808  D331 30 01        	jr nc,2F
 809  D333
 810  D333              ;	Por DEBAJO de (Min_time_to_appear_entities).
