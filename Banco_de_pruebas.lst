   1+ 94A4              ; ******************************************************************************************************************************************************************************************
   2+ 94A4              ;
   3+ 94A4              ;   3/4/25
   4+ 94A4              ;
   5+ 94A4              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 94A4              ;   (XOR) bit a bit.
   7+ 94A4              ;
   8+ 94A4              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 94A4              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 94A4
  11+ 94A4              Derivando_RND
  12+ 94A4
  13+ 94A4 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94A6 C5               push bc
  15+ 94A7              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94A7 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94AA              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94AA
  19+ 94AA A7           6 and a                                 ; Carry a "0".
  20+ 94AB CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94AD 30 02            jr nc,1F
  22+ 94AF
  23+ 94AF CB C1            set 0,c
  24+ 94B1
  25+ 94B1 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94B2 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94B4 5F               ld e,a
  28+ 94B5
  29+ 94B5 7A               ld a,d
  30+ 94B6 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94B8 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94BA
  33+ 94BA CB 3F            srl a
  34+ 94BC
  35+ 94BC AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 94BD
  37+ 94BD 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 94BE 28 04            jr z,4F
  39+ 94C0
  40+ 94C0 CB FF            set 7,a
  41+ 94C2 18 02            jr 5F
  42+ 94C4
  43+ 94C4 CB BF        4 res 7,a
  44+ 94C6
  45+ 94C6 CB 21        5 sla c
  46+ 94C8 10 E0            djnz 6B
  47+ 94CA
  48+ 94CA 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94CB
  50+ 94CB 77               ld (hl),a
  51+ 94CC 23               inc hl
  52+ 94CD C1               pop bc
  53+ 94CE 10 D4            djnz 3B
  54+ 94D0
  55+ 94D0 C9               ret
  56+ 94D1
  57+ 94D1
  58+ 94D1
