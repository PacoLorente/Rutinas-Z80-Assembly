 412+ A32E CD 43 A1     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 413+ A331
 414+ A331              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 415+ A331
 416+ A331 3A B8 93     	ld a,(Tipo)
 417+ A334 CD 6C A5     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 418+ A337 CD BE A4     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 419+ A33A
 420+ A33A              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 421+ A33A
 422+ A33A C1           	pop bc
 423+ A33B E1           	pop hl
 424+ A33C
 425+ A33C E5           	push hl															; Push (Puntero_de_entidades).
