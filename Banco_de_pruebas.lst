   4+ 9E12              ;
   5+ 9E12              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E12              ;   (XOR) bit a bit.
   7+ 9E12              ;
   8+ 9E12              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E12              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E12
  11+ 9E12              Derivando_RND:
  12+ 9E12
  13+ 9E12
  14+ 9E12 18 FE            jr $
  15+ 9E14
  16+ 9E14              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9E14 ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  18+ 9E16
  19+ 9E16 57               ld d,a
  20+ 9E17
  21+ 9E17 C5           3 push bc                               ; PUSH N° de números que queremos generar.
  22+ 9E18
  23+ 9E18 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  24+ 9E1B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  25+ 9E1B
  26+ 9E1B              ;   Adquire último bit de la semilla.
  27+ 9E1B
  28+ 9E1B E6 01            and %00000001
  29+ 9E1D
  30+ 9E1D 4F               ld c,a
  31+ 9E1E
  32+ 9E1E              ;   Rotamos los bits de la semilla una posición a la derecha.
  33+ 9E1E
  34+ 9E1E 7A               ld a,d
  35+ 9E1F
  36+ 9E1F A7               and a                               ; Carry a "0".
  37+ 9E20
  38+ 9E20 CB 1F            rr a                                ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  39+ 9E22
  40+ 9E22 57               ld d,a
  41+ 9E23
  42+ 9E23              Xor_bit_1_bit_2:
  43+ 9E23
  44+ 9E23 E6 01            and %00000001                       ; Bit_0 en (E).
  45+ 9E25 5F               ld e,a
  46+ 9E26
  47+ 9E26 7A               ld a,d
  48+ 9E27 E6 02            and %00000010                       ; Bit_1 en (A).
  49+ 9E29
  50+ 9E29 28 02            jr z,1F
  51+ 9E2B
  52+ 9E2B 3E 01            ld a,1
  53+ 9E2D
  54+ 9E2D AB           1 xor e
  55+ 9E2E
  56+ 9E2E              ;   FUNCIÓN XOR
  57+ 9E2E
  58+ 9E2E              ;   0 0 ..... 0
  59+ 9E2E              ;   0 1 ..... 1
  60+ 9E2E              ;   1 0 ..... 1
  61+ 9E2E              ;   1 1 ..... 0
  62+ 9E2E
  63+ 9E2E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla.
  64+ 9E2F
  65+ 9E2F 28 02            jr z,2F
  66+ 9E31
  67+ 9E31 CB FF            set 7,a                             ; Cuando la función XOR entre los dos últimos bits de la semilla resulta "1",_
  68+ 9E33              ;                                       ; _ seteamos a "1" el bit_7 de la misma.
  69+ 9E33
  70+ 9E33 CB 21        2 sla c                                 ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  71+ 9E35
  72+ 9E35              ;    djnz Xor_bit_1_bit_2
  73+ 9E35
  74+ 9E35 71               ld (hl),c
  75+ 9E36
  76+ 9E36 79               ld a,c
  77+ 9E37
  78+ 9E37 23               inc hl
  79+ 9E38
  80+ 9E38 C1               pop bc
  81+ 9E39
  82+ 9E39 10 DC            djnz 3B
  83+ 9E3B
  84+ 9E3B C9               ret
