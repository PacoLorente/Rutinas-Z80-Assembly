 396+ A3DC              ; Generamos movimientos masticados.
 397+ A3DC
 398+ A3DC              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A3DC
 400+ A3DC 79           	ld a,c 															; (A) = (Clase).
 401+ A3DD 32 17 94     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A3E0
 403+ A3E0 CD D5 A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A3E3 CD 67 A7     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A3E6
 406+ A3E6              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 407+ A3E6              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 408+ A3E6              ;	coreografías distintas.
