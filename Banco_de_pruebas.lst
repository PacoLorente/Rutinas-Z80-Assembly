 580+ C216
 581+ C216              ;   Init Burst_sound_efect.
 582+ C216
 583+ C216              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C216
 585+ C216 26 35            ld h,Burst_sound_init_value
 586+ C218
 587+ C218 3A F1 91         ld a,(Impacto_Amadeus)
 588+ C21B A7               and a
