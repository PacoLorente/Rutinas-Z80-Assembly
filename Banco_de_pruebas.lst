 561  94C3 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 562  94C4              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 563  94C4
 564  94C4 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 565  94C5 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 566  94C6 00           Cola_de_desplazamiento db 0									; Este byte indica:
 567  94C7
 568  94C7              ;
 569  94C7              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 570  94C7              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 571  94C7              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 572  94C7              ;
 573  94C7              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 574  94C7              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 575  94C7              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 576  94C7              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 577  94C7              ;
 578  94C7              ;															;	"$ff" ..... Bucle infinito de repetición.
 579  94C7              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 580  94C7              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 581  94C7
 582  94C7 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 583  94C8
 584  94C8              ;																DESCRIPCIÓN:
 585  94C8              ;
 586  94C8              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 587  94C8              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 588  94C8              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 589  94C8              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 590  94C8              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 591  94C8              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 592  94C8
 593  94C8              ;															BIT 3, Recarga de nueva oleada.
 594  94C8              ;															BIT 4, Recarga de nueva oleada.
 595  94C8              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 596  94C8              ;															BIT 6, **** Frame completo.
 597  94C8              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 598  94C8
 599  94C8 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 600  94CA              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 601  94CA              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 602  94CA              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 603  94CA              ;
 604  94CA              ;															; 2ª Función:
 605  94CA              ;
 606  94CA              ;															; La rutina [Genera_cabecera] almacena la dirección del álbum de scanlines donde se inicia la cabecera para posteriormente_
 607  94CA              ;															; _guardar esta dirección en la (Tabla_de_pintado).
