 565+ B1AD              ;   NextScan.
 566+ B1AD              ;
 567+ B1AD              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ B1AD              ;
 569+ B1AD              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ B1AD              ;
 571+ B1AD              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ B1AD              ;
 573+ B1AD              ;       DESTRUIDOS: AF y HL !!!
 574+ B1AD              ;
 575+ B1AD              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ B1AD              ;
 577+ B1AD
 578+ B1AD 24           NextScan inc h          							; Incrementamos el scanline.
 579+ B1AE 7C               ld a,h
 580+ B1AF E6 07            and 7
 581+ B1B1 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ B1B2
 583+ B1B2 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1B3 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1B5 6F               ld l,a
 586+ B1B6 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1B7
 588+ B1B7 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1B8 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1BA 67               ld h,a
 591+ B1BB C9               ret
 592+ B1BC
