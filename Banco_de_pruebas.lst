   1+ 948C              ; ******************************************************************************************************************************************************************************************
   2+ 948C              ;
   3+ 948C              ;   3/4/25
   4+ 948C              ;
   5+ 948C              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 948C              ;   (XOR) bit a bit.
   7+ 948C              ;
   8+ 948C              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 948C              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 948C
  11+ 948C              Derivando_RND
  12+ 948C
  13+ 948C ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 948E C5               push bc
  15+ 948F              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 948F 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9492              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9492
  19+ 9492 A7           6 and a                                 ; Carry a "0".
  20+ 9493 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9495 30 02            jr nc,1F
  22+ 9497
  23+ 9497 CB C1            set 0,c
  24+ 9499
  25+ 9499 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 949A E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 949C 5F               ld e,a
  28+ 949D
  29+ 949D 7A               ld a,d
  30+ 949E E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94A0 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94A2
