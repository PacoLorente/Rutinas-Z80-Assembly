 621+ C5A3
 622+ C5A3 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 623+ C5A4 C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ C5A6 6F               ld l,a
 625+ C5A7 D8               ret c               							; Salimos si se produce el cambio de tercio.
 626+ C5A8
 627+ C5A8 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 628+ C5A9 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 629+ C5AB 67               ld h,a
 630+ C5AC C9               ret
