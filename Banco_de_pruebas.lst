   3+ 8A6B              ;   07/07/23
   4+ 8A6B              ;
   5+ 8A6B              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8A6B              ;
   7+ 8A6B              ;   Codificación:
   8+ 8A6B              ;
   9+ 8A6B              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8A6B              ;
  11+ 8A6B              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8A6B              ;
  13+ 8A6B              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8A6B              ;
  15+ 8A6B              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8A6B              ;
  17+ 8A6B              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8A6B              ;                               ..... %01000010 Vel_up 4
  19+ 8A6B              ;                                               Vel_down 2
  20+ 8A6B              ;                               ..... $42
  21+ 8A6B              ;
  22+ 8A6B              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8A6B              ;
  24+ 8A6B              ;                               ..... %01000010 Vel_left 4
  25+ 8A6B              ;                                               Vel_right 2
  26+ 8A6B              ;                               ..... $42
  27+ 8A6B              ;
  28+ 8A6B              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8A6B              ;
  30+ 8A6B              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8A6B              ;
  32+ 8A6B              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8A6B              ;
  34+ 8A6B              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8A6B              ;                                     $53
  36+ 8A6B              ;
  37+ 8A6B              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8A6B              ;
  39+ 8A6B              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8A6B              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8A6B              ;
  42+ 8A6B              ;                       Arriba ..... $81
  43+ 8A6B              ;                       Arriba - izquierda ..... $a1
  44+ 8A6B              ;                       Arriba - derecha ..... $91
  45+ 8A6B              ;
  46+ 8A6B              ;                       Abajo ..... $41
  47+ 8A6B              ;                       Abajo - izquierda ..... $61
  48+ 8A6B              ;                       Abajo - derecha ..... $51
  49+ 8A6B              ;
  50+ 8A6B              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8A6B              ;
  52+ 8A6B              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8A6B              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8A6B              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8A6B              ;
  56+ 8A6B              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8A6B              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8A6B              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8A6B              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8A6B              ;
  61+ 8A6B              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8A6B              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8A6B              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8A6B              ;
  65+ 8A6B              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8A6B              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8A6B              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8A6B              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8A6B
