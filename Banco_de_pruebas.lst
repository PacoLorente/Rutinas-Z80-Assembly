   5+ 99A2              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99A2              ;   (XOR) bit a bit.
   7+ 99A2              ;
   8+ 99A2              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99A2              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99A2
  11+ 99A2              Derivando_RND
  12+ 99A2
  13+ 99A2 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99A4 C5               push bc
  15+ 99A5              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99A5 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99A8              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99A8
  19+ 99A8 A7           6 and a                                 ; Carry a "0".
  20+ 99A9 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99AB 30 02            jr nc,1F
  22+ 99AD
  23+ 99AD CB C1            set 0,c
  24+ 99AF
  25+ 99AF 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99B0 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99B2 5F               ld e,a
  28+ 99B3
  29+ 99B3 7A               ld a,d
  30+ 99B4 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99B6 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99B8
  33+ 99B8 CB 3F            srl a
  34+ 99BA
  35+ 99BA AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99BB
  37+ 99BB 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99BC 28 04            jr z,4F
  39+ 99BE
  40+ 99BE CB FF            set 7,a
  41+ 99C0 18 02            jr 5F
  42+ 99C2
  43+ 99C2 CB BF        4 res 7,a
  44+ 99C4
  45+ 99C4 CB 21        5 sla c
  46+ 99C6 10 E0            djnz 6B
  47+ 99C8
  48+ 99C8 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99C9
  50+ 99C9 77               ld (hl),a
  51+ 99CA 23               inc hl
  52+ 99CB C1               pop bc
  53+ 99CC 10 D4            djnz 3B
  54+ 99CE
  55+ 99CE C9               ret
