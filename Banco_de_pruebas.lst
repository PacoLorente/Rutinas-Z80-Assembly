 597+ AFE5              ;   PreviousScan.
 598+ AFE5              ;
 599+ AFE5              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 600+ AFE5              ;
 601+ AFE5              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ AFE5              ;
 603+ AFE5              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ AFE5              ;
 605+ AFE5              ;       DESTRUIDOS: AF y HL !!!
 606+ AFE5              ;
 607+ AFE5              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ AFE5              ;
 609+ AFE5
 610+ AFE5 7C           PreviousScan ld a,h
 611+ AFE6 25               dec h               							; Dec H.
 612+ AFE7 E6 07            and 7
 613+ AFE9 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ AFEA
 615+ AFEA 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ AFEB D6 20            sub $20             							; Vamos a comprobarlo...
 617+ AFED 6F               ld l,a
 618+ AFEE D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ AFEF
 620+ AFEF 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ AFF0 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ AFF2 67               ld h,a
 623+ AFF3 C9               ret
