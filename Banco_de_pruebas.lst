 342  91AB              ;
 343  91AB              ;
 344  91AB 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 345  91AC              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
