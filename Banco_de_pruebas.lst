 851+ AFF8              ;
 852+ AFF8              ;	defw Vida_1,Amadeus       							; (Puntero_de_impresion), (Puntero_objeto)
 853+ AFF8              ;	defw Vida_2,Amadeus_Fb
 854+ AFF8              ;	defw Vida_3,Amadeus
