   6+ B498              Draw:
   7+ B498
   8+ B498 2A 79 95     	ld hl,(Posicion_actual)
   9+ B49B 7C           	ld a,h
  10+ B49C B5           	or l
  11+ B49D 20 10        	jr nz,Entidad_iniciada 										; Si el contenido de (Posicion_actual) es distinto de "0" la entidad ya se ha iniciado.
  12+ B49F
  13+ B49F CD 1F BB     	call Inicia_Puntero_mov
  14+ B4A2
  15+ B4A2 2A 86 95     	ld hl,(Posicion_inicio)
  16+ B4A5 22 79 95     	ld (Posicion_actual),hl
  17+ B4A8 22 6B 95     	ld (Puntero_de_impresion),hl
  18+ B4AB
  19+ B4AB              ;	Comparador de cuadrantes:
  20+ B4AB
  21+ B4AB CD C5 B4     	call Calcula_Cuad_objeto
  22+ B4AE 08           	ex af,af													; (Cuad_objeto) inicial en A'.
  23+ B4AF
  24+ B4AF              Entidad_iniciada:
  25+ B4AF
  26+ B4AF DD 2A 6B 95  	ld ix,(Puntero_de_impresion) 								; (Puntero_de_impresion) de la anterior (Posicion_actual). Necesario para averiguar si existe_
  27+ B4B3              ; 																; _cambio de cuadrante cuando el sprite está incompleto.
  28+ B4B3 CD C5 B4     	call Calcula_Cuad_objeto  									; (Cuad_objeto) de la nueva (Posicion_actual).
  29+ B4B6
  30+ B4B6 CD 03 B5     	call calcula_CColumnass										; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  31+ B4B9              ;																; También comprueba si en la nueva (Posicion_actual) el Sprite se imprime COMPLETO o INCOMPLETO, (Sprite_completo_1).
  32+ B4B9 CD 29 B5     	call Drive													; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  33+ B4BC
  34+ B4BC 3A 74 95     	ld a,(Ctrl_0)												; Antes de salir de la rutina restauramos los bits 0,1,2,3 y 5 de (Ctrl_0).
  35+ B4BF E6 D0        	and $d0
  36+ B4C1 32 74 95     	ld (Ctrl_0),a
