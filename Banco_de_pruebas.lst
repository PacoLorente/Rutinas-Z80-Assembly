 326+ C0F3 C5               push bc
 327+ C0F4 D5               push de
 328+ C0F5 E5               push hl                                 ; STORE Regs.
 329+ C0F6
 330+ C0F6              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 331+ C0F6
 332+ C0F6              ;   Configuración de un BEEP.
 333+ C0F6
 334+ C0F6              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 335+ C0F6              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 336+ C0F6              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 337+ C0F6              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 338+ C0F6              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 339+ C0F6
 340+ C0F6
 341+ C0F6 01 02 00         ld bc,$0002
 342+ C0F9 11 00 00         ld de,0
 343+ C0FC 21 D0 00         ld hl,$00d0
 344+ C0FF
 345+ C0FF 22 78 94         ld (Sound),hl
