 614  94D6              ;
 615  94D6 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 616  94D7              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 617  94D7              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
