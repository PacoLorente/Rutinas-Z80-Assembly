 425  941A 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 426  941B 00           Cola_de_desplazamiento db 0									; Este byte indica:
 427  941C
 428  941C              ;
 429  941C              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 430  941C              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 431  941C              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 432  941C              ;
 433  941C              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 434  941C              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 435  941C              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 436  941C              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 437  941C              ;
 438  941C              ;															;	"$ff" ..... Bucle infinito de repetición.
 439  941C              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 440  941C              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
