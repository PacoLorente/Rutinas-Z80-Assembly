 308+ C0DA              ; ----------------------------------------------------------------------------------------------
 309+ C0DA              ;
 310+ C0DA              ;   17/9/26
 311+ C0DA              ;
 312+ C0DA              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C0DA              ;
 314+ C0DA              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C0DA
 316+ C0DA              BEEP:
 317+ C0DA
 318+ C0DA F5               push af
 319+ C0DB C5               push bc
 320+ C0DC D5               push de
 321+ C0DD E5               push hl                                 ; STORE Regs.
 322+ C0DE
 323+ C0DE              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C0DE
 325+ C0DE              ;   Configuración de un BEEP.
 326+ C0DE
 327+ C0DE              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C0DE              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C0DE              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C0DE              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C0DE              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C0DE
 333+ C0DE
 334+ C0DE 01 02 00         ld bc,$0002
 335+ C0E1 11 00 00         ld de,0
 336+ C0E4 21 D0 00         ld hl,$00d0
 337+ C0E7
 338+ C0E7 22 78 94         ld (Sound),hl
 339+ C0EA
 340+ C0EA CD E7 9E         call Sound_Generator    ; v2. Ok.
 341+ C0ED
 342+ C0ED 21 00 00         ld hl,0
 343+ C0F0 22 78 94         ld (Sound),hl
 344+ C0F3
 345+ C0F3 E1               pop hl                                  ; RECOVERY Regs.
 346+ C0F4 D1               pop de
 347+ C0F5 C1               pop bc
 348+ C0F6 F1               pop af
 349+ C0F7
 350+ C0F7 C9               ret
 351+ C0F8
 352+ C0F8              ; ----- ----- ----- ----- -----
 353+ C0F8              ;
 354+ C0F8              ;   23/9/26
 355+ C0F8              ;
 356+ C0F8              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C0F8              ;
 358+ C0F8              ;   HL define el sonido.
 359+ C0F8              ;
 360+ C0F8              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C0F8              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C0F8              ;
 363+ C0F8              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C0F8              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C0F8              ;
 366+ C0F8              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C0F8              ;
 368+ C0F8              ;   INPUTS: (Shot_sound) <> "0".
 369+ C0F8              ;
 370+ C0F8              ;   MODIFY: AF, HL y BC.
 371+ C0F8              ;
 372+ C0F8              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C0F8
 374+ C0F8              Play_shot_sound_effect:
 375+ C0F8
 376+ C0F8              ;   Exclusiones:
 377+ C0F8
 378+ C0F8 2A 7C 94         ld hl,(Shot_sound)
 379+ C0FB 7C               ld a,h
 380+ C0FC B5               or l
 381+ C0FD C8               ret z                   ; RET si no se ha producido disparo.
 382+ C0FE
 383+ C0FE 3A 4F 94         ld a,(Ctrl_6)
 384+ C101 CB 47            bit 0,a
 385+ C103 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C104
 387+ C104 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C106
 389+ C106              Loop_1:
 390+ C106
 391+ C106 3E 10            ld a,%00010000          ; Borde negro.
 392+ C108 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C10A
 394+ C10A 45               ld b,l
 395+ C10B
 396+ C10B 10 FE        Delay_3 djnz Delay_3
 397+ C10D
 398+ C10D AF               xor a                   ; Borde negro.
 399+ C10E D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C110
 401+ C110 45               ld b,l
 402+ C111
 403+ C111 10 FE        Delay_4 djnz Delay_4
 404+ C113
 405+ C113              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C113
 407+ C113 2C               inc l
 408+ C114 2C               inc l
 409+ C115 2C               inc l
 410+ C116 2C               inc l
 411+ C117
 412+ C117 25               dec h
 413+ C118
 414+ C118 CC 22 C1         call z,Clean_shot_effect
