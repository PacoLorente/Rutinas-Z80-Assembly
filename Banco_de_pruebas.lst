   1+ A0F7              ; ******************************************************************************************************************************************************************************************
   2+ A0F7              ;
   3+ A0F7              ;   3/4/25
   4+ A0F7              ;
   5+ A0F7              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0F7              ;   (XOR) bit a bit.
   7+ A0F7              ;
   8+ A0F7              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0F7              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0F7
  11+ A0F7              Derivando_RND
  12+ A0F7
  13+ A0F7 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0F9 C5               push bc
  15+ A0FA              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0FA 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0FD              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0FD
  19+ A0FD A7           6 and a                                 ; Carry a "0".
  20+ A0FE CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A100 30 02            jr nc,1F
  22+ A102
  23+ A102 CB C1            set 0,c
  24+ A104
  25+ A104 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A105 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A107 5F               ld e,a
  28+ A108
  29+ A108 7A               ld a,d
  30+ A109 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A10B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A10D
  33+ A10D CB 3F            srl a
  34+ A10F
  35+ A10F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A110
  37+ A110 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A111 28 04            jr z,4F
  39+ A113
  40+ A113 CB FF            set 7,a
  41+ A115 18 02            jr 5F
  42+ A117
  43+ A117 CB BF        4 res 7,a
  44+ A119
  45+ A119 CB 21        5 sla c
  46+ A11B 10 E0            djnz 6B
  47+ A11D
  48+ A11D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A11E
  50+ A11E 77               ld (hl),a
  51+ A11F 23               inc hl
  52+ A120 C1               pop bc
  53+ A121 10 D4            djnz 3B
  54+ A123
  55+ A123 C9               ret
  56+ A124
  57+ A124
  58+ A124
