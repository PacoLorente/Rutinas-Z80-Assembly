 147+ C090              Note_1:
 148+ C090
 149+ C090 01 14 00     	ld bc,$0014                                             ; No ruido / 20 ondas completas
 150+ C093 11 05 00     	ld de,$0005                                             ; Nota descendente / 5 unid. decrease.
 151+ C096 21 5E 01     	ld hl,$015e                                             ; Note init. value.
 152+ C099
 153+ C099 22 06 96     	ld (Sound),hl
 154+ C09C CD 61 9F         call Sound_Generator    ; v2. Ok.                       ; Tras la primera nota descendente (HL) se sitúa_
 155+ C09F              ;                                                           ; _ en la primera nota de la melodía. (HL)=$00fa
 156+ C09F
 157+ C09F              Note_2:
 158+ C09F
