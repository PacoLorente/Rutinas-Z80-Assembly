 273  8C0B 00           Limite_horizontal db 0	 								; Dirección de pantalla, (scanline), calculado en función del tamaño del Sprite. Si el objeto llega a esta línea se modifica_
 274  8C0C              ; 														; _(Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 275  8C0C 00           Limite_vertical db 0 									; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 276  8C0D
