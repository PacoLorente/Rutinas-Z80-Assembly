1083+ C4D4
1084+ C4D4 3E 20            ld a,$20                                                ; "SPACE" KEYCODE.
1085+ C4D6 BE               cp (hl)
1086+ C4D7 28 0B            jr z,Retrocede_carro
1087+ C4D9
1088+ C4D9 3E 21            ld a,$21                                                ; "ENTER" KEYCODE.
1089+ C4DB BE               cp (hl)
1090+ C4DC 28 06            jr z,Retrocede_carro
1091+ C4DE
1092+ C4DE 3E 27            ld a,$27                                                ; "CAPS SHIFT" KEYCODE.
1093+ C4E0 BE               cp (hl)
1094+ C4E1 28 01            jr z,Retrocede_carro
1095+ C4E3
