 220  9292              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 221  9292
 222  9292 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 223  9293              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 224  9293              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 225  9293              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 226  9293
 227  9293 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 228  9294              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 229  9294 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 230  9295 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 231  9296
 232  9296 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 233  9297              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 234  9297              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 235  9297
 236  9297              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 237  9297              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 238  9297
 239  9297              ; Ejemplos:
 240  9297
 241  9297              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 242  9297              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 243  9297              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 244  9297              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 245  9297              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 246  9297
 247  9297 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 248  9298              ;															  _ que esta entidad haya colisionado con Amadeus.
 249  9298              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 250  9298
 251  9298 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 252  929A              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 253  929A
 254  929A 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 255  929C
 256  929C              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 257  929C
 258  929C 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 259  929E              ;															  _palabras que componen el "movimiento_masticado".
 260  929E
 261  929E              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 262  929E
 263  929E 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 264  929F              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 265  929F              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 266  929F              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 267  929F              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 268  929F
 269  929F 00           Attr db 0 													; Atributos de la entidad.
 270  92A0
 271  92A0              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 272  92A0
 273  92A0
 274  92A0
 275  92A0 00           Ctrl_2 db 0
 276  92A1              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 277  92A1              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 278  92A1              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 279  92A1              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 280  92A1              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 281  92A1              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 282  92A1              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 283  92A1              ;
 284  92A1              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 285  92A1              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 286  92A1              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 287  92A1              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 288  92A1              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 289  92A1              ;															BIT 4, ???
 290  92A1              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 291  92A1              ;															BIT 6, "1" Indica que hemos iniciado la "-Transicion_de_salida-" de Amadeus.
 292  92A1              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 293  92A1              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 294  92A1
 295  92A1 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 296  92A2              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 297  92A2              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 298  92A2              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 299  92A2              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 300  92A2              ;
 301  92A2              ; 															DESCRIPCIÖN:
 302  92A2              ;
 303  92A2              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 304  92A2              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 305  92A2              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 306  92A2              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 307  92A2              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 308  92A2              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 309  92A2              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 310  92A2              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 311  92A2              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 312  92A2              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 313  92A2              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 314  92A2              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 315  92A2              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 316  92A2              ;
 317  92A2              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 318  92A2              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 319  92A2              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 320  92A2
 321  92A2 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 322  92A3              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 323  92A3              ;															; _rojo - amarillo.
 324  92A3
 325  92A3 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 326  92A4              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 327  92A4
 328  92A4 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 329  92A6 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
