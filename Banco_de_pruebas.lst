 355+ C119              ; ----- ----- ----- ----- -----
 356+ C119              ;
 357+ C119              ;   23/9/26
 358+ C119              ;
 359+ C119              ;   El efecto del disparo de Amadeus es de tipo descendente.
 360+ C119              ;
 361+ C119              ;   HL define el sonido.
 362+ C119              ;
 363+ C119              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 364+ C119              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 365+ C119              ;
 366+ C119              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 367+ C119              ;   _ escudo tienen prioridad sobre este efecto.
 368+ C119              ;
 369+ C119              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 370+ C119              ;
 371+ C119              ;   INPUTS: (Shot_sound) <> "0".
 372+ C119              ;
 373+ C119              ;   MODIFY: AF, HL y BC.
 374+ C119              ;
 375+ C119              ;   OUTPUT: (Shot_sound) actualizado.
 376+ C119
 377+ C119              Play_shot_sound_effect:
 378+ C119
 379+ C119              ;   Exclusiones:
 380+ C119
 381+ C119 2A 8F 94         ld hl,(Shot_sound)
 382+ C11C 7C               ld a,h
 383+ C11D B5               or l
 384+ C11E C8               ret z                   ; RET si no se ha producido disparo.
 385+ C11F
 386+ C11F 3A 61 94         ld a,(Ctrl_6)
 387+ C122 CB 47            bit 0,a
 388+ C124 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 389+ C125
 390+ C125 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
