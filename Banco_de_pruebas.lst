 337  91AE              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 338  91AE
 339  91AE 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 340  91AF 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 341  91B0 00           Cola_de_desplazamiento db 0									; Este byte indica:
 342  91B1
 343  91B1              ;
 344  91B1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 345  91B1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 346  91B1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 347  91B1              ;
 348  91B1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 349  91B1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 350  91B1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 351  91B1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 352  91B1              ;
 353  91B1              ;															;	"$ff" ..... Bucle infinito de repetición.
 354  91B1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 355  91B1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 356  91B1
