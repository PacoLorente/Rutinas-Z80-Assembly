 572+ A44A              ; ------------------------------------------------
 573+ A44A              ;
 574+ A44A              ;	INPUT: A y D contienen un n° aleatorio ($00-$1f).
 575+ A44A              ;
 576+ A44A              ;	MODIFY: A y D
 577+ A44A              ;
 578+ A44A              ;	OUTPUT: A y D contienen un nuevo n° RND ($00-$1f).
 579+ A44A              ;
 580+ A44A              ;	Se generan tres n° aleatorios ($00-$1f) como máximo, (3 clases de entidades diferentes como máximo por nivel).
 581+ A44A              ;
