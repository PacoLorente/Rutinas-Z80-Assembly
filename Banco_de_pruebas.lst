 616+ C40F              ; -----------------------------------------------------------------------------------------------------------
 617+ C40F              ;
 618+ C40F              ;   17/10/26
 619+ C40F              ;
 620+ C40F              ;   Asigna un nuevo KEYCODE y sustituye al contenido en la variable MOVE_xxx, (al que apunta H)L.
 621+ C40F              ;   Nueva tecla para la función de movimiento, (KEYBOARD) a la que apunta HL.
 622+ C40F              ;
 623+ C40F              ;   Move_LEFT db $24
 624+ C40F              ;   Move_RIGHT db $1c
 625+ C40F              ;   Move_FIRE db $04
 626+ C40F              ;   Move_SHIELD db $20
 627+ C40F              ;
 628+ C40F              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 629+ C40F              ;
 630+ C40F              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 631+ C40F              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 632+ C40F              ;
 633+ C40F              ;   Special keys:
 634+ C40F              ;
 635+ C40F              ;   Symbol_key defm "SYMB.",0
 636+ C40F              ;   Space_key defm "SPACE",0
 637+ C40F              ;   Enter_key defm "ENTER",0
 638+ C40F              ;   Caps_key defm "CAPS.",0
 639+ C40F              ;
 640+ C40F              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 641+ C40F              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 642+ C40F              ;
 643+ C40F              ;           (Numero_de_teclas_definidas) contiene el n° de teclas YA DEFINIDAS.
 644+ C40F              ;
 645+ C40F              ;   MODIFY: AF, HL, BC y DE.
 646+ C40F              ;
 647+ C40F              ;   OUTPUT: (A) = "0".
 648+ C40F
 649+ C40F              Define_key:
 650+ C40F
 651+ C40F E5               push hl                                                 ; PUSH Puntero KEYCODE.
 652+ C410 D5               push de                                                 ; PUSH Puntero ASCII_CODE.
 653+ C411
 654+ C411 CD 0B A0     3 call ROM_Key_Scan ; v2. Ok.                               ; Scan keyboard.
 655+ C414
 656+ C414              ;   Tras ejecutar[ROM_Key_Scan], (E) contiene el KEYCODE de la tecla pulsada.
 657+ C414
 658+ C414 3A 27 96         ld a,(Numero_de_teclas_definidas)                       ; N° de teclas ya definidas.
 659+ C417 A7               and a
 660+ C418 28 0B            jr z,2F                                                 ; (Numero_de_teclas_definidas)="0" Indica que estamos definiendo Move_LEFT.
 661+ C41A              ;                                                           ; (Numero_de_teclas_definidas) se incrementa en una unidad cada vez que se define una tecla:
 662+ C41A              ;
 663+ C41A              ;                                                           ; Ej.: Si estamos definiendo Move_RIGHT, (Numero_de_teclas_definidas)="1"
 664+ C41A              ;                                                           ;      Si estamos definiendo Move_FIRE, (Numero_de_teclas_definidas)="2"
 665+ C41A              ;                                                           ;      Si estamos definiendo Move_SHIELD, (Numero_de_teclas_definidas)="3"
 666+ C41A
 667+ C41A 47               ld b,a                                                  ; Así, (B) contiene el nº de teclas definidas -1.
 668+ C41B
 669+ C41B              ;   (Numero_de_teclas_definidas) contiene el n° de comparativas que realizaremos entre el nuevo KEYCODE definido y los anteriormente definidos.
 670+ C41B              ;   Así evitaremos que se asigne una misma tecla para varias funciones distintas.
 671+ C41B
 672+ C41B 21 28 96         ld hl,Move_LEFT                                         ; 1er KEYCODE a comparar.
 673+ C41E
 674+ C41E 7E           1 ld a,(hl)                                                 ; KEY_CODE de Move_LEFT en A.
 675+ C41F BB               cp e                                                    ; Comparo con el Key_code recién adquirido.
 676+ C420 28 EF            jr z,3B                                                 ; Esta tecla ya se definió anteriormente. Volvemos a escanear el teclado.
 677+ C422
 678+ C422 23               inc hl                                                  ; Next KEYCODE to compare.
 679+ C423
 680+ C423 10 F9            djnz 1B
 681+ C425
 682+ C425 7B           2 ld a,e                                                    ; KEY_code en A.
 683+ C426
 684+ C426 D1               pop de                                                  ; POP Puntero ASCII_CODE.
 685+ C427 E1               pop hl                                                  ; POP Puntero KEYCODE.
 686+ C428
 687+ C428 77               ld (hl),a                                               ; Key_code almacenado.
 688+ C429
 689+ C429              ;   Sonido, (BEEP) de la pulsación de las teclas, (cuando está autorizada). No se ejecuta [BEEP] si la tecla ya está definida.
 690+ C429
 691+ C429 CD 18 C1         call BEEP   ; v2. Ok.
