 517+ 9EEF              ;
 518+ 9EEF              ;   Byte (XOR) del 1er char. de la imagen.
 519+ 9EEF              ;   Byte (XOR) del 2º char. de la imagen.
 520+ 9EEF              ;   Byte (XOR) del 3er char. de la imagen., etc.
 521+ 9EEF
 522+ 9EEF              ;   Decrementa el contador de scanlines, (A´).
 523+ 9EEF
 524+ 9EEF              ;   Nos situamos en el siguiente scan, (call NextScan).
 525+ 9EEF
 526+ 9EEF              ;   Byte (XOR) del 1er char. de la imagen.
 527+ 9EEF              ;   Byte (XOR) del 2º char. de la imagen.
 528+ 9EEF              ;   Byte (XOR) del 3er char. de la imagen., etc.
 529+ 9EEF
 530+ 9EEF              ;   Decrementa el contador de scanlines, (A´).
 531+ 9EEF
 532+ 9EEF
 533+ 9EEF 1A           2 ld a,(de)
 534+ 9EF0 AE               xor (hl)
 535+ 9EF1 77               ld (hl),a
