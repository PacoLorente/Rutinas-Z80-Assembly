 592+ B4AE C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B4B0 6F               ld l,a
 594+ B4B1 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B4B2
 596+ B4B2 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B4B3 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B4B5 67               ld h,a
 599+ B4B6 C9               ret
