   4+ 9C28              ;
   5+ 9C28              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9C28              ;   (XOR) bit a bit.
   7+ 9C28              ;
   8+ 9C28              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9C28              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9C28
  11+ 9C28              Derivando_RND
  12+ 9C28
  13+ 9C28 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9C2A C5               push bc
  15+ 9C2B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9C2B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9C2E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9C2E
  19+ 9C2E A7           6 and a                                 ; Carry a "0".
  20+ 9C2F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9C31 30 02            jr nc,1F
  22+ 9C33
  23+ 9C33 CB C1            set 0,c
  24+ 9C35
  25+ 9C35 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9C36 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9C38 5F               ld e,a
  28+ 9C39
  29+ 9C39 7A               ld a,d
  30+ 9C3A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9C3C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9C3E
  33+ 9C3E CB 3F            srl a
  34+ 9C40
  35+ 9C40 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9C41
  37+ 9C41 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9C42 28 04            jr z,4F
  39+ 9C44
  40+ 9C44 CB FF            set 7,a
  41+ 9C46 18 02            jr 5F
  42+ 9C48
  43+ 9C48 CB BF        4 res 7,a
  44+ 9C4A
  45+ 9C4A CB 21        5 sla c
  46+ 9C4C 10 E0            djnz 6B
  47+ 9C4E
  48+ 9C4E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C4F
  50+ 9C4F 77               ld (hl),a
  51+ 9C50 23               inc hl
  52+ 9C51 C1               pop bc
  53+ 9C52 10 D4            djnz 3B
  54+ 9C54
  55+ 9C54 C9               ret
  56+ 9C55
  57+ 9C55
  58+ 9C55
