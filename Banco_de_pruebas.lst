 502+ ACF2              ; -----------------------------------------------------------------------------------
 503+ ACF2              ;
 504+ ACF2              ;	12/8/26
 505+ ACF2              ;
 506+ ACF2              ;	Asigna una columna de inicio aleatoria y distinta a cada una de las 3 Clases como máximo que pueden aparecer en un nivel.
 507+ ACF2
 508+ ACF2              Determina_posicion_de_inicio:
 509+ ACF2
 510+ ACF2 21 8F A2     	ld hl,Numeros_aleatorios_baile+3
 511+ ACF5 7E           	ld a,(hl)
 512+ ACF6 E6 1F        	and $1f															; Define el nº de columna por el que va a aparecer la entidad.
 513+ ACF8
 514+ ACF8              ;	Tenemos un nº aleatorio, (Columna de inicio) en A.
