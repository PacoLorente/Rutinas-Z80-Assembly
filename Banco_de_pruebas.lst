 469  93C6              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 470  93C6
 471  93C6 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 472  93C7 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 473  93C8 00           Cola_de_desplazamiento db 0									; Este byte indica:
 474  93C9
 475  93C9              ;
 476  93C9              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 477  93C9              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 478  93C9              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 479  93C9              ;
 480  93C9              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 481  93C9              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 482  93C9              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 483  93C9              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 484  93C9              ;
 485  93C9              ;															;	"$ff" ..... Bucle infinito de repetición.
 486  93C9              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 487  93C9              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 488  93C9
