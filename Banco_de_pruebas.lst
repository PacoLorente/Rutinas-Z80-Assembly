1635  989D              ;	Por encima o igual que (Max_time_to_appear_entities).
1636  989D              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1637  989D
1638  989D 4E           	ld c,(hl)
1639  989E
1640  989E              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
