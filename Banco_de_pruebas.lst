   4+ 99ED              ;
   5+ 99ED              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99ED              ;   (XOR) bit a bit.
   7+ 99ED              ;
   8+ 99ED              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99ED              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99ED
  11+ 99ED              Derivando_RND
  12+ 99ED
  13+ 99ED ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99EF C5               push bc
  15+ 99F0              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99F0 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99F3              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99F3
  19+ 99F3 A7           6 and a                                 ; Carry a "0".
  20+ 99F4 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99F6 30 02            jr nc,1F
  22+ 99F8
  23+ 99F8 CB C1            set 0,c
  24+ 99FA
  25+ 99FA 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99FB E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99FD 5F               ld e,a
  28+ 99FE
  29+ 99FE 7A               ld a,d
  30+ 99FF E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9A01 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9A03
  33+ 9A03 CB 3F            srl a
  34+ 9A05
  35+ 9A05 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9A06
  37+ 9A06 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9A07 28 04            jr z,4F
  39+ 9A09
  40+ 9A09 CB FF            set 7,a
  41+ 9A0B 18 02            jr 5F
  42+ 9A0D
  43+ 9A0D CB BF        4 res 7,a
  44+ 9A0F
  45+ 9A0F CB 21        5 sla c
  46+ 9A11 10 E0            djnz 6B
  47+ 9A13
  48+ 9A13 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9A14
  50+ 9A14 77               ld (hl),a
  51+ 9A15 23               inc hl
  52+ 9A16 C1               pop bc
  53+ 9A17 10 D4            djnz 3B
  54+ 9A19
  55+ 9A19 C9               ret
  56+ 9A1A
  57+ 9A1A
  58+ 9A1A
