 337  9197              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 338  9197
 339  9197 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 340  9198 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 341  9199 00           Cola_de_desplazamiento db 0									; Este byte indica:
 342  919A
 343  919A              ;
 344  919A              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 345  919A              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 346  919A              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 347  919A              ;
 348  919A              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 349  919A              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 350  919A              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 351  919A              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 352  919A              ;
 353  919A              ;															;	"$ff" ..... Bucle infinito de repetición.
 354  919A              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 355  919A              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 356  919A
 357  919A 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 358  919B
 359  919B              ;																DESCRIPCIÓN:
 360  919B              ;
 361  919B              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 362  919B              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 363  919B              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 364  919B              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 365  919B              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 366  919B              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 367  919B
 368  919B              ;															BIT 3, Recarga de nueva oleada.
 369  919B              ;															BIT 4, Recarga de nueva oleada.
 370  919B              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 371  919B              ;															BIT 6, **** Frame completo.
 372  919B              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 373  919B
