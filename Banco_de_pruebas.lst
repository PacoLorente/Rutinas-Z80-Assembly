 431+ C162              ;   -------------------------------------------------------------------------------------------
 432+ C162              ;
 433+ C162              ;   23/9/26
 434+ C162              ;
 435+ C162              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C162              ;
 437+ C162              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C162              ;   _ [Sound_Generator].
 439+ C162              ;
 440+ C162              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C162              ;
 442+ C162              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C162              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C162              ;
 445+ C162              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C162              ;
 447+ C162              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C162              ;
 449+ C162              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C162
