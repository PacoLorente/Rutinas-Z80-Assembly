   5+ 9D90              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D90              ;   (XOR) bit a bit.
   7+ 9D90              ;
   8+ 9D90              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D90              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D90
  11+ 9D90              Derivando_RND
  12+ 9D90
  13+ 9D90 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D92 C5               push bc
  15+ 9D93              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D93 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D96              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D96
  19+ 9D96 A7           6 and a                                 ; Carry a "0".
  20+ 9D97 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D99 30 02            jr nc,1F
  22+ 9D9B
  23+ 9D9B CB C1            set 0,c
  24+ 9D9D
  25+ 9D9D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D9E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9DA0 5F               ld e,a
  28+ 9DA1
  29+ 9DA1 7A               ld a,d
  30+ 9DA2 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9DA4 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9DA6
  33+ 9DA6 CB 3F            srl a
  34+ 9DA8
  35+ 9DA8 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9DA9
  37+ 9DA9 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9DAA 28 04            jr z,4F
  39+ 9DAC
  40+ 9DAC CB FF            set 7,a
  41+ 9DAE 18 02            jr 5F
  42+ 9DB0
  43+ 9DB0 CB BF        4 res 7,a
  44+ 9DB2
  45+ 9DB2 CB 21        5 sla c
  46+ 9DB4 10 E0            djnz 6B
  47+ 9DB6
  48+ 9DB6 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9DB7
  50+ 9DB7 77               ld (hl),a
  51+ 9DB8 23               inc hl
  52+ 9DB9 C1               pop bc
  53+ 9DBA 10 D4            djnz 3B
  54+ 9DBC
  55+ 9DBC C9               ret
