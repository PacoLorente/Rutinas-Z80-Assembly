   1+ A038              ; ******************************************************************************************************************************************************************************************
   2+ A038              ;
   3+ A038              ;   3/4/25
   4+ A038              ;
   5+ A038              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A038              ;   (XOR) bit a bit.
   7+ A038              ;
   8+ A038              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A038              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A038
  11+ A038              Derivando_RND
  12+ A038
  13+ A038 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A03A C5               push bc
  15+ A03B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A03B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A03E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A03E
  19+ A03E A7           6 and a                                 ; Carry a "0".
  20+ A03F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A041 30 02            jr nc,1F
  22+ A043
  23+ A043 CB C1            set 0,c
  24+ A045
  25+ A045 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A046 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A048 5F               ld e,a
  28+ A049
  29+ A049 7A               ld a,d
  30+ A04A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A04C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A04E
  33+ A04E CB 3F            srl a
  34+ A050
  35+ A050 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A051
  37+ A051 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A052 28 04            jr z,4F
  39+ A054
  40+ A054 CB FF            set 7,a
  41+ A056 18 02            jr 5F
  42+ A058
  43+ A058 CB BF        4 res 7,a
  44+ A05A
  45+ A05A CB 21        5 sla c
  46+ A05C 10 E0            djnz 6B
  47+ A05E
  48+ A05E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A05F
  50+ A05F 77               ld (hl),a
  51+ A060 23               inc hl
  52+ A061 C1               pop bc
  53+ A062 10 D4            djnz 3B
  54+ A064
  55+ A064 C9               ret
  56+ A065
  57+ A065
  58+ A065
