 614+ B18B
 615+ B18B 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B18C D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B18E 6F               ld l,a
 618+ B18F D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ B190
 620+ B190 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ B191 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ B193 67               ld h,a
