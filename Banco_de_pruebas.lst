 373  8C38 00 00        Stack defw 0 											; La rutinas de pintado, utilizan esta_
 374  8C3A              ;														; _variable para almacenar lo posición del puntero_
 375  8C3A              ; 														; _de pila, SP.
 376  8C3A 00 00        Stack_2 defw 0											; 2º variable destinada a almacenar el puntero de pila, SP.
