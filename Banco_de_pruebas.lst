 533  94CE              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 534  94CE
 535  94CE 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 536  94CF 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 537  94D0 00           Cola_de_desplazamiento db 0									; Este byte indica:
 538  94D1
 539  94D1              ;
 540  94D1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 541  94D1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 542  94D1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 543  94D1              ;
 544  94D1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 545  94D1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 546  94D1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 547  94D1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 548  94D1              ;
 549  94D1              ;															;	"$ff" ..... Bucle infinito de repetición.
 550  94D1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 551  94D1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 552  94D1
