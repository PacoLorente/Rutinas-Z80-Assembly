 489  93CE              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 490  93CE
 491  93CE 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 492  93CF 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 493  93D0 00           Cola_de_desplazamiento db 0									; Este byte indica:
 494  93D1
 495  93D1              ;
 496  93D1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 497  93D1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 498  93D1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 499  93D1              ;
 500  93D1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 501  93D1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 502  93D1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 503  93D1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 504  93D1              ;
 505  93D1              ;															;	"$ff" ..... Bucle infinito de repetición.
 506  93D1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 507  93D1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 508  93D1
