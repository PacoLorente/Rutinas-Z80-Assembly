1749  992F              ;	Por encima o igual que (Max_time_to_appear_entities).
1750  992F              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1751  992F
1752  992F 4E           	ld c,(hl)
1753  9930
