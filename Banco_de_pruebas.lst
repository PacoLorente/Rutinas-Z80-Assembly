 568+ 9F14              ;
 569+ 9F14              ;   16/9/26
 570+ 9F14              ;
 571+ 9F14              ;   Imprime TEXTO usando el CHARSET de la ROM.
 572+ 9F14              ;
 573+ 9F14              ;   Si el registro (B) es distinto de "0", la rutina usará ese valor para TEMPORIZAR la impresión de caracteres,_
 574+ 9F14              ;   _como si fuera una máquina de escribir.
 575+ 9F14
 576+ 9F14              ;   INPUTS: HL apunta al mensage a imprimir, (msg).
 577+ 9F14              ;           DE indica la fila de pantalla donde queremos imprimir el msg.
 578+ 9F14              ;            A contiene los attrs. del msg.
 579+ 9F14              ;            B Actúa como temporizador, ralentiza la impresión de caracteres, (simula una máquina de escribir).
 580+ 9F14              ;              No actua cuando su valor es "0".
 581+ 9F14              ;
 582+ 9F14              ;   MODIFY: HL y DE.
 583+ 9F14
 584+ 9F14              Print_text_msg:
 585+ 9F14
 586+ 9F14 C5               push bc                                 ;   PUSH temporizador.
 587+ 9F15
 588+ 9F15 08               ex af,af                                ;   Attr. en A´.
 589+ 9F16
 590+ 9F16 E5               push hl
 591+ 9F17 D5               push de
 592+ 9F18
 593+ 9F18 CD 51 9F         call Find_address
 594+ 9F1B
 595+ 9F1B EB               ex de,hl                                ;   BIN en DE - Fila en HL.
 596+ 9F1C
 597+ 9F1C CD 5C 9F         call Print_BIN                          ;   Imprime caracter.
 598+ 9F1F
 599+ 9F1F CD 56 9E         call Calcula_direccion_atributos
 600+ 9F22
 601+ 9F22 08               ex af,af
 602+ 9F23 77               ld (hl),a                               ;   Asigna attrs. al caracter impreso.
 603+ 9F24
 604+ 9F24 D1               pop de                                  ;   Fila de pantalla.
 605+ 9F25 E1               pop hl                                  ;   Mensaje de texto.
 606+ 9F26
 607+ 9F26              ;   Suiguiente char.
 608+ 9F26
 609+ 9F26 23               inc hl                                  ;   Siguiente caracter a imprimir.
 610+ 9F27
 611+ 9F27 34               inc (hl)
 612+ 9F28 35               dec (hl)
 613+ 9F29
 614+ 9F29 28 24            jr z,Exit_01                            ;   RET, fin de msg.
 615+ 9F2B
 616+ 9F2B 1C               inc e                                   ;   Siguiente columna de pantalla.
 617+ 9F2C
 618+ 9F2C C1               pop bc                                  ;   Carga el temporizador en B.
 619+ 9F2D
 620+ 9F2D 04               inc b
 621+ 9F2E 05               dec b
 622+ 9F2F
 623+ 9F2F 28 E3            jr z,Print_text_msg                     ;   Mensaje NO TEMPORIZADO. Siguiente char.
 624+ 9F31
 625+ 9F31              ;  Temporización del caracter.
 626+ 9F31
 627+ 9F31 08               ex af,af                                ;   attrs. del msg en AF´.
 628+ 9F32
 629+ 9F32 ED 5F            ld a,r
 630+ 9F34 CB 3F            srl a
 631+ 9F36
 632+ 9F36 CB 47            bit 0,a
 633+ 9F38 28 04            jr z,3F
 634+ 9F3A
 635+ 9F3A 06 5A            ld b,90
 636+ 9F3C 18 02            jr 1F
 637+ 9F3E
 638+ 9F3E 06 82        3 ld b,130
 639+ 9F40
 640+ 9F40 0E FF        1 ld c,$ff
 641+ 9F42
 642+ 9F42 0D           2 dec c
 643+ 9F43 20 FD            jr nz,2B
 644+ 9F45
 645+ 9F45 10 F9            djnz 1B                                 ;   Aplica temporización.
 646+ 9F47
 647+ 9F47 CD 49 C1         call BEEP
 648+ 9F4A
 649+ 9F4A 06 01            ld b,1                                  ;   Activa retardo RND en el próximo char. a imprimir.
 650+ 9F4C
 651+ 9F4C 08               ex af,af                                ;   Recupera attrs. en A.
 652+ 9F4D
 653+ 9F4D 18 C5            jr Print_text_msg
 654+ 9F4F
