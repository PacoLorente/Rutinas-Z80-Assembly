# file opened: Patrones_de_mov.asm
   1+ A5E1
   2+ A5E1
   3+ A5E1              ;   07/07/23
   4+ A5E1              ;
   5+ A5E1              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ A5E1              ;
   7+ A5E1              ;   Codificación:
   8+ A5E1              ;
   9+ A5E1              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ A5E1              ;
  11+ A5E1              ;   Un desplazamiento tiene la siguiente estructura:
  12+ A5E1              ;
  13+ A5E1              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ A5E1              ;
  15+ A5E1              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ A5E1              ;
  17+ A5E1              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ A5E1              ;                               ..... %01000010 Vel_up 4
  19+ A5E1              ;                                               Vel_down 2
  20+ A5E1              ;                               ..... $42
  21+ A5E1              ;
  22+ A5E1              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ A5E1              ;
  24+ A5E1              ;                               ..... %01000010 Vel_left 4
  25+ A5E1              ;                                               Vel_right 2
  26+ A5E1              ;                               ..... $42
  27+ A5E1              ;
  28+ A5E1              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ A5E1              ;
  30+ A5E1              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ A5E1              ;
  32+ A5E1              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ A5E1              ;
  34+ A5E1              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ A5E1              ;                                     $53
  36+ A5E1              ;
  37+ A5E1              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ A5E1              ;
  39+ A5E1              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ A5E1              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ A5E1              ;
  42+ A5E1              ;                       Arriba ..... $81
  43+ A5E1              ;                       Arriba - izquierda ..... $a1
  44+ A5E1              ;                       Arriba - derecha ..... $91
  45+ A5E1              ;
  46+ A5E1              ;                       Abajo ..... $41
  47+ A5E1              ;                       Abajo - izquierda ..... $61
  48+ A5E1              ;                       Abajo - derecha ..... $51
  49+ A5E1              ;
  50+ A5E1              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ A5E1              ;
  52+ A5E1              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ A5E1              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ A5E1              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ A5E1              ;
  56+ A5E1              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ A5E1              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ A5E1              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ A5E1              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ A5E1              ;
  61+ A5E1              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ A5E1              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ A5E1              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ A5E1              ;
  65+ A5E1              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ A5E1              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ A5E1              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ A5E1              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ A5E1
