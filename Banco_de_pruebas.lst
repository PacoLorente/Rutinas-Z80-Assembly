# file opened: Patrones_de_mov.asm
   1+ 9307
   2+ 9307
   3+ 9307              ;   07/07/23
   4+ 9307              ;
   5+ 9307              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 9307              ;
   7+ 9307              ;   Codificación:
   8+ 9307              ;
   9+ 9307              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 9307              ;
  11+ 9307              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 9307              ;
  13+ 9307              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 9307              ;
  15+ 9307              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 9307              ;
  17+ 9307              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 9307              ;                               ..... %01000010 Vel_up 4
  19+ 9307              ;                                               Vel_down 2
  20+ 9307              ;                               ..... $42
  21+ 9307              ;
  22+ 9307              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 9307              ;
  24+ 9307              ;                               ..... %01000010 Vel_left 4
  25+ 9307              ;                                               Vel_right 2
  26+ 9307              ;                               ..... $42
  27+ 9307              ;
  28+ 9307              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 9307              ;
  30+ 9307              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 9307              ;
  32+ 9307              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 9307              ;
  34+ 9307              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 9307              ;                                     $53
  36+ 9307              ;
  37+ 9307              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 9307              ;
  39+ 9307              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 9307              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 9307              ;
  42+ 9307              ;                       Arriba ..... $81
  43+ 9307              ;                       Arriba - izquierda ..... $a1
  44+ 9307              ;                       Arriba - derecha ..... $91
  45+ 9307              ;
  46+ 9307              ;                       Abajo ..... $41
  47+ 9307              ;                       Abajo - izquierda ..... $61
  48+ 9307              ;                       Abajo - derecha ..... $51
  49+ 9307              ;
  50+ 9307              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 9307              ;
  52+ 9307              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 9307              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 9307              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 9307              ;
  56+ 9307              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 9307              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 9307              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 9307              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 9307              ;
  61+ 9307              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 9307              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 9307              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 9307              ;
  65+ 9307              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 9307              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 9307              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 9307              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 9307
