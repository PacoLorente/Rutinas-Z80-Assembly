 308+ C152              ; ----------------------------------------------------------------------------------------------
 309+ C152              ;
 310+ C152              ;   17/9/26
 311+ C152              ;
 312+ C152              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C152              ;
 314+ C152              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C152
 316+ C152              BEEP:
 317+ C152
 318+ C152 F5               push af
 319+ C153 C5               push bc
 320+ C154 D5               push de
 321+ C155 E5               push hl                                 ; STORE Regs.
 322+ C156
 323+ C156              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C156
 325+ C156              ;   Configuración de un BEEP.
 326+ C156
 327+ C156              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C156              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C156              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C156              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C156              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C156
 333+ C156
 334+ C156 01 02 00         ld bc,$0002
 335+ C159 11 00 00         ld de,0
 336+ C15C 21 D0 00         ld hl,$00d0
 337+ C15F
 338+ C15F 22 06 96         ld (Sound),hl
 339+ C162
 340+ C162 CD 61 9F         call Sound_Generator    ; v2. Ok.
 341+ C165
 342+ C165 21 00 00         ld hl,0
 343+ C168 22 06 96         ld (Sound),hl
 344+ C16B
 345+ C16B E1               pop hl                                  ; RECOVERY Regs.
 346+ C16C D1               pop de
 347+ C16D C1               pop bc
 348+ C16E F1               pop af
 349+ C16F
 350+ C16F C9               ret
 351+ C170
 352+ C170              ; ----- ----- ----- ----- -----
 353+ C170              ;
 354+ C170              ;   23/9/26
 355+ C170              ;
 356+ C170              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C170              ;
 358+ C170              ;   HL define el sonido.
 359+ C170              ;
 360+ C170              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C170              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C170              ;
 363+ C170              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C170              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C170              ;
 366+ C170              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C170              ;
 368+ C170              ;   INPUTS: (Shot_sound) <> "0".
 369+ C170              ;
 370+ C170              ;   MODIFY: AF, HL y BC.
 371+ C170              ;
 372+ C170              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C170
 374+ C170              Play_shot_sound_effect:
 375+ C170
 376+ C170              ;   Exclusiones:
 377+ C170
 378+ C170 2A 0A 96         ld hl,(Shot_sound)
 379+ C173 7C               ld a,h
 380+ C174 B5               or l
 381+ C175 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C176
 383+ C176 3A DD 95         ld a,(Ctrl_6)
 384+ C179 CB 47            bit 0,a
 385+ C17B C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C17C
 387+ C17C 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C17E
 389+ C17E              Loop_1:
 390+ C17E
 391+ C17E 3E 10            ld a,%00010000          ; Borde negro.
 392+ C180 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C182
 394+ C182 45               ld b,l
 395+ C183
 396+ C183 10 FE        Delay_3 djnz Delay_3
 397+ C185
 398+ C185 AF               xor a                   ; Borde negro.
 399+ C186 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C188
 401+ C188 45               ld b,l
 402+ C189
 403+ C189 10 FE        Delay_4 djnz Delay_4
 404+ C18B
 405+ C18B              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C18B
 407+ C18B 2C               inc l
 408+ C18C 2C               inc l
 409+ C18D 2C               inc l
 410+ C18E 2C               inc l
 411+ C18F
 412+ C18F 25               dec h
 413+ C190
 414+ C190 CC 9A C1         call z,Clean_shot_effect
 415+ C193
 416+ C193 0D               dec c
 417+ C194
 418+ C194 20 E8            jr nz,Loop_1
 419+ C196
 420+ C196 22 0A 96         ld (Shot_sound),hl
 421+ C199
 422+ C199 C9               ret
 423+ C19A
 424+ C19A              Clean_shot_effect:
 425+ C19A
 426+ C19A 21 00 00         ld hl,0
 427+ C19D 0E 01            ld c,1
 428+ C19F
 429+ C19F C9               ret
 430+ C1A0
 431+ C1A0              ;   -------------------------------------------------------------------------------------------
 432+ C1A0              ;
 433+ C1A0              ;   23/9/26
 434+ C1A0              ;
 435+ C1A0              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C1A0              ;
 437+ C1A0              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C1A0              ;   _ [Sound_Generator].
 439+ C1A0              ;
 440+ C1A0              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C1A0              ;
 442+ C1A0              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C1A0              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C1A0              ;
 445+ C1A0              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C1A0              ;
 447+ C1A0              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C1A0              ;
 449+ C1A0              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C1A0
 451+ C1A0              Play_burst_sound_effect:
 452+ C1A0
 453+ C1A0              ;   Exclusiones:
 454+ C1A0
 455+ C1A0 3A 0C 96         ld a,(Burst_sound)
 456+ C1A3 A7               and a
 457+ C1A4 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C1A5
 459+ C1A5 08               ex af,af
 460+ C1A6
 461+ C1A6 3A DD 95         ld a,(Ctrl_6)
 462+ C1A9 CB 47            bit 0,a
 463+ C1AB C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C1AC
 465+ C1AC              ;   ----------------------
 466+ C1AC
 467+ C1AC CB C7            set 0,a
 468+ C1AE 32 DD 95         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C1B1
 470+ C1B1 08               ex af,af                ; Restore (Burst_sound).
 471+ C1B2
 472+ C1B2 67               ld h,a
 473+ C1B3 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1B5
 475+ C1B5 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1B6
 477+ C1B6 22 06 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1B9 0E 03            ld c,3
 479+ C1BB CD 9A 9F         call Noise_efect
 480+ C1BE
 481+ C1BE D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1BF
 483+ C1BF 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1C0 94               sub h
 485+ C1C1
 486+ C1C1 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1C3
 488+ C1C3 7C               ld a,h
 489+ C1C4 32 0C 96         ld (Burst_sound),a
 490+ C1C7
 491+ C1C7 C9               ret
 492+ C1C8
 493+ C1C8              Clean_burst_efect:
 494+ C1C8
 495+ C1C8 AF               xor a
 496+ C1C9 32 0C 96         ld (Burst_sound),a
 497+ C1CC
 498+ C1CC 3A DD 95         ld a,(Ctrl_6)
 499+ C1CF CB 87            res 0,a
 500+ C1D1 32 DD 95         ld (Ctrl_6),a
 501+ C1D4
 502+ C1D4 C9               ret
 503+ C1D5
 504+ C1D5              ;   -------------------------------------------------------------------------------------------
 505+ C1D5              ;
 506+ C1D5              ;   23/9/26
 507+ C1D5              ;
 508+ C1D5              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1D5              ;   _ Shield_sound_effect.
 510+ C1D5              ;
 511+ C1D5              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1D5              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1D5              ;
 514+ C1D5              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1D5              ;
 516+ C1D5              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1D5              ;
 518+ C1D5              ;   MODIFY: AF'y BC.
 519+ C1D5
 520+ C1D5              Play_Shield_sound_effect:
 521+ C1D5
 522+ C1D5 3A 0D 96         ld a,(Shield_sound)
 523+ C1D8 A7               and a
 524+ C1D9 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1DA
 526+ C1DA 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1DC
 528+ C1DC              Loop_3:
 529+ C1DC
 530+ C1DC 08               ex af,af
 531+ C1DD
 532+ C1DD 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1DF D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1E1
 535+ C1E1 08               ex af,af
 536+ C1E2
 537+ C1E2 47               ld b,a
 538+ C1E3
 539+ C1E3 10 FE        Delay_7 djnz Delay_7
 540+ C1E5
 541+ C1E5 08               ex af,af
 542+ C1E6
 543+ C1E6 AF               xor a                   ; Black BORDER.
 544+ C1E7 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1E9
 546+ C1E9 08               ex af,af
 547+ C1EA
 548+ C1EA 47               ld b,a
 549+ C1EB
 550+ C1EB 10 FE        Delay_8 djnz Delay_8
 551+ C1ED
 552+ C1ED 0D               dec c
 553+ C1EE
 554+ C1EE 20 EC            jr nz,Loop_3
 555+ C1F0
 556+ C1F0 AF               xor a
 557+ C1F1 32 0D 96         ld (Shield_sound),a
 558+ C1F4
 559+ C1F4 C9               ret
 560+ C1F5
 561+ C1F5              ; ---------------------------------------------------------------
 562+ C1F5              ;
 563+ C1F5              ;   18/9/26
 564+ C1F5              ;
 565+ C1F5              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C1F5              ;
 567+ C1F5              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C1F5              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C1F5              ;
 570+ C1F5              ;   MODIFY: A y H.
 571+ C1F5              ;
 572+ C1F5              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C1F5
 574+ C1F5
 575+ C1F5              Init_Burst_sound:
 576+ C1F5
 577+ C1F5 3A 0C 96         ld a,(Burst_sound)
 578+ C1F8 A7               and a
 579+ C1F9 C0               ret nz                                           ; RET si ya está iniciado el efecto.
 580+ C1FA
 581+ C1FA              ;   Init Burst_sound_efect.
 582+ C1FA
 583+ C1FA              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C1FA
 585+ C1FA 26 35            ld h,Burst_sound_init_value
 586+ C1FC
 587+ C1FC 3A CF 90         ld a,(Impacto_Amadeus)
 588+ C1FF A7               and a
 589+ C200 28 02            jr z,1F
 590+ C202
 591+ C202 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C204
 593+ C204 7C           1 ld a,h
 594+ C205
 595+ C205 32 0C 96         ld (Burst_sound),a
 596+ C208
 597+ C208 C9               ret
