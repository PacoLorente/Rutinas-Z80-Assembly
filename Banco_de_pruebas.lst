 427+ C195              ;
 428+ C195              ;   23/9/26
 429+ C195              ;
 430+ C195              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 431+ C195              ;   _ Shield_sound_effect.
 432+ C195              ;
 433+ C195              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 434+ C195              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 435+ C195              ;
 436+ C195              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 437+ C195              ;
 438+ C195              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 439+ C195              ;
 440+ C195              ;   MODIFY: AF'y BC.
 441+ C195
 442+ C195              Play_Shield_sound_effect:
 443+ C195
 444+ C195 3A EC 94         ld a,(Shield_sound)
 445+ C198 A7               and a
 446+ C199 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 447+ C19A
 448+ C19A 0E 02            ld c,2                  ; 2 ondas completas per frame.
 449+ C19C
 450+ C19C              Loop_3:
 451+ C19C
 452+ C19C 08               ex af,af
 453+ C19D
 454+ C19D 3E 10            ld a,%00010000          ; Black BORDER.
 455+ C19F D3 FE            out ($fe),a             ; Beeper ON.
 456+ C1A1
 457+ C1A1 08               ex af,af
 458+ C1A2
 459+ C1A2 47               ld b,a
 460+ C1A3
 461+ C1A3 10 FE        Delay_7 djnz Delay_7
 462+ C1A5
 463+ C1A5 08               ex af,af
 464+ C1A6
 465+ C1A6 AF               xor a                   ; Black BORDER.
 466+ C1A7 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 467+ C1A9
 468+ C1A9 08               ex af,af
 469+ C1AA
 470+ C1AA 47               ld b,a
 471+ C1AB
 472+ C1AB 10 FE        Delay_8 djnz Delay_8
 473+ C1AD
 474+ C1AD 0D               dec c
 475+ C1AE
 476+ C1AE 20 EC            jr nz,Loop_3
 477+ C1B0
 478+ C1B0 AF               xor a
 479+ C1B1 32 EC 94         ld (Shield_sound),a
 480+ C1B4
 481+ C1B4 C9               ret
