 615  94DA 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 616  94DB              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 617  94DB              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 618  94DB
 619  94DB 00           Incrementa_puntero_backup db 0
 620  94DC 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 621  94DD              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 622  94DD
 623  94DD 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 624  94DE 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 625  94DF 00           Cola_de_desplazamiento db 0									; Este byte indica:
 626  94E0
 627  94E0              ;
 628  94E0              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 629  94E0              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 630  94E0              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 631  94E0              ;
 632  94E0              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 633  94E0              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 634  94E0              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 635  94E0              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 636  94E0              ;
 637  94E0              ;															;	"$ff" ..... Bucle infinito de repetición.
 638  94E0              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 639  94E0              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 640  94E0
