 395+ C30C              ;       db 4                                                    ; N° de espacios que separan en pantalla la cadena de texto de la tecla definida.
 396+ C30C              ;
 397+ C30C              ;   Utilizaremos la variable: (Puntero_de_impresion) para guardar la posición del puntero indicial, (hl).
 398+ C30C              ;   Nota: Antes de salir de la función restauraremos su valor a "$0000".
 399+ C30C              ;
 400+ C30C              ;   MODIFY: AF, HL, HL´, DE, DE´, BC, IX
