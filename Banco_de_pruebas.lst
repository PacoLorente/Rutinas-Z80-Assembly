 564  94C1              ;
 565  94C1              ;
 566  94C1 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 567  94C2              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
