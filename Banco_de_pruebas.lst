   5+ 93CC              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93CC              ;   (XOR) bit a bit.
   7+ 93CC              ;
   8+ 93CC              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93CC
  10+ 93CC              Derivando_RND
  11+ 93CC
  12+ 93CC 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93CF
  14+ 93CF ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93D1 C5               push bc
  16+ 93D2              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93D2 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 93D5              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 93D5
  20+ 93D5 A7           6 and a                                 ; Carry a "0".
  21+ 93D6 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 93D8 30 02            jr nc,1F
  23+ 93DA
  24+ 93DA CB C1            set 0,c
  25+ 93DC
  26+ 93DC 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 93DD E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 93DF 5F               ld e,a
  29+ 93E0
  30+ 93E0 7A               ld a,d
  31+ 93E1 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 93E3 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 93E5
  34+ 93E5 CB 3F            srl a
  35+ 93E7
  36+ 93E7 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 93E8
  38+ 93E8 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 93E9 28 04            jr z,4F
  40+ 93EB
  41+ 93EB CB FF            set 7,a
  42+ 93ED 18 02            jr 5F
  43+ 93EF
  44+ 93EF CB BF        4 res 7,a
  45+ 93F1
  46+ 93F1 CB 21        5 sla c
  47+ 93F3 10 E0            djnz 6B
  48+ 93F5
  49+ 93F5 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 93F6
  51+ 93F6 77               ld (hl),a
  52+ 93F7 23               inc hl
  53+ 93F8 C1               pop bc
  54+ 93F9 10 D4            djnz 3B
  55+ 93FB
  56+ 93FB C9               ret
