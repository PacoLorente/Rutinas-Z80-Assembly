 359  91AD              ;																DESCRIPCIÓN:
 360  91AD              ;
 361  91AD              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 362  91AD              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 363  91AD              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 364  91AD              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 365  91AD              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 366  91AD              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 367  91AD
 368  91AD              ;															BIT 3, Recarga de nueva oleada.
 369  91AD              ;															BIT 4, Recarga de nueva oleada.
 370  91AD              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 371  91AD              ;															BIT 6, **** Frame completo.
 372  91AD              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 373  91AD
