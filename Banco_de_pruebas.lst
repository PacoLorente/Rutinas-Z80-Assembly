 356+ C10E              ; ----- ----- ----- ----- -----
 357+ C10E              ;
 358+ C10E              ;   23/9/26
 359+ C10E              ;
 360+ C10E              ;   El efecto del disparo de Amadeus es de tipo descendente.
 361+ C10E              ;
 362+ C10E              ;   HL define el sonido.
 363+ C10E              ;
 364+ C10E              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 365+ C10E              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 366+ C10E              ;
 367+ C10E              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 368+ C10E              ;   _ escudo tienen prioridad sobre este efecto.
 369+ C10E              ;
 370+ C10E              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 371+ C10E              ;
 372+ C10E              ;   INPUTS: (Shot_sound) <> "0".
 373+ C10E              ;
 374+ C10E              ;   MODIFY: AF, HL y BC.
 375+ C10E              ;
 376+ C10E              ;   OUTPUT: (Shot_sound) actualizado.
 377+ C10E
 378+ C10E              Play_shot_sound_effect:
 379+ C10E
 380+ C10E              ;   Exclusiones:
 381+ C10E
 382+ C10E 2A 89 94         ld hl,(Shot_sound)
 383+ C111 7C               ld a,h
 384+ C112 B5               or l
 385+ C113 C8               ret z                   ; RET si no se ha producido disparo.
 386+ C114
 387+ C114 3A 5B 94         ld a,(Ctrl_6)
 388+ C117 CB 47            bit 0,a
 389+ C119 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 390+ C11A
 391+ C11A 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
