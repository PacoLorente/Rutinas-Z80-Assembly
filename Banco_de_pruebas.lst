 138  8C07              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 8C07
   2+ 8C07
   3+ 8C07              ;   07/07/23
   4+ 8C07              ;
   5+ 8C07              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8C07              ;
   7+ 8C07              ;   Codificación:
   8+ 8C07              ;
   9+ 8C07              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8C07              ;
  11+ 8C07              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8C07              ;
  13+ 8C07              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8C07              ;
  15+ 8C07              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8C07              ;
  17+ 8C07              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8C07              ;                               ..... %01000010 Vel_up 4
  19+ 8C07              ;                                               Vel_down 2
  20+ 8C07              ;                               ..... $42
  21+ 8C07              ;
  22+ 8C07              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8C07              ;
  24+ 8C07              ;                               ..... %01000010 Vel_left 4
  25+ 8C07              ;                                               Vel_right 2
  26+ 8C07              ;                               ..... $42
  27+ 8C07              ;
  28+ 8C07              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8C07              ;
  30+ 8C07              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8C07              ;
  32+ 8C07              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8C07              ;
  34+ 8C07              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8C07              ;                                     $53
  36+ 8C07              ;
  37+ 8C07              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8C07              ;
  39+ 8C07              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8C07              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8C07              ;
  42+ 8C07              ;                       Arriba ..... $81
  43+ 8C07              ;                       Arriba - izquierda ..... $a1
  44+ 8C07              ;                       Arriba - derecha ..... $91
  45+ 8C07              ;
  46+ 8C07              ;                       Abajo ..... $41
  47+ 8C07              ;                       Abajo - izquierda ..... $61
  48+ 8C07              ;                       Abajo - derecha ..... $51
  49+ 8C07              ;
  50+ 8C07              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8C07              ;
  52+ 8C07              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8C07              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8C07              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8C07              ;
  56+ 8C07              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8C07              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8C07              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8C07              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8C07              ;
  61+ 8C07              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8C07              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8C07              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8C07              ;
  65+ 8C07              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8C07              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8C07              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8C07              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8C07
  70+ 8C07              ; ----- ----- ----- ----- -----
  71+ 8C07
  72+ 8C07              Indice_mov_Baile_de_BadSat
  73+ 8C07
  74+ 8C07 0B 8C            defw Left_Ini
  75+ 8C09 37 8C            defw Right_Ini
  76+ 8C0B
  77+ 8C0B
  78+ 8C0B 63 8C        Left_Ini defw Bajo_decelerando
  79+ 8C0D 6B 8C            defw F_1
  80+ 8C0F 75 8C            defw F_2
  81+ 8C11 7F 8C            defw Codo_abajo_derecha
  82+ 8C13 B3 8C            defw Derecha_y_subiendo
