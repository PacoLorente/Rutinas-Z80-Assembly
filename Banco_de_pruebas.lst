 621  94FD 00           Cola_de_desplazamiento db 0									; Este byte indica:
 622  94FE
 623  94FE              ;
 624  94FE              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 625  94FE              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 626  94FE              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 627  94FE              ;
 628  94FE              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 629  94FE              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 630  94FE              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 631  94FE              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 632  94FE              ;
 633  94FE              ;															;	"$ff" ..... Bucle infinito de repetición.
 634  94FE              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 635  94FE              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 636  94FE
