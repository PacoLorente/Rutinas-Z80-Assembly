   1+ C036              ; ----------------------------------------------------------
   2+ C036              ;
   3+ C036              ;   26/09/26
   4+ C036              ;
   5+ C036              ;   Voy a utilizar los 6 bytes de las variables:
   6+ C036              ;
   7+ C036              ;   (Indice_Sprite_der)
   8+ C036              ;   (Indice_Sprite_izq)
   9+ C036              ;   (Puntero_DESPLZ_der)
  10+ C036              ;
  11+ C036              ;   Para almacenar el perfil de la nota que está en ejecución pues la rutina se ejecuta "IN GAME TIME" y sólo reproducirá 4 ondas_
  12+ C036              ;   _del total que forman la nota.
  13+ C036              ;
  14+ C036              ;   La rutina genera un "ruido" o especie de zumbido ascendente/descendente llamando a la rutina [Sound_Generator].
  15+ C036              ;   La melodía consta de dos notas incluidas en el índice: "Game_over_noise_index:". El puntero (Puntero_game_over_noise) avanza_
  16+ C036              ;   _ por el índice proporcionando los datos de las notas a la rutina.
  17+ C036              ;
  18+ C036              ;   La rutina [Sound_Generator] requiere que los parámetros de la nota a ejecutar se den de la siguiente forma:
  19+ C036              ;
  20+ C036              ;           C contiene el nº de veces que vamos a generar la onda del sonido.
  21+ C036              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
  22+ C036              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
  23+ C036              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
  24+ C036              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
  25+ C036              ;
  26+ C036              ;   MODIFY: AF, HL, BC y DE, (Puntero_game_over_noise).
  27+ C036
  28+ C036              Game_over_noise:
  29+ C036
  30+ C036              ;   Nota en ejecución??
  31+ C036
  32+ C036 21 7E 95         ld hl,Indice_Sprite_der                           ; Caja de nota en ejecución.
  33+ C039 7E               ld a,(hl)
  34+ C03A A7               and a
  35+ C03B 28 02            jr z,New_note                                     ; Caja vacía o anterior nota finalizada. Adquiere una nueva nota del índice de notas de la canción.
  36+ C03D
  37+ C03D 18 0F            jr Get_note                                       ; No hemos terminado de ejecutar la nota. Recuperamos el 'resto' de la nota de la caja.
  38+ C03F
  39+ C03F              ;   Extrae una nueva, (o primera nota) del índice de notas de la canción.
  40+ C03F
  41+ C03F              New_note:
  42+ C03F
  43+ C03F 2A 0F 96         ld hl,(Puntero_game_over_noise)
  44+ C042 CD 46 9E         call Extrae_address
  45+ C045
  46+ C045              ;   Detecta final de canción.
  47+ C045
  48+ C045 7C               ld a,h
  49+ C046 B5               or l
  50+ C047 C8               ret z
  51+ C048
  52+ C048              ;   Actualiza el puntero de notas, (Puntero_musical).
  53+ C048
  54+ C048 13               inc de
  55+ C049 13               inc de
  56+ C04A
  57+ C04A ED 53 0F 96      ld (Puntero_game_over_noise),de                   ; Puntero situado en la siguiente nota del índice.
  58+ C04E
  59+ C04E              Get_note:
  60+ C04E
  61+ C04E ED 73 B0 95      ld (Stack),sp
  62+ C052
  63+ C052 F9               ld sp,hl
  64+ C053
  65+ C053 C1               pop bc                                            ; (B) siempre "0", (C) indica duración de la nota, (n°de ondas).
  66+ C054 D1               pop de                                            ; (DE) siempre contendrá "0".
  67+ C055 E1               pop hl                                            ; (H) = "0", (L) contiene el valor de la nota.
  68+ C056
  69+ C056              ;   Tenemos la nota cargada en os registros.
  70+ C056              ;   Determinamos si la nota se ejecuta con incremento o decremento.
