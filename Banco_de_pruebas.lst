 781+ B5BB              ;	5/08/22
 782+ B5BB              ;
 783+ B5BB              ;   NextScan.
 784+ B5BB              ;
 785+ B5BB              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B5BB              ;
 787+ B5BB              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B5BB              ;
 789+ B5BB              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B5BB              ;
 791+ B5BB              ;       DESTRUIDOS: AF y HL !!!
 792+ B5BB              ;
 793+ B5BB              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B5BB              ;
 795+ B5BB
 796+ B5BB              NextScan:
 797+ B5BB
 798+ B5BB 24           	inc h          							; Incrementamos el scanline.
 799+ B5BC 7C               ld a,h
 800+ B5BD E6 07            and 7
 801+ B5BF C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B5C0
 803+ B5C0 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B5C1 C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B5C3 6F               ld l,a
 806+ B5C4 D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B5C5
 808+ B5C5 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B5C6 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B5C8 67               ld h,a
 811+ B5C9 C9               ret
 812+ B5CA
