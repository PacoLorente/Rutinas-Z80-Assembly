 230+ C0EF 15               dec d
 231+ C0F0 1D               dec e                                                   ; Prepara Nota descendente / "0" decrease. Sonido plano.
 232+ C0F1              ;                                                           ; (HL) ha subido hasta $00fa.
 233+ C0F1 0E 16            ld c,$16                                                ; Duración, 22 ondas de sonido.
 234+ C0F3
 235+ C0F3 22 06 96     	ld (Sound),hl
 236+ C0F6 CD 67 9F         call Sound_Generator 									; PLAY NOTE.
 237+ C0F9
