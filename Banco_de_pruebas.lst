 416  9402 00 00        Puntero_tabla_Random defw 0
 417  9404 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 418  9406 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 419  9408 00 00        Puntero_indice_mov_bucle defw 0
 420  940A              ;
 421  940A              ;
 422  940A 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 423  940B              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
