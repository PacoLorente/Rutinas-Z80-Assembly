   4+ 9C24              ;
   5+ 9C24              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9C24              ;   (XOR) bit a bit.
   7+ 9C24              ;
   8+ 9C24              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9C24              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9C24
  11+ 9C24              Derivando_RND
  12+ 9C24
  13+ 9C24 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9C26 C5               push bc
  15+ 9C27              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9C27 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9C2A              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9C2A
  19+ 9C2A A7           6 and a                                 ; Carry a "0".
  20+ 9C2B CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9C2D 30 02            jr nc,1F
  22+ 9C2F
  23+ 9C2F CB C1            set 0,c
  24+ 9C31
  25+ 9C31 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9C32 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9C34 5F               ld e,a
  28+ 9C35
  29+ 9C35 7A               ld a,d
  30+ 9C36 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9C38 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9C3A
  33+ 9C3A CB 3F            srl a
  34+ 9C3C
  35+ 9C3C AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9C3D
  37+ 9C3D 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9C3E 28 04            jr z,4F
  39+ 9C40
  40+ 9C40 CB FF            set 7,a
  41+ 9C42 18 02            jr 5F
  42+ 9C44
  43+ 9C44 CB BF        4 res 7,a
  44+ 9C46
  45+ 9C46 CB 21        5 sla c
  46+ 9C48 10 E0            djnz 6B
  47+ 9C4A
  48+ 9C4A 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C4B
  50+ 9C4B 77               ld (hl),a
  51+ 9C4C 23               inc hl
  52+ 9C4D C1               pop bc
  53+ 9C4E 10 D4            djnz 3B
  54+ 9C50
  55+ 9C50 C9               ret
  56+ 9C51
  57+ 9C51
  58+ 9C51
