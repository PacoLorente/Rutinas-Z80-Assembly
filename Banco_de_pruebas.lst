 309  8CC7 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CC8
 311  8CC8              ;
 312  8CC8              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CC8              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CC8              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CC8              ;
 316  8CC8              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CC8              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CC8              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CC8              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CC8              ;
 321  8CC8              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CC8              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CC8              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8CC8
 325  8CC8 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 326  8CC9
 327  8CC9              ;																DESCRIPCIÓN:
 328  8CC9              ;
 329  8CC9              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 330  8CC9              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 331  8CC9              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 332  8CC9              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 333  8CC9              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 334  8CC9              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 335  8CC9
 336  8CC9              ;																BIT 3, Recarga de nueva oleada.
 337  8CC9              ;																BIT 4, Recarga de nueva oleada.
 338  8CC9              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 339  8CC9              ;																BIT 6, **** Frame completo.
 340  8CC9              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 341  8CC9
 342  8CC9 00 00        Repone_puntero_objeto defw 0				; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 343  8CCB              ; 																; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 344  8CCB              ; 																; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 345  8CCB              ;																; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 346  8CCB
