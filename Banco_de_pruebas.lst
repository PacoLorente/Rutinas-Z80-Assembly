 291+ C139 2D               dec l                                                   ; Note: $00fa.
 292+ C13A
 293+ C13A 1D               dec e
 294+ C13B 1D               dec e                                                   ; Clear increase.
 295+ C13C
 296+ C13C 0E 40            ld c,$40                                                ; Duration.
 297+ C13E
 298+ C13E 22 06 96         ld (Sound),hl
 299+ C141 CD 67 9F         call Sound_Generator                                    ; PLAY NOTE.
 300+ C144
 301+ C144 E1               pop hl
 302+ C145 D1               pop de
 303+ C146 C1               pop bc
 304+ C147 F1               pop af                                                  ; Restore regs.
 305+ C148
 306+ C148 C9               ret
 307+ C149
 308+ C149              ; ----------------------------------------------------------------------------------------------
 309+ C149              ;
 310+ C149              ;   17/9/26
 311+ C149              ;
 312+ C149              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C149              ;
 314+ C149              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C149
 316+ C149              BEEP:
 317+ C149
 318+ C149 F5               push af
 319+ C14A C5               push bc
 320+ C14B D5               push de
 321+ C14C E5               push hl                                 ; STORE Regs.
 322+ C14D
 323+ C14D              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C14D
 325+ C14D              ;   Configuración de un BEEP.
 326+ C14D
 327+ C14D              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C14D              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C14D              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C14D              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C14D              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C14D
 333+ C14D
 334+ C14D 01 02 00         ld bc,$0002
 335+ C150 11 00 00         ld de,0
 336+ C153 21 D0 00         ld hl,$00d0
 337+ C156
 338+ C156 22 06 96         ld (Sound),hl
 339+ C159
 340+ C159 CD 67 9F         call Sound_Generator    ; v2. Ok.
 341+ C15C
 342+ C15C 21 00 00         ld hl,0
 343+ C15F 22 06 96         ld (Sound),hl
 344+ C162
 345+ C162 E1               pop hl                                  ; RECOVERY Regs.
 346+ C163 D1               pop de
 347+ C164 C1               pop bc
 348+ C165 F1               pop af
 349+ C166
 350+ C166 C9               ret
 351+ C167
 352+ C167              ; ----- ----- ----- ----- -----
 353+ C167              ;
 354+ C167              ;   23/9/26
 355+ C167              ;
 356+ C167              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C167              ;
 358+ C167              ;   HL define el sonido.
 359+ C167              ;
 360+ C167              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C167              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C167              ;
 363+ C167              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C167              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C167              ;
 366+ C167              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C167              ;
 368+ C167              ;   INPUTS: (Shot_sound) <> "0".
 369+ C167              ;
 370+ C167              ;   MODIFY: AF, HL y BC.
 371+ C167              ;
 372+ C167              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C167
 374+ C167              Play_shot_sound_effect:
 375+ C167
 376+ C167              ;   Exclusiones:
 377+ C167
 378+ C167 2A 0A 96         ld hl,(Shot_sound)
 379+ C16A 7C               ld a,h
 380+ C16B B5               or l
 381+ C16C C8               ret z                   ; RET si no se ha producido disparo.
 382+ C16D
 383+ C16D 3A DD 95         ld a,(Ctrl_6)
 384+ C170 CB 47            bit 0,a
 385+ C172 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C173
 387+ C173 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C175
 389+ C175              Loop_1:
 390+ C175
 391+ C175 3E 10            ld a,%00010000          ; Borde negro.
 392+ C177 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C179
 394+ C179 45               ld b,l
 395+ C17A
 396+ C17A 10 FE        Delay_3 djnz Delay_3
 397+ C17C
 398+ C17C AF               xor a                   ; Borde negro.
 399+ C17D D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C17F
 401+ C17F 45               ld b,l
 402+ C180
 403+ C180 10 FE        Delay_4 djnz Delay_4
 404+ C182
 405+ C182              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C182
 407+ C182 2C               inc l
 408+ C183 2C               inc l
 409+ C184 2C               inc l
 410+ C185 2C               inc l
 411+ C186
 412+ C186 25               dec h
 413+ C187
 414+ C187 CC 91 C1         call z,Clean_shot_effect
 415+ C18A
 416+ C18A 0D               dec c
 417+ C18B
 418+ C18B 20 E8            jr nz,Loop_1
 419+ C18D
 420+ C18D 22 0A 96         ld (Shot_sound),hl
 421+ C190
 422+ C190 C9               ret
 423+ C191
 424+ C191              Clean_shot_effect:
 425+ C191
 426+ C191 21 00 00         ld hl,0
 427+ C194 0E 01            ld c,1
 428+ C196
 429+ C196 C9               ret
 430+ C197
 431+ C197              ;   -------------------------------------------------------------------------------------------
 432+ C197              ;
 433+ C197              ;   23/9/26
 434+ C197              ;
 435+ C197              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C197              ;
 437+ C197              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C197              ;   _ [Sound_Generator].
 439+ C197              ;
 440+ C197              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C197              ;
 442+ C197              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C197              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C197              ;
 445+ C197              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C197              ;
 447+ C197              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C197              ;
 449+ C197              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C197
 451+ C197              Play_burst_sound_effect:
 452+ C197
 453+ C197              ;   Exclusiones:
 454+ C197
 455+ C197 3A 0C 96         ld a,(Burst_sound)
 456+ C19A A7               and a
 457+ C19B C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C19C
 459+ C19C 08               ex af,af
 460+ C19D
 461+ C19D 3A DD 95         ld a,(Ctrl_6)
 462+ C1A0 CB 47            bit 0,a
 463+ C1A2 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C1A3
 465+ C1A3              ;   ----------------------
 466+ C1A3
 467+ C1A3 CB C7            set 0,a
 468+ C1A5 32 DD 95         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C1A8
 470+ C1A8 08               ex af,af                ; Restore (Burst_sound).
 471+ C1A9
 472+ C1A9 67               ld h,a
 473+ C1AA 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1AC
 475+ C1AC E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1AD
 477+ C1AD 22 06 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1B0 0E 03            ld c,3
 479+ C1B2 CD A0 9F         call Noise_efect
 480+ C1B5
 481+ C1B5 D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1B6
 483+ C1B6 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1B7 94               sub h
 485+ C1B8
 486+ C1B8 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1BA
 488+ C1BA 7C               ld a,h
 489+ C1BB 32 0C 96         ld (Burst_sound),a
 490+ C1BE
 491+ C1BE C9               ret
 492+ C1BF
 493+ C1BF              Clean_burst_efect:
 494+ C1BF
 495+ C1BF AF               xor a
 496+ C1C0 32 0C 96         ld (Burst_sound),a
 497+ C1C3
 498+ C1C3 3A DD 95         ld a,(Ctrl_6)
 499+ C1C6 CB 87            res 0,a
 500+ C1C8 32 DD 95         ld (Ctrl_6),a
 501+ C1CB
 502+ C1CB C9               ret
 503+ C1CC
 504+ C1CC              ;   -------------------------------------------------------------------------------------------
 505+ C1CC              ;
 506+ C1CC              ;   23/9/26
 507+ C1CC              ;
 508+ C1CC              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1CC              ;   _ Shield_sound_effect.
 510+ C1CC              ;
 511+ C1CC              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1CC              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1CC              ;
 514+ C1CC              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1CC              ;
 516+ C1CC              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1CC              ;
 518+ C1CC              ;   MODIFY: AF'y BC.
 519+ C1CC
 520+ C1CC              Play_Shield_sound_effect:
 521+ C1CC
 522+ C1CC 3A 0D 96         ld a,(Shield_sound)
 523+ C1CF A7               and a
 524+ C1D0 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1D1
 526+ C1D1 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1D3
 528+ C1D3              Loop_3:
 529+ C1D3
 530+ C1D3 08               ex af,af
 531+ C1D4
 532+ C1D4 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1D6 D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1D8
 535+ C1D8 08               ex af,af
 536+ C1D9
 537+ C1D9 47               ld b,a
 538+ C1DA
 539+ C1DA 10 FE        Delay_7 djnz Delay_7
 540+ C1DC
 541+ C1DC 08               ex af,af
 542+ C1DD
 543+ C1DD AF               xor a                   ; Black BORDER.
 544+ C1DE D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1E0
 546+ C1E0 08               ex af,af
 547+ C1E1
