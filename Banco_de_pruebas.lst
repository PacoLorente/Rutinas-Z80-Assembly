 565+ AFD6              ;   NextScan.
 566+ AFD6              ;
 567+ AFD6              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ AFD6              ;
 569+ AFD6              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ AFD6              ;
 571+ AFD6              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ AFD6              ;
 573+ AFD6              ;       DESTRUIDOS: AF y HL !!!
 574+ AFD6              ;
 575+ AFD6              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ AFD6              ;
 577+ AFD6
 578+ AFD6 24           NextScan inc h          							; Incrementamos el scanline.
 579+ AFD7 7C               ld a,h
 580+ AFD8 E6 07            and 7
 581+ AFDA C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ AFDB
 583+ AFDB 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ AFDC C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ AFDE 6F               ld l,a
 586+ AFDF D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ AFE0
 588+ AFE0 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ AFE1 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ AFE3 67               ld h,a
 591+ AFE4 C9               ret
 592+ AFE5
 593+ AFE5              ;----------------------------------------------------------------------------------------------------------------
 594+ AFE5              ;
 595+ AFE5              ;	5/08/22
