2825  C001              	include "Sound.asm"
# file opened: Sound.asm
   1+ C001              ; ----------------------------------------------------------
   2+ C001              ;
   3+ C001              ;   26/09/26
   4+ C001              ;
   5+ C001              ;   Voy a utilizar los 6 bytes de las variables:
   6+ C001              ;
   7+ C001              ;   (Indice_Sprite_der)
   8+ C001              ;   (Indice_Sprite_izq)
   9+ C001              ;   (Puntero_DESPLZ_der)
  10+ C001              ;
  11+ C001              ;   Para almacenar el perfil de la nota que está en ejecución pues la rutina se ejecuta "IN GAME TIME" y sólo reproducirá 4 ondas_
  12+ C001              ;   _del total que forman la nota.
  13+ C001              ;
  14+ C001              ;   La rutina genera un "ruido" o especie de zumbido ascendente/descendente llamando a la rutina [Sound_Generator].
  15+ C001              ;   La melodía consta de dos notas incluidas en el índice: "Game_over_noise_index:". El puntero (Puntero_game_over_noise) avanza_
  16+ C001              ;   _ por el índice proporcionando los datos de las notas a la rutina.
  17+ C001              ;
  18+ C001              ;   La rutina [Sound_Generator] requiere que los parámetros de la nota a ejecutar se den de la siguiente forma:
  19+ C001              ;
  20+ C001              ;           C contiene el nº de veces que vamos a generar la onda del sonido.
