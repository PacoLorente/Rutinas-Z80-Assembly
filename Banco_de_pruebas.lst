 623+ B5B6 C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ B5B8 6F               ld l,a
 625+ B5B9 D8               ret c               							; Salimos si se produce el cambio de tercio.
 626+ B5BA
 627+ B5BA 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 628+ B5BB D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 629+ B5BD 67               ld h,a
 630+ B5BE C9               ret
