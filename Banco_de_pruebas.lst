   1+ 946F              ; ******************************************************************************************************************************************************************************************
   2+ 946F              ;
   3+ 946F              ;   21/04/24
   4+ 946F              ;
   5+ 946F              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 946F              ;   (XOR) bit a bit.
   7+ 946F              ;
   8+ 946F              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 946F
  10+ 946F              Derivando_RND
  11+ 946F
  12+ 946F 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9472
  14+ 9472 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9474 C5               push bc
  16+ 9475              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9475 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9478              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9478
  20+ 9478 A7           6 and a                                 ; Carry a "0".
  21+ 9479 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 947B 30 02            jr nc,1F
  23+ 947D
  24+ 947D CB C1            set 0,c
  25+ 947F
  26+ 947F 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9480 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9482 5F               ld e,a
  29+ 9483
  30+ 9483 7A               ld a,d
  31+ 9484 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9486 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9488
  34+ 9488 CB 3F            srl a
  35+ 948A
  36+ 948A AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 948B
  38+ 948B 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 948C 28 04            jr z,4F
  40+ 948E
  41+ 948E CB FF            set 7,a
  42+ 9490 18 02            jr 5F
  43+ 9492
