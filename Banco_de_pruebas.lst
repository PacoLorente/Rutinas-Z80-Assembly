# file opened: RND_Derivando.asm
   1+ 9734              ; ******************************************************************************************************************************************************************************************
   2+ 9734              ;
   3+ 9734              ;   3/4/25
   4+ 9734              ;
   5+ 9734              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9734              ;   (XOR) bit a bit.
   7+ 9734              ;
   8+ 9734              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9734              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9734
  11+ 9734              Derivando_RND
  12+ 9734
  13+ 9734 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9736 C5               push bc
  15+ 9737              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9737 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 973A              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 973A
  19+ 973A A7           6 and a                                 ; Carry a "0".
  20+ 973B CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 973D 30 02            jr nc,1F
  22+ 973F
  23+ 973F CB C1            set 0,c
  24+ 9741
  25+ 9741 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9742 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9744 5F               ld e,a
