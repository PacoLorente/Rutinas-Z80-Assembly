3266  A0E7              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A0E7              ; ******************************************************************************************************************************************************************************************
   2+ A0E7              ;
   3+ A0E7              ;   3/4/25
   4+ A0E7              ;
   5+ A0E7              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0E7              ;   (XOR) bit a bit.
   7+ A0E7              ;
   8+ A0E7              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0E7              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0E7
  11+ A0E7              Derivando_RND
  12+ A0E7
  13+ A0E7 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0E9 C5               push bc
  15+ A0EA              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0EA 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0ED              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0ED
  19+ A0ED A7           6 and a                                 ; Carry a "0".
  20+ A0EE CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0F0 30 02            jr nc,1F
  22+ A0F2
  23+ A0F2 CB C1            set 0,c
  24+ A0F4
  25+ A0F4 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0F5 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0F7 5F               ld e,a
  28+ A0F8
  29+ A0F8 7A               ld a,d
  30+ A0F9 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0FB 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0FD
  33+ A0FD CB 3F            srl a
  34+ A0FF
  35+ A0FF AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A100
  37+ A100 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A101 28 04            jr z,4F
  39+ A103
  40+ A103 CB FF            set 7,a
  41+ A105 18 02            jr 5F
  42+ A107
  43+ A107 CB BF        4 res 7,a
  44+ A109
  45+ A109 CB 21        5 sla c
  46+ A10B 10 E0            djnz 6B
  47+ A10D
  48+ A10D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A10E
  50+ A10E 77               ld (hl),a
  51+ A10F 23               inc hl
  52+ A110 C1               pop bc
  53+ A111 10 D4            djnz 3B
  54+ A113
  55+ A113 C9               ret
  56+ A114
  57+ A114
  58+ A114
