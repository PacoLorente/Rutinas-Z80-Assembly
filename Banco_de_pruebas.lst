 655+ B5C4
 656+ B5C4 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 657+ B5C5 D6 20            sub $20             							; Vamos a comprobarlo...
 658+ B5C7 6F               ld l,a
