 434+ C149              ;   -------------------------------------------------------------------------------------------
 435+ C149              ;
 436+ C149              ;   23/9/26
 437+ C149              ;
 438+ C149              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 439+ C149              ;
 440+ C149              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 441+ C149              ;   _ [Sound_Generator].
 442+ C149              ;
 443+ C149              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 444+ C149              ;
 445+ C149              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 446+ C149              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 447+ C149              ;
 448+ C149              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 449+ C149              ;
 450+ C149              ;   MODIFY: AF',AF, HL, DE y BC.
 451+ C149              ;
 452+ C149              ;   OUTPUT: Actualiza (Burst_sound).
 453+ C149
 454+ C149              Play_burst_sound_effect:
 455+ C149
 456+ C149              ;   Exclusiones:
 457+ C149
 458+ C149 3A 91 94         ld a,(Burst_sound)
