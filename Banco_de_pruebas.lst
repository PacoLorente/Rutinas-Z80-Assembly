 541+ ABFD 7D           2 ld a,l
 542+ ABFE FE C0            cp $c0
 543+ AC00 30 03            jr nc,Calcula_scans_desapareciendo              ; En las 2 últimas líneas el Sprite sólo se imprime completo cuando el primer scanline está en una dirección $50xx.
 544+ AC02
 545+ AC02
 546+ AC02              ;   Entidad completa. Se generan 16 scanlines para imprimir.
 547+ AC02
 548+ AC02 06 10        1 ld b,16
