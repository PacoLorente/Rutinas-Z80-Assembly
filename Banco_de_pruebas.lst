 391+ A213              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A213              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A213 A7           	and a
 394+ A214 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A216
 396+ A216              ; Generamos movimientos masticados.
