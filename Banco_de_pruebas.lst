 177+ C1C9              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 178+ C1C9
 179+ C1C9              ;   Necesito fabricar un msg. con la máxima puntuación.
