# file opened: RND_Derivando.asm
   1+ 9742              ; ******************************************************************************************************************************************************************************************
   2+ 9742              ;
   3+ 9742              ;   3/4/25
   4+ 9742              ;
   5+ 9742              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9742              ;   (XOR) bit a bit.
   7+ 9742              ;
   8+ 9742              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9742              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9742
  11+ 9742              Derivando_RND
  12+ 9742
  13+ 9742 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9744 C5               push bc
  15+ 9745              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9745 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9748              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9748
  19+ 9748 A7           6 and a                                 ; Carry a "0".
  20+ 9749 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 974B 30 02            jr nc,1F
  22+ 974D
  23+ 974D CB C1            set 0,c
  24+ 974F
  25+ 974F 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9750 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9752 5F               ld e,a
