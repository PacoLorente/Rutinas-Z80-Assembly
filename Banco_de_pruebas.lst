 582+ A1A8
 583+ A1A8 7D           	ld a,l              ; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A1A9 C6 20            add a,$20           ; Vamos a comprobarlo...
 585+ A1AB 6F               ld l,a
 586+ A1AC D8               ret c               ; Salimos si se produce el cambio de tercio.
 587+ A1AD
 588+ A1AD 7C               ld a,h              ; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A1AE D6 08            sub 8               ; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A1B0 67               ld h,a
 591+ A1B1 C9               ret
