   1+ 9F8B              ; ******************************************************************************************************************************************************************************************
   2+ 9F8B              ;
   3+ 9F8B              ;   3/4/25
   4+ 9F8B              ;
   5+ 9F8B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9F8B              ;   (XOR) bit a bit.
   7+ 9F8B              ;
   8+ 9F8B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9F8B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9F8B
  11+ 9F8B              Derivando_RND
  12+ 9F8B
  13+ 9F8B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9F8D C5               push bc
  15+ 9F8E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9F8E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9F91              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9F91
  19+ 9F91 A7           6 and a                                 ; Carry a "0".
  20+ 9F92 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9F94 30 02            jr nc,1F
  22+ 9F96
  23+ 9F96 CB C1            set 0,c
  24+ 9F98
  25+ 9F98 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9F99 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9F9B 5F               ld e,a
  28+ 9F9C
  29+ 9F9C 7A               ld a,d
  30+ 9F9D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9F9F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9FA1
  33+ 9FA1 CB 3F            srl a
  34+ 9FA3
  35+ 9FA3 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9FA4
  37+ 9FA4 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9FA5 28 04            jr z,4F
  39+ 9FA7
  40+ 9FA7 CB FF            set 7,a
  41+ 9FA9 18 02            jr 5F
  42+ 9FAB
  43+ 9FAB CB BF        4 res 7,a
  44+ 9FAD
  45+ 9FAD CB 21        5 sla c
  46+ 9FAF 10 E0            djnz 6B
  47+ 9FB1
  48+ 9FB1 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9FB2
  50+ 9FB2 77               ld (hl),a
  51+ 9FB3 23               inc hl
  52+ 9FB4 C1               pop bc
  53+ 9FB5 10 D4            djnz 3B
  54+ 9FB7
  55+ 9FB7 C9               ret
  56+ 9FB8
  57+ 9FB8
  58+ 9FB8
