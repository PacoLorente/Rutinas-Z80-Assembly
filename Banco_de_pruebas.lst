   4+ 9D37              ;
   5+ 9D37              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D37              ;   (XOR) bit a bit.
   7+ 9D37              ;
   8+ 9D37              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D37              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D37
  11+ 9D37              Derivando_RND
  12+ 9D37
  13+ 9D37 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D39 C5               push bc
  15+ 9D3A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D3A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D3D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D3D
  19+ 9D3D A7           6 and a                                 ; Carry a "0".
  20+ 9D3E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D40 30 02            jr nc,1F
  22+ 9D42
  23+ 9D42 CB C1            set 0,c
  24+ 9D44
  25+ 9D44 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D45 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D47 5F               ld e,a
  28+ 9D48
