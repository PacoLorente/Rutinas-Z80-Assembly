 175+ C152              Make_Score_max_msg:
 176+ C152
 177+ C152              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 178+ C152
 179+ C152              ;   Necesito fabricar un msg. con la máxima puntuación.
 180+ C152              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 181+ C152
 182+ C152 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 183+ C155 21 C7 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 184+ C158              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 185+ C158 11 D6 94         ld de,Score_max_msg
 186+ C15B
 187+ C15B              KEY_CODE_de_BCD:
 188+ C15B
 189+ C15B 7E           1 ld a,(hl)
 190+ C15C A7               and a
 191+ C15D 20 07            jr nz,3F
 192+ C15F
 193+ C15F              ;   El dígito es "0".
 194+ C15F
 195+ C15F 0C               inc c
 196+ C160 0D               dec c
 197+ C161 20 03            jr nz,3F
 198+ C163
 199+ C163 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 200+ C164 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 201+ C166
 202+ C166 D5           3 push de                                    ; PUSH Score_max_msg.
 203+ C167
 204+ C167 11 E7 94         ld de,Non_authorized_KEY_CODES+2         ; KEY_CODE numbers list.
 205+ C16A
 206+ C16A A7               and a
 207+ C16B 28 04            jr z,4F
 208+ C16D
 209+ C16D 13           2 inc de
 210+ C16E 3D               dec a
 211+ C16F 20 FC            jr nz,2B                                 ; Nos situamos en el KEY_CODE correspondiente a este dígito.
 212+ C171
 213+ C171 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 214+ C172
 215+ C172 D1               pop de                                   ; Score_max_msg en DE.
 216+ C173
