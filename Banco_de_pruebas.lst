   5+ 997C              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 997C              ;   (XOR) bit a bit.
   7+ 997C              ;
   8+ 997C              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 997C              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 997C
  11+ 997C              Derivando_RND
  12+ 997C
  13+ 997C ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 997E C5               push bc
  15+ 997F              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 997F 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9982              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9982
  19+ 9982 A7           6 and a                                 ; Carry a "0".
  20+ 9983 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9985 30 02            jr nc,1F
  22+ 9987
  23+ 9987 CB C1            set 0,c
  24+ 9989
  25+ 9989 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 998A E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 998C 5F               ld e,a
  28+ 998D
  29+ 998D 7A               ld a,d
  30+ 998E E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9990 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9992
  33+ 9992 CB 3F            srl a
  34+ 9994
  35+ 9994 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9995
  37+ 9995 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9996 28 04            jr z,4F
  39+ 9998
  40+ 9998 CB FF            set 7,a
  41+ 999A 18 02            jr 5F
  42+ 999C
  43+ 999C CB BF        4 res 7,a
  44+ 999E
  45+ 999E CB 21        5 sla c
  46+ 99A0 10 E0            djnz 6B
  47+ 99A2
  48+ 99A2 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99A3
  50+ 99A3 77               ld (hl),a
  51+ 99A4 23               inc hl
