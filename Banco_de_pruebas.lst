 584+ A6C2 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A6C4 6F               ld l,a
 586+ A6C5 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A6C6
 588+ A6C6 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A6C7 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A6C9 67               ld h,a
 591+ A6CA C9               ret
