 298  8C3E
 299  8C3E 00 00        Puntero_tabla_Random defw 0
 300  8C40 00 00        Puntero_indice_mov defw 0							    ; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 301  8C42 00 00        Puntero_mov defw 0										; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 302  8C44 00 00        Puntero_indice_mov_bucle defw 0							;
 303  8C46              ;
 304  8C46              ;
 305  8C46 00           Incrementa_puntero db 0									; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 306  8C47              ;														; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 307  8C47              ;														; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 308  8C47 00           Incrementa_puntero_backup db 0
 309  8C48 00           Repetimos_desplazamiento db 0							; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 310  8C49              ;														; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 311  8C49 00           Repetimos_desplazamiento_backup db 0					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 312  8C4A 00           Repetimos_movimiento db 0								; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 313  8C4B 00           Cola_de_desplazamiento db 0								; Este byte indica:
 314  8C4C              ;
 315  8C4C              ;														;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8C4C              ;														;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8C4C              ;														;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8C4C              ;
 319  8C4C              ;														;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8C4C              ;														;						Nº de veces que vamos a repetir el movimiento completo.
 321  8C4C              ;														;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8C4C              ;														;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 323  8C4C              ;
 324  8C4C              ;														;	"$ff" ..... Bucle infinito de repetición.
 325  8C4C              ;														;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 326  8C4C              ;														;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 327  8C4C
 328  8C4C 00           Ctrl_1 db 0 											; Byte de control de propósito general.
 329  8C4D
 330  8C4D              ;														DESCRIPCIÓN:
 331  8C4D              ;
 332  8C4D              ;														BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 333  8C4D              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 334  8C4D              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 335  8C4D              ;														BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 336  8C4D              ;														BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 337  8C4D              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 338  8C4D
 339  8C4D              ;														BIT 3, Recarga de nueva oleada.
 340  8C4D              ;														BIT 4, Recarga de nueva oleada.
 341  8C4D              ;														BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 342  8C4D              ;														BIT 6, **** Frame completo.
