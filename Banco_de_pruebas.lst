   3+ 96EF              ;   3/4/25
   4+ 96EF              ;
   5+ 96EF              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 96EF              ;   (XOR) bit a bit.
   7+ 96EF              ;
   8+ 96EF              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 96EF              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 96EF
  11+ 96EF              Derivando_RND
  12+ 96EF
  13+ 96EF ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 96F1 C5               push bc
  15+ 96F2              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 96F2 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 96F5              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 96F5
  19+ 96F5 A7           6 and a                                 ; Carry a "0".
  20+ 96F6 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 96F8 30 02            jr nc,1F
  22+ 96FA
  23+ 96FA CB C1            set 0,c
  24+ 96FC
  25+ 96FC 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 96FD E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 96FF 5F               ld e,a
  28+ 9700
  29+ 9700 7A               ld a,d
  30+ 9701 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9703 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9705
  33+ 9705 CB 3F            srl a
  34+ 9707
  35+ 9707 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9708
  37+ 9708 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9709 28 04            jr z,4F
  39+ 970B
  40+ 970B CB FF            set 7,a
  41+ 970D 18 02            jr 5F
  42+ 970F
  43+ 970F CB BF        4 res 7,a
  44+ 9711
  45+ 9711 CB 21        5 sla c
  46+ 9713 10 E0            djnz 6B
  47+ 9715
  48+ 9715 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9716
  50+ 9716 77               ld (hl),a
  51+ 9717 23               inc hl
  52+ 9718 C1               pop bc
  53+ 9719 10 D4            djnz 3B
  54+ 971B
  55+ 971B C9               ret
  56+ 971C
  57+ 971C
  58+ 971C
