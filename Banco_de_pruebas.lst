   1+ 9FFC              ; ******************************************************************************************************************************************************************************************
   2+ 9FFC              ;
   3+ 9FFC              ;   3/4/25
   4+ 9FFC              ;
   5+ 9FFC              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9FFC              ;   (XOR) bit a bit.
   7+ 9FFC              ;
   8+ 9FFC              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9FFC              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9FFC
  11+ 9FFC              Derivando_RND
  12+ 9FFC
  13+ 9FFC ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9FFE C5               push bc
  15+ 9FFF              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9FFF 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A002              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A002
  19+ A002 A7           6 and a                                 ; Carry a "0".
  20+ A003 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A005 30 02            jr nc,1F
  22+ A007
  23+ A007 CB C1            set 0,c
  24+ A009
  25+ A009 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A00A E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A00C 5F               ld e,a
  28+ A00D
  29+ A00D 7A               ld a,d
  30+ A00E E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A010 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A012
  33+ A012 CB 3F            srl a
  34+ A014
  35+ A014 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A015
  37+ A015 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A016 28 04            jr z,4F
  39+ A018
  40+ A018 CB FF            set 7,a
  41+ A01A 18 02            jr 5F
  42+ A01C
  43+ A01C CB BF        4 res 7,a
  44+ A01E
  45+ A01E CB 21        5 sla c
  46+ A020 10 E0            djnz 6B
  47+ A022
  48+ A022 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A023
  50+ A023 77               ld (hl),a
  51+ A024 23               inc hl
  52+ A025 C1               pop bc
  53+ A026 10 D4            djnz 3B
  54+ A028
  55+ A028 C9               ret
  56+ A029
  57+ A029
  58+ A029
# file closed: RND_Derivando.asm
