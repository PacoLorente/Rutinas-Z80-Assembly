   5+ 9BE5              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9BE5              ;   (XOR) bit a bit.
   7+ 9BE5              ;
   8+ 9BE5              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9BE5              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9BE5
  11+ 9BE5              Derivando_RND
  12+ 9BE5
  13+ 9BE5 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9BE7 C5               push bc
  15+ 9BE8              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9BE8 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9BEB              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9BEB
  19+ 9BEB A7           6 and a                                 ; Carry a "0".
  20+ 9BEC CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9BEE 30 02            jr nc,1F
  22+ 9BF0
  23+ 9BF0 CB C1            set 0,c
  24+ 9BF2
  25+ 9BF2 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9BF3 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9BF5 5F               ld e,a
  28+ 9BF6
  29+ 9BF6 7A               ld a,d
  30+ 9BF7 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9BF9 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9BFB
  33+ 9BFB CB 3F            srl a
  34+ 9BFD
  35+ 9BFD AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9BFE
  37+ 9BFE 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9BFF 28 04            jr z,4F
  39+ 9C01
  40+ 9C01 CB FF            set 7,a
  41+ 9C03 18 02            jr 5F
  42+ 9C05
  43+ 9C05 CB BF        4 res 7,a
  44+ 9C07
  45+ 9C07 CB 21        5 sla c
  46+ 9C09 10 E0            djnz 6B
  47+ 9C0B
  48+ 9C0B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C0C
  50+ 9C0C 77               ld (hl),a
  51+ 9C0D 23               inc hl
  52+ 9C0E C1               pop bc
  53+ 9C0F 10 D4            djnz 3B
  54+ 9C11
  55+ 9C11 C9               ret
