  17+ B4A2 22 6B 95     	ld (Puntero_de_impresion),hl
  18+ B4A5
  19+ B4A5              ;	Comparador de cuadrantes:
  20+ B4A5
  21+ B4A5 CD BF B4     	call Calcula_Cuad_objeto
  22+ B4A8 08           	ex af,af													; (Cuad_objeto) inicial en A'.
  23+ B4A9
  24+ B4A9              Entidad_iniciada:
  25+ B4A9
  26+ B4A9 DD 2A 6B 95  	ld ix,(Puntero_de_impresion) 								; (Puntero_de_impresion) de la anterior (Posicion_actual). Necesario para averiguar si existe_
  27+ B4AD              ; 																; _cambio de cuadrante cuando el sprite está incompleto.
  28+ B4AD CD BF B4     	call Calcula_Cuad_objeto  									; (Cuad_objeto) de la nueva (Posicion_actual).
  29+ B4B0
  30+ B4B0 CD FD B4     	call calcula_CColumnass										; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  31+ B4B3              ;																; También comprueba si en la nueva (Posicion_actual) el Sprite se imprime COMPLETO o INCOMPLETO, (Sprite_completo_1).
  32+ B4B3 CD 23 B5     	call Drive													; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  33+ B4B6
  34+ B4B6 3A 74 95     	ld a,(Ctrl_0)												; Antes de salir de la rutina restauramos los bits 0,1,2,3 y 5 de (Ctrl_0).
  35+ B4B9 E6 D0        	and $d0
  36+ B4BB 32 74 95     	ld (Ctrl_0),a
