 504+ ACF3              ; -----------------------------------------------------------------------------------
 505+ ACF3              ;
 506+ ACF3              ;	12/8/26
 507+ ACF3              ;
 508+ ACF3              ;	Asigna una columna de inicio aleatoria y distinta a cada una de las 3 Clases como máximo que pueden aparecer en un nivel.
 509+ ACF3
 510+ ACF3              Determina_posicion_de_inicio:
 511+ ACF3
 512+ ACF3 21 8F A2     	ld hl,Numeros_aleatorios_baile+3
 513+ ACF6 7E           	ld a,(hl)
 514+ ACF7 E6 1F        	and $1f															; Define el nº de columna por el que va a aparecer la entidad.
 515+ ACF9
 516+ ACF9              ;	Tenemos un nº aleatorio, (Columna de inicio) en A.
 517+ ACF9              ; 	No queremos que se repita la posición de inicio en dos clases distintas de entidades.
 518+ ACF9
 519+ ACF9 57           	ld d,a 															; $08,$12,$0c --- $08,$02,$12 --- $18,$1c,$18 --- $1e,$1c,$18
 520+ ACFA
 521+ ACFA CD 14 AD     	call No_repeat
 522+ ACFD
 523+ ACFD 3A F4 A4     	ld a,(Tipo)														; (Tipo) $81 Badsat, $82 Badplate.
 524+ AD00 E6 02        	and 2
 525+ AD02 7A           	ld a,d
