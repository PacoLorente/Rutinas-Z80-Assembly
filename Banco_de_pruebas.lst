 159  8EAD 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 160  8EAE
 161  8EAE 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 162  8EAF              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 163  8EAF              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 164  8EAF
 165  8EAF              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 166  8EAF              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 167  8EAF
 168  8EAF              ; Ejemplos:
 169  8EAF
 170  8EAF              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 171  8EAF              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 172  8EAF              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 173  8EAF              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 174  8EAF              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 175  8EAF
 176  8EAF 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 177  8EB0              ;															  _ que esta entidad haya colisionado con Amadeus.
 178  8EB0              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 179  8EB0
