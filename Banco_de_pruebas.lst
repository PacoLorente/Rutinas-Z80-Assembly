 186  8F9F              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 8F9F
   2+ 8F9F
   3+ 8F9F              ;   07/07/23
   4+ 8F9F              ;
   5+ 8F9F              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8F9F              ;
   7+ 8F9F              ;   Codificación:
   8+ 8F9F              ;
   9+ 8F9F              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8F9F              ;
  11+ 8F9F              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8F9F              ;
  13+ 8F9F              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8F9F              ;
  15+ 8F9F              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8F9F              ;
  17+ 8F9F              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8F9F              ;                               ..... %01000010 Vel_up 4
  19+ 8F9F              ;                                               Vel_down 2
  20+ 8F9F              ;                               ..... $42
  21+ 8F9F              ;
  22+ 8F9F              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8F9F              ;
  24+ 8F9F              ;                               ..... %01000010 Vel_left 4
  25+ 8F9F              ;                                               Vel_right 2
  26+ 8F9F              ;                               ..... $42
  27+ 8F9F              ;
  28+ 8F9F              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8F9F              ;
  30+ 8F9F              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8F9F              ;
  32+ 8F9F              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8F9F              ;
  34+ 8F9F              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8F9F              ;                                     $53
  36+ 8F9F              ;
  37+ 8F9F              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8F9F              ;
  39+ 8F9F              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8F9F              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8F9F              ;
  42+ 8F9F              ;                       Arriba ..... $81
  43+ 8F9F              ;                       Arriba - izquierda ..... $a1
  44+ 8F9F              ;                       Arriba - derecha ..... $91
  45+ 8F9F              ;
  46+ 8F9F              ;                       Abajo ..... $41
  47+ 8F9F              ;                       Abajo - izquierda ..... $61
  48+ 8F9F              ;                       Abajo - derecha ..... $51
  49+ 8F9F              ;
  50+ 8F9F              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8F9F              ;
  52+ 8F9F              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8F9F              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8F9F              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8F9F              ;
  56+ 8F9F              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8F9F              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8F9F              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8F9F              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8F9F              ;
  61+ 8F9F              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8F9F              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8F9F              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8F9F              ;
  65+ 8F9F              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8F9F              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8F9F              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8F9F              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8F9F
