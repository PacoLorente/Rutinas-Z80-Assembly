 346  91BB              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 91BB
   2+ 91BB
   3+ 91BB              ;   07/07/23
   4+ 91BB              ;
   5+ 91BB              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 91BB              ;
   7+ 91BB              ;   Codificación:
   8+ 91BB              ;
   9+ 91BB              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 91BB              ;
  11+ 91BB              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 91BB              ;
  13+ 91BB              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 91BB              ;
  15+ 91BB              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 91BB              ;
  17+ 91BB              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 91BB              ;                               ..... %01000010 Vel_up 4
  19+ 91BB              ;                                               Vel_down 2
  20+ 91BB              ;                               ..... $42
  21+ 91BB              ;
  22+ 91BB              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 91BB              ;
  24+ 91BB              ;                               ..... %01000010 Vel_left 4
  25+ 91BB              ;                                               Vel_right 2
  26+ 91BB              ;                               ..... $42
  27+ 91BB              ;
  28+ 91BB              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 91BB              ;
  30+ 91BB              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 91BB              ;
  32+ 91BB              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 91BB              ;
  34+ 91BB              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 91BB              ;                                     $53
  36+ 91BB              ;
  37+ 91BB              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 91BB              ;
  39+ 91BB              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 91BB              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 91BB              ;
  42+ 91BB              ;                       Arriba ..... $81
  43+ 91BB              ;                       Arriba - izquierda ..... $a1
  44+ 91BB              ;                       Arriba - derecha ..... $91
  45+ 91BB              ;
  46+ 91BB              ;                       Abajo ..... $41
  47+ 91BB              ;                       Abajo - izquierda ..... $61
  48+ 91BB              ;                       Abajo - derecha ..... $51
  49+ 91BB              ;
  50+ 91BB              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 91BB              ;
  52+ 91BB              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 91BB              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 91BB              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 91BB              ;
  56+ 91BB              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 91BB              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 91BB              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 91BB              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 91BB              ;
  61+ 91BB              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 91BB              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 91BB              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 91BB              ;
  65+ 91BB              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 91BB              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 91BB              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 91BB              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 91BB
