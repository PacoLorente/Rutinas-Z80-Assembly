   1+ A0DD              ; ******************************************************************************************************************************************************************************************
   2+ A0DD              ;
   3+ A0DD              ;   3/4/25
   4+ A0DD              ;
   5+ A0DD              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0DD              ;   (XOR) bit a bit.
   7+ A0DD              ;
   8+ A0DD              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0DD              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0DD
  11+ A0DD              Derivando_RND
  12+ A0DD
  13+ A0DD ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0DF C5               push bc
  15+ A0E0              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0E0 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0E3              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0E3
  19+ A0E3 A7           6 and a                                 ; Carry a "0".
  20+ A0E4 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0E6 30 02            jr nc,1F
  22+ A0E8
  23+ A0E8 CB C1            set 0,c
  24+ A0EA
  25+ A0EA 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0EB E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0ED 5F               ld e,a
  28+ A0EE
  29+ A0EE 7A               ld a,d
  30+ A0EF E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0F1 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0F3
  33+ A0F3 CB 3F            srl a
  34+ A0F5
  35+ A0F5 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0F6
  37+ A0F6 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0F7 28 04            jr z,4F
  39+ A0F9
  40+ A0F9 CB FF            set 7,a
  41+ A0FB 18 02            jr 5F
  42+ A0FD
  43+ A0FD CB BF        4 res 7,a
  44+ A0FF
  45+ A0FF CB 21        5 sla c
  46+ A101 10 E0            djnz 6B
  47+ A103
  48+ A103 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A104
  50+ A104 77               ld (hl),a
  51+ A105 23               inc hl
  52+ A106 C1               pop bc
  53+ A107 10 D4            djnz 3B
  54+ A109
  55+ A109 C9               ret
  56+ A10A
  57+ A10A
  58+ A10A
