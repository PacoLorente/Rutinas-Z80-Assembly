 397+ C12B 45               ld b,l
 398+ C12C
 399+ C12C 10 FE        Delay_3 djnz Delay_3
 400+ C12E
 401+ C12E AF               xor a                   ; Borde negro.
 402+ C12F D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 403+ C131
 404+ C131 45               ld b,l
