 711+ A7FF 0E 47            ld c,%01000111         ; (Attr). de los disparos.
 712+ A801
 713+ A801 06 07        3 ld b,7                           ; Nº máximo de disparos. Fuerza la salida del album cuando hemos pintado 7 veces_
 714+ A803              ;                                      _ aunque IYL+IYH+E no sea "0". (No hay separacíon entre el álbum de borrado y el de pintado).
 715+ A803              ;                                      _ No encontraría "0".
 716+ A803
 717+ A803 FD E1        4 pop iy
 718+ A805 D1               pop de                              ; 1er .db IYL
 719+ A806              ;                                      ; 2º  .db IYH
 720+ A806              ;                                      ; 3er .db E.
 721+ A806              ;                                      ; .db que pintan el disparo, ej.: $18 $00 $00, (Puntero_objeto) del disparo, 3 .db's.
