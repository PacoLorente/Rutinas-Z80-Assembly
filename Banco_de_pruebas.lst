 490  93CE              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 491  93CE
 492  93CE 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 493  93CF 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 494  93D0 00           Cola_de_desplazamiento db 0									; Este byte indica:
 495  93D1
 496  93D1              ;
 497  93D1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 498  93D1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 499  93D1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 500  93D1              ;
 501  93D1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 502  93D1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 503  93D1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 504  93D1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 505  93D1              ;
 506  93D1              ;															;	"$ff" ..... Bucle infinito de repetición.
 507  93D1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 508  93D1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
