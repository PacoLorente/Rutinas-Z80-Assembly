 349  92C5 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 350  92C6              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 351  92C6
 352  92C6 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 353  92C7 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 354  92C8 00           Cola_de_desplazamiento db 0									; Este byte indica:
 355  92C9
 356  92C9              ;
 357  92C9              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 358  92C9              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 359  92C9              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 360  92C9              ;
 361  92C9              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 362  92C9              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 363  92C9              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 364  92C9              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 365  92C9              ;
 366  92C9              ;															;	"$ff" ..... Bucle infinito de repetición.
 367  92C9              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 368  92C9              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 369  92C9
 370  92C9 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 371  92CA
 372  92CA              ;																DESCRIPCIÓN:
 373  92CA              ;
 374  92CA              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 375  92CA              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 376  92CA              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 377  92CA              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 378  92CA              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 379  92CA              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 380  92CA
 381  92CA              ;															BIT 3, Recarga de nueva oleada.
 382  92CA              ;															BIT 4, Recarga de nueva oleada.
 383  92CA              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 384  92CA              ;															BIT 6, **** Frame completo.
 385  92CA              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 386  92CA
 387  92CA 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 388  92CC              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 389  92CC              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 390  92CC              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 391  92CC              ;
 392  92CC              ;															; 2ª Función:
 393  92CC              ;
 394  92CC              ;															; La rutina [Genera_cabecera] almacena la dirección del álbum de scanlines donde se inicia la cabecera para posteriormente_
 395  92CC              ;															; _guardar esta dirección en la (Tabla_de_pintado).
 396  92CC
 397  92CC              ; Gestión de ENTIDADES y CAJAS.
 398  92CC
