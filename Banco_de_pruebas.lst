# file opened: Patrones_de_mov.asm
   1+ 8B7D
   2+ 8B7D
   3+ 8B7D              ;   07/07/23
   4+ 8B7D              ;
   5+ 8B7D              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8B7D              ;
   7+ 8B7D              ;   Codificación:
   8+ 8B7D              ;
   9+ 8B7D              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8B7D              ;
  11+ 8B7D              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8B7D              ;
  13+ 8B7D              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8B7D              ;
  15+ 8B7D              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8B7D              ;
  17+ 8B7D              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8B7D              ;                               ..... %01000010 Vel_up 4
  19+ 8B7D              ;                                               Vel_down 2
  20+ 8B7D              ;                               ..... $42
  21+ 8B7D              ;
  22+ 8B7D              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8B7D              ;
  24+ 8B7D              ;                               ..... %01000010 Vel_left 4
  25+ 8B7D              ;                                               Vel_right 2
  26+ 8B7D              ;                               ..... $42
  27+ 8B7D              ;
  28+ 8B7D              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8B7D              ;
  30+ 8B7D              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8B7D              ;
  32+ 8B7D              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8B7D              ;
  34+ 8B7D              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8B7D              ;                                     $53
  36+ 8B7D              ;
  37+ 8B7D              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8B7D              ;
  39+ 8B7D              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8B7D              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8B7D              ;
  42+ 8B7D              ;                       Arriba ..... $81
  43+ 8B7D              ;                       Arriba - izquierda ..... $a1
  44+ 8B7D              ;                       Arriba - derecha ..... $91
  45+ 8B7D              ;
  46+ 8B7D              ;                       Abajo ..... $41
  47+ 8B7D              ;                       Abajo - izquierda ..... $61
  48+ 8B7D              ;                       Abajo - derecha ..... $51
  49+ 8B7D              ;
  50+ 8B7D              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8B7D              ;
  52+ 8B7D              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8B7D              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8B7D              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8B7D              ;
  56+ 8B7D              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8B7D              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8B7D              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8B7D              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8B7D              ;
  61+ 8B7D              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8B7D              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8B7D              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8B7D              ;
  65+ 8B7D              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8B7D              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8B7D              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8B7D              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8B7D
  70+ 8B7D              ; ----- ----- ----- ----- -----
