 270  8C5D 00           Cuad_objeto db 0										; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 271  8C5E 00           Columnas db 0
 272  8C5F
 273  8C5F              ;Limite_horizontal db 0	 								; Dirección de pantalla, (scanline), calculado en función del tamaño del Sprite. Si el objeto llega a esta línea se modifica_
 274  8C5F              ; 														; _(Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
