 214+ C181
 215+ C181 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 216+ C182
 217+ C182 D1               pop de                                   ; Score_max_msg en DE.
 218+ C183
 219+ C183 CD 8C C1         call ASCII_CODE_de_KEYCODE
 220+ C186
 221+ C186 0C               inc c                                    ; Indica que a partir de ahora se imprimen todos los "0".
