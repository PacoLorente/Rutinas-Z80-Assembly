 309+ C13E              ;
 310+ C13E              ;   17/9/26
 311+ C13E              ;
 312+ C13E              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C13E              ;
 314+ C13E              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C13E
 316+ C13E              BEEP:
 317+ C13E
 318+ C13E F5               push af
 319+ C13F C5               push bc
 320+ C140 D5               push de
 321+ C141 E5               push hl                                 ; STORE Regs.
 322+ C142
 323+ C142              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C142
 325+ C142              ;   Configuración de un BEEP.
 326+ C142
 327+ C142              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C142              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C142              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C142              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C142              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C142
 333+ C142
 334+ C142 01 02 00         ld bc,$0002
 335+ C145 11 00 00         ld de,0
 336+ C148 21 D0 00         ld hl,$00d0
 337+ C14B
 338+ C14B 22 B6 94         ld (Sound),hl
 339+ C14E
 340+ C14E CD 4D 9F         call Sound_Generator    ; v2. Ok.
 341+ C151
 342+ C151 21 00 00         ld hl,0
 343+ C154 22 B6 94         ld (Sound),hl
 344+ C157
 345+ C157 E1               pop hl                                  ; RECOVERY Regs.
 346+ C158 D1               pop de
 347+ C159 C1               pop bc
 348+ C15A F1               pop af
