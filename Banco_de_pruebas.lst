   1+ A063              ; ******************************************************************************************************************************************************************************************
   2+ A063              ;
   3+ A063              ;   3/4/25
   4+ A063              ;
   5+ A063              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A063              ;   (XOR) bit a bit.
   7+ A063              ;
   8+ A063              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A063              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A063
  11+ A063              Derivando_RND
  12+ A063
  13+ A063 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A065 C5               push bc
  15+ A066              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A066 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A069              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A069
  19+ A069 A7           6 and a                                 ; Carry a "0".
  20+ A06A CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A06C 30 02            jr nc,1F
  22+ A06E
  23+ A06E CB C1            set 0,c
  24+ A070
  25+ A070 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A071 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A073 5F               ld e,a
  28+ A074
  29+ A074 7A               ld a,d
  30+ A075 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A077 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A079
  33+ A079 CB 3F            srl a
  34+ A07B
  35+ A07B AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A07C
  37+ A07C 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A07D 28 04            jr z,4F
  39+ A07F
  40+ A07F CB FF            set 7,a
  41+ A081 18 02            jr 5F
  42+ A083
  43+ A083 CB BF        4 res 7,a
  44+ A085
  45+ A085 CB 21        5 sla c
  46+ A087 10 E0            djnz 6B
  47+ A089
  48+ A089 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A08A
  50+ A08A 77               ld (hl),a
  51+ A08B 23               inc hl
  52+ A08C C1               pop bc
  53+ A08D 10 D4            djnz 3B
  54+ A08F
  55+ A08F C9               ret
  56+ A090
  57+ A090
  58+ A090
