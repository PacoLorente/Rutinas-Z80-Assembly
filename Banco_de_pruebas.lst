 253  9366              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 9366
   2+ 9366
   3+ 9366              ;   07/07/23
   4+ 9366              ;
   5+ 9366              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 9366              ;
   7+ 9366              ;   Codificación:
   8+ 9366              ;
   9+ 9366              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 9366              ;
  11+ 9366              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 9366              ;
  13+ 9366              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 9366              ;
  15+ 9366              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 9366              ;
  17+ 9366              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 9366              ;                               ..... %01000010 Vel_up 4
  19+ 9366              ;                                               Vel_down 2
  20+ 9366              ;                               ..... $42
  21+ 9366              ;
  22+ 9366              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 9366              ;
  24+ 9366              ;                               ..... %01000010 Vel_left 4
  25+ 9366              ;                                               Vel_right 2
  26+ 9366              ;                               ..... $42
  27+ 9366              ;
  28+ 9366              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 9366              ;
  30+ 9366              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 9366              ;
  32+ 9366              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 9366              ;
  34+ 9366              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 9366              ;                                     $53
  36+ 9366              ;
  37+ 9366              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 9366              ;
  39+ 9366              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 9366              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 9366              ;
  42+ 9366              ;                       Arriba ..... $81
  43+ 9366              ;                       Arriba - izquierda ..... $a1
  44+ 9366              ;                       Arriba - derecha ..... $91
  45+ 9366              ;
  46+ 9366              ;                       Abajo ..... $41
  47+ 9366              ;                       Abajo - izquierda ..... $61
  48+ 9366              ;                       Abajo - derecha ..... $51
  49+ 9366              ;
  50+ 9366              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 9366              ;
  52+ 9366              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 9366              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 9366              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 9366              ;
  56+ 9366              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 9366              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 9366              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 9366              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 9366              ;
  61+ 9366              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 9366              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 9366              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 9366              ;
  65+ 9366              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 9366              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 9366              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 9366              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 9366
  70+ 9366              ; ----- ----- ----- ----- -----
  71+ 9366              ;
  72+ 9366              ;   Factor RANDOM --- BadSat.
  73+ 9366
