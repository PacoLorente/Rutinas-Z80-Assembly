 356  92B3
 357  92B3 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 358  92B4              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 359  92B4              ;															; _baja de la pantalla cuando hemos superado el nivel.
 360  92B4
 361  92B4 00           Columnas db 0
 362  92B5 00           Limite_vertical db 0 										; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 363  92B6              ;															; 2ª Función de (Limite_vertical):
 364  92B6              ;															; Se inicializa a "0" cada vez que ejecutamos el bucle de entidades. Se utiliza como contador; se incrementa (+1) cada vez que se añade una_
 365  92B6              ;															; _descripción a la (Tabla_de_pintado). Este valor lo utiliza la rutina [Ordena_tabla_de_pintado] para ordenar la tabla antes de imprimir.
 366  92B6
 367  92B6
 368  92B6
 369  92B6              ; Variables de control general.
 370  92B6
 371  92B6 00           Frames_explosion db 0 										; Nº de Frames que tiene la explosión.
 372  92B7
