 312  90C8 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 313  90C9              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 314  90C9
 315  90C9 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 316  90CA 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 317  90CB 00           Cola_de_desplazamiento db 0									; Este byte indica:
 318  90CC
 319  90CC              ;
 320  90CC              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 321  90CC              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 322  90CC              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 323  90CC              ;
 324  90CC              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 325  90CC              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 326  90CC              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 327  90CC              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 328  90CC              ;
 329  90CC              ;															;	"$ff" ..... Bucle infinito de repetición.
 330  90CC              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 331  90CC              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 332  90CC
 333  90CC 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 334  90CD
 335  90CD              ;																DESCRIPCIÓN:
 336  90CD              ;
 337  90CD              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 338  90CD              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 339  90CD              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 340  90CD              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 341  90CD              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 342  90CD              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 343  90CD
 344  90CD              ;															BIT 3, Recarga de nueva oleada.
 345  90CD              ;															BIT 4, Recarga de nueva oleada.
 346  90CD              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 347  90CD              ;															BIT 6, **** Frame completo.
 348  90CD              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 349  90CD
 350  90CD 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 351  90CF              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 352  90CF              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 353  90CF              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
