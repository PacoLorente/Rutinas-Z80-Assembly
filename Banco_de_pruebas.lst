1751  992F              ;	Por encima o igual que (Max_time_to_appear_entities).
1752  992F              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1753  992F
1754  992F 4E           	ld c,(hl)
1755  9930
