 572+ B1E4              ;
 573+ B1E4              ;       DESTRUIDOS: AF y HL !!!
 574+ B1E4              ;
 575+ B1E4              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ B1E4              ;
 577+ B1E4
 578+ B1E4 24           NextScan inc h          							; Incrementamos el scanline.
 579+ B1E5 7C               ld a,h
 580+ B1E6 E6 07            and 7
 581+ B1E8 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ B1E9
 583+ B1E9 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1EA C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1EC 6F               ld l,a
 586+ B1ED D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1EE
 588+ B1EE 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1EF D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1F1 67               ld h,a
 591+ B1F2 C9               ret
