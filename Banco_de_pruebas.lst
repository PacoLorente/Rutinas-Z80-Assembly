 864+ B63D              ;
 865+ B63D              ;	4/4/25
 866+ B63D              ;
 867+ B63D              ;	Limpia un espacio de la memoria.
 868+ B63D              ;
 869+ B63D              ;	INPUTS:  HL apunta al 1er byte del espacio de memoria que queremos limpiar.
 870+ B63D              ;				   BC indica el nº de bytes que vamos a poner a "0".
 871+ B63D              ;
 872+ B63D              ;	MODIFY: HL,DE,BC
 873+ B63D
