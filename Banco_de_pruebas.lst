 625  94DB 00           Cola_de_desplazamiento db 0									; Este byte indica:
 626  94DC
 627  94DC              ;
 628  94DC              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 629  94DC              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 630  94DC              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 631  94DC              ;
 632  94DC              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 633  94DC              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 634  94DC              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 635  94DC              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 636  94DC              ;
 637  94DC              ;															;	"$ff" ..... Bucle infinito de repetición.
 638  94DC              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 639  94DC              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
