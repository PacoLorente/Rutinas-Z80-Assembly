   1+ 9452              ; ******************************************************************************************************************************************************************************************
   2+ 9452              ;
   3+ 9452              ;   21/04/24
   4+ 9452              ;
   5+ 9452              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9452              ;   (XOR) bit a bit.
   7+ 9452              ;
   8+ 9452              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9452
  10+ 9452              Derivando_RND
  11+ 9452
  12+ 9452 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9455
  14+ 9455 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9457 C5               push bc
  16+ 9458              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9458 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 945B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 945B
  20+ 945B A7           6 and a                                 ; Carry a "0".
  21+ 945C CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 945E 30 02            jr nc,1F
  23+ 9460
  24+ 9460 CB C1            set 0,c
  25+ 9462
  26+ 9462 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9463 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9465 5F               ld e,a
  29+ 9466
  30+ 9466 7A               ld a,d
  31+ 9467 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9469 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 946B
  34+ 946B CB 3F            srl a
  35+ 946D
  36+ 946D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 946E
  38+ 946E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 946F 28 04            jr z,4F
  40+ 9471
  41+ 9471 CB FF            set 7,a
  42+ 9473 18 02            jr 5F
  43+ 9475
  44+ 9475 CB BF        4 res 7,a
  45+ 9477
  46+ 9477 CB 21        5 sla c
  47+ 9479 10 E0            djnz 6B
  48+ 947B
  49+ 947B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 947C
  51+ 947C 77               ld (hl),a
  52+ 947D 23               inc hl
  53+ 947E C1               pop bc
  54+ 947F 10 D4            djnz 3B
  55+ 9481
  56+ 9481 C9               ret
