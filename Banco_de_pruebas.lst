   5+ 991B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 991B              ;   (XOR) bit a bit.
   7+ 991B              ;
   8+ 991B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 991B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 991B
  11+ 991B              Derivando_RND
  12+ 991B
  13+ 991B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 991D C5               push bc
  15+ 991E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 991E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9921              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9921
  19+ 9921 A7           6 and a                                 ; Carry a "0".
  20+ 9922 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9924 30 02            jr nc,1F
  22+ 9926
  23+ 9926 CB C1            set 0,c
  24+ 9928
  25+ 9928 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9929 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 992B 5F               ld e,a
  28+ 992C
  29+ 992C 7A               ld a,d
  30+ 992D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 992F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9931
  33+ 9931 CB 3F            srl a
  34+ 9933
  35+ 9933 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9934
  37+ 9934 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9935 28 04            jr z,4F
  39+ 9937
  40+ 9937 CB FF            set 7,a
  41+ 9939 18 02            jr 5F
  42+ 993B
  43+ 993B CB BF        4 res 7,a
  44+ 993D
  45+ 993D CB 21        5 sla c
  46+ 993F 10 E0            djnz 6B
  47+ 9941
  48+ 9941 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9942
  50+ 9942 77               ld (hl),a
  51+ 9943 23               inc hl
  52+ 9944 C1               pop bc
