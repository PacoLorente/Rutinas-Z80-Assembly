 443  949D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 444  949D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 445  949D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
