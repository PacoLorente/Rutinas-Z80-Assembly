3192  A0B5              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A0B5              ; ******************************************************************************************************************************************************************************************
   2+ A0B5              ;
   3+ A0B5              ;   3/4/25
   4+ A0B5              ;
   5+ A0B5              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0B5              ;   (XOR) bit a bit.
   7+ A0B5              ;
   8+ A0B5              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0B5              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0B5
  11+ A0B5              Derivando_RND
  12+ A0B5
  13+ A0B5 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0B7 C5               push bc
  15+ A0B8              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0B8 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0BB              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0BB
  19+ A0BB A7           6 and a                                 ; Carry a "0".
  20+ A0BC CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0BE 30 02            jr nc,1F
  22+ A0C0
  23+ A0C0 CB C1            set 0,c
  24+ A0C2
  25+ A0C2 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0C3 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0C5 5F               ld e,a
  28+ A0C6
  29+ A0C6 7A               ld a,d
  30+ A0C7 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0C9 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0CB
  33+ A0CB CB 3F            srl a
  34+ A0CD
  35+ A0CD AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0CE
  37+ A0CE 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0CF 28 04            jr z,4F
  39+ A0D1
  40+ A0D1 CB FF            set 7,a
  41+ A0D3 18 02            jr 5F
  42+ A0D5
  43+ A0D5 CB BF        4 res 7,a
  44+ A0D7
  45+ A0D7 CB 21        5 sla c
  46+ A0D9 10 E0            djnz 6B
  47+ A0DB
  48+ A0DB 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0DC
  50+ A0DC 77               ld (hl),a
  51+ A0DD 23               inc hl
  52+ A0DE C1               pop bc
  53+ A0DF 10 D4            djnz 3B
  54+ A0E1
  55+ A0E1 C9               ret
  56+ A0E2
  57+ A0E2
  58+ A0E2
# file closed: RND_Derivando.asm
