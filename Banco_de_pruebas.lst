1417+ B83D 2A 0B 95         ld hl,(Entidad_sospechosa_de_colision)
1418+ B840 36 00            ld (hl),0                                       ; Coloca a "0" el .db (Impacto) de la (Entidad_sospechosa_de_colision).
1419+ B842 C9               ret
1420+ B843
1421+ B843              ;   COLISIÓN !!!!!.
1422+ B843              ;
1423+ B843              ;   .db (Impacto) de Amadeus a "1".
1424+ B843              ;   SET el bit3 de (Impacto2).
1425+ B843              ;
1426+ B843              ;   Nota: El .db (Impacto) de la entidad implicada lo puso a "1" la rutina [Compara_coordenadas_X].
1427+ B843
1428+ B843 E1           5 pop hl
1429+ B844 C1               pop bc
1430+ B845
1431+ B845 21 D7 90         ld hl,Impacto_Amadeus
1432+ B848 36 01            ld (hl),1
1433+ B84A 21 0A 95         ld hl,Impacto2                                 ; Cuando se produce Colisión, RES el bit2 de (Impacto2) y_
1434+ B84D CB 96            res 2,(hl)                                     ; _ SET el bit3. El bit3 de (Impacto2) indica que hay contacto_
1435+ B84F
1436+ B84F 11 60 8B         ld de,Indice_Explosion_entidades
1437+ B852 2A 0B 95         ld hl,(Entidad_sospechosa_de_colision)         ; Situamos el (Puntero_de_almacen_de_mov_masticados) de la entidad impactada en la primera palabra del índice de explosiones.
1438+ B855
1439+ B855 23               inc hl
1440+ B856 23               inc hl
1441+ B857 23               inc hl
1442+ B858
1443+ B858 73               ld (hl),e
1444+ B859 23               inc hl
1445+ B85A 72               ld (hl),d
1446+ B85B
1447+ B85B              ; Situamos también el (Puntero_de_almacen_de_mov_masticados) de Amadeus en la primero explosión.
1448+ B85B
1449+ B85B 11 F6 8B         ld de,Indice_Explosion_Amadeus
1450+ B85E 21 DA 90         ld hl,Pamm_Amadeus
1451+ B861
