 742+ 9F7F
 743+ 9F7F 0D           1 dec c                     ; Decrementa nº de ondas.
 744+ 9F80
 745+ 9F80 22 B6 94         ld (Sound),hl
 746+ 9F83
 747+ 9F83 20 D2            jr nz,Loop_2
 748+ 9F85
 749+ 9F85 C9               ret
 750+ 9F86
