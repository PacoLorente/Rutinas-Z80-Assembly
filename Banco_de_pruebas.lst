 352+ C169              ; ----- ----- ----- ----- -----
 353+ C169              ;
 354+ C169              ;   23/9/26
 355+ C169              ;
 356+ C169              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C169              ;
 358+ C169              ;   HL define el sonido.
 359+ C169              ;
 360+ C169              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C169              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C169              ;
 363+ C169              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C169              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C169              ;
 366+ C169              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C169              ;
 368+ C169              ;   INPUTS: (Shot_sound) <> "0".
 369+ C169              ;
 370+ C169              ;   MODIFY: AF, HL y BC.
 371+ C169              ;
 372+ C169              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C169
 374+ C169              Play_shot_sound_effect:
 375+ C169
 376+ C169              ;   Exclusiones:
 377+ C169
 378+ C169 2A 69 96         ld hl,(Shot_sound)
 379+ C16C 7C               ld a,h
 380+ C16D B5               or l
 381+ C16E C8               ret z                   ; RET si no se ha producido disparo.
 382+ C16F
 383+ C16F 3A 3C 96         ld a,(Ctrl_6)
 384+ C172 CB 47            bit 0,a
 385+ C174 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C175
 387+ C175 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
