 522  93C1              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 523  93C1
 524  93C1 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 525  93C3              ;															  _palabras que componen el "movimiento_masticado".
 526  93C3
 527  93C3              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 528  93C3
 529  93C3 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 530  93C4              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 531  93C4              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 532  93C4              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 533  93C4              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 534  93C4
