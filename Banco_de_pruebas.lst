 584+ B0F5 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B0F7 6F               ld l,a
 586+ B0F8 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B0F9
 588+ B0F9 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B0FA D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B0FC 67               ld h,a
 591+ B0FD C9               ret
