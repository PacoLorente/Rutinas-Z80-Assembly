 298  8F11 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 299  8F13 00 00        Puntero_indice_mov_bucle defw 0
 300  8F15              ;
 301  8F15              ;
 302  8F15 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 303  8F16              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 304  8F16              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 305  8F16
 306  8F16 00           Incrementa_puntero_backup db 0
 307  8F17 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 308  8F18              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 309  8F18
 310  8F18 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 311  8F19 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 312  8F1A 00           Cola_de_desplazamiento db 0									; Este byte indica:
 313  8F1B
 314  8F1B              ;
 315  8F1B              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8F1B              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8F1B              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8F1B              ;
 319  8F1B              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8F1B              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 321  8F1B              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8F1B              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
