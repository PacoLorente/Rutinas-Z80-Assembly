   2+ 9C17              ;
   3+ 9C17              ;   3/4/25
   4+ 9C17              ;
   5+ 9C17              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9C17              ;   (XOR) bit a bit.
   7+ 9C17              ;
   8+ 9C17              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9C17              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9C17
  11+ 9C17              Derivando_RND
  12+ 9C17
  13+ 9C17 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9C19 C5               push bc
  15+ 9C1A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9C1A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9C1D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9C1D
  19+ 9C1D A7           6 and a                                 ; Carry a "0".
  20+ 9C1E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9C20 30 02            jr nc,1F
  22+ 9C22
  23+ 9C22 CB C1            set 0,c
  24+ 9C24
  25+ 9C24 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9C25 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9C27 5F               ld e,a
  28+ 9C28
  29+ 9C28 7A               ld a,d
  30+ 9C29 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9C2B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9C2D
  33+ 9C2D CB 3F            srl a
  34+ 9C2F
  35+ 9C2F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9C30
  37+ 9C30 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9C31 28 04            jr z,4F
  39+ 9C33
  40+ 9C33 CB FF            set 7,a
  41+ 9C35 18 02            jr 5F
  42+ 9C37
  43+ 9C37 CB BF        4 res 7,a
  44+ 9C39
  45+ 9C39 CB 21        5 sla c
  46+ 9C3B 10 E0            djnz 6B
  47+ 9C3D
  48+ 9C3D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C3E
  50+ 9C3E 77               ld (hl),a
  51+ 9C3F 23               inc hl
  52+ 9C40 C1               pop bc
  53+ 9C41 10 D4            djnz 3B
  54+ 9C43
  55+ 9C43 C9               ret
  56+ 9C44
  57+ 9C44
  58+ 9C44
