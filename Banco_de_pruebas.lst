 790  D101
 791  D101 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
 792  D102
 793  D102 38 03        	jr c,1F
 794  D104
 795  D104              ;	Por encima o igual que (Max_time_to_appear_entities).
 796  D104
 797  D104 4E           	ld c,(hl)
 798  D105 18 06        	jr 2F
 799  D107
 800  D107              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
 801  D107              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
 802  D107
 803  D107 23           1 inc hl
 804  D108 23           	inc hl
 805  D109
 806  D109 BE           	cp (hl)
 807  D10A
