   1+ 946E              ; ******************************************************************************************************************************************************************************************
   2+ 946E              ;
   3+ 946E              ;   21/04/24
   4+ 946E              ;
   5+ 946E              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 946E              ;   (XOR) bit a bit.
   7+ 946E              ;
   8+ 946E              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 946E
  10+ 946E              Derivando_RND
  11+ 946E
  12+ 946E 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9471
  14+ 9471 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9473 C5               push bc
  16+ 9474              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9474 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9477              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9477
  20+ 9477 A7           6 and a                                 ; Carry a "0".
  21+ 9478 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 947A 30 02            jr nc,1F
  23+ 947C
  24+ 947C CB C1            set 0,c
  25+ 947E
  26+ 947E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 947F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9481 5F               ld e,a
  29+ 9482
