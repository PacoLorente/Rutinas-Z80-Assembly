1508  99E1 BE           	cp (hl)
1509  99E2
1510  99E2 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1511  99E3
1512  99E3 38 03        	jr c,1F
1513  99E5
1514  99E5              ;	Por encima o igual que (Max_time_to_appear_entities).
1515  99E5
1516  99E5 4E           	ld c,(hl)
1517  99E6 18 06        	jr 2F
1518  99E8
1519  99E8              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1520  99E8              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1521  99E8
1522  99E8 23           1 inc hl
1523  99E9 23           	inc hl
