 255+ A37E              ; 	12/11/26
 256+ A37E              ;
 257+ A37E              ; 	Almacena en (A) uno de los 7 nº pseudo aleatorios generados, ($00-$ff) y avanza el puntero (RND_SP) a la posición de mem. del siguiente nº.
 258+ A37E              ; 	Reiniciamos el puntero (RND_SP) a su posición inicial, 'Numeros_aleatorios' cuando este apunta a: 'Numeros_aleatorios+7'.
 259+ A37E              ;
 260+ A37E              ;	MODIFY: HL,DE,A
 261+ A37E              ;
 262+ A37E              ;	OUTPUTS: (A) contiene un Nº aleatorio. Actualiza el puntero de nº aleatorios (RND_SP).
 263+ A37E              ;
 264+ A37E              ;	Variables implicadas: (RND_SP).
 265+ A37E
 266+ A37E              Extrae_numero_aleatorio_y_avanza:
 267+ A37E
 268+ A37E 21 7A 91     	ld hl,Numeros_aleatorios+7						; Dirección de memoria donde se almacena el último n° pseudo aleatorio generado +1.
 269+ A381 ED 5B 13 96  	ld de,(RND_SP) 									; Puntero que se irá desplazando por el SET de nº aleatorios. Inicialmente apunta al 1°.
 270+ A385
 271+ A385              ;													; (HL) contiene la dirección del n° aleatorio que vamos a extraer.
 272+ A385              ;													; (DE)     "           "      "  último n° aleatorio +1, (detecta reinicio).
 273+ A385
 274+ A385 A7           	and a 											; Carry a "0".
 275+ A386
 276+ A386 ED 52        	sbc hl,de 										; Detecta el final de la caja de n° pseudo aleatorios.
 277+ A388 20 08        	jr nz,1F
 278+ A38A
 279+ A38A              ; 	Inicializa el puntero al principio de la caja de nº aleatorios pseudo aleatorios.
