 533  94D2              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 534  94D2
 535  94D2 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 536  94D3 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 537  94D4 00           Cola_de_desplazamiento db 0									; Este byte indica:
 538  94D5
 539  94D5              ;
 540  94D5              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 541  94D5              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 542  94D5              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 543  94D5              ;
 544  94D5              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 545  94D5              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 546  94D5              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 547  94D5              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 548  94D5              ;
 549  94D5              ;															;	"$ff" ..... Bucle infinito de repetición.
 550  94D5              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 551  94D5              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 552  94D5
