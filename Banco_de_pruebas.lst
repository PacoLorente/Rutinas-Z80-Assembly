 482  93FF
 483  93FF              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 484  93FF
 485  93FF 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 486  9400              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 487  9400              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 488  9400              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 489  9400
 490  9400 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 491  9401              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 492  9401 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 493  9402 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 494  9403
 495  9403 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 496  9404              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 497  9404              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 498  9404
 499  9404              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 500  9404              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 501  9404
 502  9404              ; Ejemplos:
 503  9404
 504  9404              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 505  9404              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 506  9404              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 507  9404              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 508  9404              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 509  9404
 510  9404 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 511  9405              ;															  _ que esta entidad haya colisionado con Amadeus.
 512  9405              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 513  9405
 514  9405 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 515  9407              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 516  9407
 517  9407 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 518  9409
 519  9409              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 520  9409
 521  9409 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 522  940B              ;															  _palabras que componen el "movimiento_masticado".
 523  940B
 524  940B              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 525  940B
 526  940B 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 527  940C              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 528  940C              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 529  940C              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 530  940C              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 531  940C
 532  940C 00           Attr db 0 													; Atributos de la entidad.
 533  940D
 534  940D              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 535  940D
 536  940D
 537  940D
 538  940D 00           Ctrl_2 db 0
 539  940E              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 540  940E              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 541  940E              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 542  940E              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 543  940E              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 544  940E              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 545  940E              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 546  940E              ;
 547  940E              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 548  940E              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 549  940E              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 550  940E              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 551  940E              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 552  940E              ;															BIT 4, ???
 553  940E              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 554  940E              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
 555  940E              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
 556  940E              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 557  940E              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 558  940E
 559  940E 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 560  940F              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 561  940F              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 562  940F              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 563  940F              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 564  940F              ;
 565  940F              ; 															DESCRIPCIÖN:
 566  940F              ;
 567  940F              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 568  940F              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 569  940F              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 570  940F              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 571  940F              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 572  940F              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 573  940F              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 574  940F              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 575  940F              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 576  940F              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 577  940F              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 578  940F              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 579  940F              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 580  940F              ;
 581  940F              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 582  940F              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 583  940F              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 584  940F
 585  940F 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 586  9410              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 587  9410              ;															; _rojo - amarillo.
 588  9410
 589  9410 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 590  9411              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 591  9411
 592  9411 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 593  9413 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
 594  9415
 595  9415              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 596  9415
 597  9415 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 598  9416              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 599  9416              ;
 600  9416              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
 601  9416
 602  9416              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 603  9416
 604  9416              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
 605  9416              ;
 606  9416              ;	COLORES: 0 ..... NEGRO
 607  9416              ;    		 1 ..... AZUL    jr $
 608  9416              ; 			 2 ..... ROJO
 609  9416              ;			 3 ..... MAGENTA
 610  9416              ; 			 4 ..... VERDE
 611  9416              ; 			 5 ..... CIAN
 612  9416              ;			 6 ..... AMARILLO
 613  9416              ; 			 7 ..... BLANCO
 614  9416
 615  9416
 616  9416 00 00        Indice_Sprite_der defw 0
 617  9418 00 00        Indice_Sprite_izq defw 0
 618  941A 00 00        Puntero_DESPLZ_der defw 0
 619  941C 00 00        Puntero_DESPLZ_izq defw 0
 620  941E 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 621  9420
 622  9420 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 623  9421              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 624  9421              ;															; _baja de la pantalla cuando hemos superado el nivel.
 625  9421
 626  9421 00           Columnas db 0
 627  9422 00           Limite_vertical db 0 										; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 628  9423              ;															; 2ª Función de (Limite_vertical):
 629  9423              ;															; Se inicializa a "0" cada vez que ejecutamos el bucle de entidades. Se utiliza como contador; se incrementa (+1) cada vez que se añade una_
 630  9423              ;															; _descripción a la (Tabla_de_pintado). Este valor lo utiliza la rutina [Ordena_tabla_de_pintado] para ordenar la tabla antes de imprimir.
 631  9423
 632  9423
 633  9423
 634  9423              ; Variables de control general.
 635  9423
 636  9423 00           Frames_explosion db 0 										; Nº de Frames que tiene la explosión.
 637  9424
 638  9424              ; Variables de funcionamiento, (No incluidas en base de datos de entidades), a partir de aquí!!!!!
 639  9424
 640  9424              Perfiles_de_velocidad
 641  9424
 642  9424 00           Vel_left db 0 												; Velocidad izquierda. Nº de píxeles que desplazamos el objeto a izquierda. 1, 2, 4 u 8 px.
 643  9425 00           Vel_right db 0 												; Velocidad derecha. Nº de píxeles que desplazamos el objeto a derecha. 1, 2, 4 u 8 px.
 644  9426 00           Vel_up db 0 												; Velocidad subida. Nº de píxeles que desplazamos el objeto hacia arriba. (De 1 a 7px).
 645  9427 00           Vel_down db 0 												; Velocidad bajada. Nº de píxeles que desplazamos el objeto hacia abajo. (De 1 a 7px).
 646  9428
