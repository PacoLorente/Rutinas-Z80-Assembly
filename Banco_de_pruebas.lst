   5+ 99B5              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99B5              ;   (XOR) bit a bit.
   7+ 99B5              ;
   8+ 99B5              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99B5              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99B5
  11+ 99B5              Derivando_RND
  12+ 99B5
  13+ 99B5 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99B7 C5               push bc
  15+ 99B8              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99B8 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99BB              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99BB
  19+ 99BB A7           6 and a                                 ; Carry a "0".
  20+ 99BC CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99BE 30 02            jr nc,1F
  22+ 99C0
  23+ 99C0 CB C1            set 0,c
  24+ 99C2
  25+ 99C2 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99C3 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99C5 5F               ld e,a
  28+ 99C6
  29+ 99C6 7A               ld a,d
  30+ 99C7 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99C9 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99CB
  33+ 99CB CB 3F            srl a
  34+ 99CD
  35+ 99CD AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99CE
  37+ 99CE 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99CF 28 04            jr z,4F
  39+ 99D1
  40+ 99D1 CB FF            set 7,a
  41+ 99D3 18 02            jr 5F
  42+ 99D5
  43+ 99D5 CB BF        4 res 7,a
  44+ 99D7
  45+ 99D7 CB 21        5 sla c
  46+ 99D9 10 E0            djnz 6B
  47+ 99DB
  48+ 99DB 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99DC
  50+ 99DC 77               ld (hl),a
  51+ 99DD 23               inc hl
  52+ 99DE C1               pop bc
  53+ 99DF 10 D4            djnz 3B
  54+ 99E1
  55+ 99E1 C9               ret
