   1+ A0BA              ; ******************************************************************************************************************************************************************************************
   2+ A0BA              ;
   3+ A0BA              ;   3/4/25
   4+ A0BA              ;
   5+ A0BA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0BA              ;   (XOR) bit a bit.
   7+ A0BA              ;
   8+ A0BA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0BA              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0BA
  11+ A0BA              Derivando_RND
  12+ A0BA
  13+ A0BA ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0BC C5               push bc
  15+ A0BD              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0BD 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0C0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0C0
  19+ A0C0 A7           6 and a                                 ; Carry a "0".
  20+ A0C1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0C3 30 02            jr nc,1F
  22+ A0C5
  23+ A0C5 CB C1            set 0,c
  24+ A0C7
  25+ A0C7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0C8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0CA 5F               ld e,a
  28+ A0CB
  29+ A0CB 7A               ld a,d
  30+ A0CC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0CE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0D0
  33+ A0D0 CB 3F            srl a
  34+ A0D2
  35+ A0D2 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0D3
  37+ A0D3 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0D4 28 04            jr z,4F
  39+ A0D6
  40+ A0D6 CB FF            set 7,a
  41+ A0D8 18 02            jr 5F
  42+ A0DA
  43+ A0DA CB BF        4 res 7,a
  44+ A0DC
  45+ A0DC CB 21        5 sla c
  46+ A0DE 10 E0            djnz 6B
  47+ A0E0
  48+ A0E0 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0E1
  50+ A0E1 77               ld (hl),a
  51+ A0E2 23               inc hl
  52+ A0E3 C1               pop bc
  53+ A0E4 10 D4            djnz 3B
  54+ A0E6
  55+ A0E6 C9               ret
  56+ A0E7
  57+ A0E7
  58+ A0E7
