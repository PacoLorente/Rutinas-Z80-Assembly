   5+ 9679              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9679              ;   (XOR) bit a bit.
   7+ 9679              ;
   8+ 9679              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9679              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9679
  11+ 9679              Derivando_RND
  12+ 9679
  13+ 9679 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 967B C5               push bc
  15+ 967C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 967C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 967F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 967F
  19+ 967F A7           6 and a                                 ; Carry a "0".
  20+ 9680 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9682 30 02            jr nc,1F
  22+ 9684
  23+ 9684 CB C1            set 0,c
  24+ 9686
  25+ 9686 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9687 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9689 5F               ld e,a
  28+ 968A
  29+ 968A 7A               ld a,d
  30+ 968B E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 968D 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 968F
  33+ 968F CB 3F            srl a
  34+ 9691
  35+ 9691 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9692
  37+ 9692 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9693 28 04            jr z,4F
  39+ 9695
  40+ 9695 CB FF            set 7,a
  41+ 9697 18 02            jr 5F
  42+ 9699
  43+ 9699 CB BF        4 res 7,a
  44+ 969B
  45+ 969B CB 21        5 sla c
  46+ 969D 10 E0            djnz 6B
  47+ 969F
  48+ 969F 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 96A0
  50+ 96A0 77               ld (hl),a
  51+ 96A1 23               inc hl
  52+ 96A2 C1               pop bc
  53+ 96A3 10 D4            djnz 3B
  54+ 96A5
  55+ 96A5 C9               ret
