   1+ 9E66              ; ******************************************************************************************************************************************************************************************
   2+ 9E66              ;
   3+ 9E66              ;   3/4/25
   4+ 9E66              ;
   5+ 9E66              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E66              ;   (XOR) bit a bit.
   7+ 9E66              ;
   8+ 9E66              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E66              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E66
  11+ 9E66              Derivando_RND
  12+ 9E66
  13+ 9E66 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9E68 C5               push bc
  15+ 9E69              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9E69 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9E6C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9E6C
  19+ 9E6C A7           6 and a                                 ; Carry a "0".
  20+ 9E6D CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9E6F 30 02            jr nc,1F
  22+ 9E71
  23+ 9E71 CB C1            set 0,c
  24+ 9E73
  25+ 9E73 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9E74 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9E76 5F               ld e,a
  28+ 9E77
  29+ 9E77 7A               ld a,d
  30+ 9E78 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9E7A 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9E7C
  33+ 9E7C CB 3F            srl a
  34+ 9E7E
  35+ 9E7E AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9E7F
  37+ 9E7F 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9E80 28 04            jr z,4F
  39+ 9E82
  40+ 9E82 CB FF            set 7,a
  41+ 9E84 18 02            jr 5F
  42+ 9E86
  43+ 9E86 CB BF        4 res 7,a
  44+ 9E88
  45+ 9E88 CB 21        5 sla c
  46+ 9E8A 10 E0            djnz 6B
  47+ 9E8C
  48+ 9E8C 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9E8D
  50+ 9E8D 77               ld (hl),a
  51+ 9E8E 23               inc hl
  52+ 9E8F C1               pop bc
  53+ 9E90 10 D4            djnz 3B
  54+ 9E92
  55+ 9E92 C9               ret
  56+ 9E93
  57+ 9E93
  58+ 9E93
# file closed: RND_Derivando.asm
