 681+ 9F4F 29               add hl,hl
 682+ 9F50 29               add hl,hl                               ;   ASCII * 8
 683+ 9F51
 684+ 9F51 09               add hl,bc
 685+ 9F52
 686+ 9F52 C9               ret
