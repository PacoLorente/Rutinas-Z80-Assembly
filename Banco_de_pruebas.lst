   1+ A0EB              ; ******************************************************************************************************************************************************************************************
   2+ A0EB              ;
   3+ A0EB              ;   3/4/25
   4+ A0EB              ;
   5+ A0EB              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0EB              ;   (XOR) bit a bit.
   7+ A0EB              ;
   8+ A0EB              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0EB              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0EB
  11+ A0EB              Derivando_RND
  12+ A0EB
  13+ A0EB ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0ED C5               push bc
  15+ A0EE              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0EE 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0F1              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0F1
  19+ A0F1 A7           6 and a                                 ; Carry a "0".
  20+ A0F2 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0F4 30 02            jr nc,1F
  22+ A0F6
  23+ A0F6 CB C1            set 0,c
  24+ A0F8
  25+ A0F8 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0F9 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0FB 5F               ld e,a
  28+ A0FC
  29+ A0FC 7A               ld a,d
  30+ A0FD E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0FF 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A101
  33+ A101 CB 3F            srl a
  34+ A103
  35+ A103 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A104
  37+ A104 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A105 28 04            jr z,4F
  39+ A107
  40+ A107 CB FF            set 7,a
  41+ A109 18 02            jr 5F
  42+ A10B
  43+ A10B CB BF        4 res 7,a
  44+ A10D
  45+ A10D CB 21        5 sla c
  46+ A10F 10 E0            djnz 6B
  47+ A111
  48+ A111 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A112
  50+ A112 77               ld (hl),a
  51+ A113 23               inc hl
  52+ A114 C1               pop bc
  53+ A115 10 D4            djnz 3B
  54+ A117
  55+ A117 C9               ret
  56+ A118
  57+ A118
  58+ A118
