   4+ 971B              ;
   5+ 971B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 971B              ;   (XOR) bit a bit.
   7+ 971B              ;
   8+ 971B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 971B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 971B
  11+ 971B              Derivando_RND
  12+ 971B
  13+ 971B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 971D C5               push bc
  15+ 971E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 971E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9721              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9721
  19+ 9721 A7           6 and a                                 ; Carry a "0".
  20+ 9722 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9724 30 02            jr nc,1F
  22+ 9726
  23+ 9726 CB C1            set 0,c
  24+ 9728
  25+ 9728 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9729 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 972B 5F               ld e,a
  28+ 972C
  29+ 972C 7A               ld a,d
  30+ 972D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 972F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9731
  33+ 9731 CB 3F            srl a
  34+ 9733
  35+ 9733 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9734
  37+ 9734 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9735 28 04            jr z,4F
  39+ 9737
  40+ 9737 CB FF            set 7,a
  41+ 9739 18 02            jr 5F
  42+ 973B
  43+ 973B CB BF        4 res 7,a
  44+ 973D
  45+ 973D CB 21        5 sla c
  46+ 973F 10 E0            djnz 6B
  47+ 9741
  48+ 9741 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9742
  50+ 9742 77               ld (hl),a
  51+ 9743 23               inc hl
  52+ 9744 C1               pop bc
  53+ 9745 10 D4            djnz 3B
  54+ 9747
  55+ 9747 C9               ret
  56+ 9748
  57+ 9748
  58+ 9748
