  28+ 96D9 01 FF 02     	LD BC,767
  29+ 96DC 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 96DD ED B0        	LDIR
  31+ 96DF C9           	ret
  32+ 96E0
