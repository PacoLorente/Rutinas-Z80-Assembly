 270  8C82 00           Cuad_objeto db 0										; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 271  8C83 00           Columnas db 0
 272  8C84
 273  8C84 00           Limite_horizontal db 0	 								; Dirección de pantalla, (scanline), calculado en función del tamaño del Sprite. Si el objeto llega a esta línea se modifica_
 274  8C85              ; 														; _(Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
