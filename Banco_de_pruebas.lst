   1+ A10C              ; ******************************************************************************************************************************************************************************************
   2+ A10C              ;
   3+ A10C              ;   3/4/25
   4+ A10C              ;
   5+ A10C              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A10C              ;   (XOR) bit a bit.
   7+ A10C              ;
   8+ A10C              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A10C              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A10C
  11+ A10C              Derivando_RND
  12+ A10C
  13+ A10C ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A10E C5               push bc
  15+ A10F              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A10F 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A112              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A112
  19+ A112 A7           6 and a                                 ; Carry a "0".
  20+ A113 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A115 30 02            jr nc,1F
  22+ A117
  23+ A117 CB C1            set 0,c
  24+ A119
  25+ A119 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A11A E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A11C 5F               ld e,a
  28+ A11D
  29+ A11D 7A               ld a,d
  30+ A11E E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A120 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A122
  33+ A122 CB 3F            srl a
  34+ A124
  35+ A124 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A125
  37+ A125 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A126 28 04            jr z,4F
  39+ A128
  40+ A128 CB FF            set 7,a
  41+ A12A 18 02            jr 5F
  42+ A12C
  43+ A12C CB BF        4 res 7,a
  44+ A12E
  45+ A12E CB 21        5 sla c
  46+ A130 10 E0            djnz 6B
  47+ A132
  48+ A132 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A133
  50+ A133 77               ld (hl),a
  51+ A134 23               inc hl
  52+ A135 C1               pop bc
  53+ A136 10 D4            djnz 3B
  54+ A138
  55+ A138 C9               ret
  56+ A139
  57+ A139
  58+ A139
