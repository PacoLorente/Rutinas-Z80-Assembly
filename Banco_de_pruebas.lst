3263  A05E              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A05E              ; ******************************************************************************************************************************************************************************************
   2+ A05E              ;
   3+ A05E              ;   3/4/25
   4+ A05E              ;
   5+ A05E              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A05E              ;   (XOR) bit a bit.
   7+ A05E              ;
   8+ A05E              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A05E              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A05E
  11+ A05E              Derivando_RND
  12+ A05E
  13+ A05E ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A060 C5               push bc
  15+ A061              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A061 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A064              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A064
  19+ A064 A7           6 and a                                 ; Carry a "0".
  20+ A065 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A067 30 02            jr nc,1F
  22+ A069
  23+ A069 CB C1            set 0,c
  24+ A06B
  25+ A06B 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A06C E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A06E 5F               ld e,a
  28+ A06F
  29+ A06F 7A               ld a,d
  30+ A070 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A072 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A074
  33+ A074 CB 3F            srl a
  34+ A076
  35+ A076 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A077
  37+ A077 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A078 28 04            jr z,4F
  39+ A07A
  40+ A07A CB FF            set 7,a
  41+ A07C 18 02            jr 5F
  42+ A07E
  43+ A07E CB BF        4 res 7,a
  44+ A080
  45+ A080 CB 21        5 sla c
  46+ A082 10 E0            djnz 6B
  47+ A084
  48+ A084 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A085
  50+ A085 77               ld (hl),a
  51+ A086 23               inc hl
  52+ A087 C1               pop bc
  53+ A088 10 D4            djnz 3B
  54+ A08A
  55+ A08A C9               ret
  56+ A08B
  57+ A08B
  58+ A08B
# file closed: RND_Derivando.asm
