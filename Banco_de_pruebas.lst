1754  9965              ;
1755  9965              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
1756  9965              ;
1757  9965              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
1758  9965              ;
1759  9965              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
1760  9965              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
1761  9965              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
1762  9965              ;
1763  9965              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
1764  9965              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
1765  9965              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
1766  9965              ;				  _medida que transcurre el tiempo.
1767  9965              ;
1768  9965              ;	OUTPUT: Define (Clock_next_entity).
1769  9965
1770  9965              Define_Clock_next_entity:
1771  9965
1772  9965 21 D1 94     	ld hl,Max_time_to_appear_entities
1773  9968 BE           	cp (hl)
1774  9969 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1775  996A
1776  996A 38 01        	jr c,1F
1777  996C
1778  996C              ;	Por encima o igual que (Max_time_to_appear_entities).
1779  996C              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1780  996C
1781  996C 4E           	ld c,(hl)
1782  996D
1783  996D              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1784  996D              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1785  996D
1786  996D 23           1 inc hl
1787  996E 23           	inc hl
1788  996F
1789  996F BE           	cp (hl)
1790  9970
1791  9970 30 01        	jr nc,2F
