  97+ AB42 E6 E0        	and $e0                                             ; La máscara "$e0" entrega el valor de la primera columna de la Fila en la que nos encontamos:
  98+ AB44              ;
  99+ AB44              ;                                                       : Ejemplo:
 100+ AB44              ;
 101+ AB44              ;                                                       Cuando (L) contiene: "$0f", "$1c", "$08", ...etc (A) contiene "$00"
 102+ AB44              ;                                                       Cuando (L) contiene: "$2f", "$3c", "$28", ...etc (A) contiene "$20"
 103+ AB44              ;                                                       Cuando (L) contiene: "$4f", "$5c", "$48", ...etc (A) contiene "$40"
 104+ AB44              ;                                                       Cuando (L) contiene: "$6f", "$7c", "$68", ...etc (A) contiene "$60"
