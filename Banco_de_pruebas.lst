 394  8E66 00           Cola_de_desplazamiento db 0									; Este byte indica:
 395  8E67
 396  8E67              ;
 397  8E67              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 398  8E67              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 399  8E67              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 400  8E67              ;
 401  8E67              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 402  8E67              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 403  8E67              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 404  8E67              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 405  8E67              ;
 406  8E67              ;															;	"$ff" ..... Bucle infinito de repetición.
 407  8E67              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 408  8E67              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
