 819+ B603              ;	Limpia un espacio de la memoria.
 820+ B603              ;
 821+ B603              ;	INPUTS:  HL apunta al 1er byte del espacio de memoria que queremos limpiar.
 822+ B603              ;				   BC indica el nº de bytes que vamos a poner a "0".
 823+ B603              ;
 824+ B603              ;	MODIFY: HL,DE,BC
 825+ B603
