3209  A005              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A005              ; ******************************************************************************************************************************************************************************************
   2+ A005              ;
   3+ A005              ;   3/4/25
   4+ A005              ;
   5+ A005              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A005              ;   (XOR) bit a bit.
   7+ A005              ;
   8+ A005              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A005              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A005
  11+ A005              Derivando_RND
  12+ A005
  13+ A005 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A007 C5               push bc
  15+ A008              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A008 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A00B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A00B
  19+ A00B A7           6 and a                                 ; Carry a "0".
  20+ A00C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A00E 30 02            jr nc,1F
  22+ A010
  23+ A010 CB C1            set 0,c
  24+ A012
  25+ A012 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A013 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A015 5F               ld e,a
  28+ A016
  29+ A016 7A               ld a,d
  30+ A017 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A019 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A01B
  33+ A01B CB 3F            srl a
  34+ A01D
  35+ A01D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A01E
  37+ A01E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A01F 28 04            jr z,4F
  39+ A021
  40+ A021 CB FF            set 7,a
  41+ A023 18 02            jr 5F
  42+ A025
  43+ A025 CB BF        4 res 7,a
  44+ A027
  45+ A027 CB 21        5 sla c
  46+ A029 10 E0            djnz 6B
  47+ A02B
  48+ A02B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A02C
  50+ A02C 77               ld (hl),a
  51+ A02D 23               inc hl
  52+ A02E C1               pop bc
  53+ A02F 10 D4            djnz 3B
  54+ A031
  55+ A031 C9               ret
  56+ A032
  57+ A032
  58+ A032
# file closed: RND_Derivando.asm
