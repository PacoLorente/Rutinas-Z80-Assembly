 387  947D 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 388  947E              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 389  947E              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 390  947E              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 391  947E
 392  947E 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 393  947F              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 394  947F 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 395  9480 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 396  9481
 397  9481 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 398  9482              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 399  9482              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 400  9482
 401  9482              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 402  9482              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 403  9482
 404  9482              ; Ejemplos:
 405  9482
 406  9482              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 407  9482              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 408  9482              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 409  9482              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 410  9482              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 411  9482
 412  9482 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 413  9483              ;															  _ que esta entidad haya colisionado con Amadeus.
 414  9483              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 415  9483
