   1+ A102              ; ******************************************************************************************************************************************************************************************
   2+ A102              ;
   3+ A102              ;   3/4/25
   4+ A102              ;
   5+ A102              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A102              ;   (XOR) bit a bit.
   7+ A102              ;
   8+ A102              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A102              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A102
  11+ A102              Derivando_RND
  12+ A102
  13+ A102 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A104 C5               push bc
  15+ A105              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A105 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A108              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A108
  19+ A108 A7           6 and a                                 ; Carry a "0".
  20+ A109 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A10B 30 02            jr nc,1F
  22+ A10D
  23+ A10D CB C1            set 0,c
  24+ A10F
  25+ A10F 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A110 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A112 5F               ld e,a
  28+ A113
  29+ A113 7A               ld a,d
  30+ A114 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A116 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A118
  33+ A118 CB 3F            srl a
  34+ A11A
  35+ A11A AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A11B
  37+ A11B 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A11C 28 04            jr z,4F
  39+ A11E
  40+ A11E CB FF            set 7,a
  41+ A120 18 02            jr 5F
  42+ A122
  43+ A122 CB BF        4 res 7,a
  44+ A124
  45+ A124 CB 21        5 sla c
  46+ A126 10 E0            djnz 6B
  47+ A128
  48+ A128 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A129
  50+ A129 77               ld (hl),a
  51+ A12A 23               inc hl
  52+ A12B C1               pop bc
  53+ A12C 10 D4            djnz 3B
  54+ A12E
  55+ A12E C9               ret
  56+ A12F
  57+ A12F
  58+ A12F
# file closed: RND_Derivando.asm
