3284  A0DF              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A0DF              ; ******************************************************************************************************************************************************************************************
   2+ A0DF              ;
   3+ A0DF              ;   3/4/25
   4+ A0DF              ;
   5+ A0DF              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0DF              ;   (XOR) bit a bit.
   7+ A0DF              ;
   8+ A0DF              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0DF              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0DF
  11+ A0DF              Derivando_RND
  12+ A0DF
  13+ A0DF ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0E1 C5               push bc
  15+ A0E2              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0E2 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0E5              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0E5
  19+ A0E5 A7           6 and a                                 ; Carry a "0".
  20+ A0E6 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0E8 30 02            jr nc,1F
  22+ A0EA
  23+ A0EA CB C1            set 0,c
  24+ A0EC
  25+ A0EC 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0ED E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0EF 5F               ld e,a
  28+ A0F0
  29+ A0F0 7A               ld a,d
  30+ A0F1 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0F3 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0F5
  33+ A0F5 CB 3F            srl a
  34+ A0F7
  35+ A0F7 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0F8
  37+ A0F8 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0F9 28 04            jr z,4F
  39+ A0FB
  40+ A0FB CB FF            set 7,a
  41+ A0FD 18 02            jr 5F
  42+ A0FF
  43+ A0FF CB BF        4 res 7,a
  44+ A101
  45+ A101 CB 21        5 sla c
  46+ A103 10 E0            djnz 6B
  47+ A105
  48+ A105 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A106
  50+ A106 77               ld (hl),a
  51+ A107 23               inc hl
  52+ A108 C1               pop bc
  53+ A109 10 D4            djnz 3B
  54+ A10B
  55+ A10B C9               ret
  56+ A10C
  57+ A10C
  58+ A10C
