1819  9956 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1820  9957
1821  9957 38 03        	jr c,1F
1822  9959
1823  9959              ;	Por encima o igual que (Max_time_to_appear_entities).
1824  9959
1825  9959 4E           	ld c,(hl)
1826  995A 18 06        	jr 2F
1827  995C
1828  995C              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1829  995C              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1830  995C
1831  995C 23           1 inc hl
