 691+ 9F55
 692+ 9F55 E5               push hl
 693+ 9F56
 694+ 9F56 1A           1 ld a,(de)
 695+ 9F57 77               ld (hl),a                               ;   Print
 696+ 9F58
 697+ 9F58 24               inc h                                   ;   INC scanline.
 698+ 9F59 1C               inc e                                   ;   INC data address
 699+ 9F5A
 700+ 9F5A 10 FA            djnz 1B
 701+ 9F5C
 702+ 9F5C E1               pop hl
 703+ 9F5D
 704+ 9F5D C9               ret
