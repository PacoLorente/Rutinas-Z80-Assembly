 431+ C199              ;   -------------------------------------------------------------------------------------------
 432+ C199              ;
 433+ C199              ;   23/9/26
 434+ C199              ;
 435+ C199              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C199              ;
 437+ C199              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C199              ;   _ [Sound_Generator].
 439+ C199              ;
 440+ C199              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C199              ;
 442+ C199              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C199              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C199              ;
 445+ C199              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C199              ;
 447+ C199              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C199              ;
 449+ C199              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C199
 451+ C199              Play_burst_sound_effect:
 452+ C199
 453+ C199              ;   Exclusiones:
 454+ C199
 455+ C199 3A 6B 96         ld a,(Burst_sound)
 456+ C19C A7               and a
 457+ C19D C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C19E
 459+ C19E 08               ex af,af
 460+ C19F
 461+ C19F 3A 3C 96         ld a,(Ctrl_6)
 462+ C1A2 CB 47            bit 0,a
 463+ C1A4 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C1A5
 465+ C1A5              ;   ----------------------
 466+ C1A5
 467+ C1A5 CB C7            set 0,a
 468+ C1A7 32 3C 96         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C1AA
 470+ C1AA 08               ex af,af                ; Restore (Burst_sound).
 471+ C1AB
 472+ C1AB 67               ld h,a
 473+ C1AC 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1AE
 475+ C1AE E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1AF
 477+ C1AF 22 65 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1B2 0E 03            ld c,3
 479+ C1B4 CD DC 9F         call Noise_efect
 480+ C1B7
 481+ C1B7 D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1B8
 483+ C1B8 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1B9 94               sub h
 485+ C1BA
 486+ C1BA 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1BC
 488+ C1BC 7C               ld a,h
 489+ C1BD 32 6B 96         ld (Burst_sound),a
 490+ C1C0
 491+ C1C0 C9               ret
 492+ C1C1
 493+ C1C1              Clean_burst_efect:
 494+ C1C1
 495+ C1C1 AF               xor a
 496+ C1C2 32 6B 96         ld (Burst_sound),a
 497+ C1C5
 498+ C1C5 3A 3C 96         ld a,(Ctrl_6)
 499+ C1C8 CB 87            res 0,a
 500+ C1CA 32 3C 96         ld (Ctrl_6),a
 501+ C1CD
 502+ C1CD C9               ret
 503+ C1CE
 504+ C1CE              ;   -------------------------------------------------------------------------------------------
 505+ C1CE              ;
 506+ C1CE              ;   23/9/26
 507+ C1CE              ;
 508+ C1CE              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1CE              ;   _ Shield_sound_effect.
 510+ C1CE              ;
 511+ C1CE              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1CE              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1CE              ;
 514+ C1CE              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1CE              ;
 516+ C1CE              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1CE              ;
 518+ C1CE              ;   MODIFY: AF'y BC.
 519+ C1CE
 520+ C1CE              Play_Shield_sound_effect:
 521+ C1CE
 522+ C1CE 3A 6C 96         ld a,(Shield_sound)
 523+ C1D1 A7               and a
 524+ C1D2 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1D3
 526+ C1D3 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1D5
 528+ C1D5              Loop_3:
 529+ C1D5
 530+ C1D5 08               ex af,af
 531+ C1D6
 532+ C1D6 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1D8 D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1DA
 535+ C1DA 08               ex af,af
 536+ C1DB
 537+ C1DB 47               ld b,a
 538+ C1DC
 539+ C1DC 10 FE        Delay_7 djnz Delay_7
 540+ C1DE
 541+ C1DE 08               ex af,af
 542+ C1DF
 543+ C1DF AF               xor a                   ; Black BORDER.
 544+ C1E0 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1E2
 546+ C1E2 08               ex af,af
 547+ C1E3
 548+ C1E3 47               ld b,a
 549+ C1E4
 550+ C1E4 10 FE        Delay_8 djnz Delay_8
 551+ C1E6
 552+ C1E6 0D               dec c
 553+ C1E7
 554+ C1E7 20 EC            jr nz,Loop_3
 555+ C1E9
 556+ C1E9 AF               xor a
 557+ C1EA 32 6C 96         ld (Shield_sound),a
 558+ C1ED
 559+ C1ED C9               ret
 560+ C1EE
 561+ C1EE              ; ---------------------------------------------------------------
 562+ C1EE              ;
 563+ C1EE              ;   18/9/26
 564+ C1EE              ;
 565+ C1EE              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C1EE              ;
 567+ C1EE              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C1EE              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C1EE              ;
 570+ C1EE              ;   MODIFY: A y H.
 571+ C1EE              ;
 572+ C1EE              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C1EE
