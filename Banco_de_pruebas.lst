  21  AB0F              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ AB0F              ; ******************************************************************************************************************************************************************************************
   2+ AB0F              ;
   3+ AB0F              ;   9/8/26
   4+ AB0F              ;
   5+ AB0F              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ AB0F              ;   (XOR) bit a bit.
   7+ AB0F              ;
   8+ AB0F              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ AB0F              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ AB0F
  11+ AB0F              Derivando_RND:
  12+ AB0F
  13+ AB0F ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ AB11
  15+ AB11 C5               push bc
  16+ AB12              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ AB12 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ AB15              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ AB15
  20+ AB15 A7           6 and a                                 ; Carry a "0".
  21+ AB16 CB 3F            srl a                               ; Rotación a la derecha.
  22+ AB18 30 02            jr nc,1F
  23+ AB1A
  24+ AB1A CB C1            set 0,c
  25+ AB1C
  26+ AB1C 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después de la rotación.
  27+ AB1D
  28+ AB1D E6 01            and %00000001                       ; Extraigo bit(0) de r(srl) y lo guardo en E.
  29+ AB1F 5F               ld e,a
  30+ AB20
  31+ AB20 7A               ld a,d
  32+ AB21 E6 02            and %00000010                       ; Extraigo bit(1) de r(srl).
  33+ AB23
  34+ AB23 28 02            jr z,2F
  35+ AB25
  36+ AB25 CB 3F            srl a
  37+ AB27
