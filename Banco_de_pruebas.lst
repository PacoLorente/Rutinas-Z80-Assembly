 613+ AEDA C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ AEDB
 615+ AEDB 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ AEDC D6 20            sub $20             							; Vamos a comprobarlo...
 617+ AEDE 6F               ld l,a
