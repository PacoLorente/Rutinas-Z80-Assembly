 508+ AE93              ;
 509+ AE93              ;   29/10/26
 510+ AE93              ;
 511+ AE93              ;   Imprime el logo "Score:" en el marcador, (parte sup. de la pantalla).
 512+ AE93              ;
 513+ AE93              ;   Para ello haremos TRES llamadas a la rutina de pintado [Pinta_imagen].
 514+ AE93              ;
 515+ AE93              ;   El logo consta de tres grupos de datos de 2x2, (Columnas/Filas).
 516+ AE93              ;
 517+ AE93              ;   El 1er grupo construye el gráfico "Sc".
 518+ AE93              ;   El 2° construye "or".
 519+ AE93              ;   El 3er grupo de datos: "e:".
 520+ AE93              ;
 521+ AE93              ;   MODIFY: AF, HL, DE y BC.
 522+ AE93
 523+ AE93              Print_SCORE_Logo:
 524+ AE93
 525+ AE93 21 12 40         ld hl,Cartel_Score_address                          ; (HL) contendrá la dirección de pantalla donde imprimiremos el logo del panel marcador: "Score:".
 526+ AE96 11 C0 8E         ld de,_Sc                                           ; (DE) contiene la dirección de memoria donde se encuentran los datos del primer bloque, ("Sc").
 527+ AE99
 528+ AE99 CD A9 AE         call Subroutine_001                                 ; [Subroutine_001] asigna (Columnas/Filas) en BC, Attrs. en (A) y pinta imagen, (call Pinta_imagen ).
 529+ AE9C
 530+ AE9C 11 E0 8A         ld de,_or                                           ; (DE) contiene la dirección de memoria donde se encuentran los datos del 2° bloque, ("or").
 531+ AE9F
 532+ AE9F CD A9 AE         call Subroutine_001                                 ; [Subroutine_001] asigna (Columnas/Filas) en BC, Attrs. en (A) y pinta imagen, (call Pinta_imagen ).
 533+ AEA2
 534+ AEA2 11 D4 8C         ld de,_e                                            ; (DE) contiene la dirección de memoria donde se encuentran los datos del 3er bloque, ("e:").
 535+ AEA5
 536+ AEA5 CD A9 AE         call Subroutine_001                                 ; [Subroutine_001] asigna (Columnas/Filas) en BC, Attrs. en (A) y pinta imagen, (call Pinta_imagen ).
 537+ AEA8
 538+ AEA8 C9               ret
 539+ AEA9
 540+ AEA9              Subroutine_001:
 541+ AEA9
 542+ AEA9 E5               push hl                                             ; PUSH Cartel_Score_address (actualizado).
