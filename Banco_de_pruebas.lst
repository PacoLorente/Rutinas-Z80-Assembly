 565  94B9 00 00        Puntero_tabla_Random defw 0
 566  94BB 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 567  94BD 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 568  94BF 00 00        Puntero_indice_mov_bucle defw 0
 569  94C1              ;
 570  94C1              ;
 571  94C1 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 572  94C2              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 573  94C2              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
