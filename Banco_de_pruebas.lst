 456  9403 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 457  9404              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 458  9404              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 459  9404
 460  9404              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 461  9404              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 462  9404
 463  9404              ; Ejemplos:
 464  9404
 465  9404              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 466  9404              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 467  9404              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 468  9404              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 469  9404              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 470  9404
