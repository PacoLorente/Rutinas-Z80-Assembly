 350  949A              ;
 351  949A              ; 29/4/25
 352  949A              ;
 353  949A              ; Parámetros DRAW.
 354  949A              ;
 355  949A
 356  949A              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 357  949A
 358  949A 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 359  949B              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 360  949B              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 361  949B              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 362  949B
 363  949B 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 364  949C              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 365  949C 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 366  949D 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 367  949E
 368  949E 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 369  949F              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 370  949F              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 371  949F
 372  949F              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 373  949F              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 374  949F
 375  949F              ; Ejemplos:
 376  949F
 377  949F              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 378  949F              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 379  949F              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 380  949F              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 381  949F              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 382  949F
