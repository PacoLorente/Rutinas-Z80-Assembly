 298  8C3D
 299  8C3D 00 00        Puntero_tabla_Random defw 0
 300  8C3F 00 00        Puntero_indice_mov defw 0							    ; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 301  8C41 00 00        Puntero_mov defw 0										; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 302  8C43 00 00        Puntero_indice_mov_bucle defw 0							;
 303  8C45              ;
 304  8C45              ;
 305  8C45 00           Incrementa_puntero db 0									; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 306  8C46              ;														; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 307  8C46              ;														; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 308  8C46 00           Incrementa_puntero_backup db 0
 309  8C47 00           Repetimos_desplazamiento db 0							; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 310  8C48              ;														; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 311  8C48 00           Repetimos_desplazamiento_backup db 0					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 312  8C49 00           Repetimos_movimiento db 0								; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 313  8C4A 00           Cola_de_desplazamiento db 0								; Este byte indica:
 314  8C4B              ;
 315  8C4B              ;														;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8C4B              ;														;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8C4B              ;														;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8C4B              ;
 319  8C4B              ;														;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8C4B              ;														;						Nº de veces que vamos a repetir el movimiento completo.
 321  8C4B              ;														;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8C4B              ;														;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 323  8C4B              ;
 324  8C4B              ;														;	"$ff" ..... Bucle infinito de repetición.
 325  8C4B              ;														;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 326  8C4B              ;														;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 327  8C4B
 328  8C4B 00           Ctrl_1 db 0 											; Byte de control de propósito general.
 329  8C4C
 330  8C4C              ;														DESCRIPCIÓN:
 331  8C4C              ;
 332  8C4C              ;														BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 333  8C4C              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 334  8C4C              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 335  8C4C              ;														BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 336  8C4C              ;														BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 337  8C4C              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 338  8C4C
 339  8C4C              ;														BIT 3, Recarga de nueva oleada.
 340  8C4C              ;														BIT 4, Recarga de nueva oleada.
 341  8C4C              ;														BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 342  8C4C              ;														BIT 6, **** Frame completo.
 343  8C4C              ;														BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 344  8C4C
