 590+ B200
 591+ B200 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B201 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B203 6F               ld l,a
 594+ B204 D8               ret c               							; Salimos si se produce el cambio de tercio.
