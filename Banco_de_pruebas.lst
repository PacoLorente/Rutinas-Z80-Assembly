   4+ 9EC4              ;
   5+ 9EC4              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9EC4              ;   (XOR) bit a bit.
   7+ 9EC4              ;
   8+ 9EC4              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9EC4              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9EC4
  11+ 9EC4              Derivando_RND
  12+ 9EC4
  13+ 9EC4 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9EC6 C5               push bc
  15+ 9EC7              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9EC7 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9ECA              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9ECA
  19+ 9ECA A7           6 and a                                 ; Carry a "0".
