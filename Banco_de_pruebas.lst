 350  9198              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 351  9198
 352  9198 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 353  9199 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 354  919A 00           Cola_de_desplazamiento db 0									; Este byte indica:
 355  919B
 356  919B              ;
 357  919B              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 358  919B              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 359  919B              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 360  919B              ;
 361  919B              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 362  919B              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 363  919B              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 364  919B              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 365  919B              ;
 366  919B              ;															;	"$ff" ..... Bucle infinito de repetición.
 367  919B              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 368  919B              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 369  919B
