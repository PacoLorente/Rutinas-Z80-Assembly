 372  919C              ;																DESCRIPCIÓN:
 373  919C              ;
 374  919C              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 375  919C              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 376  919C              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 377  919C              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 378  919C              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 379  919C              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 380  919C
 381  919C              ;															BIT 3, Recarga de nueva oleada.
 382  919C              ;															BIT 4, Recarga de nueva oleada.
 383  919C              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 384  919C              ;															BIT 6, **** Frame completo.
 385  919C              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 386  919C
