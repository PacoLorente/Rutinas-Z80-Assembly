 613+ B1D3 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ B1D4
 615+ B1D4 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B1D5 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B1D7 6F               ld l,a
 618+ B1D8 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ B1D9
 620+ B1D9 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ B1DA C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
