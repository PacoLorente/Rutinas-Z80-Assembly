 174+ C0AA
 175+ C0AA 01 00 40         ld bc,$4000
 176+ C0AD CD 3A 9B     	call DELAY 												; PAUSE. Pausa entre notas, las tres primeras se ejecutan ligadas.
 177+ C0B0
