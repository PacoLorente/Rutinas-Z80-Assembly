  21  AAC2              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ AAC2              ; ******************************************************************************************************************************************************************************************
   2+ AAC2              ;
   3+ AAC2              ;   9/8/26
   4+ AAC2              ;
   5+ AAC2              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ AAC2              ;   (XOR) bit a bit.
   7+ AAC2              ;
   8+ AAC2              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ AAC2              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ AAC2
  11+ AAC2              Derivando_RND:
  12+ AAC2
  13+ AAC2 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ AAC4
  15+ AAC4 C5               push bc
  16+ AAC5              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ AAC5 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ AAC8              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ AAC8
  20+ AAC8 A7           6 and a                                 ; Carry a "0".
  21+ AAC9 CB 3F            srl a                               ; Rotación a la derecha.
  22+ AACB 30 02            jr nc,1F
  23+ AACD
  24+ AACD CB C1            set 0,c
  25+ AACF
  26+ AACF 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después de la rotación.
  27+ AAD0
  28+ AAD0 E6 01            and %00000001                       ; Extraigo bit(0) de r(srl) y lo guardo en E.
  29+ AAD2 5F               ld e,a
  30+ AAD3
  31+ AAD3 7A               ld a,d
  32+ AAD4 E6 02            and %00000010                       ; Extraigo bit(1) de r(srl).
  33+ AAD6
  34+ AAD6 28 02            jr z,2F
  35+ AAD8
  36+ AAD8 CB 3F            srl a
  37+ AADA
  38+ AADA AB           2 xor e                                 ; Realizamos una FUNCIÓN XOR entre el bit(0) y bit (1) de nuestro número aleatorio desplazado.
  39+ AADB
  40+ AADB              ;   FUNCIÓN XOR
  41+ AADB
  42+ AADB              ;   0 0 ..... 0
  43+ AADB              ;   0 1 ..... 1
  44+ AADB              ;   1 0 ..... 1
  45+ AADB              ;   1 1 ..... 0
  46+ AADB
  47+ AADB 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  48+ AADC
  49+ AADC 28 04            jr z,4F
  50+ AADE
  51+ AADE CB FF            set 7,a
  52+ AAE0 18 02            jr 5F
  53+ AAE2
  54+ AAE2 CB BF        4 res 7,a
  55+ AAE4
  56+ AAE4 CB 21        5 sla c
  57+ AAE6 10 E0            djnz 6B
  58+ AAE8
  59+ AAE8 71               ld (hl),c
  60+ AAE9
  61+ AAE9 23               inc hl
  62+ AAEA
  63+ AAEA C1               pop bc
  64+ AAEB 10 D5            djnz 3B
  65+ AAED
  66+ AAED C9               ret
  67+ AAEE
  68+ AAEE
  69+ AAEE
# file closed: RND_Derivando.asm
