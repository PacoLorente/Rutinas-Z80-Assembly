 110+ BA08              ;            A contiene los attrs. del msg.
 111+ BA08              ;
 112+ BA08              ;           % FBPPPIII
 113+ BA08
 114+ BA08              Print_text_msg:
 115+ BA08
 116+ BA08 08               ex af,af                                ;   Attr. en A´.
 117+ BA09
 118+ BA09 E5               push hl
 119+ BA0A D5               push de
 120+ BA0B
 121+ BA0B CD 1B BA         call Find_address
 122+ BA0E
 123+ BA0E EB               ex de,hl                                ;   BIN en DE - Fila en HL.
 124+ BA0F
 125+ BA0F CD 26 BA         call Print_BIN
 126+ BA12
 127+ BA12 D1               pop de
 128+ BA13 E1               pop hl
 129+ BA14
 130+ BA14              ;   Suiguiente char.
 131+ BA14
 132+ BA14 23               inc hl
 133+ BA15
 134+ BA15 34               inc (hl)
 135+ BA16 35               dec (hl)
 136+ BA17
 137+ BA17 C8               ret z                                   ;   RET, fin de msg.
 138+ BA18
 139+ BA18 1C               inc e
 140+ BA19
 141+ BA19 18 ED            jr Print_text_msg
 142+ BA1B
 143+ BA1B              ;   Find char. data.
 144+ BA1B
 145+ BA1B              Find_address
 146+ BA1B
 147+ BA1B 01 00 3C         ld bc,ROM_ASCII
 148+ BA1E
 149+ BA1E 6E               ld l,(hl)
 150+ BA1F 26 00            ld h,0
 151+ BA21
 152+ BA21 29               add hl,hl
 153+ BA22 29               add hl,hl
 154+ BA23 29               add hl,hl                               ;   ASCII * 8
 155+ BA24
 156+ BA24 09               add hl,bc
 157+ BA25
 158+ BA25 C9               ret
 159+ BA26
 160+ BA26              Print_BIN
 161+ BA26
 162+ BA26 06 08            ld b,8                                  ;   Nº de lineas que forman el caracter.
 163+ BA28
 164+ BA28 E5               push hl
 165+ BA29
 166+ BA29 1A           1 ld a,(de)
 167+ BA2A 77               ld (hl),a                               ;   Print
 168+ BA2B
 169+ BA2B 24               inc h                                   ;   INC scanline.
 170+ BA2C 1C               inc e                                   ;   INC data address
 171+ BA2D
 172+ BA2D 10 FA            djnz 1B
 173+ BA2F
 174+ BA2F E1               pop hl
 175+ BA30
 176+ BA30 CD 23 A2         call Calcula_direccion_atributos
 177+ BA33
 178+ BA33 08               ex af,af
 179+ BA34 77               ld (hl),a
 180+ BA35
 181+ BA35 C9               ret
 182+ BA36
