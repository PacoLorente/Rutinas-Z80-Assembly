 185  8EEC              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 186  8EEC
 187  8EEC 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 188  8EEE              ;															  _palabras que componen el "movimiento_masticado".
 189  8EEE
