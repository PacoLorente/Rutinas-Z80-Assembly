 789+ C45F 11 0C 48         ld de,Line_8 + 12                                       ; Dirección de pantalla, Fila 8, columna 12. (1a línea).
 790+ C462 06 00            ld b,0                                                  ; No efecto "Máquina de escribir".
 791+ C464 3E 46            ld a,%01000110                                          ; Attrs.: BRIGHT, BLACK PAPER, YELLOW INK.
 792+ C466
 793+ C466              ;           HL apunta al mensage a imprimir, (msg).
 794+ C466              ;           DE indica la fila de pantalla donde queremos imprimir el msg.
 795+ C466              ;            A contiene los attrs. del msg.
 796+ C466              ;            B Actúa como temporizador, ralentiza la impresión de caracteres, (simula una máquina de escribir).
 797+ C466              ;              No actua cuando su valor es "0".
 798+ C466              ;
 799+ C466              ;   Recordatorio. TABLA DE ATRIBUTOS:
 800+ C466              ;
 801+ C466              ;   El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
 802+ C466              ;
 803+ C466              ;   COLORES: 0 ..... NEGRO
 804+ C466              ;            1 ..... AZUL
 805+ C466              ;            2 ..... ROJO
 806+ C466              ;            3 ..... MAGENTA
 807+ C466              ;            4 ..... VERDE
 808+ C466              ;            5 ..... CIAN
 809+ C466              ;            6 ..... AMARILLO
 810+ C466              ;            7 ..... BLANCO
