 572+ AFFA              ;
 573+ AFFA              ;       DESTRUIDOS: AF y HL !!!
 574+ AFFA              ;
 575+ AFFA              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ AFFA              ;
 577+ AFFA
 578+ AFFA 24           NextScan inc h          							; Incrementamos el scanline.
 579+ AFFB 7C               ld a,h
 580+ AFFC E6 07            and 7
 581+ AFFE C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ AFFF
 583+ AFFF 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B000 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B002 6F               ld l,a
 586+ B003 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B004
 588+ B004 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B005 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B007 67               ld h,a
 591+ B008 C9               ret
