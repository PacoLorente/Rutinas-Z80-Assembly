 119+ C083              ; ----------------------------------------------------------------------------------------------
 120+ C083              ;
 121+ C083              ;   26/09/26
 122+ C083              ;
 123+ C083              ;   Melodía DONE. NIVEL SUPERADO !!!
 124+ C083              ;
 125+ C083              ;   La melodía DONE se ejecuta en DI, (interrupciones deshabilitadas).
 126+ C083              ;
 127+ C083              ;   Está compuesta por 15 notes y 5 pausas.
 128+ C083              ;
 129+ C083              ;   Hay que introducir los parámetros de cada nota que forma la melodía y llamar a la función de sonido [Sound_Generator].
 130+ C083              ;   Los parámetros son:
 131+ C083              ;
 132+ C083              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido, (duración de la nota).
 133+ C083              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 134+ C083              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 135+ C083              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 136+ C083              ;          HL = (NOTA). Duracíon del semiciclo.
 137+ C083              ;
 138+ C083              ;   MODIFY: NO MODIFY REGS. !!!
 139+ C083
 140+ C083              Done_melody:
 141+ C083
 142+ C083 F5               push af
 143+ C084 C5               push bc
 144+ C085 D5               push de
 145+ C086 E5               push hl                                                 ; Store regs.
 146+ C087
 147+ C087              Note_1:
 148+ C087
 149+ C087 01 14 00     	ld bc,$0014                                             ; No ruido / 20 ondas completas
 150+ C08A 11 05 00     	ld de,$0005                                             ; Nota descendente / 5 unid. decrease.
 151+ C08D 21 5E 01     	ld hl,$015e                                             ; Note init. value.
 152+ C090
 153+ C090 22 06 96     	ld (Sound),hl
 154+ C093 CD 67 9F         call Sound_Generator    ; v2. Ok.                       ; Tras la primera nota descendente (HL) se sitúa_
 155+ C096              ;                                                           ; _ en la primera nota de la melodía. (HL)=$00fa
 156+ C096
 157+ C096              Note_2:
 158+ C096
 159+ C096 0E 14            ld c,$14                                                ; Duración de la nueva nota, 20 ondas.
 160+ C098 1E 00            ld e,0                                                  ; No existe decremento. (sonido plano).
 161+ C09A
 162+ C09A 22 06 96         ld (Sound),hl
 163+ C09D CD 67 9F         call Sound_Generator                                    ; Ejecuta nota.
 164+ C0A0
 165+ C0A0              Note_3:
 166+ C0A0
 167+ C0A0 0E 24        	ld c,$24                                                ; Duración de la nueva nota.
 168+ C0A2 2E A5        	ld l,$a5                                                ; (HL) = $00a5. Nota, (duración de un semiciclo).
 169+ C0A4              ;                                                           ; (E) = $00, no existe decremento. (sonido plano).
 170+ C0A4 22 06 96     	ld (Sound),hl
 171+ C0A7 CD 67 9F         call Sound_Generator 									; Ejecuta nota.
