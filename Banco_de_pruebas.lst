 340  92BF 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 341  92C1 00 00        Puntero_indice_mov_bucle defw 0
 342  92C3              ;
 343  92C3              ;
 344  92C3 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 345  92C4              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 346  92C4              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 347  92C4
