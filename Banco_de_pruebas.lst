3286  A061              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A061              ; ******************************************************************************************************************************************************************************************
   2+ A061              ;
   3+ A061              ;   3/4/25
   4+ A061              ;
   5+ A061              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A061              ;   (XOR) bit a bit.
   7+ A061              ;
   8+ A061              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A061              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A061
  11+ A061              Derivando_RND
  12+ A061
  13+ A061 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A063 C5               push bc
  15+ A064              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A064 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A067              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A067
  19+ A067 A7           6 and a                                 ; Carry a "0".
  20+ A068 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A06A 30 02            jr nc,1F
  22+ A06C
  23+ A06C CB C1            set 0,c
  24+ A06E
  25+ A06E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A06F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A071 5F               ld e,a
  28+ A072
  29+ A072 7A               ld a,d
  30+ A073 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A075 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A077
  33+ A077 CB 3F            srl a
  34+ A079
  35+ A079 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A07A
  37+ A07A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A07B 28 04            jr z,4F
  39+ A07D
  40+ A07D CB FF            set 7,a
  41+ A07F 18 02            jr 5F
  42+ A081
  43+ A081 CB BF        4 res 7,a
  44+ A083
  45+ A083 CB 21        5 sla c
  46+ A085 10 E0            djnz 6B
  47+ A087
  48+ A087 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A088
  50+ A088 77               ld (hl),a
  51+ A089 23               inc hl
  52+ A08A C1               pop bc
  53+ A08B 10 D4            djnz 3B
  54+ A08D
  55+ A08D C9               ret
  56+ A08E
  57+ A08E
  58+ A08E
# file closed: RND_Derivando.asm
