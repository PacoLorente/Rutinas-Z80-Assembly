 149  8E30
 150  8E30 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 151  8E31              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 152  8E31              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 153  8E31              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 154  8E31
 155  8E31 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 156  8E32              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 157  8E32 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 158  8E33 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 159  8E34
 160  8E34 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 161  8E35              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 162  8E35              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 163  8E35
 164  8E35              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 165  8E35              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 166  8E35
 167  8E35              ; Ejemplos:
 168  8E35
 169  8E35              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 170  8E35              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 171  8E35              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 172  8E35              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 173  8E35              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 174  8E35
 175  8E35 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 176  8E36              ;															  _ que esta entidad haya colisionado con Amadeus.
 177  8E36              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 178  8E36
 179  8E36 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 180  8E38              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 181  8E38
 182  8E38 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 183  8E3A
 184  8E3A              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 185  8E3A
 186  8E3A 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 187  8E3C              ;															  _palabras que componen el "movimiento_masticado".
 188  8E3C
 189  8E3C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 190  8E3C
 191  8E3C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 192  8E3D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 193  8E3D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 194  8E3D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 195  8E3D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 196  8E3D
 197  8E3D 00           Attr db 0 													; Atributos de la entidad.
