 244  8BF9 00           Columns db 0 	  										; Nº de columnas. [DRAW]
 245  8BFA 00 00        Posicion_actual defw 0									; Dirección actual del Sprite. [DRAW]
 246  8BFC 00 00        Puntero_objeto defw 0									; Donde están los datos para pintar el Sprite.
