   1+ A140              ; ******************************************************************************************************************************************************************************************
   2+ A140              ;
   3+ A140              ;   3/4/25
   4+ A140              ;
   5+ A140              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A140              ;   (XOR) bit a bit.
   7+ A140              ;
   8+ A140              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A140              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A140
  11+ A140              Derivando_RND
  12+ A140
  13+ A140 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A142 C5               push bc
  15+ A143              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A143 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A146              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A146
  19+ A146 A7           6 and a                                 ; Carry a "0".
  20+ A147 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A149 30 02            jr nc,1F
  22+ A14B
  23+ A14B CB C1            set 0,c
  24+ A14D
  25+ A14D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A14E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A150 5F               ld e,a
  28+ A151
  29+ A151 7A               ld a,d
  30+ A152 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A154 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A156
  33+ A156 CB 3F            srl a
  34+ A158
  35+ A158 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A159
  37+ A159 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A15A 28 04            jr z,4F
  39+ A15C
  40+ A15C CB FF            set 7,a
  41+ A15E 18 02            jr 5F
  42+ A160
  43+ A160 CB BF        4 res 7,a
  44+ A162
  45+ A162 CB 21        5 sla c
  46+ A164 10 E0            djnz 6B
  47+ A166
  48+ A166 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A167
  50+ A167 77               ld (hl),a
  51+ A168 23               inc hl
  52+ A169 C1               pop bc
  53+ A16A 10 D4            djnz 3B
  54+ A16C
  55+ A16C C9               ret
  56+ A16D
  57+ A16D
  58+ A16D
