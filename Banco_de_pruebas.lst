 619+ A6F5
 620+ A6F5 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ A6F6 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ A6F8 67               ld h,a
 623+ A6F9 C9               ret
