# file opened: Patrones_de_mov.asm
   1+ A5E8
   2+ A5E8
   3+ A5E8              ;   07/07/23
   4+ A5E8              ;
   5+ A5E8              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ A5E8              ;
   7+ A5E8              ;   Codificación:
   8+ A5E8              ;
   9+ A5E8              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ A5E8              ;
  11+ A5E8              ;   Un desplazamiento tiene la siguiente estructura:
  12+ A5E8              ;
  13+ A5E8              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ A5E8              ;
  15+ A5E8              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ A5E8              ;
  17+ A5E8              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ A5E8              ;                               ..... %01000010 Vel_up 4
  19+ A5E8              ;                                               Vel_down 2
  20+ A5E8              ;                               ..... $42
  21+ A5E8              ;
  22+ A5E8              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ A5E8              ;
  24+ A5E8              ;                               ..... %01000010 Vel_left 4
  25+ A5E8              ;                                               Vel_right 2
  26+ A5E8              ;                               ..... $42
  27+ A5E8              ;
  28+ A5E8              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ A5E8              ;
  30+ A5E8              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ A5E8              ;
  32+ A5E8              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ A5E8              ;
  34+ A5E8              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ A5E8              ;                                     $53
  36+ A5E8              ;
  37+ A5E8              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ A5E8              ;
  39+ A5E8              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ A5E8              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ A5E8              ;
  42+ A5E8              ;                       Arriba ..... $81
  43+ A5E8              ;                       Arriba - izquierda ..... $a1
  44+ A5E8              ;                       Arriba - derecha ..... $91
  45+ A5E8              ;
  46+ A5E8              ;                       Abajo ..... $41
  47+ A5E8              ;                       Abajo - izquierda ..... $61
  48+ A5E8              ;                       Abajo - derecha ..... $51
  49+ A5E8              ;
  50+ A5E8              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ A5E8              ;
  52+ A5E8              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ A5E8              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ A5E8              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ A5E8              ;
  56+ A5E8              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ A5E8              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ A5E8              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ A5E8              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ A5E8              ;
  61+ A5E8              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ A5E8              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ A5E8              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ A5E8              ;
  65+ A5E8              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ A5E8              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ A5E8              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ A5E8              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ A5E8
