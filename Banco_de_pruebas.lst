 611+ B5AC              ;
 612+ B5AC              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 613+ B5AC              ;
 614+ B5AC
 615+ B5AC              NextScan:
 616+ B5AC
 617+ B5AC 24           	inc h          							; Incrementamos el scanline.
 618+ B5AD 7C               ld a,h
 619+ B5AE E6 07            and 7
 620+ B5B0 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 621+ B5B1
 622+ B5B1 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 623+ B5B2 C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ B5B4 6F               ld l,a
 625+ B5B5 D8               ret c               							; Salimos si se produce el cambio de tercio.
 626+ B5B6
 627+ B5B6 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 628+ B5B7 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 629+ B5B9 67               ld h,a
 630+ B5BA C9               ret
