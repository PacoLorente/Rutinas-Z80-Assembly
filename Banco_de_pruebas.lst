   1+ 94B3              ; ******************************************************************************************************************************************************************************************
   2+ 94B3              ;
   3+ 94B3              ;   3/4/25
   4+ 94B3              ;
   5+ 94B3              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 94B3              ;   (XOR) bit a bit.
   7+ 94B3              ;
   8+ 94B3              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 94B3              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 94B3
  11+ 94B3              Derivando_RND
  12+ 94B3
  13+ 94B3 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94B5 C5               push bc
  15+ 94B6              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94B6 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94B9              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94B9
  19+ 94B9 A7           6 and a                                 ; Carry a "0".
  20+ 94BA CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94BC 30 02            jr nc,1F
  22+ 94BE
  23+ 94BE CB C1            set 0,c
  24+ 94C0
  25+ 94C0 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94C1 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94C3 5F               ld e,a
  28+ 94C4
