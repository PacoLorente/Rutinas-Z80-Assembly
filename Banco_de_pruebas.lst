 235+ 9E07
 236+ 9E07 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 237+ 9E08 C6 20            add a,$20           							; Vamos a comprobarlo...
 238+ 9E0A 6F               ld l,a
 239+ 9E0B D8               ret c               							; Salimos si se produce el cambio de tercio.
 240+ 9E0C
 241+ 9E0C 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 242+ 9E0D D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 243+ 9E0F 67               ld h,a
 244+ 9E10 C9               ret
