 619+ B3CE
 620+ B3CE 7C           	ld a,h
 621+ B3CF 25               dec h               							; Dec H.
 622+ B3D0 E6 07            and 7
 623+ B3D2 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 624+ B3D3
 625+ B3D3 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 626+ B3D4 D6 20            sub $20             							; Vamos a comprobarlo...
 627+ B3D6 6F               ld l,a
 628+ B3D7 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 629+ B3D8
 630+ B3D8 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 631+ B3D9 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 632+ B3DB 67               ld h,a
 633+ B3DC C9               ret
