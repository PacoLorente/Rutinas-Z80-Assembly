1704  99DB              ;
1705  99DB              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
1706  99DB              ;
1707  99DB              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
1708  99DB              ;
1709  99DB              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
1710  99DB              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
1711  99DB              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
1712  99DB              ;
1713  99DB              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
1714  99DB              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
1715  99DB              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
1716  99DB              ;				  _medida que transcurre el tiempo.
1717  99DB              ;
1718  99DB              ;	OUTPUT: Define (Clock_next_entity).
1719  99DB
1720  99DB              Define_Clock_next_entity:
1721  99DB
1722  99DB 21 A0 95     	ld hl,Max_time_to_appear_entities
1723  99DE BE           	cp (hl)
1724  99DF 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1725  99E0
1726  99E0 38 01        	jr c,1F
1727  99E2
1728  99E2              ;	Por encima o igual que (Max_time_to_appear_entities).
1729  99E2              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1730  99E2
1731  99E2 4E           	ld c,(hl)
1732  99E3
1733  99E3              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1734  99E3              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1735  99E3
1736  99E3 23           1 inc hl
1737  99E4 23           	inc hl
1738  99E5
1739  99E5 BE           	cp (hl)
1740  99E6
1741  99E6 30 01        	jr nc,2F
1742  99E8
1743  99E8              ;	Por DEBAJO de (Min_time_to_appear_entities).
1744  99E8
1745  99E8 4E           	ld c,(hl)
1746  99E9
1747  99E9 3A 78 5C     2 ld a,(FRAMES)
1748  99EC 81           	add c
