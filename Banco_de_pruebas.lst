 306  9392              ;
 307  9392              ; 29/4/25
 308  9392              ;
 309  9392              ; Parámetros DRAW.
 310  9392              ;
 311  9392
 312  9392              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 313  9392
 314  9392 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 315  9393              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 316  9393              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 317  9393              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 318  9393
 319  9393 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 320  9394              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 321  9394 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 322  9395 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 323  9396
 324  9396 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 325  9397              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 326  9397              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 327  9397
 328  9397              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 329  9397              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 330  9397
 331  9397              ; Ejemplos:
 332  9397
 333  9397              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 334  9397              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 335  9397              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 336  9397              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 337  9397              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 338  9397
 339  9397 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 340  9398              ;															  _ que esta entidad haya colisionado con Amadeus.
 341  9398              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 342  9398
 343  9398 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 344  939A              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 345  939A
 346  939A 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 347  939C
 348  939C              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 349  939C
 350  939C 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 351  939E              ;															  _palabras que componen el "movimiento_masticado".
 352  939E
 353  939E              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 354  939E
 355  939E 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 356  939F              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 357  939F              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 358  939F              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 359  939F              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
