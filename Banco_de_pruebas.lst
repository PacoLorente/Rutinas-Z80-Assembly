2843  A1AC              	include "Cls.asm"
# file opened: Cls.asm
   1+ A1AC              ; *********************************** Limpia la pantalla, CLEAR SCREEN ****************************************************************
   2+ A1AC              ;
   3+ A1AC              ;
   4+ A1AC              ;	CLS.
   5+ A1AC              ;
   6+ A1AC              ;	Limpia la pantalla y define sus atributos.
   7+ A1AC              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A1AC              ;
   9+ A1AC              ;	COLORES: 0 ..... NEGRO
  10+ A1AC              ;    		 1 ..... AZUL
  11+ A1AC              ; 			 2 ..... ROJO
  12+ A1AC              ;			 3 ..... MAGENTA
  13+ A1AC              ; 			 4 ..... VERDE
  14+ A1AC              ; 			 5 ..... CIAN
  15+ A1AC              ;			 6 ..... AMARILLO
  16+ A1AC              ; 			 7 ..... BLANCO
  17+ A1AC              ;
  18+ A1AC              ;	INPUT: A contiene los atributos de pantalla.
  19+ A1AC              ;
  20+ A1AC              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A1AC
  22+ A1AC
  23+ A1AC 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A1AF 11 01 40     	LD DE,$4001
  25+ A1B2 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A1B5 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A1B7 ED B0        	LDIR
  28+ A1B9 01 FF 02     	LD BC,767
  29+ A1BC 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A1BD ED B0        	LDIR
  31+ A1BF
  32+ A1BF AF           	xor a
  33+ A1C0
  34+ A1C0 C9           	ret
  35+ A1C1
# file closed: Cls.asm
