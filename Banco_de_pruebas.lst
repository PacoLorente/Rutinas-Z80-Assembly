 575  94BD 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 576  94BF 00 00        Puntero_indice_mov_bucle defw 0
 577  94C1              ;
 578  94C1              ;
 579  94C1 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 580  94C2              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
