 299  8CBD 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8CBE              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 301  8CBE              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 302  8CBE
 303  8CBE 00           Incrementa_puntero_backup db 0
 304  8CBF 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 305  8CC0              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8CC0
 307  8CC0 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8CC1 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CC2 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CC3
 311  8CC3              ;
 312  8CC3              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CC3              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CC3              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CC3              ;
 316  8CC3              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CC3              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CC3              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CC3              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CC3              ;
 321  8CC3              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CC3              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CC3              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8CC3
 325  8CC3 00           Ctrl_1 db 0 												; Byte de control de propósito general.
