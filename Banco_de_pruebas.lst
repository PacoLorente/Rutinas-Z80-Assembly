 664+ B5E8
 665+ B5E8 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 666+ B5E9 D6 20            sub $20             							; Vamos a comprobarlo...
 667+ B5EB 6F               ld l,a
