   5+ 9D17              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D17              ;   (XOR) bit a bit.
   7+ 9D17              ;
   8+ 9D17              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D17              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D17
  11+ 9D17              Derivando_RND
  12+ 9D17
  13+ 9D17 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D19 C5               push bc
  15+ 9D1A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D1A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D1D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D1D
  19+ 9D1D A7           6 and a                                 ; Carry a "0".
  20+ 9D1E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D20 30 02            jr nc,1F
  22+ 9D22
  23+ 9D22 CB C1            set 0,c
  24+ 9D24
  25+ 9D24 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D25 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D27 5F               ld e,a
  28+ 9D28
  29+ 9D28 7A               ld a,d
  30+ 9D29 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D2B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D2D
  33+ 9D2D CB 3F            srl a
  34+ 9D2F
  35+ 9D2F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D30
  37+ 9D30 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D31 28 04            jr z,4F
  39+ 9D33
  40+ 9D33 CB FF            set 7,a
  41+ 9D35 18 02            jr 5F
  42+ 9D37
  43+ 9D37 CB BF        4 res 7,a
  44+ 9D39
  45+ 9D39 CB 21        5 sla c
  46+ 9D3B 10 E0            djnz 6B
  47+ 9D3D
  48+ 9D3D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D3E
  50+ 9D3E 77               ld (hl),a
  51+ 9D3F 23               inc hl
  52+ 9D40 C1               pop bc
  53+ 9D41 10 D4            djnz 3B
  54+ 9D43
  55+ 9D43 C9               ret
