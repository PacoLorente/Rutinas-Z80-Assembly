 151  8EE2 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 152  8EE3              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 153  8EE3              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 154  8EE3              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 155  8EE3
 156  8EE3 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 157  8EE4              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 158  8EE4 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 159  8EE5 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 160  8EE6
 161  8EE6 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 162  8EE7              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 163  8EE7              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 164  8EE7
 165  8EE7              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 166  8EE7              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 167  8EE7
 168  8EE7              ; Ejemplos:
 169  8EE7
 170  8EE7              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 171  8EE7              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 172  8EE7              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 173  8EE7              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 174  8EE7              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 175  8EE7
 176  8EE7 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 177  8EE8              ;															  _ que esta entidad haya colisionado con Amadeus.
 178  8EE8              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 179  8EE8
