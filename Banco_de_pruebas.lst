 292  8C36 00 00        Contador_general_de_mov_masticados_Entidad_1 defw 0
 293  8C38 00 00        Contador_general_de_mov_masticados_Entidad_2 defw 0
 294  8C3A 00 00        Contador_general_de_mov_masticados_Entidad_3 defw 0
