3153  A0D7              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A0D7              ; ******************************************************************************************************************************************************************************************
   2+ A0D7              ;
   3+ A0D7              ;   3/4/25
   4+ A0D7              ;
   5+ A0D7              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0D7              ;   (XOR) bit a bit.
   7+ A0D7              ;
   8+ A0D7              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0D7              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0D7
  11+ A0D7              Derivando_RND
  12+ A0D7
  13+ A0D7 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0D9 C5               push bc
  15+ A0DA              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0DA 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0DD              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0DD
  19+ A0DD A7           6 and a                                 ; Carry a "0".
  20+ A0DE CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0E0 30 02            jr nc,1F
  22+ A0E2
  23+ A0E2 CB C1            set 0,c
  24+ A0E4
  25+ A0E4 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0E5 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0E7 5F               ld e,a
  28+ A0E8
  29+ A0E8 7A               ld a,d
  30+ A0E9 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0EB 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0ED
  33+ A0ED CB 3F            srl a
  34+ A0EF
  35+ A0EF AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0F0
  37+ A0F0 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0F1 28 04            jr z,4F
  39+ A0F3
  40+ A0F3 CB FF            set 7,a
  41+ A0F5 18 02            jr 5F
  42+ A0F7
  43+ A0F7 CB BF        4 res 7,a
  44+ A0F9
  45+ A0F9 CB 21        5 sla c
  46+ A0FB 10 E0            djnz 6B
  47+ A0FD
  48+ A0FD 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0FE
  50+ A0FE 77               ld (hl),a
  51+ A0FF 23               inc hl
  52+ A100 C1               pop bc
  53+ A101 10 D4            djnz 3B
  54+ A103
  55+ A103 C9               ret
  56+ A104
  57+ A104
  58+ A104
# file closed: RND_Derivando.asm
