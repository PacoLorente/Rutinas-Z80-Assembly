 383+ C11C 3A 5B 94         ld a,(Ctrl_6)
 384+ C11F CB 47            bit 0,a
 385+ C121 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C122
