 298  8C70
 299  8C70 00 00        Puntero_tabla_Random defw 0
 300  8C72 00 00        Puntero_indice_mov defw 0							    ; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 301  8C74 00 00        Puntero_mov defw 0										; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 302  8C76 00 00        Puntero_indice_mov_bucle defw 0							;
 303  8C78              ;
 304  8C78              ;
 305  8C78 00           Incrementa_puntero db 0									; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 306  8C79              ;														; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 307  8C79              ;														; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 308  8C79 00           Incrementa_puntero_backup db 0
 309  8C7A 00           Repetimos_desplazamiento db 0							; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 310  8C7B              ;														; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 311  8C7B 00           Repetimos_desplazamiento_backup db 0					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 312  8C7C 00           Repetimos_movimiento db 0								; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 313  8C7D 00           Cola_de_desplazamiento db 0								; Este byte indica:
 314  8C7E              ;
 315  8C7E              ;														;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8C7E              ;														;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8C7E              ;														;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8C7E              ;
 319  8C7E              ;														;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8C7E              ;														;						Nº de veces que vamos a repetir el movimiento completo.
 321  8C7E              ;														;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8C7E              ;														;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
