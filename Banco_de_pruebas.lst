   1+ 9D25              ; ******************************************************************************************************************************************************************************************
   2+ 9D25              ;
   3+ 9D25              ;   3/4/25
   4+ 9D25              ;
   5+ 9D25              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D25              ;   (XOR) bit a bit.
   7+ 9D25              ;
   8+ 9D25              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D25              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D25
  11+ 9D25              Derivando_RND
  12+ 9D25
  13+ 9D25 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D27 C5               push bc
  15+ 9D28              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D28 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D2B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D2B
  19+ 9D2B A7           6 and a                                 ; Carry a "0".
  20+ 9D2C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D2E 30 02            jr nc,1F
  22+ 9D30
  23+ 9D30 CB C1            set 0,c
  24+ 9D32
  25+ 9D32 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D33 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D35 5F               ld e,a
