 330  8F32              ;																DESCRIPCIÓN:
 331  8F32              ;
 332  8F32              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 333  8F32              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 334  8F32              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 335  8F32              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 336  8F32              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 337  8F32              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 338  8F32
 339  8F32              ;															BIT 3, Recarga de nueva oleada.
 340  8F32              ;															BIT 4, Recarga de nueva oleada.
 341  8F32              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 342  8F32              ;															BIT 6, **** Frame completo.
 343  8F32              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 344  8F32
 345  8F32 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 346  8F34              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 347  8F34              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 348  8F34              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
