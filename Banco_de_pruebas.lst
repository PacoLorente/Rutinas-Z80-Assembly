 562  94B1              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 563  94B1
 564  94B1 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 565  94B2 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 566  94B3 00           Cola_de_desplazamiento db 0									; Este byte indica:
 567  94B4
 568  94B4              ;
 569  94B4              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 570  94B4              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 571  94B4              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 572  94B4              ;
 573  94B4              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 574  94B4              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 575  94B4              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 576  94B4              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 577  94B4              ;
 578  94B4              ;															;	"$ff" ..... Bucle infinito de repetición.
 579  94B4              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 580  94B4              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 581  94B4
 582  94B4 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 583  94B5
 584  94B5              ;																DESCRIPCIÓN:
 585  94B5              ;
 586  94B5              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 587  94B5              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 588  94B5              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 589  94B5              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 590  94B5              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 591  94B5              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 592  94B5
 593  94B5              ;															BIT 3, Recarga de nueva oleada.
 594  94B5              ;															BIT 4, Recarga de nueva oleada.
 595  94B5              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 596  94B5              ;															BIT 6, **** Frame completo.
 597  94B5              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 598  94B5
 599  94B5 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 600  94B7              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 601  94B7              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 602  94B7              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
