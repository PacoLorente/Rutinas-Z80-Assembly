 574+ AEC4              ;
 575+ AEC4              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ AEC4              ;
 577+ AEC4
 578+ AEC4 24           NextScan inc h          							; Incrementamos el scanline.
 579+ AEC5 7C               ld a,h
