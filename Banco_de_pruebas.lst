3267  A12B              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A12B              ; ******************************************************************************************************************************************************************************************
   2+ A12B              ;
   3+ A12B              ;   3/4/25
   4+ A12B              ;
   5+ A12B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A12B              ;   (XOR) bit a bit.
   7+ A12B              ;
   8+ A12B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A12B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A12B
  11+ A12B              Derivando_RND
  12+ A12B
  13+ A12B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A12D C5               push bc
  15+ A12E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A12E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A131              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A131
  19+ A131 A7           6 and a                                 ; Carry a "0".
  20+ A132 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A134 30 02            jr nc,1F
  22+ A136
  23+ A136 CB C1            set 0,c
  24+ A138
  25+ A138 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A139 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A13B 5F               ld e,a
  28+ A13C
  29+ A13C 7A               ld a,d
  30+ A13D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A13F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A141
  33+ A141 CB 3F            srl a
  34+ A143
  35+ A143 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A144
  37+ A144 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A145 28 04            jr z,4F
  39+ A147
  40+ A147 CB FF            set 7,a
  41+ A149 18 02            jr 5F
  42+ A14B
  43+ A14B CB BF        4 res 7,a
  44+ A14D
  45+ A14D CB 21        5 sla c
  46+ A14F 10 E0            djnz 6B
  47+ A151
  48+ A151 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A152
  50+ A152 77               ld (hl),a
  51+ A153 23               inc hl
  52+ A154 C1               pop bc
  53+ A155 10 D4            djnz 3B
  54+ A157
  55+ A157 C9               ret
  56+ A158
  57+ A158
  58+ A158
