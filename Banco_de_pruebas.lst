 582+ A61C
 583+ A61C 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A61D C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A61F 6F               ld l,a
