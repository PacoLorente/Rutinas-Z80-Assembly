 595+ 9F22              ;
 596+ 9F22              ;   17/9/26
 597+ 9F22              ;
 598+ 9F22              ;   Herramienta para construir melodías y ruido con el SPEAKER.
 599+ 9F22
 600+ 9F22              Sound_Generator:
 601+ 9F22
 602+ 9F22              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 603+ 9F22              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 604+ 9F22              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 605+ 9F22              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 606+ 9F22              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 607+ 9F22              ;
 608+ 9F22
 609+ 9F22              ;   MODIFY: A,HL,BC y DE.
 610+ 9F22
 611+ 9F22              ;   Exclusión:
 612+ 9F22
 613+ 9F22 2A B6 94         ld hl,(Sound)
 614+ 9F25 7C               ld a,h
 615+ 9F26 B5               or l
 616+ 9F27 C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 617+ 9F28
 618+ 9F28 04               inc b
 619+ 9F29 05               dec b
 620+ 9F2A 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
 621+ 9F2C
 622+ 9F2C              Loop_2:
 623+ 9F2C
 624+ 9F2C              ;   %xxxabccc
 625+ 9F2C
 626+ 9F2C              ;   %a ... Salida SPEAKER.
 627+ 9F2C              ;   %b ... MIC/EAR.
 628+ 9F2C              ;   %c ... BORDER Colour.
 629+ 9F2C
 630+ 9F2C
 631+ 9F2C 3E 10            ld a,%00010000          ; Borde negro.
 632+ 9F2E D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 633+ 9F30
 634+ 9F30              Delay_5:
 635+ 9F30
 636+ 9F30 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 637+ 9F31
 638+ 9F31 7C               ld a,h
 639+ 9F32 B5               or l
 640+ 9F33 20 FB            jr nz,Delay_5
 641+ 9F35
 642+ 9F35 2A B6 94         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 643+ 9F38
 644+ 9F38 AF               xor a                   ; Borde negro.    ---     4 tstates
 645+ 9F39 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 646+ 9F3B
 647+ 9F3B              Delay_6:
 648+ 9F3B
 649+ 9F3B 2B               dec hl
 650+ 9F3C
 651+ 9F3C 7C               ld a,h
 652+ 9F3D B5               or l
 653+ 9F3E 20 FB            jr nz,Delay_6
 654+ 9F40
 655+ 9F40              ; Hemos generado una onda sonora.
 656+ 9F40              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 657+ 9F40
 658+ 9F40 2A B6 94         ld hl,(Sound)
 659+ 9F43
 660+ 9F43 1C               inc e
 661+ 9F44 1D               dec e
 662+ 9F45 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 663+ 9F47              ;                           ; (E)="0" indica que no hay variación en el tono.
 664+ 9F47
 665+ 9F47 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 666+ 9F48 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 667+ 9F49
 668+ 9F49              ; Rayo de entrada o de salida ???
 669+ 9F49
 670+ 9F49 A7               and a
 671+ 9F4A 20 05            jr nz,Incrementa_delay
 672+ 9F4C
 673+ 9F4C              Decrementa_delay:
 674+ 9F4C
 675+ 9F4C 2B               dec hl
 676+ 9F4D 10 FD            djnz Decrementa_delay
 677+ 9F4F
 678+ 9F4F 18 03            jr 1F
 679+ 9F51
 680+ 9F51              Incrementa_delay:
 681+ 9F51
 682+ 9F51 23               inc hl
 683+ 9F52 10 FD            djnz Incrementa_delay
 684+ 9F54
 685+ 9F54              ; Descontamos la onda generada del total de ondas que tiene el efecto, (Sound).
 686+ 9F54
 687+ 9F54 0D           1 dec c                     ; Decrementa nº de ondas.
 688+ 9F55
 689+ 9F55 22 B6 94         ld (Sound),hl
 690+ 9F58
 691+ 9F58 20 D2            jr nz,Loop_2
 692+ 9F5A
 693+ 9F5A C9               ret
 694+ 9F5B
 695+ 9F5B              ;   Efecto de ruido, se puede utilizar, (entre otras cosas) para generar explosiones, disparos, etc.
 696+ 9F5B              ;   Este tipo de onda NO ES SIMÉTRICA, el semiciclo positivo y el negativo tienen una duración distinta.
 697+ 9F5B              ;   Cada onda completa que compone el sonido es distinta a la anterior siendo el registro (C) el que contiene el_
 698+ 9F5B              ;   _nº de ondas que vamos a ejecutar.
 699+ 9F5B              ;   El registro R proporciona el nº pseudo aleatorio que construye los dos semiciclos de la onda.
 700+ 9F5B
 701+ 9F5B              Noise_efect:
 702+ 9F5B
 703+ 9F5B              Loop:
 704+ 9F5B
 705+ 9F5B ED 5F            ld a,r
 706+ 9F5D 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 707+ 9F5E
 708+ 9F5E 3E 10            ld a,%00010000          ; Borde negro.
 709+ 9F60 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 710+ 9F62
 711+ 9F62 10 FE        Delay_1 djnz Delay_1        ; Aplica Delay.
 712+ 9F64
 713+ 9F64 AF               xor a
 714+ 9F65 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 715+ 9F67
 716+ 9F67 ED 5F            ld a,r
 717+ 9F69 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 718+ 9F6A
 719+ 9F6A 10 FE        Delay_2 djnz Delay_2        ; Aplica Delay.
 720+ 9F6C
 721+ 9F6C 25               dec h
 722+ 9F6D
 723+ 9F6D 0D               dec c                   ; Decrementa ondas completas generadas.
 724+ 9F6E
 725+ 9F6E 20 EB            jr nz,Loop
 726+ 9F70
 727+ 9F70 22 B6 94         ld (Sound),hl
 728+ 9F73
 729+ 9F73 C9               ret
