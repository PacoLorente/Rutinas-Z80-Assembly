 588+ C3C8              ;
 589+ C3C8              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3C8              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3C8              ;
 592+ C3C8              ;   Special keys:
 593+ C3C8              ;
 594+ C3C8              ;   Symbol_key defm "SYMB.",0
 595+ C3C8              ;   Space_key defm "SPACE",0
 596+ C3C8              ;   Enter_key defm "ENTER",0
 597+ C3C8              ;   Caps_key defm "CAPS.",0
 598+ C3C8              ;
 599+ C3C8              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 600+ C3C8              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 601+ C3C8              ;
