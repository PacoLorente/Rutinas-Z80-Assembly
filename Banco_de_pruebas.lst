1817  9967 BE           	cp (hl)
1818  9968
1819  9968 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1820  9969
1821  9969 38 03        	jr c,1F
1822  996B
1823  996B              ;	Por encima o igual que (Max_time_to_appear_entities).
1824  996B
1825  996B 4E           	ld c,(hl)
1826  996C 18 06        	jr 2F
1827  996E
1828  996E              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1829  996E              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1830  996E
1831  996E 23           1 inc hl
