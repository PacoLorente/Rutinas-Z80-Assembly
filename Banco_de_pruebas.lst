 653  942C 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 654  942E 00 00        Puntero_indice_mov_bucle defw 0
 655  9430              ;
 656  9430              ;
 657  9430 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 658  9431              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
