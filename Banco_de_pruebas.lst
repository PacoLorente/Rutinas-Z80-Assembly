 582+ A1A2
 583+ A1A2 7D           	ld a,l              ; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A1A3 C6 20            add a,$20           ; Vamos a comprobarlo...
 585+ A1A5 6F               ld l,a
 586+ A1A6 D8               ret c               ; Salimos si se produce el cambio de tercio.
 587+ A1A7
 588+ A1A7 7C               ld a,h              ; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A1A8 D6 08            sub 8               ; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A1AA 67               ld h,a
 591+ A1AB C9               ret
