  66+ C665              ;	El siguiente .defw indica:
  67+ C665              ;
  68+ C665              ;	Byte alto: Límite superior que puede tener como máximo nuestro nº rnd.
  69+ C665              ;	Byte bajo: Límite inferior que puede tener como mínimo nuestro nº rnd.
  70+ C665              ;
  71+ C665              ;	Los sucesivos .defw indican la dirección o direcciones de memoria correspondientes donde se almacenará el nº aleatorio.
  72+ C665              ;
