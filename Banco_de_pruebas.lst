  27+ 97D1 ED B0        	LDIR
  28+ 97D3 01 FF 02     	LD BC,767
  29+ 97D6 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 97D7 ED B0        	LDIR
  31+ 97D9 C9           	ret
