 607+ 9F26              ;   Suiguiente char.
 608+ 9F26
 609+ 9F26 23               inc hl                                  ;   Siguiente caracter a imprimir.
 610+ 9F27
 611+ 9F27 34               inc (hl)
 612+ 9F28 35               dec (hl)
