  13+ 9D4B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D4D C5               push bc
  15+ 9D4E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D4E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D51              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D51
  19+ 9D51 A7           6 and a                                 ; Carry a "0".
  20+ 9D52 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D54 30 02            jr nc,1F
  22+ 9D56
  23+ 9D56 CB C1            set 0,c
  24+ 9D58
  25+ 9D58 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D59 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D5B 5F               ld e,a
  28+ 9D5C
  29+ 9D5C 7A               ld a,d
  30+ 9D5D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D5F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D61
  33+ 9D61 CB 3F            srl a
  34+ 9D63
  35+ 9D63 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D64
  37+ 9D64 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D65 28 04            jr z,4F
  39+ 9D67
  40+ 9D67 CB FF            set 7,a
  41+ 9D69 18 02            jr 5F
  42+ 9D6B
  43+ 9D6B CB BF        4 res 7,a
