 300  8CBD              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 301  8CBD              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 302  8CBD
 303  8CBD 00           Incrementa_puntero_backup db 0
 304  8CBE 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 305  8CBF              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8CBF
 307  8CBF 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8CC0 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CC1 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CC2
 311  8CC2              ;
 312  8CC2              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CC2              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CC2              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CC2              ;
 316  8CC2              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CC2              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CC2              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CC2              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CC2              ;
 321  8CC2              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CC2              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CC2              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8CC2
 325  8CC2 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 326  8CC3
 327  8CC3              ;																DESCRIPCIÓN:
 328  8CC3              ;
 329  8CC3              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 330  8CC3              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 331  8CC3              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 332  8CC3              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 333  8CC3              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 334  8CC3              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 335  8CC3
 336  8CC3              ;																BIT 3, Recarga de nueva oleada.
 337  8CC3              ;																BIT 4, Recarga de nueva oleada.
 338  8CC3              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 339  8CC3              ;																BIT 6, **** Frame completo.
 340  8CC3              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 341  8CC3
 342  8CC3 00 00        Repone_puntero_objeto defw 0				; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 343  8CC5              ; 																; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 344  8CC5              ; 																; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 345  8CC5              ;																; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 346  8CC5
