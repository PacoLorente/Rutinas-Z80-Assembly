 383+ ACB2              ;
 384+ ACB2              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 385+ ACB2              ;
 386+ ACB2              ;	INPUTS:		B contiene (Numero_de_entidades).
 387+ ACB2              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 388+ ACB2              ; 				HL contiene (Puntero_de_entidades).
 389+ ACB2
 390+ ACB2              Prepara_Cajas_Master:
 391+ ACB2
 392+ ACB2 E5           	push hl															; Push (Puntero_de_entidades).
 393+ ACB3 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 394+ ACB4
 395+ ACB4              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 396+ ACB4
 397+ ACB4 79           	ld a,c
 398+ ACB5 08           	ex af,af
 399+ ACB6 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 400+ ACB7
 401+ ACB7 CD D8 AE     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 402+ ACBA              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 403+ ACBA              ; 																	; Saltaremos a la siguiente entidad del nivel.
 404+ ACBA A7           	and a
 405+ ACBB 20 41        	jr nz, Avanza_siguiente_entidad_del_nivel
 406+ ACBD
 407+ ACBD              ; Generamos movimientos masticados.
 408+ ACBD
 409+ ACBD              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 410+ ACBD
 411+ ACBD 79           	ld a,c 															; (A) = (Clase).
 412+ ACBE
 413+ ACBE CD A1 AF     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 414+ ACC1 CD 31 B0     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 415+ ACC4
 416+ ACC4              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 417+ ACC4              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 418+ ACC4              ;	coreografías distintas.
 419+ ACC4
 420+ ACC4 06 07        	ld b,7
 421+ ACC6 21 07 A2     	ld hl,Numeros_aleatorios_baile
 422+ ACC9 CD EA AA     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 423+ ACCC
 424+ ACCC              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 425+ ACCC
 426+ ACCC 3A 13 A5     	ld a,(Tipo)
 427+ ACCF CD 05 AF     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 428+ ACD2 CD 57 AE     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 429+ ACD5
 430+ ACD5              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 431+ ACD5
 432+ ACD5 C1           	pop bc
 433+ ACD6 E1           	pop hl
 434+ ACD7
 435+ ACD7 E5           	push hl															; Push (Puntero_de_entidades).
 436+ ACD8 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 437+ ACD9
 438+ ACD9              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 439+ ACD9
 440+ ACD9 CD 16 AD     	call Determina_posicion_de_inicio 								; $941e ($78),($76),($72)
 441+ ACDC
 442+ ACDC 3A 13 A5     	ld a,(Tipo)
 443+ ACDF CD 15 AF     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
 444+ ACE2
 445+ ACE2              ;	Ya disponemos de una (Posicion_inicio) aleatoria y la definición de la entidad en la "Bandeja DRAW".
 446+ ACE2              ;	Generamos "Movimientos masticados" de la entidad.
 447+ ACE2
 448+ ACE2 CD DB AD     	call Construye_movimientos_masticados_entidad
