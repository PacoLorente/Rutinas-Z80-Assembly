 538  94D2
 539  94D2              ;
 540  94D2              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 541  94D2              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 542  94D2              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 543  94D2              ;
 544  94D2              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 545  94D2              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 546  94D2              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 547  94D2              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 548  94D2              ;
 549  94D2              ;															;	"$ff" ..... Bucle infinito de repetición.
 550  94D2              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 551  94D2              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
