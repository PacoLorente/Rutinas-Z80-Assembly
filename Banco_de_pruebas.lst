3121  A1BA              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A1BA              ; ******************************************************************************************************************************************************************************************
   2+ A1BA              ;
   3+ A1BA              ;   3/4/25
   4+ A1BA              ;
   5+ A1BA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A1BA              ;   (XOR) bit a bit.
   7+ A1BA              ;
   8+ A1BA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A1BA              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A1BA
  11+ A1BA              Derivando_RND
  12+ A1BA
  13+ A1BA ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A1BC C5               push bc
  15+ A1BD              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A1BD 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A1C0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A1C0
  19+ A1C0 A7           6 and a                                 ; Carry a "0".
  20+ A1C1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A1C3 30 02            jr nc,1F
  22+ A1C5
  23+ A1C5 CB C1            set 0,c
  24+ A1C7
  25+ A1C7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A1C8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A1CA 5F               ld e,a
  28+ A1CB
  29+ A1CB 7A               ld a,d
  30+ A1CC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A1CE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A1D0
  33+ A1D0 CB 3F            srl a
  34+ A1D2
  35+ A1D2 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A1D3
  37+ A1D3 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A1D4 28 04            jr z,4F
  39+ A1D6
  40+ A1D6 CB FF            set 7,a
  41+ A1D8 18 02            jr 5F
  42+ A1DA
  43+ A1DA CB BF        4 res 7,a
  44+ A1DC
  45+ A1DC CB 21        5 sla c
  46+ A1DE 10 E0            djnz 6B
  47+ A1E0
  48+ A1E0 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A1E1
  50+ A1E1 77               ld (hl),a
  51+ A1E2 23               inc hl
  52+ A1E3 C1               pop bc
  53+ A1E4 10 D4            djnz 3B
  54+ A1E6
  55+ A1E6 C9               ret
  56+ A1E7
  57+ A1E7
  58+ A1E7
# file closed: RND_Derivando.asm
