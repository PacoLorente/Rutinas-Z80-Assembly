 590+ B351
 591+ B351 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B352 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B354 6F               ld l,a
 594+ B355 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B356
 596+ B356 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B357 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B359 67               ld h,a
 599+ B35A C9               ret
