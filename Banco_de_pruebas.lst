 589+ C3B6              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3B6              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3B6              ;
 592+ C3B6              ;   Special keys:
 593+ C3B6              ;
 594+ C3B6              ;   Symbol_key defm "SYMB.",0
 595+ C3B6              ;   Space_key defm "SPACE",0
 596+ C3B6              ;   Enter_key defm "ENTER",0
 597+ C3B6              ;   Caps_key defm "CAPS.",0
