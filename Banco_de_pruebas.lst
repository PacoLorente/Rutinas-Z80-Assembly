1123+ CFAE              ;
1124+ CFAE              ;   10/8/26
1125+ CFAE              ;
1126+ CFAE              ;   INPUTS: HL apunta al mensage a imprimir, (msg).
1127+ CFAE              ;           DE indica la fila de pantalla donde queremos imprimir el msg.
1128+ CFAE              ;            A contiene los attrs. del msg. % FBPPPIII
1129+ CFAE              ;            B Actúa como temporizador, ralentiza la impresión de caracteres. No actúa cuando es "0".
1130+ CFAE
1131+ CFAE              Print_text_msg:
1132+ CFAE
1133+ CFAE C5               push bc                                 ;   PUSH temporizador.
1134+ CFAF
1135+ CFAF 08               ex af,af                                ;   Attr. en A´.
1136+ CFB0
1137+ CFB0 E5               push hl                                 ;   PUSH (HL) actúa como puntero del msg.
1138+ CFB1 D5               push de                                 ;   PUSH (DE) dirección de pantalla donde se imprime el msg.
1139+ CFB2
1140+ CFB2 CD E6 CF         call Find_address                       ;   Entrega en HL la dirección ROM donde se encuentran los datas que forman el char. del msg.
1141+ CFB5
1142+ CFB5 EB               ex de,hl                                ;   BIN en DE - Fila en HL.
1143+ CFB6
1144+ CFB6 CD F3 CF         call Print_BIN                          ;   Imprime caracter con atributos.
1145+ CFB9
1146+ CFB9 D1               pop de                                  ;   POP (DE) dirección de pantalla donde se imprime el msg.
1147+ CFBA E1               pop hl                                  ;   POP (HL) actúa como puntero del msg.
1148+ CFBB
1149+ CFBB              ;   Suiguiente char.
1150+ CFBB
1151+ CFBB 23               inc hl
1152+ CFBC
1153+ CFBC 34               inc (hl)
1154+ CFBD 35               dec (hl)
1155+ CFBE
1156+ CFBE 28 24            jr z,Exit_01                            ;   RET, fin de msg.
1157+ CFC0
1158+ CFC0 1C               inc e                                   ;   Siguiente columna de pantalla.
1159+ CFC1
1160+ CFC1              ;   TEMPORIZADOR.
1161+ CFC1
1162+ CFC1 C1               pop bc                                  ;   POP temporización en B.
1163+ CFC2
1164+ CFC2 04               inc b
1165+ CFC3 05               dec b
1166+ CFC4
1167+ CFC4 28 E8            jr z,Print_text_msg                     ;   Mensaje NO TEMPORIZADO. Imprime char.
1168+ CFC6
1169+ CFC6 08               ex af,af                                ;   attrs. del msg en AF´.
1170+ CFC7
1171+ CFC7              ;   Imprime cierta aleatoriedad a la temporización del mensaje.
1172+ CFC7              ;   (Se pretende que la impresión de los caracteres en pantalla no sea uniforme, sea similar a la impresión de una máquina de escribir).
1173+ CFC7
1174+ CFC7              ;   Si el bit(0) de la muestra (r) es "0" el bucle de retardo antes de imprimir el char. descontará sobre (BC)=$82ff.
1175+ CFC7              ;   Si el bit(0) de la muestra (r) es "1" "    "    "     "     "    "     "    "   "         "        "  (BC)=$5aff.
1176+ CFC7
1177+ CFC7 ED 5F            ld a,r
1178+ CFC9 CB 3F            srl a
1179+ CFCB
1180+ CFCB CB 47            bit 0,a
1181+ CFCD 28 04            jr z,3F
1182+ CFCF
1183+ CFCF 06 5A            ld b,90
1184+ CFD1 18 02            jr 1F
1185+ CFD3
1186+ CFD3 06 82        3 ld b,130
1187+ CFD5
1188+ CFD5              ;   Bucle de retardo.
1189+ CFD5
1190+ CFD5 0E FF        1 ld c,$ff
1191+ CFD7 0D           2 dec c
1192+ CFD8 20 FD            jr nz,2B
1193+ CFDA
1194+ CFDA 10 F9            djnz 1B                                 ;   Aplica temporización.
1195+ CFDC
1196+ CFDC CD 28 CA         call BEEP
1197+ CFDF
1198+ CFDF 06 01            ld b,1                                  ;   Activa retardo RND en el próximo char. a imprimir.
1199+ CFE1
1200+ CFE1 08               ex af,af                                ;   Recupera attrs. en A.
1201+ CFE2
1202+ CFE2 18 CA            jr Print_text_msg
1203+ CFE4
1204+ CFE4              Exit_01:
1205+ CFE4
1206+ CFE4 C1               pop bc
1207+ CFE5
1208+ CFE5 C9               ret
1209+ CFE6
1210+ CFE6              ; -----------------------------------------------------
1211+ CFE6
1212+ CFE6              ;   Find char. data.
1213+ CFE6
1214+ CFE6              Find_address:
1215+ CFE6
1216+ CFE6 01 00 3C         ld bc,ROM_ASCII
1217+ CFE9
1218+ CFE9 6E               ld l,(hl)
1219+ CFEA 26 00            ld h,0
1220+ CFEC
1221+ CFEC 29               add hl,hl
1222+ CFED 29               add hl,hl
1223+ CFEE 29               add hl,hl                               ;   ASCII * 8
1224+ CFEF
1225+ CFEF AF               xor a
1226+ CFF0 ED 4A            adc hl,bc
1227+ CFF2
1228+ CFF2 C9               ret
1229+ CFF3
1230+ CFF3              Print_BIN:
1231+ CFF3
1232+ CFF3 06 08            ld b,8                                  ;   Nº de lineas que forman el caracter.
1233+ CFF5
1234+ CFF5 E5               push hl
1235+ CFF6
1236+ CFF6 1A           1 ld a,(de)
1237+ CFF7 77               ld (hl),a                               ;   Print
1238+ CFF8
1239+ CFF8 24               inc h                                   ;   INC scanline.
1240+ CFF9 1C               inc e                                   ;   INC data address
1241+ CFFA
1242+ CFFA 10 FA            djnz 1B
1243+ CFFC
1244+ CFFC E1               pop hl
1245+ CFFD
1246+ CFFD CD 98 B1         call Calcula_direccion_atributos
1247+ D000
1248+ D000 08               ex af,af                                ;   attrs. en A.
1249+ D001 77               ld (hl),a
1250+ D002
1251+ D002 C9               ret
1252+ D003
