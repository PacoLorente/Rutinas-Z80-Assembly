 343  8E64              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 344  8E64
 345  8E64 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 346  8E65 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 347  8E66 00           Cola_de_desplazamiento db 0									; Este byte indica:
 348  8E67
 349  8E67              ;
 350  8E67              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 351  8E67              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 352  8E67              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 353  8E67              ;
 354  8E67              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 355  8E67              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 356  8E67              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 357  8E67              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 358  8E67              ;
 359  8E67              ;															;	"$ff" ..... Bucle infinito de repetición.
 360  8E67              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 361  8E67              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 362  8E67
