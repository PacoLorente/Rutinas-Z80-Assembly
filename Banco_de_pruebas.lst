 602+ BFC5              ;   NextScan.
 603+ BFC5              ;
 604+ BFC5              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 605+ BFC5              ;
 606+ BFC5              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 607+ BFC5              ;
 608+ BFC5              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 609+ BFC5              ;
 610+ BFC5              ;       DESTRUIDOS: AF y HL !!!
 611+ BFC5              ;
 612+ BFC5              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 613+ BFC5              ;
 614+ BFC5
 615+ BFC5              NextScan:
 616+ BFC5
 617+ BFC5 24           	inc h          							; Incrementamos el scanline.
 618+ BFC6 7C               ld a,h
 619+ BFC7 E6 07            and 7
 620+ BFC9 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 621+ BFCA
 622+ BFCA 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 623+ BFCB C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ BFCD 6F               ld l,a
 625+ BFCE D8               ret c               							; Salimos si se produce el cambio de tercio.
 626+ BFCF
 627+ BFCF 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 628+ BFD0 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 629+ BFD2 67               ld h,a
