  12+ A3AB              ;		Estructura de cada línea en la (Tabla_de_pintado):
  13+ A3AB              ;
  14+ A3AB              ;		(Columna_Y), (Attr), (Columnas) y .defw (Album_de_pintado).
  15+ A3AB              ;		.db, .db, .db, .defw
  16+ A3AB              ;
  17+ A3AB              ;	Por último; decrementa el contador (Contador_de_mov_masticados).
  18+ A3AB              ;
  19+ A3AB              ;	INPUTS: IX apunta al 1er .db de la `Caja_de_entidades' correspondiente.
  20+ A3AB              ;
  21+ A3AB              ;	MODIFY: A,BC,DE y HL
