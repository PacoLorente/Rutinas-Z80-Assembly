 654  93EB              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 655  93EB
 656  93EB 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 657  93EC 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 658  93ED 00           Cola_de_desplazamiento db 0									; Este byte indica:
 659  93EE
 660  93EE              ;
 661  93EE              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 662  93EE              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 663  93EE              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 664  93EE              ;
 665  93EE              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 666  93EE              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 667  93EE              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 668  93EE              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 669  93EE              ;
 670  93EE              ;															;	"$ff" ..... Bucle infinito de repetición.
 671  93EE              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 672  93EE              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 673  93EE
