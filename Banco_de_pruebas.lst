 563+ AFCF              ;	5/08/22
 564+ AFCF              ;
 565+ AFCF              ;   NextScan.
 566+ AFCF              ;
 567+ AFCF              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ AFCF              ;
 569+ AFCF              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ AFCF              ;
 571+ AFCF              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ AFCF              ;
 573+ AFCF              ;       DESTRUIDOS: AF y HL !!!
 574+ AFCF              ;
 575+ AFCF              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ AFCF              ;
 577+ AFCF
 578+ AFCF 24           NextScan inc h          							; Incrementamos el scanline.
 579+ AFD0 7C               ld a,h
 580+ AFD1 E6 07            and 7
 581+ AFD3 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ AFD4
 583+ AFD4 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ AFD5 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ AFD7 6F               ld l,a
 586+ AFD8 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ AFD9
 588+ AFD9 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ AFDA D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ AFDC 67               ld h,a
 591+ AFDD C9               ret
 592+ AFDE
 593+ AFDE              ;----------------------------------------------------------------------------------------------------------------
 594+ AFDE              ;
 595+ AFDE              ;	5/08/22
 596+ AFDE              ;
 597+ AFDE              ;   PreviousScan.
 598+ AFDE              ;
 599+ AFDE              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 600+ AFDE              ;
 601+ AFDE              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ AFDE              ;
 603+ AFDE              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ AFDE              ;
 605+ AFDE              ;       DESTRUIDOS: AF y HL !!!
 606+ AFDE              ;
 607+ AFDE              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ AFDE              ;
 609+ AFDE
 610+ AFDE 7C           PreviousScan ld a,h
 611+ AFDF 25               dec h               							; Dec H.
 612+ AFE0 E6 07            and 7
 613+ AFE2 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ AFE3
 615+ AFE3 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ AFE4 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ AFE6 6F               ld l,a
