 328  90D2              ;
 329  90D2 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 330  90D3              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
