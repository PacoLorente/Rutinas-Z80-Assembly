 544+ AEAE 01 02 02         ld bc,$0202                                         ; (BC) contiene (Columnas/Filas).
 545+ AEB1 3E 45            ld a,%01000101                                      ; Attrs.: BRIGHT, BLACK PAPER, CYAN INK.
 546+ AEB3
 547+ AEB3              ;   Parámetros necesarios antes de llamar a [Pinta_imagen]:
 548+ AEB3
 549+ AEB3              ;   INPUTS: HL contiene la dirección de memoria de pantalla donde queremos imprimir la imagen, (esquina superior izquierda).
 550+ AEB3              ;           DE contiene la dirección del 1er .db que conforman los datos de la imagen.
 551+ AEB3              ;            A contiene los Attr.
 552+ AEB3              ;            B contiene el nº de Columnas.
 553+ AEB3              ;            C contiene el nº de Filas.
 554+ AEB3
 555+ AEB3 CD CC 9E         call Pinta_imagen   ; v2. Ok.
 556+ AEB6
 557+ AEB6 E1               pop hl                                              ; POP Cartel_Score_address (actualizado).
 558+ AEB7
