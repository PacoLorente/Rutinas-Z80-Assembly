 238  8CA7 00           Columns db 0 	  									  	; Nº de columnas. [DRAW]
 239  8CA8 00 00        Posicion_actual defw 0							; Dirección actual del Sprite. [DRAW]
 240  8CAA 00 00        Puntero_objeto defw 0								; Donde están los datos para pintar el Sprite.
