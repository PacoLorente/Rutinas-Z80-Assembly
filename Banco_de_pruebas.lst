 256  958A              ;
 257  958A              ; 05/05/26
 258  958A              ;
 259  958A              ; Parámetros DRAW.
 260  958A              ;
 261  958A
 262  958A              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 263  958A
 264  958A 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 265  958B              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 266  958B              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 267  958B              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 268  958B
 269  958B 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 270  958C              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 271  958C
 272  958C 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 273  958D              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 274  958D              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 275  958D
 276  958D              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 277  958D              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 278  958D
 279  958D              ; Ejemplos:
 280  958D
 281  958D              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 282  958D              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 283  958D              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 284  958D              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 285  958D              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 286  958D
 287  958D 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 288  958E              ;															  _ que esta entidad haya colisionado con Amadeus.
 289  958E              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 290  958E
 291  958E 00 00        Puntero_de_impresion defw 0									; Esta variable tiene dos funciones, la primera:
 292  9590              ;
 293  9590              ;															; Es utilizada por la rutina [Define_menu] para almacenar el puntero indicial: Define_menu_index_parameters.
 294  9590              ;
 295  9590              ;															; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 296  9590              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 297  9590
 298  9590 00 40        Puntero_de_almacen_de_mov_masticados defw Line_0
 299  9592
 300  9592
 301  9592
