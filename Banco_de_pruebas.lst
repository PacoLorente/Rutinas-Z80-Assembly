   5+ 99A4              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99A4              ;   (XOR) bit a bit.
   7+ 99A4              ;
   8+ 99A4              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99A4              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99A4
  11+ 99A4              Derivando_RND
  12+ 99A4
  13+ 99A4 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99A6 C5               push bc
  15+ 99A7              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99A7 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99AA              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99AA
  19+ 99AA A7           6 and a                                 ; Carry a "0".
  20+ 99AB CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99AD 30 02            jr nc,1F
  22+ 99AF
  23+ 99AF CB C1            set 0,c
  24+ 99B1
  25+ 99B1 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99B2 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99B4 5F               ld e,a
  28+ 99B5
  29+ 99B5 7A               ld a,d
  30+ 99B6 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99B8 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99BA
  33+ 99BA CB 3F            srl a
  34+ 99BC
  35+ 99BC AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99BD
  37+ 99BD 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99BE 28 04            jr z,4F
  39+ 99C0
  40+ 99C0 CB FF            set 7,a
  41+ 99C2 18 02            jr 5F
  42+ 99C4
  43+ 99C4 CB BF        4 res 7,a
  44+ 99C6
  45+ 99C6 CB 21        5 sla c
  46+ 99C8 10 E0            djnz 6B
  47+ 99CA
  48+ 99CA 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99CB
  50+ 99CB 77               ld (hl),a
  51+ 99CC 23               inc hl
  52+ 99CD C1               pop bc
  53+ 99CE 10 D4            djnz 3B
  54+ 99D0
  55+ 99D0 C9               ret
  56+ 99D1
  57+ 99D1
  58+ 99D1
