   4+ 94A1              ;
   5+ 94A1              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 94A1              ;   (XOR) bit a bit.
   7+ 94A1              ;
   8+ 94A1              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 94A1              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 94A1
  11+ 94A1              Derivando_RND
  12+ 94A1
  13+ 94A1 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94A3 C5               push bc
  15+ 94A4              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94A4 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94A7              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94A7
  19+ 94A7 A7           6 and a                                 ; Carry a "0".
  20+ 94A8 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94AA 30 02            jr nc,1F
  22+ 94AC
  23+ 94AC CB C1            set 0,c
  24+ 94AE
  25+ 94AE 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94AF E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94B1 5F               ld e,a
  28+ 94B2
  29+ 94B2 7A               ld a,d
  30+ 94B3 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94B5 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94B7
  33+ 94B7 CB 3F            srl a
  34+ 94B9
  35+ 94B9 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 94BA
  37+ 94BA 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 94BB 28 04            jr z,4F
  39+ 94BD
  40+ 94BD CB FF            set 7,a
  41+ 94BF 18 02            jr 5F
  42+ 94C1
  43+ 94C1 CB BF        4 res 7,a
  44+ 94C3
  45+ 94C3 CB 21        5 sla c
  46+ 94C5 10 E0            djnz 6B
  47+ 94C7
  48+ 94C7 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94C8
  50+ 94C8 77               ld (hl),a
  51+ 94C9 23               inc hl
  52+ 94CA C1               pop bc
  53+ 94CB 10 D4            djnz 3B
  54+ 94CD
  55+ 94CD C9               ret
  56+ 94CE
  57+ 94CE
  58+ 94CE
