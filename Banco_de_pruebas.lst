 619+ B0BB
 620+ B0BB 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ B0BC C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ B0BE 67               ld h,a
