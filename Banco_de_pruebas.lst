 305  8C9F              ;
 306  8C9F              ;
 307  8C9F 00           Incrementa_puntero db 0									; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 308  8CA0              ;														; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 309  8CA0              ;														; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 310  8CA0 00           Incrementa_puntero_backup db 0
 311  8CA1 00           Repetimos_desplazamiento db 0							; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 312  8CA2              ;														; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 313  8CA2 00           Repetimos_desplazamiento_backup db 0					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 314  8CA3 00           Repetimos_movimiento db 0								; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 315  8CA4 00           Cola_de_desplazamiento db 0								; Este byte indica:
 316  8CA5              ;
 317  8CA5              ;														;	"$00" ..... Hemos finalizado la cadena de movimiento.
 318  8CA5              ;														;				En este caso hemos de incrementar (Puntero_indice_mov)_
 319  8CA5              ;														;				_ y pasar a la siguiente cadena de movimiento del índice.
 320  8CA5              ;
 321  8CA5              ;														;	"$01 - "$fe" ..... Repetición del movimiento.
 322  8CA5              ;														;						Nº de veces que vamos a repetir el movimiento completo.
 323  8CA5              ;														;						En este caso, volveremos a inicializar (Puntero_mov),_
 324  8CA5              ;														;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 325  8CA5              ;
 326  8CA5              ;														;	"$ff" ..... Bucle infinito de repetición.
 327  8CA5              ;														;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 328  8CA5              ;														;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 329  8CA5
