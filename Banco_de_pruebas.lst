3257  A039              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A039              ; ******************************************************************************************************************************************************************************************
   2+ A039              ;
   3+ A039              ;   3/4/25
   4+ A039              ;
   5+ A039              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A039              ;   (XOR) bit a bit.
   7+ A039              ;
   8+ A039              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A039              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A039
  11+ A039              Derivando_RND
  12+ A039
  13+ A039 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A03B C5               push bc
  15+ A03C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A03C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A03F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A03F
  19+ A03F A7           6 and a                                 ; Carry a "0".
  20+ A040 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A042 30 02            jr nc,1F
  22+ A044
  23+ A044 CB C1            set 0,c
  24+ A046
  25+ A046 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A047 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A049 5F               ld e,a
  28+ A04A
  29+ A04A 7A               ld a,d
  30+ A04B E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A04D 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A04F
  33+ A04F CB 3F            srl a
  34+ A051
  35+ A051 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A052
  37+ A052 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A053 28 04            jr z,4F
  39+ A055
  40+ A055 CB FF            set 7,a
  41+ A057 18 02            jr 5F
  42+ A059
  43+ A059 CB BF        4 res 7,a
  44+ A05B
  45+ A05B CB 21        5 sla c
  46+ A05D 10 E0            djnz 6B
  47+ A05F
  48+ A05F 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A060
  50+ A060 77               ld (hl),a
  51+ A061 23               inc hl
  52+ A062 C1               pop bc
  53+ A063 10 D4            djnz 3B
  54+ A065
  55+ A065 C9               ret
  56+ A066
  57+ A066
  58+ A066
# file closed: RND_Derivando.asm
