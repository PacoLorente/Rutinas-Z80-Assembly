 241  8C1D 00           Columns db 0 	  										; Nº de columnas. [DRAW]
 242  8C1E 00 00        Posicion_actual defw 0									; Dirección actual del Sprite. [DRAW]
 243  8C20 00 00        Puntero_objeto defw 0									; Donde están los datos para pintar el Sprite.
