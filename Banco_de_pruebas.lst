 305  8C9E              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8C9E
 307  8C9E 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8C9F 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CA0 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CA1
 311  8CA1              ;
 312  8CA1              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CA1              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CA1              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CA1              ;
 316  8CA1              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CA1              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CA1              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CA1              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CA1              ;
 321  8CA1              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CA1              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CA1              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8CA1
 325  8CA1 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 326  8CA2
 327  8CA2              ;																DESCRIPCIÓN:
 328  8CA2              ;
 329  8CA2              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 330  8CA2              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 331  8CA2              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 332  8CA2              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 333  8CA2              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 334  8CA2              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 335  8CA2
 336  8CA2              ;																BIT 3, Recarga de nueva oleada.
 337  8CA2              ;																BIT 4, Recarga de nueva oleada.
 338  8CA2              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 339  8CA2              ;																BIT 6, **** Frame completo.
 340  8CA2              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 341  8CA2
 342  8CA2 00 00        Repone_puntero_objeto defw 0				; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 343  8CA4              ; 																; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 344  8CA4              ; 																; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 345  8CA4              ;																; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 346  8CA4
