   4+ 93CA              ;
   5+ 93CA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93CA              ;   (XOR) bit a bit.
   7+ 93CA              ;
   8+ 93CA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93CA
  10+ 93CA              Derivando_RND
  11+ 93CA
  12+ 93CA 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93CD
  14+ 93CD ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93CF C5               push bc
  16+ 93D0              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93D0 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 93D3              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 93D3
  20+ 93D3 A7           6 and a                                 ; Carry a "0".
  21+ 93D4 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 93D6 30 02            jr nc,1F
  23+ 93D8
  24+ 93D8 CB C1            set 0,c
  25+ 93DA
  26+ 93DA 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 93DB E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 93DD 5F               ld e,a
  29+ 93DE
  30+ 93DE 7A               ld a,d
  31+ 93DF E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 93E1 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 93E3
  34+ 93E3 CB 3F            srl a
  35+ 93E5
  36+ 93E5 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 93E6
  38+ 93E6 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 93E7 28 04            jr z,4F
  40+ 93E9
  41+ 93E9 CB FF            set 7,a
  42+ 93EB 18 02            jr 5F
  43+ 93ED
  44+ 93ED CB BF        4 res 7,a
  45+ 93EF
  46+ 93EF CB 21        5 sla c
  47+ 93F1 10 E0            djnz 6B
  48+ 93F3
  49+ 93F3 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 93F4
  51+ 93F4 77               ld (hl),a
  52+ 93F5 23               inc hl
  53+ 93F6 C1               pop bc
  54+ 93F7 10 D4            djnz 3B
  55+ 93F9
  56+ 93F9 C9               ret
  57+ 93FA
  58+ 93FA
  59+ 93FA
