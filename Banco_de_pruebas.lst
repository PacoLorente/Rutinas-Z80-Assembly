 350  91C6              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 351  91C6
 352  91C6 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 353  91C7 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 354  91C8 00           Cola_de_desplazamiento db 0									; Este byte indica:
 355  91C9
 356  91C9              ;
 357  91C9              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 358  91C9              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 359  91C9              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 360  91C9              ;
 361  91C9              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 362  91C9              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 363  91C9              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 364  91C9              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 365  91C9              ;
 366  91C9              ;															;	"$ff" ..... Bucle infinito de repetición.
 367  91C9              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 368  91C9              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 369  91C9
