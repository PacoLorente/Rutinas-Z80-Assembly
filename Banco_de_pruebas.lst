# file opened: RND_Derivando.asm
   1+ 9463              ; ******************************************************************************************************************************************************************************************
   2+ 9463              ;
   3+ 9463              ;   21/04/24
   4+ 9463              ;
   5+ 9463              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9463              ;   (XOR) bit a bit.
   7+ 9463              ;
   8+ 9463              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9463
  10+ 9463              Derivando_RND
  11+ 9463
  12+ 9463 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9466
  14+ 9466 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9468 C5               push bc
  16+ 9469              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9469 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 946C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 946C
  20+ 946C A7           6 and a                                 ; Carry a "0".
  21+ 946D CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 946F 30 02            jr nc,1F
  23+ 9471
  24+ 9471 CB C1            set 0,c
  25+ 9473
  26+ 9473 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9474 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9476 5F               ld e,a
