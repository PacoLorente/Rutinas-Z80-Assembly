 372  91B2              ;																DESCRIPCIÓN:
 373  91B2              ;
 374  91B2              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 375  91B2              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 376  91B2              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 377  91B2              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 378  91B2              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 379  91B2              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 380  91B2
 381  91B2              ;															BIT 3, Recarga de nueva oleada.
 382  91B2              ;															BIT 4, Recarga de nueva oleada.
 383  91B2              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 384  91B2              ;															BIT 6, **** Frame completo.
 385  91B2              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 386  91B2
