 611+ AFDA 25               dec h               							; Dec H.
 612+ AFDB E6 07            and 7
 613+ AFDD C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ AFDE
 615+ AFDE 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ AFDF D6 20            sub $20             							; Vamos a comprobarlo...
 617+ AFE1 6F               ld l,a
 618+ AFE2 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ AFE3
 620+ AFE3 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ AFE4 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ AFE6 67               ld h,a
