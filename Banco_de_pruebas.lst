2076  C064              	include "Sound.asm"
# file opened: Sound.asm
   1+ C064              ; ----------------------------------------------------------
   2+ C064              ;
   3+ C064              ;   26/09/26
   4+ C064              ;
   5+ C064              ;   Voy a utilizar los 6 bytes de las variables:
   6+ C064              ;
   7+ C064              ;   (Indice_Sprite_der)
   8+ C064              ;   (Indice_Sprite_izq)
   9+ C064              ;   (Puntero_DESPLZ_der)
  10+ C064              ;
  11+ C064              ;   Para almacenar el perfil de la nota que está en ejecución pues la rutina se ejecuta "IN GAME TIME" y sólo reproducirá 4 ondas_
  12+ C064              ;   _del total que forman la nota.
  13+ C064              ;
  14+ C064              ;   La rutina genera un "ruido" o especie de zumbido ascendente/descendente llamando a la rutina [Sound_Generator].
  15+ C064              ;   La melodía consta de dos notas incluidas en el índice: "Game_over_noise_index:". El puntero (Puntero_game_over_noise) avanza_
  16+ C064              ;   _ por el índice proporcionando los datos de las notas a la rutina.
  17+ C064              ;
  18+ C064              ;   La rutina [Sound_Generator] requiere que los parámetros de la nota a ejecutar se den de la siguiente forma:
  19+ C064              ;
  20+ C064              ;           C contiene el nº de veces que vamos a generar la onda del sonido.
