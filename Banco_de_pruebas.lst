   3+ A1DA              ;
   4+ A1DA              ;	CLS.
   5+ A1DA              ;
   6+ A1DA              ;	Limpia la pantalla y define sus atributos.
   7+ A1DA              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A1DA              ;
   9+ A1DA              ;	COLORES: 0 ..... NEGRO
  10+ A1DA              ;    		 1 ..... AZUL
  11+ A1DA              ; 			 2 ..... ROJO
  12+ A1DA              ;			 3 ..... MAGENTA
  13+ A1DA              ; 			 4 ..... VERDE
  14+ A1DA              ; 			 5 ..... CIAN
  15+ A1DA              ;			 6 ..... AMARILLO
  16+ A1DA              ; 			 7 ..... BLANCO
  17+ A1DA              ;
  18+ A1DA              ;	INPUT: A contiene los atributos de pantalla.
  19+ A1DA              ;
  20+ A1DA              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A1DA
  22+ A1DA
  23+ A1DA 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A1DD 11 01 40     	LD DE,$4001
  25+ A1E0 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A1E3 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A1E5 ED B0        	LDIR
  28+ A1E7 01 FF 02     	LD BC,767
  29+ A1EA 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A1EB ED B0        	LDIR
  31+ A1ED
  32+ A1ED AF           	xor a
  33+ A1EE
  34+ A1EE C9           	ret
  35+ A1EF
