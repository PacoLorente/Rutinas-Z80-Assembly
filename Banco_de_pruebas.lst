   6+ 99A0
   7+ 99A0              Draw
   8+ 99A0
   9+ 99A0 CD 94 9B     	call Prepara_draw
  10+ 99A3 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 99A4 A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 99A5 28 05        	jr z,2F
  13+ 99A7
  14+ 99A7 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99AA 18 0C        	jr 1F
  16+ 99AC
  17+ 99AC              ;	Inicia entidad.
  18+ 99AC
  19+ 99AC 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99AF 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99B2
  22+ 99B2 CD DC 9A     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  23+ 99B5              ;													; _la esquina superior izquierda de la pantalla.
  24+ 99B5 CD 2C A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  25+ 99B8
  26+ 99B8 3A F7 8B     1 ld a,(Ctrl_0)
  27+ 99BB CB 6F        	bit 5,a
  28+ 99BD 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  29+ 99BF
  30+ 99BF CD 0D 9A     	call Comprueba_limite_horizontal
  31+ 99C2 CD 42 9A     	call Comprueba_limite_vertical
  32+ 99C5
  33+ 99C5              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  34+ 99C5              ; -----------------------
  35+ 99C5              ; -----------------------
  36+ 99C5              ; -----------------------
  37+ 99C5
  38+ 99C5 CD 10 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  39+ 99C8 CD 34 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  40+ 99CB
  41+ 99CB 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina restauramos los bits 0,1,2,3 y 5 de (Ctrl_0).
  42+ 99CE E6 D0        	and $d0
  43+ 99D0 32 F7 8B     	ld (Ctrl_0),a
