   1+ 99A1              ; ******************************************************************************************************************************************************************************************
   2+ 99A1              ;
   3+ 99A1              ; 26/06/23
   4+ 99A1              ;
   5+ 99A1              ; DRAW. ************************************************************************************************************************************************************************************
   6+ 99A1
   7+ 99A1              Draw
   8+ 99A1
   9+ 99A1 CD 22 9C     	call Prepara_draw
  10+ 99A4 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 99A5 A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 99A6 28 05        	jr z,2F
  13+ 99A8
  14+ 99A8 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99AB 18 0C        	jr 1F
  16+ 99AD
  17+ 99AD              ;	Inicia entidad.
  18+ 99AD
  19+ 99AD 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99B0 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99B3
  22+ 99B3 CD 3B 9B     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  23+ 99B6              ;													; _la esquina superior izquierda de la pantalla.
  24+ 99B6 CD B8 A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  25+ 99B9
  26+ 99B9 3A F7 8B     1 ld a,(Ctrl_0)
  27+ 99BC CB 6F        	bit 5,a
  28+ 99BE 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  29+ 99C0
  30+ 99C0 CD 0E 9A     	call Comprueba_limite_horizontal
  31+ 99C3 CD 7B 9A     	call Comprueba_limite_vertical
  32+ 99C6
  33+ 99C6              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  34+ 99C6              ; -----------------------
  35+ 99C6              ; -----------------------
  36+ 99C6              ; -----------------------
  37+ 99C6
  38+ 99C6 CD 9C 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  39+ 99C9 CD C0 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  40+ 99CC
  41+ 99CC 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina REStauramos el bit5 de Ctrl_0 para que nos vuelva_
  42+ 99CF CB AF        	res 5,a											; _a ser de utilidad.
  43+ 99D1 32 F7 8B     	ld (Ctrl_0),a
  44+ 99D4
  45+ 99D4 C9           	ret
  46+ 99D5
