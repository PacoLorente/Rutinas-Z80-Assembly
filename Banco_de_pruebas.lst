   1+ A0FD              ; ******************************************************************************************************************************************************************************************
   2+ A0FD              ;
   3+ A0FD              ;   3/4/25
   4+ A0FD              ;
   5+ A0FD              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0FD              ;   (XOR) bit a bit.
   7+ A0FD              ;
   8+ A0FD              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0FD              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0FD
  11+ A0FD              Derivando_RND
  12+ A0FD
  13+ A0FD ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0FF C5               push bc
  15+ A100              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A100 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A103              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A103
  19+ A103 A7           6 and a                                 ; Carry a "0".
  20+ A104 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A106 30 02            jr nc,1F
  22+ A108
  23+ A108 CB C1            set 0,c
  24+ A10A
  25+ A10A 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A10B E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A10D 5F               ld e,a
  28+ A10E
  29+ A10E 7A               ld a,d
  30+ A10F E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A111 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A113
  33+ A113 CB 3F            srl a
  34+ A115
  35+ A115 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A116
  37+ A116 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A117 28 04            jr z,4F
  39+ A119
  40+ A119 CB FF            set 7,a
  41+ A11B 18 02            jr 5F
  42+ A11D
  43+ A11D CB BF        4 res 7,a
  44+ A11F
  45+ A11F CB 21        5 sla c
  46+ A121 10 E0            djnz 6B
  47+ A123
  48+ A123 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A124
  50+ A124 77               ld (hl),a
  51+ A125 23               inc hl
  52+ A126 C1               pop bc
  53+ A127 10 D4            djnz 3B
  54+ A129
  55+ A129 C9               ret
  56+ A12A
  57+ A12A
  58+ A12A
# file closed: RND_Derivando.asm
