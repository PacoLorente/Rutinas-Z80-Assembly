 255  8C56              ;	COLORES: 0 ..... NEGRO
 256  8C56              ;    		 1 ..... AZUL
 257  8C56              ; 			 2 ..... ROJO
 258  8C56              ;			 3 ..... MAGENTA
 259  8C56              ; 			 4 ..... VERDE
 260  8C56              ; 			 5 ..... CIAN
 261  8C56              ;			 6 ..... AMARILLO
 262  8C56              ; 			 7 ..... BLANCO
 263  8C56
 264  8C56 00 00        Indice_Sprite_der defw 0
 265  8C58 00 00        Indice_Sprite_izq defw 0
