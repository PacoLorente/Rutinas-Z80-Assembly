 576+ C3ED              ;
 577+ C3ED              ;   17/10/26
 578+ C3ED              ;
 579+ C3ED              ;   Asigna un nuevo KEYCODE y sustituye al contenido en la variable MOVE_xxx, (al que apunta H)L.
 580+ C3ED              ;   Nueva tecla para la función de movimiento, (KEYBOARD) a la que apunta HL.
 581+ C3ED              ;
 582+ C3ED              ;   Move_LEFT db $24
 583+ C3ED              ;   Move_RIGHT db $1c
 584+ C3ED              ;   Move_FIRE db $04
 585+ C3ED              ;   Move_SHIELD db $20
 586+ C3ED              ;
 587+ C3ED              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 588+ C3ED              ;
 589+ C3ED              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3ED              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3ED              ;
 592+ C3ED              ;   Special keys:
 593+ C3ED              ;
 594+ C3ED              ;   Symbol_key defm "SYMB.",0
 595+ C3ED              ;   Space_key defm "SPACE",0
 596+ C3ED              ;   Enter_key defm "ENTER",0
 597+ C3ED              ;   Caps_key defm "CAPS.",0
 598+ C3ED              ;
 599+ C3ED              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 600+ C3ED              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 601+ C3ED              ;
 602+ C3ED              ;           (Numero_de_teclas_definidas) contiene el n° de teclas YA DEFINIDAS.
 603+ C3ED              ;
 604+ C3ED              ;   MODIFY: AF, HL, BC y DE.
 605+ C3ED              ;
 606+ C3ED              ;   OUTPUT: (A) = "0".
 607+ C3ED
 608+ C3ED              Define_key:
 609+ C3ED
 610+ C3ED E5               push hl                                                 ; PUSH Puntero KEYCODE.
 611+ C3EE D5               push de                                                 ; PUSH Puntero ASCII_CODE.
