3220  A011              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A011              ; ******************************************************************************************************************************************************************************************
   2+ A011              ;
   3+ A011              ;   3/4/25
   4+ A011              ;
   5+ A011              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A011              ;   (XOR) bit a bit.
   7+ A011              ;
   8+ A011              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A011              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A011
  11+ A011              Derivando_RND
  12+ A011
  13+ A011 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A013 C5               push bc
  15+ A014              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A014 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A017              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A017
  19+ A017 A7           6 and a                                 ; Carry a "0".
  20+ A018 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A01A 30 02            jr nc,1F
  22+ A01C
  23+ A01C CB C1            set 0,c
  24+ A01E
  25+ A01E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A01F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A021 5F               ld e,a
  28+ A022
  29+ A022 7A               ld a,d
  30+ A023 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A025 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A027
  33+ A027 CB 3F            srl a
  34+ A029
  35+ A029 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A02A
  37+ A02A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A02B 28 04            jr z,4F
  39+ A02D
  40+ A02D CB FF            set 7,a
  41+ A02F 18 02            jr 5F
  42+ A031
  43+ A031 CB BF        4 res 7,a
  44+ A033
  45+ A033 CB 21        5 sla c
  46+ A035 10 E0            djnz 6B
  47+ A037
  48+ A037 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A038
  50+ A038 77               ld (hl),a
  51+ A039 23               inc hl
  52+ A03A C1               pop bc
  53+ A03B 10 D4            djnz 3B
  54+ A03D
  55+ A03D C9               ret
  56+ A03E
  57+ A03E
  58+ A03E
# file closed: RND_Derivando.asm
