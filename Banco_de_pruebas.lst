   1+ 9476              ; ******************************************************************************************************************************************************************************************
   2+ 9476              ;
   3+ 9476              ;   21/04/24
   4+ 9476              ;
   5+ 9476              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9476              ;   (XOR) bit a bit.
   7+ 9476              ;
   8+ 9476              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9476
  10+ 9476              Derivando_RND
  11+ 9476
  12+ 9476 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9479
  14+ 9479 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 947B C5               push bc
  16+ 947C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 947C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 947F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 947F
  20+ 947F A7           6 and a                                 ; Carry a "0".
  21+ 9480 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9482 30 02            jr nc,1F
  23+ 9484
  24+ 9484 CB C1            set 0,c
  25+ 9486
  26+ 9486 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9487 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9489 5F               ld e,a
  29+ 948A
  30+ 948A 7A               ld a,d
  31+ 948B E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 948D 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 948F
