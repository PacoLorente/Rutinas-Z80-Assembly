   2+ 9ABE              ;
   3+ 9ABE              ;   3/4/25
   4+ 9ABE              ;
   5+ 9ABE              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9ABE              ;   (XOR) bit a bit.
   7+ 9ABE              ;
   8+ 9ABE              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9ABE              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9ABE
  11+ 9ABE              Derivando_RND
  12+ 9ABE
  13+ 9ABE ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9AC0 C5               push bc
  15+ 9AC1              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9AC1 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9AC4              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9AC4
  19+ 9AC4 A7           6 and a                                 ; Carry a "0".
  20+ 9AC5 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9AC7 30 02            jr nc,1F
  22+ 9AC9
  23+ 9AC9 CB C1            set 0,c
  24+ 9ACB
  25+ 9ACB 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9ACC E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9ACE 5F               ld e,a
  28+ 9ACF
  29+ 9ACF 7A               ld a,d
  30+ 9AD0 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9AD2 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9AD4
  33+ 9AD4 CB 3F            srl a
  34+ 9AD6
  35+ 9AD6 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9AD7
  37+ 9AD7 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9AD8 28 04            jr z,4F
  39+ 9ADA
  40+ 9ADA CB FF            set 7,a
  41+ 9ADC 18 02            jr 5F
  42+ 9ADE
  43+ 9ADE CB BF        4 res 7,a
  44+ 9AE0
  45+ 9AE0 CB 21        5 sla c
  46+ 9AE2 10 E0            djnz 6B
  47+ 9AE4
  48+ 9AE4 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9AE5
  50+ 9AE5 77               ld (hl),a
  51+ 9AE6 23               inc hl
  52+ 9AE7 C1               pop bc
  53+ 9AE8 10 D4            djnz 3B
  54+ 9AEA
  55+ 9AEA C9               ret
  56+ 9AEB
  57+ 9AEB
  58+ 9AEB
