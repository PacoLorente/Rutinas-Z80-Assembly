 148  8C86              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 149  8C86
 150  8C86 00           Tipo db 0												; Clase de la entidad. Cada `tipo´ de Entidad tiene unas características únicas que lo distinguen de otros tipos:
 151  8C87              ;
 152  8C87 00           Coordenada_X db 0 							; Coordenada X del objeto. (En chars.)
 153  8C88 00           Coordenada_y db 0 								; Coordenada Y del objeto. (En chars.)
 154  8C89
 155  8C89 00           Contador_de_vueltas db 0					; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición a la izquierda cada vez que la entidad_
 156  8C8A              ;															; _desaparece por la parte baja de la pantalla. Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 157  8C8A
 158  8C8A              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 159  8C8A              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 160  8C8A              ; Ejemplos.
 161  8C8A
 162  8C8A              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 163  8C8A              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 164  8C8A              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 165  8C8A              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 166  8C8A              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 167  8C8A
 168  8C8A 00           Impacto db 0											; Si después del movimiento de la entidad, (Impacto) se coloca a "1",_
 169  8C8B              ;																; _ existen muchas posibilidades de que esta entidad haya colisionado con Amadeus.
 170  8C8B              ; 																; Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 171  8C8B
 172  8C8B 00 00        Puntero_de_impresion defw 0					; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 173  8C8D              ;																; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 174  8C8D
 175  8C8D 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 176  8C8F
 177  8C8F              ;																; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 178  8C8F
 179  8C8F 00 00        Contador_de_mov_masticados defw 0	; Contador de 16bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 180  8C91              ;																; _palabras que componen el "movimiento_masticado".
 181  8C91
 182  8C91              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 183  8C91
 184  8C91 00           Velocidad db 0 										; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 185  8C92              ;																					 2 - 0 (2ª vuelta - velocidad 0)
 186  8C92              ;																					 4 - 1 (3ª vuelta - velocidad 1)
 187  8C92              ;																					 8 - 2 (4ª vuelta - velocidad 2)
 188  8C92              ;																				 $10 - 4 (5ª vuelta - velocidad 3)
 189  8C92
 190  8C92 00           Attr db 0 													; Atributos de la entidad.
 191  8C93
 192  8C93 00           Ctrl_2 db 0
 193  8C94              ;																BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 194  8C94              ;																_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 195  8C94              ;																_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 196  8C94              ; 																_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 197  8C94              ; 																_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 198  8C94              ;																_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 199  8C94              ;																_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 200  8C94              ;
 201  8C94              ;																BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 202  8C94              ;																BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 203  8C94              ;																_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 204  8C94              ;																BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 205  8C94              ;																_ el último MOVIMIENTO que hayamos ejecutado.
 206  8C94              ;																BIT 4, ???
 207  8C94              ;																BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 208  8C94
 209  8C94 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 210  8C95              ;																; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 211  8C95              ; 																; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer´ por el contrario.
 212  8C95              ; 																; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 213  8C95              ; 																; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición´ por un extremo del cuadrante y la `reaparición´ por el otro.
 214  8C95              ;
 215  8C95              ; 																DESCRIPCIÖN:
 216  8C95              ;
 217  8C95              ; 																SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido´ por el_
 218  8C95              ; 																_lado izquierdo de la pantalla y ha de `reaparecer´ por el derecho. ([Comprueba_limite_vertical]).
 219  8C95              ; 																SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido´ por el_
 220  8C95              ; 																_lado derecho de la pantalla y ha de `reaparecer´ por el izquierdo. ([Comprueba_limite_vertical]).
 221  8C95              ; 																SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido´ por la_
 222  8C95              ; 																_parte superior de la pantalla y ha de `reaparecer´ por el inferior. ([Comprueba_limite_horizontal]).
 223  8C95              ; 																SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido´ por la_
 224  8C95              ; 																_parte inferior de la pantalla y ha de `reaparecer´ por la superior. ([Comprueba_limite_horizontal]).
 225  8C95              ; 																SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 226  8C95              ;												                _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 227  8C95              ;																SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 228  8C95              ;																_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar´ un objeto.
 229  8C95              ; 																SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine´ es AMADEUS.
 230  8C95              ;
 231  8C95              ; 																SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 232  8C95              ; 															   _ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 233  8C95              ; 															   _ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 234  8C95
