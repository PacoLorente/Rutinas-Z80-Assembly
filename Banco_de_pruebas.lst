   5+ 9DAA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9DAA              ;   (XOR) bit a bit.
   7+ 9DAA              ;
   8+ 9DAA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9DAA              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9DAA
  11+ 9DAA              Derivando_RND
  12+ 9DAA
  13+ 9DAA ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9DAC C5               push bc
  15+ 9DAD              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9DAD 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9DB0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9DB0
  19+ 9DB0 A7           6 and a                                 ; Carry a "0".
  20+ 9DB1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9DB3 30 02            jr nc,1F
  22+ 9DB5
  23+ 9DB5 CB C1            set 0,c
  24+ 9DB7
  25+ 9DB7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9DB8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9DBA 5F               ld e,a
  28+ 9DBB
  29+ 9DBB 7A               ld a,d
  30+ 9DBC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9DBE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9DC0
  33+ 9DC0 CB 3F            srl a
  34+ 9DC2
  35+ 9DC2 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9DC3
  37+ 9DC3 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9DC4 28 04            jr z,4F
  39+ 9DC6
  40+ 9DC6 CB FF            set 7,a
  41+ 9DC8 18 02            jr 5F
  42+ 9DCA
  43+ 9DCA CB BF        4 res 7,a
  44+ 9DCC
  45+ 9DCC CB 21        5 sla c
  46+ 9DCE 10 E0            djnz 6B
  47+ 9DD0
  48+ 9DD0 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9DD1
  50+ 9DD1 77               ld (hl),a
  51+ 9DD2 23               inc hl
  52+ 9DD3 C1               pop bc
  53+ 9DD4 10 D4            djnz 3B
  54+ 9DD6
  55+ 9DD6 C9               ret
