 619+ B1C5
 620+ B1C5 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ B1C6 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ B1C8 67               ld h,a
