 583+ A261 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A262 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A264 6F               ld l,a
 586+ A265 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A266
 588+ A266 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A267 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A269 67               ld h,a
