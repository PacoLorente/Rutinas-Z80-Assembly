  57+ B05C              ;	INPUT:  HL contiene (Posicion_actual).
  58+ B05C              ;	OUTPUT: (Cuad_objeto) y A contienen "1", "2", "3" o "4" en función del cuadrante de pantalla en el que se encuentra la entidad.
  59+ B05C              ;
  60+ B05C              ;	MODIFY: A.
  61+ B05C
  62+ B05C
