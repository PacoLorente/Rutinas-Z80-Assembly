 622+ B55D 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 623+ B55E C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ B560 6F               ld l,a
 625+ B561 D8               ret c               							; Salimos si se produce el cambio de tercio.
