   1+ A557              ; *********************************** Limpia la pantalla, CLEAR SCREEN ****************************************************************
   2+ A557              ;
   3+ A557              ;
   4+ A557              ;	CLS.
   5+ A557              ;
   6+ A557              ;	Limpia la pantalla y define sus atributos.
   7+ A557              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A557              ;
   9+ A557              ;	COLORES: 0 ..... NEGRO
  10+ A557              ;    		 1 ..... AZUL
  11+ A557              ; 			 2 ..... ROJO
  12+ A557              ;			 3 ..... MAGENTA
  13+ A557              ; 			 4 ..... VERDE
  14+ A557              ; 			 5 ..... CIAN
  15+ A557              ;			 6 ..... AMARILLO
  16+ A557              ; 			 7 ..... BLANCO
  17+ A557              ;
  18+ A557              ;	INPUT: A contiene los atributos de pantalla.
  19+ A557              ;
  20+ A557              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A557
  22+ A557
  23+ A557 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A55A 11 01 40     	LD DE,$4001
  25+ A55D 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A560 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A562 ED B0        	LDIR
  28+ A564 01 FF 02     	LD BC,767
  29+ A567 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A568 ED B0        	LDIR
  31+ A56A
  32+ A56A AF           	xor a
  33+ A56B
  34+ A56B C9           	ret
  35+ A56C
