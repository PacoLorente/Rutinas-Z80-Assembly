 380+ A3DF
 381+ A3DF E5           	push hl															; Push (Puntero_de_entidades).
 382+ A3E0 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A3E1
 384+ A3E1              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A3E1
 386+ A3E1 79           	ld a,c
 387+ A3E2 08           	ex af,af
 388+ A3E3 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A3E4
 390+ A3E4 CD 0A A6     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 391+ A3E7              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A3E7              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A3E7 A7           	and a
 394+ A3E8 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A3EA
 396+ A3EA              ; Generamos movimientos masticados.
 397+ A3EA
 398+ A3EA              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A3EA
 400+ A3EA 79           	ld a,c 															; (A) = (Clase).
 401+ A3EB 32 67 95     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A3EE
 403+ A3EE CD E3 A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A3F1 CD 75 A7     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A3F4
 406+ A3F4              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 407+ A3F4              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 408+ A3F4              ;	coreografías distintas.
