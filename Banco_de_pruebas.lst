  61+ C057 ED 73 B0 95      ld (Stack),sp
  62+ C05B
  63+ C05B F9               ld sp,hl
  64+ C05C
  65+ C05C C1               pop bc                                            ; (B) siempre "0", (C) indica duración de la nota, (n°de ondas).
  66+ C05D D1               pop de                                            ; (DE) siempre contendrá "0".
  67+ C05E E1               pop hl                                            ; (H) = "0", (L) contiene el valor de la nota.
  68+ C05F
  69+ C05F              ;   Tenemos la nota cargada en os registros.
