 582+ B0A7
 583+ B0A7 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B0A8 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B0AA 6F               ld l,a
