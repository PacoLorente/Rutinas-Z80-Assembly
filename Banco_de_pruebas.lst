 367+ C34D              ;
 368+ C34D              ;   Esta función nos permite cambiar las teclas asignadas a los controles de Amadeus.
 369+ C34D              ;   Por defecto las teclas que controlan nuestra nave son:
 370+ C34D              ;
 371+ C34D              ;   Move_LEFT db $24
 372+ C34D              ;   Move_RIGHT db $1c
 373+ C34D              ;   Move_FIRE db $04
 374+ C34D              ;   Move_SHIELD db $20
