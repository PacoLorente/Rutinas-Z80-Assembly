 459+ C167 08               ex af,af
 460+ C168
 461+ C168 3A 00 96         ld a,(Ctrl_6)
 462+ C16B CB 47            bit 0,a
 463+ C16D C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C16E
 465+ C16E              ;   ----------------------
 466+ C16E
 467+ C16E CB C7            set 0,a
 468+ C170 32 00 96         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
