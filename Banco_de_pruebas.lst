 381+ AC8F              ;
 382+ AC8F              ;   23/6/25
 383+ AC8F              ;
 384+ AC8F              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 385+ AC8F              ;
 386+ AC8F              ;	INPUTS:		B contiene (Numero_de_entidades).
 387+ AC8F              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 388+ AC8F              ; 				HL contiene (Puntero_de_entidades).
 389+ AC8F
 390+ AC8F              Prepara_Cajas_Master:
 391+ AC8F
 392+ AC8F E5           	push hl															; PUSH (Puntero_de_entidades).
 393+ AC90 C5           	push bc															; PUSH (Numero_de_entidades)/(Clase).
 394+ AC91
 395+ AC91              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 396+ AC91
 397+ AC91 79           	ld a,c
 398+ AC92 08           	ex af,af
 399+ AC93 79           	ld a,c 															; (Clase) de la entidad en C, A y A´.
 400+ AC94
 401+ AC94 CD B0 AE     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 402+ AC97              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 403+ AC97              ; 																	; Saltaremos a la siguiente entidad del nivel.
 404+ AC97 A7           	and a
 405+ AC98 20 40        	jr nz, Avanza_siguiente_entidad_del_nivel
 406+ AC9A
 407+ AC9A              ; Generamos movimientos masticados.
 408+ AC9A
 409+ AC9A              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 410+ AC9A
 411+ AC9A 79           	ld a,c 															; (A) = (Clase).
 412+ AC9B
 413+ AC9B CD 7B AF     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 414+ AC9E CD 08 B0     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 415+ ACA1
 416+ ACA1              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 417+ ACA1              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 418+ ACA1              ;	coreografías distintas.
 419+ ACA1
 420+ ACA1 06 07        	ld b,7
 421+ ACA3 21 8C A2     	ld hl,Numeros_aleatorios_baile
 422+ ACA6 CD C9 AA     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 423+ ACA9
 424+ ACA9              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 425+ ACA9
 426+ ACA9 3A F4 A4     	ld a,(Tipo)
 427+ ACAC CD DD AE     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 428+ ACAF CD 2F AE     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 429+ ACB2
 430+ ACB2              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 431+ ACB2
 432+ ACB2 C1           	pop bc 															; POP (Numero_de_entidades)/(Clase).
 433+ ACB3 E1           	pop hl 															; POP (Puntero_de_entidades).
 434+ ACB4
 435+ ACB4 E5           	push hl															; PUSH (Puntero_de_entidades).
 436+ ACB5 C5           	push bc															; PUSH (Numero_de_entidades)/(Clase).
 437+ ACB6
 438+ ACB6              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 439+ ACB6
 440+ ACB6 CD F2 AC     	call Determina_posicion_de_inicio 								; $941e ($78),($76),($72)
 441+ ACB9
 442+ ACB9 3A F4 A4     	ld a,(Tipo)
 443+ ACBC CD ED AE     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
 444+ ACBF
 445+ ACBF              ;	Ya disponemos de una (Posicion_inicio) aleatoria y la definición de la entidad en la "Bandeja DRAW".
 446+ ACBF              ;	Generamos "Movimientos masticados" de la entidad.
 447+ ACBF
 448+ ACBF CD B5 AD     	call Construye_movimientos_masticados_entidad
 449+ ACC2
 450+ ACC2              Movimientos_masticados_construidos:
 451+ ACC2
 452+ ACC2 2A 33 A5     	ld hl,(Puntero_indice_master)
 453+ ACC5 CD C0 D4     	call Extrae_address
 454+ ACC8
 455+ ACC8 EB           	ex de,hl
 456+ ACC9
 457+ ACC9 CD 35 B0     	call Parametros_de_bandeja_DRAW_a_Caja_Master	 				; Caja de entidades Master completa.
 458+ ACCC
 459+ ACCC              ;	Limpiamos la bandeja_DRAW y las variables de movimiento para poder generar los mov. masticados_
 460+ ACCC              ;	_de otro (Tipo) de entidad.
 461+ ACCC              ;
 462+ ACCC              ;	Limpiamos bandeja y variables.
 463+ ACCC
 464+ ACCC AF           	xor a
 465+ ACCD 32 64 A5     	ld (Ctrl_3),a 													; (Ctrl_3) ha de inicializarse pués lo utilizamos para indicar_
 466+ ACD0              ;																	; _, (entre otras cosas) cuando finalizamos de generar los mov. masticados.
 467+ ACD0 21 F3 A4     	ld hl,Bandeja_DRAW
 468+ ACD3 01 3A 00     	ld bc,Gestion_de_ENTIDADES_y_CAJAS-Bandeja_DRAW
 469+ ACD6 0B           	dec bc
 470+ ACD7
 471+ ACD7 CD 2E C0     	call Clean_mem
 472+ ACDA
 473+ ACDA              ; 	Avanza a la siguiente entidad del nivel.
 474+ ACDA
 475+ ACDA              Avanza_siguiente_entidad_del_nivel:
 476+ ACDA
 477+ ACDA C1           	pop bc															; Pop (Numero_de_entidades)/(Tipo).
 478+ ACDB E1           	pop hl															; Pop (Puntero_de_entidades).
 479+ ACDC
 480+ ACDC 23           	inc hl															; Puntero_de_entidades +1 en HL.
 481+ ACDD 22 85 A5     	ld (Puntero_de_entidades),hl 									; Actualizamos (Puntero_de_entidades).
 482+ ACE0
 483+ ACE0 4E           	ld c,(hl)														; (Tipo) de la siguiente entidad en C.
 484+ ACE1 10 AC        	djnz Prepara_Cajas_Master 										; dec (Numero_de_entidades).
 485+ ACE3
 486+ ACE3              ; Una vez terminados los movimientos masticados de los distintos TIPOS de entidades,
 487+ ACE3              ; _ inicializamos el puntero (Puntero_de_entidades), situándolo en la 1ª entidad.
 488+ ACE3
 489+ ACE3 2A A0 A5     	ld hl,(Puntero_indice_NIVELES)
 490+ ACE6 CD C0 D4     	call Extrae_address
 491+ ACE9
 492+ ACE9 23           	inc hl
 493+ ACEA 23           	inc hl
 494+ ACEB 23           	inc hl
 495+ ACEC 23           	inc hl
 496+ ACED 23           	inc hl
 497+ ACEE
 498+ ACEE 22 85 A5     	ld (Puntero_de_entidades),hl
 499+ ACF1
 500+ ACF1 C9           	ret
