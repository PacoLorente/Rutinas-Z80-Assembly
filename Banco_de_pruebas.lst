 395+ C329              ;       db 4                                                    ; N° de espacios que separan en pantalla la cadena de texto de la tecla definida.
 396+ C329              ;
 397+ C329              ;   Utilizaremos la variable: (Puntero_de_impresion) para guardar la posición del puntero indicial, (hl).
 398+ C329              ;   Nota: Antes de salir de la función restauraremos su valor a "$0000".
 399+ C329              ;
 400+ C329              ;   MODIFY: AF, HL, HL´, DE, DE´, BC, IX
