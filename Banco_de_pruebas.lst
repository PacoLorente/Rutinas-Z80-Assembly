 393  94A4
 394  94A4 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 395  94A6              ;															  _palabras que componen el "movimiento_masticado".
 396  94A6
 397  94A6              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 398  94A6
 399  94A6 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 400  94A7              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 401  94A7              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 402  94A7              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 403  94A7              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 404  94A7
 405  94A7 00           Attr db 0 													; Atributos de la entidad.
 406  94A8
