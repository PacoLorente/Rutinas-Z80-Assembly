# file opened: Patrones_de_mov.asm
   1+ 93A8
   2+ 93A8
   3+ 93A8              ;   07/07/23
   4+ 93A8              ;
   5+ 93A8              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 93A8              ;
   7+ 93A8              ;   Codificación:
   8+ 93A8              ;
   9+ 93A8              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 93A8              ;
  11+ 93A8              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 93A8              ;
  13+ 93A8              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 93A8              ;
  15+ 93A8              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 93A8              ;
  17+ 93A8              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 93A8              ;                               ..... %01000010 Vel_up 4
  19+ 93A8              ;                                               Vel_down 2
  20+ 93A8              ;                               ..... $42
  21+ 93A8              ;
  22+ 93A8              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 93A8              ;
  24+ 93A8              ;                               ..... %01000010 Vel_left 4
  25+ 93A8              ;                                               Vel_right 2
  26+ 93A8              ;                               ..... $42
  27+ 93A8              ;
  28+ 93A8              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 93A8              ;
  30+ 93A8              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 93A8              ;
  32+ 93A8              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 93A8              ;
  34+ 93A8              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 93A8              ;                                     $53
  36+ 93A8              ;
  37+ 93A8              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 93A8              ;
  39+ 93A8              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 93A8              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 93A8              ;
  42+ 93A8              ;                       Arriba ..... $81
  43+ 93A8              ;                       Arriba - izquierda ..... $a1
  44+ 93A8              ;                       Arriba - derecha ..... $91
  45+ 93A8              ;
  46+ 93A8              ;                       Abajo ..... $41
  47+ 93A8              ;                       Abajo - izquierda ..... $61
  48+ 93A8              ;                       Abajo - derecha ..... $51
  49+ 93A8              ;
  50+ 93A8              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 93A8              ;
  52+ 93A8              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 93A8              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 93A8              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 93A8              ;
  56+ 93A8              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 93A8              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 93A8              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 93A8              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 93A8              ;
  61+ 93A8              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 93A8              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 93A8              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 93A8              ;
  65+ 93A8              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 93A8              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 93A8              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 93A8              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 93A8
