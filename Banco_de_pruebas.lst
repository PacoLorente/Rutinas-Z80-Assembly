   1+ 9F18              ; ******************************************************************************************************************************************************************************************
   2+ 9F18              ;
   3+ 9F18              ;   3/4/25
   4+ 9F18              ;
   5+ 9F18              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9F18              ;   (XOR) bit a bit.
   7+ 9F18              ;
   8+ 9F18              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9F18              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9F18
  11+ 9F18              Derivando_RND
  12+ 9F18
  13+ 9F18 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9F1A C5               push bc
  15+ 9F1B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9F1B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9F1E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9F1E
  19+ 9F1E A7           6 and a                                 ; Carry a "0".
  20+ 9F1F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9F21 30 02            jr nc,1F
  22+ 9F23
  23+ 9F23 CB C1            set 0,c
  24+ 9F25
  25+ 9F25 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9F26 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9F28 5F               ld e,a
  28+ 9F29
  29+ 9F29 7A               ld a,d
  30+ 9F2A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9F2C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9F2E
  33+ 9F2E CB 3F            srl a
  34+ 9F30
  35+ 9F30 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9F31
  37+ 9F31 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9F32 28 04            jr z,4F
  39+ 9F34
  40+ 9F34 CB FF            set 7,a
  41+ 9F36 18 02            jr 5F
  42+ 9F38
  43+ 9F38 CB BF        4 res 7,a
  44+ 9F3A
  45+ 9F3A CB 21        5 sla c
  46+ 9F3C 10 E0            djnz 6B
  47+ 9F3E
  48+ 9F3E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9F3F
  50+ 9F3F 77               ld (hl),a
  51+ 9F40 23               inc hl
  52+ 9F41 C1               pop bc
  53+ 9F42 10 D4            djnz 3B
  54+ 9F44
  55+ 9F44 C9               ret
  56+ 9F45
  57+ 9F45
  58+ 9F45
