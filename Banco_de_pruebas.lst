 296  8F0C 00 00        Puntero_tabla_Random defw 0
 297  8F0E 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 298  8F10 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 299  8F12 00 00        Puntero_indice_mov_bucle defw 0
 300  8F14              ;
 301  8F14              ;
 302  8F14 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 303  8F15              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 304  8F15              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 305  8F15
 306  8F15 00           Incrementa_puntero_backup db 0
 307  8F16 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 308  8F17              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 309  8F17
 310  8F17 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 311  8F18 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 312  8F19 00           Cola_de_desplazamiento db 0									; Este byte indica:
 313  8F1A
 314  8F1A              ;
 315  8F1A              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8F1A              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8F1A              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8F1A              ;
 319  8F1A              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8F1A              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 321  8F1A              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8F1A              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
