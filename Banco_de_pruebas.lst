 283+ C130 11 02 01         ld de,$0102                                             ; (D)="1" / Increase "2"
 284+ C133              ;                                                           ; (HL) up to $00fb
 285+ C133 22 06 96         ld (Sound),hl
 286+ C136 CD 67 9F         call Sound_Generator                                    ; PLAY NOTE.
 287+ C139
 288+ C139
 289+ C139              Note_15:
