 186+ C2C4              Make_Score_max_msg:
 187+ C2C4
 188+ C2C4              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 189+ C2C4
 190+ C2C4              ;   Necesito fabricar un msg. con la máxima puntuación.
 191+ C2C4              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 192+ C2C4
 193+ C2C4 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 194+ C2C7 21 D4 96         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 195+ C2CA              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 196+ C2CA 11 E4 96         ld de,Score_max_msg
 197+ C2CD
 198+ C2CD              KEY_CODE_de_BCD:
 199+ C2CD
 200+ C2CD 7E           1 ld a,(hl)
 201+ C2CE A7               and a
 202+ C2CF 20 07            jr nz,3F
 203+ C2D1
 204+ C2D1              ;   El dígito es "0".
 205+ C2D1
 206+ C2D1 0C               inc c
 207+ C2D2 0D               dec c
 208+ C2D3 20 03            jr nz,3F
 209+ C2D5
 210+ C2D5 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 211+ C2D6 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 212+ C2D8
 213+ C2D8 D5           3 push de                                    ; PUSH Score_max_msg.
 214+ C2D9
 215+ C2D9 11 F5 96         ld de,Non_authorized_KEY_CODES+2         ; KEY_CODE numbers list.
 216+ C2DC
 217+ C2DC A7               and a
 218+ C2DD 28 04            jr z,4F
 219+ C2DF
 220+ C2DF 13           2 inc de
 221+ C2E0 3D               dec a
 222+ C2E1 20 FC            jr nz,2B                                 ; Nos situamos en el KEY_CODE correspondiente a este dígito.
 223+ C2E3
 224+ C2E3 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 225+ C2E4
 226+ C2E4 D1               pop de                                   ; Score_max_msg en DE.
 227+ C2E5
