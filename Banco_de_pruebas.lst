 614+ AE07
 615+ AE07 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ AE08 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ AE0A 6F               ld l,a
