   1+ 9468              ; ******************************************************************************************************************************************************************************************
   2+ 9468              ;
   3+ 9468              ;   21/04/24
   4+ 9468              ;
   5+ 9468              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9468              ;   (XOR) bit a bit.
   7+ 9468              ;
   8+ 9468              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9468
  10+ 9468              Derivando_RND
  11+ 9468
  12+ 9468 21 F6 88         ld hl,Numeros_aleatorios
  13+ 946B
  14+ 946B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 946D C5               push bc
  16+ 946E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 946E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9471              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9471
  20+ 9471 A7           6 and a                                 ; Carry a "0".
  21+ 9472 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9474 30 02            jr nc,1F
  23+ 9476
  24+ 9476 CB C1            set 0,c
  25+ 9478
  26+ 9478 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9479 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 947B 5F               ld e,a
  29+ 947C
  30+ 947C 7A               ld a,d
  31+ 947D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 947F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9481
  34+ 9481 CB 3F            srl a
  35+ 9483
