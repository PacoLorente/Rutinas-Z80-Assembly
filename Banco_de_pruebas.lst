 253+ C109 0E 21        	ld c,$21
 254+ C10B 2E D4        	ld l,$d4
 255+ C10D
 256+ C10D 22 06 96     	ld (Sound),hl
 257+ C110 CD 67 9F         call Sound_Generator
 258+ C113
 259+ C113              Pause_5:
 260+ C113
 261+ C113 01 F0 5F         ld bc,$5ff0
 262+ C116 CD 3A 9B         call DELAY 												; PAUSE.
