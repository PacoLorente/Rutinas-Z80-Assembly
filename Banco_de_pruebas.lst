 288  8CBD 00 00        Puntero_mov defw 0								; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 289  8CBF 00 00        Puntero_indice_mov_bucle defw 0
 290  8CC1              ;
 291  8CC1              ;
 292  8CC1 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 293  8CC2              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 294  8CC2              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
