   1+ A62E
   2+ A62E
   3+ A62E              ;   07/07/23
   4+ A62E              ;
   5+ A62E              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ A62E              ;
   7+ A62E              ;   Codificación:
   8+ A62E              ;
   9+ A62E              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ A62E              ;
  11+ A62E              ;   Un desplazamiento tiene la siguiente estructura:
  12+ A62E              ;
  13+ A62E              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ A62E              ;
  15+ A62E              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ A62E              ;
  17+ A62E              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ A62E              ;                               ..... %01000010 Vel_up 4
  19+ A62E              ;                                               Vel_down 2
  20+ A62E              ;                               ..... $42
  21+ A62E              ;
  22+ A62E              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ A62E              ;
  24+ A62E              ;                               ..... %01000010 Vel_left 4
  25+ A62E              ;                                               Vel_right 2
  26+ A62E              ;                               ..... $42
  27+ A62E              ;
  28+ A62E              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ A62E              ;
  30+ A62E              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ A62E              ;
  32+ A62E              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ A62E              ;
  34+ A62E              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ A62E              ;                                     $53
  36+ A62E              ;
  37+ A62E              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ A62E              ;
  39+ A62E              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ A62E              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ A62E              ;
  42+ A62E              ;                       Arriba ..... $81
  43+ A62E              ;                       Arriba - izquierda ..... $a1
  44+ A62E              ;                       Arriba - derecha ..... $91
  45+ A62E              ;
  46+ A62E              ;                       Abajo ..... $41
  47+ A62E              ;                       Abajo - izquierda ..... $61
  48+ A62E              ;                       Abajo - derecha ..... $51
  49+ A62E              ;
  50+ A62E              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ A62E              ;
  52+ A62E              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ A62E              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ A62E              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ A62E              ;
  56+ A62E              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ A62E              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ A62E              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ A62E              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ A62E              ;
  61+ A62E              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ A62E              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ A62E              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ A62E              ;
  65+ A62E              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ A62E              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ A62E              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ A62E              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ A62E
