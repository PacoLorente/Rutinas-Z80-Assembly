 655+ B5C0
 656+ B5C0 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 657+ B5C1 D6 20            sub $20             							; Vamos a comprobarlo...
 658+ B5C3 6F               ld l,a
 659+ B5C4 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 660+ B5C5
