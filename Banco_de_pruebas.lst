   1+ A08F              ; ******************************************************************************************************************************************************************************************
   2+ A08F              ;
   3+ A08F              ;   3/4/25
   4+ A08F              ;
   5+ A08F              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A08F              ;   (XOR) bit a bit.
   7+ A08F              ;
   8+ A08F              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A08F              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A08F
  11+ A08F              Derivando_RND
  12+ A08F
  13+ A08F ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A091 C5               push bc
  15+ A092              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A092 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A095              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A095
  19+ A095 A7           6 and a                                 ; Carry a "0".
  20+ A096 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A098 30 02            jr nc,1F
  22+ A09A
  23+ A09A CB C1            set 0,c
  24+ A09C
  25+ A09C 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A09D E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A09F 5F               ld e,a
  28+ A0A0
  29+ A0A0 7A               ld a,d
  30+ A0A1 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0A3 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0A5
  33+ A0A5 CB 3F            srl a
  34+ A0A7
  35+ A0A7 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0A8
  37+ A0A8 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0A9 28 04            jr z,4F
  39+ A0AB
  40+ A0AB CB FF            set 7,a
  41+ A0AD 18 02            jr 5F
  42+ A0AF
  43+ A0AF CB BF        4 res 7,a
  44+ A0B1
  45+ A0B1 CB 21        5 sla c
  46+ A0B3 10 E0            djnz 6B
  47+ A0B5
  48+ A0B5 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0B6
  50+ A0B6 77               ld (hl),a
  51+ A0B7 23               inc hl
  52+ A0B8 C1               pop bc
  53+ A0B9 10 D4            djnz 3B
  54+ A0BB
  55+ A0BB C9               ret
  56+ A0BC
  57+ A0BC
  58+ A0BC
