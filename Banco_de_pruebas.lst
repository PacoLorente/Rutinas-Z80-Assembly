 668+ 9F57              ;
 669+ 9F57              ;   17/9/26
 670+ 9F57              ;
 671+ 9F57              ;   Herramienta para construir melodías y ruido con el SPEAKER.
 672+ 9F57
 673+ 9F57              Sound_Generator:
 674+ 9F57
 675+ 9F57              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 676+ 9F57              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 677+ 9F57              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 678+ 9F57              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 679+ 9F57              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 680+ 9F57              ;
 681+ 9F57
 682+ 9F57              ;   MODIFY: A,HL,BC y DE.
 683+ 9F57
 684+ 9F57              ;   Exclusión:
 685+ 9F57
 686+ 9F57 2A 06 96         ld hl,(Sound)
 687+ 9F5A 7C               ld a,h
 688+ 9F5B B5               or l
 689+ 9F5C C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 690+ 9F5D
 691+ 9F5D 04               inc b
 692+ 9F5E 05               dec b
 693+ 9F5F 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
