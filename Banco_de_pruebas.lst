 484+ A4A6 28 09        	jr z,1F
 485+ A4A8
 486+ A4A8              ; 	Entidad tipo Badplate. Si nuestro nº RND es "<= $0f" aparecerá por la izquierda. Si es superior iniciará por la derecha.
 487+ A4A8
 488+ A4A8 FE 0F        	cp $0f
 489+ A4AA 38 04        	jr c,2F
