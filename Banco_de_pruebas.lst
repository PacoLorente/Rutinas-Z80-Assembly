  46+ A09E              ;
  47+ A09E              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
  48+ A09E              ;
  49+ A09E              ;	INPUTS:		B contiene (Numero_de_entidades).
  50+ A09E              ;				C contiene la (Clase) de la 1ª entidad del nivel.
  51+ A09E              ; 				HL contiene (Puntero_de_entidades).
  52+ A09E
  53+ A09E              Prepara_Cajas_Master
  54+ A09E
  55+ A09E E5           	push hl															; Push (Puntero_de_entidades).
  56+ A09F C5           	push bc															; Push (Numero_de_entidades)/(Clase).
  57+ A0A0
  58+ A0A0              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
  59+ A0A0
  60+ A0A0 79           	ld a,c
  61+ A0A1 08           	ex af,af
  62+ A0A2 79           	ld a,c 															; (Clase) de la entidad en A y A´.
  63+ A0A3
  64+ A0A3 CD 17 A2     	call Situa_en_Caja_Master										; A=Z indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
  65+ A0A6              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
  66+ A0A6              ; 																	; Saltaremos a la siguiente entidad del nivel.
