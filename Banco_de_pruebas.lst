   4+ 971A              ;
   5+ 971A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 971A              ;   (XOR) bit a bit.
   7+ 971A              ;
   8+ 971A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 971A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 971A
  11+ 971A              Derivando_RND
  12+ 971A
  13+ 971A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 971C C5               push bc
  15+ 971D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 971D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9720              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9720
  19+ 9720 A7           6 and a                                 ; Carry a "0".
  20+ 9721 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9723 30 02            jr nc,1F
  22+ 9725
  23+ 9725 CB C1            set 0,c
  24+ 9727
  25+ 9727 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9728 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 972A 5F               ld e,a
  28+ 972B
  29+ 972B 7A               ld a,d
  30+ 972C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 972E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9730
  33+ 9730 CB 3F            srl a
  34+ 9732
  35+ 9732 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9733
  37+ 9733 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9734 28 04            jr z,4F
  39+ 9736
  40+ 9736 CB FF            set 7,a
  41+ 9738 18 02            jr 5F
  42+ 973A
  43+ 973A CB BF        4 res 7,a
  44+ 973C
  45+ 973C CB 21        5 sla c
  46+ 973E 10 E0            djnz 6B
  47+ 9740
  48+ 9740 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9741
  50+ 9741 77               ld (hl),a
  51+ 9742 23               inc hl
  52+ 9743 C1               pop bc
  53+ 9744 10 D4            djnz 3B
  54+ 9746
  55+ 9746 C9               ret
  56+ 9747
  57+ 9747
  58+ 9747
