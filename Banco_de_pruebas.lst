3378  A117              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A117              ; ******************************************************************************************************************************************************************************************
   2+ A117              ;
   3+ A117              ;   3/4/25
   4+ A117              ;
   5+ A117              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A117              ;   (XOR) bit a bit.
   7+ A117              ;
   8+ A117              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A117              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A117
  11+ A117              Derivando_RND
  12+ A117
  13+ A117 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A119 C5               push bc
  15+ A11A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A11A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A11D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A11D
  19+ A11D A7           6 and a                                 ; Carry a "0".
  20+ A11E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A120 30 02            jr nc,1F
  22+ A122
  23+ A122 CB C1            set 0,c
  24+ A124
  25+ A124 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A125 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A127 5F               ld e,a
  28+ A128
  29+ A128 7A               ld a,d
  30+ A129 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A12B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A12D
  33+ A12D CB 3F            srl a
  34+ A12F
  35+ A12F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A130
  37+ A130 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A131 28 04            jr z,4F
  39+ A133
  40+ A133 CB FF            set 7,a
  41+ A135 18 02            jr 5F
  42+ A137
  43+ A137 CB BF        4 res 7,a
  44+ A139
  45+ A139 CB 21        5 sla c
  46+ A13B 10 E0            djnz 6B
  47+ A13D
  48+ A13D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A13E
  50+ A13E 77               ld (hl),a
  51+ A13F 23               inc hl
  52+ A140 C1               pop bc
  53+ A141 10 D4            djnz 3B
  54+ A143
  55+ A143 C9               ret
  56+ A144
  57+ A144
  58+ A144
