   5+ 99C5              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99C5              ;   (XOR) bit a bit.
   7+ 99C5              ;
   8+ 99C5              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99C5              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99C5
  11+ 99C5              Derivando_RND
  12+ 99C5
  13+ 99C5 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99C7 C5               push bc
  15+ 99C8              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99C8 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99CB              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99CB
  19+ 99CB A7           6 and a                                 ; Carry a "0".
  20+ 99CC CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99CE 30 02            jr nc,1F
  22+ 99D0
  23+ 99D0 CB C1            set 0,c
  24+ 99D2
  25+ 99D2 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99D3 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99D5 5F               ld e,a
  28+ 99D6
  29+ 99D6 7A               ld a,d
  30+ 99D7 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99D9 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99DB
  33+ 99DB CB 3F            srl a
  34+ 99DD
  35+ 99DD AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99DE
  37+ 99DE 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99DF 28 04            jr z,4F
  39+ 99E1
  40+ 99E1 CB FF            set 7,a
  41+ 99E3 18 02            jr 5F
  42+ 99E5
  43+ 99E5 CB BF        4 res 7,a
  44+ 99E7
  45+ 99E7 CB 21        5 sla c
  46+ 99E9 10 E0            djnz 6B
  47+ 99EB
  48+ 99EB 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99EC
  50+ 99EC 77               ld (hl),a
  51+ 99ED 23               inc hl
  52+ 99EE C1               pop bc
  53+ 99EF 10 D4            djnz 3B
  54+ 99F1
  55+ 99F1 C9               ret
  56+ 99F2
  57+ 99F2
  58+ 99F2
