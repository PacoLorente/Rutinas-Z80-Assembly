 399+ A216
 400+ A216 79           	ld a,c 															; (A) = (Clase).
 401+ A217 32 B9 93     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A21A
 403+ A21A CD 0B A5     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A21D CD 9D A5     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A220
