 378+ A3D1
 379+ A3D1              Prepara_Cajas_Master:
 380+ A3D1
 381+ A3D1 E5           	push hl															; Push (Puntero_de_entidades).
 382+ A3D2 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A3D3
 384+ A3D3              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A3D3
 386+ A3D3 79           	ld a,c
 387+ A3D4 08           	ex af,af
 388+ A3D5 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A3D6
