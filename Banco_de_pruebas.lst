 704+ C43C              ;   No special key_code.
 705+ C43C
 706+ C43C              ;   Seleccionamos el ASCII_code correspondiente y lo almacenamos.
 707+ C43C              ;
 708+ C43C              ;   Recordatorio: Cada caja ASCII consta de 6 bytes, esto es porque el msg. de texto que se almacena al pulsar una SPECIAL KEY consta de 5 caracteres.
 709+ C43C              ;   El 6° byte SIEMPRE contendrá "0" pues indica a [Print_text_msg], "FIN DE CADENA DE TEXTO".
 710+ C43C              ;
 711+ C43C              ;   Guardamos el ASCII_CODE seguido de "0" para indicar "fin de cadena de texto".
 712+ C43C              ;
 713+ C43C
 714+ C43C 4F               ld c,a
