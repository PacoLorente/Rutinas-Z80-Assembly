 240  9392              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 241  9392
 242  9392 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 243  9393              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 244  9393              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 245  9393              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 246  9393
 247  9393 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 248  9394              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 249  9394 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 250  9395 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 251  9396
 252  9396 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 253  9397              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 254  9397              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 255  9397
 256  9397              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 257  9397              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 258  9397
 259  9397              ; Ejemplos:
 260  9397
 261  9397              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 262  9397              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 263  9397              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 264  9397              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 265  9397              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 266  9397
 267  9397 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 268  9398              ;															  _ que esta entidad haya colisionado con Amadeus.
 269  9398              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 270  9398
 271  9398 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 272  939A              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 273  939A
 274  939A 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 275  939C
 276  939C              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 277  939C
 278  939C 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 279  939E              ;															  _palabras que componen el "movimiento_masticado".
 280  939E
 281  939E              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 282  939E
 283  939E 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 284  939F              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 285  939F              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 286  939F              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 287  939F              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 288  939F
 289  939F 00           Attr db 0 													; Atributos de la entidad.
 290  93A0
 291  93A0              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 292  93A0
 293  93A0
 294  93A0
 295  93A0 00           Ctrl_2 db 0
 296  93A1              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 297  93A1              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 298  93A1              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 299  93A1              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 300  93A1              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 301  93A1              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 302  93A1              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 303  93A1              ;
 304  93A1              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 305  93A1              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 306  93A1              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 307  93A1              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 308  93A1              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 309  93A1              ;															BIT 4, ???
 310  93A1              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 311  93A1              ;															BIT 6, "1" Indica que hemos iniciado la "-Transicion_de_salida-" de Amadeus.
 312  93A1              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 313  93A1              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 314  93A1
 315  93A1 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 316  93A2              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 317  93A2              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 318  93A2              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 319  93A2              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 320  93A2              ;
 321  93A2              ; 															DESCRIPCIÖN:
 322  93A2              ;
 323  93A2              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 324  93A2              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 325  93A2              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 326  93A2              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 327  93A2              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 328  93A2              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 329  93A2              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 330  93A2              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 331  93A2              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 332  93A2              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 333  93A2              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 334  93A2              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 335  93A2              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 336  93A2              ;
 337  93A2              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 338  93A2              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 339  93A2              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
