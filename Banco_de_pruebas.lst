2892  A200              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A200              ; ******************************************************************************************************************************************************************************************
   2+ A200              ;
   3+ A200              ;   3/4/25
   4+ A200              ;
   5+ A200              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A200              ;   (XOR) bit a bit.
   7+ A200              ;
   8+ A200              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A200              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A200
  11+ A200              Derivando_RND
  12+ A200
  13+ A200 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A202 C5               push bc
  15+ A203              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A203 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A206              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A206
  19+ A206 A7           6 and a                                 ; Carry a "0".
  20+ A207 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A209 30 02            jr nc,1F
  22+ A20B
  23+ A20B CB C1            set 0,c
  24+ A20D
  25+ A20D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A20E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A210 5F               ld e,a
  28+ A211
  29+ A211 7A               ld a,d
  30+ A212 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A214 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A216
  33+ A216 CB 3F            srl a
  34+ A218
  35+ A218 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A219
  37+ A219 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A21A 28 04            jr z,4F
  39+ A21C
  40+ A21C CB FF            set 7,a
  41+ A21E 18 02            jr 5F
  42+ A220
  43+ A220 CB BF        4 res 7,a
  44+ A222
  45+ A222 CB 21        5 sla c
  46+ A224 10 E0            djnz 6B
  47+ A226
  48+ A226 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A227
  50+ A227 77               ld (hl),a
  51+ A228 23               inc hl
  52+ A229 C1               pop bc
  53+ A22A 10 D4            djnz 3B
  54+ A22C
  55+ A22C C9               ret
  56+ A22D
  57+ A22D
  58+ A22D
# file closed: RND_Derivando.asm
