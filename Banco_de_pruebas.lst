 619+ A6B7
 620+ A6B7 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ A6B8 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ A6BA 67               ld h,a
