 581+ B17B C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ B17C
 583+ B17C 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B17D C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B17F 6F               ld l,a
 586+ B180 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B181
 588+ B181 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B182 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B184 67               ld h,a
 591+ B185 C9               ret
