   1+ 8E9F
   2+ 8E9F
   3+ 8E9F              ;   07/07/23
   4+ 8E9F              ;
   5+ 8E9F              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8E9F              ;
   7+ 8E9F              ;   Codificación:
   8+ 8E9F              ;
   9+ 8E9F              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8E9F              ;
  11+ 8E9F              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8E9F              ;
  13+ 8E9F              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8E9F              ;
  15+ 8E9F              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8E9F              ;
  17+ 8E9F              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8E9F              ;                               ..... %01000010 Vel_up 4
  19+ 8E9F              ;                                               Vel_down 2
  20+ 8E9F              ;                               ..... $42
  21+ 8E9F              ;
  22+ 8E9F              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8E9F              ;
  24+ 8E9F              ;                               ..... %01000010 Vel_left 4
  25+ 8E9F              ;                                               Vel_right 2
  26+ 8E9F              ;                               ..... $42
  27+ 8E9F              ;
  28+ 8E9F              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8E9F              ;
  30+ 8E9F              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8E9F              ;
  32+ 8E9F              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8E9F              ;
  34+ 8E9F              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8E9F              ;                                     $53
  36+ 8E9F              ;
  37+ 8E9F              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8E9F              ;
  39+ 8E9F              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8E9F              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8E9F              ;
  42+ 8E9F              ;                       Arriba ..... $81
  43+ 8E9F              ;                       Arriba - izquierda ..... $a1
  44+ 8E9F              ;                       Arriba - derecha ..... $91
  45+ 8E9F              ;
  46+ 8E9F              ;                       Abajo ..... $41
  47+ 8E9F              ;                       Abajo - izquierda ..... $61
  48+ 8E9F              ;                       Abajo - derecha ..... $51
  49+ 8E9F              ;
  50+ 8E9F              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8E9F              ;
  52+ 8E9F              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8E9F              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8E9F              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8E9F              ;
  56+ 8E9F              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8E9F              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8E9F              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8E9F              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8E9F              ;
  61+ 8E9F              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8E9F              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8E9F              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8E9F              ;
  65+ 8E9F              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8E9F              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8E9F              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8E9F              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8E9F
