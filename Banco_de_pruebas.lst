  13+ 95DB              ; 			 4 ..... VERDE
  14+ 95DB              ; 			 5 ..... CIAN
  15+ 95DB              ;			 6 ..... AMARILLO
  16+ 95DB              ; 			 7 ..... BLANCO
  17+ 95DB              ;
  18+ 95DB              ;	INPUT: A contiene los atributos de pantalla.
  19+ 95DB              ;
  20+ 95DB              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 95DB
  22+ 95DB
