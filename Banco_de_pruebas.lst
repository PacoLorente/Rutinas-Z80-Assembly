 629+ B560
 630+ B560 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 631+ B561 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 632+ B563 67               ld h,a
