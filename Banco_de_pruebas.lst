 253  9352              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 9352
   2+ 9352
   3+ 9352              ;   07/07/23
   4+ 9352              ;
   5+ 9352              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 9352              ;
   7+ 9352              ;   Codificación:
   8+ 9352              ;
   9+ 9352              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 9352              ;
  11+ 9352              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 9352              ;
  13+ 9352              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 9352              ;
  15+ 9352              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 9352              ;
  17+ 9352              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 9352              ;                               ..... %01000010 Vel_up 4
  19+ 9352              ;                                               Vel_down 2
  20+ 9352              ;                               ..... $42
  21+ 9352              ;
  22+ 9352              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 9352              ;
  24+ 9352              ;                               ..... %01000010 Vel_left 4
  25+ 9352              ;                                               Vel_right 2
  26+ 9352              ;                               ..... $42
  27+ 9352              ;
  28+ 9352              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 9352              ;
  30+ 9352              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 9352              ;
  32+ 9352              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 9352              ;
  34+ 9352              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 9352              ;                                     $53
  36+ 9352              ;
  37+ 9352              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 9352              ;
  39+ 9352              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 9352              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 9352              ;
  42+ 9352              ;                       Arriba ..... $81
  43+ 9352              ;                       Arriba - izquierda ..... $a1
  44+ 9352              ;                       Arriba - derecha ..... $91
  45+ 9352              ;
  46+ 9352              ;                       Abajo ..... $41
  47+ 9352              ;                       Abajo - izquierda ..... $61
  48+ 9352              ;                       Abajo - derecha ..... $51
  49+ 9352              ;
  50+ 9352              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 9352              ;
  52+ 9352              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 9352              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 9352              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 9352              ;
  56+ 9352              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 9352              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 9352              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 9352              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 9352              ;
  61+ 9352              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 9352              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 9352              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 9352              ;
  65+ 9352              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 9352              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 9352              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 9352              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 9352
  70+ 9352              ; ----- ----- ----- ----- -----
  71+ 9352              ;
  72+ 9352              ;   Factor RANDOM --- BadSat.
  73+ 9352
  74+ 9352              ; Random_1_1_10 (1-10) Bajo_decelerando
