 621  9504 00           Cola_de_desplazamiento db 0									; Este byte indica:
 622  9505
 623  9505              ;
 624  9505              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 625  9505              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 626  9505              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 627  9505              ;
 628  9505              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 629  9505              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 630  9505              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 631  9505              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 632  9505              ;
 633  9505              ;															;	"$ff" ..... Bucle infinito de repetición.
 634  9505              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 635  9505              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 636  9505
