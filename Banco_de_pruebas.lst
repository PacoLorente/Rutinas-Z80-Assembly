   1+ 9FEA              ; ******************************************************************************************************************************************************************************************
   2+ 9FEA              ;
   3+ 9FEA              ;   3/4/25
   4+ 9FEA              ;
   5+ 9FEA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9FEA              ;   (XOR) bit a bit.
   7+ 9FEA              ;
   8+ 9FEA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9FEA              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9FEA
  11+ 9FEA              Derivando_RND
  12+ 9FEA
  13+ 9FEA ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9FEC C5               push bc
  15+ 9FED              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9FED 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9FF0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9FF0
  19+ 9FF0 A7           6 and a                                 ; Carry a "0".
  20+ 9FF1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9FF3 30 02            jr nc,1F
  22+ 9FF5
  23+ 9FF5 CB C1            set 0,c
  24+ 9FF7
  25+ 9FF7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9FF8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9FFA 5F               ld e,a
  28+ 9FFB
  29+ 9FFB 7A               ld a,d
  30+ 9FFC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9FFE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A000
  33+ A000 CB 3F            srl a
  34+ A002
  35+ A002 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A003
  37+ A003 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A004 28 04            jr z,4F
  39+ A006
  40+ A006 CB FF            set 7,a
  41+ A008 18 02            jr 5F
  42+ A00A
  43+ A00A CB BF        4 res 7,a
  44+ A00C
  45+ A00C CB 21        5 sla c
  46+ A00E 10 E0            djnz 6B
  47+ A010
  48+ A010 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A011
  50+ A011 77               ld (hl),a
  51+ A012 23               inc hl
  52+ A013 C1               pop bc
  53+ A014 10 D4            djnz 3B
  54+ A016
  55+ A016 C9               ret
  56+ A017
  57+ A017
  58+ A017
# file closed: RND_Derivando.asm
