 696+ 9F61
 697+ 9F61              ;   %xxxabccc
 698+ 9F61
 699+ 9F61              ;   %a ... Salida SPEAKER.
 700+ 9F61              ;   %b ... MIC/EAR.
 701+ 9F61              ;   %c ... BORDER Colour.
 702+ 9F61
 703+ 9F61
 704+ 9F61 3E 10            ld a,%00010000          ; Borde negro.
 705+ 9F63 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 706+ 9F65
 707+ 9F65              Delay_5:
 708+ 9F65
 709+ 9F65 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 710+ 9F66
 711+ 9F66 7C               ld a,h
 712+ 9F67 B5               or l
 713+ 9F68 20 FB            jr nz,Delay_5
 714+ 9F6A
 715+ 9F6A 2A 06 96         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 716+ 9F6D
 717+ 9F6D AF               xor a                   ; Borde negro.    ---     4 tstates
 718+ 9F6E D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 719+ 9F70
 720+ 9F70              Delay_6:
 721+ 9F70
 722+ 9F70 2B               dec hl
 723+ 9F71
 724+ 9F71 7C               ld a,h
 725+ 9F72 B5               or l
 726+ 9F73 20 FB            jr nz,Delay_6
 727+ 9F75
 728+ 9F75              ; Hemos generado una onda sonora.
 729+ 9F75              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 730+ 9F75
 731+ 9F75 2A 06 96         ld hl,(Sound)
 732+ 9F78
 733+ 9F78 1C               inc e
 734+ 9F79 1D               dec e
 735+ 9F7A 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 736+ 9F7C              ;                           ; (E)="0" indica que no hay variación en el tono.
