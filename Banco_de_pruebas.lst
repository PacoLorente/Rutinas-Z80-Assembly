  13+ A3D3              ;
  14+ A3D3              ;		(Columna_Y), (Attr), (Columnas) y .defw (Album_de_pintado).
  15+ A3D3              ;		.db, .db, .db, .defw
  16+ A3D3              ;
  17+ A3D3              ;	Por último; decrementa el contador (Contador_de_mov_masticados).
