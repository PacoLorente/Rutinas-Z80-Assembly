 308+ C134              ; ----------------------------------------------------------------------------------------------
 309+ C134              ;
 310+ C134              ;   17/9/26
 311+ C134              ;
 312+ C134              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C134              ;
 314+ C134              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C134
 316+ C134              BEEP:
 317+ C134
 318+ C134 F5               push af
 319+ C135 C5               push bc
 320+ C136 D5               push de
 321+ C137 E5               push hl                                 ; STORE Regs.
 322+ C138
 323+ C138              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C138
 325+ C138              ;   Configuración de un BEEP.
 326+ C138
 327+ C138              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C138              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C138              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C138              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C138              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C138
 333+ C138
 334+ C138 01 02 00         ld bc,$0002
 335+ C13B 11 00 00         ld de,0
 336+ C13E 21 D0 00         ld hl,$00d0
 337+ C141
 338+ C141 22 06 96         ld (Sound),hl
 339+ C144
 340+ C144 CD 5D 9F         call Sound_Generator    ; v2. Ok.
 341+ C147
 342+ C147 21 00 00         ld hl,0
 343+ C14A 22 06 96         ld (Sound),hl
 344+ C14D
 345+ C14D E1               pop hl                                  ; RECOVERY Regs.
 346+ C14E D1               pop de
 347+ C14F C1               pop bc
 348+ C150 F1               pop af
 349+ C151
 350+ C151 C9               ret
 351+ C152
 352+ C152              ; ----- ----- ----- ----- -----
 353+ C152              ;
 354+ C152              ;   23/9/26
 355+ C152              ;
 356+ C152              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C152              ;
 358+ C152              ;   HL define el sonido.
 359+ C152              ;
 360+ C152              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C152              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C152              ;
 363+ C152              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C152              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C152              ;
 366+ C152              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C152              ;
 368+ C152              ;   INPUTS: (Shot_sound) <> "0".
 369+ C152              ;
 370+ C152              ;   MODIFY: AF, HL y BC.
 371+ C152              ;
 372+ C152              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C152
 374+ C152              Play_shot_sound_effect:
 375+ C152
 376+ C152              ;   Exclusiones:
 377+ C152
 378+ C152 2A 0A 96         ld hl,(Shot_sound)
 379+ C155 7C               ld a,h
 380+ C156 B5               or l
 381+ C157 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C158
 383+ C158 3A DD 95         ld a,(Ctrl_6)
 384+ C15B CB 47            bit 0,a
 385+ C15D C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C15E
 387+ C15E 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C160
 389+ C160              Loop_1:
 390+ C160
 391+ C160 3E 10            ld a,%00010000          ; Borde negro.
 392+ C162 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C164
 394+ C164 45               ld b,l
 395+ C165
 396+ C165 10 FE        Delay_3 djnz Delay_3
 397+ C167
 398+ C167 AF               xor a                   ; Borde negro.
 399+ C168 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C16A
 401+ C16A 45               ld b,l
 402+ C16B
 403+ C16B 10 FE        Delay_4 djnz Delay_4
 404+ C16D
 405+ C16D              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C16D
 407+ C16D 2C               inc l
 408+ C16E 2C               inc l
 409+ C16F 2C               inc l
 410+ C170 2C               inc l
 411+ C171
 412+ C171 25               dec h
 413+ C172
 414+ C172 CC 7C C1         call z,Clean_shot_effect
 415+ C175
 416+ C175 0D               dec c
 417+ C176
 418+ C176 20 E8            jr nz,Loop_1
 419+ C178
 420+ C178 22 0A 96         ld (Shot_sound),hl
 421+ C17B
 422+ C17B C9               ret
 423+ C17C
 424+ C17C              Clean_shot_effect:
 425+ C17C
 426+ C17C 21 00 00         ld hl,0
 427+ C17F 0E 01            ld c,1
 428+ C181
 429+ C181 C9               ret
 430+ C182
 431+ C182              ;   -------------------------------------------------------------------------------------------
 432+ C182              ;
 433+ C182              ;   23/9/26
 434+ C182              ;
 435+ C182              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C182              ;
 437+ C182              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C182              ;   _ [Sound_Generator].
 439+ C182              ;
 440+ C182              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C182              ;
 442+ C182              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C182              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C182              ;
 445+ C182              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C182              ;
 447+ C182              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C182              ;
 449+ C182              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C182
 451+ C182              Play_burst_sound_effect:
 452+ C182
 453+ C182              ;   Exclusiones:
 454+ C182
 455+ C182 3A 0C 96         ld a,(Burst_sound)
 456+ C185 A7               and a
 457+ C186 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C187
 459+ C187 08               ex af,af
 460+ C188
 461+ C188 3A DD 95         ld a,(Ctrl_6)
 462+ C18B CB 47            bit 0,a
 463+ C18D C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C18E
 465+ C18E              ;   ----------------------
 466+ C18E
 467+ C18E CB C7            set 0,a
 468+ C190 32 DD 95         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C193
 470+ C193 08               ex af,af                ; Restore (Burst_sound).
 471+ C194
 472+ C194 67               ld h,a
 473+ C195 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C197
 475+ C197 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C198
 477+ C198 22 06 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C19B 0E 03            ld c,3
 479+ C19D CD 96 9F         call Noise_efect
 480+ C1A0
 481+ C1A0 D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1A1
 483+ C1A1 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1A2 94               sub h
 485+ C1A3
 486+ C1A3 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1A5
 488+ C1A5 7C               ld a,h
 489+ C1A6 32 0C 96         ld (Burst_sound),a
 490+ C1A9
 491+ C1A9 C9               ret
 492+ C1AA
 493+ C1AA              Clean_burst_efect:
 494+ C1AA
 495+ C1AA AF               xor a
 496+ C1AB 32 0C 96         ld (Burst_sound),a
 497+ C1AE
 498+ C1AE 3A DD 95         ld a,(Ctrl_6)
 499+ C1B1 CB 87            res 0,a
 500+ C1B3 32 DD 95         ld (Ctrl_6),a
 501+ C1B6
 502+ C1B6 C9               ret
 503+ C1B7
 504+ C1B7              ;   -------------------------------------------------------------------------------------------
 505+ C1B7              ;
 506+ C1B7              ;   23/9/26
 507+ C1B7              ;
 508+ C1B7              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1B7              ;   _ Shield_sound_effect.
 510+ C1B7              ;
 511+ C1B7              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1B7              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1B7              ;
 514+ C1B7              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1B7              ;
 516+ C1B7              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1B7              ;
 518+ C1B7              ;   MODIFY: AF'y BC.
 519+ C1B7
 520+ C1B7              Play_Shield_sound_effect:
 521+ C1B7
 522+ C1B7 3A 0D 96         ld a,(Shield_sound)
 523+ C1BA A7               and a
 524+ C1BB C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1BC
 526+ C1BC 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1BE
 528+ C1BE              Loop_3:
 529+ C1BE
 530+ C1BE 08               ex af,af
 531+ C1BF
 532+ C1BF 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1C1 D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1C3
 535+ C1C3 08               ex af,af
 536+ C1C4
 537+ C1C4 47               ld b,a
 538+ C1C5
 539+ C1C5 10 FE        Delay_7 djnz Delay_7
 540+ C1C7
 541+ C1C7 08               ex af,af
 542+ C1C8
 543+ C1C8 AF               xor a                   ; Black BORDER.
 544+ C1C9 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1CB
 546+ C1CB 08               ex af,af
 547+ C1CC
 548+ C1CC 47               ld b,a
 549+ C1CD
 550+ C1CD 10 FE        Delay_8 djnz Delay_8
 551+ C1CF
 552+ C1CF 0D               dec c
 553+ C1D0
 554+ C1D0 20 EC            jr nz,Loop_3
 555+ C1D2
 556+ C1D2 AF               xor a
 557+ C1D3 32 0D 96         ld (Shield_sound),a
 558+ C1D6
 559+ C1D6 C9               ret
 560+ C1D7
 561+ C1D7              ; ---------------------------------------------------------------
 562+ C1D7              ;
 563+ C1D7              ;   18/9/26
 564+ C1D7              ;
 565+ C1D7              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C1D7              ;
 567+ C1D7              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C1D7              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C1D7              ;
 570+ C1D7              ;   MODIFY: A y H.
 571+ C1D7              ;
 572+ C1D7              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C1D7
 574+ C1D7
 575+ C1D7              Init_Burst_sound:
 576+ C1D7
 577+ C1D7 3A 0C 96         ld a,(Burst_sound)
 578+ C1DA A7               and a
 579+ C1DB C0               ret nz                                           ; RET si ya está iniciado el efecto.
 580+ C1DC
 581+ C1DC              ;   Init Burst_sound_efect.
 582+ C1DC
 583+ C1DC              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C1DC
 585+ C1DC 26 35            ld h,Burst_sound_init_value
 586+ C1DE
 587+ C1DE 3A CF 90         ld a,(Impacto_Amadeus)
 588+ C1E1 A7               and a
 589+ C1E2 28 02            jr z,1F
 590+ C1E4
 591+ C1E4 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C1E6
 593+ C1E6 7C           1 ld a,h
 594+ C1E7
 595+ C1E7 32 0C 96         ld (Burst_sound),a
 596+ C1EA
 597+ C1EA C9               ret
 598+ C1EB
 599+ C1EB
