 822+ B629              ;
 823+ B629              ;	5/08/22
 824+ B629              ;
 825+ B629              ;   PreviousScan.
 826+ B629              ;
 827+ B629              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B629              ;
 829+ B629              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B629              ;
 831+ B629              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B629              ;
 833+ B629              ;       DESTRUIDOS: AF y HL !!!
 834+ B629              ;
 835+ B629              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B629              ;
 837+ B629
 838+ B629              PreviousScan:
 839+ B629
 840+ B629 7C           	ld a,h
 841+ B62A 25               dec h               							; Dec H.
 842+ B62B E6 07            and 7
 843+ B62D C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B62E
 845+ B62E 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B62F D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B631 6F               ld l,a
 848+ B632 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B633
 850+ B633 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B634 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B636 67               ld h,a
 853+ B637 C9               ret
