1055+ C546              ;
1056+ C546              ;   Special keys:
1057+ C546              ;
1058+ C546              ;   Symbol_key defm "SYMB."
1059+ C546              ;   Space_key defm "SPACE"
1060+ C546              ;   Enter_key defm "ENTER"
1061+ C546              ;   Caps_key defm "CAPS."
1062+ C546              ;
1063+ C546              ;   MODIFY: AF, E.
