 292  93ED              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 293  93ED
 294  93ED 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 295  93EF              ;															  _palabras que componen el "movimiento_masticado".
 296  93EF
 297  93EF              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 298  93EF
 299  93EF 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 300  93F0              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 301  93F0              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 302  93F0              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 303  93F0              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 304  93F0
