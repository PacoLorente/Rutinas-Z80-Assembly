   5+ 99A3              ; DRAW. ************************************************************************************************************************************************************************************
   6+ 99A3
   7+ 99A3              Draw
   8+ 99A3
   9+ 99A3 CD 0B 9C     	call Prepara_draw
  10+ 99A6 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 99A7 A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 99A8 28 05        	jr z,2F
  13+ 99AA
  14+ 99AA 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99AD 18 0C        	jr 1F
  16+ 99AF
  17+ 99AF              ;	Inicia entidad.
  18+ 99AF
  19+ 99AF 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99B2 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99B5
  22+ 99B5 CD 24 9B     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  23+ 99B8              ;													; _la esquina superior izquierda de la pantalla.
  24+ 99B8 CD 9F A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  25+ 99BB
  26+ 99BB 3A F7 8B     1 ld a,(Ctrl_0)
  27+ 99BE CB 6F        	bit 5,a
  28+ 99C0 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  29+ 99C2
  30+ 99C2 CD 10 9A     	call Comprueba_limite_horizontal
  31+ 99C5 CD 7D 9A     	call Comprueba_limite_vertical
  32+ 99C8
  33+ 99C8              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  34+ 99C8              ; -----------------------
  35+ 99C8              ; -----------------------
  36+ 99C8              ; -----------------------
  37+ 99C8
  38+ 99C8 CD 85 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  39+ 99CB CD A9 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  40+ 99CE
  41+ 99CE 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina restauramos los bits 0,1,2,3 y 5 de (Ctrl_0).
  42+ 99D1 E6 DC        	and %11011100
  43+ 99D3 32 F7 8B     	ld (Ctrl_0),a
  44+ 99D6
  45+ 99D6 C9           	ret
  46+ 99D7
