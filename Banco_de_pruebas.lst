 121+ C078              ; ----------------------------------------------------------------------------------------------
 122+ C078              ;
 123+ C078              ;   17/9/26
 124+ C078              ;
 125+ C078              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 126+ C078              ;
 127+ C078              ;   NO MODIFICA NINGÚN REGISTRO.
 128+ C078
 129+ C078              BEEP:
 130+ C078
 131+ C078 F5               push af
 132+ C079 C5               push bc
 133+ C07A D5               push de
 134+ C07B E5               push hl                                 ; STORE Regs.
 135+ C07C
 136+ C07C              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 137+ C07C
 138+ C07C              ;   Configuración de un BEEP.
 139+ C07C
 140+ C07C              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 141+ C07C              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 142+ C07C              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 143+ C07C              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 144+ C07C              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 145+ C07C
 146+ C07C
 147+ C07C 01 02 00         ld bc,$0002
 148+ C07F 11 00 00         ld de,0
 149+ C082 21 D0 00         ld hl,$00d0
 150+ C085
 151+ C085 22 56 94         ld (Sound),hl
 152+ C088
 153+ C088 CD B2 9E         call Sound_Generator
 154+ C08B
 155+ C08B 21 00 00         ld hl,0
 156+ C08E 22 56 94         ld (Sound),hl
 157+ C091
 158+ C091 E1               pop hl                                  ; RECOVERY Regs.
 159+ C092 D1               pop de
 160+ C093 C1               pop bc
 161+ C094 F1               pop af
 162+ C095
 163+ C095 C9               ret
 164+ C096
 165+ C096              ; ----- ----- ----- ----- -----
 166+ C096              ;
 167+ C096              ;   23/9/26
 168+ C096              ;
 169+ C096              ;   El efecto del disparo de Amadeus es de tipo descendente.
 170+ C096              ;
 171+ C096              ;   HL define el sonido.
 172+ C096              ;
 173+ C096              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 174+ C096              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 175+ C096              ;
 176+ C096              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 177+ C096              ;   _ escudo tienen prioridad sobre este efecto.
 178+ C096              ;
 179+ C096              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 180+ C096
 181+ C096              Play_shot_sound_effect:
 182+ C096
 183+ C096              ;   Exclusiones:
 184+ C096
 185+ C096 2A 5B 94         ld hl,(Shot_sound)
 186+ C099 7C               ld a,h
 187+ C09A B5               or l
 188+ C09B C8               ret z                   ; RET si no se ha producido disparo.
 189+ C09C
 190+ C09C 3A 2D 94         ld a,(Ctrl_6)
 191+ C09F CB 47            bit 0,a
 192+ C0A1 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 193+ C0A2
 194+ C0A2 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 195+ C0A4
 196+ C0A4              Loop_1
 197+ C0A4
 198+ C0A4 3E 10            ld a,%00010000          ; Borde negro.
 199+ C0A6 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 200+ C0A8
 201+ C0A8 45               ld b,l
 202+ C0A9
 203+ C0A9 10 FE        Delay_3 djnz Delay_3
 204+ C0AB
 205+ C0AB AF               xor a                   ; Borde negro.
 206+ C0AC D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 207+ C0AE
 208+ C0AE 45               ld b,l
 209+ C0AF
 210+ C0AF 10 FE        Delay_4 djnz Delay_4
 211+ C0B1
 212+ C0B1              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 213+ C0B1
 214+ C0B1 2C               inc l
 215+ C0B2 2C               inc l
 216+ C0B3 2C               inc l
 217+ C0B4 2C               inc l
 218+ C0B5
 219+ C0B5 25               dec h
 220+ C0B6
 221+ C0B6 CC C0 C0         call z,Clean_shot_effect
 222+ C0B9
 223+ C0B9 0D               dec c
 224+ C0BA
 225+ C0BA 20 E8            jr nz,Loop_1
 226+ C0BC
 227+ C0BC 22 5B 94         ld (Shot_sound),hl
 228+ C0BF
 229+ C0BF C9               ret
 230+ C0C0
 231+ C0C0              Clean_shot_effect:
 232+ C0C0
 233+ C0C0 21 00 00         ld hl,0
 234+ C0C3 0E 01            ld c,1
 235+ C0C5
 236+ C0C5 C9               ret
 237+ C0C6
 238+ C0C6              ;   -------------------------------------------------------------------------------------------
 239+ C0C6              ;
 240+ C0C6              ;   23/9/26
 241+ C0C6              ;
 242+ C0C6              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso,_
 243+ C0C6              ;   _ o se esté ejecutando el efecto de sonido SHIELD, (Bit_0 Ctrl_6).
 244+ C0C6              ;
 245+ C0C6              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 246+ C0C6              ;   _ [Sound_Generator].
 247+ C0C6              ;
 248+ C0C6              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 249+ C0C6              ;
 250+ C0C6              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 251+ C0C6              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 252+ C0C6
 253+ C0C6              Play_burst_sound_effect:
 254+ C0C6
 255+ C0C6              ;   Exclusiones:
 256+ C0C6
 257+ C0C6 3A 5D 94         ld a,(Burst_sound)
 258+ C0C9 A7               and a
 259+ C0CA C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 260+ C0CB
 261+ C0CB 08               ex af,af
 262+ C0CC
 263+ C0CC 3A 2D 94         ld a,(Ctrl_6)
 264+ C0CF CB 47            bit 0,a
 265+ C0D1 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 266+ C0D2
 267+ C0D2              ;   ----------------------
 268+ C0D2
 269+ C0D2 CB C7            set 0,a
 270+ C0D4 32 2D 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 271+ C0D7
 272+ C0D7 08               ex af,af                ; Restore (Burst_sound).
 273+ C0D8
 274+ C0D8 67               ld h,a
 275+ C0D9 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 276+ C0DB
 277+ C0DB E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 278+ C0DC
 279+ C0DC 22 56 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 280+ C0DF 0E 03            ld c,3
 281+ C0E1 CD EB 9E         call Noise_efect
 282+ C0E4
 283+ C0E4 D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 284+ C0E5
 285+ C0E5 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 286+ C0E6 94               sub h
 287+ C0E7
 288+ C0E7 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 289+ C0E9
 290+ C0E9 7C               ld a,h
 291+ C0EA 32 5D 94         ld (Burst_sound),a
 292+ C0ED
 293+ C0ED C9               ret
 294+ C0EE
 295+ C0EE              Clean_burst_efect:
 296+ C0EE
 297+ C0EE AF               xor a
 298+ C0EF 32 5D 94         ld (Burst_sound),a
 299+ C0F2
 300+ C0F2 3A 2D 94         ld a,(Ctrl_6)
 301+ C0F5 CB 87            res 0,a
 302+ C0F7 32 2D 94         ld (Ctrl_6),a
 303+ C0FA
 304+ C0FA C9               ret
