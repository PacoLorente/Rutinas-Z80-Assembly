 782+ B621              ;
 783+ B621              ;   NextScan.
 784+ B621              ;
 785+ B621              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B621              ;
 787+ B621              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B621              ;
 789+ B621              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B621              ;
 791+ B621              ;       DESTRUIDOS: AF y HL !!!
 792+ B621              ;
 793+ B621              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B621              ;
 795+ B621
 796+ B621              NextScan:
 797+ B621
 798+ B621 24           	inc h          							; Incrementamos el scanline.
 799+ B622 7C               ld a,h
 800+ B623 E6 07            and 7
 801+ B625 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B626
 803+ B626 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B627 C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B629 6F               ld l,a
 806+ B62A D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B62B
 808+ B62B 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B62C D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B62E 67               ld h,a
 811+ B62F C9               ret
