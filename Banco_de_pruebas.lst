   4+ 9FB0              ;
   5+ 9FB0              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9FB0              ;   (XOR) bit a bit.
   7+ 9FB0              ;
   8+ 9FB0              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9FB0              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9FB0
  11+ 9FB0              Derivando_RND
  12+ 9FB0
  13+ 9FB0 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9FB2 C5               push bc
  15+ 9FB3              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9FB3 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9FB6              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9FB6
  19+ 9FB6 A7           6 and a                                 ; Carry a "0".
  20+ 9FB7 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9FB9 30 02            jr nc,1F
  22+ 9FBB
  23+ 9FBB CB C1            set 0,c
  24+ 9FBD
  25+ 9FBD 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9FBE E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9FC0 5F               ld e,a
  28+ 9FC1
  29+ 9FC1 7A               ld a,d
  30+ 9FC2 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9FC4 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9FC6
  33+ 9FC6 CB 3F            srl a
  34+ 9FC8
  35+ 9FC8 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9FC9
  37+ 9FC9 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9FCA 28 04            jr z,4F
  39+ 9FCC
  40+ 9FCC CB FF            set 7,a
  41+ 9FCE 18 02            jr 5F
  42+ 9FD0
  43+ 9FD0 CB BF        4 res 7,a
  44+ 9FD2
  45+ 9FD2 CB 21        5 sla c
  46+ 9FD4 10 E0            djnz 6B
  47+ 9FD6
  48+ 9FD6 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9FD7
  50+ 9FD7 77               ld (hl),a
  51+ 9FD8 23               inc hl
  52+ 9FD9 C1               pop bc
  53+ 9FDA 10 D4            djnz 3B
  54+ 9FDC
  55+ 9FDC C9               ret
  56+ 9FDD
  57+ 9FDD
  58+ 9FDD
