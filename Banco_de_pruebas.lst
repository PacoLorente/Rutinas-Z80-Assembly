 587+ A26C
 588+ A26C 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A26D D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A26F 67               ld h,a
 591+ A270 C9               ret
