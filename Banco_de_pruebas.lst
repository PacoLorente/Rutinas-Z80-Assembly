 372+ A3E9              ;
 373+ A3E9              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 374+ A3E9              ;
 375+ A3E9              ;	INPUTS:		B contiene (Numero_de_entidades).
 376+ A3E9              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 377+ A3E9              ; 				HL contiene (Puntero_de_entidades).
 378+ A3E9
 379+ A3E9              Prepara_Cajas_Master:
 380+ A3E9
 381+ A3E9 E5           	push hl															; Push (Puntero_de_entidades).
 382+ A3EA C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A3EB
 384+ A3EB              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A3EB
 386+ A3EB 79           	ld a,c
 387+ A3EC 08           	ex af,af
 388+ A3ED 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A3EE
 390+ A3EE CD 14 A6     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 391+ A3F1              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A3F1              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A3F1 A7           	and a
 394+ A3F2 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A3F4
 396+ A3F4              ; Generamos movimientos masticados.
 397+ A3F4
 398+ A3F4              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A3F4
 400+ A3F4 79           	ld a,c 															; (A) = (Clase).
 401+ A3F5 32 67 95     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A3F8
 403+ A3F8 CD ED A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A3FB CD 7F A7     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A3FE
 406+ A3FE              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 407+ A3FE              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 408+ A3FE              ;	coreografías distintas.
 409+ A3FE
 410+ A3FE 06 07        	ld b,7
 411+ A400 21 07 90     	ld hl,Numeros_aleatorios_baile
 412+ A403 CD 12 9E     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 413+ A406
 414+ A406              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 415+ A406
 416+ A406 3A 68 95     	ld a,(Tipo)
 417+ A409 CD 41 A6     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 418+ A40C CD 93 A5     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 419+ A40F
 420+ A40F              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 421+ A40F
 422+ A40F C1           	pop bc
 423+ A410 E1           	pop hl
 424+ A411
 425+ A411 E5           	push hl															; Push (Puntero_de_entidades).
 426+ A412 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 427+ A413
 428+ A413              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 429+ A413
 430+ A413 CD 50 A4     	call Determina_posicion_de_inicio 								; $941e ($78),($76),($72)
 431+ A416
 432+ A416 3A 68 95     	ld a,(Tipo)
 433+ A419 CD 51 A6     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
 434+ A41C
 435+ A41C              ;	Ya disponemos de una (Posicion_inicio) aleatoria y la definición de la entidad en la "Bandeja DRAW".
 436+ A41C              ;	Generamos "Movimientos masticados" de la entidad.
 437+ A41C
 438+ A41C CD 15 A5     	call Construye_movimientos_masticados_entidad
 439+ A41F
