   1+ 947D              ; ******************************************************************************************************************************************************************************************
   2+ 947D              ;
   3+ 947D              ;   3/4/25
   4+ 947D              ;
   5+ 947D              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 947D              ;   (XOR) bit a bit.
   7+ 947D              ;
   8+ 947D              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 947D              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 947D
  11+ 947D              Derivando_RND
  12+ 947D
  13+ 947D ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 947F C5               push bc
  15+ 9480              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9480 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9483              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9483
  19+ 9483 A7           6 and a                                 ; Carry a "0".
  20+ 9484 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9486 30 02            jr nc,1F
  22+ 9488
  23+ 9488 CB C1            set 0,c
  24+ 948A
  25+ 948A 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 948B E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 948D 5F               ld e,a
  28+ 948E
  29+ 948E 7A               ld a,d
  30+ 948F E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9491 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9493
  33+ 9493 CB 3F            srl a
  34+ 9495
  35+ 9495 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9496
  37+ 9496 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9497 28 04            jr z,4F
  39+ 9499
  40+ 9499 CB FF            set 7,a
  41+ 949B 18 02            jr 5F
  42+ 949D
  43+ 949D CB BF        4 res 7,a
  44+ 949F
  45+ 949F CB 21        5 sla c
  46+ 94A1 10 E0            djnz 6B
  47+ 94A3
  48+ 94A3 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94A4
  50+ 94A4 77               ld (hl),a
