 632  93FE
 633  93FE              Perfiles_de_velocidad:
 634  93FE
 635  93FE 00           Vel_left db 0 												; Velocidad izquierda. Nº de píxeles que desplazamos el objeto a izquierda. 1, 2, 4 u 8 px.
 636  93FF 00           Vel_right db 0 												; Velocidad derecha. Nº de píxeles que desplazamos el objeto a derecha. 1, 2, 4 u 8 px.
 637  9400 00           Vel_up db 0 												; Velocidad subida. Nº de píxeles que desplazamos el objeto hacia arriba. (De 1 a 7px).
 638  9401 00           Vel_down db 0 												; Velocidad bajada. Nº de píxeles que desplazamos el objeto hacia abajo. (De 1 a 7px).
 639  9402
 640  9402              ; Movimiento. ------------------------------------------------------------------------------------------------------
 641  9402
 642  9402 00 00        Puntero_tabla_Random defw 0
 643  9404 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 644  9406 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 645  9408 00 00        Puntero_indice_mov_bucle defw 0
 646  940A              ;
 647  940A              ;
 648  940A 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 649  940B              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 650  940B              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 651  940B
 652  940B 00           Incrementa_puntero_backup db 0
 653  940C 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 654  940D              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 655  940D
 656  940D 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 657  940E 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 658  940F 00           Cola_de_desplazamiento db 0									; Este byte indica:
 659  9410
 660  9410              ;
 661  9410              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 662  9410              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 663  9410              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 664  9410              ;
 665  9410              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 666  9410              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 667  9410              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 668  9410              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 669  9410              ;
 670  9410              ;															;	"$ff" ..... Bucle infinito de repetición.
 671  9410              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 672  9410              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 673  9410
 674  9410 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 675  9411
 676  9411              ;																DESCRIPCIÓN:
 677  9411              ;
 678  9411              ;															BIT 0, "1" Habilita la impresión del msg. DONE en pantalla. La llamada a [Print_DONE] se efectúa desde el Reloj del juego,_
 679  9411              ; 															_ Rutina de interrupciones IM2.
 680  9411
 681  9411 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 682  9413              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 683  9413              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 684  9413              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 685  9413              ;
