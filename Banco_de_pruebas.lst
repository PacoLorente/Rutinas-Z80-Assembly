 317+ C101 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 318+ C102
 319+ C102 21 2D 94         ld hl,Ctrl_6
 320+ C105 CB C6            set 0,(hl)              ; Activa el Inhibidor de sonido.
 321+ C107
 322+ C107 0E 02            ld c,2                  ; 2 ondas completas per frame.
 323+ C109
 324+ C109              Loop_3
 325+ C109
 326+ C109 08               ex af,af
 327+ C10A
 328+ C10A 3E 10            ld a,%00010000          ; Borde negro.
 329+ C10C D3 FE            out ($fe),a             ; Beeper ON.
 330+ C10E
 331+ C10E 08               ex af,af
 332+ C10F
 333+ C10F 47               ld b,a
 334+ C110
 335+ C110 10 FE        Delay_7 djnz Delay_7        ; Aplica Delay.
 336+ C112
 337+ C112 08               ex af,af
 338+ C113
 339+ C113 AF               xor a
 340+ C114 D3 FE            out ($fe),a
 341+ C116
 342+ C116 08               ex af,af
