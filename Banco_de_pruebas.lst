  20+ A5BB              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A5BB
  22+ A5BB
  23+ A5BB 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A5BE 11 01 40     	LD DE,$4001
  25+ A5C1 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A5C4 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A5C6 ED B0        	LDIR
  28+ A5C8 01 FF 02     	LD BC,767
  29+ A5CB 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A5CC ED B0        	LDIR
  31+ A5CE
  32+ A5CE AF           	xor a
  33+ A5CF
  34+ A5CF C9           	ret
  35+ A5D0
