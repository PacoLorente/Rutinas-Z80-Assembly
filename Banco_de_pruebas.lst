 256+ A3BC              ;
 257+ A3BC              ; 	Almacena en (A) uno de los 7 nº pseudo aleatorios generados, ($00-$ff) y avanza el puntero (RND_SP) a la posición de mem. del siguiente nº.
 258+ A3BC              ; 	Reiniciamos el puntero (RND_SP) a su posición inicial, 'Numeros_aleatorios' cuando este apunta a: 'Numeros_aleatorios+7'.
 259+ A3BC              ;
 260+ A3BC              ;	MODIFY: HL,DE,A
 261+ A3BC              ;
 262+ A3BC              ;	OUTPUTS: (A) contiene un Nº aleatorio. Actualiza el puntero de nº aleatorios (RND_SP).
 263+ A3BC              ;
 264+ A3BC              ;	Variables implicadas: (RND_SP).
 265+ A3BC
 266+ A3BC              Extrae_numero_aleatorio_y_avanza:
 267+ A3BC
 268+ A3BC 21 7A 91     	ld hl,Numeros_aleatorios+7						; Dirección de memoria donde se almacena el último n° pseudo aleatorio generado +1.
 269+ A3BF ED 5B 4F 96  	ld de,(RND_SP) 									; Puntero que se irá desplazando por el SET de nº aleatorios. Inicialmente apunta al 1°.
 270+ A3C3
 271+ A3C3              ;													; (HL) contiene la dirección del n° aleatorio que vamos a extraer.
 272+ A3C3              ;													; (DE)     "           "      "  último n° aleatorio +1, (detecta reinicio).
 273+ A3C3
 274+ A3C3 A7           	and a 											; Carry a "0".
 275+ A3C4
 276+ A3C4 ED 52        	sbc hl,de 										; Detecta el final de la caja de n° pseudo aleatorios.
 277+ A3C6 20 08        	jr nz,1F
 278+ A3C8
 279+ A3C8              ; 	Inicializa el puntero al principio de la caja de nº aleatorios pseudo aleatorios.
