   1+ 8A68
   2+ 8A68
   3+ 8A68              ;   07/07/23
   4+ 8A68              ;
   5+ 8A68              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8A68              ;
   7+ 8A68              ;   Codificación:
   8+ 8A68              ;
   9+ 8A68              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8A68              ;
  11+ 8A68              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8A68              ;
  13+ 8A68              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8A68              ;
  15+ 8A68              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8A68              ;
  17+ 8A68              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8A68              ;                               ..... %01000010 Vel_up 4
  19+ 8A68              ;                                               Vel_down 2
  20+ 8A68              ;                               ..... $42
  21+ 8A68              ;
  22+ 8A68              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8A68              ;
  24+ 8A68              ;                               ..... %01000010 Vel_left 4
  25+ 8A68              ;                                               Vel_right 2
  26+ 8A68              ;                               ..... $42
  27+ 8A68              ;
  28+ 8A68              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8A68              ;
  30+ 8A68              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8A68              ;
  32+ 8A68              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8A68              ;
  34+ 8A68              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8A68              ;                                     $53
  36+ 8A68              ;
  37+ 8A68              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8A68              ;
  39+ 8A68              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8A68              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8A68              ;
  42+ 8A68              ;                       Arriba ..... $81
  43+ 8A68              ;                       Arriba - izquierda ..... $a1
  44+ 8A68              ;                       Arriba - derecha ..... $91
  45+ 8A68              ;
  46+ 8A68              ;                       Abajo ..... $41
  47+ 8A68              ;                       Abajo - izquierda ..... $61
  48+ 8A68              ;                       Abajo - derecha ..... $51
  49+ 8A68              ;
  50+ 8A68              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8A68              ;
  52+ 8A68              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8A68              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8A68              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8A68              ;
  56+ 8A68              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8A68              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8A68              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8A68              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8A68              ;
  61+ 8A68              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8A68              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8A68              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8A68              ;
  65+ 8A68              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8A68              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8A68              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8A68              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8A68
