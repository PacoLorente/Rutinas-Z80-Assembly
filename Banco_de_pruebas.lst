   5+ 93D6              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93D6              ;   (XOR) bit a bit.
   7+ 93D6              ;
   8+ 93D6              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93D6
  10+ 93D6              Derivando_RND
  11+ 93D6
  12+ 93D6 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93D9
  14+ 93D9 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93DB C5               push bc
  16+ 93DC              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93DC 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 93DF              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 93DF
  20+ 93DF A7           6 and a                                 ; Carry a "0".
  21+ 93E0 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 93E2 30 02            jr nc,1F
  23+ 93E4
  24+ 93E4 CB C1            set 0,c
  25+ 93E6
  26+ 93E6 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 93E7 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 93E9 5F               ld e,a
  29+ 93EA
  30+ 93EA 7A               ld a,d
  31+ 93EB E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 93ED 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 93EF
  34+ 93EF CB 3F            srl a
  35+ 93F1
  36+ 93F1 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 93F2
  38+ 93F2 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 93F3 28 04            jr z,4F
  40+ 93F5
  41+ 93F5 CB FF            set 7,a
  42+ 93F7 18 02            jr 5F
  43+ 93F9
  44+ 93F9 CB BF        4 res 7,a
  45+ 93FB
  46+ 93FB CB 21        5 sla c
  47+ 93FD 10 E0            djnz 6B
  48+ 93FF
  49+ 93FF 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9400
  51+ 9400 77               ld (hl),a
  52+ 9401 23               inc hl
  53+ 9402 C1               pop bc
  54+ 9403 10 D4            djnz 3B
  55+ 9405
  56+ 9405 C9               ret
