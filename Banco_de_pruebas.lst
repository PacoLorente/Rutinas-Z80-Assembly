  28+ A38C 01 FF 02     	LD BC,767
  29+ A38F 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A390 ED B0        	LDIR
  31+ A392
  32+ A392 AF           	xor a
  33+ A393
  34+ A393 C9           	ret
  35+ A394
