 584  94C3 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 585  94C4              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 586  94C4
 587  94C4 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 588  94C5 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 589  94C6 00           Cola_de_desplazamiento db 0									; Este byte indica:
 590  94C7
 591  94C7              ;
 592  94C7              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 593  94C7              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 594  94C7              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 595  94C7              ;
 596  94C7              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 597  94C7              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 598  94C7              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 599  94C7              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 600  94C7              ;
 601  94C7              ;															;	"$ff" ..... Bucle infinito de repetición.
 602  94C7              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 603  94C7              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 604  94C7
 605  94C7 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 606  94C8
 607  94C8              ;																DESCRIPCIÓN:
 608  94C8              ;
 609  94C8              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 610  94C8              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 611  94C8              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 612  94C8              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 613  94C8              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 614  94C8              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 615  94C8
 616  94C8              ;															BIT 3, Recarga de nueva oleada.
 617  94C8              ;															BIT 4, Recarga de nueva oleada.
