   4+ 9972              ;
   5+ 9972              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9972              ;   (XOR) bit a bit.
   7+ 9972              ;
   8+ 9972              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9972              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9972
  11+ 9972              Derivando_RND
  12+ 9972
  13+ 9972 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9974 C5               push bc
  15+ 9975              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9975 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9978              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9978
  19+ 9978 A7           6 and a                                 ; Carry a "0".
  20+ 9979 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 997B 30 02            jr nc,1F
  22+ 997D
  23+ 997D CB C1            set 0,c
  24+ 997F
  25+ 997F 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9980 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9982 5F               ld e,a
  28+ 9983
  29+ 9983 7A               ld a,d
  30+ 9984 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9986 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9988
  33+ 9988 CB 3F            srl a
  34+ 998A
  35+ 998A AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 998B
  37+ 998B 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 998C 28 04            jr z,4F
  39+ 998E
  40+ 998E CB FF            set 7,a
  41+ 9990 18 02            jr 5F
  42+ 9992
  43+ 9992 CB BF        4 res 7,a
  44+ 9994
  45+ 9994 CB 21        5 sla c
  46+ 9996 10 E0            djnz 6B
  47+ 9998
  48+ 9998 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9999
  50+ 9999 77               ld (hl),a
  51+ 999A 23               inc hl
  52+ 999B C1               pop bc
  53+ 999C 10 D4            djnz 3B
  54+ 999E
  55+ 999E C9               ret
  56+ 999F
  57+ 999F
  58+ 999F
