   5+ B4B5
   6+ B4B5              Draw:
   7+ B4B5
   8+ B4B5 2A 79 95     	ld hl,(Posicion_actual)
   9+ B4B8 7C           	ld a,h
  10+ B4B9 B5           	or l
  11+ B4BA 20 10        	jr nz,Entidad_iniciada 										; Si el contenido de (Posicion_actual) es distinto de "0" la entidad ya se ha iniciado.
  12+ B4BC
  13+ B4BC CD 3C BB     	call Inicia_Puntero_mov
  14+ B4BF
  15+ B4BF 2A 86 95     	ld hl,(Posicion_inicio)
  16+ B4C2 22 79 95     	ld (Posicion_actual),hl
  17+ B4C5 22 6B 95     	ld (Puntero_de_impresion),hl
  18+ B4C8
  19+ B4C8              ;	Comparador de cuadrantes:
  20+ B4C8
  21+ B4C8 CD E2 B4     	call Calcula_Cuad_objeto
  22+ B4CB 08           	ex af,af													; (Cuad_objeto) inicial en A'.
  23+ B4CC
  24+ B4CC              Entidad_iniciada:
  25+ B4CC
  26+ B4CC DD 2A 6B 95  	ld ix,(Puntero_de_impresion) 								; (Puntero_de_impresion) de la anterior (Posicion_actual). Necesario para averiguar si existe_
  27+ B4D0              ; 																; _cambio de cuadrante cuando el sprite está incompleto.
  28+ B4D0 CD E2 B4     	call Calcula_Cuad_objeto  									; (Cuad_objeto) de la nueva (Posicion_actual).
  29+ B4D3
  30+ B4D3 CD 20 B5     	call calcula_CColumnass										; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  31+ B4D6              ;																; También comprueba si en la nueva (Posicion_actual) el Sprite se imprime COMPLETO o INCOMPLETO, (Sprite_completo_1).
  32+ B4D6 CD 46 B5     	call Drive													; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  33+ B4D9
  34+ B4D9 3A 74 95     	ld a,(Ctrl_0)												; Antes de salir de la rutina restauramos los bits 0,1,2,3 y 5 de (Ctrl_0).
  35+ B4DC E6 D0        	and $d0
  36+ B4DE 32 74 95     	ld (Ctrl_0),a
