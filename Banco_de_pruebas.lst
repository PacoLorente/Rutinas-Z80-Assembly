 305  8CAB              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8CAB
 307  8CAB 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8CAC 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CAD 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CAE
 311  8CAE              ;
 312  8CAE              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CAE              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CAE              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CAE              ;
 316  8CAE              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CAE              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CAE              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CAE              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CAE              ;
 321  8CAE              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CAE              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CAE              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8CAE
 325  8CAE 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 326  8CAF
 327  8CAF              ;																DESCRIPCIÓN:
 328  8CAF              ;
 329  8CAF              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 330  8CAF              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 331  8CAF              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 332  8CAF              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 333  8CAF              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 334  8CAF              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 335  8CAF
 336  8CAF              ;																BIT 3, Recarga de nueva oleada.
 337  8CAF              ;																BIT 4, Recarga de nueva oleada.
 338  8CAF              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 339  8CAF              ;																BIT 6, **** Frame completo.
 340  8CAF              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 341  8CAF
