 329+ C16B              ; ----- ----- ----- ----- -----
 330+ C16B              ;
 331+ C16B              ;   23/9/26
 332+ C16B              ;
 333+ C16B              ;   El efecto del disparo de Amadeus es de tipo descendente.
 334+ C16B              ;
 335+ C16B              ;   HL define el sonido.
 336+ C16B              ;
 337+ C16B              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 338+ C16B              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 339+ C16B              ;
 340+ C16B              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 341+ C16B              ;   _ escudo tienen prioridad sobre este efecto.
 342+ C16B              ;
 343+ C16B              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 344+ C16B              ;
 345+ C16B              ;   INPUTS: (Shot_sound) <> "0".
 346+ C16B              ;
 347+ C16B              ;   MODIFY: AF, HL y BC.
 348+ C16B              ;
 349+ C16B              ;   OUTPUT: (Shot_sound) actualizado.
 350+ C16B
 351+ C16B              Play_shot_sound_effect:
 352+ C16B
 353+ C16B              ;   Exclusiones:
 354+ C16B
 355+ C16B 2A EB 94         ld hl,(Shot_sound)
 356+ C16E 7C               ld a,h
 357+ C16F B5               or l
 358+ C170 C8               ret z                   ; RET si no se ha producido disparo.
 359+ C171
 360+ C171 3A BD 94         ld a,(Ctrl_6)
 361+ C174 CB 47            bit 0,a
 362+ C176 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 363+ C177
 364+ C177 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
