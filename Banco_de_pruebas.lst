1749  992D
1750  992D 38 01        	jr c,1F
1751  992F
1752  992F              ;	Por encima o igual que (Max_time_to_appear_entities).
1753  992F              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1754  992F
1755  992F 4E           	ld c,(hl)
1756  9930
1757  9930              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1758  9930              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
