 640  940E              ; Movimiento. ------------------------------------------------------------------------------------------------------
 641  940E
 642  940E 00 00        Puntero_tabla_Random defw 0
 643  9410 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 644  9412 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 645  9414 00 00        Puntero_indice_mov_bucle defw 0
 646  9416              ;
 647  9416              ;
 648  9416 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 649  9417              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 650  9417              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 651  9417
 652  9417 00           Incrementa_puntero_backup db 0
 653  9418 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 654  9419              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 655  9419
 656  9419 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 657  941A 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 658  941B 00           Cola_de_desplazamiento db 0									; Este byte indica:
 659  941C
 660  941C              ;
 661  941C              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 662  941C              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 663  941C              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 664  941C              ;
 665  941C              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 666  941C              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 667  941C              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 668  941C              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 669  941C              ;
 670  941C              ;															;	"$ff" ..... Bucle infinito de repetición.
 671  941C              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 672  941C              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 673  941C
 674  941C 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 675  941D
 676  941D              ;																DESCRIPCIÓN:
 677  941D              ;
 678  941D              ;															BIT 0, "1" Habilita la impresión del msg. DONE en pantalla. La llamada a [Print_DONE] se efectúa desde el Reloj del juego,_
 679  941D              ; 															_ Rutina de interrupciones IM2.
 680  941D
 681  941D 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 682  941F              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 683  941F              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 684  941F              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 685  941F              ;
 686  941F              ;															; 2ª Función:
