 473+ C14F
 474+ C14F 08               ex af,af                ; Restore (Burst_sound).
 475+ C150
 476+ C150 67               ld h,a
 477+ C151 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 478+ C153
 479+ C153 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 480+ C154
 481+ C154 22 84 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 482+ C157 0E 03            ld c,3
 483+ C159 CD 1E 9F         call Noise_efect
 484+ C15C
 485+ C15C D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 486+ C15D
 487+ C15D 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 488+ C15E 94               sub h
