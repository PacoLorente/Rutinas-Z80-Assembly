 619+ AE1E
 620+ AE1E 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ AE1F C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ AE21 67               ld h,a
