3125  BFE6              	include "Sound.asm"
# file opened: Sound.asm
   1+ BFE6              ; ----------------------------------------------------------
   2+ BFE6              ;
   3+ BFE6              ;   26/09/26
   4+ BFE6              ;
   5+ BFE6              ;   Voy a utilizar los 6 bytes de las variables:
   6+ BFE6              ;
   7+ BFE6              ;   (Indice_Sprite_der)
   8+ BFE6              ;   (Indice_Sprite_izq)
   9+ BFE6              ;   (Puntero_DESPLZ_der)
  10+ BFE6              ;
  11+ BFE6              ;   Para almacenar el perfil de la nota que está en ejecución pues la rutina se ejecuta "IN GAME TIME" y sólo reproducirá 4 ondas_
  12+ BFE6              ;   _del total que forman la nota.
  13+ BFE6              ;
  14+ BFE6              ;   La rutina genera un "ruido" o especie de zumbido ascendente/descendente llamando a la rutina [Sound_Generator].
  15+ BFE6              ;   La melodía consta de dos notas incluidas en el índice: "Game_over_noise_index:". El puntero (Puntero_game_over_noise) avanza_
  16+ BFE6              ;   _ por el índice proporcionando los datos de las notas a la rutina.
  17+ BFE6              ;
  18+ BFE6              ;   La rutina [Sound_Generator] requiere que los parámetros de la nota a ejecutar se den de la siguiente forma:
  19+ BFE6              ;
  20+ BFE6              ;           C contiene el nº de veces que vamos a generar la onda del sonido.
  21+ BFE6              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
  22+ BFE6              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
  23+ BFE6              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
