 554  94C1              ;
 555  94C1              ;
 556  94C1 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 557  94C2              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
