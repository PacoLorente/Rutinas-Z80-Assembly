 141+ 9E63 C6 20            add a,$20           							; Vamos a comprobarlo...
 142+ 9E65 6F               ld l,a
 143+ 9E66 D8               ret c               							; Salimos si se produce el cambio de tercio.
 144+ 9E67
 145+ 9E67 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 146+ 9E68 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 147+ 9E6A 67               ld h,a
