 308+ C151              ; ----------------------------------------------------------------------------------------------
 309+ C151              ;
 310+ C151              ;   17/9/26
 311+ C151              ;
 312+ C151              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C151              ;
 314+ C151              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C151
 316+ C151              BEEP:
 317+ C151
 318+ C151 F5               push af
 319+ C152 C5               push bc
 320+ C153 D5               push de
 321+ C154 E5               push hl                                 ; STORE Regs.
 322+ C155
 323+ C155              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C155
 325+ C155              ;   Configuración de un BEEP.
 326+ C155
 327+ C155              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C155              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C155              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C155              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C155              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C155
 333+ C155
 334+ C155 01 02 00         ld bc,$0002
 335+ C158 11 00 00         ld de,0
 336+ C15B 21 D0 00         ld hl,$00d0
 337+ C15E
 338+ C15E 22 06 96         ld (Sound),hl
 339+ C161
 340+ C161 CD 5F 9F         call Sound_Generator    ; v2. Ok.
 341+ C164
 342+ C164 21 00 00         ld hl,0
 343+ C167 22 06 96         ld (Sound),hl
 344+ C16A
 345+ C16A E1               pop hl                                  ; RECOVERY Regs.
 346+ C16B D1               pop de
 347+ C16C C1               pop bc
 348+ C16D F1               pop af
 349+ C16E
 350+ C16E C9               ret
 351+ C16F
 352+ C16F              ; ----- ----- ----- ----- -----
 353+ C16F              ;
 354+ C16F              ;   23/9/26
 355+ C16F              ;
 356+ C16F              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C16F              ;
 358+ C16F              ;   HL define el sonido.
 359+ C16F              ;
 360+ C16F              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C16F              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C16F              ;
 363+ C16F              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C16F              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C16F              ;
 366+ C16F              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C16F              ;
 368+ C16F              ;   INPUTS: (Shot_sound) <> "0".
 369+ C16F              ;
 370+ C16F              ;   MODIFY: AF, HL y BC.
 371+ C16F              ;
 372+ C16F              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C16F
 374+ C16F              Play_shot_sound_effect:
 375+ C16F
 376+ C16F              ;   Exclusiones:
 377+ C16F
 378+ C16F 2A 0A 96         ld hl,(Shot_sound)
 379+ C172 7C               ld a,h
 380+ C173 B5               or l
 381+ C174 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C175
 383+ C175 3A DD 95         ld a,(Ctrl_6)
 384+ C178 CB 47            bit 0,a
 385+ C17A C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C17B
 387+ C17B 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C17D
 389+ C17D              Loop_1:
 390+ C17D
 391+ C17D 3E 10            ld a,%00010000          ; Borde negro.
 392+ C17F D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C181
 394+ C181 45               ld b,l
 395+ C182
 396+ C182 10 FE        Delay_3 djnz Delay_3
 397+ C184
 398+ C184 AF               xor a                   ; Borde negro.
 399+ C185 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C187
 401+ C187 45               ld b,l
 402+ C188
 403+ C188 10 FE        Delay_4 djnz Delay_4
 404+ C18A
 405+ C18A              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C18A
 407+ C18A 2C               inc l
 408+ C18B 2C               inc l
 409+ C18C 2C               inc l
 410+ C18D 2C               inc l
 411+ C18E
 412+ C18E 25               dec h
 413+ C18F
 414+ C18F CC 99 C1         call z,Clean_shot_effect
 415+ C192
 416+ C192 0D               dec c
 417+ C193
 418+ C193 20 E8            jr nz,Loop_1
 419+ C195
 420+ C195 22 0A 96         ld (Shot_sound),hl
 421+ C198
 422+ C198 C9               ret
 423+ C199
 424+ C199              Clean_shot_effect:
 425+ C199
 426+ C199 21 00 00         ld hl,0
 427+ C19C 0E 01            ld c,1
 428+ C19E
 429+ C19E C9               ret
 430+ C19F
 431+ C19F              ;   -------------------------------------------------------------------------------------------
 432+ C19F              ;
 433+ C19F              ;   23/9/26
 434+ C19F              ;
 435+ C19F              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C19F              ;
 437+ C19F              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C19F              ;   _ [Sound_Generator].
 439+ C19F              ;
 440+ C19F              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C19F              ;
 442+ C19F              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C19F              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C19F              ;
 445+ C19F              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C19F              ;
 447+ C19F              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C19F              ;
 449+ C19F              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C19F
 451+ C19F              Play_burst_sound_effect:
 452+ C19F
 453+ C19F              ;   Exclusiones:
 454+ C19F
 455+ C19F 3A 0C 96         ld a,(Burst_sound)
 456+ C1A2 A7               and a
 457+ C1A3 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C1A4
 459+ C1A4 08               ex af,af
 460+ C1A5
 461+ C1A5 3A DD 95         ld a,(Ctrl_6)
 462+ C1A8 CB 47            bit 0,a
 463+ C1AA C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C1AB
 465+ C1AB              ;   ----------------------
 466+ C1AB
 467+ C1AB CB C7            set 0,a
 468+ C1AD 32 DD 95         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C1B0
 470+ C1B0 08               ex af,af                ; Restore (Burst_sound).
 471+ C1B1
 472+ C1B1 67               ld h,a
 473+ C1B2 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1B4
 475+ C1B4 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1B5
 477+ C1B5 22 06 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1B8 0E 03            ld c,3
 479+ C1BA CD 98 9F         call Noise_efect
 480+ C1BD
 481+ C1BD D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1BE
 483+ C1BE 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1BF 94               sub h
 485+ C1C0
 486+ C1C0 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1C2
 488+ C1C2 7C               ld a,h
 489+ C1C3 32 0C 96         ld (Burst_sound),a
 490+ C1C6
 491+ C1C6 C9               ret
 492+ C1C7
 493+ C1C7              Clean_burst_efect:
 494+ C1C7
 495+ C1C7 AF               xor a
 496+ C1C8 32 0C 96         ld (Burst_sound),a
 497+ C1CB
 498+ C1CB 3A DD 95         ld a,(Ctrl_6)
 499+ C1CE CB 87            res 0,a
 500+ C1D0 32 DD 95         ld (Ctrl_6),a
 501+ C1D3
 502+ C1D3 C9               ret
 503+ C1D4
 504+ C1D4              ;   -------------------------------------------------------------------------------------------
 505+ C1D4              ;
 506+ C1D4              ;   23/9/26
 507+ C1D4              ;
 508+ C1D4              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1D4              ;   _ Shield_sound_effect.
 510+ C1D4              ;
 511+ C1D4              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1D4              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1D4              ;
 514+ C1D4              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1D4              ;
 516+ C1D4              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1D4              ;
 518+ C1D4              ;   MODIFY: AF'y BC.
 519+ C1D4
 520+ C1D4              Play_Shield_sound_effect:
 521+ C1D4
 522+ C1D4 3A 0D 96         ld a,(Shield_sound)
 523+ C1D7 A7               and a
 524+ C1D8 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1D9
 526+ C1D9 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1DB
 528+ C1DB              Loop_3:
 529+ C1DB
 530+ C1DB 08               ex af,af
 531+ C1DC
 532+ C1DC 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1DE D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1E0
 535+ C1E0 08               ex af,af
 536+ C1E1
 537+ C1E1 47               ld b,a
 538+ C1E2
 539+ C1E2 10 FE        Delay_7 djnz Delay_7
 540+ C1E4
 541+ C1E4 08               ex af,af
 542+ C1E5
 543+ C1E5 AF               xor a                   ; Black BORDER.
 544+ C1E6 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1E8
 546+ C1E8 08               ex af,af
 547+ C1E9
 548+ C1E9 47               ld b,a
 549+ C1EA
 550+ C1EA 10 FE        Delay_8 djnz Delay_8
 551+ C1EC
 552+ C1EC 0D               dec c
 553+ C1ED
 554+ C1ED 20 EC            jr nz,Loop_3
 555+ C1EF
 556+ C1EF AF               xor a
 557+ C1F0 32 0D 96         ld (Shield_sound),a
 558+ C1F3
 559+ C1F3 C9               ret
 560+ C1F4
 561+ C1F4              ; ---------------------------------------------------------------
 562+ C1F4              ;
 563+ C1F4              ;   18/9/26
 564+ C1F4              ;
 565+ C1F4              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C1F4              ;
 567+ C1F4              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C1F4              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C1F4              ;
 570+ C1F4              ;   MODIFY: A y H.
 571+ C1F4              ;
 572+ C1F4              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C1F4
 574+ C1F4
 575+ C1F4              Init_Burst_sound:
 576+ C1F4
 577+ C1F4 3A 0C 96         ld a,(Burst_sound)
 578+ C1F7 A7               and a
 579+ C1F8 C0               ret nz                                           ; RET si ya está iniciado el efecto.
 580+ C1F9
 581+ C1F9              ;   Init Burst_sound_efect.
 582+ C1F9
 583+ C1F9              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C1F9
 585+ C1F9 26 35            ld h,Burst_sound_init_value
 586+ C1FB
 587+ C1FB 3A CF 90         ld a,(Impacto_Amadeus)
 588+ C1FE A7               and a
 589+ C1FF 28 02            jr z,1F
 590+ C201
 591+ C201 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C203
 593+ C203 7C           1 ld a,h
 594+ C204
 595+ C204 32 0C 96         ld (Burst_sound),a
 596+ C207
 597+ C207 C9               ret
 598+ C208
 599+ C208
