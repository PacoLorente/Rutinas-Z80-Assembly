 297  8CAB              ;
 298  8CAB              ;
 299  8CAB 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8CAC              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
