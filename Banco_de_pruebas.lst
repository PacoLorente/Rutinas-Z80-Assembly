   4+ 9A12              ;	CLS.
   5+ 9A12              ;
   6+ 9A12              ;	Limpia la pantalla y define sus atributos.
   7+ 9A12              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ 9A12              ;
   9+ 9A12              ;	COLORES: 0 ..... NEGRO
  10+ 9A12              ;    		 1 ..... AZUL
  11+ 9A12              ; 			 2 ..... ROJO
  12+ 9A12              ;			 3 ..... MAGENTA
  13+ 9A12              ; 			 4 ..... VERDE
  14+ 9A12              ; 			 5 ..... CIAN
  15+ 9A12              ;			 6 ..... AMARILLO
  16+ 9A12              ; 			 7 ..... BLANCO
  17+ 9A12              ;
  18+ 9A12              ;	INPUT: A contiene los atributos de pantalla.
  19+ 9A12              ;
  20+ 9A12              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 9A12
  22+ 9A12
  23+ 9A12 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ 9A15 11 01 40     	LD DE,$4001
  25+ 9A18 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 9A1B 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 9A1D ED B0        	LDIR
  28+ 9A1F 01 FF 02     	LD BC,767
  29+ 9A22 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 9A23 ED B0        	LDIR
  31+ 9A25 C9           	ret
  32+ 9A26
