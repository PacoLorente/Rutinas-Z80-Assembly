 213+ A9AE              ;
 214+ A9AE              ;	8/11/26
 215+ A9AE              ;
 216+ A9AE              ;	Genera una constelación de 42 estrellas en pantalla.
 217+ A9AE              ;
 218+ A9AE              ;	La rutina se ejecutará SEIS veces por medio de un bucle; generamos 7 estrellas cada vez que ejecutamos la función.
 219+ A9AE              ;
 220+ A9AE              ;	En primer lugar la función genera 7 n° pseudo aleatorios, ([Numeros_aleatorios]).
 221+ A9AE              ;
 222+ A9AE              ;	Sumaremos el 1er n° generado a la dirección de memoria de pantalla $4000.
 223+ A9AE              ;
 224+ A9AE              ;	A la dirección de memoria de pantalla resultante sumaremos el 2° número.
 225+ A9AE              ;
 226+ A9AE              ;	A la  "        "      "         "         "          "     el 3° y así sucesivamente hasta que agotemos los 7 números.
 227+ A9AE              ;
 228+ A9AE              ;	En cada dirección de memoria pseudo aleatoria, (de las SIETE generadas) pintaremos la estrella mediante una función XOR_
 229+ A9AE              ;	_ para no borrar parte del marcador, vidas y luna en la parte alta de la pantalla.
 230+ A9AE              ;
 231+ A9AE              ;	Antes de ejecutar de nuevo la función y generar SIETE nuevos números pseudo aleatorios guardaremos la última dirección de_
 232+ A9AE              ;	_ memoria de pantalla en la variable (Puntero_de_almacen_de_mov_masticados). Nota: Antes de salir de la rutina inicializaremos_
 233+ A9AE              ;	_ esta variable, (Puntero_de_almacen_de_mov_masticados)="0".
 234+ A9AE              ;
 235+ A9AE              ;	Resumiendo: ($4000 + n°1) = STAR_1
 236+ A9AE              ;				(STAR_1 + n°2) = STAR_2
 237+ A9AE              ; 				(STAR_2 + n°3) = STAR_3
 238+ A9AE              ;						"    "
 239+ A9AE              ; 						"    "
 240+ A9AE              ; 				(STAR_6 + n°7) = STAR_7
 241+ A9AE              ;
 242+ A9AE              ;				ld (Puntero_de_almacen_de_mov_masticados),STAR_7
 243+ A9AE              ;
 244+ A9AE              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 245+ A9AE              ;
 246+ A9AE              ;	MODIFY: AF, HL, BC y DE.
 247+ A9AE
 248+ A9AE              make_stars:
 249+ A9AE
 250+ A9AE 06 06        	ld b,6 												; Generamos 42 estrellas, (6*7). Con esta cantidad nos aseguramos de no llegar a generar direcciones_
 251+ A9B0              ; 														; _ de memoria de pantalla superiores a $57ff y entrar en memoria deatributos.
 252+ A9B0              ; 														; Las direcciones de memoria generadas se inician a partir de la $4000 e irán incrementándose en función_
 253+ A9B0              ; 														; _de los n° aleatorios generados.
 254+ A9B0
 255+ A9B0 C5           2 push bc 												; PUSH 6, (número de veces que vamos a ejecutar la función).
 256+ A9B1
 257+ A9B1 06 07        	ld b,7 												; Generamos 7 números pseudo aleatorios, (para generar 7 direcciónes de pantalla pseudo aleatorias).
 258+ A9B3
 259+ A9B3 21 73 91     	ld hl,Numeros_aleatorios
 260+ A9B6
 261+ A9B6 E5           	push hl
 262+ A9B7
 263+ A9B7 CD 94 9E     	call Derivando_RND
 264+ A9BA
 265+ A9BA E1           	pop hl
 266+ A9BB
 267+ A9BB EB           	ex de,hl 											; DE apunta a la dirección de mem. donde se encuentra el 1er n° generado.
 268+ A9BC
 269+ A9BC 2A 15 96     	ld hl,(Puntero_de_almacen_de_mov_masticados) 		; Inicialmente Line_0, ($4000).
 270+ A9BF
 271+ A9BF 01 00 07     	ld bc,$0700 										; Contador, Construimos 7 estrellas con 7 direcciones de memoria.
