 796+ AFCE              ;
 797+ AFCE              ;   26/10/26
 798+ AFCE              ;
 799+ AFCE              ;   Pinta un sprite de Amadeus en la parte superior izquierda de la pantalla. IT's a LIFE !!!
 800+ AFCE              ;
 801+ AFCE              ;   Los datos de pintado de la vida vienen dados por la tabla:
 802+ AFCE              ;
 803+ AFCE              ;   Tabla_marcador_de_vidas:
 804+ AFCE              ;
 805+ AFCE              ;	defw Vida_1,Amadeus       							; (Puntero_de_impresion), (Puntero_objeto)
 806+ AFCE              ;	defw Vida_2,Amadeus_Fb
 807+ AFCE              ;	defw Vida_3,Amadeus
 808+ AFCE              ;
 809+ AFCE              ;   (Puntero_de_vidas) almacenará el puntero SP que será el encargado de ir desplazandose por la tabla abasteciendo de datos_
 810+ AFCE              ;   _ a los registros HL y DE:
 811+ AFCE              ;
 812+ AFCE              ;    pop hl                                             ; Dirección de pantalla donde se imprime Vida_X, (Puntero_de_impresion).
 813+ AFCE              ;    pop de                                             ; Dirección de memoria donde se encuentran los .db que componen Amadeus, (Puntero_objeto).
 814+ AFCE              ;
 815+ AFCE              ;   Al ser el n° de (Columnas/Filas) una constante, ($0302) lo cargamos directamente en el par de registros (BC).
 816+ AFCE              ;   Los attrs. serían la 2a constante que será almacenada en (A).
 817+ AFCE              ;
 818+ AFCE              ;   Con estos datos, la rutina [Pinta_imagen] imprimirá la imagen en la parte superior izquierda de la pantalla.
 819+ AFCE              ;
 820+ AFCE              ;   MODIFY: A,HL,BC y DE
 821+ AFCE              ;           (Puntero_de_vidas)
 822+ AFCE
 823+ AFCE              Pinta_Vida:
 824+ AFCE
 825+ AFCE ED 73 FB 95      ld (Stack),sp                                       ; Guarda el vector (SP).
 826+ AFD2 ED 7B 69 96      ld sp,(Puntero_de_vidas)                            ; Utilizaremos el puntero SP para extraer la información de la ((Tabla_marcador_de_vidas))_
 827+ AFD6              ;                                                       ; _ y abastecer REGs.
 828+ AFD6
 829+ AFD6 E1               pop hl                                              ; Dirección de pantalla donde se imprime Vida_X, (Puntero_de_impresion).
 830+ AFD7 D1               pop de                                              ; Dirección de memoria donde se encuentran los .db que componen Amadeus, (Puntero_objeto).
 831+ AFD8
 832+ AFD8 ED 73 69 96      ld (Puntero_de_vidas),sp                            ; Sitúa (Puntero_de_vidas) en los datos de la tabla de la siguiente vida.
 833+ AFDC
 834+ AFDC ED 7B FB 95      ld sp,(Stack)                                       ; Recupera la dirección que contenía el vector SP.
 835+ AFE0
 836+ AFE0 3E 45            ld a,%01000101                                      ; Attrs.: BRIGHT, BLACK PAPER, CYAN INK.
 837+ AFE2
 838+ AFE2 01 02 03         ld bc,$0302                                         ; (Columnas/Filas )
 839+ AFE5
 840+ AFE5 CD F2 9E         call Pinta_imagen   ; v2. Ok.                       ; Imprime AMADEUS.
 841+ AFE8
 842+ AFE8 C9               ret
