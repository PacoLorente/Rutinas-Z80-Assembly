   3+ 8C1A              ;   07/07/23
   4+ 8C1A              ;
   5+ 8C1A              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8C1A              ;
   7+ 8C1A              ;   Codificación:
   8+ 8C1A              ;
   9+ 8C1A              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8C1A              ;
  11+ 8C1A              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8C1A              ;
  13+ 8C1A              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8C1A              ;
  15+ 8C1A              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8C1A              ;
  17+ 8C1A              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8C1A              ;                               ..... %01000010 Vel_up 4
  19+ 8C1A              ;                                               Vel_down 2
  20+ 8C1A              ;                               ..... $42
  21+ 8C1A              ;
  22+ 8C1A              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8C1A              ;
  24+ 8C1A              ;                               ..... %01000010 Vel_left 4
  25+ 8C1A              ;                                               Vel_right 2
  26+ 8C1A              ;                               ..... $42
  27+ 8C1A              ;
  28+ 8C1A              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8C1A              ;
  30+ 8C1A              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8C1A              ;
  32+ 8C1A              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8C1A              ;
  34+ 8C1A              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8C1A              ;                                     $53
  36+ 8C1A              ;
  37+ 8C1A              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8C1A              ;
  39+ 8C1A              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8C1A              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8C1A              ;
  42+ 8C1A              ;                       Arriba ..... $81
  43+ 8C1A              ;                       Arriba - izquierda ..... $a1
  44+ 8C1A              ;                       Arriba - derecha ..... $91
  45+ 8C1A              ;
  46+ 8C1A              ;                       Abajo ..... $41
  47+ 8C1A              ;                       Abajo - izquierda ..... $61
  48+ 8C1A              ;                       Abajo - derecha ..... $51
  49+ 8C1A              ;
  50+ 8C1A              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8C1A              ;
  52+ 8C1A              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8C1A              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8C1A              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8C1A              ;
  56+ 8C1A              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8C1A              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8C1A              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8C1A              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8C1A              ;
  61+ 8C1A              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8C1A              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8C1A              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8C1A              ;
  65+ 8C1A              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8C1A              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8C1A              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8C1A              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8C1A
