 632+ B5DA C6 20            add a,$20           							; Vamos a comprobarlo...
 633+ B5DC 6F               ld l,a
 634+ B5DD D8               ret c               							; Salimos si se produce el cambio de tercio.
 635+ B5DE
 636+ B5DE 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 637+ B5DF D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 638+ B5E1 67               ld h,a
 639+ B5E2 C9               ret
