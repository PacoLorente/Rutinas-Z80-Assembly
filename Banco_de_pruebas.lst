   4+ 9E11              ;
   5+ 9E11              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E11              ;   (XOR) bit a bit.
   7+ 9E11              ;
   8+ 9E11              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E11              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E11
  11+ 9E11              Derivando_RND:
  12+ 9E11
  13+ 9E11              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  14+ 9E11 ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9E13
  16+ 9E13 C5           3 push bc                               ; PUSH N° de números que queremos generar.
  17+ 9E14
  18+ 9E14 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  19+ 9E17              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  20+ 9E17
  21+ 9E17              Xor_bit_1_bit_2:
  22+ 9E17
  23+ 9E17              ;   Realizamos operación lógica XOR entre el bit_0 y el bit_1 de la semilla.
  24+ 9E17
  25+ 9E17 57               ld d,a                              ; D contiene la copia de nuestra semilla.
  26+ 9E18
  27+ 9E18 E6 01            and %00000001                       ; Bit_0 en (E).
  28+ 9E1A 5F               ld e,a
  29+ 9E1B
  30+ 9E1B 7A               ld a,d
  31+ 9E1C E6 02            and %00000010                       ; Bit_1 en (A).
  32+ 9E1E
  33+ 9E1E 28 02            jr z,1F
  34+ 9E20
  35+ 9E20 3E 01            ld a,1
  36+ 9E22
  37+ 9E22 AB           1 xor e
  38+ 9E23
  39+ 9E23              ;   FUNCIÓN XOR
  40+ 9E23
  41+ 9E23              ;   0 0 ..... 0
  42+ 9E23              ;   0 1 ..... 1
  43+ 9E23              ;   1 0 ..... 1
  44+ 9E23              ;   1 1 ..... 0
  45+ 9E23
  46+ 9E23 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla.
  47+ 9E24
  48+ 9E24 28 03            jr z,2F
  49+ 9E26
  50+ 9E26              ;   FUNCIÓN XOR "1".
  51+ 9E26
  52+ 9E26 CB C1            set 0,c                             ; Set bit_0 del n° que estamos generando.
  53+ 9E28
  54+ 9E28 37               scf                                 ; Set Flag Carry.
  55+ 9E29
  56+ 9E29 CB 1F        2 rr a                                  ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  57+ 9E2B
  58+ 9E2B CB 21            sla c                               ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  59+ 9E2D
  60+ 9E2D 10 E8            djnz Xor_bit_1_bit_2
  61+ 9E2F
  62+ 9E2F 71               ld (hl),c
  63+ 9E30
  64+ 9E30 79               ld a,c
  65+ 9E31
  66+ 9E31 23               inc hl
  67+ 9E32
  68+ 9E32 C1               pop bc
  69+ 9E33
  70+ 9E33 10 DE            djnz 3B
  71+ 9E35
  72+ 9E35 C9               ret
