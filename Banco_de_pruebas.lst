 297  8CAE              ;
 298  8CAE              ;
 299  8CAE 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8CAF              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
