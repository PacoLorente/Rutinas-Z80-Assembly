 962+ B040              ;   Estructura de un disparo de entidades.
 963+ B040
 964+ B040              ;   Disparo_1 defw 0                                ; Puntero objeto.
 965+ B040              ;   defw 0                                          ; Puntero de impresión.
 966+ B040              ;   defw 0                                          ; Control.
 967+ B040
 968+ B040              ;   El byte bajo de Control indica la velocidad a la que fué lanzado el disparo, (Velocidad)_
 969+ B040              ;   _de la entidad en el momento de disparar.
 970+ B040
 971+ B040              ;   El byte de control muestra la siguiente información:
 972+ B040
 973+ B040              ;   Nibble alto    ..... Bits (6) y (7) ..... Indican si el disparo va hacia la derecha o hacia la izquierda.
 974+ B040              ;
 975+ B040              ;                        10xx ..... Izquierda.
 976+ B040              ;                        01xx ..... Derecha.
 977+ B040              ;                        00xx ..... Recto.
 978+ B040
 979+ B040              Pinta_disparos_Entidades:
 980+ B040
 981+ B040 ED 73 B0 95      ld (Stack),sp
 982+ B044 ED 7B C2 95      ld sp,(Album_de_borrado_disparos_Entidades)
