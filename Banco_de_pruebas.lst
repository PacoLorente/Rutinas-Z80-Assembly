   1+ 9728              ; ******************************************************************************************************************************************************************************************
   2+ 9728              ;
   3+ 9728              ;   3/4/25
   4+ 9728              ;
   5+ 9728              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9728              ;   (XOR) bit a bit.
   7+ 9728              ;
   8+ 9728              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9728              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9728
  11+ 9728              Derivando_RND
  12+ 9728
  13+ 9728 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 972A C5               push bc
  15+ 972B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 972B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 972E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 972E
  19+ 972E A7           6 and a                                 ; Carry a "0".
  20+ 972F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9731 30 02            jr nc,1F
  22+ 9733
  23+ 9733 CB C1            set 0,c
  24+ 9735
  25+ 9735 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9736 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9738 5F               ld e,a
  28+ 9739
  29+ 9739 7A               ld a,d
  30+ 973A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 973C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 973E
  33+ 973E CB 3F            srl a
  34+ 9740
  35+ 9740 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9741
  37+ 9741 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9742 28 04            jr z,4F
  39+ 9744
  40+ 9744 CB FF            set 7,a
  41+ 9746 18 02            jr 5F
  42+ 9748
  43+ 9748 CB BF        4 res 7,a
  44+ 974A
  45+ 974A CB 21        5 sla c
  46+ 974C 10 E0            djnz 6B
  47+ 974E
  48+ 974E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 974F
  50+ 974F 77               ld (hl),a
