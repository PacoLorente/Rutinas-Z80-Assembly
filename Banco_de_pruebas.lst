 253  93AF              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 93AF
   2+ 93AF
   3+ 93AF              ;   07/07/23
   4+ 93AF              ;
   5+ 93AF              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 93AF              ;
   7+ 93AF              ;   Codificación:
   8+ 93AF              ;
   9+ 93AF              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 93AF              ;
  11+ 93AF              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 93AF              ;
  13+ 93AF              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 93AF              ;
  15+ 93AF              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 93AF              ;
  17+ 93AF              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 93AF              ;                               ..... %01000010 Vel_up 4
  19+ 93AF              ;                                               Vel_down 2
  20+ 93AF              ;                               ..... $42
  21+ 93AF              ;
  22+ 93AF              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 93AF              ;
  24+ 93AF              ;                               ..... %01000010 Vel_left 4
  25+ 93AF              ;                                               Vel_right 2
  26+ 93AF              ;                               ..... $42
  27+ 93AF              ;
  28+ 93AF              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 93AF              ;
  30+ 93AF              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 93AF              ;
  32+ 93AF              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 93AF              ;
  34+ 93AF              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 93AF              ;                                     $53
  36+ 93AF              ;
  37+ 93AF              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 93AF              ;
  39+ 93AF              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 93AF              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 93AF              ;
  42+ 93AF              ;                       Arriba ..... $81
  43+ 93AF              ;                       Arriba - izquierda ..... $a1
  44+ 93AF              ;                       Arriba - derecha ..... $91
  45+ 93AF              ;
  46+ 93AF              ;                       Abajo ..... $41
  47+ 93AF              ;                       Abajo - izquierda ..... $61
  48+ 93AF              ;                       Abajo - derecha ..... $51
  49+ 93AF              ;
  50+ 93AF              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 93AF              ;
  52+ 93AF              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 93AF              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 93AF              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 93AF              ;
  56+ 93AF              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 93AF              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 93AF              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 93AF              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 93AF              ;
  61+ 93AF              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 93AF              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 93AF              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 93AF              ;
  65+ 93AF              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 93AF              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 93AF              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 93AF              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 93AF
  70+ 93AF              ; ----- ----- ----- ----- -----
  71+ 93AF              ;
