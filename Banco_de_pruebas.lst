   1+ 9475              ; ******************************************************************************************************************************************************************************************
   2+ 9475              ;
   3+ 9475              ;   21/04/24
   4+ 9475              ;
   5+ 9475              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9475              ;   (XOR) bit a bit.
   7+ 9475              ;
   8+ 9475              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9475
  10+ 9475              Derivando_RND
  11+ 9475
  12+ 9475 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9478
  14+ 9478 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 947A C5               push bc
  16+ 947B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 947B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 947E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 947E
  20+ 947E A7           6 and a                                 ; Carry a "0".
  21+ 947F CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9481 30 02            jr nc,1F
  23+ 9483
  24+ 9483 CB C1            set 0,c
  25+ 9485
  26+ 9485 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9486 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9488 5F               ld e,a
  29+ 9489
  30+ 9489 7A               ld a,d
  31+ 948A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 948C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 948E
