 584+ A309 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A30B 6F               ld l,a
 586+ A30C D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A30D
 588+ A30D 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A30E D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A310 67               ld h,a
