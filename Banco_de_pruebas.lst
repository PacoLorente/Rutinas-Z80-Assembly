 447+ 9EDC              ;            (A) contiene los atributos.
 448+ 9EDC              ;            (B) contiene el nº de Columnas.
 449+ 9EDC              ;            (C) contiene el nº de Filas.
 450+ 9EDC              ;
 451+ 9EDC              ;   MODIFY: (HL), contendrá la dirección de attrs. del último char. de la imagen, (abajo-izq) + 1
 452+ 9EDC              ;            (C), contiene "0".
 453+ 9EDC              ;
 454+ 9EDC
 455+ 9EDC              Fija_attrs:
 456+ 9EDC
 457+ 9EDC C5               push bc
 458+ 9EDD
 459+ 9EDD 77           1 ld (hl),a
 460+ 9EDE 2C               inc l
