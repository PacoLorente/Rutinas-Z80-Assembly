 272+ 9E82              ;   NextScan.
 273+ 9E82              ;
 274+ 9E82              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 275+ 9E82              ;
 276+ 9E82              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 277+ 9E82              ;
 278+ 9E82              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 279+ 9E82              ;
 280+ 9E82              ;       DESTRUIDOS: AF y HL !!!
 281+ 9E82              ;
 282+ 9E82              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 283+ 9E82              ;
 284+ 9E82
 285+ 9E82              NextScan:
 286+ 9E82
 287+ 9E82 24           	inc h          							        ; Incrementamos el scanline.
 288+ 9E83 7C               ld a,h
 289+ 9E84 E6 07            and 7
 290+ 9E86 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 291+ 9E87
 292+ 9E87 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 293+ 9E88 C6 20            add a,$20           							; Vamos a comprobarlo...
 294+ 9E8A 6F               ld l,a
 295+ 9E8B D8               ret c               							; Salimos si se produce el cambio de tercio.
 296+ 9E8C
 297+ 9E8C 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 298+ 9E8D D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 299+ 9E8F 67               ld h,a
 300+ 9E90 C9               ret
