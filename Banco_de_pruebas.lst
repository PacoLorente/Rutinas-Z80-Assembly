1085+ C54D BE               cp (hl)
1086+ C54E 28 0B            jr z,Retrocede_carro
1087+ C550
1088+ C550 3E 21            ld a,$21                                                ; "ENTER" KEYCODE.
1089+ C552 BE               cp (hl)
1090+ C553 28 06            jr z,Retrocede_carro
1091+ C555
1092+ C555 3E 27            ld a,$27                                                ; "CAPS SHIFT" KEYCODE.
1093+ C557 BE               cp (hl)
1094+ C558 28 01            jr z,Retrocede_carro
