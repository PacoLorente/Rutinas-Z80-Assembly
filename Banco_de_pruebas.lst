 191  8EEE
 192  8EEE 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 193  8EEF              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 194  8EEF              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 195  8EEF              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 196  8EEF              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 197  8EEF
