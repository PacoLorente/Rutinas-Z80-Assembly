 299+ A9D0
 300+ A9D0 22 15 96     	ld (Puntero_de_almacen_de_mov_masticados),hl
 301+ A9D3
 302+ A9D3 C1           	pop bc
 303+ A9D4
 304+ A9D4 10 DA        	djnz 2B
 305+ A9D6
 306+ A9D6              ;	Hemos terminado de generar todas las estrellas.
