 317+ C0FE              ;   -------------------------------------------------------------------------------------------
 318+ C0FE              ;
 319+ C0FE              ;   23/9/26
 320+ C0FE              ;
 321+ C0FE              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 322+ C0FE              ;   _ Shield_sound_effect.
 323+ C0FE              ;
 324+ C0FE              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 325+ C0FE              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 326+ C0FE              ;
 327+ C0FE              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 328+ C0FE              ;
 329+ C0FE              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 330+ C0FE              ;
 331+ C0FE              ;   MODIFY: AF'y BC.
 332+ C0FE
 333+ C0FE              Play_Shield_sound_effect:
 334+ C0FE
 335+ C0FE 3A 5E 94         ld a,(Shield_sound)
 336+ C101 A7               and a
 337+ C102 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 338+ C103
 339+ C103 0E 02            ld c,2                  ; 2 ondas completas per frame.
 340+ C105
 341+ C105              Loop_3:
 342+ C105
 343+ C105 08               ex af,af
 344+ C106
 345+ C106 3E 10            ld a,%00010000          ; Black BORDER.
 346+ C108 D3 FE            out ($fe),a             ; Beeper ON.
 347+ C10A
 348+ C10A 08               ex af,af
 349+ C10B
 350+ C10B 47               ld b,a
 351+ C10C
 352+ C10C 10 FE        Delay_7 djnz Delay_7
 353+ C10E
 354+ C10E 08               ex af,af
 355+ C10F
 356+ C10F AF               xor a                   ; Black BORDER.
 357+ C110 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 358+ C112
 359+ C112 08               ex af,af
 360+ C113
 361+ C113 47               ld b,a
 362+ C114
 363+ C114 10 FE        Delay_8 djnz Delay_8
 364+ C116
 365+ C116 0D               dec c
 366+ C117
 367+ C117 20 EC            jr nz,Loop_3
 368+ C119
 369+ C119 AF               xor a
 370+ C11A 32 5E 94         ld (Shield_sound),a
 371+ C11D
 372+ C11D C9               ret
