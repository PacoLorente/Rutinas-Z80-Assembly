 121+ C07B              ; ----------------------------------------------------------------------------------------------
 122+ C07B              ;
 123+ C07B              ;   17/9/26
 124+ C07B              ;
 125+ C07B              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 126+ C07B              ;
 127+ C07B              ;   NO MODIFICA NINGÚN REGISTRO.
 128+ C07B
 129+ C07B              BEEP:
 130+ C07B
 131+ C07B F5               push af
 132+ C07C C5               push bc
 133+ C07D D5               push de
 134+ C07E E5               push hl                                 ; STORE Regs.
 135+ C07F
 136+ C07F              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 137+ C07F
 138+ C07F              ;   Configuración de un BEEP.
 139+ C07F
 140+ C07F              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 141+ C07F              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 142+ C07F              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 143+ C07F              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 144+ C07F              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 145+ C07F
 146+ C07F
 147+ C07F 01 02 00         ld bc,$0002
 148+ C082 11 00 00         ld de,0
 149+ C085 21 D0 00         ld hl,$00d0
 150+ C088
 151+ C088 22 56 94         ld (Sound),hl
 152+ C08B
 153+ C08B CD B2 9E         call Sound_Generator
 154+ C08E
 155+ C08E 21 00 00         ld hl,0
 156+ C091 22 56 94         ld (Sound),hl
 157+ C094
 158+ C094 E1               pop hl                                  ; RECOVERY Regs.
 159+ C095 D1               pop de
 160+ C096 C1               pop bc
 161+ C097 F1               pop af
 162+ C098
 163+ C098 C9               ret
 164+ C099
 165+ C099              ; ----- ----- ----- ----- -----
 166+ C099              ;
 167+ C099              ;   23/9/26
 168+ C099              ;
 169+ C099              ;   El efecto del disparo de Amadeus es de tipo descendente.
 170+ C099              ;
 171+ C099              ;   HL define el sonido.
 172+ C099              ;
 173+ C099              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 174+ C099              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 175+ C099              ;
 176+ C099              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 177+ C099              ;   _ escudo tienen prioridad sobre este efecto.
 178+ C099              ;
 179+ C099              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 180+ C099              ;
 181+ C099              ;   INPUTS: (Shot_sound) <> "0".
 182+ C099              ;
 183+ C099              ;   MODIFY: AF, HL y BC.
 184+ C099              ;
 185+ C099              ;   OUTPUT: (Shot_sound) actualizado.
 186+ C099
 187+ C099              Play_shot_sound_effect:
 188+ C099
 189+ C099              ;   Exclusiones:
 190+ C099
 191+ C099 2A 5B 94         ld hl,(Shot_sound)
 192+ C09C 7C               ld a,h
 193+ C09D B5               or l
 194+ C09E C8               ret z                   ; RET si no se ha producido disparo.
 195+ C09F
 196+ C09F 3A 2D 94         ld a,(Ctrl_6)
 197+ C0A2 CB 47            bit 0,a
 198+ C0A4 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 199+ C0A5
 200+ C0A5 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 201+ C0A7
 202+ C0A7              Loop_1:
 203+ C0A7
 204+ C0A7 3E 10            ld a,%00010000          ; Borde negro.
 205+ C0A9 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 206+ C0AB
 207+ C0AB 45               ld b,l
 208+ C0AC
 209+ C0AC 10 FE        Delay_3 djnz Delay_3
 210+ C0AE
 211+ C0AE AF               xor a                   ; Borde negro.
 212+ C0AF D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 213+ C0B1
 214+ C0B1 45               ld b,l
 215+ C0B2
 216+ C0B2 10 FE        Delay_4 djnz Delay_4
 217+ C0B4
 218+ C0B4              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 219+ C0B4
 220+ C0B4 2C               inc l
 221+ C0B5 2C               inc l
 222+ C0B6 2C               inc l
 223+ C0B7 2C               inc l
 224+ C0B8
 225+ C0B8 25               dec h
 226+ C0B9
 227+ C0B9 CC C3 C0         call z,Clean_shot_effect
 228+ C0BC
 229+ C0BC 0D               dec c
 230+ C0BD
 231+ C0BD 20 E8            jr nz,Loop_1
 232+ C0BF
 233+ C0BF 22 5B 94         ld (Shot_sound),hl
 234+ C0C2
 235+ C0C2 C9               ret
 236+ C0C3
 237+ C0C3              Clean_shot_effect:
 238+ C0C3
 239+ C0C3 21 00 00         ld hl,0
 240+ C0C6 0E 01            ld c,1
 241+ C0C8
 242+ C0C8 C9               ret
 243+ C0C9
 244+ C0C9              ;   -------------------------------------------------------------------------------------------
 245+ C0C9              ;
 246+ C0C9              ;   23/9/26
 247+ C0C9              ;
 248+ C0C9              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 249+ C0C9              ;
 250+ C0C9              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 251+ C0C9              ;   _ [Sound_Generator].
 252+ C0C9              ;
 253+ C0C9              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 254+ C0C9              ;
 255+ C0C9              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 256+ C0C9              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 257+ C0C9              ;
 258+ C0C9              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 259+ C0C9              ;
 260+ C0C9              ;   MODIFY: AF',AF, HL, DE y BC.
 261+ C0C9              ;
 262+ C0C9              ;   OUTPUT: Actualiza (Burst_sound).
 263+ C0C9
 264+ C0C9              Play_burst_sound_effect:
 265+ C0C9
 266+ C0C9              ;   Exclusiones:
 267+ C0C9
 268+ C0C9 3A 5D 94         ld a,(Burst_sound)
 269+ C0CC A7               and a
 270+ C0CD C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 271+ C0CE
 272+ C0CE 08               ex af,af
 273+ C0CF
 274+ C0CF 3A 2D 94         ld a,(Ctrl_6)
 275+ C0D2 CB 47            bit 0,a
 276+ C0D4 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 277+ C0D5
 278+ C0D5              ;   ----------------------
 279+ C0D5
 280+ C0D5 CB C7            set 0,a
 281+ C0D7 32 2D 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 282+ C0DA
 283+ C0DA 08               ex af,af                ; Restore (Burst_sound).
 284+ C0DB
 285+ C0DB 67               ld h,a
 286+ C0DC 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 287+ C0DE
 288+ C0DE E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 289+ C0DF
 290+ C0DF 22 56 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 291+ C0E2 0E 03            ld c,3
 292+ C0E4 CD EB 9E         call Noise_efect
 293+ C0E7
 294+ C0E7 D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 295+ C0E8
 296+ C0E8 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 297+ C0E9 94               sub h
 298+ C0EA
 299+ C0EA 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 300+ C0EC
 301+ C0EC 7C               ld a,h
 302+ C0ED 32 5D 94         ld (Burst_sound),a
 303+ C0F0
 304+ C0F0 C9               ret
 305+ C0F1
 306+ C0F1              Clean_burst_efect:
 307+ C0F1
 308+ C0F1 AF               xor a
 309+ C0F2 32 5D 94         ld (Burst_sound),a
 310+ C0F5
 311+ C0F5 3A 2D 94         ld a,(Ctrl_6)
 312+ C0F8 CB 87            res 0,a
 313+ C0FA 32 2D 94         ld (Ctrl_6),a
 314+ C0FD
 315+ C0FD C9               ret
