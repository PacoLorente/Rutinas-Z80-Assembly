1498+ B075              ;   Nota: El .db (Impacto) de la entidad implicada lo puso a "1" la rutina [Compara_coordenadas_X].
1499+ B075
1500+ B075 E1           5 pop hl
1501+ B076 C1               pop bc
1502+ B077
1503+ B077 21 D7 8D         ld hl,Impacto_Amadeus
1504+ B07A 36 01            ld (hl),1
1505+ B07C 21 DF 91         ld hl,Impacto2                                 ; Cuando se produce Colisión, RES el bit2 de (Impacto2) y_
1506+ B07F CB 96            res 2,(hl)                                     ; _ SET el bit3. El bit3 de (Impacto2) indica que hay contacto_
1507+ B081
1508+ B081 11 90 8B         ld de,Indice_Explosion_entidades
1509+ B084 2A E0 91         ld hl,(Entidad_sospechosa_de_colision)         ; Situamos el (Puntero_de_almacen_de_mov_masticados) de la entidad impactada en la primera palabra del índice de explosiones.
1510+ B087
1511+ B087 23               inc hl
1512+ B088 23               inc hl
1513+ B089 23               inc hl
1514+ B08A
1515+ B08A 73               ld (hl),e
1516+ B08B 23               inc hl
1517+ B08C 72               ld (hl),d
1518+ B08D
1519+ B08D              ; Situamos también el (Puntero_de_almacen_de_mov_masticados) de Amadeus en la primero explosión.
1520+ B08D
1521+ B08D 11 30 8C         ld de,Indice_Explosion_Amadeus
1522+ B090 21 DA 8D         ld hl,Pamm_Amadeus
1523+ B093
1524+ B093 73               ld (hl),e
1525+ B094 23               inc hl
1526+ B095 72               ld (hl),d
1527+ B096
1528+ B096 C9               ret
1529+ B097
1530+ B097
1531+ B097
1532+ B097
