 603  94B9
 604  94B9 00 00        Puntero_tabla_Random defw 0
 605  94BB 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 606  94BD 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 607  94BF 00 00        Puntero_indice_mov_bucle defw 0
 608  94C1              ;
 609  94C1              ;
 610  94C1 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 611  94C2              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 612  94C2              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 613  94C2
 614  94C2 00           Incrementa_puntero_backup db 0
 615  94C3 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 616  94C4              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 617  94C4
 618  94C4 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 619  94C5 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 620  94C6 00           Cola_de_desplazamiento db 0									; Este byte indica:
 621  94C7
 622  94C7              ;
 623  94C7              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 624  94C7              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 625  94C7              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 626  94C7              ;
 627  94C7              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 628  94C7              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 629  94C7              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 630  94C7              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 631  94C7              ;
 632  94C7              ;															;	"$ff" ..... Bucle infinito de repetición.
 633  94C7              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
