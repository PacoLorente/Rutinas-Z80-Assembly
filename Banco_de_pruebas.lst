 624+ B55B
 625+ B55B 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 626+ B55C D6 20            sub $20             							; Vamos a comprobarlo...
 627+ B55E 6F               ld l,a
