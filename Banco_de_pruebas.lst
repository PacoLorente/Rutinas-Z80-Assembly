 254+ A3FB              ;
 255+ A3FB              ; 	12/11/26
 256+ A3FB              ;
 257+ A3FB              ; 	Almacena en (A) uno de los 7 nº pseudo aleatorios generados, ($00-$ff) y avanza el puntero (RND_SP) a la posición de mem. del siguiente nº.
 258+ A3FB              ; 	Reiniciamos el puntero (RND_SP) a su posición inicial, 'Numeros_aleatorios' cuando este apunta a: 'Numeros_aleatorios+7'.
 259+ A3FB              ;
 260+ A3FB              ;	MODIFY: HL,DE,A
 261+ A3FB              ;
 262+ A3FB              ;	OUTPUTS: (A) contiene un Nº aleatorio. Actualiza el puntero de nº aleatorios (RND_SP).
 263+ A3FB              ;
 264+ A3FB              ;	Variables implicadas: (RND_SP).
 265+ A3FB
 266+ A3FB              Extrae_numero_aleatorio_y_avanza:
 267+ A3FB
 268+ A3FB 21 92 92     	ld hl,Numeros_aleatorios+7						; Dirección de memoria donde se almacena el último n° pseudo aleatorio generado +1.
 269+ A3FE ED 5B 91 96  	ld de,(RND_SP) 									; Puntero que se irá desplazando por el SET de nº aleatorios. Inicialmente apunta al 1°.
 270+ A402
 271+ A402              ;													; (HL) contiene la dirección del n° aleatorio que vamos a extraer.
 272+ A402              ;													; (DE)     "           "      "  último n° aleatorio +1, (detecta reinicio).
 273+ A402
 274+ A402 A7           	and a 											; Carry a "0".
 275+ A403
 276+ A403 ED 52        	sbc hl,de 										; Detecta el final de la caja de n° pseudo aleatorios.
 277+ A405 20 08        	jr nz,1F
 278+ A407
 279+ A407              ; 	Inicializa el puntero al principio de la caja de nº aleatorios pseudo aleatorios.
 280+ A407
 281+ A407 21 8B 92     	ld hl,Numeros_aleatorios
 282+ A40A 22 91 96     	ld (RND_SP),HL
 283+ A40D
 284+ A40D 18 01        	jr 2F
