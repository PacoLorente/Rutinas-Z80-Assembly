 327  8DC2              ;																DESCRIPCIÓN:
 328  8DC2              ;
 329  8DC2              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 330  8DC2              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 331  8DC2              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 332  8DC2              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 333  8DC2              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 334  8DC2              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 335  8DC2
 336  8DC2              ;																BIT 3, Recarga de nueva oleada.
 337  8DC2              ;																BIT 4, Recarga de nueva oleada.
 338  8DC2              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 339  8DC2              ;																BIT 6, **** Frame completo.
 340  8DC2              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 341  8DC2
 342  8DC2 00 00        Repone_puntero_objeto defw 0				; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 343  8DC4              ; 																; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 344  8DC4              ; 																; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 345  8DC4              ;																; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 346  8DC4
