   6+ 99AD
   7+ 99AD              Draw
   8+ 99AD
   9+ 99AD CD 0A 9C     	call Prepara_draw
  10+ 99B0 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 99B1 A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 99B2 28 05        	jr z,2F
  13+ 99B4
  14+ 99B4 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99B7 18 0C        	jr 1F
  16+ 99B9
  17+ 99B9              ;	Inicia entidad.
  18+ 99B9
  19+ 99B9 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99BC 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99BF CD 23 9B     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  22+ 99C2              ;													; _la esquina superior izquierda de la pantalla.
  23+ 99C2 CD AE A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  24+ 99C5
  25+ 99C5 3A F7 8B     1 ld a,(Ctrl_0)
  26+ 99C8 CB 6F        	bit 5,a
  27+ 99CA 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  28+ 99CC
  29+ 99CC CD 1A 9A     	call Comprueba_limite_horizontal
  30+ 99CF CD 63 9A     	call Comprueba_limite_vertical
  31+ 99D2
  32+ 99D2              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  33+ 99D2              ; -----------------------
  34+ 99D2              ; -----------------------
  35+ 99D2              ; -----------------------
  36+ 99D2
  37+ 99D2 CD 84 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  38+ 99D5 CD A8 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  39+ 99D8
  40+ 99D8 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina REStauramos el bit5 de Ctrl_0 para que nos vuelva_
  41+ 99DB CB AF        	res 5,a											; _a ser de utilidad.
  42+ 99DD 32 F7 8B     	ld (Ctrl_0),a
  43+ 99E0
  44+ 99E0 C9           	ret
