 545+ C183 08               ex af,af
 546+ C184
 547+ C184 AF               xor a                   ; Black BORDER.
 548+ C185 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 549+ C187
 550+ C187 08               ex af,af
 551+ C188
 552+ C188 47               ld b,a
 553+ C189
 554+ C189 10 FE        Delay_8 djnz Delay_8
 555+ C18B
 556+ C18B 0D               dec c
