 448  949C              ;															  _palabras que componen el "movimiento_masticado".
 449  949C
 450  949C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 451  949C
 452  949C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 453  949D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 454  949D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 455  949D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 456  949D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 457  949D
 458  949D 00           Attr db 0 													; Atributos de la entidad.
 459  949E
