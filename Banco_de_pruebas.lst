 261  9567              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 262  9567
 263  9567 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 264  9568              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 265  9568              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 266  9568              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 267  9568
 268  9568 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 269  9569              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 270  9569
 271  9569 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 272  956A              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 273  956A              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 274  956A
 275  956A              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 276  956A              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 277  956A
 278  956A              ; Ejemplos:
 279  956A
 280  956A              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 281  956A              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 282  956A              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 283  956A              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 284  956A              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 285  956A
 286  956A 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 287  956B              ;															  _ que esta entidad haya colisionado con Amadeus.
 288  956B              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 289  956B
 290  956B 00 00        Puntero_de_impresion defw 0									; Esta variable tiene dos funciones, la primera:
 291  956D              ;
 292  956D              ;															; Es utilizada por la rutina [Define_menu] para almacenar el puntero indicial: Define_menu_index_parameters.
 293  956D              ;
 294  956D              ;															; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 295  956D              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 296  956D
 297  956D 00 40        Puntero_de_almacen_de_mov_masticados defw Line_0
