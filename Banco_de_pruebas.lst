 782+ B5B8              ;
 783+ B5B8              ;   NextScan.
 784+ B5B8              ;
 785+ B5B8              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B5B8              ;
 787+ B5B8              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B5B8              ;
 789+ B5B8              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B5B8              ;
 791+ B5B8              ;       DESTRUIDOS: AF y HL !!!
 792+ B5B8              ;
 793+ B5B8              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B5B8              ;
 795+ B5B8
 796+ B5B8              NextScan:
 797+ B5B8
 798+ B5B8 24           	inc h          							; Incrementamos el scanline.
 799+ B5B9 7C               ld a,h
 800+ B5BA E6 07            and 7
 801+ B5BC C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B5BD
 803+ B5BD 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B5BE C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B5C0 6F               ld l,a
 806+ B5C1 D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B5C2
 808+ B5C2 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B5C3 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B5C5 67               ld h,a
 811+ B5C6 C9               ret
 812+ B5C7
