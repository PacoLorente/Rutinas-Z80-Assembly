 504+ C179              ;   -------------------------------------------------------------------------------------------
 505+ C179              ;
 506+ C179              ;   23/9/26
 507+ C179              ;
 508+ C179              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C179              ;   _ Shield_sound_effect.
 510+ C179              ;
 511+ C179              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C179              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C179              ;
 514+ C179              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C179              ;
 516+ C179              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C179              ;
 518+ C179              ;   MODIFY: AF'y BC.
 519+ C179
 520+ C179              Play_Shield_sound_effect:
 521+ C179
 522+ C179 3A 8C 94         ld a,(Shield_sound)
 523+ C17C A7               and a
 524+ C17D C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C17E
 526+ C17E 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C180
 528+ C180              Loop_3:
 529+ C180
 530+ C180 08               ex af,af
 531+ C181
 532+ C181 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C183 D3 FE            out ($fe),a             ; Beeper ON.
 534+ C185
 535+ C185 08               ex af,af
 536+ C186
 537+ C186 47               ld b,a
 538+ C187
 539+ C187 10 FE        Delay_7 djnz Delay_7
 540+ C189
 541+ C189 08               ex af,af
 542+ C18A
 543+ C18A AF               xor a                   ; Black BORDER.
 544+ C18B D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C18D
 546+ C18D 08               ex af,af
 547+ C18E
 548+ C18E 47               ld b,a
 549+ C18F
 550+ C18F 10 FE        Delay_8 djnz Delay_8
 551+ C191
 552+ C191 0D               dec c
 553+ C192
 554+ C192 20 EC            jr nz,Loop_3
 555+ C194
 556+ C194 AF               xor a
 557+ C195 32 8C 94         ld (Shield_sound),a
 558+ C198
 559+ C198 C9               ret
