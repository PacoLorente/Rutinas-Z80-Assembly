 547+ C190 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 548+ C192
 549+ C192 08               ex af,af
 550+ C193
 551+ C193 47               ld b,a
 552+ C194
 553+ C194 10 FE        Delay_8 djnz Delay_8
 554+ C196
 555+ C196 0D               dec c
