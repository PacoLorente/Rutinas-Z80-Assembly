   3+ 9727              ;   3/4/25
   4+ 9727              ;
   5+ 9727              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9727              ;   (XOR) bit a bit.
   7+ 9727              ;
   8+ 9727              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9727              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9727
  11+ 9727              Derivando_RND
  12+ 9727
  13+ 9727 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9729 C5               push bc
  15+ 972A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 972A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 972D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 972D
  19+ 972D A7           6 and a                                 ; Carry a "0".
  20+ 972E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9730 30 02            jr nc,1F
  22+ 9732
  23+ 9732 CB C1            set 0,c
  24+ 9734
  25+ 9734 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9735 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9737 5F               ld e,a
  28+ 9738
  29+ 9738 7A               ld a,d
  30+ 9739 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 973B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 973D
  33+ 973D CB 3F            srl a
  34+ 973F
  35+ 973F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9740
  37+ 9740 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9741 28 04            jr z,4F
  39+ 9743
  40+ 9743 CB FF            set 7,a
  41+ 9745 18 02            jr 5F
  42+ 9747
  43+ 9747 CB BF        4 res 7,a
  44+ 9749
  45+ 9749 CB 21        5 sla c
  46+ 974B 10 E0            djnz 6B
  47+ 974D
  48+ 974D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 974E
  50+ 974E 77               ld (hl),a
  51+ 974F 23               inc hl
  52+ 9750 C1               pop bc
  53+ 9751 10 D4            djnz 3B
  54+ 9753
  55+ 9753 C9               ret
  56+ 9754
  57+ 9754
  58+ 9754
