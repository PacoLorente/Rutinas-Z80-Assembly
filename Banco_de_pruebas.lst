 293+ 9EC4 C6 20            add a,$20           							; Vamos a comprobarlo...
 294+ 9EC6 6F               ld l,a
 295+ 9EC7 D8               ret c               							; Salimos si se produce el cambio de tercio.
 296+ 9EC8
 297+ 9EC8 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 298+ 9EC9 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
