 175+ C1D3              Make_Score_max_msg:
 176+ C1D3
 177+ C1D3              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 178+ C1D3
 179+ C1D3              ;   Necesito fabricar un msg. con la máxima puntuación.
 180+ C1D3              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 181+ C1D3
 182+ C1D3 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 183+ C1D6 21 7C 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 184+ C1D9              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 185+ C1D9 11 8B 94         ld de,Score_max_msg
 186+ C1DC
 187+ C1DC              KEY_CODE_de_BCD:
 188+ C1DC
 189+ C1DC 7E           1 ld a,(hl)
 190+ C1DD A7               and a
 191+ C1DE 20 07            jr nz,3F
 192+ C1E0
 193+ C1E0              ;   El dígito es "0".
 194+ C1E0
 195+ C1E0 0C               inc c
 196+ C1E1 0D               dec c
 197+ C1E2 20 03            jr nz,3F
 198+ C1E4
 199+ C1E4 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 200+ C1E5 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 201+ C1E7
 202+ C1E7 D5           3 push de                                    ; PUSH Score_max_msg.
 203+ C1E8
 204+ C1E8 11 9C 94         ld de,Non_authorized_KEY_CODES+2         ; KEY_CODE numbers list.
 205+ C1EB
 206+ C1EB A7               and a
 207+ C1EC 28 04            jr z,4F
 208+ C1EE
 209+ C1EE 13           2 inc de
 210+ C1EF 3D               dec a
 211+ C1F0 20 FC            jr nz,2B                                 ; Nos situamos en el KEY_CODE correspondiente a este dígito.
 212+ C1F2
 213+ C1F2 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 214+ C1F3
 215+ C1F3 D1               pop de                                   ; Score_max_msg en DE.
 216+ C1F4
 217+ C1F4 CD FD C1         call ASCII_CODE_de_KEYCODE
 218+ C1F7
 219+ C1F7 0C               inc c                                    ; Indica que a partir de ahora se imprimen todos los "0".
 220+ C1F8
 221+ C1F8              Next_digit:
 222+ C1F8
 223+ C1F8 13               inc de                                   ; Siguiente char del msg. que estamos creando.
