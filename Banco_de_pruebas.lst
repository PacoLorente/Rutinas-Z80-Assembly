 386+ C187
 387+ C187 45               ld b,l
 388+ C188
 389+ C188 10 FE        Delay_3 djnz Delay_3
 390+ C18A
 391+ C18A AF               xor a                   ; Borde negro.
 392+ C18B D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 393+ C18D
 394+ C18D 45               ld b,l
 395+ C18E
 396+ C18E 10 FE        Delay_4 djnz Delay_4
 397+ C190
 398+ C190              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 399+ C190
