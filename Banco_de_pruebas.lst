   3+ 9E4E              ;   6/11/26
   4+ 9E4E              ;
   5+ 9E4E              ;   Construyo un nº pseudo aleatorio. Método "DERIVANDO":
   6+ 9E4E              ;
   7+ 9E4E              ;   Inicialmente nuestra semilla será la contenida en el registro R. A partir de ahí irá mutando y la almacenaremos en la variable: (Semilla).
   8+ 9E4E              ;
   9+ 9E4E              ;   Para construir nuestro n° pseudo aleatorio necesitamos 8 bits que iremos adquiriendo del último bit, (bit_0) de la semilla.
  10+ 9E4E              ;
  11+ 9E4E              ;   Después de adquirir el bit de la semilla, desplazamos a la derecha los bits de la misma y realizamos una función lógica XOR entre los_
  12+ 9E4E              ;   _ bits 0 y 1, (los dos últimos).
  13+ 9E4E              ;
  14+ 9E4E              ;   Si el resultado de la operación XOR es "1" pondremos a "1" el bit_7 de la semilla. Si es "0" no realizamos cambios.
  15+ 9E4E              ;
  16+ 9E4E              ;   Desplazamos los bits del número que estamos generando una posición a la izquierda con el fin de adquirir un nuevo bit de la semilla.
  17+ 9E4E              ;
  18+ 9E4E              ;   Repetimos proceso hasta que hayamos adquirido los 8 bits necesarios de la semilla.
  19+ 9E4E              ;
  20+ 9E4E              ;   Guardamos la semilla en la variable (Semilla) y el número generado en (HL).
  21+ 9E4E              ;
  22+ 9E4E              ;   Incrementamos el puntero HL para situarlo en la siguiente dirección de memoria, (donde almacenaremos el siguiente n° pseudo aleatorio a generar).
  23+ 9E4E              ;
  24+ 9E4E              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
  25+ 9E4E              ;          HL contendrá la dirección de mem. donde vamos a almacenar el 1er n° de los (B) números pseudo aleatorios a generar.
  26+ 9E4E              ;
  27+ 9E4E              ;   MODIFY: (Semilla), AF, HL, DE y B.
  28+ 9E4E
  29+ 9E4E              Derivando_RND:
  30+ 9E4E
  31+ 9E4E              ;   En 1er lugar comprobamos si disponemos de semilla.
  32+ 9E4E
  33+ 9E4E 3A 98 96         ld a,(Semilla)
  34+ 9E51
  35+ 9E51 A7               and a
  36+ 9E52
  37+ 9E52 20 02            jr nz,Semilla_iniciada
  38+ 9E54
  39+ 9E54              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  40+ 9E54 ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  41+ 9E56
  42+ 9E56              Semilla_iniciada:
  43+ 9E56
  44+ 9E56 57               ld d,a                              ; A partir de ahora, (D) contendrá nuestra semilla.
  45+ 9E57
  46+ 9E57 C5               push bc                             ; PUSH N° de números que queremos generar.
  47+ 9E58
  48+ 9E58 01 00 08         ld bc,$0800                         ; C contendrá nuestro nº aleatorio: ($0 - $ff). Inicialmente está a "0".
  49+ 9E5B              ;                                       ; B actuará como contador de bits, (números de bits a generar), 8 bits.
  50+ 9E5B
  51+ 9E5B CB 21        3 sla c                                 ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  52+ 9E5D
  53+ 9E5D 7A               ld a,d
  54+ 9E5E
  55+ 9E5E              ;   El último bit de la semilla, (bit_0) será el 1° del número pseudo aleatorio generado, (bit_7).
  56+ 9E5E
  57+ 9E5E E6 01            and %00000001
  58+ 9E60
  59+ 9E60 28 02            jr z,4F
  60+ 9E62
  61+ 9E62 CB C1            set 0,c                             ; One bit generated.
  62+ 9E64
  63+ 9E64              ;   Rotamos los bits de la semilla una posición a la derecha.
  64+ 9E64
  65+ 9E64 CB 1A        4  rr d                                 ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  66+ 9E66
  67+ 9E66 7A               ld a,d
  68+ 9E67
  69+ 9E67              Xor_bit_1_bit_2:
  70+ 9E67
  71+ 9E67 E6 01            and %00000001                       ; Bit_0 en (E).
  72+ 9E69 5F               ld e,a
  73+ 9E6A
  74+ 9E6A 7A               ld a,d
  75+ 9E6B E6 02            and %00000010                       ; Bit_1 en (A).
  76+ 9E6D
  77+ 9E6D 28 02            jr z,1F
  78+ 9E6F
  79+ 9E6F 3E 01            ld a,1
  80+ 9E71
  81+ 9E71 AB           1 xor e
  82+ 9E72
  83+ 9E72              ;   FUNCIÓN XOR entre el bit_0 y el bit_1 de la semilla después de una rotación de 1 bit a la derecha.
  84+ 9E72
  85+ 9E72              ;   0 0 ..... 0
  86+ 9E72              ;   0 1 ..... 1
  87+ 9E72              ;   1 0 ..... 1
  88+ 9E72              ;   1 1 ..... 0
  89+ 9E72
  90+ 9E72 28 02            jr z,2F
  91+ 9E74
  92+ 9E74 CB FA            set 7,d                             ; Cuando la función XOR entre los dos últimos bits de la semilla resulta "1",_
  93+ 9E76              ;                                       ; _ seteamos a "1" el bit_7 de la misma.
  94+ 9E76
  95+ 9E76 10 E3        2 djnz 3B
  96+ 9E78
  97+ 9E78              Number_generated:
  98+ 9E78
  99+ 9E78 7A               ld a,d
 100+ 9E79
 101+ 9E79 32 98 96         ld (Semilla),a                      ; Guarda la evolución de la semilla para seguir generando números.
 102+ 9E7C
 103+ 9E7C 71               ld (hl),c                           ; Guardamos el número pseudo aleatorio generado en su correspondiente dirección de memoria.
 104+ 9E7D
 105+ 9E7D 23               inc hl                              ; HL apunta a la dirección de memoria donde vamos a guardar el siguiente número a generar.
 106+ 9E7E
 107+ 9E7E C1               pop bc
 108+ 9E7F
 109+ 9E7F 10 CD            djnz Derivando_RND
