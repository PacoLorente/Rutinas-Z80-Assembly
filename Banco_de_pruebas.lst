   5+ 9D51              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D51              ;   (XOR) bit a bit.
   7+ 9D51              ;
   8+ 9D51              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D51              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D51
  11+ 9D51              Derivando_RND
  12+ 9D51
  13+ 9D51 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D53 C5               push bc
  15+ 9D54              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D54 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D57              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D57
  19+ 9D57 A7           6 and a                                 ; Carry a "0".
  20+ 9D58 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D5A 30 02            jr nc,1F
  22+ 9D5C
  23+ 9D5C CB C1            set 0,c
  24+ 9D5E
  25+ 9D5E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D5F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D61 5F               ld e,a
  28+ 9D62
  29+ 9D62 7A               ld a,d
  30+ 9D63 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D65 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D67
  33+ 9D67 CB 3F            srl a
  34+ 9D69
  35+ 9D69 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D6A
  37+ 9D6A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D6B 28 04            jr z,4F
  39+ 9D6D
  40+ 9D6D CB FF            set 7,a
  41+ 9D6F 18 02            jr 5F
  42+ 9D71
  43+ 9D71 CB BF        4 res 7,a
  44+ 9D73
  45+ 9D73 CB 21        5 sla c
  46+ 9D75 10 E0            djnz 6B
  47+ 9D77
  48+ 9D77 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D78
  50+ 9D78 77               ld (hl),a
  51+ 9D79 23               inc hl
  52+ 9D7A C1               pop bc
  53+ 9D7B 10 D4            djnz 3B
