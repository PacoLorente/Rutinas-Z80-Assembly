   1+ A1DA              ; ******************************************************************************************************************************************************************************************
   2+ A1DA              ;
   3+ A1DA              ;   3/4/25
   4+ A1DA              ;
   5+ A1DA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A1DA              ;   (XOR) bit a bit.
   7+ A1DA              ;
   8+ A1DA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A1DA              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A1DA
  11+ A1DA              Derivando_RND
  12+ A1DA
  13+ A1DA ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A1DC C5               push bc
  15+ A1DD              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A1DD 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A1E0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A1E0
  19+ A1E0 A7           6 and a                                 ; Carry a "0".
  20+ A1E1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A1E3 30 02            jr nc,1F
  22+ A1E5
  23+ A1E5 CB C1            set 0,c
  24+ A1E7
  25+ A1E7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A1E8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A1EA 5F               ld e,a
  28+ A1EB
  29+ A1EB 7A               ld a,d
  30+ A1EC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A1EE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A1F0
  33+ A1F0 CB 3F            srl a
  34+ A1F2
  35+ A1F2 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A1F3
  37+ A1F3 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A1F4 28 04            jr z,4F
  39+ A1F6
  40+ A1F6 CB FF            set 7,a
  41+ A1F8 18 02            jr 5F
  42+ A1FA
  43+ A1FA CB BF        4 res 7,a
  44+ A1FC
  45+ A1FC CB 21        5 sla c
  46+ A1FE 10 E0            djnz 6B
  47+ A200
  48+ A200 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A201
  50+ A201 77               ld (hl),a
  51+ A202 23               inc hl
  52+ A203 C1               pop bc
  53+ A204 10 D4            djnz 3B
  54+ A206
  55+ A206 C9               ret
  56+ A207
  57+ A207
  58+ A207
# file closed: RND_Derivando.asm
