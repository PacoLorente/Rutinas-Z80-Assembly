 352+ C18C              ; ----- ----- ----- ----- -----
 353+ C18C              ;
 354+ C18C              ;   23/9/26
 355+ C18C              ;
 356+ C18C              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C18C              ;
 358+ C18C              ;   HL define el sonido.
 359+ C18C              ;
 360+ C18C              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C18C              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C18C              ;
 363+ C18C              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C18C              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C18C              ;
 366+ C18C              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C18C              ;
 368+ C18C              ;   INPUTS: (Shot_sound) <> "0".
 369+ C18C              ;
 370+ C18C              ;   MODIFY: AF, HL y BC.
 371+ C18C              ;
 372+ C18C              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C18C
 374+ C18C              Play_shot_sound_effect:
 375+ C18C
 376+ C18C              ;   Exclusiones:
 377+ C18C
 378+ C18C 2A AB 96         ld hl,(Shot_sound)
 379+ C18F 7C               ld a,h
 380+ C190 B5               or l
 381+ C191 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C192
 383+ C192 3A 7E 96         ld a,(Ctrl_6)
 384+ C195 CB 47            bit 0,a
 385+ C197 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C198
 387+ C198 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C19A
 389+ C19A              Loop_1:
 390+ C19A
 391+ C19A 3E 10            ld a,%00010000          ; Borde negro.
 392+ C19C D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C19E
 394+ C19E 45               ld b,l
 395+ C19F
 396+ C19F 10 FE        Delay_3 djnz Delay_3
 397+ C1A1
 398+ C1A1 AF               xor a                   ; Borde negro.
 399+ C1A2 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C1A4
 401+ C1A4 45               ld b,l
 402+ C1A5
 403+ C1A5 10 FE        Delay_4 djnz Delay_4
