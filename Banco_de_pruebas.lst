 664+ 9F51              ;   Find char. data.
 665+ 9F51              ;
 666+ 9F51              ;   INPUT: (HL) contiene el código ASCII del char. a imprimir.
 667+ 9F51              ;
 668+ 9F51              ;   MODIFY: HL y BC.
 669+ 9F51
 670+ 9F51              ;   OUTPUT: HL contendrá la dirección de memoria ROM donde se encuentran los 8 bytes que forman el caracter.
 671+ 9F51
 672+ 9F51
 673+ 9F51              Find_address:
 674+ 9F51
 675+ 9F51 01 00 3C         ld bc,ROM_ASCII
