 583+ ACC0 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ ACC1 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ ACC3 6F               ld l,a
 586+ ACC4 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ ACC5
 588+ ACC5 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ ACC6 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ ACC8 67               ld h,a
 591+ ACC9 C9               ret
