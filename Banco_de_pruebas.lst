 187+ C1D3              KEY_CODE_de_BCD:
 188+ C1D3
 189+ C1D3 7E           1 ld a,(hl)
 190+ C1D4 A7               and a
 191+ C1D5 20 07            jr nz,3F
 192+ C1D7
 193+ C1D7              ;   El dígito es "0".
 194+ C1D7
