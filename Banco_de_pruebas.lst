 582+ B1C5
 583+ B1C5 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1C6 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1C8 6F               ld l,a
 586+ B1C9 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1CA
 588+ B1CA 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1CB D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1CD 67               ld h,a
 591+ B1CE C9               ret
