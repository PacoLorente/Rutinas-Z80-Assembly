 533  94EA              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 534  94EA
 535  94EA 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 536  94EB 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 537  94EC 00           Cola_de_desplazamiento db 0									; Este byte indica:
 538  94ED
 539  94ED              ;
 540  94ED              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 541  94ED              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 542  94ED              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 543  94ED              ;
 544  94ED              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 545  94ED              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 546  94ED              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 547  94ED              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 548  94ED              ;
 549  94ED              ;															;	"$ff" ..... Bucle infinito de repetición.
 550  94ED              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 551  94ED              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 552  94ED
 553  94ED 00           Ctrl_1 db 0 												; Byte de control de propósito general.
