 486  9409              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 487  9409
 488  9409 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 489  940B              ;															  _palabras que componen el "movimiento_masticado".
 490  940B
 491  940B              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 492  940B
 493  940B 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 494  940C              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 495  940C              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 496  940C              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 497  940C              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 498  940C
 499  940C 00           Attr db 0 													; Atributos de la entidad.
