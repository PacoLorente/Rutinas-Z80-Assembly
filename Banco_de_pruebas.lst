 319  90D2              ;
 320  90D2              ;
 321  90D2 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 322  90D3              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 323  90D3              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
