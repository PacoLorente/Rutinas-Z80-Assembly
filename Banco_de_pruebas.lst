 582+ A758
 583+ A758 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A759 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A75B 6F               ld l,a
 586+ A75C D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A75D
 588+ A75D 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A75E D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A760 67               ld h,a
 591+ A761 C9               ret
