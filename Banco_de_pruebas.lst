 153  8C67              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 154  8C67
 155  8C67 00           Tipo db 0												; Clase de la entidad. Cada `tipo´ de Entidad tiene unas características únicas que lo distinguen de otros tipos:
 156  8C68              ;															- Patrón de movimiento.
 157  8C68 00           Coordenada_X db 0 										; Coordenada X del objeto. (En chars.)
 158  8C69 00           Coordenada_y db 0 										; Coordenada Y del objeto. (En chars.)
 159  8C6A
 160  8C6A 00           Contador_de_vueltas db 0								; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición a la izquierda cada vez que la entidad_
 161  8C6B              ;														; _desaparece por la parte baja de la pantalla. Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 162  8C6B
 163  8C6B              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 164  8C6B              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 165  8C6B              ; Ejemplos.
 166  8C6B
 167  8C6B              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 168  8C6B              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 169  8C6B              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 170  8C6B              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 171  8C6B              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 172  8C6B
 173  8C6B 00           Impacto db 0											; Si después del movimiento de la entidad, (Impacto) se coloca a "1",_
 174  8C6C              ;														; _ existen muchas posibilidades de que esta entidad haya colisionado con Amadeus.
 175  8C6C              ; 														; Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 176  8C6C
 177  8C6C 00 00        Puntero_de_impresion defw 0								; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 178  8C6E              ;														; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 179  8C6E
 180  8C6E 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 181  8C70
 182  8C70              ;	Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 183  8C70
 184  8C70 00 00        Contador_de_mov_masticados defw 0						; Contador de 16bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 185  8C72              ;														; _palabras que componen el "movimiento_masticado".
 186  8C72
 187  8C72              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 188  8C72
 189  8C72 00           Velocidad db 0 											; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 190  8C73              ;																						 2 - 0 (2ª vuelta - velocidad 0)
 191  8C73              ;																						 4 - 1 (3ª vuelta - velocidad 1)
 192  8C73              ;																						 8 - 2 (4ª vuelta - velocidad 2)
 193  8C73              ;																					   $10 - 4 (5ª vuelta - velocidad 3)
 194  8C73
 195  8C73 00           Attr db 0 												; Atributos de la entidad.
 196  8C74
 197  8C74 00           Ctrl_2 db 0
 198  8C75              ;														BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 199  8C75              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 200  8C75              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 201  8C75              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 202  8C75              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 203  8C75              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 204  8C75              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 205  8C75              ;
 206  8C75              ;														BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 207  8C75              ;														BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 208  8C75              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 209  8C75              ;														BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 210  8C75              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 211  8C75              ;														BIT 4, ???
 212  8C75              ;														BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 213  8C75
 214  8C75 00           Ctrl_0 db 0 											; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 215  8C76              ;														; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 216  8C76              ; 														; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer´ por el contrario.
 217  8C76              ; 														; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 218  8C76              ; 														; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición´ por un extremo del cuadrante y la `reaparición´ por el otro.
 219  8C76              ;
 220  8C76              ; 														DESCRIPCIÖN:
 221  8C76              ;
 222  8C76              ; 														SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido´ por el_
 223  8C76              ; 																_lado izquierdo de la pantalla y ha de `reaparecer´ por el derecho. ([Comprueba_limite_vertical]).
 224  8C76              ; 														SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido´ por el_
 225  8C76              ; 																_lado derecho de la pantalla y ha de `reaparecer´ por el izquierdo. ([Comprueba_limite_vertical]).
 226  8C76              ; 														SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido´ por la_
 227  8C76              ; 																_parte superior de la pantalla y ha de `reaparecer´ por el inferior. ([Comprueba_limite_horizontal]).
 228  8C76              ; 														SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido´ por la_
 229  8C76              ; 																_parte inferior de la pantalla y ha de `reaparecer´ por la superior. ([Comprueba_limite_horizontal]).
 230  8C76              ; 														SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 231  8C76              ;												                _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 232  8C76              ;														SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 233  8C76              ;																_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar´ un objeto.
 234  8C76              ; 														SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine´ es AMADEUS.
 235  8C76              ;
 236  8C76              ; 														SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 237  8C76              ; 															   _ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 238  8C76              ; 															   _ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 239  8C76
