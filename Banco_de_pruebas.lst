   3+ A54A              ;
   4+ A54A              ;	CLS.
   5+ A54A              ;
   6+ A54A              ;	Limpia la pantalla y define sus atributos.
   7+ A54A              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A54A              ;
   9+ A54A              ;	COLORES: 0 ..... NEGRO
  10+ A54A              ;    		 1 ..... AZUL
  11+ A54A              ; 			 2 ..... ROJO
  12+ A54A              ;			 3 ..... MAGENTA
  13+ A54A              ; 			 4 ..... VERDE
  14+ A54A              ; 			 5 ..... CIAN
  15+ A54A              ;			 6 ..... AMARILLO
  16+ A54A              ; 			 7 ..... BLANCO
  17+ A54A              ;
  18+ A54A              ;	INPUT: A contiene los atributos de pantalla.
  19+ A54A              ;
  20+ A54A              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A54A
  22+ A54A
  23+ A54A 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A54D 11 01 40     	LD DE,$4001
  25+ A550 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
