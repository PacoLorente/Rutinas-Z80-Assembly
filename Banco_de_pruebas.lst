   5+ 9969              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9969              ;   (XOR) bit a bit.
   7+ 9969              ;
   8+ 9969              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9969              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9969
  11+ 9969              Derivando_RND
  12+ 9969
  13+ 9969 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 996B C5               push bc
  15+ 996C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 996C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 996F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 996F
  19+ 996F A7           6 and a                                 ; Carry a "0".
  20+ 9970 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9972 30 02            jr nc,1F
  22+ 9974
  23+ 9974 CB C1            set 0,c
  24+ 9976
  25+ 9976 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9977 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9979 5F               ld e,a
  28+ 997A
  29+ 997A 7A               ld a,d
  30+ 997B E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 997D 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 997F
  33+ 997F CB 3F            srl a
  34+ 9981
  35+ 9981 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9982
  37+ 9982 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9983 28 04            jr z,4F
  39+ 9985
  40+ 9985 CB FF            set 7,a
  41+ 9987 18 02            jr 5F
  42+ 9989
  43+ 9989 CB BF        4 res 7,a
  44+ 998B
  45+ 998B CB 21        5 sla c
  46+ 998D 10 E0            djnz 6B
  47+ 998F
  48+ 998F 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9990
  50+ 9990 77               ld (hl),a
  51+ 9991 23               inc hl
  52+ 9992 C1               pop bc
  53+ 9993 10 D4            djnz 3B
  54+ 9995
  55+ 9995 C9               ret
  56+ 9996
  57+ 9996
  58+ 9996
