   6+ A4EA              ;	Limpia la pantalla y define sus atributos.
   7+ A4EA              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A4EA              ;
   9+ A4EA              ;	COLORES: 0 ..... NEGRO
  10+ A4EA              ;    		 1 ..... AZUL
  11+ A4EA              ; 			 2 ..... ROJO
  12+ A4EA              ;			 3 ..... MAGENTA
  13+ A4EA              ; 			 4 ..... VERDE
  14+ A4EA              ; 			 5 ..... CIAN
  15+ A4EA              ;			 6 ..... AMARILLO
  16+ A4EA              ; 			 7 ..... BLANCO
  17+ A4EA              ;
  18+ A4EA              ;	INPUT: A contiene los atributos de pantalla.
  19+ A4EA              ;
  20+ A4EA              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A4EA
  22+ A4EA
  23+ A4EA 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A4ED 11 01 40     	LD DE,$4001
  25+ A4F0 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A4F3 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A4F5 ED B0        	LDIR
  28+ A4F7 01 FF 02     	LD BC,767
  29+ A4FA 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A4FB ED B0        	LDIR
  31+ A4FD
  32+ A4FD AF           	xor a
  33+ A4FE
  34+ A4FE C9           	ret
  35+ A4FF
