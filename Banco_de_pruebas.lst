 641  942C 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 642  942E 00 00        Puntero_indice_mov_bucle defw 0
 643  9430              ;
 644  9430              ;
 645  9430 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 646  9431              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
