 384  92BB 00 00        Puntero_tabla_Random defw 0
 385  92BD 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 386  92BF 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 387  92C1 00 00        Puntero_indice_mov_bucle defw 0
 388  92C3              ;
 389  92C3              ;
 390  92C3 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 391  92C4              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 392  92C4              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 393  92C4
 394  92C4 00           Incrementa_puntero_backup db 0
 395  92C5 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 396  92C6              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 397  92C6
 398  92C6 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 399  92C7 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 400  92C8 00           Cola_de_desplazamiento db 0									; Este byte indica:
 401  92C9
 402  92C9              ;
 403  92C9              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 404  92C9              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 405  92C9              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 406  92C9              ;
 407  92C9              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 408  92C9              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 409  92C9              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 410  92C9              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 411  92C9              ;
 412  92C9              ;															;	"$ff" ..... Bucle infinito de repetición.
 413  92C9              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
