 579+ B3BF              ;       DESTRUIDOS: AF y HL !!!
 580+ B3BF              ;
 581+ B3BF              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 582+ B3BF              ;
 583+ B3BF
 584+ B3BF              NextScan:
 585+ B3BF
 586+ B3BF 24           	inc h          							; Incrementamos el scanline.
 587+ B3C0 7C               ld a,h
 588+ B3C1 E6 07            and 7
 589+ B3C3 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 590+ B3C4
 591+ B3C4 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B3C5 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B3C7 6F               ld l,a
 594+ B3C8 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B3C9
 596+ B3C9 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B3CA D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B3CC 67               ld h,a
 599+ B3CD C9               ret
 600+ B3CE
