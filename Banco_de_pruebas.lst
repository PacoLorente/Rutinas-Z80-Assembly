 614+ A727
 615+ A727 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ A728 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ A72A 6F               ld l,a
