 587+ 9F0C
 588+ 9F0C 08               ex af,af                                ;   Attr. en A´.
 589+ 9F0D
 590+ 9F0D E5               push hl
 591+ 9F0E D5               push de
 592+ 9F0F
 593+ 9F0F CD 48 9F         call Find_address
