3117  A218              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A218              ; ******************************************************************************************************************************************************************************************
   2+ A218              ;
   3+ A218              ;   3/4/25
   4+ A218              ;
   5+ A218              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A218              ;   (XOR) bit a bit.
   7+ A218              ;
   8+ A218              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A218              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A218
  11+ A218              Derivando_RND
  12+ A218
  13+ A218 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A21A C5               push bc
  15+ A21B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A21B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A21E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A21E
  19+ A21E A7           6 and a                                 ; Carry a "0".
  20+ A21F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A221 30 02            jr nc,1F
  22+ A223
  23+ A223 CB C1            set 0,c
  24+ A225
  25+ A225 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A226 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A228 5F               ld e,a
  28+ A229
  29+ A229 7A               ld a,d
  30+ A22A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A22C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A22E
  33+ A22E CB 3F            srl a
  34+ A230
  35+ A230 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A231
  37+ A231 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A232 28 04            jr z,4F
  39+ A234
  40+ A234 CB FF            set 7,a
  41+ A236 18 02            jr 5F
  42+ A238
  43+ A238 CB BF        4 res 7,a
  44+ A23A
  45+ A23A CB 21        5 sla c
  46+ A23C 10 E0            djnz 6B
  47+ A23E
  48+ A23E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A23F
  50+ A23F 77               ld (hl),a
  51+ A240 23               inc hl
  52+ A241 C1               pop bc
  53+ A242 10 D4            djnz 3B
  54+ A244
  55+ A244 C9               ret
  56+ A245
  57+ A245
  58+ A245
# file closed: RND_Derivando.asm
