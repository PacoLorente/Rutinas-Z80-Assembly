 241  8C50 00           Columns db 0 	  										; Nº de columnas. [DRAW]
 242  8C51 00 00        Posicion_actual defw 0									; Dirección actual del Sprite. [DRAW]
 243  8C53 00 00        Puntero_objeto defw 0									; Donde están los datos para pintar el Sprite.
 244  8C55
 245  8C55              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
