 351  9197
 352  9197 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 353  9198 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 354  9199 00           Cola_de_desplazamiento db 0									; Este byte indica:
 355  919A
 356  919A              ;
 357  919A              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 358  919A              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 359  919A              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 360  919A              ;
 361  919A              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 362  919A              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 363  919A              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 364  919A              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 365  919A              ;
 366  919A              ;															;	"$ff" ..... Bucle infinito de repetición.
 367  919A              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 368  919A              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 369  919A
