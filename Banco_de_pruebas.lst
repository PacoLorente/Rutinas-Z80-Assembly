   1+ 949A              ; ******************************************************************************************************************************************************************************************
   2+ 949A              ;
   3+ 949A              ;   3/4/25
   4+ 949A              ;
   5+ 949A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 949A              ;   (XOR) bit a bit.
   7+ 949A              ;
   8+ 949A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 949A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 949A
  11+ 949A              Derivando_RND
  12+ 949A
  13+ 949A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 949C C5               push bc
  15+ 949D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 949D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94A0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94A0
  19+ 94A0 A7           6 and a                                 ; Carry a "0".
  20+ 94A1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94A3 30 02            jr nc,1F
  22+ 94A5
  23+ 94A5 CB C1            set 0,c
