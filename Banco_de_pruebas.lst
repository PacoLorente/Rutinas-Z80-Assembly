   1+ 9E6B              ; ******************************************************************************************************************************************************************************************
   2+ 9E6B              ;
   3+ 9E6B              ;   3/4/25
   4+ 9E6B              ;
   5+ 9E6B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E6B              ;   (XOR) bit a bit.
   7+ 9E6B              ;
   8+ 9E6B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E6B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E6B
  11+ 9E6B              Derivando_RND
  12+ 9E6B
  13+ 9E6B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9E6D C5               push bc
  15+ 9E6E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9E6E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9E71              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9E71
  19+ 9E71 A7           6 and a                                 ; Carry a "0".
  20+ 9E72 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9E74 30 02            jr nc,1F
  22+ 9E76
  23+ 9E76 CB C1            set 0,c
  24+ 9E78
  25+ 9E78 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9E79 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9E7B 5F               ld e,a
  28+ 9E7C
  29+ 9E7C 7A               ld a,d
  30+ 9E7D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9E7F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9E81
  33+ 9E81 CB 3F            srl a
  34+ 9E83
  35+ 9E83 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9E84
  37+ 9E84 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9E85 28 04            jr z,4F
  39+ 9E87
  40+ 9E87 CB FF            set 7,a
  41+ 9E89 18 02            jr 5F
  42+ 9E8B
  43+ 9E8B CB BF        4 res 7,a
  44+ 9E8D
  45+ 9E8D CB 21        5 sla c
  46+ 9E8F 10 E0            djnz 6B
  47+ 9E91
  48+ 9E91 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9E92
  50+ 9E92 77               ld (hl),a
  51+ 9E93 23               inc hl
  52+ 9E94 C1               pop bc
  53+ 9E95 10 D4            djnz 3B
  54+ 9E97
  55+ 9E97 C9               ret
  56+ 9E98
  57+ 9E98
  58+ 9E98
# file closed: RND_Derivando.asm
