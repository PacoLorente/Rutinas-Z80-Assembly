  47+ 998C              ;	21/01/23
  48+ 998C              ;
  49+ 998C              ; 	Comprueba_limite_horizontal.
  50+ 998C              ;
  51+ 998C              ;	La rutina comprueba si hemos sobrepasado el (Limite_horizontal) definido en la rutina [Inicializacion]. Este será:_
  52+ 998C              ;	_ $4fc0 si partimos de los cuadrantes 1 o 2 de pantalla o $4820 si partimos de los cuadrantes 3 o 4.
  53+ 998C              ;
  54+ 998C              ;	Si sobrepasamos o alcanzamos el límite horizontal establecido, la rutina cargará el registro E con un "1".
  55+ 998C              ;	Si NO HEMOS SOBREPASADO (Limite_horizontal), E="0".
  56+ 998C              ;	E="1" indica que HEMOS SOBREPASADO el (Limite_horizontal).
  57+ 998C              ;	E="2" indica que NO HEMOS SOBREPASADO el (Limite_horizontal) pero hemos alcanzado o superado EL CENTRO DE PANTALLA.
  58+ 998C
  59+ 998C
  60+ 998C
  61+ 998C 3A F7 8B     Comprueba_limite_horizontal ld a,(Ctrl_0)          	; Si no hemos desaparecido por arriba o por abajo, saltamos a 1F para comprobar_
  62+ 998F CB 57        	bit 2,a                                         ; _si hemos llegado o sobrepasado (Limite_horizontal). Seguimos con la rutina.
  63+ 9991 28 07        	jr z,1F                                         ; Si por el contrario hemos desaparecido por arriba o por abajo, (bit2/bit3 de (Ctrl_0)="1"))_
  64+ 9993 E6 FB        	and $fb 										; _hay que modificar el puntero de posición. (E="1" y salimos de la rutina). Antes inicializaremos los_
  65+ 9995 32 F7 8B     	ld (Ctrl_0),a 									; _ bits 2 y 3 de (Ctrl_0).
  66+ 9998 18 09            jr 6F
  67+ 999A CB 5F        1 bit 3,a
  68+ 999C 28 0A            jr z,2F
  69+ 999E E6 F7            and $f7
