 188+ C994
 189+ C994 7E           1 ld a,(hl)
 190+ C995 A7               and a
 191+ C996 20 07            jr nz,3F
 192+ C998
 193+ C998              ;   El dígito es "0".
 194+ C998
 195+ C998 0C               inc c
 196+ C999 0D               dec c
 197+ C99A 20 03            jr nz,3F
 198+ C99C
 199+ C99C 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 200+ C99D 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 201+ C99F
 202+ C99F D5           3 push de                                    ; PUSH Score_max_msg.
