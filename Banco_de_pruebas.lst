 565+ ABBB              ;   NextScan.
 566+ ABBB              ;
 567+ ABBB              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ ABBB              ;
 569+ ABBB              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ ABBB              ;
 571+ ABBB              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ ABBB              ;
 573+ ABBB              ;       DESTRUIDOS: AF y HL !!!
 574+ ABBB              ;
 575+ ABBB              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ ABBB              ;
 577+ ABBB
 578+ ABBB 24           NextScan inc h          							; Incrementamos el scanline.
 579+ ABBC 7C               ld a,h
 580+ ABBD E6 07            and 7
 581+ ABBF C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ ABC0
 583+ ABC0 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ ABC1 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ ABC3 6F               ld l,a
 586+ ABC4 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ ABC5
 588+ ABC5 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ ABC6 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ ABC8 67               ld h,a
 591+ ABC9 C9               ret
 592+ ABCA
