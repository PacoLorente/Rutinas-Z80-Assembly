  51+ 99D4              ;
  52+ 99D4              ;	Calcula el cuadrante de pantalla donde se encuentra la entidad: (Cuad_objeto), "1", "2", "3" o "4".
  53+ 99D4              ;	Esta información es necesaria para poder calcular el (Puntero_de_impresion) de la entidad.
  54+ 99D4              ;
  55+ 99D4              ;	INPUT:  HL contiene (Posicion_actual).
  56+ 99D4              ;	OUTPUT: (Cuad_objeto) y A contienen "1", "2", "3" o "4" en función del cuadrante de pantalla en el que se encuentra la entidad.
  57+ 99D4              ;
  58+ 99D4              ;	MODIFY: A.
  59+ 99D4
  60+ 99D4
  61+ 99D4              Calcula_Cuad_objeto
  62+ 99D4
  63+ 99D4 CD D0 95     	call calcula_tercio
  64+ 99D7
  65+ 99D7              ;	Ahora tenemos "0", "1" o "2" en el acumulador en función del tercio de pantalla en el que nos encontremos.
  66+ 99D7
  67+ 99D7 28 12        	jr z,Primer_tercio
  68+ 99D9 3D           	dec a
  69+ 99DA 28 1C        	jr z,Segundo_tercio
  70+ 99DC
  71+ 99DC              Tercer_tercio
  72+ 99DC
  73+ 99DC CD 01 9A     	call Determina_lado_de_pantalla
  74+ 99DF 20 04        	jr nz,1F
  75+ 99E1 3E 04        	ld a,4
  76+ 99E3 18 02        	jr 2F
