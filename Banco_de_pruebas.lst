 714+ 9F6B 2A B6 94         ld hl,(Sound)
 715+ 9F6E
 716+ 9F6E 1C               inc e
 717+ 9F6F 1D               dec e
 718+ 9F70 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 719+ 9F72              ;                           ; (E)="0" indica que no hay variación en el tono.
 720+ 9F72
 721+ 9F72 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 722+ 9F73 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 723+ 9F74
 724+ 9F74              ; Rayo de entrada o de salida ???
 725+ 9F74
 726+ 9F74 A7               and a
