 583+ A718 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A719 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A71B 6F               ld l,a
 586+ A71C D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A71D
 588+ A71D 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A71E D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A720 67               ld h,a
