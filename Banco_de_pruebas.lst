 431+ C1C3              ;   -------------------------------------------------------------------------------------------
 432+ C1C3              ;
 433+ C1C3              ;   23/9/26
 434+ C1C3              ;
 435+ C1C3              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C1C3              ;
 437+ C1C3              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C1C3              ;   _ [Sound_Generator].
 439+ C1C3              ;
 440+ C1C3              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C1C3              ;
 442+ C1C3              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C1C3              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C1C3              ;
 445+ C1C3              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C1C3              ;
 447+ C1C3              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C1C3              ;
 449+ C1C3              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C1C3
 451+ C1C3              Play_burst_sound_effect:
 452+ C1C3
 453+ C1C3              ;   Exclusiones:
 454+ C1C3
 455+ C1C3 3A B4 96         ld a,(Burst_sound)
 456+ C1C6 A7               and a
 457+ C1C7 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C1C8
 459+ C1C8 08               ex af,af
 460+ C1C9
 461+ C1C9 3A 85 96         ld a,(Ctrl_6)
 462+ C1CC CB 47            bit 0,a
 463+ C1CE C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C1CF
 465+ C1CF              ;   ----------------------
 466+ C1CF
 467+ C1CF CB C7            set 0,a
 468+ C1D1 32 85 96         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C1D4
 470+ C1D4 08               ex af,af                ; Restore (Burst_sound).
 471+ C1D5
 472+ C1D5 67               ld h,a
 473+ C1D6 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1D8
 475+ C1D8 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1D9
 477+ C1D9 22 AE 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1DC 0E 03            ld c,3
