3116  A1B8              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A1B8              ; ******************************************************************************************************************************************************************************************
   2+ A1B8              ;
   3+ A1B8              ;   3/4/25
   4+ A1B8              ;
   5+ A1B8              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A1B8              ;   (XOR) bit a bit.
   7+ A1B8              ;
   8+ A1B8              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A1B8              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A1B8
  11+ A1B8              Derivando_RND
  12+ A1B8
  13+ A1B8 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A1BA C5               push bc
  15+ A1BB              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A1BB 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A1BE              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A1BE
  19+ A1BE A7           6 and a                                 ; Carry a "0".
  20+ A1BF CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A1C1 30 02            jr nc,1F
  22+ A1C3
  23+ A1C3 CB C1            set 0,c
  24+ A1C5
  25+ A1C5 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A1C6 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A1C8 5F               ld e,a
  28+ A1C9
  29+ A1C9 7A               ld a,d
  30+ A1CA E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A1CC 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A1CE
  33+ A1CE CB 3F            srl a
  34+ A1D0
  35+ A1D0 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A1D1
  37+ A1D1 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A1D2 28 04            jr z,4F
  39+ A1D4
  40+ A1D4 CB FF            set 7,a
  41+ A1D6 18 02            jr 5F
  42+ A1D8
  43+ A1D8 CB BF        4 res 7,a
  44+ A1DA
  45+ A1DA CB 21        5 sla c
  46+ A1DC 10 E0            djnz 6B
  47+ A1DE
  48+ A1DE 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A1DF
  50+ A1DF 77               ld (hl),a
  51+ A1E0 23               inc hl
  52+ A1E1 C1               pop bc
  53+ A1E2 10 D4            djnz 3B
  54+ A1E4
  55+ A1E4 C9               ret
  56+ A1E5
  57+ A1E5
  58+ A1E5
# file closed: RND_Derivando.asm
