 615  94C3 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 616  94C4              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 617  94C4
 618  94C4 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 619  94C5 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 620  94C6 00           Cola_de_desplazamiento db 0									; Este byte indica:
 621  94C7
 622  94C7              ;
 623  94C7              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 624  94C7              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 625  94C7              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 626  94C7              ;
 627  94C7              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 628  94C7              ;															;						Nº de veces que vamos a repetir el movimiento completo.
