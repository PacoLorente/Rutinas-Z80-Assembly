   1+ 9E72              ; ******************************************************************************************************************************************************************************************
   2+ 9E72              ;
   3+ 9E72              ;   3/4/25
   4+ 9E72              ;
   5+ 9E72              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E72              ;   (XOR) bit a bit.
   7+ 9E72              ;
   8+ 9E72              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E72              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E72
  11+ 9E72              Derivando_RND
  12+ 9E72
  13+ 9E72 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9E74 C5               push bc
  15+ 9E75              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9E75 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9E78              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9E78
  19+ 9E78 A7           6 and a                                 ; Carry a "0".
  20+ 9E79 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9E7B 30 02            jr nc,1F
  22+ 9E7D
  23+ 9E7D CB C1            set 0,c
  24+ 9E7F
  25+ 9E7F 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9E80 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9E82 5F               ld e,a
  28+ 9E83
  29+ 9E83 7A               ld a,d
  30+ 9E84 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9E86 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9E88
  33+ 9E88 CB 3F            srl a
  34+ 9E8A
  35+ 9E8A AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9E8B
  37+ 9E8B 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9E8C 28 04            jr z,4F
  39+ 9E8E
  40+ 9E8E CB FF            set 7,a
  41+ 9E90 18 02            jr 5F
  42+ 9E92
  43+ 9E92 CB BF        4 res 7,a
  44+ 9E94
  45+ 9E94 CB 21        5 sla c
  46+ 9E96 10 E0            djnz 6B
  47+ 9E98
  48+ 9E98 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9E99
  50+ 9E99 77               ld (hl),a
  51+ 9E9A 23               inc hl
  52+ 9E9B C1               pop bc
  53+ 9E9C 10 D4            djnz 3B
  54+ 9E9E
  55+ 9E9E C9               ret
  56+ 9E9F
  57+ 9E9F
  58+ 9E9F
# file closed: RND_Derivando.asm
