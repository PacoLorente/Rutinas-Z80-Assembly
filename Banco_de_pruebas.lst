   1+ 95E7              ; *********************************** Limpia la pantalla, CLEAR SCREEN ****************************************************************
   2+ 95E7              ;
   3+ 95E7              ;
   4+ 95E7              ;	CLS.
   5+ 95E7              ;
   6+ 95E7              ;	Limpia la pantalla y define sus atributos.
   7+ 95E7              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ 95E7              ;
   9+ 95E7              ;	COLORES: 0 ..... NEGRO
  10+ 95E7              ;    		 1 ..... AZUL
  11+ 95E7              ; 			 2 ..... ROJO
  12+ 95E7              ;			 3 ..... MAGENTA
  13+ 95E7              ; 			 4 ..... VERDE
  14+ 95E7              ; 			 5 ..... CIAN
  15+ 95E7              ;			 6 ..... AMARILLO
  16+ 95E7              ; 			 7 ..... BLANCO
  17+ 95E7              ;
  18+ 95E7              ;	INPUT: A contiene los atributos de pantalla.
  19+ 95E7              ;
  20+ 95E7              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 95E7
  22+ 95E7
  23+ 95E7 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ 95EA 11 01 40     	LD DE,$4001
  25+ 95ED 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 95F0 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 95F2 ED B0        	LDIR
  28+ 95F4 01 FF 02     	LD BC,767
  29+ 95F7 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 95F8 ED B0        	LDIR
  31+ 95FA C9           	ret
  32+ 95FB
