   3+ 9E96              ;   3/4/25
   4+ 9E96              ;
   5+ 9E96              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E96              ;   (XOR) bit a bit.
   7+ 9E96              ;
   8+ 9E96              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E96              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E96
  11+ 9E96              Derivando_RND
  12+ 9E96
  13+ 9E96 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9E98 C5               push bc
  15+ 9E99              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9E99 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9E9C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9E9C
  19+ 9E9C A7           6 and a                                 ; Carry a "0".
  20+ 9E9D CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9E9F 30 02            jr nc,1F
  22+ 9EA1
  23+ 9EA1 CB C1            set 0,c
  24+ 9EA3
  25+ 9EA3 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9EA4 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9EA6 5F               ld e,a
  28+ 9EA7
  29+ 9EA7 7A               ld a,d
  30+ 9EA8 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9EAA 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9EAC
  33+ 9EAC CB 3F            srl a
  34+ 9EAE
  35+ 9EAE AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9EAF
  37+ 9EAF 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9EB0 28 04            jr z,4F
  39+ 9EB2
  40+ 9EB2 CB FF            set 7,a
  41+ 9EB4 18 02            jr 5F
  42+ 9EB6
  43+ 9EB6 CB BF        4 res 7,a
