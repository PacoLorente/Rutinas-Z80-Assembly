 173  90A1
 174  90A1              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 175  90A1
 176  90A1 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 177  90A2              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 178  90A2              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 179  90A2              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 180  90A2
 181  90A2 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 182  90A3              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 183  90A3 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 184  90A4 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 185  90A5
 186  90A5 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 187  90A6              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 188  90A6              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 189  90A6
 190  90A6              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 191  90A6              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 192  90A6
 193  90A6              ; Ejemplos:
 194  90A6
 195  90A6              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 196  90A6              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 197  90A6              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 198  90A6              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 199  90A6              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 200  90A6
 201  90A6 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 202  90A7              ;															  _ que esta entidad haya colisionado con Amadeus.
 203  90A7              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 204  90A7
 205  90A7 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 206  90A9              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 207  90A9
 208  90A9 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 209  90AB
 210  90AB              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 211  90AB
 212  90AB 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 213  90AD              ;															  _palabras que componen el "movimiento_masticado".
 214  90AD
 215  90AD              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 216  90AD
 217  90AD 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 218  90AE              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 219  90AE              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 220  90AE              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 221  90AE              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 222  90AE
 223  90AE 00           Attr db 0 													; Atributos de la entidad.
