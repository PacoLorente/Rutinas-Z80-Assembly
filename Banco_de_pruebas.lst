 599+ 9F16 CD 4D 9E         call Calcula_direccion_atributos
 600+ 9F19
 601+ 9F19 08               ex af,af
 602+ 9F1A 77               ld (hl),a                               ;   Asigna attrs. al caracter impreso.
 603+ 9F1B
 604+ 9F1B D1               pop de                                  ;   Fila de pantalla.
 605+ 9F1C E1               pop hl                                  ;   Mensaje de texto.
 606+ 9F1D
 607+ 9F1D              ;   Suiguiente char.
 608+ 9F1D
 609+ 9F1D 23               inc hl                                  ;   Siguiente caracter a imprimir.
 610+ 9F1E
 611+ 9F1E 34               inc (hl)
 612+ 9F1F 35               dec (hl)
 613+ 9F20
 614+ 9F20 28 24            jr z,Exit_01                            ;   RET, fin de msg.
 615+ 9F22
 616+ 9F22 1C               inc e                                   ;   Siguiente columna de pantalla.
 617+ 9F23
 618+ 9F23 C1               pop bc                                  ;   Carga el temporizador en B.
 619+ 9F24
 620+ 9F24 04               inc b
 621+ 9F25 05               dec b
 622+ 9F26
