   1+ 9D44              ; ******************************************************************************************************************************************************************************************
   2+ 9D44              ;
   3+ 9D44              ;   3/4/25
   4+ 9D44              ;
   5+ 9D44              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D44              ;   (XOR) bit a bit.
   7+ 9D44              ;
   8+ 9D44              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D44              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D44
  11+ 9D44              Derivando_RND
  12+ 9D44
  13+ 9D44 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D46 C5               push bc
  15+ 9D47              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D47 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D4A              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D4A
  19+ 9D4A A7           6 and a                                 ; Carry a "0".
  20+ 9D4B CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D4D 30 02            jr nc,1F
  22+ 9D4F
  23+ 9D4F CB C1            set 0,c
  24+ 9D51
  25+ 9D51 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D52 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D54 5F               ld e,a
  28+ 9D55
  29+ 9D55 7A               ld a,d
  30+ 9D56 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D58 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D5A
  33+ 9D5A CB 3F            srl a
  34+ 9D5C
  35+ 9D5C AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D5D
  37+ 9D5D 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D5E 28 04            jr z,4F
  39+ 9D60
  40+ 9D60 CB FF            set 7,a
  41+ 9D62 18 02            jr 5F
  42+ 9D64
  43+ 9D64 CB BF        4 res 7,a
  44+ 9D66
  45+ 9D66 CB 21        5 sla c
  46+ 9D68 10 E0            djnz 6B
