 431+ C144              ;   -------------------------------------------------------------------------------------------
 432+ C144              ;
 433+ C144              ;   23/9/26
 434+ C144              ;
 435+ C144              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C144              ;
 437+ C144              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C144              ;   _ [Sound_Generator].
 439+ C144              ;
 440+ C144              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C144              ;
 442+ C144              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C144              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C144              ;
 445+ C144              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C144              ;
 447+ C144              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C144              ;
 449+ C144              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C144
 451+ C144              Play_burst_sound_effect:
 452+ C144
 453+ C144              ;   Exclusiones:
 454+ C144
 455+ C144 3A 8B 94         ld a,(Burst_sound)
 456+ C147 A7               and a
 457+ C148 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
