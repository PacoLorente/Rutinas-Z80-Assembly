 393  9490              ; Parámetros DRAW.
 394  9490              ;
 395  9490
 396  9490              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 397  9490
 398  9490 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 399  9491              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 400  9491              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 401  9491              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 402  9491
 403  9491 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 404  9492              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 405  9492 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 406  9493 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 407  9494
 408  9494 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 409  9495              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 410  9495              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 411  9495
 412  9495              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 413  9495              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 414  9495
 415  9495              ; Ejemplos:
 416  9495
 417  9495              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 418  9495              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 419  9495              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 420  9495              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 421  9495              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 422  9495
 423  9495 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 424  9496              ;															  _ que esta entidad haya colisionado con Amadeus.
 425  9496              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 426  9496
 427  9496 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 428  9498              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 429  9498
 430  9498 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 431  949A
 432  949A              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 433  949A
 434  949A 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 435  949C              ;															  _palabras que componen el "movimiento_masticado".
 436  949C
 437  949C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 438  949C
 439  949C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 440  949D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 441  949D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 442  949D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 443  949D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 444  949D
 445  949D 00           Attr db 0 													; Atributos de la entidad.
 446  949E
 447  949E              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 448  949E
 449  949E
 450  949E
 451  949E 00           Ctrl_2 db 0
 452  949F              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 453  949F              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 454  949F              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 455  949F              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 456  949F              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 457  949F              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 458  949F              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 459  949F              ;
 460  949F              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 461  949F              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 462  949F              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 463  949F              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 464  949F              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 465  949F              ;															BIT 4, ???
 466  949F              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 467  949F              ;															BIT 6, "1" Indica que hemos iniciado la "-Transicion_de_salida-" de Amadeus.
 468  949F              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 469  949F              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 470  949F
 471  949F 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 472  94A0              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 473  94A0              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 474  94A0              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 475  94A0              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 476  94A0              ;
 477  94A0              ; 															DESCRIPCIÖN:
 478  94A0              ;
 479  94A0              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 480  94A0              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 481  94A0              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 482  94A0              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 483  94A0              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 484  94A0              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 485  94A0              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 486  94A0              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 487  94A0              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 488  94A0              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 489  94A0              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 490  94A0              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 491  94A0              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 492  94A0              ;
 493  94A0              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 494  94A0              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 495  94A0              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 496  94A0
 497  94A0 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 498  94A1              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 499  94A1              ;															; _rojo - amarillo.
 500  94A1
 501  94A1 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 502  94A2              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 503  94A2
 504  94A2 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 505  94A4 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
 506  94A6
 507  94A6              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 508  94A6
 509  94A6 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 510  94A7              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 511  94A7              ;
 512  94A7              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
 513  94A7
 514  94A7              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 515  94A7
 516  94A7              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
 517  94A7              ;
 518  94A7              ;	COLORES: 0 ..... NEGRO
 519  94A7              ;    		 1 ..... AZUL
 520  94A7              ; 			 2 ..... ROJO
 521  94A7              ;			 3 ..... MAGENTA
 522  94A7              ; 			 4 ..... VERDE
 523  94A7              ; 			 5 ..... CIAN
 524  94A7              ;			 6 ..... AMARILLO
 525  94A7              ; 			 7 ..... BLANCO
 526  94A7
 527  94A7
 528  94A7 00 00        Indice_Sprite_der defw 0
 529  94A9 00 00        Indice_Sprite_izq defw 0
 530  94AB 00 00        Puntero_DESPLZ_der defw 0
 531  94AD 00 00        Puntero_DESPLZ_izq defw 0
 532  94AF 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 533  94B1
 534  94B1 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 535  94B2              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 536  94B2              ;															; _baja de la pantalla cuando hemos superado el nivel.
 537  94B2
 538  94B2 00           Columnas db 0
 539  94B3 00           Limite_vertical db 0 										; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
