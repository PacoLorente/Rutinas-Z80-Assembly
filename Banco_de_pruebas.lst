  91+ C06A
  92+ C06A 31 84 95         ld sp,Indice_Sprite_der+6                         ; Almacenaremos la nota en la caja de notas, (6 bytes). No hemos terminado con la ejecución.
  93+ C06D
  94+ C06D E5               push hl
  95+ C06E D5               push de
  96+ C06F C5               push bc
  97+ C070
  98+ C070              ;   Siguiente fragmento de la nota guardado. Restauramos SP.
  99+ C070
 100+ C070 ED 7B B0 95  2 ld sp,(Stack)
