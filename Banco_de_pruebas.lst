  24+ 95DF 11 01 40     	LD DE,$4001
  25+ 95E2 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 95E5 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 95E7 ED B0        	LDIR
  28+ 95E9 01 FF 02     	LD BC,767
  29+ 95EC 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 95ED ED B0        	LDIR
  31+ 95EF C9           	ret
  32+ 95F0
