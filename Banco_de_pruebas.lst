 175+ C98B              Make_Score_max_msg:
 176+ C98B
 177+ C98B              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 178+ C98B
 179+ C98B              ;   Necesito fabricar un msg. con la máxima puntuación.
 180+ C98B              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 181+ C98B
 182+ C98B 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
