 587+ C3CA              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 588+ C3CA              ;
 589+ C3CA              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3CA              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3CA              ;
 592+ C3CA              ;   Special keys:
 593+ C3CA              ;
 594+ C3CA              ;   Symbol_key defm "SYMB.",0
 595+ C3CA              ;   Space_key defm "SPACE",0
 596+ C3CA              ;   Enter_key defm "ENTER",0
 597+ C3CA              ;   Caps_key defm "CAPS.",0
 598+ C3CA              ;
 599+ C3CA              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 600+ C3CA              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 601+ C3CA              ;
 602+ C3CA              ;           (Numero_de_teclas_definidas) contiene el n° de teclas YA DEFINIDAS.
 603+ C3CA              ;
 604+ C3CA              ;   MODIFY: AF, HL, BC y DE.
 605+ C3CA              ;
 606+ C3CA              ;   OUTPUT: (A) = "0".
 607+ C3CA
 608+ C3CA              Define_key:
 609+ C3CA
 610+ C3CA E5               push hl                                                 ; PUSH Puntero KEYCODE.
 611+ C3CB D5               push de                                                 ; PUSH Puntero ASCII_CODE.
 612+ C3CC
 613+ C3CC CD 70 A0     3 call ROM_Key_Scan ; v2. Ok.                               ; Scan keyboard.
 614+ C3CF
 615+ C3CF              ;   Tras ejecutar[ROM_Key_Scan], (E) contiene el KEYCODE de la tecla pulsada.
 616+ C3CF
 617+ C3CF 3A 5D 96         ld a,(Numero_de_teclas_definidas)                       ; N° de teclas ya definidas.
 618+ C3D2 A7               and a
 619+ C3D3 28 0B            jr z,2F                                                 ; (Numero_de_teclas_definidas)="0" Indica que estamos definiendo Move_LEFT.
 620+ C3D5              ;                                                           ; (Numero_de_teclas_definidas) se incrementa en una unidad cada vez que se define una tecla:
 621+ C3D5              ;
 622+ C3D5              ;                                                           ; Ej.: Si estamos definiendo Move_RIGHT, (Numero_de_teclas_definidas)="1"
 623+ C3D5              ;                                                           ;      Si estamos definiendo Move_FIRE, (Numero_de_teclas_definidas)="2"
 624+ C3D5              ;                                                           ;      Si estamos definiendo Move_SHIELD, (Numero_de_teclas_definidas)="3"
 625+ C3D5
 626+ C3D5 47               ld b,a                                                  ; Así, (B) contiene el nº de teclas definidas -1.
 627+ C3D6
 628+ C3D6              ;   (Numero_de_teclas_definidas) contiene el n° de comparativas que realizaremos entre el nuevo KEYCODE definido y los anteriormente definidos.
 629+ C3D6              ;   Así evitaremos que se asigne una misma tecla para varias funciones distintas.
 630+ C3D6
 631+ C3D6 21 5E 96         ld hl,Move_LEFT                                         ; 1er KEYCODE a comparar.
 632+ C3D9
 633+ C3D9 7E           1 ld a,(hl)                                                 ; KEY_CODE de Move_LEFT en A.
 634+ C3DA BB               cp e                                                    ; Comparo con el Key_code recién adquirido.
 635+ C3DB 28 EF            jr z,3B                                                 ; Esta tecla ya se definió anteriormente. Volvemos a escanear el teclado.
 636+ C3DD
 637+ C3DD 23               inc hl                                                  ; Next KEYCODE to compare.
 638+ C3DE
 639+ C3DE 10 F9            djnz 1B
 640+ C3E0
 641+ C3E0 7B           2 ld a,e                                                    ; KEY_code en A.
 642+ C3E1
 643+ C3E1 D1               pop de                                                  ; POP Puntero ASCII_CODE.
 644+ C3E2 E1               pop hl                                                  ; POP Puntero KEYCODE.
 645+ C3E3
 646+ C3E3 77               ld (hl),a                                               ; Key_code almacenado.
 647+ C3E4
 648+ C3E4              ;   Sonido, (BEEP) de la pulsación de las teclas, (cuando está autorizada). No se ejecuta [BEEP] si la tecla ya está definida.
 649+ C3E4
 650+ C3E4 CD 52 C1         call BEEP   ; v2. Ok.
