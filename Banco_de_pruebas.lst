 766+ C465              ;   Al salir de la rutina tendremos en la caja correspondiente algo así:
 767+ C465              ;
 768+ C465              ;   $961e db $45, $4e, $54, $45, $52, $00 ..... Move_LEFT_ASCII_CODE db "SPACE",0
 769+ C465              ;
