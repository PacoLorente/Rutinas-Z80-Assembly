 383+ A20D
 384+ A20D              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A20D
 386+ A20D 79           	ld a,c
 387+ A20E 08           	ex af,af
 388+ A20F 79           	ld a,c 															; (Clase) de la entidad en A y A´.
