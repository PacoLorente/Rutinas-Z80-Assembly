 771  D303
 772  D303              ;	Por encima o igual que (Max_time_to_appear_entities).
 773  D303
 774  D303 4E           	ld c,(hl)
 775  D304 18 06        	jr 2F
 776  D306
 777  D306              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
 778  D306              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
 779  D306
 780  D306 23           1 inc hl
 781  D307 23           	inc hl
 782  D308
