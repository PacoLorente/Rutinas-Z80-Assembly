  23+ B164 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
  24+ B165
  25+ B165 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
  26+ B166 C6 20            add a,$20           							; Vamos a comprobarlo...
  27+ B168 6F               ld l,a
  28+ B169 D8               ret c               							; Salimos si se produce el cambio de tercio.
  29+ B16A
  30+ B16A 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
  31+ B16B D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
  32+ B16D 67               ld h,a
  33+ B16E C9               ret
