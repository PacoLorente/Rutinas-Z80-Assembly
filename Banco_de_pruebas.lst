 605+ B4CC              ;   PreviousScan.
 606+ B4CC              ;
 607+ B4CC              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 608+ B4CC              ;
 609+ B4CC              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 610+ B4CC              ;
 611+ B4CC              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 612+ B4CC              ;
 613+ B4CC              ;       DESTRUIDOS: AF y HL !!!
 614+ B4CC              ;
 615+ B4CC              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 616+ B4CC              ;
 617+ B4CC
 618+ B4CC              PreviousScan:
 619+ B4CC
 620+ B4CC 7C           	ld a,h
 621+ B4CD 25               dec h               							; Dec H.
 622+ B4CE E6 07            and 7
 623+ B4D0 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 624+ B4D1
 625+ B4D1 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 626+ B4D2 D6 20            sub $20             							; Vamos a comprobarlo...
 627+ B4D4 6F               ld l,a
 628+ B4D5 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 629+ B4D6
 630+ B4D6 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 631+ B4D7 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 632+ B4D9 67               ld h,a
 633+ B4DA C9               ret
