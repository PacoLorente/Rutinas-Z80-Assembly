 844+ B63D
 845+ B63D 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B63E D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B640 6F               ld l,a
 848+ B641 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B642
 850+ B642 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B643 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B645 67               ld h,a
 853+ B646 C9               ret
