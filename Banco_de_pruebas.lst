   4+ 99EF              ;
   5+ 99EF              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99EF              ;   (XOR) bit a bit.
   7+ 99EF              ;
   8+ 99EF              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99EF              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99EF
  11+ 99EF              Derivando_RND
  12+ 99EF
  13+ 99EF ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99F1 C5               push bc
  15+ 99F2              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99F2 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99F5              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99F5
  19+ 99F5 A7           6 and a                                 ; Carry a "0".
  20+ 99F6 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99F8 30 02            jr nc,1F
  22+ 99FA
  23+ 99FA CB C1            set 0,c
  24+ 99FC
  25+ 99FC 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99FD E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99FF 5F               ld e,a
  28+ 9A00
  29+ 9A00 7A               ld a,d
  30+ 9A01 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9A03 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9A05
  33+ 9A05 CB 3F            srl a
  34+ 9A07
  35+ 9A07 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9A08
  37+ 9A08 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9A09 28 04            jr z,4F
  39+ 9A0B
  40+ 9A0B CB FF            set 7,a
  41+ 9A0D 18 02            jr 5F
  42+ 9A0F
  43+ 9A0F CB BF        4 res 7,a
  44+ 9A11
  45+ 9A11 CB 21        5 sla c
  46+ 9A13 10 E0            djnz 6B
  47+ 9A15
  48+ 9A15 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9A16
  50+ 9A16 77               ld (hl),a
  51+ 9A17 23               inc hl
  52+ 9A18 C1               pop bc
  53+ 9A19 10 D4            djnz 3B
  54+ 9A1B
  55+ 9A1B C9               ret
  56+ 9A1C
  57+ 9A1C
  58+ 9A1C
