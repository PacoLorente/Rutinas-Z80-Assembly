 262  960F              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 263  960F
 264  960F 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 265  9610              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 266  9610              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 267  9610              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 268  9610
 269  9610 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 270  9611              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 271  9611
 272  9611 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 273  9612              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 274  9612              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 275  9612
 276  9612              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 277  9612              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 278  9612
 279  9612              ; Ejemplos:
 280  9612
 281  9612              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 282  9612              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 283  9612              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 284  9612              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 285  9612              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 286  9612
 287  9612 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 288  9613              ;															  _ que esta entidad haya colisionado con Amadeus.
 289  9613              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 290  9613
 291  9613 00 00        Puntero_de_impresion defw 0									; Esta variable tiene dos funciones, la primera:
 292  9615              ;
 293  9615              ;															; Es utilizada por la rutina [Define_menu] para almacenar el puntero indicial: Define_menu_index_parameters.
 294  9615              ;
 295  9615              ;															; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 296  9615              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 297  9615
 298  9615 00 40        Puntero_de_almacen_de_mov_masticados defw Line_0
