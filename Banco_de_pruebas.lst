 627+ 9F28 08               ex af,af                                ;   attrs. del msg en AF´.
 628+ 9F29
 629+ 9F29 ED 5F            ld a,r
 630+ 9F2B CB 3F            srl a
 631+ 9F2D
 632+ 9F2D CB 47            bit 0,a
 633+ 9F2F 28 04            jr z,3F
 634+ 9F31
 635+ 9F31 06 5A            ld b,90
 636+ 9F33 18 02            jr 1F
 637+ 9F35
 638+ 9F35 06 82        3 ld b,130
 639+ 9F37
 640+ 9F37 0E FF        1 ld c,$ff
 641+ 9F39
 642+ 9F39 0D           2 dec c
 643+ 9F3A 20 FD            jr nz,2B
 644+ 9F3C
 645+ 9F3C 10 F9            djnz 1B                                 ;   Aplica temporización.
 646+ 9F3E
 647+ 9F3E CD 0B C1         call BEEP
 648+ 9F41
