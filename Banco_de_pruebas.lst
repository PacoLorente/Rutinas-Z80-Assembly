   5+ 9998              ; DRAW. ************************************************************************************************************************************************************************************
   6+ 9998
   7+ 9998              Draw
   8+ 9998
   9+ 9998 CD 2D 9C     	call Prepara_draw
  10+ 999B 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 999C A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 999D 28 05        	jr z,2F
  13+ 999F
  14+ 999F 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99A2 18 0C        	jr 1F
  16+ 99A4
  17+ 99A4              ;	Inicia entidad.
  18+ 99A4
  19+ 99A4 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99A7 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99AA CD 35 9B     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  22+ 99AD              ;													; _la esquina superior izquierda de la pantalla.
  23+ 99AD CD C3 A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  24+ 99B0
  25+ 99B0 3A F7 8B     1 ld a,(Ctrl_0)
  26+ 99B3 CB 6F        	bit 5,a
  27+ 99B5 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  28+ 99B7
  29+ 99B7 CD CC 99     	call Comprueba_limite_horizontal
  30+ 99BA CD 5C 9A     	call Comprueba_limite_vertical
  31+ 99BD
  32+ 99BD              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  33+ 99BD              ; -----------------------
  34+ 99BD              ; -----------------------
  35+ 99BD              ; -----------------------
  36+ 99BD
  37+ 99BD CD B1 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  38+ 99C0 CD D5 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  39+ 99C3
  40+ 99C3 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina REStauramos el bit5 de Ctrl_0 para que nos vuelva_
  41+ 99C6 CB AF        	res 5,a											; _a ser de utilidad.
  42+ 99C8 32 F7 8B     	ld (Ctrl_0),a
  43+ 99CB
  44+ 99CB C9           	ret
  45+ 99CC
  46+ 99CC              ; *******************************************************************************************************************************************************************************************
  47+ 99CC              ;	21/01/23
  48+ 99CC              ;
  49+ 99CC              ; 	Comprueba_limite_horizontal.
  50+ 99CC              ;
  51+ 99CC              ;	La rutina comprueba si hemos sobrepasado el (Limite_horizontal) definido en la rutina [Inicializacion]. Este será:_
  52+ 99CC              ;	_ $4fc0 si partimos de los cuadrantes 1 o 2 de pantalla o $4820 si partimos de los cuadrantes 3 o 4.
  53+ 99CC              ;
  54+ 99CC              ;	Si sobrepasamos o alcanzamos el límite horizontal establecido, la rutina cargará el registro E con un "1".
  55+ 99CC              ;	Si NO HEMOS SOBREPASADO (Limite_horizontal), E="0".
  56+ 99CC              ;	E="1" indica que HEMOS SOBREPASADO el (Limite_horizontal).
  57+ 99CC              ;	E="2" indica que NO HEMOS SOBREPASADO el (Limite_horizontal) pero hemos alcanzado o superado EL CENTRO DE PANTALLA.
  58+ 99CC
  59+ 99CC
  60+ 99CC
  61+ 99CC 3A F7 8B     Comprueba_limite_horizontal ld a,(Ctrl_0)          	; Si no hemos desaparecido por arriba o por abajo, saltamos a 1F para comprobar_
  62+ 99CF CB 57        	bit 2,a                                         ; _si hemos llegado o sobrepasado (Limite_horizontal). Seguimos con la rutina.
  63+ 99D1 28 07        	jr z,1F                                         ; Si por el contrario hemos desaparecido por arriba o por abajo, (bit2/bit3 de (Ctrl_0)="1"))_
