 584+ B1F3 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1F5 6F               ld l,a
 586+ B1F6 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1F7
 588+ B1F7 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1F8 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
