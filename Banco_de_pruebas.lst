 455+ ACB5
 456+ ACB5 2A 2C A5     	ld hl,(Puntero_indice_master)
 457+ ACB8 CD 7A D4     	call Extrae_address
 458+ ACBB
 459+ ACBB 5D           	ld e,l
 460+ ACBC 54           	ld d,h
 461+ ACBD
 462+ ACBD CD 2B B0     	call Parametros_de_bandeja_DRAW_a_Caja_Master	 				; Caja de entidades Master completa.
 463+ ACC0
 464+ ACC0              ;	Limpiamos la bandeja_DRAW y las variables de movimiento para poder generar los mov. masticados_
 465+ ACC0              ;	_de otro (Tipo) de entidad.
 466+ ACC0              ;
 467+ ACC0              ;	Limpiamos bandeja y variables.
 468+ ACC0
 469+ ACC0 AF           	xor a
 470+ ACC1 32 5D A5     	ld (Ctrl_3),a 													; (Ctrl_3) ha de inicializarse pués lo utilizamos para indicar_
 471+ ACC4              ;																	; _, (entre otras cosas) cuando finalizamos de generar los mov. masticados.
 472+ ACC4 21 EC A4     	ld hl,Clase
 473+ ACC7 01 3A 00     	ld bc,Gestion_de_ENTIDADES_y_CAJAS-Bandeja_DRAW
 474+ ACCA
 475+ ACCA 0B           	dec bc
 476+ ACCB
 477+ ACCB CD A9 BF     	call Clean_mem
 478+ ACCE
 479+ ACCE              ; 	Avanza a la siguiente entidad del nivel.
 480+ ACCE
 481+ ACCE              Avanza_siguiente_entidad_del_nivel:
 482+ ACCE
 483+ ACCE C1           	pop bc															; Pop (Numero_de_entidades)/(Tipo).
 484+ ACCF E1           	pop hl															; Pop (Puntero_de_entidades).
 485+ ACD0
 486+ ACD0 23           	inc hl															; Puntero_de_entidades +1 en HL.
 487+ ACD1 22 7E A5     	ld (Puntero_de_entidades),hl 									; Actualizamos (Puntero_de_entidades).
 488+ ACD4
 489+ ACD4 4E           	ld c,(hl)														; (Tipo) de la siguiente entidad en C.
 490+ ACD5 10 B1        	djnz Prepara_Cajas_Master 										; dec (Numero_de_entidades).
 491+ ACD7
 492+ ACD7              ; Una vez terminados los movimientos masticados de los distintos TIPOS de entidades,
 493+ ACD7              ; _ inicializamos el puntero (Puntero_de_entidades), situándolo en la 1ª entidad.
 494+ ACD7
 495+ ACD7 2A 99 A5     	ld hl,(Puntero_indice_NIVELES)
 496+ ACDA CD 7A D4     	call Extrae_address
 497+ ACDD
 498+ ACDD 23           	inc hl
 499+ ACDE 23           	inc hl
 500+ ACDF 23           	inc hl
 501+ ACE0 23           	inc hl
 502+ ACE1 23           	inc hl
 503+ ACE2
 504+ ACE2 22 7E A5     	ld (Puntero_de_entidades),hl
 505+ ACE5
 506+ ACE5 C9           	ret
 507+ ACE6
 508+ ACE6              ; -----------------------------------------------------------------------------------
 509+ ACE6              ;
 510+ ACE6              ;	20/07/26
 511+ ACE6              ;
 512+ ACE6              ;	Asigna una columna de inicio aleatoria y distinta a cada una de las 3 Clases como máximo que pueden aparecer en un nivel.
 513+ ACE6
 514+ ACE6              Determina_posicion_de_inicio:
 515+ ACE6
 516+ ACE6 21 88 A2     	ld hl,Numeros_aleatorios+3
 517+ ACE9 7E           	ld a,(hl)
 518+ ACEA E6 1F        	and $1f															; Define el nº de columna por el que va a aparecer la entidad.
 519+ ACEC
 520+ ACEC              ;	Tenemos un nº aleatorio, (Columna de inicio) en A.
 521+ ACEC              ; 	No queremos que se repita la posición de inicio en dos clases distintas de entidades.
 522+ ACEC
 523+ ACEC 57           	ld d,a 															; $08,$12,$0c --- $08,$02,$12 --- $18,$1c,$18 --- $1e,$1c,$18
 524+ ACED
 525+ ACED CD 07 AD     	call No_repeat
 526+ ACF0
 527+ ACF0 3A ED A4     	ld a,(Tipo)														; (Tipo) $81 Badsat, $82 Badplate.
 528+ ACF3 E6 02        	and 2
 529+ ACF5 7A           	ld a,d
