  91+ AAA7
  92+ AAA7 04           	inc b
  93+ AAA8
  94+ AAA8 1E 00        	ld e,0                                              ; Contador de Filas, inicialmente "0", (1a Fila del 1er tercio de pantalla).
  95+ AAAA
  96+ AAAA 7D               ld a,l
  97+ AAAB E6 E0        	and $e0                                             ; La máscara "$e0" entrega el valor de la primera columna de la Fila en la que nos encontamos:
  98+ AAAD              ;
  99+ AAAD              ;                                                       : Ejemplo:
 100+ AAAD              ;
 101+ AAAD              ;                                                       Cuando (L) contiene: "$0f", "$1c", "$08", ...etc (A) contiene "$00"
 102+ AAAD              ;                                                       Cuando (L) contiene: "$2f", "$3c", "$28", ...etc (A) contiene "$20"
 103+ AAAD              ;                                                       Cuando (L) contiene: "$4f", "$5c", "$48", ...etc (A) contiene "$40"
 104+ AAAD              ;                                                       Cuando (L) contiene: "$6f", "$7c", "$68", ...etc (A) contiene "$60"
 105+ AAAD              ;
 106+ AAAD              ;                                                       etc.
