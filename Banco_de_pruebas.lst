 681+ 9F58 29               add hl,hl
 682+ 9F59 29               add hl,hl                               ;   ASCII * 8
 683+ 9F5A
 684+ 9F5A 09               add hl,bc
 685+ 9F5B
 686+ 9F5B C9               ret
