  11+ 9A0D              ; 			 2 ..... ROJO
  12+ 9A0D              ;			 3 ..... MAGENTA
  13+ 9A0D              ; 			 4 ..... VERDE
  14+ 9A0D              ; 			 5 ..... CIAN
  15+ 9A0D              ;			 6 ..... AMARILLO
  16+ 9A0D              ; 			 7 ..... BLANCO
  17+ 9A0D              ;
  18+ 9A0D              ;	INPUT: A contiene los atributos de pantalla.
  19+ 9A0D              ;
  20+ 9A0D              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 9A0D
  22+ 9A0D
