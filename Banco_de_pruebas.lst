 325+ C179              ;   Configuración de un BEEP.
 326+ C179
 327+ C179              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C179              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C179              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C179              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C179              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C179
 333+ C179
 334+ C179 01 02 00         ld bc,$0002
 335+ C17C 11 00 00         ld de,0
 336+ C17F 21 D0 00         ld hl,$00d0
 337+ C182
 338+ C182 22 AE 96         ld (Sound),hl
 339+ C185
 340+ C185 CD E9 9F         call Sound_Generator    ; v2. Ok.
 341+ C188
 342+ C188 21 00 00         ld hl,0
 343+ C18B 22 AE 96         ld (Sound),hl
