 397  9490 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 398  9491              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 399  9491              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 400  9491              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 401  9491
 402  9491 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 403  9492              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 404  9492 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 405  9493 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 406  9494
 407  9494 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 408  9495              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 409  9495              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 410  9495
 411  9495              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 412  9495              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 413  9495
 414  9495              ; Ejemplos:
 415  9495
 416  9495              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 417  9495              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 418  9495              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 419  9495              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 420  9495              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 421  9495
 422  9495 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 423  9496              ;															  _ que esta entidad haya colisionado con Amadeus.
 424  9496              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 425  9496
