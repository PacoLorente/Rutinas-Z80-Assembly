 435+ C13E              ;   -------------------------------------------------------------------------------------------
 436+ C13E              ;
 437+ C13E              ;   23/9/26
 438+ C13E              ;
 439+ C13E              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 440+ C13E              ;
 441+ C13E              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 442+ C13E              ;   _ [Sound_Generator].
 443+ C13E              ;
 444+ C13E              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 445+ C13E              ;
 446+ C13E              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 447+ C13E              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 448+ C13E              ;
 449+ C13E              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 450+ C13E              ;
 451+ C13E              ;   MODIFY: AF',AF, HL, DE y BC.
 452+ C13E              ;
 453+ C13E              ;   OUTPUT: Actualiza (Burst_sound).
 454+ C13E
 455+ C13E              Play_burst_sound_effect:
 456+ C13E
 457+ C13E              ;   Exclusiones:
 458+ C13E
 459+ C13E 3A 8B 94         ld a,(Burst_sound)
 460+ C141 A7               and a
 461+ C142 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 462+ C143
 463+ C143 08               ex af,af
 464+ C144
 465+ C144 3A 5B 94         ld a,(Ctrl_6)
 466+ C147 CB 47            bit 0,a
