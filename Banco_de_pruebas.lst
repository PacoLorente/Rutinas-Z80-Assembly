   4+ 95E9              ;
   5+ 95E9              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 95E9              ;   (XOR) bit a bit.
   7+ 95E9              ;
   8+ 95E9              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 95E9              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 95E9
  11+ 95E9              Derivando_RND
  12+ 95E9
  13+ 95E9 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 95EB C5               push bc
  15+ 95EC              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 95EC 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 95EF              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 95EF
  19+ 95EF A7           6 and a                                 ; Carry a "0".
  20+ 95F0 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 95F2 30 02            jr nc,1F
  22+ 95F4
  23+ 95F4 CB C1            set 0,c
  24+ 95F6
  25+ 95F6 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 95F7 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 95F9 5F               ld e,a
  28+ 95FA
  29+ 95FA 7A               ld a,d
  30+ 95FB E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 95FD 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 95FF
  33+ 95FF CB 3F            srl a
  34+ 9601
  35+ 9601 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9602
  37+ 9602 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9603 28 04            jr z,4F
  39+ 9605
  40+ 9605 CB FF            set 7,a
  41+ 9607 18 02            jr 5F
  42+ 9609
  43+ 9609 CB BF        4 res 7,a
  44+ 960B
  45+ 960B CB 21        5 sla c
  46+ 960D 10 E0            djnz 6B
  47+ 960F
  48+ 960F 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9610
  50+ 9610 77               ld (hl),a
  51+ 9611 23               inc hl
  52+ 9612 C1               pop bc
  53+ 9613 10 D4            djnz 3B
  54+ 9615
  55+ 9615 C9               ret
