   1+ A16A              ; ******************************************************************************************************************************************************************************************
   2+ A16A              ;
   3+ A16A              ;   3/4/25
   4+ A16A              ;
   5+ A16A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A16A              ;   (XOR) bit a bit.
   7+ A16A              ;
   8+ A16A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A16A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A16A
  11+ A16A              Derivando_RND
  12+ A16A
  13+ A16A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A16C C5               push bc
  15+ A16D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A16D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A170              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A170
  19+ A170 A7           6 and a                                 ; Carry a "0".
  20+ A171 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A173 30 02            jr nc,1F
  22+ A175
  23+ A175 CB C1            set 0,c
  24+ A177
  25+ A177 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A178 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A17A 5F               ld e,a
  28+ A17B
  29+ A17B 7A               ld a,d
  30+ A17C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A17E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A180
  33+ A180 CB 3F            srl a
  34+ A182
  35+ A182 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A183
  37+ A183 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A184 28 04            jr z,4F
  39+ A186
  40+ A186 CB FF            set 7,a
  41+ A188 18 02            jr 5F
  42+ A18A
  43+ A18A CB BF        4 res 7,a
  44+ A18C
  45+ A18C CB 21        5 sla c
  46+ A18E 10 E0            djnz 6B
  47+ A190
  48+ A190 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A191
  50+ A191 77               ld (hl),a
  51+ A192 23               inc hl
  52+ A193 C1               pop bc
  53+ A194 10 D4            djnz 3B
  54+ A196
  55+ A196 C9               ret
  56+ A197
  57+ A197
  58+ A197
# file closed: RND_Derivando.asm
