  28+ A1A2 01 FF 02     	LD BC,767
  29+ A1A5 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A1A6 ED B0        	LDIR
  31+ A1A8
  32+ A1A8 AF           	xor a
  33+ A1A9
  34+ A1A9 C9           	ret
  35+ A1AA
