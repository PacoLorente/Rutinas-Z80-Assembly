   5+ 93D5              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93D5              ;   (XOR) bit a bit.
   7+ 93D5              ;
   8+ 93D5              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93D5
  10+ 93D5              Derivando_RND
  11+ 93D5
  12+ 93D5 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93D8
  14+ 93D8 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93DA C5               push bc
  16+ 93DB              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93DB 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 93DE              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 93DE
  20+ 93DE A7           6 and a                                 ; Carry a "0".
  21+ 93DF CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 93E1 30 02            jr nc,1F
  23+ 93E3
  24+ 93E3 CB C1            set 0,c
  25+ 93E5
  26+ 93E5 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 93E6 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 93E8 5F               ld e,a
  29+ 93E9
  30+ 93E9 7A               ld a,d
  31+ 93EA E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 93EC 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 93EE
  34+ 93EE CB 3F            srl a
  35+ 93F0
  36+ 93F0 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 93F1
  38+ 93F1 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 93F2 28 04            jr z,4F
  40+ 93F4
  41+ 93F4 CB FF            set 7,a
  42+ 93F6 18 02            jr 5F
  43+ 93F8
  44+ 93F8 CB BF        4 res 7,a
  45+ 93FA
  46+ 93FA CB 21        5 sla c
  47+ 93FC 10 E0            djnz 6B
  48+ 93FE
  49+ 93FE 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 93FF
  51+ 93FF 77               ld (hl),a
  52+ 9400 23               inc hl
  53+ 9401 C1               pop bc
  54+ 9402 10 D4            djnz 3B
  55+ 9404
  56+ 9404 C9               ret
