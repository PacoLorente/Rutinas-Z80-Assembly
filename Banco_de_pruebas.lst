   1+ 8A84
   2+ 8A84
   3+ 8A84              ;   07/07/23
   4+ 8A84              ;
   5+ 8A84              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8A84              ;
   7+ 8A84              ;   Codificación:
   8+ 8A84              ;
   9+ 8A84              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8A84              ;
  11+ 8A84              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8A84              ;
  13+ 8A84              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8A84              ;
  15+ 8A84              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8A84              ;
  17+ 8A84              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8A84              ;                               ..... %01000010 Vel_up 4
  19+ 8A84              ;                                               Vel_down 2
  20+ 8A84              ;                               ..... $42
  21+ 8A84              ;
  22+ 8A84              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8A84              ;
  24+ 8A84              ;                               ..... %01000010 Vel_left 4
  25+ 8A84              ;                                               Vel_right 2
  26+ 8A84              ;                               ..... $42
  27+ 8A84              ;
  28+ 8A84              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8A84              ;
  30+ 8A84              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8A84              ;
  32+ 8A84              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8A84              ;
  34+ 8A84              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8A84              ;                                     $53
  36+ 8A84              ;
  37+ 8A84              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8A84              ;
  39+ 8A84              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8A84              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8A84              ;
  42+ 8A84              ;                       Arriba ..... $81
  43+ 8A84              ;                       Arriba - izquierda ..... $a1
  44+ 8A84              ;                       Arriba - derecha ..... $91
  45+ 8A84              ;
  46+ 8A84              ;                       Abajo ..... $41
  47+ 8A84              ;                       Abajo - izquierda ..... $61
  48+ 8A84              ;                       Abajo - derecha ..... $51
  49+ 8A84              ;
  50+ 8A84              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8A84              ;
  52+ 8A84              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8A84              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8A84              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8A84              ;
  56+ 8A84              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8A84              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8A84              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8A84              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8A84              ;
  61+ 8A84              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8A84              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8A84              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8A84              ;
  65+ 8A84              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8A84              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8A84              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8A84              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8A84
