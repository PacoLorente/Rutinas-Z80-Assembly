 619  94D7 00           Incrementa_puntero_backup db 0
 620  94D8 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 621  94D9              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 622  94D9
 623  94D9 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 624  94DA 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 625  94DB 00           Cola_de_desplazamiento db 0									; Este byte indica:
 626  94DC
 627  94DC              ;
 628  94DC              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 629  94DC              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 630  94DC              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 631  94DC              ;
 632  94DC              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 633  94DC              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 634  94DC              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 635  94DC              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 636  94DC              ;
 637  94DC              ;															;	"$ff" ..... Bucle infinito de repetición.
 638  94DC              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 639  94DC              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 640  94DC
 641  94DC 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 642  94DD
 643  94DD              ;																DESCRIPCIÓN:
 644  94DD              ;
 645  94DD              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 646  94DD              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 647  94DD              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 648  94DD              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 649  94DD              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 650  94DD              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 651  94DD
 652  94DD              ;															BIT 3, Recarga de nueva oleada.
 653  94DD              ;															BIT 4, Recarga de nueva oleada.
 654  94DD              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 655  94DD              ;															BIT 6, **** Frame completo.
 656  94DD              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 657  94DD
 658  94DD 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 659  94DF              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 660  94DF              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 661  94DF              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
