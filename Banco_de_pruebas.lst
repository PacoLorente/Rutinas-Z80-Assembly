 340  9197 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 341  9198 00           Cola_de_desplazamiento db 0									; Este byte indica:
 342  9199
 343  9199              ;
 344  9199              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 345  9199              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 346  9199              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 347  9199              ;
 348  9199              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 349  9199              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 350  9199              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 351  9199              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 352  9199              ;
 353  9199              ;															;	"$ff" ..... Bucle infinito de repetición.
 354  9199              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 355  9199              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 356  9199
