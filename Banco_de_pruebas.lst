   1+ 9EEF              ; ******************************************************************************************************************************************************************************************
   2+ 9EEF              ;
   3+ 9EEF              ;   3/4/25
   4+ 9EEF              ;
   5+ 9EEF              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9EEF              ;   (XOR) bit a bit.
   7+ 9EEF              ;
   8+ 9EEF              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9EEF              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9EEF
  11+ 9EEF              Derivando_RND
  12+ 9EEF
  13+ 9EEF ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9EF1 C5               push bc
  15+ 9EF2              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9EF2 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9EF5              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9EF5
  19+ 9EF5 A7           6 and a                                 ; Carry a "0".
  20+ 9EF6 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9EF8 30 02            jr nc,1F
  22+ 9EFA
  23+ 9EFA CB C1            set 0,c
  24+ 9EFC
  25+ 9EFC 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9EFD E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9EFF 5F               ld e,a
  28+ 9F00
  29+ 9F00 7A               ld a,d
  30+ 9F01 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9F03 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9F05
  33+ 9F05 CB 3F            srl a
  34+ 9F07
  35+ 9F07 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9F08
  37+ 9F08 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9F09 28 04            jr z,4F
  39+ 9F0B
  40+ 9F0B CB FF            set 7,a
  41+ 9F0D 18 02            jr 5F
  42+ 9F0F
  43+ 9F0F CB BF        4 res 7,a
  44+ 9F11
  45+ 9F11 CB 21        5 sla c
  46+ 9F13 10 E0            djnz 6B
  47+ 9F15
  48+ 9F15 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9F16
  50+ 9F16 77               ld (hl),a
  51+ 9F17 23               inc hl
  52+ 9F18 C1               pop bc
  53+ 9F19 10 D4            djnz 3B
  54+ 9F1B
  55+ 9F1B C9               ret
  56+ 9F1C
  57+ 9F1C
  58+ 9F1C
