 481  9179              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 9179
   2+ 9179
   3+ 9179              ;   07/07/23
   4+ 9179              ;
   5+ 9179              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 9179              ;
   7+ 9179              ;   Codificación:
   8+ 9179              ;
   9+ 9179              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 9179              ;
  11+ 9179              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 9179              ;
  13+ 9179              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 9179              ;
  15+ 9179              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 9179              ;
  17+ 9179              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 9179              ;                               ..... %01000010 Vel_up 4
  19+ 9179              ;                                               Vel_down 2
  20+ 9179              ;                               ..... $42
  21+ 9179              ;
  22+ 9179              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 9179              ;
  24+ 9179              ;                               ..... %01000010 Vel_left 4
  25+ 9179              ;                                               Vel_right 2
  26+ 9179              ;                               ..... $42
  27+ 9179              ;
  28+ 9179              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 9179              ;
  30+ 9179              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 9179              ;
  32+ 9179              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 9179              ;
  34+ 9179              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 9179              ;                                     $53
  36+ 9179              ;
  37+ 9179              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 9179              ;
  39+ 9179              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 9179              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 9179              ;
  42+ 9179              ;                       Arriba ..... $81
  43+ 9179              ;                       Arriba - izquierda ..... $a1
  44+ 9179              ;                       Arriba - derecha ..... $91
  45+ 9179              ;
  46+ 9179              ;                       Abajo ..... $41
  47+ 9179              ;                       Abajo - izquierda ..... $61
  48+ 9179              ;                       Abajo - derecha ..... $51
  49+ 9179              ;
  50+ 9179              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 9179              ;
  52+ 9179              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 9179              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 9179              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 9179              ;
  56+ 9179              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 9179              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 9179              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 9179              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 9179              ;
  61+ 9179              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 9179              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 9179              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 9179              ;
  65+ 9179              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 9179              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 9179              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 9179              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 9179
