   6+ A0AC              ;	Limpia la pantalla y define sus atributos.
   7+ A0AC              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A0AC              ;
   9+ A0AC              ;	COLORES: 0 ..... NEGRO
  10+ A0AC              ;    		 1 ..... AZUL
  11+ A0AC              ; 			 2 ..... ROJO
  12+ A0AC              ;			 3 ..... MAGENTA
  13+ A0AC              ; 			 4 ..... VERDE
  14+ A0AC              ; 			 5 ..... CIAN
  15+ A0AC              ;			 6 ..... AMARILLO
  16+ A0AC              ; 			 7 ..... BLANCO
  17+ A0AC              ;
  18+ A0AC              ;	INPUT: A contiene los atributos de pantalla.
  19+ A0AC              ;
  20+ A0AC              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A0AC
  22+ A0AC
  23+ A0AC 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A0AF 11 01 40     	LD DE,$4001
  25+ A0B2 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A0B5 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A0B7 ED B0        	LDIR
  28+ A0B9 01 FF 02     	LD BC,767
  29+ A0BC 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A0BD ED B0        	LDIR
  31+ A0BF
  32+ A0BF AF           	xor a
  33+ A0C0
  34+ A0C0 C9           	ret
  35+ A0C1
