   5+ 99B8              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99B8              ;   (XOR) bit a bit.
   7+ 99B8              ;
   8+ 99B8              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99B8              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99B8
  11+ 99B8              Derivando_RND
  12+ 99B8
  13+ 99B8 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99BA C5               push bc
  15+ 99BB              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99BB 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99BE              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99BE
  19+ 99BE A7           6 and a                                 ; Carry a "0".
  20+ 99BF CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99C1 30 02            jr nc,1F
  22+ 99C3
  23+ 99C3 CB C1            set 0,c
  24+ 99C5
  25+ 99C5 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99C6 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99C8 5F               ld e,a
  28+ 99C9
  29+ 99C9 7A               ld a,d
  30+ 99CA E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99CC 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99CE
  33+ 99CE CB 3F            srl a
  34+ 99D0
  35+ 99D0 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99D1
  37+ 99D1 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99D2 28 04            jr z,4F
  39+ 99D4
  40+ 99D4 CB FF            set 7,a
  41+ 99D6 18 02            jr 5F
  42+ 99D8
  43+ 99D8 CB BF        4 res 7,a
  44+ 99DA
  45+ 99DA CB 21        5 sla c
  46+ 99DC 10 E0            djnz 6B
  47+ 99DE
  48+ 99DE 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99DF
  50+ 99DF 77               ld (hl),a
  51+ 99E0 23               inc hl
  52+ 99E1 C1               pop bc
  53+ 99E2 10 D4            djnz 3B
