 504+ C1F1              ;   -------------------------------------------------------------------------------------------
 505+ C1F1              ;
 506+ C1F1              ;   23/9/26
 507+ C1F1              ;
 508+ C1F1              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1F1              ;   _ Shield_sound_effect.
 510+ C1F1              ;
 511+ C1F1              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1F1              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1F1              ;
 514+ C1F1              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1F1              ;
 516+ C1F1              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1F1              ;
 518+ C1F1              ;   MODIFY: AF'y BC.
 519+ C1F1
 520+ C1F1              Play_Shield_sound_effect:
 521+ C1F1
 522+ C1F1 3A AE 96         ld a,(Shield_sound)
 523+ C1F4 A7               and a
 524+ C1F5 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1F6
 526+ C1F6 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1F8
 528+ C1F8              Loop_3:
 529+ C1F8
 530+ C1F8 08               ex af,af
 531+ C1F9
 532+ C1F9 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1FB D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1FD
 535+ C1FD 08               ex af,af
 536+ C1FE
 537+ C1FE 47               ld b,a
 538+ C1FF
 539+ C1FF 10 FE        Delay_7 djnz Delay_7
 540+ C201
 541+ C201 08               ex af,af
 542+ C202
 543+ C202 AF               xor a                   ; Black BORDER.
 544+ C203 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C205
 546+ C205 08               ex af,af
 547+ C206
 548+ C206 47               ld b,a
 549+ C207
 550+ C207 10 FE        Delay_8 djnz Delay_8
 551+ C209
 552+ C209 0D               dec c
 553+ C20A
 554+ C20A 20 EC            jr nz,Loop_3
 555+ C20C
 556+ C20C AF               xor a
 557+ C20D 32 AE 96         ld (Shield_sound),a
 558+ C210
 559+ C210 C9               ret
 560+ C211
 561+ C211              ; ---------------------------------------------------------------
 562+ C211              ;
 563+ C211              ;   18/9/26
 564+ C211              ;
 565+ C211              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C211              ;
 567+ C211              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C211              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C211              ;
 570+ C211              ;   MODIFY: A y H.
 571+ C211              ;
