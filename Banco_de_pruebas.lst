 655+ B5B2
 656+ B5B2 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 657+ B5B3 D6 20            sub $20             							; Vamos a comprobarlo...
 658+ B5B5 6F               ld l,a
