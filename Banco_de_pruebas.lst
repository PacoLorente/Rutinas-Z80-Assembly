   4+ 9D35              ;
   5+ 9D35              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D35              ;   (XOR) bit a bit.
   7+ 9D35              ;
   8+ 9D35              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D35              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D35
  11+ 9D35              Derivando_RND
  12+ 9D35
  13+ 9D35 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D37 C5               push bc
  15+ 9D38              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D38 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D3B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D3B
  19+ 9D3B A7           6 and a                                 ; Carry a "0".
  20+ 9D3C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D3E 30 02            jr nc,1F
  22+ 9D40
  23+ 9D40 CB C1            set 0,c
  24+ 9D42
  25+ 9D42 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D43 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D45 5F               ld e,a
  28+ 9D46
  29+ 9D46 7A               ld a,d
  30+ 9D47 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D49 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D4B
  33+ 9D4B CB 3F            srl a
  34+ 9D4D
