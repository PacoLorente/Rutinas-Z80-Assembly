 454+ ACEB
 455+ ACEB 5D           	ld e,l
 456+ ACEC 54           	ld d,h
 457+ ACED
 458+ ACED CD 65 B0     	call Parametros_de_bandeja_DRAW_a_Caja_Master	 				; Caja de entidades Master completa.
 459+ ACF0
 460+ ACF0              ;	Limpiamos la bandeja_DRAW y las variables de movimiento para poder generar los mov. masticados_
 461+ ACF0              ;	_de otro (Tipo) de entidad.
 462+ ACF0              ;
 463+ ACF0              ;	Limpiamos bandeja y variables.
 464+ ACF0
 465+ ACF0 AF           	xor a
 466+ ACF1 32 85 A5     	ld (Ctrl_3),a 													; (Ctrl_3) ha de inicializarse pués lo utilizamos para indicar_
 467+ ACF4              ;																	; _, (entre otras cosas) cuando finalizamos de generar los mov. masticados.
 468+ ACF4 21 12 A5     	ld hl,Clase
 469+ ACF7 01 3A 00     	ld bc,Gestion_de_ENTIDADES_y_CAJAS-Bandeja_DRAW
