1548  985B
1549  985B 4E           	ld c,(hl)
1550  985C
1551  985C              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1552  985C              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
