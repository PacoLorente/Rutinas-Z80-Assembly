   1+ 8B6C
   2+ 8B6C
   3+ 8B6C              ;   07/07/23
   4+ 8B6C              ;
   5+ 8B6C              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8B6C              ;
   7+ 8B6C              ;   Codificación:
   8+ 8B6C              ;
   9+ 8B6C              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8B6C              ;
  11+ 8B6C              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8B6C              ;
  13+ 8B6C              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8B6C              ;
  15+ 8B6C              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8B6C              ;
  17+ 8B6C              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8B6C              ;                               ..... %01000010 Vel_up 4
  19+ 8B6C              ;                                               Vel_down 2
  20+ 8B6C              ;                               ..... $42
  21+ 8B6C              ;
  22+ 8B6C              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8B6C              ;
  24+ 8B6C              ;                               ..... %01000010 Vel_left 4
  25+ 8B6C              ;                                               Vel_right 2
  26+ 8B6C              ;                               ..... $42
  27+ 8B6C              ;
  28+ 8B6C              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8B6C              ;
  30+ 8B6C              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8B6C              ;
  32+ 8B6C              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8B6C              ;
  34+ 8B6C              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8B6C              ;                                     $53
  36+ 8B6C              ;
  37+ 8B6C              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8B6C              ;
  39+ 8B6C              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8B6C              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8B6C              ;
  42+ 8B6C              ;                       Arriba ..... $81
  43+ 8B6C              ;                       Arriba - izquierda ..... $a1
  44+ 8B6C              ;                       Arriba - derecha ..... $91
  45+ 8B6C              ;
  46+ 8B6C              ;                       Abajo ..... $41
  47+ 8B6C              ;                       Abajo - izquierda ..... $61
  48+ 8B6C              ;                       Abajo - derecha ..... $51
  49+ 8B6C              ;
  50+ 8B6C              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8B6C              ;
  52+ 8B6C              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8B6C              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8B6C              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8B6C              ;
  56+ 8B6C              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8B6C              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8B6C              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8B6C              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8B6C              ;
  61+ 8B6C              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8B6C              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8B6C              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8B6C              ;
  65+ 8B6C              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8B6C              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8B6C              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8B6C              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8B6C
