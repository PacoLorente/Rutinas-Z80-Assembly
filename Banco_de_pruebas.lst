  56+ C5FF              ;	4/3/25
  57+ C5FF              ;
  58+ C5FF              ;	En 1er lugar identificamos si existe .db de CTRL, ($00).
  59+ C5FF              ;	Al .db de CTRL $00 le seguirá otro .db indicando el nº de .defw que compartirán nº aleatorio.
  60+ C5FF              ;
  61+ C5FF              ;	El siguiente .defw indica:
  62+ C5FF              ;
  63+ C5FF              ;	Byte alto: Límite superior que puede tener como máximo nuestro nº rnd.
  64+ C5FF              ;	Byte bajo: Límite inferior que puede tener como mínimo nuestro nº rnd.
  65+ C5FF              ;
  66+ C5FF              ;	Los sucesivos .defw indican la dirección o direcciones de memoria correspondientes donde se almacenará el nº aleatorio.
  67+ C5FF              ;
