   5+ 942A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 942A              ;   (XOR) bit a bit.
   7+ 942A              ;
   8+ 942A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 942A
  10+ 942A              Derivando_RND
  11+ 942A
  12+ 942A 21 F6 88         ld hl,Numeros_aleatorios
  13+ 942D
  14+ 942D ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 942F C5               push bc
  16+ 9430              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9430 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9433              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9433
  20+ 9433 A7           6 and a                                 ; Carry a "0".
  21+ 9434 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9436 30 02            jr nc,1F
  23+ 9438
  24+ 9438 CB C1            set 0,c
  25+ 943A
  26+ 943A 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 943B E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 943D 5F               ld e,a
  29+ 943E
  30+ 943E 7A               ld a,d
  31+ 943F E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9441 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9443
  34+ 9443 CB 3F            srl a
  35+ 9445
  36+ 9445 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9446
  38+ 9446 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9447 28 04            jr z,4F
  40+ 9449
  41+ 9449 CB FF            set 7,a
  42+ 944B 18 02            jr 5F
  43+ 944D
  44+ 944D CB BF        4 res 7,a
  45+ 944F
  46+ 944F CB 21        5 sla c
  47+ 9451 10 E0            djnz 6B
  48+ 9453
  49+ 9453 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9454
  51+ 9454 77               ld (hl),a
  52+ 9455 23               inc hl
  53+ 9456 C1               pop bc
  54+ 9457 10 D4            djnz 3B
  55+ 9459
  56+ 9459 C9               ret
