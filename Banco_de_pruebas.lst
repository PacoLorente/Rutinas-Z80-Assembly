 985+ B04A 08               ex af,af
 986+ B04B
 987+ B04B 0E 47            ld c,%01000111         ; (Attr). de los disparos.
 988+ B04D
 989+ B04D 06 07        3 ld b,7                           ; Nº máximo de disparos. Fuerza la salida del album cuando hemos pintado 7 veces_
 990+ B04F              ;                                      _ aunque IYL+IYH+E no sea "0". (No hay separacíon entre el álbum de borrado y el de pintado).
 991+ B04F              ;                                      _ No encontraría "0".
 992+ B04F
 993+ B04F FD E1        4 pop iy
 994+ B051 D1               pop de                              ; 1er .db IYL
 995+ B052              ;                                      ; 2º  .db IYH
 996+ B052              ;                                      ; 3er .db E.
 997+ B052              ;                                      ; .db que pintan el disparo, ej.: $18 $00 $00, (Puntero_objeto) del disparo, 3 .db's.
 998+ B052
 999+ B052              ;   Album vacío ???
1000+ B052
1001+ B052 FD 7D            ld a,iyl
1002+ B054 FD 84            add iyh
1003+ B056 83               add e
1004+ B057 28 38            jr z,1F                          ; Álbum vacío salta a 1F.
