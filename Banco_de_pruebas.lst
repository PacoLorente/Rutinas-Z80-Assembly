 175+ C14A              Make_Score_max_msg:
 176+ C14A
 177+ C14A              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 178+ C14A
 179+ C14A              ;   Necesito fabricar un msg. con la máxima puntuación.
 180+ C14A              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 181+ C14A
 182+ C14A 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 183+ C14D 21 C7 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 184+ C150              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 185+ C150 11 D6 94         ld de,Score_max_msg
 186+ C153
 187+ C153              KEY_CODE_de_BCD:
 188+ C153
 189+ C153 7E           1 ld a,(hl)
