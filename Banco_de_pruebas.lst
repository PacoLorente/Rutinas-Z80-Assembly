   4+ 94B0              ;
   5+ 94B0              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 94B0              ;   (XOR) bit a bit.
   7+ 94B0              ;
   8+ 94B0              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 94B0              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 94B0
  11+ 94B0              Derivando_RND
  12+ 94B0
  13+ 94B0 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94B2 C5               push bc
  15+ 94B3              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94B3 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94B6              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94B6
  19+ 94B6 A7           6 and a                                 ; Carry a "0".
  20+ 94B7 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94B9 30 02            jr nc,1F
  22+ 94BB
  23+ 94BB CB C1            set 0,c
  24+ 94BD
  25+ 94BD 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94BE E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94C0 5F               ld e,a
  28+ 94C1
  29+ 94C1 7A               ld a,d
  30+ 94C2 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94C4 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94C6
  33+ 94C6 CB 3F            srl a
  34+ 94C8
  35+ 94C8 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 94C9
  37+ 94C9 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 94CA 28 04            jr z,4F
  39+ 94CC
  40+ 94CC CB FF            set 7,a
  41+ 94CE 18 02            jr 5F
  42+ 94D0
  43+ 94D0 CB BF        4 res 7,a
  44+ 94D2
  45+ 94D2 CB 21        5 sla c
  46+ 94D4 10 E0            djnz 6B
  47+ 94D6
  48+ 94D6 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94D7
  50+ 94D7 77               ld (hl),a
  51+ 94D8 23               inc hl
  52+ 94D9 C1               pop bc
  53+ 94DA 10 D4            djnz 3B
  54+ 94DC
  55+ 94DC C9               ret
