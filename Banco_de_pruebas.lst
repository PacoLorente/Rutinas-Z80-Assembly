 303  8E64 00           Incrementa_puntero_backup db 0
 304  8E65 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 305  8E66              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8E66
 307  8E66 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8E67 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8E68 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8E69
 311  8E69              ;
 312  8E69              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8E69              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8E69              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8E69              ;
 316  8E69              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8E69              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8E69              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8E69              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8E69              ;
 321  8E69              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8E69              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8E69              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8E69
 325  8E69 00           Ctrl_1 db 0 												; Byte de control de propósito general.
