 614+ B1C2
 615+ B1C2 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B1C3 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B1C5 6F               ld l,a
