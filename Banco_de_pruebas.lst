 555+ 9ED9              ;
 556+ 9ED9              ;   17/9/26
 557+ 9ED9              ;
 558+ 9ED9              ;   Herramienta para construir melodías y ruido con el SPEAKER.
 559+ 9ED9
 560+ 9ED9              Sound_Generator:
 561+ 9ED9
 562+ 9ED9              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 563+ 9ED9              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 564+ 9ED9              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 565+ 9ED9              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 566+ 9ED9              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 567+ 9ED9              ;
 568+ 9ED9
 569+ 9ED9              ;   MODIFY: A,HL,BC y DE.
 570+ 9ED9
 571+ 9ED9              ;   Exclusión:
 572+ 9ED9
 573+ 9ED9 2A 78 94         ld hl,(Sound)
 574+ 9EDC 7C               ld a,h
 575+ 9EDD B5               or l
 576+ 9EDE C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 577+ 9EDF
 578+ 9EDF 04               inc b
 579+ 9EE0 05               dec b
 580+ 9EE1 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
 581+ 9EE3
 582+ 9EE3              Loop_2:
 583+ 9EE3
 584+ 9EE3              ;   %xxxabccc
 585+ 9EE3
 586+ 9EE3              ;   %a ... Salida SPEAKER.
 587+ 9EE3              ;   %b ... MIC/EAR.
 588+ 9EE3              ;   %c ... BORDER Colour.
 589+ 9EE3
 590+ 9EE3
 591+ 9EE3 3E 10            ld a,%00010000          ; Borde negro.
 592+ 9EE5 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 593+ 9EE7
 594+ 9EE7              Delay_5:
 595+ 9EE7
 596+ 9EE7 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 597+ 9EE8
 598+ 9EE8 7C               ld a,h
 599+ 9EE9 B5               or l
 600+ 9EEA 20 FB            jr nz,Delay_5
 601+ 9EEC
 602+ 9EEC 2A 78 94         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 603+ 9EEF
 604+ 9EEF AF               xor a                   ; Borde negro.    ---     4 tstates
 605+ 9EF0 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 606+ 9EF2
 607+ 9EF2              Delay_6:
 608+ 9EF2
 609+ 9EF2 2B               dec hl
 610+ 9EF3
 611+ 9EF3 7C               ld a,h
 612+ 9EF4 B5               or l
 613+ 9EF5 20 FB            jr nz,Delay_6
 614+ 9EF7
 615+ 9EF7              ; Hemos generado una onda sonora.
 616+ 9EF7              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 617+ 9EF7
 618+ 9EF7 2A 78 94         ld hl,(Sound)
 619+ 9EFA
 620+ 9EFA 1C               inc e
 621+ 9EFB 1D               dec e
 622+ 9EFC 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 623+ 9EFE              ;                           ; (E)="0" indica que no hay variación en el tono.
 624+ 9EFE
 625+ 9EFE 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 626+ 9EFF 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 627+ 9F00
 628+ 9F00              ; Rayo de entrada o de salida ???
 629+ 9F00
 630+ 9F00 A7               and a
 631+ 9F01 20 05            jr nz,Incrementa_delay
 632+ 9F03
 633+ 9F03              Decrementa_delay:
 634+ 9F03
 635+ 9F03 2B               dec hl
 636+ 9F04 10 FD            djnz Decrementa_delay
 637+ 9F06
 638+ 9F06 18 03            jr 1F
 639+ 9F08
 640+ 9F08              Incrementa_delay:
 641+ 9F08
 642+ 9F08 23               inc hl
 643+ 9F09 10 FD            djnz Incrementa_delay
 644+ 9F0B
 645+ 9F0B              ; Descontamos la onda generada del total de ondas que tiene el efecto, (Sound).
 646+ 9F0B
 647+ 9F0B 0D           1 dec c                     ; Decrementa nº de ondas.
 648+ 9F0C
 649+ 9F0C 22 78 94         ld (Sound),hl
 650+ 9F0F
 651+ 9F0F 20 D2            jr nz,Loop_2
 652+ 9F11
 653+ 9F11 C9               ret
 654+ 9F12
 655+ 9F12              ;   Efecto de ruido, se puede utilizar, (entre otras cosas) para generar explosiones, disparos, etc.
 656+ 9F12              ;   Este tipo de onda NO ES SIMÉTRICA, el semiciclo positivo y el negativo tienen una duración distinta.
 657+ 9F12              ;   Cada onda completa que compone el sonido es distinta a la anterior siendo el registro (C) el que contiene el_
 658+ 9F12              ;   _nº de ondas que vamos a ejecutar.
 659+ 9F12              ;   El registro R proporciona el nº pseudo aleatorio que construye los dos semiciclos de la onda.
 660+ 9F12
 661+ 9F12              Noise_efect:
 662+ 9F12
 663+ 9F12              Loop:
 664+ 9F12
 665+ 9F12 ED 5F            ld a,r
 666+ 9F14 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 667+ 9F15
 668+ 9F15 3E 10            ld a,%00010000          ; Borde negro.
 669+ 9F17 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 670+ 9F19
 671+ 9F19 10 FE        Delay_1 djnz Delay_1        ; Aplica Delay.
 672+ 9F1B
 673+ 9F1B AF               xor a
 674+ 9F1C D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 675+ 9F1E
 676+ 9F1E ED 5F            ld a,r
 677+ 9F20 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 678+ 9F21
 679+ 9F21 10 FE        Delay_2 djnz Delay_2        ; Aplica Delay.
 680+ 9F23
 681+ 9F23 25               dec h
 682+ 9F24
 683+ 9F24 0D               dec c                   ; Decrementa ondas completas generadas.
 684+ 9F25
 685+ 9F25 20 EB            jr nz,Loop
 686+ 9F27
 687+ 9F27 22 78 94         ld (Sound),hl
 688+ 9F2A
 689+ 9F2A C9               ret
 690+ 9F2B
