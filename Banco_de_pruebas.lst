   1+ A3A8              ; *********************************** Limpia la pantalla, CLEAR SCREEN ****************************************************************
   2+ A3A8              ;
   3+ A3A8              ;
   4+ A3A8              ;	CLS.
   5+ A3A8              ;
   6+ A3A8              ;	Limpia la pantalla y define sus atributos.
   7+ A3A8              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A3A8              ;
   9+ A3A8              ;	COLORES: 0 ..... NEGRO
  10+ A3A8              ;    		 1 ..... AZUL
  11+ A3A8              ; 			 2 ..... ROJO
  12+ A3A8              ;			 3 ..... MAGENTA
  13+ A3A8              ; 			 4 ..... VERDE
  14+ A3A8              ; 			 5 ..... CIAN
  15+ A3A8              ;			 6 ..... AMARILLO
  16+ A3A8              ; 			 7 ..... BLANCO
  17+ A3A8              ;
  18+ A3A8              ;	INPUT: A contiene los atributos de pantalla.
  19+ A3A8              ;
  20+ A3A8              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A3A8
  22+ A3A8
  23+ A3A8 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A3AB 11 01 40     	LD DE,$4001
  25+ A3AE 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A3B1 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A3B3 ED B0        	LDIR
  28+ A3B5 01 FF 02     	LD BC,767
  29+ A3B8 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A3B9 ED B0        	LDIR
  31+ A3BB
  32+ A3BB AF           	xor a
  33+ A3BC
  34+ A3BC C9           	ret
  35+ A3BD
