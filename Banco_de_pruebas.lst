 771  D327
 772  D327              ;	Por encima o igual que (Max_time_to_appear_entities).
 773  D327
 774  D327 4E           	ld c,(hl)
 775  D328 18 06        	jr 2F
 776  D32A
 777  D32A              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
 778  D32A              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
 779  D32A
 780  D32A 23           1 inc hl
