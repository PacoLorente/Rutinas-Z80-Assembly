 267+ C11B 21 17 01     	ld hl,$0117
 268+ C11E
 269+ C11E 22 06 96     	ld (Sound),hl
 270+ C121 CD 67 9F         call Sound_Generator 									; PLAY NOTE.
 271+ C124
 272+ C124              Note_13:
 273+ C124
 274+ C124 0E 14         	ld c,$14                                                ; Duración.
 275+ C126 1E 03            ld e,3                                                  ; (D)="0" / Decrease "3".
 276+ C128              ;                                                           ; (HL) down to $00db, (Note).
 277+ C128 22 06 96     	ld (Sound),hl
 278+ C12B CD 67 9F         call Sound_Generator 	                                ; PLAY NOTE.
 279+ C12E
 280+ C12E              Note_14:
 281+ C12E
