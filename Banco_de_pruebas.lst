 325  90D3 00           Incrementa_puntero_backup db 0
 326  90D4 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 327  90D5              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 328  90D5
 329  90D5 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 330  90D6 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 331  90D7 00           Cola_de_desplazamiento db 0									; Este byte indica:
 332  90D8
 333  90D8              ;
 334  90D8              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 335  90D8              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 336  90D8              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 337  90D8              ;
 338  90D8              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 339  90D8              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 340  90D8              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 341  90D8              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 342  90D8              ;
 343  90D8              ;															;	"$ff" ..... Bucle infinito de repetición.
 344  90D8              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 345  90D8              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 346  90D8
 347  90D8 00           Ctrl_1 db 0 												; Byte de control de propósito general.
