   1+ 9E38              ; ******************************************************************************************************************************************************************************************
   2+ 9E38              ;
   3+ 9E38              ;   6/11/26
   4+ 9E38              ;
   5+ 9E38              ;   Construyo un nº pseudo aleatorio. Método "DERIVANDO":
   6+ 9E38              ;
   7+ 9E38              ;   Inicialmente nuestra semilla será la contenida en el registro R. A partir de ahí irá mutando y la almacenaremos en la variable: (Semilla).
   8+ 9E38              ;
   9+ 9E38              ;   Para construir nuestro n° pseudo aleatorio necesitamos 8 bits que iremos adquiriendo del último bit, (bit_0) de la semilla.
  10+ 9E38              ;
  11+ 9E38              ;   Después de adquirir el bit de la semilla, desplazamos a la derecha los bits de la misma y realizamos una función lógica XOR entre los_
  12+ 9E38              ;   _ bits 0 y 1, (los dos últimos).
  13+ 9E38              ;
  14+ 9E38              ;   Si el resultado de la operación XOR es "1" pondremos a "1" el bit_7 de la semilla. Si es "0" no realizamos cambios.
  15+ 9E38              ;
  16+ 9E38              ;   Desplazamos los bits del número que estamos generando una posición a la izquierda con el fin de adquirir un nuevo bit de la semilla.
  17+ 9E38              ;
  18+ 9E38              ;   Repetimos proceso hasta que hayamos adquirido los 8 bits necesarios de la semilla.
  19+ 9E38              ;
  20+ 9E38              ;   Guardamos la semilla en la variable (Semilla) y el número generado en (HL).
  21+ 9E38              ;
  22+ 9E38              ;   Incrementamos el puntero HL para situarlo en la siguiente dirección de memoria, (donde almacenaremos el siguiente n° pseudo aleatorio a generar).
  23+ 9E38              ;
  24+ 9E38              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
  25+ 9E38              ;          HL contendrá la dirección de mem. donde vamos a almacenar el 1er n° de los (B) números pseudo aleatorios a generar.
  26+ 9E38              ;
  27+ 9E38              ;   MODIFY: (Semilla), AF, HL, DE y B.
  28+ 9E38
  29+ 9E38              Derivando_RND:
  30+ 9E38
  31+ 9E38              ;   En 1er lugar comprobamos si disponemos de semilla.
  32+ 9E38
  33+ 9E38 3A 84 96         ld a,(Semilla)
  34+ 9E3B
  35+ 9E3B A7               and a
  36+ 9E3C
  37+ 9E3C 20 02            jr nz,Semilla_iniciada
  38+ 9E3E
  39+ 9E3E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  40+ 9E3E ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  41+ 9E40
  42+ 9E40              Semilla_iniciada:
  43+ 9E40
  44+ 9E40 57               ld d,a                              ; A partir de ahora, (D) contendrá nuestra semilla.
  45+ 9E41
  46+ 9E41 C5               push bc                             ; PUSH N° de números que queremos generar.
  47+ 9E42
  48+ 9E42 01 00 08         ld bc,$0800                         ; C contendrá nuestro nº aleatorio: ($0 - $ff). Inicialmente está a "0".
  49+ 9E45              ;                                       ; B actuará como contador de bits, (números de bits a generar), 8 bits.
  50+ 9E45
  51+ 9E45 CB 21        3 sla c                                 ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  52+ 9E47
  53+ 9E47 7A               ld a,d
  54+ 9E48
  55+ 9E48              ;   El último bit de la semilla, (bit_0) será el 1° del número pseudo aleatorio generado, (bit_7).
  56+ 9E48
  57+ 9E48 E6 01            and %00000001
  58+ 9E4A
  59+ 9E4A 28 02            jr z,4F
  60+ 9E4C
  61+ 9E4C CB C1            set 0,c                             ; One bit generated.
  62+ 9E4E
  63+ 9E4E              ;   Rotamos los bits de la semilla una posición a la derecha.
  64+ 9E4E
  65+ 9E4E CB 1A        4  rr d                                 ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  66+ 9E50
  67+ 9E50 7A               ld a,d
  68+ 9E51
  69+ 9E51              Xor_bit_1_bit_2:
  70+ 9E51
  71+ 9E51 E6 01            and %00000001                       ; Bit_0 en (E).
  72+ 9E53 5F               ld e,a
  73+ 9E54
  74+ 9E54 7A               ld a,d
  75+ 9E55 E6 02            and %00000010                       ; Bit_1 en (A).
  76+ 9E57
  77+ 9E57 28 02            jr z,1F
  78+ 9E59
  79+ 9E59 3E 01            ld a,1
  80+ 9E5B
  81+ 9E5B AB           1 xor e
  82+ 9E5C
  83+ 9E5C              ;   FUNCIÓN XOR entre el bit_0 y el bit_1 de la semilla después de una rotación de 1 bit a la derecha.
  84+ 9E5C
  85+ 9E5C              ;   0 0 ..... 0
  86+ 9E5C              ;   0 1 ..... 1
  87+ 9E5C              ;   1 0 ..... 1
  88+ 9E5C              ;   1 1 ..... 0
  89+ 9E5C
  90+ 9E5C 28 02            jr z,2F
  91+ 9E5E
  92+ 9E5E CB FA            set 7,d                             ; Cuando la función XOR entre los dos últimos bits de la semilla resulta "1",_
  93+ 9E60              ;                                       ; _ seteamos a "1" el bit_7 de la misma.
  94+ 9E60
  95+ 9E60 10 E3        2 djnz 3B
  96+ 9E62
  97+ 9E62              Number_generated:
  98+ 9E62
  99+ 9E62 7A               ld a,d
 100+ 9E63
 101+ 9E63 32 84 96         ld (Semilla),a                      ; Guarda la evolución de la semilla para seguir generando números.
 102+ 9E66
 103+ 9E66 71               ld (hl),c                           ; Guardamos el número pseudo aleatorio generado en su correspondiente dirección de memoria.
 104+ 9E67
 105+ 9E67 23               inc hl                              ; HL apunta a la dirección de memoria donde vamos a guardar el siguiente número a generar.
 106+ 9E68
 107+ 9E68 C1               pop bc
 108+ 9E69
 109+ 9E69 10 CD            djnz Derivando_RND
 110+ 9E6B
 111+ 9E6B C9               ret
