3236  A008              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A008              ; ******************************************************************************************************************************************************************************************
   2+ A008              ;
   3+ A008              ;   3/4/25
   4+ A008              ;
   5+ A008              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A008              ;   (XOR) bit a bit.
   7+ A008              ;
   8+ A008              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A008              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A008
  11+ A008              Derivando_RND
  12+ A008
  13+ A008 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A00A C5               push bc
  15+ A00B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A00B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A00E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A00E
  19+ A00E A7           6 and a                                 ; Carry a "0".
  20+ A00F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A011 30 02            jr nc,1F
  22+ A013
  23+ A013 CB C1            set 0,c
  24+ A015
  25+ A015 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A016 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A018 5F               ld e,a
  28+ A019
  29+ A019 7A               ld a,d
  30+ A01A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A01C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A01E
  33+ A01E CB 3F            srl a
  34+ A020
  35+ A020 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A021
  37+ A021 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A022 28 04            jr z,4F
  39+ A024
  40+ A024 CB FF            set 7,a
  41+ A026 18 02            jr 5F
  42+ A028
  43+ A028 CB BF        4 res 7,a
  44+ A02A
  45+ A02A CB 21        5 sla c
  46+ A02C 10 E0            djnz 6B
  47+ A02E
  48+ A02E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A02F
  50+ A02F 77               ld (hl),a
  51+ A030 23               inc hl
  52+ A031 C1               pop bc
  53+ A032 10 D4            djnz 3B
  54+ A034
  55+ A034 C9               ret
  56+ A035
  57+ A035
  58+ A035
# file closed: RND_Derivando.asm
