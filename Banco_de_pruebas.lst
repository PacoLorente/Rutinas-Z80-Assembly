 352+ C129              ; ----- ----- ----- ----- -----
 353+ C129              ;
 354+ C129              ;   23/9/26
 355+ C129              ;
 356+ C129              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C129              ;
 358+ C129              ;   HL define el sonido.
 359+ C129              ;
 360+ C129              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C129              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C129              ;
 363+ C129              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C129              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C129              ;
 366+ C129              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C129              ;
 368+ C129              ;   INPUTS: (Shot_sound) <> "0".
 369+ C129              ;
 370+ C129              ;   MODIFY: AF, HL y BC.
 371+ C129              ;
 372+ C129              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C129
 374+ C129              Play_shot_sound_effect:
 375+ C129
 376+ C129              ;   Exclusiones:
 377+ C129
 378+ C129 2A 0A 96         ld hl,(Shot_sound)
 379+ C12C 7C               ld a,h
 380+ C12D B5               or l
 381+ C12E C8               ret z                   ; RET si no se ha producido disparo.
 382+ C12F
 383+ C12F 3A DD 95         ld a,(Ctrl_6)
 384+ C132 CB 47            bit 0,a
 385+ C134 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C135
 387+ C135 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C137
 389+ C137              Loop_1:
 390+ C137
 391+ C137 3E 10            ld a,%00010000          ; Borde negro.
 392+ C139 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C13B
 394+ C13B 45               ld b,l
 395+ C13C
 396+ C13C 10 FE        Delay_3 djnz Delay_3
 397+ C13E
 398+ C13E AF               xor a                   ; Borde negro.
 399+ C13F D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C141
 401+ C141 45               ld b,l
 402+ C142
 403+ C142 10 FE        Delay_4 djnz Delay_4
 404+ C144
 405+ C144              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
