 825+ B5C4              ;   PreviousScan.
 826+ B5C4              ;
 827+ B5C4              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B5C4              ;
 829+ B5C4              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B5C4              ;
 831+ B5C4              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B5C4              ;
 833+ B5C4              ;       DESTRUIDOS: AF y HL !!!
 834+ B5C4              ;
 835+ B5C4              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B5C4              ;
 837+ B5C4
 838+ B5C4              PreviousScan:
 839+ B5C4
 840+ B5C4 7C           	ld a,h
 841+ B5C5 25               dec h               							; Dec H.
 842+ B5C6 E6 07            and 7
 843+ B5C8 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B5C9
 845+ B5C9 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B5CA D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B5CC 6F               ld l,a
 848+ B5CD D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B5CE
 850+ B5CE 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B5CF C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B5D1 67               ld h,a
 853+ B5D2 C9               ret
