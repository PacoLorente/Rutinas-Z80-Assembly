 399+ A2CC
 400+ A2CC 79           	ld a,c 															; (A) = (Clase).
 401+ A2CD 32 B7 93     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A2D0
 403+ A2D0 CD C5 A5     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
