 470+ C155 08               ex af,af                ; Restore (Burst_sound).
 471+ C156
 472+ C156 67               ld h,a
 473+ C157 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C159
 475+ C159 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C15A
 477+ C15A 22 84 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C15D 0E 03            ld c,3
