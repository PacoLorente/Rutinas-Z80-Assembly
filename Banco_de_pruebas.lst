3249  A056              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A056              ; ******************************************************************************************************************************************************************************************
   2+ A056              ;
   3+ A056              ;   3/4/25
   4+ A056              ;
   5+ A056              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A056              ;   (XOR) bit a bit.
   7+ A056              ;
   8+ A056              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A056              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A056
  11+ A056              Derivando_RND
  12+ A056
  13+ A056 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A058 C5               push bc
  15+ A059              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A059 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A05C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A05C
  19+ A05C A7           6 and a                                 ; Carry a "0".
  20+ A05D CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A05F 30 02            jr nc,1F
  22+ A061
  23+ A061 CB C1            set 0,c
  24+ A063
  25+ A063 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A064 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A066 5F               ld e,a
  28+ A067
  29+ A067 7A               ld a,d
  30+ A068 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A06A 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A06C
  33+ A06C CB 3F            srl a
  34+ A06E
  35+ A06E AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A06F
  37+ A06F 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A070 28 04            jr z,4F
  39+ A072
  40+ A072 CB FF            set 7,a
  41+ A074 18 02            jr 5F
  42+ A076
  43+ A076 CB BF        4 res 7,a
  44+ A078
  45+ A078 CB 21        5 sla c
  46+ A07A 10 E0            djnz 6B
  47+ A07C
  48+ A07C 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A07D
  50+ A07D 77               ld (hl),a
  51+ A07E 23               inc hl
  52+ A07F C1               pop bc
  53+ A080 10 D4            djnz 3B
  54+ A082
  55+ A082 C9               ret
  56+ A083
  57+ A083
  58+ A083
# file closed: RND_Derivando.asm
