   1+ 9489              ; ******************************************************************************************************************************************************************************************
   2+ 9489              ;
   3+ 9489              ;   21/04/24
   4+ 9489              ;
   5+ 9489              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9489              ;   (XOR) bit a bit.
   7+ 9489              ;
   8+ 9489              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9489
  10+ 9489              Derivando_RND
  11+ 9489
  12+ 9489 21 F6 88         ld hl,Numeros_aleatorios
  13+ 948C
  14+ 948C ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 948E C5               push bc
  16+ 948F              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 948F 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9492              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9492
  20+ 9492 A7           6 and a                                 ; Carry a "0".
  21+ 9493 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9495 30 02            jr nc,1F
  23+ 9497
  24+ 9497 CB C1            set 0,c
  25+ 9499
  26+ 9499 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 949A E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 949C 5F               ld e,a
  29+ 949D
