  28+ 97FF 01 FF 02     	LD BC,767
  29+ 9802 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 9803 ED B0        	LDIR
  31+ 9805 C9           	ret
