 120+ C08C              ;
 121+ C08C              ;   26/09/26
 122+ C08C              ;
 123+ C08C              ;   Melodía DONE. NIVEL SUPERADO !!!
 124+ C08C              ;
 125+ C08C              ;   La melodía DONE se ejecuta en DI, (interrupciones deshabilitadas).
 126+ C08C              ;
 127+ C08C              ;   Está compuesta por 15 notes y 5 pausas.
 128+ C08C              ;
 129+ C08C              ;   Hay que introducir los parámetros de cada nota que forma la melodía y llamar a la función de sonido [Sound_Generator].
 130+ C08C              ;   Los parámetros son:
 131+ C08C              ;
 132+ C08C              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido, (duración de la nota).
 133+ C08C              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 134+ C08C              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 135+ C08C              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 136+ C08C              ;          HL = (NOTA). Duracíon del semiciclo.
 137+ C08C              ;
 138+ C08C              ;   MODIFY: NO MODIFY REGS. !!!
 139+ C08C
 140+ C08C              Done_melody:
 141+ C08C
 142+ C08C F5               push af
 143+ C08D C5               push bc
 144+ C08E D5               push de
 145+ C08F E5               push hl                                                 ; Store regs.
