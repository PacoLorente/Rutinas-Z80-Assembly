 338  90D5 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 339  90D6 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 340  90D7 00           Cola_de_desplazamiento db 0									; Este byte indica:
 341  90D8
 342  90D8              ;
 343  90D8              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 344  90D8              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 345  90D8              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 346  90D8              ;
 347  90D8              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 348  90D8              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 349  90D8              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 350  90D8              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 351  90D8              ;
 352  90D8              ;															;	"$ff" ..... Bucle infinito de repetición.
 353  90D8              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 354  90D8              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 355  90D8
