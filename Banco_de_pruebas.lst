 383+ C2EC              ;   ds 1
 384+ C2EC              ;
 385+ C2EC              ;   Hemos creado una tabla de punteros con los .defw que contienen los datos necesarios para definir e imprimir_
 386+ C2EC              ;   _ cada uno de los 4 controles.
 387+ C2EC              ;
 388+ C2EC              ;   Los datos son los siguientes:
 389+ C2EC              ;
 390+ C2EC              ;   Left_key_parameters: defw b1                                ; Cadena de texto: "LEFT".
 391+ C2EC              ;       defw Line_12 + 12                                       ; Dirección de pantalla, Fila 12, columna 12.
 392+ C2EC              ;       defw Move_LEFT
