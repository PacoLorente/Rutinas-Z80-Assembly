 312+ C13C              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C13C              ;
 314+ C13C              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C13C
 316+ C13C              BEEP:
 317+ C13C
 318+ C13C F5               push af
 319+ C13D C5               push bc
 320+ C13E D5               push de
 321+ C13F E5               push hl                                 ; STORE Regs.
 322+ C140
 323+ C140              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C140
 325+ C140              ;   Configuración de un BEEP.
 326+ C140
 327+ C140              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C140              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C140              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C140              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C140              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C140
 333+ C140
 334+ C140 01 02 00         ld bc,$0002
 335+ C143 11 00 00         ld de,0
 336+ C146 21 D0 00         ld hl,$00d0
 337+ C149
 338+ C149 22 B6 94         ld (Sound),hl
 339+ C14C
 340+ C14C CD 20 9F         call Sound_Generator    ; v2. Ok.
 341+ C14F
 342+ C14F 21 00 00         ld hl,0
 343+ C152 22 B6 94         ld (Sound),hl
 344+ C155
 345+ C155 E1               pop hl                                  ; RECOVERY Regs.
 346+ C156 D1               pop de
 347+ C157 C1               pop bc
 348+ C158 F1               pop af
 349+ C159
 350+ C159 C9               ret
 351+ C15A
 352+ C15A              ; ----- ----- ----- ----- -----
 353+ C15A              ;
 354+ C15A              ;   23/9/26
 355+ C15A              ;
 356+ C15A              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C15A              ;
 358+ C15A              ;   HL define el sonido.
 359+ C15A              ;
 360+ C15A              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C15A              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C15A              ;
 363+ C15A              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C15A              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C15A              ;
 366+ C15A              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C15A              ;
 368+ C15A              ;   INPUTS: (Shot_sound) <> "0".
 369+ C15A              ;
 370+ C15A              ;   MODIFY: AF, HL y BC.
 371+ C15A              ;
 372+ C15A              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C15A
 374+ C15A              Play_shot_sound_effect:
 375+ C15A
 376+ C15A              ;   Exclusiones:
 377+ C15A
 378+ C15A 2A BA 94         ld hl,(Shot_sound)
 379+ C15D 7C               ld a,h
 380+ C15E B5               or l
 381+ C15F C8               ret z                   ; RET si no se ha producido disparo.
 382+ C160
 383+ C160 3A 8D 94         ld a,(Ctrl_6)
 384+ C163 CB 47            bit 0,a
 385+ C165 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C166
 387+ C166 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C168
 389+ C168              Loop_1:
 390+ C168
 391+ C168 3E 10            ld a,%00010000          ; Borde negro.
 392+ C16A D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C16C
 394+ C16C 45               ld b,l
 395+ C16D
 396+ C16D 10 FE        Delay_3 djnz Delay_3
 397+ C16F
 398+ C16F AF               xor a                   ; Borde negro.
 399+ C170 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C172
 401+ C172 45               ld b,l
 402+ C173
 403+ C173 10 FE        Delay_4 djnz Delay_4
 404+ C175
 405+ C175              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C175
 407+ C175 2C               inc l
 408+ C176 2C               inc l
 409+ C177 2C               inc l
 410+ C178 2C               inc l
 411+ C179
 412+ C179 25               dec h
 413+ C17A
 414+ C17A CC 84 C1         call z,Clean_shot_effect
 415+ C17D
 416+ C17D 0D               dec c
 417+ C17E
 418+ C17E 20 E8            jr nz,Loop_1
 419+ C180
 420+ C180 22 BA 94         ld (Shot_sound),hl
 421+ C183
 422+ C183 C9               ret
 423+ C184
 424+ C184              Clean_shot_effect:
 425+ C184
 426+ C184 21 00 00         ld hl,0
 427+ C187 0E 01            ld c,1
 428+ C189
 429+ C189 C9               ret
 430+ C18A
 431+ C18A              ;   -------------------------------------------------------------------------------------------
 432+ C18A              ;
 433+ C18A              ;   23/9/26
 434+ C18A              ;
 435+ C18A              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C18A              ;
 437+ C18A              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C18A              ;   _ [Sound_Generator].
 439+ C18A              ;
 440+ C18A              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C18A              ;
 442+ C18A              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C18A              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C18A              ;
 445+ C18A              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C18A              ;
 447+ C18A              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C18A              ;
 449+ C18A              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C18A
 451+ C18A              Play_burst_sound_effect:
 452+ C18A
 453+ C18A              ;   Exclusiones:
 454+ C18A
 455+ C18A 3A BC 94         ld a,(Burst_sound)
 456+ C18D A7               and a
 457+ C18E C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C18F
 459+ C18F 08               ex af,af
 460+ C190
 461+ C190 3A 8D 94         ld a,(Ctrl_6)
 462+ C193 CB 47            bit 0,a
 463+ C195 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C196
 465+ C196              ;   ----------------------
 466+ C196
 467+ C196 CB C7            set 0,a
 468+ C198 32 8D 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C19B
 470+ C19B 08               ex af,af                ; Restore (Burst_sound).
 471+ C19C
 472+ C19C 67               ld h,a
 473+ C19D 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C19F
 475+ C19F E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1A0
 477+ C1A0 22 B6 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1A3 0E 03            ld c,3
 479+ C1A5 CD 59 9F         call Noise_efect
 480+ C1A8
 481+ C1A8 D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1A9
 483+ C1A9 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1AA 94               sub h
 485+ C1AB
 486+ C1AB 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1AD
 488+ C1AD 7C               ld a,h
 489+ C1AE 32 BC 94         ld (Burst_sound),a
 490+ C1B1
 491+ C1B1 C9               ret
 492+ C1B2
 493+ C1B2              Clean_burst_efect:
 494+ C1B2
 495+ C1B2 AF               xor a
 496+ C1B3 32 BC 94         ld (Burst_sound),a
 497+ C1B6
 498+ C1B6 3A 8D 94         ld a,(Ctrl_6)
 499+ C1B9 CB 87            res 0,a
 500+ C1BB 32 8D 94         ld (Ctrl_6),a
 501+ C1BE
 502+ C1BE C9               ret
 503+ C1BF
 504+ C1BF              ;   -------------------------------------------------------------------------------------------
 505+ C1BF              ;
 506+ C1BF              ;   23/9/26
 507+ C1BF              ;
 508+ C1BF              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1BF              ;   _ Shield_sound_effect.
 510+ C1BF              ;
 511+ C1BF              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1BF              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1BF              ;
 514+ C1BF              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1BF              ;
 516+ C1BF              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1BF              ;
 518+ C1BF              ;   MODIFY: AF'y BC.
 519+ C1BF
 520+ C1BF              Play_Shield_sound_effect:
 521+ C1BF
 522+ C1BF 3A BD 94         ld a,(Shield_sound)
 523+ C1C2 A7               and a
 524+ C1C3 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1C4
 526+ C1C4 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1C6
 528+ C1C6              Loop_3:
 529+ C1C6
 530+ C1C6 08               ex af,af
 531+ C1C7
 532+ C1C7 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1C9 D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1CB
 535+ C1CB 08               ex af,af
 536+ C1CC
 537+ C1CC 47               ld b,a
 538+ C1CD
 539+ C1CD 10 FE        Delay_7 djnz Delay_7
 540+ C1CF
 541+ C1CF 08               ex af,af
 542+ C1D0
 543+ C1D0 AF               xor a                   ; Black BORDER.
 544+ C1D1 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1D3
 546+ C1D3 08               ex af,af
 547+ C1D4
 548+ C1D4 47               ld b,a
 549+ C1D5
 550+ C1D5 10 FE        Delay_8 djnz Delay_8
 551+ C1D7
 552+ C1D7 0D               dec c
 553+ C1D8
 554+ C1D8 20 EC            jr nz,Loop_3
 555+ C1DA
 556+ C1DA AF               xor a
 557+ C1DB 32 BD 94         ld (Shield_sound),a
 558+ C1DE
 559+ C1DE C9               ret
 560+ C1DF
 561+ C1DF              ; ---------------------------------------------------------------
 562+ C1DF              ;
 563+ C1DF              ;   18/9/26
 564+ C1DF              ;
 565+ C1DF              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C1DF              ;
 567+ C1DF              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C1DF              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C1DF              ;
 570+ C1DF              ;   MODIFY: A y H.
 571+ C1DF              ;
 572+ C1DF              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C1DF
 574+ C1DF
 575+ C1DF              Init_Burst_sound:
 576+ C1DF
 577+ C1DF 3A BC 94         ld a,(Burst_sound)
 578+ C1E2 A7               and a
 579+ C1E3 C0               ret nz                                           ; RET si ya está iniciado el efecto.
 580+ C1E4
 581+ C1E4              ;   Init Burst_sound_efect.
 582+ C1E4
 583+ C1E4              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C1E4
 585+ C1E4 26 35            ld h,Burst_sound_init_value
 586+ C1E6
 587+ C1E6 3A CF 90         ld a,(Impacto_Amadeus)
 588+ C1E9 A7               and a
 589+ C1EA 28 02            jr z,1F
 590+ C1EC
 591+ C1EC 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C1EE
 593+ C1EE 7C           1 ld a,h
 594+ C1EF
 595+ C1EF 32 BC 94         ld (Burst_sound),a
 596+ C1F2
 597+ C1F2 C9               ret
