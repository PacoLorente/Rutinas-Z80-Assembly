 582+ B1B3
 583+ B1B3 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1B4 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1B6 6F               ld l,a
 586+ B1B7 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1B8
 588+ B1B8 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1B9 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1BB 67               ld h,a
 591+ B1BC C9               ret
