 592+ B2A0 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B2A2 6F               ld l,a
 594+ B2A3 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B2A4
 596+ B2A4 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B2A5 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B2A7 67               ld h,a
 599+ B2A8 C9               ret
