 308+ C12E              ; ----------------------------------------------------------------------------------------------
 309+ C12E              ;
 310+ C12E              ;   17/9/26
 311+ C12E              ;
 312+ C12E              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C12E              ;
 314+ C12E              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C12E
 316+ C12E              BEEP:
 317+ C12E
 318+ C12E F5               push af
 319+ C12F C5               push bc
 320+ C130 D5               push de
 321+ C131 E5               push hl                                 ; STORE Regs.
 322+ C132
 323+ C132              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C132
 325+ C132              ;   Configuración de un BEEP.
 326+ C132
 327+ C132              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C132              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C132              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C132              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C132              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C132
 333+ C132
 334+ C132 01 02 00         ld bc,$0002
 335+ C135 11 00 00         ld de,0
 336+ C138 21 D0 00         ld hl,$00d0
 337+ C13B
 338+ C13B 22 06 96         ld (Sound),hl
 339+ C13E
 340+ C13E CD 57 9F         call Sound_Generator    ; v2. Ok.
 341+ C141
 342+ C141 21 00 00         ld hl,0
 343+ C144 22 06 96         ld (Sound),hl
 344+ C147
 345+ C147 E1               pop hl                                  ; RECOVERY Regs.
 346+ C148 D1               pop de
 347+ C149 C1               pop bc
 348+ C14A F1               pop af
 349+ C14B
 350+ C14B C9               ret
 351+ C14C
 352+ C14C              ; ----- ----- ----- ----- -----
 353+ C14C              ;
 354+ C14C              ;   23/9/26
 355+ C14C              ;
 356+ C14C              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C14C              ;
 358+ C14C              ;   HL define el sonido.
 359+ C14C              ;
 360+ C14C              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C14C              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C14C              ;
 363+ C14C              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C14C              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C14C              ;
 366+ C14C              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C14C              ;
 368+ C14C              ;   INPUTS: (Shot_sound) <> "0".
 369+ C14C              ;
 370+ C14C              ;   MODIFY: AF, HL y BC.
 371+ C14C              ;
 372+ C14C              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C14C
 374+ C14C              Play_shot_sound_effect:
 375+ C14C
 376+ C14C              ;   Exclusiones:
 377+ C14C
 378+ C14C 2A 0A 96         ld hl,(Shot_sound)
 379+ C14F 7C               ld a,h
 380+ C150 B5               or l
 381+ C151 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C152
 383+ C152 3A DD 95         ld a,(Ctrl_6)
 384+ C155 CB 47            bit 0,a
 385+ C157 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C158
 387+ C158 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C15A
 389+ C15A              Loop_1:
 390+ C15A
 391+ C15A 3E 10            ld a,%00010000          ; Borde negro.
 392+ C15C D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C15E
 394+ C15E 45               ld b,l
 395+ C15F
 396+ C15F 10 FE        Delay_3 djnz Delay_3
 397+ C161
 398+ C161 AF               xor a                   ; Borde negro.
 399+ C162 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C164
 401+ C164 45               ld b,l
 402+ C165
 403+ C165 10 FE        Delay_4 djnz Delay_4
 404+ C167
 405+ C167              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C167
 407+ C167 2C               inc l
 408+ C168 2C               inc l
 409+ C169 2C               inc l
 410+ C16A 2C               inc l
 411+ C16B
 412+ C16B 25               dec h
 413+ C16C
 414+ C16C CC 76 C1         call z,Clean_shot_effect
 415+ C16F
 416+ C16F 0D               dec c
 417+ C170
 418+ C170 20 E8            jr nz,Loop_1
 419+ C172
 420+ C172 22 0A 96         ld (Shot_sound),hl
 421+ C175
 422+ C175 C9               ret
 423+ C176
 424+ C176              Clean_shot_effect:
 425+ C176
 426+ C176 21 00 00         ld hl,0
 427+ C179 0E 01            ld c,1
 428+ C17B
 429+ C17B C9               ret
 430+ C17C
 431+ C17C              ;   -------------------------------------------------------------------------------------------
 432+ C17C              ;
 433+ C17C              ;   23/9/26
 434+ C17C              ;
 435+ C17C              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C17C              ;
 437+ C17C              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C17C              ;   _ [Sound_Generator].
 439+ C17C              ;
 440+ C17C              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C17C              ;
 442+ C17C              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C17C              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C17C              ;
 445+ C17C              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C17C              ;
 447+ C17C              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C17C              ;
 449+ C17C              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C17C
 451+ C17C              Play_burst_sound_effect:
 452+ C17C
 453+ C17C              ;   Exclusiones:
 454+ C17C
 455+ C17C 3A 0C 96         ld a,(Burst_sound)
 456+ C17F A7               and a
 457+ C180 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C181
 459+ C181 08               ex af,af
 460+ C182
 461+ C182 3A DD 95         ld a,(Ctrl_6)
 462+ C185 CB 47            bit 0,a
 463+ C187 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C188
 465+ C188              ;   ----------------------
 466+ C188
 467+ C188 CB C7            set 0,a
 468+ C18A 32 DD 95         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C18D
 470+ C18D 08               ex af,af                ; Restore (Burst_sound).
 471+ C18E
 472+ C18E 67               ld h,a
 473+ C18F 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C191
 475+ C191 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C192
 477+ C192 22 06 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C195 0E 03            ld c,3
 479+ C197 CD 90 9F         call Noise_efect
 480+ C19A
 481+ C19A D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C19B
 483+ C19B 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C19C 94               sub h
 485+ C19D
 486+ C19D 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C19F
 488+ C19F 7C               ld a,h
 489+ C1A0 32 0C 96         ld (Burst_sound),a
 490+ C1A3
 491+ C1A3 C9               ret
 492+ C1A4
 493+ C1A4              Clean_burst_efect:
 494+ C1A4
 495+ C1A4 AF               xor a
 496+ C1A5 32 0C 96         ld (Burst_sound),a
 497+ C1A8
 498+ C1A8 3A DD 95         ld a,(Ctrl_6)
 499+ C1AB CB 87            res 0,a
 500+ C1AD 32 DD 95         ld (Ctrl_6),a
 501+ C1B0
 502+ C1B0 C9               ret
 503+ C1B1
 504+ C1B1              ;   -------------------------------------------------------------------------------------------
 505+ C1B1              ;
 506+ C1B1              ;   23/9/26
 507+ C1B1              ;
 508+ C1B1              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1B1              ;   _ Shield_sound_effect.
 510+ C1B1              ;
 511+ C1B1              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1B1              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1B1              ;
 514+ C1B1              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1B1              ;
 516+ C1B1              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1B1              ;
 518+ C1B1              ;   MODIFY: AF'y BC.
 519+ C1B1
 520+ C1B1              Play_Shield_sound_effect:
 521+ C1B1
 522+ C1B1 3A 0D 96         ld a,(Shield_sound)
 523+ C1B4 A7               and a
 524+ C1B5 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1B6
 526+ C1B6 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1B8
 528+ C1B8              Loop_3:
 529+ C1B8
 530+ C1B8 08               ex af,af
 531+ C1B9
 532+ C1B9 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1BB D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1BD
 535+ C1BD 08               ex af,af
 536+ C1BE
 537+ C1BE 47               ld b,a
 538+ C1BF
 539+ C1BF 10 FE        Delay_7 djnz Delay_7
 540+ C1C1
 541+ C1C1 08               ex af,af
 542+ C1C2
 543+ C1C2 AF               xor a                   ; Black BORDER.
 544+ C1C3 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1C5
 546+ C1C5 08               ex af,af
 547+ C1C6
 548+ C1C6 47               ld b,a
 549+ C1C7
 550+ C1C7 10 FE        Delay_8 djnz Delay_8
 551+ C1C9
 552+ C1C9 0D               dec c
 553+ C1CA
 554+ C1CA 20 EC            jr nz,Loop_3
 555+ C1CC
 556+ C1CC AF               xor a
 557+ C1CD 32 0D 96         ld (Shield_sound),a
 558+ C1D0
 559+ C1D0 C9               ret
 560+ C1D1
 561+ C1D1              ; ---------------------------------------------------------------
 562+ C1D1              ;
 563+ C1D1              ;   18/9/26
 564+ C1D1              ;
 565+ C1D1              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C1D1              ;
 567+ C1D1              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C1D1              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C1D1              ;
 570+ C1D1              ;   MODIFY: A y H.
 571+ C1D1              ;
 572+ C1D1              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C1D1
 574+ C1D1
 575+ C1D1              Init_Burst_sound:
 576+ C1D1
 577+ C1D1 3A 0C 96         ld a,(Burst_sound)
 578+ C1D4 A7               and a
 579+ C1D5 C0               ret nz                                           ; RET si ya está iniciado el efecto.
 580+ C1D6
 581+ C1D6              ;   Init Burst_sound_efect.
 582+ C1D6
 583+ C1D6              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C1D6
 585+ C1D6 26 35            ld h,Burst_sound_init_value
 586+ C1D8
 587+ C1D8 3A CF 90         ld a,(Impacto_Amadeus)
 588+ C1DB A7               and a
 589+ C1DC 28 02            jr z,1F
 590+ C1DE
 591+ C1DE 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C1E0
 593+ C1E0 7C           1 ld a,h
 594+ C1E1
 595+ C1E1 32 0C 96         ld (Burst_sound),a
 596+ C1E4
 597+ C1E4 C9               ret
 598+ C1E5
 599+ C1E5
