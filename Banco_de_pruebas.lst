 277  918B 00           Columns db 0 												; Nº de columnas. [DRAW]
 278  918C 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 279  918E 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
