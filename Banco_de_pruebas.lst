 584+ A6E3 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A6E5 6F               ld l,a
 586+ A6E6 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A6E7
 588+ A6E7 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A6E8 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A6EA 67               ld h,a
