 629+ B476
 630+ B476 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 631+ B477 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 632+ B479 67               ld h,a
