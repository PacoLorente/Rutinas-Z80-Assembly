 577+ C17D 3A 7E 94         ld a,(Burst_sound)
 578+ C180 A7               and a
 579+ C181 C0               ret nz                                           ; RET si ya está iniciado el efecto.
 580+ C182
 581+ C182              ;   Init Burst_sound_efect.
 582+ C182
 583+ C182              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C182
 585+ C182 26 35            ld h,Burst_sound_init_value
 586+ C184
 587+ C184 3A CF 90         ld a,(Impacto_Amadeus)
 588+ C187 A7               and a
 589+ C188 28 02            jr z,1F
 590+ C18A
 591+ C18A 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C18C
 593+ C18C 7C           1 ld a,h
 594+ C18D
 595+ C18D 32 7E 94         ld (Burst_sound),a
 596+ C190
 597+ C190 C9               ret
