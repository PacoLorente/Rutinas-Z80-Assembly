   5+ 9677              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9677              ;   (XOR) bit a bit.
   7+ 9677              ;
   8+ 9677              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9677              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9677
  11+ 9677              Derivando_RND
  12+ 9677
  13+ 9677 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9679 C5               push bc
  15+ 967A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 967A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 967D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 967D
  19+ 967D A7           6 and a                                 ; Carry a "0".
  20+ 967E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9680 30 02            jr nc,1F
  22+ 9682
  23+ 9682 CB C1            set 0,c
  24+ 9684
  25+ 9684 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9685 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9687 5F               ld e,a
  28+ 9688
  29+ 9688 7A               ld a,d
  30+ 9689 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 968B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 968D
  33+ 968D CB 3F            srl a
  34+ 968F
  35+ 968F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9690
  37+ 9690 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9691 28 04            jr z,4F
  39+ 9693
  40+ 9693 CB FF            set 7,a
  41+ 9695 18 02            jr 5F
  42+ 9697
  43+ 9697 CB BF        4 res 7,a
  44+ 9699
  45+ 9699 CB 21        5 sla c
  46+ 969B 10 E0            djnz 6B
  47+ 969D
  48+ 969D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 969E
  50+ 969E 77               ld (hl),a
  51+ 969F 23               inc hl
  52+ 96A0 C1               pop bc
  53+ 96A1 10 D4            djnz 3B
  54+ 96A3
  55+ 96A3 C9               ret
