 241  8C69
 242  8C69 00           Filas db 0												; Filas. [DRAW]
 243  8C6A 00           Columns db 0 	  										; Nº de columnas. [DRAW]
 244  8C6B 00 00        Posicion_actual defw 0									; Dirección actual del Sprite. [DRAW]
 245  8C6D 00 00        Puntero_objeto defw 0									; Donde están los datos para pintar el Sprite.
