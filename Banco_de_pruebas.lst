 614+ C3F2
 615+ C3F2              ;   Tras ejecutar[ROM_Key_Scan], (E) contiene el KEYCODE de la tecla pulsada.
 616+ C3F2
 617+ C3F2 3A 01 97         ld a,(Numero_de_teclas_definidas)                       ; N° de teclas ya definidas.
 618+ C3F5 A7               and a
 619+ C3F6 28 0B            jr z,2F                                                 ; (Numero_de_teclas_definidas)="0" Indica que estamos definiendo Move_LEFT.
 620+ C3F8              ;                                                           ; (Numero_de_teclas_definidas) se incrementa en una unidad cada vez que se define una tecla:
 621+ C3F8              ;
 622+ C3F8              ;                                                           ; Ej.: Si estamos definiendo Move_RIGHT, (Numero_de_teclas_definidas)="1"
 623+ C3F8              ;                                                           ;      Si estamos definiendo Move_FIRE, (Numero_de_teclas_definidas)="2"
 624+ C3F8              ;                                                           ;      Si estamos definiendo Move_SHIELD, (Numero_de_teclas_definidas)="3"
 625+ C3F8
 626+ C3F8 47               ld b,a                                                  ; Así, (B) contiene el nº de teclas definidas -1.
 627+ C3F9
 628+ C3F9              ;   (Numero_de_teclas_definidas) contiene el n° de comparativas que realizaremos entre el nuevo KEYCODE definido y los anteriormente definidos.
 629+ C3F9              ;   Así evitaremos que se asigne una misma tecla para varias funciones distintas.
 630+ C3F9
