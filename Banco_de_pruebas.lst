3100  A05A              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A05A              ; ******************************************************************************************************************************************************************************************
   2+ A05A              ;
   3+ A05A              ;   3/4/25
   4+ A05A              ;
   5+ A05A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A05A              ;   (XOR) bit a bit.
   7+ A05A              ;
   8+ A05A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A05A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A05A
  11+ A05A              Derivando_RND
  12+ A05A
  13+ A05A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A05C C5               push bc
  15+ A05D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A05D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A060              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A060
  19+ A060 A7           6 and a                                 ; Carry a "0".
  20+ A061 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A063 30 02            jr nc,1F
  22+ A065
  23+ A065 CB C1            set 0,c
  24+ A067
  25+ A067 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A068 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A06A 5F               ld e,a
  28+ A06B
  29+ A06B 7A               ld a,d
  30+ A06C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A06E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A070
  33+ A070 CB 3F            srl a
  34+ A072
  35+ A072 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A073
  37+ A073 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A074 28 04            jr z,4F
  39+ A076
  40+ A076 CB FF            set 7,a
  41+ A078 18 02            jr 5F
  42+ A07A
  43+ A07A CB BF        4 res 7,a
  44+ A07C
  45+ A07C CB 21        5 sla c
  46+ A07E 10 E0            djnz 6B
  47+ A080
  48+ A080 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A081
  50+ A081 77               ld (hl),a
  51+ A082 23               inc hl
  52+ A083 C1               pop bc
  53+ A084 10 D4            djnz 3B
  54+ A086
  55+ A086 C9               ret
  56+ A087
  57+ A087
  58+ A087
# file closed: RND_Derivando.asm
