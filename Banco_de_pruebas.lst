 641+ 9F14
 642+ 9F14 23               inc hl
 643+ 9F15 10 FD            djnz Incrementa_delay
 644+ 9F17
 645+ 9F17              ; Descontamos la onda generada del total de ondas que tiene el efecto, (Sound).
 646+ 9F17
 647+ 9F17 0D           1 dec c                     ; Decrementa nº de ondas.
 648+ 9F18
 649+ 9F18 22 84 94         ld (Sound),hl
 650+ 9F1B
 651+ 9F1B 20 D2            jr nz,Loop_2
 652+ 9F1D
 653+ 9F1D C9               ret
 654+ 9F1E
 655+ 9F1E              ;   Efecto de ruido, se puede utilizar, (entre otras cosas) para generar explosiones, disparos, etc.
 656+ 9F1E              ;   Este tipo de onda NO ES SIMÉTRICA, el semiciclo positivo y el negativo tienen una duración distinta.
 657+ 9F1E              ;   Cada onda completa que compone el sonido es distinta a la anterior siendo el registro (C) el que contiene el_
 658+ 9F1E              ;   _nº de ondas que vamos a ejecutar.
 659+ 9F1E              ;   El registro R proporciona el nº pseudo aleatorio que construye los dos semiciclos de la onda.
 660+ 9F1E
 661+ 9F1E              Noise_efect:
 662+ 9F1E
 663+ 9F1E              Loop:
 664+ 9F1E
 665+ 9F1E ED 5F            ld a,r
 666+ 9F20 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 667+ 9F21
 668+ 9F21 3E 10            ld a,%00010000          ; Borde negro.
 669+ 9F23 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 670+ 9F25
 671+ 9F25 10 FE        Delay_1 djnz Delay_1        ; Aplica Delay.
 672+ 9F27
 673+ 9F27 AF               xor a
 674+ 9F28 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 675+ 9F2A
 676+ 9F2A ED 5F            ld a,r
 677+ 9F2C 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 678+ 9F2D
 679+ 9F2D 10 FE        Delay_2 djnz Delay_2        ; Aplica Delay.
 680+ 9F2F
 681+ 9F2F 25               dec h
 682+ 9F30
 683+ 9F30 0D               dec c                   ; Decrementa ondas completas generadas.
 684+ 9F31
 685+ 9F31 20 EB            jr nz,Loop
 686+ 9F33
 687+ 9F33 22 84 94         ld (Sound),hl
 688+ 9F36
 689+ 9F36 C9               ret
