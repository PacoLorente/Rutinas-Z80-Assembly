  12+ 9ACC
  13+ 9ACC ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9ACE C5               push bc
  15+ 9ACF              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9ACF 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9AD2              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9AD2
  19+ 9AD2 A7           6 and a                                 ; Carry a "0".
  20+ 9AD3 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9AD5 30 02            jr nc,1F
  22+ 9AD7
  23+ 9AD7 CB C1            set 0,c
  24+ 9AD9
  25+ 9AD9 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9ADA E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9ADC 5F               ld e,a
  28+ 9ADD
  29+ 9ADD 7A               ld a,d
  30+ 9ADE E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9AE0 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9AE2
  33+ 9AE2 CB 3F            srl a
  34+ 9AE4
  35+ 9AE4 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9AE5
  37+ 9AE5 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9AE6 28 04            jr z,4F
  39+ 9AE8
  40+ 9AE8 CB FF            set 7,a
  41+ 9AEA 18 02            jr 5F
  42+ 9AEC
  43+ 9AEC CB BF        4 res 7,a
  44+ 9AEE
  45+ 9AEE CB 21        5 sla c
  46+ 9AF0 10 E0            djnz 6B
  47+ 9AF2
  48+ 9AF2 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9AF3
  50+ 9AF3 77               ld (hl),a
  51+ 9AF4 23               inc hl
  52+ 9AF5 C1               pop bc
  53+ 9AF6 10 D4            djnz 3B
