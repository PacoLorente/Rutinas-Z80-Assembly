 104  FD01              FRAMES equ $5c78														; Variable de 24 bits. Almacena el nº de cuadros, (frames) que llevamos construidos. Reloj en tiempo real.
 105  FD01              FRAMES_3 equ $5c7a
 106  FD01
 107  FD01              Sprite_vacio equ $82c1													; 48 Bytes de "0".
 108  FD01
 109  FD01              Almacen_de_movimientos_masticados_Amadeus equ $c000						; ($c000 - $c1e3), 483 bytes. $1e3. Movimientos masticados de Amadeus.
 110  FD01
 111  FD01              ; Scanlines_album.
 112  FD01
 113  FD01              ; 35 bytes por entidad, (7 entidades).
 114  FD01
 115  FD01              ; 1. 2 Bytes ..... .defw  Puntero_objeto, (mem. address donde se encuentran los .db que forman los distintos sprites).
 116  FD01              ; 2. 1 Byte ..... .db  Indica el nº de scanlines que vamos a imprimir del sprite. Generalmente 16 scanlines.
 117  FD01              ; El nº de scanlines será menor cuando estemos `desapareciendo? por la parte baja de la pantalla.
 118  FD01              ; 3. 32 Bytes, (como máximo). Screen mem. address de cada uno de los scanlines que forman el sprite.
 119  FD01
 120  FD01              Scanlines_album equ $8000	;						($8000 - $8118) 	; Inicialmente 280 bytes, $118.
 121  FD01              Scanlines_album_2 equ $811a	;    					($811a - $8232)
 122  FD01              Amadeus_scanlines_album equ $8234	;				($8234 - $8256) 	; Inicialmente 34 bytes, $22.
 123  FD01              Amadeus_scanlines_album_2 equ $8258	;				($8258 - $827a)
 124  FD01
 125  FD01              Amadeus_disparos_scanlines_album equ $827c	;		($827c - $8281) 	; 6 Bytes, (1 único disparo).
