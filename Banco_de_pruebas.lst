 381+ AC88              ;
 382+ AC88              ;   23/6/25
 383+ AC88              ;
 384+ AC88              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 385+ AC88              ;
 386+ AC88              ;	INPUTS:		B contiene (Numero_de_entidades).
 387+ AC88              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 388+ AC88              ; 				HL contiene (Puntero_de_entidades).
 389+ AC88
 390+ AC88              Prepara_Cajas_Master:
 391+ AC88
 392+ AC88              ;	jr $
 393+ AC88
 394+ AC88 E5           	push hl															; PUSH (Puntero_de_entidades).
 395+ AC89 C5           	push bc															; PUSH (Numero_de_entidades)/(Clase).
 396+ AC8A
 397+ AC8A              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 398+ AC8A
 399+ AC8A 79           	ld a,c
 400+ AC8B 08           	ex af,af
 401+ AC8C 79           	ld a,c 															; (Clase) de la entidad en C, A y A´.
 402+ AC8D
 403+ AC8D CD A8 AE     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 404+ AC90              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 405+ AC90              ; 																	; Saltaremos a la siguiente entidad del nivel.
 406+ AC90 A7           	and a
 407+ AC91 20 3B        	jr nz, Avanza_siguiente_entidad_del_nivel
 408+ AC93
 409+ AC93              ; Generamos movimientos masticados.
 410+ AC93
 411+ AC93              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 412+ AC93
 413+ AC93 79           	ld a,c 															; (A) = (Clase).
 414+ AC94
 415+ AC94 CD 71 AF     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 416+ AC97 CD FE AF     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 417+ AC9A
 418+ AC9A 18 FE        	jr $
 419+ AC9C
 420+ AC9C              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 421+ AC9C              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 422+ AC9C              ;	coreografías distintas.
 423+ AC9C
 424+ AC9C              ;	ld b,7
 425+ AC9C              ;	ld hl,Numeros_aleatorios_baile
 426+ AC9C              ;	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 427+ AC9C
 428+ AC9C              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 429+ AC9C
 430+ AC9C 3A ED A4     	ld a,(Tipo)
 431+ AC9F CD D5 AE     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 432+ ACA2 CD 27 AE     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 433+ ACA5
 434+ ACA5              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 435+ ACA5
 436+ ACA5 C1           	pop bc
 437+ ACA6 E1           	pop hl
 438+ ACA7
 439+ ACA7 E5           	push hl															; Push (Puntero_de_entidades).
 440+ ACA8 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 441+ ACA9
 442+ ACA9              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 443+ ACA9
 444+ ACA9 CD E6 AC     	call Determina_posicion_de_inicio 								; $941e ($78),($76),($72)
 445+ ACAC
 446+ ACAC 3A ED A4     	ld a,(Tipo)
 447+ ACAF CD E5 AE     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
 448+ ACB2
 449+ ACB2              ;	Ya disponemos de una (Posicion_inicio) aleatoria y la definición de la entidad en la "Bandeja DRAW".
 450+ ACB2              ;	Generamos "Movimientos masticados" de la entidad.
 451+ ACB2
 452+ ACB2 CD AB AD     	call Construye_movimientos_masticados_entidad
 453+ ACB5
