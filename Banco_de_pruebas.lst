 399  949C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 400  949D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 401  949D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 402  949D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 403  949D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
