 372  8C39 00 00        Stack defw 0 											; La rutinas de pintado, utilizan esta_
 373  8C3B              ;														; _variable para almacenar lo posición del puntero_
 374  8C3B              ; 														; _de pila, SP.
 375  8C3B 00 00        Stack_2 defw 0											; 2º variable destinada a almacenar el puntero de pila, SP.
