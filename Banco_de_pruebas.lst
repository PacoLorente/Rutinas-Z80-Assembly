3263  A065              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A065              ; ******************************************************************************************************************************************************************************************
   2+ A065              ;
   3+ A065              ;   3/4/25
   4+ A065              ;
   5+ A065              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A065              ;   (XOR) bit a bit.
   7+ A065              ;
   8+ A065              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A065              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A065
  11+ A065              Derivando_RND
  12+ A065
  13+ A065 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A067 C5               push bc
  15+ A068              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A068 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A06B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A06B
  19+ A06B A7           6 and a                                 ; Carry a "0".
  20+ A06C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A06E 30 02            jr nc,1F
  22+ A070
  23+ A070 CB C1            set 0,c
  24+ A072
  25+ A072 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A073 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A075 5F               ld e,a
  28+ A076
  29+ A076 7A               ld a,d
  30+ A077 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A079 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A07B
  33+ A07B CB 3F            srl a
  34+ A07D
  35+ A07D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A07E
  37+ A07E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A07F 28 04            jr z,4F
  39+ A081
  40+ A081 CB FF            set 7,a
  41+ A083 18 02            jr 5F
  42+ A085
  43+ A085 CB BF        4 res 7,a
  44+ A087
  45+ A087 CB 21        5 sla c
  46+ A089 10 E0            djnz 6B
  47+ A08B
  48+ A08B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A08C
  50+ A08C 77               ld (hl),a
  51+ A08D 23               inc hl
  52+ A08E C1               pop bc
  53+ A08F 10 D4            djnz 3B
  54+ A091
  55+ A091 C9               ret
  56+ A092
  57+ A092
  58+ A092
# file closed: RND_Derivando.asm
