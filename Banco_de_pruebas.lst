   5+ 9D67              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D67              ;   (XOR) bit a bit.
   7+ 9D67              ;
   8+ 9D67              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D67              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D67
  11+ 9D67              Derivando_RND
  12+ 9D67
  13+ 9D67 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D69 C5               push bc
  15+ 9D6A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D6A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D6D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D6D
  19+ 9D6D A7           6 and a                                 ; Carry a "0".
  20+ 9D6E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D70 30 02            jr nc,1F
  22+ 9D72
  23+ 9D72 CB C1            set 0,c
  24+ 9D74
  25+ 9D74 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D75 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D77 5F               ld e,a
  28+ 9D78
  29+ 9D78 7A               ld a,d
  30+ 9D79 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D7B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D7D
  33+ 9D7D CB 3F            srl a
  34+ 9D7F
  35+ 9D7F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D80
  37+ 9D80 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D81 28 04            jr z,4F
  39+ 9D83
  40+ 9D83 CB FF            set 7,a
  41+ 9D85 18 02            jr 5F
  42+ 9D87
  43+ 9D87 CB BF        4 res 7,a
  44+ 9D89
  45+ 9D89 CB 21        5 sla c
  46+ 9D8B 10 E0            djnz 6B
  47+ 9D8D
  48+ 9D8D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D8E
  50+ 9D8E 77               ld (hl),a
  51+ 9D8F 23               inc hl
  52+ 9D90 C1               pop bc
  53+ 9D91 10 D4            djnz 3B
  54+ 9D93
  55+ 9D93 C9               ret
