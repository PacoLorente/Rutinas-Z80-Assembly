# file opened: Patrones_de_mov.asm
   1+ 9159
   2+ 9159
   3+ 9159              ;   07/07/23
   4+ 9159              ;
   5+ 9159              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 9159              ;
   7+ 9159              ;   Codificación:
   8+ 9159              ;
   9+ 9159              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 9159              ;
  11+ 9159              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 9159              ;
  13+ 9159              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 9159              ;
  15+ 9159              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 9159              ;
  17+ 9159              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 9159              ;                               ..... %01000010 Vel_up 4
  19+ 9159              ;                                               Vel_down 2
  20+ 9159              ;                               ..... $42
  21+ 9159              ;
  22+ 9159              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 9159              ;
  24+ 9159              ;                               ..... %01000010 Vel_left 4
  25+ 9159              ;                                               Vel_right 2
  26+ 9159              ;                               ..... $42
  27+ 9159              ;
  28+ 9159              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 9159              ;
  30+ 9159              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 9159              ;
  32+ 9159              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 9159              ;
  34+ 9159              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 9159              ;                                     $53
  36+ 9159              ;
  37+ 9159              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 9159              ;
  39+ 9159              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 9159              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 9159              ;
  42+ 9159              ;                       Arriba ..... $81
  43+ 9159              ;                       Arriba - izquierda ..... $a1
  44+ 9159              ;                       Arriba - derecha ..... $91
  45+ 9159              ;
  46+ 9159              ;                       Abajo ..... $41
  47+ 9159              ;                       Abajo - izquierda ..... $61
  48+ 9159              ;                       Abajo - derecha ..... $51
  49+ 9159              ;
  50+ 9159              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 9159              ;
  52+ 9159              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 9159              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 9159              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 9159              ;
  56+ 9159              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 9159              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 9159              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 9159              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 9159              ;
  61+ 9159              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 9159              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 9159              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 9159              ;
  65+ 9159              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 9159              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 9159              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 9159              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 9159
