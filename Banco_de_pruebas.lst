3137  A185              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A185              ; ******************************************************************************************************************************************************************************************
   2+ A185              ;
   3+ A185              ;   3/4/25
   4+ A185              ;
   5+ A185              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A185              ;   (XOR) bit a bit.
   7+ A185              ;
   8+ A185              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A185              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A185
  11+ A185              Derivando_RND
  12+ A185
  13+ A185 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A187 C5               push bc
  15+ A188              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A188 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A18B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A18B
  19+ A18B A7           6 and a                                 ; Carry a "0".
  20+ A18C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A18E 30 02            jr nc,1F
  22+ A190
  23+ A190 CB C1            set 0,c
  24+ A192
  25+ A192 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A193 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A195 5F               ld e,a
  28+ A196
  29+ A196 7A               ld a,d
  30+ A197 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A199 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A19B
  33+ A19B CB 3F            srl a
  34+ A19D
  35+ A19D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A19E
  37+ A19E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A19F 28 04            jr z,4F
  39+ A1A1
  40+ A1A1 CB FF            set 7,a
  41+ A1A3 18 02            jr 5F
  42+ A1A5
  43+ A1A5 CB BF        4 res 7,a
  44+ A1A7
  45+ A1A7 CB 21        5 sla c
  46+ A1A9 10 E0            djnz 6B
  47+ A1AB
  48+ A1AB 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A1AC
  50+ A1AC 77               ld (hl),a
  51+ A1AD 23               inc hl
  52+ A1AE C1               pop bc
  53+ A1AF 10 D4            djnz 3B
  54+ A1B1
  55+ A1B1 C9               ret
  56+ A1B2
  57+ A1B2
  58+ A1B2
# file closed: RND_Derivando.asm
