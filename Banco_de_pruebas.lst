 825+ B5DC              ;   PreviousScan.
 826+ B5DC              ;
 827+ B5DC              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B5DC              ;
 829+ B5DC              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B5DC              ;
 831+ B5DC              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B5DC              ;
 833+ B5DC              ;       DESTRUIDOS: AF y HL !!!
 834+ B5DC              ;
 835+ B5DC              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B5DC              ;
 837+ B5DC
 838+ B5DC              PreviousScan:
 839+ B5DC
 840+ B5DC 7C           	ld a,h
 841+ B5DD 25               dec h               							; Dec H.
 842+ B5DE E6 07            and 7
 843+ B5E0 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B5E1
 845+ B5E1 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B5E2 D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B5E4 6F               ld l,a
 848+ B5E5 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B5E6
 850+ B5E6 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B5E7 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B5E9 67               ld h,a
 853+ B5EA C9               ret
