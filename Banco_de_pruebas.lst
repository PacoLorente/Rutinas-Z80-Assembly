 506+ A450              ;	Tenemos un nº aleatorio, (Columna de inicio) en A.
 507+ A450              ; 	No queremos que se repita la posición de inicio en dos clases distintas de entidades.
 508+ A450
 509+ A450 57           	ld d,a 															; $08,$12,$0c --- $08,$02,$12 --- $18,$1c,$18 --- $1e,$1c,$18
