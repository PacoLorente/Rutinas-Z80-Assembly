   1+ A537              ;	Variables de programa.
   2+ A537
   3+ A537              Bandeja_DRAW:
   4+ A537
   5+ A537 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
   6+ A538              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
   7+ A538              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
   8+ A538              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
   9+ A538
  10+ A538 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
  11+ A539              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
  12+ A539 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
  13+ A53A 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
  14+ A53B
  15+ A53B 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
  16+ A53C              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
  17+ A53C              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
  18+ A53C
  19+ A53C              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
  20+ A53C              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
  21+ A53C
  22+ A53C              ; Ejemplos:
  23+ A53C
  24+ A53C              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
  25+ A53C              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
  26+ A53C              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
  27+ A53C              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
  28+ A53C              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
  29+ A53C
  30+ A53C 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
  31+ A53D              ;															  _ que esta entidad haya colisionado con Amadeus.
  32+ A53D              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
  33+ A53D
  34+ A53D 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
  35+ A53F              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
  36+ A53F
  37+ A53F 00 00        Puntero_de_almacen_de_mov_masticados defw 0
  38+ A541
  39+ A541              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
  40+ A541
  41+ A541 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
  42+ A543              ;															  _palabras que componen el "movimiento_masticado".
  43+ A543
  44+ A543              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
  45+ A543
  46+ A543 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
