 494+ C150
 495+ C150 AF               xor a
 496+ C151 32 7E 94         ld (Burst_sound),a
 497+ C154
 498+ C154 3A 4F 94         ld a,(Ctrl_6)
 499+ C157 CB 87            res 0,a
 500+ C159 32 4F 94         ld (Ctrl_6),a
 501+ C15C
 502+ C15C C9               ret
 503+ C15D
 504+ C15D              ;   -------------------------------------------------------------------------------------------
 505+ C15D              ;
 506+ C15D              ;   23/9/26
 507+ C15D              ;
 508+ C15D              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C15D              ;   _ Shield_sound_effect.
 510+ C15D              ;
 511+ C15D              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C15D              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C15D              ;
 514+ C15D              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C15D              ;
 516+ C15D              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C15D              ;
 518+ C15D              ;   MODIFY: AF'y BC.
 519+ C15D
 520+ C15D              Play_Shield_sound_effect:
 521+ C15D
 522+ C15D 3A 7F 94         ld a,(Shield_sound)
 523+ C160 A7               and a
 524+ C161 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C162
 526+ C162 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C164
 528+ C164              Loop_3:
 529+ C164
 530+ C164 08               ex af,af
 531+ C165
 532+ C165 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C167 D3 FE            out ($fe),a             ; Beeper ON.
 534+ C169
 535+ C169 08               ex af,af
 536+ C16A
 537+ C16A 47               ld b,a
 538+ C16B
 539+ C16B 10 FE        Delay_7 djnz Delay_7
 540+ C16D
 541+ C16D 08               ex af,af
 542+ C16E
 543+ C16E AF               xor a                   ; Black BORDER.
 544+ C16F D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C171
 546+ C171 08               ex af,af
 547+ C172
 548+ C172 47               ld b,a
 549+ C173
 550+ C173 10 FE        Delay_8 djnz Delay_8
 551+ C175
 552+ C175 0D               dec c
 553+ C176
 554+ C176 20 EC            jr nz,Loop_3
 555+ C178
 556+ C178 AF               xor a
 557+ C179 32 7F 94         ld (Shield_sound),a
 558+ C17C
 559+ C17C C9               ret
