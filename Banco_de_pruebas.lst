 260  93F3 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 261  93F4              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 262  93F4              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 263  93F4              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 264  93F4
 265  93F4 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 266  93F5              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 267  93F5
 268  93F5 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 269  93F6              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 270  93F6              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 271  93F6
 272  93F6              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 273  93F6              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 274  93F6
 275  93F6              ; Ejemplos:
 276  93F6
 277  93F6              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 278  93F6              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 279  93F6              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 280  93F6              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 281  93F6              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 282  93F6
 283  93F6 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 284  93F7              ;															  _ que esta entidad haya colisionado con Amadeus.
 285  93F7              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 286  93F7
