 160+ C0A1 1E 00            ld e,0                                                  ; No existe decremento. (sonido plano).
 161+ C0A3
 162+ C0A3 22 06 96         ld (Sound),hl
 163+ C0A6 CD 61 9F         call Sound_Generator                                    ; Ejecuta nota.
