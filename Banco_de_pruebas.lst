 623+ B35F C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 624+ B360
 625+ B360 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 626+ B361 D6 20            sub $20             							; Vamos a comprobarlo...
 627+ B363 6F               ld l,a
 628+ B364 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 629+ B365
 630+ B365 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 631+ B366 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 632+ B368 67               ld h,a
 633+ B369 C9               ret
