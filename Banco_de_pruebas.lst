  25+ 96C4 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 96C7 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 96C9 ED B0        	LDIR
  28+ 96CB 01 FF 02     	LD BC,767
  29+ 96CE 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 96CF ED B0        	LDIR
  31+ 96D1 C9           	ret
  32+ 96D2
