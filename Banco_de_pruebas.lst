   3+ 9E9C              ;   3/4/25
   4+ 9E9C              ;
   5+ 9E9C              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E9C              ;   (XOR) bit a bit.
   7+ 9E9C              ;
   8+ 9E9C              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E9C              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E9C
  11+ 9E9C              Derivando_RND
  12+ 9E9C
  13+ 9E9C ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9E9E C5               push bc
  15+ 9E9F              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9E9F 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9EA2              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9EA2
  19+ 9EA2 A7           6 and a                                 ; Carry a "0".
  20+ 9EA3 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9EA5 30 02            jr nc,1F
  22+ 9EA7
  23+ 9EA7 CB C1            set 0,c
  24+ 9EA9
  25+ 9EA9 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9EAA E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9EAC 5F               ld e,a
  28+ 9EAD
  29+ 9EAD 7A               ld a,d
  30+ 9EAE E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9EB0 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9EB2
