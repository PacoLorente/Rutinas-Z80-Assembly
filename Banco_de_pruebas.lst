 310  8E65 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 311  8E66 00           Cola_de_desplazamiento db 0									; Este byte indica:
 312  8E67
 313  8E67              ;
 314  8E67              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 315  8E67              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 316  8E67              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 317  8E67              ;
 318  8E67              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 319  8E67              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 320  8E67              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 321  8E67              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 322  8E67              ;
 323  8E67              ;															;	"$ff" ..... Bucle infinito de repetición.
 324  8E67              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 325  8E67              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
