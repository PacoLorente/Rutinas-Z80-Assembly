   4+ 9EE7              ;
   5+ 9EE7              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9EE7              ;   (XOR) bit a bit.
   7+ 9EE7              ;
   8+ 9EE7              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9EE7              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9EE7
  11+ 9EE7              Derivando_RND
  12+ 9EE7
  13+ 9EE7 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9EE9 C5               push bc
  15+ 9EEA              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9EEA 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9EED              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9EED
  19+ 9EED A7           6 and a                                 ; Carry a "0".
  20+ 9EEE CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9EF0 30 02            jr nc,1F
  22+ 9EF2
  23+ 9EF2 CB C1            set 0,c
  24+ 9EF4
  25+ 9EF4 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9EF5 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9EF7 5F               ld e,a
  28+ 9EF8
  29+ 9EF8 7A               ld a,d
  30+ 9EF9 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9EFB 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9EFD
  33+ 9EFD CB 3F            srl a
  34+ 9EFF
  35+ 9EFF AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9F00
  37+ 9F00 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9F01 28 04            jr z,4F
  39+ 9F03
  40+ 9F03 CB FF            set 7,a
  41+ 9F05 18 02            jr 5F
  42+ 9F07
  43+ 9F07 CB BF        4 res 7,a
  44+ 9F09
  45+ 9F09 CB 21        5 sla c
  46+ 9F0B 10 E0            djnz 6B
  47+ 9F0D
  48+ 9F0D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9F0E
  50+ 9F0E 77               ld (hl),a
  51+ 9F0F 23               inc hl
  52+ 9F10 C1               pop bc
  53+ 9F11 10 D4            djnz 3B
  54+ 9F13
  55+ 9F13 C9               ret
  56+ 9F14
  57+ 9F14
  58+ 9F14
