 589+ B4F1 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 590+ B4F2
 591+ B4F2 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B4F3 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B4F5 6F               ld l,a
 594+ B4F6 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B4F7
 596+ B4F7 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B4F8 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B4FA 67               ld h,a
 599+ B4FB C9               ret
