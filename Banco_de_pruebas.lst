 372  919B              ;																DESCRIPCIÓN:
 373  919B              ;
 374  919B              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 375  919B              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 376  919B              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 377  919B              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 378  919B              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 379  919B              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 380  919B
 381  919B              ;															BIT 3, Recarga de nueva oleada.
 382  919B              ;															BIT 4, Recarga de nueva oleada.
 383  919B              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 384  919B              ;															BIT 6, **** Frame completo.
 385  919B              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 386  919B
