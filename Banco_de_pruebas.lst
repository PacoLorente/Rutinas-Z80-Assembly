 720+ 9F6B
 721+ 9F6B 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 722+ 9F6C
 723+ 9F6C 7C               ld a,h
 724+ 9F6D B5               or l
 725+ 9F6E 20 FB            jr nz,Delay_5
 726+ 9F70
