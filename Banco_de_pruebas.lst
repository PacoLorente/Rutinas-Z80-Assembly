 187+ C28B
 188+ C28B              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 189+ C28B
 190+ C28B              ;   Necesito fabricar un msg. con la máxima puntuación.
 191+ C28B              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 192+ C28B
 193+ C28B 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 194+ C28E 21 DD 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 195+ C291              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 196+ C291 11 EC 94         ld de,Score_max_msg
 197+ C294
 198+ C294              KEY_CODE_de_BCD:
 199+ C294
 200+ C294 7E           1 ld a,(hl)
 201+ C295 A7               and a
 202+ C296 20 07            jr nz,3F
 203+ C298
 204+ C298              ;   El dígito es "0".
