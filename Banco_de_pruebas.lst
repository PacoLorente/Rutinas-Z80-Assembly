3297  A13A              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A13A              ; ******************************************************************************************************************************************************************************************
   2+ A13A              ;
   3+ A13A              ;   3/4/25
   4+ A13A              ;
   5+ A13A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A13A              ;   (XOR) bit a bit.
   7+ A13A              ;
   8+ A13A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A13A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A13A
  11+ A13A              Derivando_RND
  12+ A13A
  13+ A13A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A13C C5               push bc
  15+ A13D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A13D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A140              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A140
  19+ A140 A7           6 and a                                 ; Carry a "0".
  20+ A141 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A143 30 02            jr nc,1F
  22+ A145
  23+ A145 CB C1            set 0,c
  24+ A147
  25+ A147 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A148 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A14A 5F               ld e,a
  28+ A14B
  29+ A14B 7A               ld a,d
  30+ A14C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A14E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A150
  33+ A150 CB 3F            srl a
  34+ A152
  35+ A152 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A153
  37+ A153 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A154 28 04            jr z,4F
  39+ A156
  40+ A156 CB FF            set 7,a
  41+ A158 18 02            jr 5F
  42+ A15A
  43+ A15A CB BF        4 res 7,a
  44+ A15C
  45+ A15C CB 21        5 sla c
  46+ A15E 10 E0            djnz 6B
  47+ A160
  48+ A160 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A161
  50+ A161 77               ld (hl),a
  51+ A162 23               inc hl
  52+ A163 C1               pop bc
  53+ A164 10 D4            djnz 3B
  54+ A166
  55+ A166 C9               ret
  56+ A167
  57+ A167
  58+ A167
# file closed: RND_Derivando.asm
