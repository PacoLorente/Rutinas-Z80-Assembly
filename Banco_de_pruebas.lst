   3+ A683              ;
   4+ A683              ;	CLS.
   5+ A683              ;
   6+ A683              ;	Limpia la pantalla y define sus atributos.
   7+ A683              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A683              ;
   9+ A683              ;	COLORES: 0 ..... NEGRO
  10+ A683              ;    		 1 ..... AZUL
  11+ A683              ; 			 2 ..... ROJO
  12+ A683              ;			 3 ..... MAGENTA
  13+ A683              ; 			 4 ..... VERDE
  14+ A683              ; 			 5 ..... CIAN
  15+ A683              ;			 6 ..... AMARILLO
  16+ A683              ; 			 7 ..... BLANCO
  17+ A683              ;
  18+ A683              ;	INPUT: A contiene los atributos de pantalla.
  19+ A683              ;
  20+ A683              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A683
  22+ A683
  23+ A683 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A686 11 01 40     	LD DE,$4001
  25+ A689 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A68C 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A68E ED B0        	LDIR
  28+ A690 01 FF 02     	LD BC,767
  29+ A693 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A694 ED B0        	LDIR
  31+ A696
  32+ A696 AF           	xor a
  33+ A697
  34+ A697 C9           	ret
  35+ A698
