3321  A123              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A123              ; ******************************************************************************************************************************************************************************************
   2+ A123              ;
   3+ A123              ;   3/4/25
   4+ A123              ;
   5+ A123              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A123              ;   (XOR) bit a bit.
   7+ A123              ;
   8+ A123              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A123              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A123
  11+ A123              Derivando_RND
  12+ A123
  13+ A123 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A125 C5               push bc
  15+ A126              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A126 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A129              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A129
  19+ A129 A7           6 and a                                 ; Carry a "0".
  20+ A12A CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A12C 30 02            jr nc,1F
  22+ A12E
  23+ A12E CB C1            set 0,c
  24+ A130
  25+ A130 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A131 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A133 5F               ld e,a
  28+ A134
  29+ A134 7A               ld a,d
  30+ A135 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A137 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A139
  33+ A139 CB 3F            srl a
  34+ A13B
  35+ A13B AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A13C
  37+ A13C 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A13D 28 04            jr z,4F
  39+ A13F
  40+ A13F CB FF            set 7,a
  41+ A141 18 02            jr 5F
  42+ A143
  43+ A143 CB BF        4 res 7,a
  44+ A145
  45+ A145 CB 21        5 sla c
  46+ A147 10 E0            djnz 6B
  47+ A149
  48+ A149 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A14A
  50+ A14A 77               ld (hl),a
  51+ A14B 23               inc hl
  52+ A14C C1               pop bc
  53+ A14D 10 D4            djnz 3B
  54+ A14F
  55+ A14F C9               ret
  56+ A150
  57+ A150
  58+ A150
# file closed: RND_Derivando.asm
