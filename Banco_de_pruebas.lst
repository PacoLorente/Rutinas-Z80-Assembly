   1+ 8D9F
   2+ 8D9F
   3+ 8D9F              ;   07/07/23
   4+ 8D9F              ;
   5+ 8D9F              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8D9F              ;
   7+ 8D9F              ;   Codificación:
   8+ 8D9F              ;
   9+ 8D9F              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8D9F              ;
  11+ 8D9F              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8D9F              ;
  13+ 8D9F              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8D9F              ;
  15+ 8D9F              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8D9F              ;
  17+ 8D9F              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8D9F              ;                               ..... %01000010 Vel_up 4
  19+ 8D9F              ;                                               Vel_down 2
  20+ 8D9F              ;                               ..... $42
  21+ 8D9F              ;
  22+ 8D9F              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8D9F              ;
  24+ 8D9F              ;                               ..... %01000010 Vel_left 4
  25+ 8D9F              ;                                               Vel_right 2
  26+ 8D9F              ;                               ..... $42
  27+ 8D9F              ;
  28+ 8D9F              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8D9F              ;
  30+ 8D9F              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8D9F              ;
  32+ 8D9F              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8D9F              ;
  34+ 8D9F              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8D9F              ;                                     $53
  36+ 8D9F              ;
  37+ 8D9F              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8D9F              ;
  39+ 8D9F              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8D9F              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8D9F              ;
  42+ 8D9F              ;                       Arriba ..... $81
  43+ 8D9F              ;                       Arriba - izquierda ..... $a1
  44+ 8D9F              ;                       Arriba - derecha ..... $91
  45+ 8D9F              ;
  46+ 8D9F              ;                       Abajo ..... $41
  47+ 8D9F              ;                       Abajo - izquierda ..... $61
  48+ 8D9F              ;                       Abajo - derecha ..... $51
  49+ 8D9F              ;
  50+ 8D9F              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8D9F              ;
  52+ 8D9F              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8D9F              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8D9F              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8D9F              ;
  56+ 8D9F              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8D9F              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8D9F              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8D9F              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8D9F              ;
  61+ 8D9F              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8D9F              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8D9F              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8D9F              ;
  65+ 8D9F              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8D9F              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8D9F              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8D9F              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8D9F
