   6+ 976A              ;	Limpia la pantalla y define sus atributos.
   7+ 976A              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ 976A              ;
   9+ 976A              ;	COLORES: 0 ..... NEGRO
  10+ 976A              ;    		 1 ..... AZUL
  11+ 976A              ; 			 2 ..... ROJO
  12+ 976A              ;			 3 ..... MAGENTA
  13+ 976A              ; 			 4 ..... VERDE
  14+ 976A              ; 			 5 ..... CIAN
  15+ 976A              ;			 6 ..... AMARILLO
  16+ 976A              ; 			 7 ..... BLANCO
  17+ 976A              ;
  18+ 976A              ;	INPUT: A contiene los atributos de pantalla.
  19+ 976A              ;
  20+ 976A              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 976A
  22+ 976A
  23+ 976A 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ 976D 11 01 40     	LD DE,$4001
  25+ 9770 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 9773 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 9775 ED B0        	LDIR
  28+ 9777 01 FF 02     	LD BC,767
  29+ 977A 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 977B ED B0        	LDIR
  31+ 977D C9           	ret
  32+ 977E
