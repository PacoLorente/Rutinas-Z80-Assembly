  57+ 9B64              ;	INPUT:  HL contiene (Posicion_actual).
  58+ 9B64              ;	OUTPUT: (Cuad_objeto) y A contienen "1", "2", "3" o "4" en función del cuadrante de pantalla en el que se encuentra la entidad.
  59+ 9B64              ;
  60+ 9B64              ;	MODIFY: A.
  61+ 9B64
  62+ 9B64
