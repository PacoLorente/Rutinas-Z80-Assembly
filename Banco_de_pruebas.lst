 473+ C15A 08               ex af,af                ; Restore (Burst_sound).
 474+ C15B
 475+ C15B 67               ld h,a
 476+ C15C 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 477+ C15E
 478+ C15E E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 479+ C15F
 480+ C15F 22 8A 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 481+ C162 0E 03            ld c,3
