 651+ 9F61              ;
 652+ 9F61              ;   17/9/26
 653+ 9F61              ;
 654+ 9F61              ;   Herramienta para construir melodías y ruido con el SPEAKER.
 655+ 9F61
 656+ 9F61              Sound_Generator:
 657+ 9F61
 658+ 9F61              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 659+ 9F61              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 660+ 9F61              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 661+ 9F61              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 662+ 9F61              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 663+ 9F61              ;
 664+ 9F61
 665+ 9F61              ;   MODIFY: A,HL,BC y DE.
 666+ 9F61
 667+ 9F61              ;   Exclusión:
 668+ 9F61
 669+ 9F61 2A 06 96         ld hl,(Sound)
 670+ 9F64 7C               ld a,h
 671+ 9F65 B5               or l
 672+ 9F66 C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 673+ 9F67
 674+ 9F67 04               inc b
 675+ 9F68 05               dec b
 676+ 9F69 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
 677+ 9F6B
 678+ 9F6B              Loop_2:
 679+ 9F6B
 680+ 9F6B              ;   %xxxabccc
 681+ 9F6B
 682+ 9F6B              ;   %a ... Salida SPEAKER.
 683+ 9F6B              ;   %b ... MIC/EAR.
 684+ 9F6B              ;   %c ... BORDER Colour.
 685+ 9F6B
 686+ 9F6B
 687+ 9F6B 3E 10            ld a,%00010000          ; Borde negro.
 688+ 9F6D D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 689+ 9F6F
 690+ 9F6F              Delay_5:
 691+ 9F6F
 692+ 9F6F 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 693+ 9F70
 694+ 9F70 7C               ld a,h
 695+ 9F71 B5               or l
 696+ 9F72 20 FB            jr nz,Delay_5
 697+ 9F74
 698+ 9F74 2A 06 96         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 699+ 9F77
 700+ 9F77 AF               xor a                   ; Borde negro.    ---     4 tstates
 701+ 9F78 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 702+ 9F7A
 703+ 9F7A              Delay_6:
 704+ 9F7A
 705+ 9F7A 2B               dec hl
 706+ 9F7B
 707+ 9F7B 7C               ld a,h
 708+ 9F7C B5               or l
 709+ 9F7D 20 FB            jr nz,Delay_6
 710+ 9F7F
 711+ 9F7F              ; Hemos generado una onda sonora.
 712+ 9F7F              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 713+ 9F7F
 714+ 9F7F 2A 06 96         ld hl,(Sound)
 715+ 9F82
 716+ 9F82 1C               inc e
 717+ 9F83 1D               dec e
 718+ 9F84 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 719+ 9F86              ;                           ; (E)="0" indica que no hay variación en el tono.
 720+ 9F86
 721+ 9F86 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 722+ 9F87 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 723+ 9F88
 724+ 9F88              ; Rayo de entrada o de salida ???
 725+ 9F88
 726+ 9F88 A7               and a
 727+ 9F89 20 05            jr nz,Incrementa_delay
 728+ 9F8B
 729+ 9F8B              Decrementa_delay:
 730+ 9F8B
 731+ 9F8B 2B               dec hl
 732+ 9F8C 10 FD            djnz Decrementa_delay
 733+ 9F8E
 734+ 9F8E 18 03            jr 1F
 735+ 9F90
 736+ 9F90              Incrementa_delay:
 737+ 9F90
 738+ 9F90 23               inc hl
 739+ 9F91 10 FD            djnz Incrementa_delay
 740+ 9F93
 741+ 9F93              ; Descontamos la onda generada del total de ondas que tiene el efecto, (Sound).
