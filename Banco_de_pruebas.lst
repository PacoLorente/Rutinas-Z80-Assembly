   5+ 97AB              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 97AB              ;   (XOR) bit a bit.
   7+ 97AB              ;
   8+ 97AB              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 97AB              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 97AB
  11+ 97AB              Derivando_RND
  12+ 97AB
  13+ 97AB ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 97AD C5               push bc
  15+ 97AE              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 97AE 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 97B1              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 97B1
  19+ 97B1 A7           6 and a                                 ; Carry a "0".
  20+ 97B2 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 97B4 30 02            jr nc,1F
  22+ 97B6
  23+ 97B6 CB C1            set 0,c
  24+ 97B8
  25+ 97B8 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 97B9 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 97BB 5F               ld e,a
  28+ 97BC
  29+ 97BC 7A               ld a,d
  30+ 97BD E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 97BF 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 97C1
  33+ 97C1 CB 3F            srl a
  34+ 97C3
  35+ 97C3 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 97C4
  37+ 97C4 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 97C5 28 04            jr z,4F
  39+ 97C7
  40+ 97C7 CB FF            set 7,a
  41+ 97C9 18 02            jr 5F
  42+ 97CB
  43+ 97CB CB BF        4 res 7,a
  44+ 97CD
  45+ 97CD CB 21        5 sla c
  46+ 97CF 10 E0            djnz 6B
  47+ 97D1
  48+ 97D1 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 97D2
  50+ 97D2 77               ld (hl),a
  51+ 97D3 23               inc hl
  52+ 97D4 C1               pop bc
  53+ 97D5 10 D4            djnz 3B
  54+ 97D7
  55+ 97D7 C9               ret
