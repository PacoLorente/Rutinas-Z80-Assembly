  28+ A559 01 FF 02     	LD BC,767
  29+ A55C 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A55D ED B0        	LDIR
  31+ A55F
  32+ A55F AF           	xor a
  33+ A560
  34+ A560 C9           	ret
  35+ A561
