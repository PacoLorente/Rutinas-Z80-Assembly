 481  91E5              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 91E5
   2+ 91E5
   3+ 91E5              ;   07/07/23
   4+ 91E5              ;
   5+ 91E5              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 91E5              ;
   7+ 91E5              ;   Codificación:
   8+ 91E5              ;
   9+ 91E5              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 91E5              ;
  11+ 91E5              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 91E5              ;
  13+ 91E5              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 91E5              ;
  15+ 91E5              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 91E5              ;
  17+ 91E5              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 91E5              ;                               ..... %01000010 Vel_up 4
  19+ 91E5              ;                                               Vel_down 2
  20+ 91E5              ;                               ..... $42
  21+ 91E5              ;
  22+ 91E5              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 91E5              ;
  24+ 91E5              ;                               ..... %01000010 Vel_left 4
  25+ 91E5              ;                                               Vel_right 2
  26+ 91E5              ;                               ..... $42
  27+ 91E5              ;
  28+ 91E5              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 91E5              ;
  30+ 91E5              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 91E5              ;
  32+ 91E5              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 91E5              ;
  34+ 91E5              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 91E5              ;                                     $53
  36+ 91E5              ;
  37+ 91E5              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 91E5              ;
  39+ 91E5              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 91E5              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 91E5              ;
  42+ 91E5              ;                       Arriba ..... $81
  43+ 91E5              ;                       Arriba - izquierda ..... $a1
  44+ 91E5              ;                       Arriba - derecha ..... $91
  45+ 91E5              ;
  46+ 91E5              ;                       Abajo ..... $41
  47+ 91E5              ;                       Abajo - izquierda ..... $61
  48+ 91E5              ;                       Abajo - derecha ..... $51
  49+ 91E5              ;
  50+ 91E5              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 91E5              ;
  52+ 91E5              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 91E5              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 91E5              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 91E5              ;
  56+ 91E5              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 91E5              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 91E5              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 91E5              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 91E5              ;
  61+ 91E5              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 91E5              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 91E5              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 91E5              ;
  65+ 91E5              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 91E5              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 91E5              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 91E5              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 91E5
  70+ 91E5              ; ----- ----- ----- ----- -----
  71+ 91E5              ;
  72+ 91E5              ;   Factor RANDOM --- BadSat.
  73+ 91E5
