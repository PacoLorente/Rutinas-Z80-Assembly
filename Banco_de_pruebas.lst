  13+ 95E2              ; 			 4 ..... VERDE
  14+ 95E2              ; 			 5 ..... CIAN
  15+ 95E2              ;			 6 ..... AMARILLO
  16+ 95E2              ; 			 7 ..... BLANCO
  17+ 95E2              ;
  18+ 95E2              ;	INPUT: A contiene los atributos de pantalla.
  19+ 95E2              ;
  20+ 95E2              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 95E2
  22+ 95E2
  23+ 95E2 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ 95E5 11 01 40     	LD DE,$4001
  25+ 95E8 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 95EB 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 95ED ED B0        	LDIR
  28+ 95EF 01 FF 02     	LD BC,767
  29+ 95F2 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 95F3 ED B0        	LDIR
  31+ 95F5 C9           	ret
  32+ 95F6
