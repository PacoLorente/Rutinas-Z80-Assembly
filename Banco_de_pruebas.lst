 372+ A3E1              ;
 373+ A3E1              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 374+ A3E1              ;
 375+ A3E1              ;	INPUTS:		B contiene (Numero_de_entidades).
 376+ A3E1              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 377+ A3E1              ; 				HL contiene (Puntero_de_entidades).
 378+ A3E1
 379+ A3E1              Prepara_Cajas_Master:
 380+ A3E1
 381+ A3E1 E5           	push hl															; Push (Puntero_de_entidades).
 382+ A3E2 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A3E3
 384+ A3E3              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A3E3
 386+ A3E3 79           	ld a,c
 387+ A3E4 08           	ex af,af
 388+ A3E5 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A3E6
 390+ A3E6 CD 0C A6     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 391+ A3E9              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A3E9              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A3E9 A7           	and a
 394+ A3EA 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A3EC
 396+ A3EC              ; Generamos movimientos masticados.
 397+ A3EC
 398+ A3EC              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A3EC
 400+ A3EC 79           	ld a,c 															; (A) = (Clase).
 401+ A3ED 32 67 95     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A3F0
 403+ A3F0 CD E5 A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A3F3 CD 77 A7     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A3F6
 406+ A3F6              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 407+ A3F6              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 408+ A3F6              ;	coreografías distintas.
