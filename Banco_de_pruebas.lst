   4+ 99AD              ;
   5+ 99AD              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99AD              ;   (XOR) bit a bit.
   7+ 99AD              ;
   8+ 99AD              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99AD              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99AD
  11+ 99AD              Derivando_RND
  12+ 99AD
  13+ 99AD ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99AF C5               push bc
  15+ 99B0              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99B0 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99B3              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99B3
  19+ 99B3 A7           6 and a                                 ; Carry a "0".
  20+ 99B4 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99B6 30 02            jr nc,1F
  22+ 99B8
  23+ 99B8 CB C1            set 0,c
  24+ 99BA
  25+ 99BA 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99BB E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99BD 5F               ld e,a
  28+ 99BE
  29+ 99BE 7A               ld a,d
  30+ 99BF E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99C1 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99C3
  33+ 99C3 CB 3F            srl a
  34+ 99C5
  35+ 99C5 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99C6
  37+ 99C6 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99C7 28 04            jr z,4F
  39+ 99C9
  40+ 99C9 CB FF            set 7,a
  41+ 99CB 18 02            jr 5F
  42+ 99CD
  43+ 99CD CB BF        4 res 7,a
  44+ 99CF
  45+ 99CF CB 21        5 sla c
  46+ 99D1 10 E0            djnz 6B
  47+ 99D3
  48+ 99D3 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99D4
  50+ 99D4 77               ld (hl),a
  51+ 99D5 23               inc hl
  52+ 99D6 C1               pop bc
  53+ 99D7 10 D4            djnz 3B
  54+ 99D9
  55+ 99D9 C9               ret
