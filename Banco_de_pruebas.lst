 595+ 9F55
 596+ 9F55 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 597+ 9F56
 598+ 9F56 7C               ld a,h
 599+ 9F57 B5               or l
 600+ 9F58 20 FB            jr nz,Delay_5
