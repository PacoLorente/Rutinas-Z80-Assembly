  16  A680              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A680              ; ******************************************************************************************************************************************************************************************
   2+ A680              ;
   3+ A680              ;   3/4/25
   4+ A680              ;
   5+ A680              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A680              ;   (XOR) bit a bit.
   7+ A680              ;
   8+ A680              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A680              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A680
  11+ A680              Derivando_RND
  12+ A680
  13+ A680 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A682 C5               push bc
  15+ A683              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A683 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A686              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A686
  19+ A686 A7           6 and a                                 ; Carry a "0".
  20+ A687 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A689 30 02            jr nc,1F
  22+ A68B
  23+ A68B CB C1            set 0,c
  24+ A68D
  25+ A68D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A68E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A690 5F               ld e,a
  28+ A691
  29+ A691 7A               ld a,d
  30+ A692 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A694 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A696
  33+ A696 CB 3F            srl a
  34+ A698
  35+ A698 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A699
  37+ A699 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A69A 28 04            jr z,4F
  39+ A69C
  40+ A69C CB FF            set 7,a
  41+ A69E 18 02            jr 5F
  42+ A6A0
  43+ A6A0 CB BF        4 res 7,a
  44+ A6A2
  45+ A6A2 CB 21        5 sla c
  46+ A6A4 10 E0            djnz 6B
  47+ A6A6
  48+ A6A6 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A6A7
  50+ A6A7 77               ld (hl),a
  51+ A6A8 23               inc hl
  52+ A6A9 C1               pop bc
  53+ A6AA 10 D4            djnz 3B
  54+ A6AC
  55+ A6AC C9               ret
  56+ A6AD
