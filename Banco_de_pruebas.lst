 600+ B1F3              ;
 601+ B1F3              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ B1F3              ;
 603+ B1F3              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ B1F3              ;
 605+ B1F3              ;       DESTRUIDOS: AF y HL !!!
 606+ B1F3              ;
 607+ B1F3              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ B1F3              ;
 609+ B1F3
 610+ B1F3 7C           PreviousScan ld a,h
 611+ B1F4 25               dec h               							; Dec H.
 612+ B1F5 E6 07            and 7
 613+ B1F7 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ B1F8
 615+ B1F8 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B1F9 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B1FB 6F               ld l,a
 618+ B1FC D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
