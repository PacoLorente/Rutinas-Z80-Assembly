 614+ AE19
 615+ AE19 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ AE1A D6 20            sub $20             							; Vamos a comprobarlo...
 617+ AE1C 6F               ld l,a
