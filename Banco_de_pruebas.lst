 441+ A41F
 442+ A41F 2A A7 95     	ld hl,(Puntero_indice_master)
 443+ A422 CD 46 9E     	call Extrae_address
 444+ A425
 445+ A425 5D           	ld e,l
 446+ A426 54           	ld d,h
 447+ A427
 448+ A427 CD A9 A7     	call Parametros_de_bandeja_DRAW_a_Caja_Master	 				; Caja de entidades Master completa.
 449+ A42A
 450+ A42A              ;	Limpiamos la bandeja_DRAW y las variables de movimiento para poder generar los mov. masticados_
 451+ A42A              ;	_de otro (Tipo) de entidad.
 452+ A42A              ;
 453+ A42A              ;	Limpiamos bandeja y variables.
 454+ A42A
 455+ A42A AF           	xor a
 456+ A42B 32 DA 95     	ld (Ctrl_3),a 													; (Ctrl_3) ha de inicializarse pués lo utilizamos para indicar_
