2396  99A8              	include "Draw_XOR.asm"
# file opened: Draw_XOR.asm
   1+ 99A8              ; ******************************************************************************************************************************************************************************************
   2+ 99A8              ;
   3+ 99A8              ; 26/06/23
   4+ 99A8              ;
   5+ 99A8              ; DRAW. ************************************************************************************************************************************************************************************
   6+ 99A8
   7+ 99A8              Draw
   8+ 99A8
   9+ 99A8 CD 3D 9C     	call Prepara_draw
  10+ 99AB 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 99AC A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 99AD 28 05        	jr z,2F
  13+ 99AF
  14+ 99AF 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99B2 18 0C        	jr 1F
  16+ 99B4
  17+ 99B4              ;	Inicia entidad.
  18+ 99B4
  19+ 99B4 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99B7 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99BA CD 45 9B     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  22+ 99BD              ;													; _la esquina superior izquierda de la pantalla.
  23+ 99BD CD D3 A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  24+ 99C0
  25+ 99C0 3A F7 8B     1 ld a,(Ctrl_0)
  26+ 99C3 CB 6F        	bit 5,a
  27+ 99C5 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  28+ 99C7
  29+ 99C7 CD DC 99     	call Comprueba_limite_horizontal
  30+ 99CA CD 6C 9A     	call Comprueba_limite_vertical
  31+ 99CD
  32+ 99CD              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  33+ 99CD              ; -----------------------
  34+ 99CD              ; -----------------------
  35+ 99CD              ; -----------------------
  36+ 99CD
  37+ 99CD CD C1 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  38+ 99D0 CD E5 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  39+ 99D3
  40+ 99D3 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina REStauramos el bit5 de Ctrl_0 para que nos vuelva_
  41+ 99D6 CB AF        	res 5,a											; _a ser de utilidad.
  42+ 99D8 32 F7 8B     	ld (Ctrl_0),a
  43+ 99DB
  44+ 99DB C9           	ret
  45+ 99DC
  46+ 99DC              ; *******************************************************************************************************************************************************************************************
  47+ 99DC              ;	21/01/23
  48+ 99DC              ;
  49+ 99DC              ; 	Comprueba_limite_horizontal.
  50+ 99DC              ;
  51+ 99DC              ;	La rutina comprueba si hemos sobrepasado el (Limite_horizontal) definido en la rutina [Inicializacion]. Este será:_
  52+ 99DC              ;	_ $4fc0 si partimos de los cuadrantes 1 o 2 de pantalla o $4820 si partimos de los cuadrantes 3 o 4.
  53+ 99DC              ;
  54+ 99DC              ;	Si sobrepasamos o alcanzamos el límite horizontal establecido, la rutina cargará el registro E con un "1".
