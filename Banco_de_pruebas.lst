 372+ A3D9              ;
 373+ A3D9              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 374+ A3D9              ;
 375+ A3D9              ;	INPUTS:		B contiene (Numero_de_entidades).
 376+ A3D9              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 377+ A3D9              ; 				HL contiene (Puntero_de_entidades).
 378+ A3D9
 379+ A3D9              Prepara_Cajas_Master:
 380+ A3D9
 381+ A3D9 E5           	push hl															; Push (Puntero_de_entidades).
 382+ A3DA C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A3DB
 384+ A3DB              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A3DB
 386+ A3DB 79           	ld a,c
 387+ A3DC 08           	ex af,af
 388+ A3DD 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A3DE
 390+ A3DE CD 04 A6     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 391+ A3E1              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A3E1              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A3E1 A7           	and a
 394+ A3E2 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A3E4
 396+ A3E4              ; Generamos movimientos masticados.
 397+ A3E4
 398+ A3E4              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A3E4
 400+ A3E4 79           	ld a,c 															; (A) = (Clase).
 401+ A3E5 32 67 95     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A3E8
 403+ A3E8 CD DD A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A3EB CD 6F A7     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A3EE
 406+ A3EE              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 407+ A3EE              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 408+ A3EE              ;	coreografías distintas.
 409+ A3EE
 410+ A3EE 06 07        	ld b,7
 411+ A3F0 21 07 90     	ld hl,Numeros_aleatorios_baile
 412+ A3F3 CD 11 9E     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 413+ A3F6
 414+ A3F6              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 415+ A3F6
 416+ A3F6 3A 68 95     	ld a,(Tipo)
 417+ A3F9 CD 31 A6     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 418+ A3FC CD 83 A5     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 419+ A3FF
 420+ A3FF              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 421+ A3FF
 422+ A3FF C1           	pop bc
 423+ A400 E1           	pop hl
 424+ A401
 425+ A401 E5           	push hl															; Push (Puntero_de_entidades).
 426+ A402 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 427+ A403
 428+ A403              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 429+ A403
 430+ A403 CD 40 A4     	call Determina_posicion_de_inicio 								; $941e ($78),($76),($72)
 431+ A406
 432+ A406 3A 68 95     	ld a,(Tipo)
 433+ A409 CD 41 A6     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
