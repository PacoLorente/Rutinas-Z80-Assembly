# file opened: RND_Derivando.asm
   1+ 94A5              ; ******************************************************************************************************************************************************************************************
   2+ 94A5              ;
   3+ 94A5              ;   3/4/25
   4+ 94A5              ;
   5+ 94A5              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 94A5              ;   (XOR) bit a bit.
   7+ 94A5              ;
   8+ 94A5              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 94A5              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 94A5
  11+ 94A5              Derivando_RND
  12+ 94A5
  13+ 94A5 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94A7 C5               push bc
  15+ 94A8              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94A8 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94AB              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94AB
  19+ 94AB A7           6 and a                                 ; Carry a "0".
  20+ 94AC CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94AE 30 02            jr nc,1F
  22+ 94B0
  23+ 94B0 CB C1            set 0,c
  24+ 94B2
  25+ 94B2 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94B3 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94B5 5F               ld e,a
