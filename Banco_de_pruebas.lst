   5+ 9D0E              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D0E              ;   (XOR) bit a bit.
   7+ 9D0E              ;
   8+ 9D0E              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D0E              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D0E
  11+ 9D0E              Derivando_RND
  12+ 9D0E
  13+ 9D0E ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D10 C5               push bc
  15+ 9D11              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D11 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D14              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D14
  19+ 9D14 A7           6 and a                                 ; Carry a "0".
  20+ 9D15 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D17 30 02            jr nc,1F
  22+ 9D19
  23+ 9D19 CB C1            set 0,c
  24+ 9D1B
  25+ 9D1B 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D1C E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D1E 5F               ld e,a
  28+ 9D1F
  29+ 9D1F 7A               ld a,d
  30+ 9D20 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D22 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D24
  33+ 9D24 CB 3F            srl a
  34+ 9D26
  35+ 9D26 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D27
  37+ 9D27 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D28 28 04            jr z,4F
  39+ 9D2A
  40+ 9D2A CB FF            set 7,a
  41+ 9D2C 18 02            jr 5F
  42+ 9D2E
  43+ 9D2E CB BF        4 res 7,a
  44+ 9D30
  45+ 9D30 CB 21        5 sla c
  46+ 9D32 10 E0            djnz 6B
  47+ 9D34
  48+ 9D34 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D35
  50+ 9D35 77               ld (hl),a
  51+ 9D36 23               inc hl
  52+ 9D37 C1               pop bc
  53+ 9D38 10 D4            djnz 3B
  54+ 9D3A
  55+ 9D3A C9               ret
