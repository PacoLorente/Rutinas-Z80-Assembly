 181  8E90              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 182  8E90
 183  8E90 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 184  8E92
 185  8E92              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 186  8E92
 187  8E92 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 188  8E94              ;															  _palabras que componen el "movimiento_masticado".
 189  8E94
 190  8E94              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 191  8E94
 192  8E94 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 193  8E95              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 194  8E95              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 195  8E95              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 196  8E95              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 197  8E95
