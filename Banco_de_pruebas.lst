 252  8C54
 253  8C54              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
 254  8C54              ;
 255  8C54              ;	COLORES: 0 ..... NEGRO
 256  8C54              ;    		 1 ..... AZUL
 257  8C54              ; 			 2 ..... ROJO
 258  8C54              ;			 3 ..... MAGENTA
 259  8C54              ; 			 4 ..... VERDE
 260  8C54              ; 			 5 ..... CIAN
 261  8C54              ;			 6 ..... AMARILLO
 262  8C54              ; 			 7 ..... BLANCO
 263  8C54
