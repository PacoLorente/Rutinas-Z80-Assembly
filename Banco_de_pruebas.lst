   1+ 9464              ; ******************************************************************************************************************************************************************************************
   2+ 9464              ;
   3+ 9464              ;   21/04/24
   4+ 9464              ;
   5+ 9464              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9464              ;   (XOR) bit a bit.
   7+ 9464              ;
   8+ 9464              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9464
  10+ 9464              Derivando_RND
  11+ 9464
  12+ 9464 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9467
  14+ 9467 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9469 C5               push bc
  16+ 946A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 946A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 946D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 946D
  20+ 946D A7           6 and a                                 ; Carry a "0".
  21+ 946E CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9470 30 02            jr nc,1F
  23+ 9472
  24+ 9472 CB C1            set 0,c
  25+ 9474
  26+ 9474 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9475 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9477 5F               ld e,a
  29+ 9478
  30+ 9478 7A               ld a,d
  31+ 9479 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 947B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 947D
  34+ 947D CB 3F            srl a
  35+ 947F
  36+ 947F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9480
  38+ 9480 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9481 28 04            jr z,4F
  40+ 9483
  41+ 9483 CB FF            set 7,a
  42+ 9485 18 02            jr 5F
  43+ 9487
  44+ 9487 CB BF        4 res 7,a
  45+ 9489
  46+ 9489 CB 21        5 sla c
  47+ 948B 10 E0            djnz 6B
  48+ 948D
  49+ 948D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 948E
