   3+ 8A6C              ;   07/07/23
   4+ 8A6C              ;
   5+ 8A6C              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8A6C              ;
   7+ 8A6C              ;   Codificación:
   8+ 8A6C              ;
   9+ 8A6C              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8A6C              ;
  11+ 8A6C              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8A6C              ;
  13+ 8A6C              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8A6C              ;
  15+ 8A6C              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8A6C              ;
  17+ 8A6C              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8A6C              ;                               ..... %01000010 Vel_up 4
  19+ 8A6C              ;                                               Vel_down 2
  20+ 8A6C              ;                               ..... $42
  21+ 8A6C              ;
  22+ 8A6C              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8A6C              ;
  24+ 8A6C              ;                               ..... %01000010 Vel_left 4
  25+ 8A6C              ;                                               Vel_right 2
  26+ 8A6C              ;                               ..... $42
  27+ 8A6C              ;
  28+ 8A6C              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8A6C              ;
  30+ 8A6C              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8A6C              ;
  32+ 8A6C              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8A6C              ;
  34+ 8A6C              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8A6C              ;                                     $53
  36+ 8A6C              ;
  37+ 8A6C              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8A6C              ;
  39+ 8A6C              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8A6C              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8A6C              ;
  42+ 8A6C              ;                       Arriba ..... $81
  43+ 8A6C              ;                       Arriba - izquierda ..... $a1
  44+ 8A6C              ;                       Arriba - derecha ..... $91
  45+ 8A6C              ;
  46+ 8A6C              ;                       Abajo ..... $41
  47+ 8A6C              ;                       Abajo - izquierda ..... $61
  48+ 8A6C              ;                       Abajo - derecha ..... $51
  49+ 8A6C              ;
  50+ 8A6C              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8A6C              ;
  52+ 8A6C              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8A6C              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8A6C              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8A6C              ;
  56+ 8A6C              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8A6C              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8A6C              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8A6C              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8A6C              ;
  61+ 8A6C              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8A6C              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8A6C              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8A6C              ;
  65+ 8A6C              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8A6C              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8A6C              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8A6C              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8A6C
