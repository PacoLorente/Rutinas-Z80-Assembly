 186  8E3A
 187  8E3A 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 188  8E3C              ;															  _palabras que componen el "movimiento_masticado".
 189  8E3C
 190  8E3C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 191  8E3C
 192  8E3C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 193  8E3D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 194  8E3D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 195  8E3D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 196  8E3D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 197  8E3D
