   3+ 8C2B              ;   07/07/23
   4+ 8C2B              ;
   5+ 8C2B              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8C2B              ;
   7+ 8C2B              ;   Codificación:
   8+ 8C2B              ;
   9+ 8C2B              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8C2B              ;
  11+ 8C2B              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8C2B              ;
  13+ 8C2B              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8C2B              ;
  15+ 8C2B              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8C2B              ;
  17+ 8C2B              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8C2B              ;                               ..... %01000010 Vel_up 4
  19+ 8C2B              ;                                               Vel_down 2
  20+ 8C2B              ;                               ..... $42
  21+ 8C2B              ;
  22+ 8C2B              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8C2B              ;
  24+ 8C2B              ;                               ..... %01000010 Vel_left 4
  25+ 8C2B              ;                                               Vel_right 2
  26+ 8C2B              ;                               ..... $42
  27+ 8C2B              ;
  28+ 8C2B              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8C2B              ;
  30+ 8C2B              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8C2B              ;
  32+ 8C2B              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8C2B              ;
  34+ 8C2B              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8C2B              ;                                     $53
  36+ 8C2B              ;
  37+ 8C2B              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8C2B              ;
  39+ 8C2B              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8C2B              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8C2B              ;
  42+ 8C2B              ;                       Arriba ..... $81
  43+ 8C2B              ;                       Arriba - izquierda ..... $a1
  44+ 8C2B              ;                       Arriba - derecha ..... $91
  45+ 8C2B              ;
  46+ 8C2B              ;                       Abajo ..... $41
  47+ 8C2B              ;                       Abajo - izquierda ..... $61
  48+ 8C2B              ;                       Abajo - derecha ..... $51
  49+ 8C2B              ;
  50+ 8C2B              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8C2B              ;
  52+ 8C2B              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8C2B              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8C2B              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8C2B              ;
  56+ 8C2B              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8C2B              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8C2B              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8C2B              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8C2B              ;
  61+ 8C2B              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8C2B              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8C2B              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8C2B              ;
  65+ 8C2B              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8C2B              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8C2B              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8C2B              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8C2B
