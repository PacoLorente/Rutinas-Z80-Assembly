   5+ 991F              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 991F              ;   (XOR) bit a bit.
   7+ 991F              ;
   8+ 991F              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 991F              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 991F
  11+ 991F              Derivando_RND
  12+ 991F
  13+ 991F ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9921 C5               push bc
  15+ 9922              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9922 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9925              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9925
  19+ 9925 A7           6 and a                                 ; Carry a "0".
  20+ 9926 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9928 30 02            jr nc,1F
  22+ 992A
  23+ 992A CB C1            set 0,c
  24+ 992C
  25+ 992C 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 992D E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 992F 5F               ld e,a
  28+ 9930
  29+ 9930 7A               ld a,d
  30+ 9931 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9933 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9935
  33+ 9935 CB 3F            srl a
  34+ 9937
  35+ 9937 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9938
  37+ 9938 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9939 28 04            jr z,4F
  39+ 993B
  40+ 993B CB FF            set 7,a
  41+ 993D 18 02            jr 5F
  42+ 993F
  43+ 993F CB BF        4 res 7,a
