 793+ B60B              ;
 794+ B60B              ;	5/08/22
 795+ B60B              ;
 796+ B60B              ;   PreviousScan.
 797+ B60B              ;
 798+ B60B              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 799+ B60B              ;
 800+ B60B              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 801+ B60B              ;
 802+ B60B              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 803+ B60B              ;
 804+ B60B              ;       DESTRUIDOS: AF y HL !!!
 805+ B60B              ;
 806+ B60B              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 807+ B60B              ;
 808+ B60B
 809+ B60B              PreviousScan:
 810+ B60B
 811+ B60B 7C           	ld a,h
 812+ B60C 25               dec h               							; Dec H.
 813+ B60D E6 07            and 7
 814+ B60F C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 815+ B610
 816+ B610 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 817+ B611 D6 20            sub $20             							; Vamos a comprobarlo...
 818+ B613 6F               ld l,a
 819+ B614 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 820+ B615
 821+ B615 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 822+ B616 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 823+ B618 67               ld h,a
 824+ B619 C9               ret
