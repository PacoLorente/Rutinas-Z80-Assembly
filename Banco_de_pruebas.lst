 623+ B500 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 624+ B501
 625+ B501 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 626+ B502 D6 20            sub $20             							; Vamos a comprobarlo...
 627+ B504 6F               ld l,a
 628+ B505 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 629+ B506
 630+ B506 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 631+ B507 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 632+ B509 67               ld h,a
 633+ B50A C9               ret
