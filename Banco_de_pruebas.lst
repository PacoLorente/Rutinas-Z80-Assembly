 399+ A2B8
 400+ A2B8 79           	ld a,c 															; (A) = (Clase).
 401+ A2B9 32 B7 93     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A2BC
 403+ A2BC CD B1 A5     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
