   5+ 9EE0              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9EE0              ;   (XOR) bit a bit.
   7+ 9EE0              ;
   8+ 9EE0              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9EE0              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9EE0
  11+ 9EE0              Derivando_RND
  12+ 9EE0
  13+ 9EE0 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9EE2 C5               push bc
  15+ 9EE3              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9EE3 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9EE6              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9EE6
  19+ 9EE6 A7           6 and a                                 ; Carry a "0".
  20+ 9EE7 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9EE9 30 02            jr nc,1F
  22+ 9EEB
  23+ 9EEB CB C1            set 0,c
  24+ 9EED
  25+ 9EED 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9EEE E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9EF0 5F               ld e,a
  28+ 9EF1
  29+ 9EF1 7A               ld a,d
  30+ 9EF2 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9EF4 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9EF6
  33+ 9EF6 CB 3F            srl a
  34+ 9EF8
  35+ 9EF8 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9EF9
  37+ 9EF9 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9EFA 28 04            jr z,4F
  39+ 9EFC
  40+ 9EFC CB FF            set 7,a
  41+ 9EFE 18 02            jr 5F
  42+ 9F00
  43+ 9F00 CB BF        4 res 7,a
  44+ 9F02
  45+ 9F02 CB 21        5 sla c
  46+ 9F04 10 E0            djnz 6B
  47+ 9F06
  48+ 9F06 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9F07
  50+ 9F07 77               ld (hl),a
  51+ 9F08 23               inc hl
  52+ 9F09 C1               pop bc
  53+ 9F0A 10 D4            djnz 3B
  54+ 9F0C
  55+ 9F0C C9               ret
