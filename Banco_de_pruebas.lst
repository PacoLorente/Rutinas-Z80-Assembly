   5+ 9E11              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E11              ;   (XOR) bit a bit.
   7+ 9E11              ;
   8+ 9E11              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E11              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E11
  11+ 9E11              Derivando_RND
  12+ 9E11
  13+ 9E11 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9E13 C5               push bc
  15+ 9E14              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9E14 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9E17              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9E17
  19+ 9E17 A7           6 and a                                 ; Carry a "0".
  20+ 9E18 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9E1A 30 02            jr nc,1F
  22+ 9E1C
  23+ 9E1C CB C1            set 0,c
  24+ 9E1E
  25+ 9E1E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9E1F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9E21 5F               ld e,a
  28+ 9E22
  29+ 9E22 7A               ld a,d
  30+ 9E23 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9E25 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9E27
  33+ 9E27 CB 3F            srl a
  34+ 9E29
  35+ 9E29 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9E2A
  37+ 9E2A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9E2B 28 04            jr z,4F
  39+ 9E2D
  40+ 9E2D CB FF            set 7,a
  41+ 9E2F 18 02            jr 5F
  42+ 9E31
  43+ 9E31 CB BF        4 res 7,a
