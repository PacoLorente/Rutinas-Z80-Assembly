   5+ 93F9              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93F9              ;   (XOR) bit a bit.
   7+ 93F9              ;
   8+ 93F9              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93F9
  10+ 93F9              Derivando_RND
  11+ 93F9
  12+ 93F9 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93FC
  14+ 93FC ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93FE C5               push bc
  16+ 93FF              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93FF 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9402              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9402
  20+ 9402 A7           6 and a                                 ; Carry a "0".
  21+ 9403 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9405 30 02            jr nc,1F
  23+ 9407
  24+ 9407 CB C1            set 0,c
  25+ 9409
  26+ 9409 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 940A E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 940C 5F               ld e,a
  29+ 940D
  30+ 940D 7A               ld a,d
  31+ 940E E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9410 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9412
  34+ 9412 CB 3F            srl a
  35+ 9414
  36+ 9414 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9415
  38+ 9415 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9416 28 04            jr z,4F
  40+ 9418
  41+ 9418 CB FF            set 7,a
  42+ 941A 18 02            jr 5F
  43+ 941C
  44+ 941C CB BF        4 res 7,a
  45+ 941E
  46+ 941E CB 21        5 sla c
  47+ 9420 10 E0            djnz 6B
  48+ 9422
  49+ 9422 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9423
  51+ 9423 77               ld (hl),a
  52+ 9424 23               inc hl
  53+ 9425 C1               pop bc
  54+ 9426 10 D4            djnz 3B
  55+ 9428
  56+ 9428 C9               ret
