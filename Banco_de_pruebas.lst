 583+ B1B1 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1B2 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1B4 6F               ld l,a
 586+ B1B5 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1B6
 588+ B1B6 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1B7 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1B9 67               ld h,a
 591+ B1BA C9               ret
