 212+ C9AA
 213+ C9AA 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 214+ C9AB
 215+ C9AB D1               pop de                                   ; Score_max_msg en DE.
 216+ C9AC
 217+ C9AC CD B5 C9         call ASCII_CODE_de_KEYCODE
 218+ C9AF
