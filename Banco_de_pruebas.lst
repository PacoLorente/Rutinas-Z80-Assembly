   4+ 9DAE              ;
   5+ 9DAE              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9DAE              ;   (XOR) bit a bit.
   7+ 9DAE              ;
   8+ 9DAE              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9DAE              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9DAE
  11+ 9DAE              Derivando_RND
  12+ 9DAE
  13+ 9DAE ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9DB0 C5               push bc
  15+ 9DB1              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9DB1 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9DB4              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9DB4
  19+ 9DB4 A7           6 and a                                 ; Carry a "0".
  20+ 9DB5 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9DB7 30 02            jr nc,1F
  22+ 9DB9
  23+ 9DB9 CB C1            set 0,c
  24+ 9DBB
  25+ 9DBB 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9DBC E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9DBE 5F               ld e,a
  28+ 9DBF
  29+ 9DBF 7A               ld a,d
  30+ 9DC0 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9DC2 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9DC4
  33+ 9DC4 CB 3F            srl a
  34+ 9DC6
  35+ 9DC6 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9DC7
  37+ 9DC7 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9DC8 28 04            jr z,4F
  39+ 9DCA
  40+ 9DCA CB FF            set 7,a
  41+ 9DCC 18 02            jr 5F
  42+ 9DCE
  43+ 9DCE CB BF        4 res 7,a
  44+ 9DD0
  45+ 9DD0 CB 21        5 sla c
  46+ 9DD2 10 E0            djnz 6B
  47+ 9DD4
  48+ 9DD4 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9DD5
  50+ 9DD5 77               ld (hl),a
  51+ 9DD6 23               inc hl
  52+ 9DD7 C1               pop bc
  53+ 9DD8 10 D4            djnz 3B
  54+ 9DDA
  55+ 9DDA C9               ret
  56+ 9DDB
  57+ 9DDB
  58+ 9DDB
