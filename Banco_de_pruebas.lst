  12+ A3DA              ;		Estructura de cada línea en la (Tabla_de_pintado):
  13+ A3DA              ;
  14+ A3DA              ;		(Columna_Y), (Attr), (Columnas) y .defw (Album_de_pintado).
  15+ A3DA              ;		.db, .db, .db, .defw
  16+ A3DA              ;
  17+ A3DA              ;	Por último; decrementa el contador (Contador_de_mov_masticados).
  18+ A3DA              ;
  19+ A3DA              ;	INPUTS: IX apunta al 1er .db de la `Caja_de_entidades' correspondiente.
