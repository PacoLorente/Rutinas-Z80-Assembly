 288  93EB              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 289  93EB
 290  93EB 00 00        Puntero_de_almacen_de_mov_masticados defw 0
