1429+ B264 21 0C 93         ld hl,Impacto2                                 ; Cuando se produce Colisión, RES el bit2 de (Impacto2) y_
1430+ B267 CB 96            res 2,(hl)                                     ; _ SET el bit3. El bit3 de (Impacto2) indica que hay contacto_
1431+ B269
1432+ B269 11 90 8B         ld de,Indice_Explosion_entidades
1433+ B26C 2A 0D 93         ld hl,(Entidad_sospechosa_de_colision)         ; Situamos el (Puntero_de_almacen_de_mov_masticados) de la entidad impactada en la primera palabra del índice de explosiones.
1434+ B26F
1435+ B26F 23               inc hl
1436+ B270 23               inc hl
1437+ B271 23               inc hl
1438+ B272
1439+ B272 73               ld (hl),e
1440+ B273 23               inc hl
1441+ B274 72               ld (hl),d
1442+ B275
1443+ B275              ; Situamos también el (Puntero_de_almacen_de_mov_masticados) de Amadeus en la primero explosión.
1444+ B275
1445+ B275 11 30 8C         ld de,Indice_Explosion_Amadeus
1446+ B278 21 DA 8E         ld hl,Pamm_Amadeus
1447+ B27B
1448+ B27B 73               ld (hl),e
1449+ B27C 23               inc hl
