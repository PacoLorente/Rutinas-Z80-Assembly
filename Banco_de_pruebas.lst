 557+ 9EE5              ;
 558+ 9EE5              ;   Herramienta para construir melodías y ruido con el SPEAKER.
 559+ 9EE5
 560+ 9EE5              Sound_Generator:
 561+ 9EE5
 562+ 9EE5              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 563+ 9EE5              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 564+ 9EE5              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 565+ 9EE5              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 566+ 9EE5              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 567+ 9EE5              ;
 568+ 9EE5
 569+ 9EE5              ;   MODIFY: A,HL,BC y DE.
 570+ 9EE5
 571+ 9EE5              ;   Exclusión:
 572+ 9EE5
 573+ 9EE5 2A 84 94         ld hl,(Sound)
 574+ 9EE8 7C               ld a,h
 575+ 9EE9 B5               or l
 576+ 9EEA C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 577+ 9EEB
 578+ 9EEB 04               inc b
 579+ 9EEC 05               dec b
 580+ 9EED 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
 581+ 9EEF
 582+ 9EEF              Loop_2:
 583+ 9EEF
 584+ 9EEF              ;   %xxxabccc
 585+ 9EEF
 586+ 9EEF              ;   %a ... Salida SPEAKER.
 587+ 9EEF              ;   %b ... MIC/EAR.
 588+ 9EEF              ;   %c ... BORDER Colour.
 589+ 9EEF
 590+ 9EEF
 591+ 9EEF 3E 10            ld a,%00010000          ; Borde negro.
 592+ 9EF1 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 593+ 9EF3
 594+ 9EF3              Delay_5:
 595+ 9EF3
 596+ 9EF3 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 597+ 9EF4
 598+ 9EF4 7C               ld a,h
 599+ 9EF5 B5               or l
 600+ 9EF6 20 FB            jr nz,Delay_5
 601+ 9EF8
 602+ 9EF8 2A 84 94         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 603+ 9EFB
 604+ 9EFB AF               xor a                   ; Borde negro.    ---     4 tstates
 605+ 9EFC D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 606+ 9EFE
 607+ 9EFE              Delay_6:
 608+ 9EFE
 609+ 9EFE 2B               dec hl
 610+ 9EFF
 611+ 9EFF 7C               ld a,h
 612+ 9F00 B5               or l
 613+ 9F01 20 FB            jr nz,Delay_6
 614+ 9F03
 615+ 9F03              ; Hemos generado una onda sonora.
 616+ 9F03              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 617+ 9F03
 618+ 9F03 2A 84 94         ld hl,(Sound)
 619+ 9F06
 620+ 9F06 1C               inc e
 621+ 9F07 1D               dec e
 622+ 9F08 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 623+ 9F0A              ;                           ; (E)="0" indica que no hay variación en el tono.
 624+ 9F0A
 625+ 9F0A 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 626+ 9F0B 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 627+ 9F0C
 628+ 9F0C              ; Rayo de entrada o de salida ???
 629+ 9F0C
 630+ 9F0C A7               and a
 631+ 9F0D 20 05            jr nz,Incrementa_delay
 632+ 9F0F
 633+ 9F0F              Decrementa_delay:
 634+ 9F0F
 635+ 9F0F 2B               dec hl
 636+ 9F10 10 FD            djnz Decrementa_delay
 637+ 9F12
 638+ 9F12 18 03            jr 1F
 639+ 9F14
