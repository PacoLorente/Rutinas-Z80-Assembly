   3+ 944F              ;   21/04/24
   4+ 944F              ;
   5+ 944F              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 944F              ;   (XOR) bit a bit.
   7+ 944F              ;
   8+ 944F              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 944F
  10+ 944F              Derivando_RND
  11+ 944F
  12+ 944F 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9452
  14+ 9452 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9454 C5               push bc
  16+ 9455              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9455 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9458              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9458
  20+ 9458 A7           6 and a                                 ; Carry a "0".
  21+ 9459 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 945B 30 02            jr nc,1F
  23+ 945D
  24+ 945D CB C1            set 0,c
  25+ 945F
  26+ 945F 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9460 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9462 5F               ld e,a
  29+ 9463
  30+ 9463 7A               ld a,d
  31+ 9464 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9466 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9468
  34+ 9468 CB 3F            srl a
  35+ 946A
  36+ 946A AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 946B
  38+ 946B 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 946C 28 04            jr z,4F
  40+ 946E
  41+ 946E CB FF            set 7,a
  42+ 9470 18 02            jr 5F
  43+ 9472
  44+ 9472 CB BF        4 res 7,a
  45+ 9474
  46+ 9474 CB 21        5 sla c
  47+ 9476 10 E0            djnz 6B
  48+ 9478
  49+ 9478 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9479
  51+ 9479 77               ld (hl),a
  52+ 947A 23               inc hl
  53+ 947B C1               pop bc
  54+ 947C 10 D4            djnz 3B
