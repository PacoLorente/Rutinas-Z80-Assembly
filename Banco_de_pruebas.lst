 382+ A2AE C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A2AF
 384+ A2AF              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A2AF
 386+ A2AF 79           	ld a,c
