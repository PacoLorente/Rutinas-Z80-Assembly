 597+ B1BC              ;   PreviousScan.
 598+ B1BC              ;
 599+ B1BC              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 600+ B1BC              ;
 601+ B1BC              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ B1BC              ;
 603+ B1BC              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ B1BC              ;
 605+ B1BC              ;       DESTRUIDOS: AF y HL !!!
 606+ B1BC              ;
 607+ B1BC              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ B1BC              ;
 609+ B1BC
 610+ B1BC 7C           PreviousScan ld a,h
 611+ B1BD 25               dec h               							; Dec H.
 612+ B1BE E6 07            and 7
 613+ B1C0 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ B1C1
 615+ B1C1 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B1C2 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B1C4 6F               ld l,a
 618+ B1C5 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ B1C6
 620+ B1C6 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ B1C7 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ B1C9 67               ld h,a
 623+ B1CA C9               ret
