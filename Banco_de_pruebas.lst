  17+ A561              ;   04/11/22
  18+ A561              ;
  19+ A561              ;   Entrega una dirección de ATRIBUTOS de pantalla en HL a partir de una dirección de pantalla, dada en HL.
  20+ A561              ;
  21+ A561              ;   INPUT: HL contiene la dirección de memoria de pantalla.
  22+ A561              ;   OUTPUT: HL contiene la dirección de ATRIBUTOS de pantalla de la dirección que contenía HL.
  23+ A561              ;
  24+ A561              ;   DESTRUYE: HL y A. !!!!!
  25+ A561
  26+ A561 CD 57 A5     Calcula_direccion_atributos: call calcula_tercio
  27+ A564 26 58            ld h,$58
  28+ A566 84               add h
  29+ A567 67               ld h,a
  30+ A568 C9               ret
