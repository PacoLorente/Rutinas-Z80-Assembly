 576+ C3B4              ;
 577+ C3B4              ;   17/10/26
 578+ C3B4              ;
 579+ C3B4              ;   Asigna un nuevo KEYCODE y sustituye al contenido en la variable MOVE_xxx, (al que apunta H)L.
 580+ C3B4              ;   Nueva tecla para la función de movimiento, (KEYBOARD) a la que apunta HL.
 581+ C3B4              ;
 582+ C3B4              ;   Move_LEFT db $24
 583+ C3B4              ;   Move_RIGHT db $1c
 584+ C3B4              ;   Move_FIRE db $04
 585+ C3B4              ;   Move_SHIELD db $20
 586+ C3B4              ;
 587+ C3B4              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 588+ C3B4              ;
 589+ C3B4              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3B4              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3B4              ;
 592+ C3B4              ;   Special keys:
 593+ C3B4              ;
 594+ C3B4              ;   Symbol_key defm "SYMB.",0
 595+ C3B4              ;   Space_key defm "SPACE",0
 596+ C3B4              ;   Enter_key defm "ENTER",0
 597+ C3B4              ;   Caps_key defm "CAPS.",0
 598+ C3B4              ;
 599+ C3B4              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 600+ C3B4              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 601+ C3B4              ;
 602+ C3B4              ;           (Numero_de_teclas_definidas) contiene el n° de teclas YA DEFINIDAS.
 603+ C3B4              ;
 604+ C3B4              ;   MODIFY: AF, HL, BC y DE.
 605+ C3B4              ;
 606+ C3B4              ;   OUTPUT: (A) = "0".
