 781+ B5A6              ;	5/08/22
 782+ B5A6              ;
 783+ B5A6              ;   NextScan.
 784+ B5A6              ;
 785+ B5A6              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B5A6              ;
 787+ B5A6              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B5A6              ;
 789+ B5A6              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B5A6              ;
 791+ B5A6              ;       DESTRUIDOS: AF y HL !!!
 792+ B5A6              ;
 793+ B5A6              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B5A6              ;
 795+ B5A6
 796+ B5A6              NextScan:
 797+ B5A6
 798+ B5A6 24           	inc h          							; Incrementamos el scanline.
 799+ B5A7 7C               ld a,h
 800+ B5A8 E6 07            and 7
 801+ B5AA C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B5AB
 803+ B5AB 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B5AC C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B5AE 6F               ld l,a
 806+ B5AF D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B5B0
 808+ B5B0 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B5B1 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B5B3 67               ld h,a
 811+ B5B4 C9               ret
 812+ B5B5
 813+ B5B5              NextScan_15:
 814+ B5B5
 815+ B5B5 06 0F        	ld b,15
 816+ B5B7 CD A6 B5     1 call NextScan
 817+ B5BA 10 FB        	djnz 1B
 818+ B5BC
 819+ B5BC C9           	ret
 820+ B5BD
 821+ B5BD              ;----------------------------------------------------------------------------------------------------------------
 822+ B5BD              ;
 823+ B5BD              ;	5/08/22
 824+ B5BD              ;
 825+ B5BD              ;   PreviousScan.
 826+ B5BD              ;
 827+ B5BD              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B5BD              ;
 829+ B5BD              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B5BD              ;
 831+ B5BD              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B5BD              ;
 833+ B5BD              ;       DESTRUIDOS: AF y HL !!!
 834+ B5BD              ;
 835+ B5BD              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B5BD              ;
 837+ B5BD
 838+ B5BD              PreviousScan:
 839+ B5BD
 840+ B5BD 7C           	ld a,h
 841+ B5BE 25               dec h               							; Dec H.
 842+ B5BF E6 07            and 7
 843+ B5C1 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B5C2
 845+ B5C2 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B5C3 D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B5C5 6F               ld l,a
 848+ B5C6 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B5C7
 850+ B5C7 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B5C8 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B5CA 67               ld h,a
 853+ B5CB C9               ret
