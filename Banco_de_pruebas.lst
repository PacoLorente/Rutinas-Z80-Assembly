 480+ ABD5
 481+ ABD5 7D               ld a,l
 482+ ABD6 C6 05            add 5
 483+ ABD8 6F               ld l,a                                          ; Scanlines_album nunca tendrá cambio de byte alto.
 484+ ABD9
 485+ ABD9 F9               ld sp,hl
 486+ ABDA 22 D9 95         ld (Scanlines_album_SP),hl                      ; Actualiza (Scanlines_album_SP). Lo sitúa en el siguiente movimiento.
 487+ ABDD
 488+ ABDD 21 00 00         ld hl,0
 489+ ABE0 ED 7A            adc hl,sp                                       ; HL posicionado para ir generando líneas tras la CABECERA. Una manera de pasar el SP a HL.
 490+ ABE2
 491+ ABE2 DD E5            push ix                                         ; (Puntero_de_impresion) al álbum de líneas.
 492+ ABE4 C5               push bc                                         ; Nº de scanlines al álbum de líneas.
 493+ ABE5
 494+ ABE5 33               inc sp
 495+ ABE6
 496+ ABE6 D5               push de                                         ; (Puntero_objeto) al álbum de líneas.
