 538  93D1
 539  93D1              ;
 540  93D1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 541  93D1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 542  93D1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 543  93D1              ;
 544  93D1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 545  93D1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 546  93D1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 547  93D1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 548  93D1              ;
 549  93D1              ;															;	"$ff" ..... Bucle infinito de repetición.
 550  93D1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 551  93D1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
