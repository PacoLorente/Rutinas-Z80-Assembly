 394+ C126 45               ld b,l
 395+ C127
 396+ C127 10 FE        Delay_3 djnz Delay_3
 397+ C129
 398+ C129 AF               xor a                   ; Borde negro.
 399+ C12A D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
