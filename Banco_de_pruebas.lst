  45+ 99CC              ; *******************************************************************************************************************************************************************************************
  46+ 99CC              ;	21/01/23
  47+ 99CC              ;
  48+ 99CC              ; 	Comprueba_limite_horizontal.
  49+ 99CC              ;
  50+ 99CC              ;	La rutina comprueba si hemos sobrepasado el (Limite_horizontal) definido en la rutina [Inicializacion]. Este será:_
  51+ 99CC              ;	_ $4fc0 si partimos de los cuadrantes 1 o 2 de pantalla o $4820 si partimos de los cuadrantes 3 o 4.
  52+ 99CC              ;
  53+ 99CC              ;	Si sobrepasamos o alcanzamos el límite horizontal establecido, la rutina cargará el registro E con un "1".
  54+ 99CC              ;	Si NO HEMOS SOBREPASADO (Limite_horizontal), E="0".
  55+ 99CC              ;	E="1" indica que HEMOS SOBREPASADO el (Limite_horizontal).
  56+ 99CC              ;	E="2" indica que NO HEMOS SOBREPASADO el (Limite_horizontal) pero hemos alcanzado o superado EL CENTRO DE PANTALLA.
  57+ 99CC
  58+ 99CC
  59+ 99CC
  60+ 99CC 3A F7 8B     Comprueba_limite_horizontal ld a,(Ctrl_0)          	; Si no hemos desaparecido por arriba o por abajo, saltamos a 1F para comprobar_
  61+ 99CF CB 57        	bit 2,a                                         ; _si hemos llegado o sobrepasado (Limite_horizontal). Seguimos con la rutina.
  62+ 99D1 28 07        	jr z,1F                                         ; Si por el contrario hemos desaparecido por arriba o por abajo, (bit2/bit3 de (Ctrl_0)="1"))_
  63+ 99D3 E6 FB        	and $fb 										; _hay que modificar el puntero de posición. (E="1" y salimos de la rutina). Antes inicializaremos los_
