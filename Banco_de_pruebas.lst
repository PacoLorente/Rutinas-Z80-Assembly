   2+ A0A6              ;
   3+ A0A6              ;   3/4/25
   4+ A0A6              ;
   5+ A0A6              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0A6              ;   (XOR) bit a bit.
   7+ A0A6              ;
   8+ A0A6              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0A6              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0A6
  11+ A0A6              Derivando_RND
  12+ A0A6
  13+ A0A6 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0A8 C5               push bc
  15+ A0A9              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0A9 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0AC              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0AC
  19+ A0AC A7           6 and a                                 ; Carry a "0".
  20+ A0AD CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0AF 30 02            jr nc,1F
  22+ A0B1
  23+ A0B1 CB C1            set 0,c
  24+ A0B3
  25+ A0B3 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0B4 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0B6 5F               ld e,a
  28+ A0B7
  29+ A0B7 7A               ld a,d
  30+ A0B8 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0BA 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0BC
  33+ A0BC CB 3F            srl a
  34+ A0BE
  35+ A0BE AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0BF
  37+ A0BF 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0C0 28 04            jr z,4F
  39+ A0C2
  40+ A0C2 CB FF            set 7,a
  41+ A0C4 18 02            jr 5F
  42+ A0C6
  43+ A0C6 CB BF        4 res 7,a
  44+ A0C8
  45+ A0C8 CB 21        5 sla c
  46+ A0CA 10 E0            djnz 6B
  47+ A0CC
  48+ A0CC 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0CD
  50+ A0CD 77               ld (hl),a
  51+ A0CE 23               inc hl
  52+ A0CF C1               pop bc
  53+ A0D0 10 D4            djnz 3B
  54+ A0D2
  55+ A0D2 C9               ret
  56+ A0D3
  57+ A0D3
  58+ A0D3
