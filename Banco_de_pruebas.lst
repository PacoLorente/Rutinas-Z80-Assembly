 612  9416              ;    		 1 ..... AZUL    jr $
 613  9416              ; 			 2 ..... ROJO
 614  9416              ;			 3 ..... MAGENTA
 615  9416              ; 			 4 ..... VERDE
 616  9416              ; 			 5 ..... CIAN
 617  9416              ;			 6 ..... AMARILLO
 618  9416              ; 			 7 ..... BLANCO
 619  9416
 620  9416
 621  9416 00 00        Indice_Sprite_der defw 0
 622  9418 00 00        Indice_Sprite_izq defw 0
 623  941A 00 00        Puntero_DESPLZ_der defw 0
