1639  98AD 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1640  98AE
1641  98AE 38 01        	jr c,1F
1642  98B0
1643  98B0              ;	Por encima o igual que (Max_time_to_appear_entities).
1644  98B0              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1645  98B0
1646  98B0 4E           	ld c,(hl)
1647  98B1
1648  98B1              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1649  98B1              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1650  98B1
1651  98B1 23           1 inc hl
1652  98B2 23           	inc hl
1653  98B3
1654  98B3 BE           	cp (hl)
1655  98B4
