   5+ 98EF              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 98EF              ;   (XOR) bit a bit.
   7+ 98EF              ;
   8+ 98EF              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 98EF              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 98EF
  11+ 98EF              Derivando_RND
  12+ 98EF
  13+ 98EF ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 98F1 C5               push bc
  15+ 98F2              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 98F2 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 98F5              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 98F5
  19+ 98F5 A7           6 and a                                 ; Carry a "0".
  20+ 98F6 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 98F8 30 02            jr nc,1F
  22+ 98FA
  23+ 98FA CB C1            set 0,c
  24+ 98FC
  25+ 98FC 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 98FD E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 98FF 5F               ld e,a
  28+ 9900
  29+ 9900 7A               ld a,d
  30+ 9901 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9903 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9905
  33+ 9905 CB 3F            srl a
  34+ 9907
  35+ 9907 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9908
  37+ 9908 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9909 28 04            jr z,4F
  39+ 990B
  40+ 990B CB FF            set 7,a
  41+ 990D 18 02            jr 5F
  42+ 990F
  43+ 990F CB BF        4 res 7,a
  44+ 9911
  45+ 9911 CB 21        5 sla c
  46+ 9913 10 E0            djnz 6B
  47+ 9915
  48+ 9915 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9916
  50+ 9916 77               ld (hl),a
  51+ 9917 23               inc hl
  52+ 9918 C1               pop bc
  53+ 9919 10 D4            djnz 3B
  54+ 991B
  55+ 991B C9               ret
