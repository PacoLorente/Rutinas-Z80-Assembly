   3+ 8A62              ;   07/07/23
   4+ 8A62              ;
   5+ 8A62              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8A62              ;
   7+ 8A62              ;   Codificación:
   8+ 8A62              ;
   9+ 8A62              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8A62              ;
  11+ 8A62              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8A62              ;
  13+ 8A62              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8A62              ;
  15+ 8A62              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8A62              ;
  17+ 8A62              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8A62              ;                               ..... %01000010 Vel_up 4
  19+ 8A62              ;                                               Vel_down 2
  20+ 8A62              ;                               ..... $42
  21+ 8A62              ;
  22+ 8A62              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8A62              ;
  24+ 8A62              ;                               ..... %01000010 Vel_left 4
  25+ 8A62              ;                                               Vel_right 2
  26+ 8A62              ;                               ..... $42
  27+ 8A62              ;
  28+ 8A62              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8A62              ;
  30+ 8A62              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8A62              ;
  32+ 8A62              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8A62              ;
  34+ 8A62              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8A62              ;                                     $53
  36+ 8A62              ;
  37+ 8A62              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8A62              ;
  39+ 8A62              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8A62              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8A62              ;
  42+ 8A62              ;                       Arriba ..... $81
  43+ 8A62              ;                       Arriba - izquierda ..... $a1
  44+ 8A62              ;                       Arriba - derecha ..... $91
  45+ 8A62              ;
  46+ 8A62              ;                       Abajo ..... $41
  47+ 8A62              ;                       Abajo - izquierda ..... $61
  48+ 8A62              ;                       Abajo - derecha ..... $51
  49+ 8A62              ;
  50+ 8A62              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8A62              ;
  52+ 8A62              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8A62              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8A62              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8A62              ;
  56+ 8A62              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8A62              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8A62              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8A62              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8A62              ;
  61+ 8A62              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8A62              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8A62              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8A62              ;
  65+ 8A62              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8A62              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8A62              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8A62              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8A62
