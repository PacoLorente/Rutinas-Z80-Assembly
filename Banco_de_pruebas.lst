   5+ 9E13              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9E13              ;   (XOR) bit a bit.
   7+ 9E13              ;
   8+ 9E13              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9E13              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9E13
  11+ 9E13              Derivando_RND
  12+ 9E13
  13+ 9E13 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9E15 C5               push bc
  15+ 9E16              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9E16 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9E19              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9E19
  19+ 9E19 A7           6 and a                                 ; Carry a "0".
  20+ 9E1A CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9E1C 30 02            jr nc,1F
  22+ 9E1E
  23+ 9E1E CB C1            set 0,c
  24+ 9E20
  25+ 9E20 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9E21 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9E23 5F               ld e,a
  28+ 9E24
  29+ 9E24 7A               ld a,d
  30+ 9E25 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9E27 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9E29
  33+ 9E29 CB 3F            srl a
  34+ 9E2B
  35+ 9E2B AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9E2C
  37+ 9E2C 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9E2D 28 04            jr z,4F
  39+ 9E2F
  40+ 9E2F CB FF            set 7,a
  41+ 9E31 18 02            jr 5F
