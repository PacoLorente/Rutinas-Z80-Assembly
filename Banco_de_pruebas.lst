 506  8E45 31 00 00     	ld sp,0																	; Situamos el inicio de Stack.
 507  8E48 3E FC        	ld a,$fc 																; IM2 ON. Vector de interrupciones a $fcff, (defw debajo de la pila).
 508  8E4A ED 47        	ld i,a 																	; Byte alto de la dirección donde se encuentra nuestro vector de interrupciones en el registro I. ($a9). El byte bajo será siempre $ff.
 509  8E4C ED 5E        	IM 2 											   							; Habilitamos el modo 2 de INTERRUPCIONES.
 510  8E4E F3           	DI
 511  8E4F
 512  8E4F              ; Limpiamos pantalla.
 513  8E4F
 514  8E4F 3E 07        	ld a,%00000111 													; Fondo NEGRO, tinta BLANCA.
