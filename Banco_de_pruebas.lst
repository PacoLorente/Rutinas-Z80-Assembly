 393+ C144
 394+ C144 45               ld b,l
 395+ C145
 396+ C145 10 FE        Delay_3 djnz Delay_3
 397+ C147
 398+ C147 AF               xor a                   ; Borde negro.
 399+ C148 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C14A
 401+ C14A 45               ld b,l
 402+ C14B
 403+ C14B 10 FE        Delay_4 djnz Delay_4
