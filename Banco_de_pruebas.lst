   1+ 94A8              ; ******************************************************************************************************************************************************************************************
   2+ 94A8              ;
   3+ 94A8              ;   3/4/25
   4+ 94A8              ;
   5+ 94A8              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 94A8              ;   (XOR) bit a bit.
   7+ 94A8              ;
   8+ 94A8              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 94A8              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 94A8
  11+ 94A8              Derivando_RND
  12+ 94A8
  13+ 94A8 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94AA C5               push bc
  15+ 94AB              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94AB 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94AE              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94AE
  19+ 94AE A7           6 and a                                 ; Carry a "0".
  20+ 94AF CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94B1 30 02            jr nc,1F
  22+ 94B3
