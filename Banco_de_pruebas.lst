   1+ 9AC7              ; ******************************************************************************************************************************************************************************************
   2+ 9AC7              ;
   3+ 9AC7              ;   3/4/25
   4+ 9AC7              ;
   5+ 9AC7              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9AC7              ;   (XOR) bit a bit.
   7+ 9AC7              ;
   8+ 9AC7              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9AC7              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9AC7
  11+ 9AC7              Derivando_RND
  12+ 9AC7
  13+ 9AC7 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9AC9 C5               push bc
  15+ 9ACA              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9ACA 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9ACD              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9ACD
  19+ 9ACD A7           6 and a                                 ; Carry a "0".
  20+ 9ACE CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9AD0 30 02            jr nc,1F
  22+ 9AD2
  23+ 9AD2 CB C1            set 0,c
  24+ 9AD4
  25+ 9AD4 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9AD5 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9AD7 5F               ld e,a
  28+ 9AD8
  29+ 9AD8 7A               ld a,d
  30+ 9AD9 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9ADB 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9ADD
  33+ 9ADD CB 3F            srl a
  34+ 9ADF
  35+ 9ADF AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9AE0
  37+ 9AE0 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9AE1 28 04            jr z,4F
  39+ 9AE3
  40+ 9AE3 CB FF            set 7,a
  41+ 9AE5 18 02            jr 5F
  42+ 9AE7
  43+ 9AE7 CB BF        4 res 7,a
  44+ 9AE9
  45+ 9AE9 CB 21        5 sla c
  46+ 9AEB 10 E0            djnz 6B
  47+ 9AED
  48+ 9AED 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
