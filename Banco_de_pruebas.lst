 624+ B219
 625+ B219 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 626+ B21A D6 20            sub $20             							; Vamos a comprobarlo...
 627+ B21C 6F               ld l,a
 628+ B21D D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
