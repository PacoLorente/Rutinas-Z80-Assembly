 590+ B4A2
 591+ B4A2 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B4A3 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B4A5 6F               ld l,a
 594+ B4A6 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B4A7
 596+ B4A7 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B4A8 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B4AA 67               ld h,a
 599+ B4AB C9               ret
