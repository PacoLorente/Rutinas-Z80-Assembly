  20+ A67B              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A67B
  22+ A67B
  23+ A67B 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A67E 11 01 40     	LD DE,$4001
