 755+ C465              ; --------------------------------------------------
 756+ C465              ;
 757+ C465              ;   18/10/26
 758+ C465              ;
 759+ C465              ;   Sub.: Almacena los 5 códigos ASCII que construyen la palabra de la SPECIAL KEY.:
 760+ C465              ;
 761+ C465              ;   Symbol_key defm "SYMB.",0
 762+ C465              ;   Space_key defm "SPACE",0
 763+ C465              ;   Enter_key defm "ENTER",0
 764+ C465              ;   Caps_key defm "CAPS.",0
