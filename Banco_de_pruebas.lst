 651+ 9F5F              ;
 652+ 9F5F              ;   17/9/26
 653+ 9F5F              ;
 654+ 9F5F              ;   Herramienta para construir melodías y ruido con el SPEAKER.
 655+ 9F5F
 656+ 9F5F              Sound_Generator:
 657+ 9F5F
 658+ 9F5F              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 659+ 9F5F              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 660+ 9F5F              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 661+ 9F5F              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 662+ 9F5F              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 663+ 9F5F              ;
 664+ 9F5F
 665+ 9F5F              ;   MODIFY: A,HL,BC y DE.
 666+ 9F5F
 667+ 9F5F              ;   Exclusión:
 668+ 9F5F
 669+ 9F5F 2A 06 96         ld hl,(Sound)
 670+ 9F62 7C               ld a,h
 671+ 9F63 B5               or l
 672+ 9F64 C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 673+ 9F65
 674+ 9F65 04               inc b
 675+ 9F66 05               dec b
 676+ 9F67 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
 677+ 9F69
 678+ 9F69              Loop_2:
 679+ 9F69
 680+ 9F69              ;   %xxxabccc
 681+ 9F69
 682+ 9F69              ;   %a ... Salida SPEAKER.
 683+ 9F69              ;   %b ... MIC/EAR.
 684+ 9F69              ;   %c ... BORDER Colour.
 685+ 9F69
 686+ 9F69
 687+ 9F69 3E 10            ld a,%00010000          ; Borde negro.
 688+ 9F6B D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 689+ 9F6D
 690+ 9F6D              Delay_5:
 691+ 9F6D
 692+ 9F6D 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 693+ 9F6E
 694+ 9F6E 7C               ld a,h
 695+ 9F6F B5               or l
 696+ 9F70 20 FB            jr nz,Delay_5
 697+ 9F72
 698+ 9F72 2A 06 96         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 699+ 9F75
 700+ 9F75 AF               xor a                   ; Borde negro.    ---     4 tstates
 701+ 9F76 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 702+ 9F78
 703+ 9F78              Delay_6:
 704+ 9F78
 705+ 9F78 2B               dec hl
 706+ 9F79
 707+ 9F79 7C               ld a,h
 708+ 9F7A B5               or l
 709+ 9F7B 20 FB            jr nz,Delay_6
 710+ 9F7D
 711+ 9F7D              ; Hemos generado una onda sonora.
 712+ 9F7D              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 713+ 9F7D
 714+ 9F7D 2A 06 96         ld hl,(Sound)
 715+ 9F80
 716+ 9F80 1C               inc e
 717+ 9F81 1D               dec e
 718+ 9F82 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 719+ 9F84              ;                           ; (E)="0" indica que no hay variación en el tono.
 720+ 9F84
 721+ 9F84 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 722+ 9F85 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 723+ 9F86
 724+ 9F86              ; Rayo de entrada o de salida ???
 725+ 9F86
 726+ 9F86 A7               and a
 727+ 9F87 20 05            jr nz,Incrementa_delay
 728+ 9F89
 729+ 9F89              Decrementa_delay:
 730+ 9F89
 731+ 9F89 2B               dec hl
 732+ 9F8A 10 FD            djnz Decrementa_delay
 733+ 9F8C
 734+ 9F8C 18 03            jr 1F
 735+ 9F8E
 736+ 9F8E              Incrementa_delay:
 737+ 9F8E
 738+ 9F8E 23               inc hl
 739+ 9F8F 10 FD            djnz Incrementa_delay
 740+ 9F91
 741+ 9F91              ; Descontamos la onda generada del total de ondas que tiene el efecto, (Sound).
 742+ 9F91
 743+ 9F91 0D           1 dec c                     ; Decrementa nº de ondas.
 744+ 9F92
 745+ 9F92 22 06 96         ld (Sound),hl
 746+ 9F95
 747+ 9F95 20 D2            jr nz,Loop_2
 748+ 9F97
 749+ 9F97 C9               ret
