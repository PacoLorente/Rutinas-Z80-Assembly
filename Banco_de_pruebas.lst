# file opened: RND_Derivando.asm
   1+ 9466              ; ******************************************************************************************************************************************************************************************
   2+ 9466              ;
   3+ 9466              ;   21/04/24
   4+ 9466              ;
   5+ 9466              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9466              ;   (XOR) bit a bit.
   7+ 9466              ;
   8+ 9466              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9466
  10+ 9466              Derivando_RND
  11+ 9466
  12+ 9466 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9469
  14+ 9469 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 946B C5               push bc
  16+ 946C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 946C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 946F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
