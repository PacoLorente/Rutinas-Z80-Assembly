   3+ 9E8D              ;   6/11/26
   4+ 9E8D              ;
   5+ 9E8D              ;   Construyo un nº pseudo aleatorio. Método "DERIVANDO":
   6+ 9E8D              ;
   7+ 9E8D              ;   Inicialmente nuestra semilla será la contenida en el registro R. A partir de ahí irá mutando y la almacenaremos en la variable: (Semilla).
   8+ 9E8D              ;
   9+ 9E8D              ;   Para construir nuestro n° pseudo aleatorio necesitamos 8 bits que iremos adquiriendo del último bit, (bit_0) de la semilla.
  10+ 9E8D              ;
  11+ 9E8D              ;   Después de adquirir el bit de la semilla, desplazamos a la derecha los bits de la misma y realizamos una función lógica XOR entre los_
  12+ 9E8D              ;   _ bits 0 y 1, (los dos últimos).
  13+ 9E8D              ;
  14+ 9E8D              ;   Si el resultado de la operación XOR es "1" pondremos a "1" el bit_7 de la semilla. Si es "0" no realizamos cambios.
  15+ 9E8D              ;
  16+ 9E8D              ;   Desplazamos los bits del número que estamos generando una posición a la izquierda con el fin de adquirir un nuevo bit de la semilla.
  17+ 9E8D              ;
  18+ 9E8D              ;   Repetimos proceso hasta que hayamos adquirido los 8 bits necesarios de la semilla.
  19+ 9E8D              ;
  20+ 9E8D              ;   Guardamos la semilla en la variable (Semilla) y el número generado en (HL).
  21+ 9E8D              ;
  22+ 9E8D              ;   Incrementamos el puntero HL para situarlo en la siguiente dirección de memoria, (donde almacenaremos el siguiente n° pseudo aleatorio a generar).
  23+ 9E8D              ;
  24+ 9E8D              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
  25+ 9E8D              ;          HL contendrá la dirección de mem. donde vamos a almacenar el 1er n° de los (B) números pseudo aleatorios a generar.
  26+ 9E8D              ;
  27+ 9E8D              ;   MODIFY: (Semilla), AF, HL, DE y B.
  28+ 9E8D
  29+ 9E8D              Derivando_RND:
  30+ 9E8D
  31+ 9E8D              ;   En 1er lugar comprobamos si disponemos de semilla.
  32+ 9E8D
  33+ 9E8D 3A D9 96         ld a,(Semilla)
  34+ 9E90
  35+ 9E90 A7               and a
  36+ 9E91
  37+ 9E91 20 02            jr nz,Semilla_iniciada
  38+ 9E93
  39+ 9E93              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  40+ 9E93 ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  41+ 9E95
  42+ 9E95              Semilla_iniciada:
  43+ 9E95
  44+ 9E95 57               ld d,a                              ; A partir de ahora, (D) contendrá nuestra semilla.
  45+ 9E96
  46+ 9E96 C5               push bc                             ; PUSH N° de números que queremos generar.
  47+ 9E97
  48+ 9E97 01 00 08         ld bc,$0800                         ; C contendrá nuestro nº aleatorio: ($0 - $ff). Inicialmente está a "0".
  49+ 9E9A              ;                                       ; B actuará como contador de bits, (números de bits a generar), 8 bits.
  50+ 9E9A
  51+ 9E9A CB 21        3 sla c                                 ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  52+ 9E9C
  53+ 9E9C 7A               ld a,d
  54+ 9E9D
  55+ 9E9D              ;   El último bit de la semilla, (bit_0) será el 1° del número pseudo aleatorio generado, (bit_7).
  56+ 9E9D
  57+ 9E9D E6 01            and %00000001
  58+ 9E9F
  59+ 9E9F 28 02            jr z,4F
  60+ 9EA1
  61+ 9EA1 CB C1            set 0,c                             ; One bit generated.
  62+ 9EA3
  63+ 9EA3              ;   Rotamos los bits de la semilla una posición a la derecha.
  64+ 9EA3
  65+ 9EA3 CB 1A        4  rr d                                 ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  66+ 9EA5
  67+ 9EA5 7A               ld a,d
  68+ 9EA6
  69+ 9EA6              Xor_bit_1_bit_2:
  70+ 9EA6
  71+ 9EA6 E6 01            and %00000001                       ; Bit_0 en (E).
  72+ 9EA8 5F               ld e,a
  73+ 9EA9
  74+ 9EA9 7A               ld a,d
  75+ 9EAA E6 02            and %00000010                       ; Bit_1 en (A).
  76+ 9EAC
  77+ 9EAC 28 02            jr z,1F
  78+ 9EAE
  79+ 9EAE 3E 01            ld a,1
  80+ 9EB0
  81+ 9EB0 AB           1 xor e
  82+ 9EB1
  83+ 9EB1              ;   FUNCIÓN XOR entre el bit_0 y el bit_1 de la semilla después de una rotación de 1 bit a la derecha.
  84+ 9EB1
  85+ 9EB1              ;   0 0 ..... 0
  86+ 9EB1              ;   0 1 ..... 1
  87+ 9EB1              ;   1 0 ..... 1
  88+ 9EB1              ;   1 1 ..... 0
  89+ 9EB1
  90+ 9EB1 28 02            jr z,2F
  91+ 9EB3
  92+ 9EB3 CB FA            set 7,d                             ; Cuando la función XOR entre los dos últimos bits de la semilla resulta "1",_
  93+ 9EB5              ;                                       ; _ seteamos a "1" el bit_7 de la misma.
  94+ 9EB5
  95+ 9EB5 10 E3        2 djnz 3B
  96+ 9EB7
  97+ 9EB7              Number_generated:
  98+ 9EB7
  99+ 9EB7 7A               ld a,d
 100+ 9EB8
 101+ 9EB8 32 D9 96         ld (Semilla),a                      ; Guarda la evolución de la semilla para seguir generando números.
 102+ 9EBB
 103+ 9EBB 71               ld (hl),c                           ; Guardamos el número pseudo aleatorio generado en su correspondiente dirección de memoria.
 104+ 9EBC
 105+ 9EBC 23               inc hl                              ; HL apunta a la dirección de memoria donde vamos a guardar el siguiente número a generar.
