 260  93E5 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 261  93E6              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 262  93E6              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 263  93E6              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 264  93E6
 265  93E6 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 266  93E7              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 267  93E7
 268  93E7 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 269  93E8              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 270  93E8              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 271  93E8
 272  93E8              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 273  93E8              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 274  93E8
 275  93E8              ; Ejemplos:
 276  93E8
 277  93E8              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 278  93E8              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 279  93E8              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 280  93E8              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 281  93E8              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 282  93E8
 283  93E8 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 284  93E9              ;															  _ que esta entidad haya colisionado con Amadeus.
 285  93E9              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 286  93E9
