   4+ 9C2E              ;
   5+ 9C2E              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9C2E              ;   (XOR) bit a bit.
   7+ 9C2E              ;
   8+ 9C2E              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9C2E              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9C2E
  11+ 9C2E              Derivando_RND
  12+ 9C2E
  13+ 9C2E ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9C30 C5               push bc
  15+ 9C31              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9C31 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9C34              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9C34
  19+ 9C34 A7           6 and a                                 ; Carry a "0".
  20+ 9C35 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9C37 30 02            jr nc,1F
  22+ 9C39
  23+ 9C39 CB C1            set 0,c
  24+ 9C3B
  25+ 9C3B 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9C3C E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9C3E 5F               ld e,a
  28+ 9C3F
  29+ 9C3F 7A               ld a,d
  30+ 9C40 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9C42 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9C44
  33+ 9C44 CB 3F            srl a
  34+ 9C46
  35+ 9C46 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9C47
  37+ 9C47 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9C48 28 04            jr z,4F
  39+ 9C4A
  40+ 9C4A CB FF            set 7,a
  41+ 9C4C 18 02            jr 5F
  42+ 9C4E
  43+ 9C4E CB BF        4 res 7,a
  44+ 9C50
  45+ 9C50 CB 21        5 sla c
  46+ 9C52 10 E0            djnz 6B
  47+ 9C54
  48+ 9C54 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C55
  50+ 9C55 77               ld (hl),a
  51+ 9C56 23               inc hl
  52+ 9C57 C1               pop bc
  53+ 9C58 10 D4            djnz 3B
  54+ 9C5A
  55+ 9C5A C9               ret
  56+ 9C5B
  57+ 9C5B
  58+ 9C5B
