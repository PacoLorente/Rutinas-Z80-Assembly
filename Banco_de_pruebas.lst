   5+ 9D60              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D60              ;   (XOR) bit a bit.
   7+ 9D60              ;
   8+ 9D60              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D60              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D60
  11+ 9D60              Derivando_RND
  12+ 9D60
  13+ 9D60 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D62 C5               push bc
  15+ 9D63              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D63 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D66              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D66
  19+ 9D66 A7           6 and a                                 ; Carry a "0".
  20+ 9D67 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D69 30 02            jr nc,1F
  22+ 9D6B
  23+ 9D6B CB C1            set 0,c
  24+ 9D6D
  25+ 9D6D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D6E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D70 5F               ld e,a
  28+ 9D71
  29+ 9D71 7A               ld a,d
  30+ 9D72 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D74 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D76
  33+ 9D76 CB 3F            srl a
  34+ 9D78
  35+ 9D78 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D79
  37+ 9D79 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D7A 28 04            jr z,4F
  39+ 9D7C
  40+ 9D7C CB FF            set 7,a
  41+ 9D7E 18 02            jr 5F
  42+ 9D80
  43+ 9D80 CB BF        4 res 7,a
  44+ 9D82
  45+ 9D82 CB 21        5 sla c
  46+ 9D84 10 E0            djnz 6B
  47+ 9D86
  48+ 9D86 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D87
  50+ 9D87 77               ld (hl),a
  51+ 9D88 23               inc hl
  52+ 9D89 C1               pop bc
  53+ 9D8A 10 D4            djnz 3B
  54+ 9D8C
  55+ 9D8C C9               ret
