   5+ 99E8              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99E8              ;   (XOR) bit a bit.
   7+ 99E8              ;
   8+ 99E8              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99E8              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99E8
  11+ 99E8              Derivando_RND
  12+ 99E8
  13+ 99E8 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99EA C5               push bc
  15+ 99EB              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99EB 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99EE              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99EE
  19+ 99EE A7           6 and a                                 ; Carry a "0".
  20+ 99EF CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99F1 30 02            jr nc,1F
  22+ 99F3
  23+ 99F3 CB C1            set 0,c
  24+ 99F5
  25+ 99F5 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99F6 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99F8 5F               ld e,a
  28+ 99F9
  29+ 99F9 7A               ld a,d
  30+ 99FA E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99FC 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99FE
  33+ 99FE CB 3F            srl a
  34+ 9A00
  35+ 9A00 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9A01
  37+ 9A01 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9A02 28 04            jr z,4F
  39+ 9A04
  40+ 9A04 CB FF            set 7,a
  41+ 9A06 18 02            jr 5F
  42+ 9A08
  43+ 9A08 CB BF        4 res 7,a
  44+ 9A0A
  45+ 9A0A CB 21        5 sla c
  46+ 9A0C 10 E0            djnz 6B
  47+ 9A0E
  48+ 9A0E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9A0F
  50+ 9A0F 77               ld (hl),a
  51+ 9A10 23               inc hl
  52+ 9A11 C1               pop bc
  53+ 9A12 10 D4            djnz 3B
  54+ 9A14
  55+ 9A14 C9               ret
  56+ 9A15
  57+ 9A15
  58+ 9A15
