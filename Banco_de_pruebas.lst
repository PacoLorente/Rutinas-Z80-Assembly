 428  944B 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 429  944C 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 430  944D 00           Cola_de_desplazamiento db 0									; Este byte indica:
 431  944E
 432  944E              ;
 433  944E              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 434  944E              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 435  944E              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 436  944E              ;
 437  944E              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 438  944E              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 439  944E              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 440  944E              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 441  944E              ;
 442  944E              ;															;	"$ff" ..... Bucle infinito de repetición.
 443  944E              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 444  944E              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
