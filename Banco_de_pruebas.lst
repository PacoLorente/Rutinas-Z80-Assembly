1594  988B 38 01        	jr c,1F
1595  988D
1596  988D              ;	Por encima o igual que (Max_time_to_appear_entities).
1597  988D              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1598  988D
1599  988D 4E           	ld c,(hl)
1600  988E
1601  988E              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
