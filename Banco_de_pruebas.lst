 308  8CAF 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CB0 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CB1
 311  8CB1              ;
 312  8CB1              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CB1              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CB1              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CB1              ;
 316  8CB1              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CB1              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CB1              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CB1              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CB1              ;
 321  8CB1              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CB1              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CB1              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
