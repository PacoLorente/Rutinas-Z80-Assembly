 574+ B4BD              ;
 575+ B4BD              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 576+ B4BD              ;
 577+ B4BD              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 578+ B4BD              ;
 579+ B4BD              ;       DESTRUIDOS: AF y HL !!!
 580+ B4BD              ;
 581+ B4BD              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 582+ B4BD              ;
 583+ B4BD
 584+ B4BD              NextScan:
 585+ B4BD
 586+ B4BD 24           	inc h          							; Incrementamos el scanline.
 587+ B4BE 7C               ld a,h
 588+ B4BF E6 07            and 7
 589+ B4C1 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 590+ B4C2
 591+ B4C2 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B4C3 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B4C5 6F               ld l,a
 594+ B4C6 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B4C7
 596+ B4C7 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B4C8 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B4CA 67               ld h,a
 599+ B4CB C9               ret
