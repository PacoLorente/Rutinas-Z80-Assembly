 571+ B201              ;   NextScan.
 572+ B201              ;
 573+ B201              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 574+ B201              ;
 575+ B201              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 576+ B201              ;
 577+ B201              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 578+ B201              ;
 579+ B201              ;       DESTRUIDOS: AF y HL !!!
 580+ B201              ;
 581+ B201              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 582+ B201              ;
 583+ B201
 584+ B201              NextScan:
 585+ B201
 586+ B201 24           	inc h          							; Incrementamos el scanline.
 587+ B202 7C               ld a,h
 588+ B203 E6 07            and 7
 589+ B205 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 590+ B206
 591+ B206 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B207 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B209 6F               ld l,a
 594+ B20A D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B20B
 596+ B20B 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B20C D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B20E 67               ld h,a
 599+ B20F C9               ret
