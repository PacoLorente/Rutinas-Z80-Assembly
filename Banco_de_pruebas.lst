 590+ B20A
 591+ B20A 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B20B C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B20D 6F               ld l,a
 594+ B20E D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B20F
 596+ B20F 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B210 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B212 67               ld h,a
 599+ B213 C9               ret
