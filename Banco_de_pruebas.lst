   5+ 9BF1              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9BF1              ;   (XOR) bit a bit.
   7+ 9BF1              ;
   8+ 9BF1              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9BF1              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9BF1
  11+ 9BF1              Derivando_RND
  12+ 9BF1
  13+ 9BF1 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9BF3 C5               push bc
  15+ 9BF4              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9BF4 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9BF7              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9BF7
  19+ 9BF7 A7           6 and a                                 ; Carry a "0".
  20+ 9BF8 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9BFA 30 02            jr nc,1F
  22+ 9BFC
  23+ 9BFC CB C1            set 0,c
  24+ 9BFE
  25+ 9BFE 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9BFF E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9C01 5F               ld e,a
  28+ 9C02
  29+ 9C02 7A               ld a,d
  30+ 9C03 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9C05 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9C07
  33+ 9C07 CB 3F            srl a
  34+ 9C09
  35+ 9C09 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9C0A
  37+ 9C0A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9C0B 28 04            jr z,4F
  39+ 9C0D
  40+ 9C0D CB FF            set 7,a
  41+ 9C0F 18 02            jr 5F
  42+ 9C11
  43+ 9C11 CB BF        4 res 7,a
  44+ 9C13
  45+ 9C13 CB 21        5 sla c
  46+ 9C15 10 E0            djnz 6B
  47+ 9C17
  48+ 9C17 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C18
  50+ 9C18 77               ld (hl),a
  51+ 9C19 23               inc hl
  52+ 9C1A C1               pop bc
  53+ 9C1B 10 D4            djnz 3B
  54+ 9C1D
  55+ 9C1D C9               ret
