 592+ B4E7 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B4E9 6F               ld l,a
 594+ B4EA D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B4EB
 596+ B4EB 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B4EC D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B4EE 67               ld h,a
 599+ B4EF C9               ret
