 308  8CBF 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CC0 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CC1
 311  8CC1              ;
 312  8CC1              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CC1              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CC1              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CC1              ;
 316  8CC1              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CC1              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CC1              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CC1              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CC1              ;
 321  8CC1              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CC1              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CC1              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8CC1
