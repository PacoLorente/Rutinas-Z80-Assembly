   5+ 99E4              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99E4              ;   (XOR) bit a bit.
   7+ 99E4              ;
   8+ 99E4              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99E4              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99E4
  11+ 99E4              Derivando_RND
  12+ 99E4
  13+ 99E4 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99E6 C5               push bc
  15+ 99E7              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99E7 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99EA              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99EA
  19+ 99EA A7           6 and a                                 ; Carry a "0".
  20+ 99EB CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99ED 30 02            jr nc,1F
  22+ 99EF
  23+ 99EF CB C1            set 0,c
  24+ 99F1
  25+ 99F1 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99F2 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99F4 5F               ld e,a
  28+ 99F5
  29+ 99F5 7A               ld a,d
  30+ 99F6 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99F8 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99FA
  33+ 99FA CB 3F            srl a
  34+ 99FC
  35+ 99FC AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99FD
  37+ 99FD 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99FE 28 04            jr z,4F
  39+ 9A00
  40+ 9A00 CB FF            set 7,a
  41+ 9A02 18 02            jr 5F
  42+ 9A04
  43+ 9A04 CB BF        4 res 7,a
  44+ 9A06
  45+ 9A06 CB 21        5 sla c
  46+ 9A08 10 E0            djnz 6B
  47+ 9A0A
  48+ 9A0A 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9A0B
  50+ 9A0B 77               ld (hl),a
  51+ 9A0C 23               inc hl
  52+ 9A0D C1               pop bc
  53+ 9A0E 10 D4            djnz 3B
  54+ 9A10
  55+ 9A10 C9               ret
