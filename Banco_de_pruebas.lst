3097  A054              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A054              ; ******************************************************************************************************************************************************************************************
   2+ A054              ;
   3+ A054              ;   3/4/25
   4+ A054              ;
   5+ A054              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A054              ;   (XOR) bit a bit.
   7+ A054              ;
   8+ A054              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A054              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A054
  11+ A054              Derivando_RND
  12+ A054
  13+ A054 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A056 C5               push bc
  15+ A057              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A057 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A05A              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A05A
  19+ A05A A7           6 and a                                 ; Carry a "0".
  20+ A05B CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A05D 30 02            jr nc,1F
  22+ A05F
  23+ A05F CB C1            set 0,c
  24+ A061
  25+ A061 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A062 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A064 5F               ld e,a
  28+ A065
  29+ A065 7A               ld a,d
  30+ A066 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A068 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A06A
  33+ A06A CB 3F            srl a
  34+ A06C
  35+ A06C AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A06D
  37+ A06D 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A06E 28 04            jr z,4F
  39+ A070
  40+ A070 CB FF            set 7,a
  41+ A072 18 02            jr 5F
  42+ A074
  43+ A074 CB BF        4 res 7,a
  44+ A076
  45+ A076 CB 21        5 sla c
  46+ A078 10 E0            djnz 6B
  47+ A07A
  48+ A07A 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A07B
  50+ A07B 77               ld (hl),a
  51+ A07C 23               inc hl
  52+ A07D C1               pop bc
  53+ A07E 10 D4            djnz 3B
  54+ A080
  55+ A080 C9               ret
  56+ A081
  57+ A081
  58+ A081
# file closed: RND_Derivando.asm
