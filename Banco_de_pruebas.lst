 123+ C028              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 124+ C028
 125+ C028              ;   Necesito fabricar un msg. con la máxima puntuación.
 126+ C028              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 127+ C028
 128+ C028 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 129+ C02B 21 B8 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
