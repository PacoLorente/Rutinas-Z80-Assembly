 523  94B0 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 524  94B2 00 00        Puntero_indice_mov_bucle defw 0
 525  94B4              ;
 526  94B4              ;
 527  94B4 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 528  94B5              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
