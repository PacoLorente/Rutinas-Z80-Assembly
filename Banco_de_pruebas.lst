   5+ 9D99              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D99              ;   (XOR) bit a bit.
   7+ 9D99              ;
   8+ 9D99              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D99              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D99
  11+ 9D99              Derivando_RND
  12+ 9D99
  13+ 9D99 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D9B C5               push bc
  15+ 9D9C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D9C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D9F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D9F
  19+ 9D9F A7           6 and a                                 ; Carry a "0".
  20+ 9DA0 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9DA2 30 02            jr nc,1F
  22+ 9DA4
  23+ 9DA4 CB C1            set 0,c
  24+ 9DA6
  25+ 9DA6 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9DA7 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9DA9 5F               ld e,a
  28+ 9DAA
  29+ 9DAA 7A               ld a,d
  30+ 9DAB E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9DAD 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9DAF
  33+ 9DAF CB 3F            srl a
  34+ 9DB1
  35+ 9DB1 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9DB2
  37+ 9DB2 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9DB3 28 04            jr z,4F
  39+ 9DB5
  40+ 9DB5 CB FF            set 7,a
  41+ 9DB7 18 02            jr 5F
  42+ 9DB9
  43+ 9DB9 CB BF        4 res 7,a
  44+ 9DBB
  45+ 9DBB CB 21        5 sla c
  46+ 9DBD 10 E0            djnz 6B
  47+ 9DBF
  48+ 9DBF 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
