 202  A435 00           Cola_de_desplazamiento db 0									; Este byte indica:
 203  A436
 204  A436              ;
 205  A436              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 206  A436              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 207  A436              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 208  A436              ;
 209  A436              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 210  A436              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 211  A436              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 212  A436              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 213  A436              ;
 214  A436              ;															;	"$ff" ..... Bucle infinito de repetición.
 215  A436              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 216  A436              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
