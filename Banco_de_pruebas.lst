 506+ 9EF3              Imprime_imagen:
 507+ 9EF3
 508+ 9EF3 3E 08            ld a,8
 509+ 9EF5 08               ex af,af                                                         ; (A´) contendrá el contador de scanlines que tiene un char.
 510+ 9EF6
 511+ 9EF6 E5           1 push hl
 512+ 9EF7 C5               push bc
 513+ 9EF8
 514+ 9EF8              ;   Generamos scanlines.
 515+ 9EF8
 516+ 9EF8              ;   La secuencia es la siguiente:
 517+ 9EF8              ;
 518+ 9EF8              ;   Byte (XOR) del 1er char. de la imagen.
 519+ 9EF8              ;   Byte (XOR) del 2º char. de la imagen.
 520+ 9EF8              ;   Byte (XOR) del 3er char. de la imagen., etc.
 521+ 9EF8
 522+ 9EF8              ;   Decrementa el contador de scanlines, (A´).
 523+ 9EF8
 524+ 9EF8              ;   Nos situamos en el siguiente scan, (call NextScan).
 525+ 9EF8
 526+ 9EF8              ;   Byte (XOR) del 1er char. de la imagen.
 527+ 9EF8              ;   Byte (XOR) del 2º char. de la imagen.
 528+ 9EF8              ;   Byte (XOR) del 3er char. de la imagen., etc.
 529+ 9EF8
 530+ 9EF8              ;   Decrementa el contador de scanlines, (A´).
 531+ 9EF8
 532+ 9EF8
 533+ 9EF8 1A           2 ld a,(de)
 534+ 9EF9 AE               xor (hl)
 535+ 9EFA 77               ld (hl),a
 536+ 9EFB
 537+ 9EFB 2C               inc l
 538+ 9EFC 13               inc de
 539+ 9EFD
 540+ 9EFD 10 F9            djnz 2B
