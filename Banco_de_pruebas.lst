 150  8C79 00           Clase db 0  											; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 151  8C7A              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 152  8C7A              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 153  8C7A              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 154  8C7A
 155  8C7A 00           Tipo db 0												; Cada `tipo´ de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 156  8C7B              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 157  8C7B 00           Coordenada_X db 0 							; Coordenada X del objeto. (En chars.)
 158  8C7C 00           Coordenada_y db 0 								; Coordenada Y del objeto. (En chars.)
 159  8C7D
 160  8C7D 00           Contador_de_vueltas db 0					; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición a la izquierda cada vez que la entidad_
 161  8C7E              ;															; _desaparece por la parte baja de la pantalla. Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 162  8C7E
 163  8C7E              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 164  8C7E              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 165  8C7E              ; Ejemplos.
 166  8C7E
 167  8C7E              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 168  8C7E              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 169  8C7E              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 170  8C7E              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 171  8C7E              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 172  8C7E
 173  8C7E 00           Impacto db 0											; Si después del movimiento de la entidad, (Impacto) se coloca a "1",_
 174  8C7F              ;																; _ existen muchas posibilidades de que esta entidad haya colisionado con Amadeus.
 175  8C7F              ; 																; Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 176  8C7F
 177  8C7F 00 00        Puntero_de_impresion defw 0					; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 178  8C81              ;																; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 179  8C81
 180  8C81 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 181  8C83
 182  8C83              ;																; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 183  8C83
 184  8C83 00 00        Contador_de_mov_masticados defw 0	; Contador de 16bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 185  8C85              ;																; _palabras que componen el "movimiento_masticado".
 186  8C85
 187  8C85              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 188  8C85
 189  8C85 00           Velocidad db 0 										; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 190  8C86              ;																					 2 - 0 (2ª vuelta - velocidad 0)
 191  8C86              ;																					 4 - 1 (3ª vuelta - velocidad 1)
 192  8C86              ;																					 8 - 2 (4ª vuelta - velocidad 2)
 193  8C86              ;																				 $10 - 4 (5ª vuelta - velocidad 3)
 194  8C86
 195  8C86 00           Attr db 0 													; Atributos de la entidad.
