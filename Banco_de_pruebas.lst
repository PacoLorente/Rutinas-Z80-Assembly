 400  94C3              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 401  94C3              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 402  94C3              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 403  94C3              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
