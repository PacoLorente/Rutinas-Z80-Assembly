   2+ 9415              ;
   3+ 9415              ;   21/04/24
   4+ 9415              ;
   5+ 9415              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9415              ;   (XOR) bit a bit.
   7+ 9415              ;
   8+ 9415              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9415
  10+ 9415              Derivando_RND
  11+ 9415
  12+ 9415 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9418
  14+ 9418 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 941A C5               push bc
  16+ 941B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 941B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 941E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 941E
  20+ 941E A7           6 and a                                 ; Carry a "0".
  21+ 941F CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9421 30 02            jr nc,1F
  23+ 9423
  24+ 9423 CB C1            set 0,c
  25+ 9425
  26+ 9425 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9426 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9428 5F               ld e,a
  29+ 9429
  30+ 9429 7A               ld a,d
  31+ 942A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 942C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 942E
  34+ 942E CB 3F            srl a
  35+ 9430
  36+ 9430 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9431
  38+ 9431 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9432 28 04            jr z,4F
  40+ 9434
  41+ 9434 CB FF            set 7,a
  42+ 9436 18 02            jr 5F
  43+ 9438
  44+ 9438 CB BF        4 res 7,a
  45+ 943A
  46+ 943A CB 21        5 sla c
  47+ 943C 10 E0            djnz 6B
  48+ 943E
  49+ 943E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 943F
  51+ 943F 77               ld (hl),a
  52+ 9440 23               inc hl
  53+ 9441 C1               pop bc
  54+ 9442 10 D4            djnz 3B
  55+ 9444
  56+ 9444 C9               ret
  57+ 9445
  58+ 9445
  59+ 9445
