 295  8E5F 00 00        Puntero_mov defw 0								; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 296  8E61 00 00        Puntero_indice_mov_bucle defw 0
 297  8E63              ;
 298  8E63              ;
 299  8E63 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8E64              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 301  8E64              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
