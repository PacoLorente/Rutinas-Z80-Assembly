 582+ C3B8              ;   Move_LEFT db $24
 583+ C3B8              ;   Move_RIGHT db $1c
 584+ C3B8              ;   Move_FIRE db $04
 585+ C3B8              ;   Move_SHIELD db $20
 586+ C3B8              ;
 587+ C3B8              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 588+ C3B8              ;
 589+ C3B8              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3B8              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3B8              ;
 592+ C3B8              ;   Special keys:
 593+ C3B8              ;
 594+ C3B8              ;   Symbol_key defm "SYMB.",0
 595+ C3B8              ;   Space_key defm "SPACE",0
 596+ C3B8              ;   Enter_key defm "ENTER",0
 597+ C3B8              ;   Caps_key defm "CAPS.",0
