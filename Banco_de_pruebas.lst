 544+ AEAA 01 02 02         ld bc,$0202                                         ; (BC) contiene (Columnas/Filas).
 545+ AEAD 3E 45            ld a,%01000101                                      ; Attrs.: BRIGHT, BLACK PAPER, CYAN INK.
