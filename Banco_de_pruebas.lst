 422  944B              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 423  944B
 424  944B 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 425  944C 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 426  944D 00           Cola_de_desplazamiento db 0									; Este byte indica:
 427  944E
 428  944E              ;
 429  944E              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 430  944E              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 431  944E              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 432  944E              ;
 433  944E              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 434  944E              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 435  944E              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 436  944E              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 437  944E              ;
 438  944E              ;															;	"$ff" ..... Bucle infinito de repetición.
 439  944E              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 440  944E              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
