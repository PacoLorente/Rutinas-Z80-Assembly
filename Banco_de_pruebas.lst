   5+ 9D45              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D45              ;   (XOR) bit a bit.
   7+ 9D45              ;
   8+ 9D45              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D45              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D45
  11+ 9D45              Derivando_RND
  12+ 9D45
  13+ 9D45 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D47 C5               push bc
  15+ 9D48              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D48 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D4B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D4B
  19+ 9D4B A7           6 and a                                 ; Carry a "0".
  20+ 9D4C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D4E 30 02            jr nc,1F
  22+ 9D50
  23+ 9D50 CB C1            set 0,c
  24+ 9D52
  25+ 9D52 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D53 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D55 5F               ld e,a
  28+ 9D56
  29+ 9D56 7A               ld a,d
  30+ 9D57 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D59 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D5B
  33+ 9D5B CB 3F            srl a
  34+ 9D5D
  35+ 9D5D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D5E
  37+ 9D5E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D5F 28 04            jr z,4F
  39+ 9D61
  40+ 9D61 CB FF            set 7,a
  41+ 9D63 18 02            jr 5F
  42+ 9D65
  43+ 9D65 CB BF        4 res 7,a
  44+ 9D67
  45+ 9D67 CB 21        5 sla c
  46+ 9D69 10 E0            djnz 6B
  47+ 9D6B
  48+ 9D6B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D6C
  50+ 9D6C 77               ld (hl),a
  51+ 9D6D 23               inc hl
  52+ 9D6E C1               pop bc
  53+ 9D6F 10 D4            djnz 3B
  54+ 9D71
  55+ 9D71 C9               ret
  56+ 9D72
  57+ 9D72
  58+ 9D72
