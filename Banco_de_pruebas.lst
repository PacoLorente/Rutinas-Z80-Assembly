 614+ B0B6
 615+ B0B6 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B0B7 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B0B9 6F               ld l,a
