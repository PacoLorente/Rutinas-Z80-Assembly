 582+ A30B
 583+ A30B 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A30C C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A30E 6F               ld l,a
 586+ A30F D8               ret c               							; Salimos si se produce el cambio de tercio.
