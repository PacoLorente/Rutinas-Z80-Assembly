 751  D315              ;
 752  D315              ; 	3/7/26
 753  D315              ;
 754  D315              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
 755  D315              ;
 756  D315              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
 757  D315              ;
 758  D315              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
 759  D315              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
 760  D315              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
 761  D315              ;
 762  D315              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
 763  D315              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
 764  D315              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
 765  D315              ;				  _medida que transcurre el tiempo.
 766  D315              ;
 767  D315              ;	OUTPUT: Define (Clock_next_entity).
 768  D315
 769  D315              Define_Clock_next_entity:
 770  D315
 771  D315 21 E1 A5     	ld hl,Max_time_to_appear_entities
 772  D318 BE           	cp (hl)
 773  D319
 774  D319 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
 775  D31A
 776  D31A 38 03        	jr c,1F
 777  D31C
 778  D31C              ;	Por encima o igual que (Max_time_to_appear_entities).
 779  D31C
 780  D31C 4E           	ld c,(hl)
 781  D31D 18 06        	jr 2F
 782  D31F
 783  D31F              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
 784  D31F              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
 785  D31F
 786  D31F 23           1 inc hl
 787  D320 23           	inc hl
 788  D321
 789  D321 BE           	cp (hl)
 790  D322
 791  D322 30 01        	jr nc,2F
 792  D324
 793  D324              ;	Por DEBAJO de (Min_time_to_appear_entities).
 794  D324
