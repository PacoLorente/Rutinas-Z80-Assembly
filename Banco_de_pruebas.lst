 350  939A              ;
 351  939A              ; 29/4/25
 352  939A              ;
 353  939A              ; Parámetros DRAW.
 354  939A              ;
 355  939A
 356  939A              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 357  939A
 358  939A 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 359  939B              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 360  939B              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 361  939B              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 362  939B
 363  939B 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 364  939C              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 365  939C 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 366  939D 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 367  939E
 368  939E 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 369  939F              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 370  939F              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 371  939F
 372  939F              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 373  939F              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 374  939F
 375  939F              ; Ejemplos:
 376  939F
 377  939F              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
