 431+ C1BC              ;   -------------------------------------------------------------------------------------------
 432+ C1BC              ;
 433+ C1BC              ;   23/9/26
 434+ C1BC              ;
 435+ C1BC              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C1BC              ;
 437+ C1BC              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C1BC              ;   _ [Sound_Generator].
 439+ C1BC              ;
 440+ C1BC              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C1BC              ;
 442+ C1BC              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C1BC              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C1BC              ;
 445+ C1BC              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C1BC              ;
 447+ C1BC              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C1BC              ;
 449+ C1BC              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C1BC
 451+ C1BC              Play_burst_sound_effect:
 452+ C1BC
 453+ C1BC              ;   Exclusiones:
 454+ C1BC
 455+ C1BC 3A AD 96         ld a,(Burst_sound)
 456+ C1BF A7               and a
 457+ C1C0 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C1C1
 459+ C1C1 08               ex af,af
 460+ C1C2
 461+ C1C2 3A 7E 96         ld a,(Ctrl_6)
 462+ C1C5 CB 47            bit 0,a
 463+ C1C7 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C1C8
 465+ C1C8              ;   ----------------------
 466+ C1C8
 467+ C1C8 CB C7            set 0,a
 468+ C1CA 32 7E 96         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C1CD
 470+ C1CD 08               ex af,af                ; Restore (Burst_sound).
 471+ C1CE
 472+ C1CE 67               ld h,a
 473+ C1CF 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1D1
 475+ C1D1 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1D2
 477+ C1D2 22 A7 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1D5 0E 03            ld c,3
 479+ C1D7 CD 1B A0         call Noise_efect
 480+ C1DA
 481+ C1DA D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1DB
 483+ C1DB 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1DC 94               sub h
 485+ C1DD
 486+ C1DD 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1DF
 488+ C1DF 7C               ld a,h
 489+ C1E0 32 AD 96         ld (Burst_sound),a
 490+ C1E3
 491+ C1E3 C9               ret
 492+ C1E4
 493+ C1E4              Clean_burst_efect:
 494+ C1E4
 495+ C1E4 AF               xor a
 496+ C1E5 32 AD 96         ld (Burst_sound),a
 497+ C1E8
 498+ C1E8 3A 7E 96         ld a,(Ctrl_6)
 499+ C1EB CB 87            res 0,a
 500+ C1ED 32 7E 96         ld (Ctrl_6),a
 501+ C1F0
 502+ C1F0 C9               ret
