 175+ C1C1              Make_Score_max_msg:
 176+ C1C1
 177+ C1C1              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 178+ C1C1
 179+ C1C1              ;   Necesito fabricar un msg. con la máxima puntuación.
 180+ C1C1              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 181+ C1C1
 182+ C1C1 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 183+ C1C4 21 7C 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 184+ C1C7              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
