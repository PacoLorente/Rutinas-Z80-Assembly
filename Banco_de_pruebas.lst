3153  A19A              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A19A              ; ******************************************************************************************************************************************************************************************
   2+ A19A              ;
   3+ A19A              ;   3/4/25
   4+ A19A              ;
   5+ A19A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A19A              ;   (XOR) bit a bit.
   7+ A19A              ;
   8+ A19A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A19A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A19A
  11+ A19A              Derivando_RND
  12+ A19A
  13+ A19A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A19C C5               push bc
  15+ A19D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A19D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A1A0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A1A0
  19+ A1A0 A7           6 and a                                 ; Carry a "0".
  20+ A1A1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A1A3 30 02            jr nc,1F
  22+ A1A5
  23+ A1A5 CB C1            set 0,c
  24+ A1A7
  25+ A1A7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A1A8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A1AA 5F               ld e,a
  28+ A1AB
  29+ A1AB 7A               ld a,d
  30+ A1AC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A1AE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A1B0
  33+ A1B0 CB 3F            srl a
  34+ A1B2
  35+ A1B2 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A1B3
  37+ A1B3 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A1B4 28 04            jr z,4F
  39+ A1B6
  40+ A1B6 CB FF            set 7,a
  41+ A1B8 18 02            jr 5F
  42+ A1BA
  43+ A1BA CB BF        4 res 7,a
  44+ A1BC
  45+ A1BC CB 21        5 sla c
  46+ A1BE 10 E0            djnz 6B
  47+ A1C0
  48+ A1C0 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A1C1
  50+ A1C1 77               ld (hl),a
  51+ A1C2 23               inc hl
  52+ A1C3 C1               pop bc
  53+ A1C4 10 D4            djnz 3B
  54+ A1C6
  55+ A1C6 C9               ret
  56+ A1C7
  57+ A1C7
  58+ A1C7
# file closed: RND_Derivando.asm
