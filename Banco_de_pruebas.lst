1487+ B11D              ;   COLISIÓN !!!!!.
1488+ B11D              ;
1489+ B11D              ;   .db (Impacto) de Amadeus a "1".
1490+ B11D              ;   SET el bit3 de (Impacto2).
1491+ B11D              ;
1492+ B11D              ;   Nota: El .db (Impacto) de la entidad implicada lo puso a "1" la rutina [Compara_coordenadas_X].
1493+ B11D
1494+ B11D E1           5 pop hl
1495+ B11E C1               pop bc
1496+ B11F
1497+ B11F 21 D7 8D         ld hl,Impacto_Amadeus
1498+ B122 36 01            ld (hl),1
1499+ B124 21 EF 91         ld hl,Impacto2                                 ; Cuando se produce Colisión, RES el bit2 de (Impacto2) y_
1500+ B127 CB 96            res 2,(hl)                                     ; _ SET el bit3. El bit3 de (Impacto2) indica que hay contacto_
1501+ B129
1502+ B129 11 90 8B         ld de,Indice_Explosion_entidades
1503+ B12C 2A F0 91         ld hl,(Entidad_sospechosa_de_colision)         ; Situamos el (Puntero_de_almacen_de_mov_masticados) de la entidad impactada en la primera palabra del índice de explosiones.
1504+ B12F
1505+ B12F 23               inc hl
1506+ B130 23               inc hl
1507+ B131 23               inc hl
1508+ B132
1509+ B132 73               ld (hl),e
1510+ B133 23               inc hl
1511+ B134 72               ld (hl),d
1512+ B135
1513+ B135              ; Situamos también el (Puntero_de_almacen_de_mov_masticados) de Amadeus en la primero explosión.
1514+ B135
1515+ B135 11 30 8C         ld de,Indice_Explosion_Amadeus
1516+ B138 21 DA 8D         ld hl,Pamm_Amadeus
1517+ B13B
1518+ B13B 73               ld (hl),e
1519+ B13C 23               inc hl
1520+ B13D 72               ld (hl),d
1521+ B13E
1522+ B13E C9               ret
1523+ B13F
1524+ B13F
1525+ B13F
1526+ B13F
