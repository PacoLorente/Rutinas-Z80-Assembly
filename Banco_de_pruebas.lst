   5+ 93D7              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93D7              ;   (XOR) bit a bit.
   7+ 93D7              ;
   8+ 93D7              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93D7
  10+ 93D7              Derivando_RND
  11+ 93D7
  12+ 93D7 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93DA
  14+ 93DA ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93DC C5               push bc
  16+ 93DD              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93DD 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 93E0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 93E0
  20+ 93E0 A7           6 and a                                 ; Carry a "0".
  21+ 93E1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 93E3 30 02            jr nc,1F
  23+ 93E5
  24+ 93E5 CB C1            set 0,c
  25+ 93E7
  26+ 93E7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 93E8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 93EA 5F               ld e,a
  29+ 93EB
  30+ 93EB 7A               ld a,d
  31+ 93EC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 93EE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 93F0
  34+ 93F0 CB 3F            srl a
  35+ 93F2
  36+ 93F2 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 93F3
  38+ 93F3 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 93F4 28 04            jr z,4F
  40+ 93F6
  41+ 93F6 CB FF            set 7,a
  42+ 93F8 18 02            jr 5F
  43+ 93FA
  44+ 93FA CB BF        4 res 7,a
  45+ 93FC
  46+ 93FC CB 21        5 sla c
  47+ 93FE 10 E0            djnz 6B
  48+ 9400
  49+ 9400 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9401
  51+ 9401 77               ld (hl),a
  52+ 9402 23               inc hl
  53+ 9403 C1               pop bc
  54+ 9404 10 D4            djnz 3B
  55+ 9406
  56+ 9406 C9               ret
