2884  A1C2              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A1C2              ; ******************************************************************************************************************************************************************************************
   2+ A1C2              ;
   3+ A1C2              ;   3/4/25
   4+ A1C2              ;
   5+ A1C2              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A1C2              ;   (XOR) bit a bit.
   7+ A1C2              ;
   8+ A1C2              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A1C2              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A1C2
  11+ A1C2              Derivando_RND
  12+ A1C2
  13+ A1C2 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A1C4 C5               push bc
  15+ A1C5              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A1C5 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A1C8              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A1C8
  19+ A1C8 A7           6 and a                                 ; Carry a "0".
  20+ A1C9 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A1CB 30 02            jr nc,1F
  22+ A1CD
  23+ A1CD CB C1            set 0,c
  24+ A1CF
  25+ A1CF 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A1D0 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A1D2 5F               ld e,a
  28+ A1D3
  29+ A1D3 7A               ld a,d
  30+ A1D4 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A1D6 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A1D8
  33+ A1D8 CB 3F            srl a
  34+ A1DA
  35+ A1DA AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A1DB
  37+ A1DB 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A1DC 28 04            jr z,4F
  39+ A1DE
  40+ A1DE CB FF            set 7,a
  41+ A1E0 18 02            jr 5F
  42+ A1E2
  43+ A1E2 CB BF        4 res 7,a
  44+ A1E4
  45+ A1E4 CB 21        5 sla c
  46+ A1E6 10 E0            djnz 6B
  47+ A1E8
  48+ A1E8 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A1E9
  50+ A1E9 77               ld (hl),a
  51+ A1EA 23               inc hl
  52+ A1EB C1               pop bc
  53+ A1EC 10 D4            djnz 3B
  54+ A1EE
  55+ A1EE C9               ret
  56+ A1EF
  57+ A1EF
  58+ A1EF
# file closed: RND_Derivando.asm
