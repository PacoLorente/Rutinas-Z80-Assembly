 171  9163              ; Parámetros DRAW.
 172  9163              ;
 173  9163
 174  9163              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 175  9163
 176  9163 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 177  9164              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 178  9164              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 179  9164              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 180  9164
 181  9164 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 182  9165              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 183  9165 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 184  9166 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 185  9167
 186  9167 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 187  9168              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 188  9168              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 189  9168
 190  9168              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 191  9168              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 192  9168
 193  9168              ; Ejemplos:
 194  9168
 195  9168              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 196  9168              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 197  9168              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 198  9168              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 199  9168              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 200  9168
 201  9168 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 202  9169              ;															  _ que esta entidad haya colisionado con Amadeus.
 203  9169              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 204  9169
 205  9169 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 206  916B              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 207  916B
 208  916B 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 209  916D
 210  916D              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 211  916D
 212  916D 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 213  916F              ;															  _palabras que componen el "movimiento_masticado".
 214  916F
 215  916F              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 216  916F
 217  916F 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 218  9170              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 219  9170              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 220  9170              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 221  9170              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 222  9170
 223  9170 00           Attr db 0 													; Atributos de la entidad.
 224  9171
 225  9171              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 226  9171
 227  9171
 228  9171
 229  9171 00           Ctrl_2 db 0
 230  9172              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 231  9172              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 232  9172              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 233  9172              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 234  9172              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 235  9172              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 236  9172              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 237  9172              ;
 238  9172              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 239  9172              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 240  9172              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 241  9172              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 242  9172              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 243  9172              ;															BIT 4, ???
 244  9172              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 245  9172              ;															BIT 6, "1" Indica que hemos iniciado la "-Transicion_de_salida-" de Amadeus.
 246  9172              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 247  9172              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 248  9172
 249  9172 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 250  9173              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 251  9173              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 252  9173              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 253  9173              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 254  9173              ;
 255  9173              ; 															DESCRIPCIÖN:
 256  9173              ;
 257  9173              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 258  9173              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 259  9173              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 260  9173              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 261  9173              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 262  9173              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 263  9173              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 264  9173              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 265  9173              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 266  9173              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 267  9173              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 268  9173              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 269  9173              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 270  9173              ;
 271  9173              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 272  9173              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 273  9173              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 274  9173
 275  9173 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 276  9174              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 277  9174              ;															; _rojo - amarillo.
 278  9174
 279  9174 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 280  9175              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 281  9175
