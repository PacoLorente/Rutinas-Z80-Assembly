 500+ A305
 501+ A305 3E 01        	ld a,1
 502+ A307
 503+ A307 21 24 94     	ld hl,Vel_left
 504+ A30A 77           	ld (hl),a
 505+ A30B
 506+ A30B 23           	inc hl
 507+ A30C
 508+ A30C 77           	ld (hl),a 														; (Vel_left) y (Vel_right) a "1".
 509+ A30D
 510+ A30D              ;	El primer Sprite que se imprime en pantalla en cualquier patrón de movimientos será un "sprite vacío".
 511+ A30D              ;	El objeto "SIEMPRE" ha de aparecer `oculto'. Tanto si aparece de arriba a abajo como si lo hace por los extremos de la pantalla.
 512+ A30D
 513+ A30D 21 0D 94     	ld hl,Ctrl_2
 514+ A310 CB C6        	set 0,(hl)														; Indica que fijamos un "sprite vacío" en (Puntero_objeto).
 515+ A312
 516+ A312 2A 1E 94     	ld hl,(Posicion_inicio)
 517+ A315 22 11 94     	ld (Posicion_actual),hl 										; (Posicion_actual) no puede contener "0" para poder ejecutar (Mov_lef) o (Mov_right).
 518+ A318
 519+ A318 7D           	ld a,l
 520+ A319 E6 1F        	and $1f
 521+ A31B 28 1A        	jr z,1F
 522+ A31D
 523+ A31D FE 1F        	cp $1f
 524+ A31F 20 03        	jr nz,2F
 525+ A321
 526+ A321              ;	Vamos a aparecer por la parte derecha de la pantalla.
 527+ A321
 528+ A321 CD 7D B7     	call Mov_left
 529+ A324
 530+ A324              ; No vamos a aparecer por ningún extremo. Cargamos Sprite vacío pues vamos a ir apareciendo por la_
 531+ A324              ; _parte alta de la pantalla.
 532+ A324
 533+ A324 2A 13 94     2 ld hl,(Puntero_objeto)
 534+ A327 22 37 94     	ld (Repone_puntero_objeto),hl
