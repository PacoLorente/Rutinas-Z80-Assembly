 481  91E7              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 91E7
   2+ 91E7
   3+ 91E7              ;   07/07/23
   4+ 91E7              ;
   5+ 91E7              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 91E7              ;
   7+ 91E7              ;   Codificación:
   8+ 91E7              ;
   9+ 91E7              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 91E7              ;
  11+ 91E7              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 91E7              ;
  13+ 91E7              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 91E7              ;
  15+ 91E7              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 91E7              ;
  17+ 91E7              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 91E7              ;                               ..... %01000010 Vel_up 4
  19+ 91E7              ;                                               Vel_down 2
  20+ 91E7              ;                               ..... $42
  21+ 91E7              ;
  22+ 91E7              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 91E7              ;
  24+ 91E7              ;                               ..... %01000010 Vel_left 4
  25+ 91E7              ;                                               Vel_right 2
  26+ 91E7              ;                               ..... $42
  27+ 91E7              ;
  28+ 91E7              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 91E7              ;
  30+ 91E7              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 91E7              ;
  32+ 91E7              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 91E7              ;
  34+ 91E7              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 91E7              ;                                     $53
  36+ 91E7              ;
  37+ 91E7              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 91E7              ;
  39+ 91E7              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 91E7              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 91E7              ;
  42+ 91E7              ;                       Arriba ..... $81
  43+ 91E7              ;                       Arriba - izquierda ..... $a1
  44+ 91E7              ;                       Arriba - derecha ..... $91
  45+ 91E7              ;
  46+ 91E7              ;                       Abajo ..... $41
  47+ 91E7              ;                       Abajo - izquierda ..... $61
  48+ 91E7              ;                       Abajo - derecha ..... $51
  49+ 91E7              ;
  50+ 91E7              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 91E7              ;
  52+ 91E7              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 91E7              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 91E7              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 91E7              ;
  56+ 91E7              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 91E7              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 91E7              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 91E7              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 91E7              ;
  61+ 91E7              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 91E7              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 91E7              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 91E7              ;
  65+ 91E7              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 91E7              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 91E7              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 91E7              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 91E7
  70+ 91E7              ; ----- ----- ----- ----- -----
  71+ 91E7              ;
  72+ 91E7              ;   Factor RANDOM --- BadSat.
  73+ 91E7
