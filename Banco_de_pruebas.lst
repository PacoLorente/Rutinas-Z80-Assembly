 350  91A4              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 351  91A4
 352  91A4 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 353  91A5 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 354  91A6 00           Cola_de_desplazamiento db 0									; Este byte indica:
 355  91A7
 356  91A7              ;
 357  91A7              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 358  91A7              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 359  91A7              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 360  91A7              ;
 361  91A7              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 362  91A7              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 363  91A7              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 364  91A7              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 365  91A7              ;
 366  91A7              ;															;	"$ff" ..... Bucle infinito de repetición.
 367  91A7              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 368  91A7              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 369  91A7
