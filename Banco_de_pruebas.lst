 590+ B1FD
 591+ B1FD 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B1FE C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B200 6F               ld l,a
 594+ B201 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B202
 596+ B202 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B203 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B205 67               ld h,a
 599+ B206 C9               ret
