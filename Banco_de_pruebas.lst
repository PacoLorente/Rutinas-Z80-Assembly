 565+ B1D2              ;   NextScan.
 566+ B1D2              ;
 567+ B1D2              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ B1D2              ;
 569+ B1D2              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ B1D2              ;
 571+ B1D2              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ B1D2              ;
 573+ B1D2              ;       DESTRUIDOS: AF y HL !!!
 574+ B1D2              ;
 575+ B1D2              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ B1D2              ;
 577+ B1D2
 578+ B1D2 24           NextScan inc h          							; Incrementamos el scanline.
 579+ B1D3 7C               ld a,h
 580+ B1D4 E6 07            and 7
 581+ B1D6 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ B1D7
 583+ B1D7 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1D8 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1DA 6F               ld l,a
 586+ B1DB D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1DC
 588+ B1DC 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1DD D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1DF 67               ld h,a
 591+ B1E0 C9               ret
