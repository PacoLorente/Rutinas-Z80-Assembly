   5+ 9965              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9965              ;   (XOR) bit a bit.
   7+ 9965              ;
   8+ 9965              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9965              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9965
  11+ 9965              Derivando_RND
  12+ 9965
  13+ 9965 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9967 C5               push bc
  15+ 9968              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9968 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 996B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 996B
  19+ 996B A7           6 and a                                 ; Carry a "0".
  20+ 996C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 996E 30 02            jr nc,1F
  22+ 9970
  23+ 9970 CB C1            set 0,c
  24+ 9972
  25+ 9972 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9973 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9975 5F               ld e,a
  28+ 9976
  29+ 9976 7A               ld a,d
  30+ 9977 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9979 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 997B
  33+ 997B CB 3F            srl a
  34+ 997D
  35+ 997D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 997E
  37+ 997E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 997F 28 04            jr z,4F
  39+ 9981
  40+ 9981 CB FF            set 7,a
  41+ 9983 18 02            jr 5F
  42+ 9985
  43+ 9985 CB BF        4 res 7,a
  44+ 9987
  45+ 9987 CB 21        5 sla c
  46+ 9989 10 E0            djnz 6B
  47+ 998B
  48+ 998B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 998C
  50+ 998C 77               ld (hl),a
  51+ 998D 23               inc hl
  52+ 998E C1               pop bc
  53+ 998F 10 D4            djnz 3B
  54+ 9991
  55+ 9991 C9               ret
  56+ 9992
  57+ 9992
  58+ 9992
