 236  CC80              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 237  CC80              ;
 238  CC80              ;															;	"$ff" ..... Bucle infinito de repetición.
 239  CC80              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 240  CC80              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
