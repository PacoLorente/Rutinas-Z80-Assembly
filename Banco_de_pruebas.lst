1051+ C535              ;   Sitúa DOS columnas a la izquierda el comienzo de la línea de texto, (para que quede centrado), cuando el control_
1052+ C535              ;   _ a analizar, (HL) sea una TECLA ESPECIAL.
1053+ C535              ;
1054+ C535              ;   Las teclas especiales se mostrarán en pantalla como cadenas de texto de 5 caracteres:
1055+ C535              ;
1056+ C535              ;   Special keys:
1057+ C535              ;
1058+ C535              ;   Symbol_key defm "SYMB."
1059+ C535              ;   Space_key defm "SPACE"
1060+ C535              ;   Enter_key defm "ENTER"
1061+ C535              ;   Caps_key defm "CAPS."
1062+ C535              ;
1063+ C535              ;   MODIFY: AF, E.
1064+ C535              ;
1065+ C535              ;   INPUTS: HL apunta a la dirección que contiene el KEYCODE de la tecla de CONTROL a sondear:
