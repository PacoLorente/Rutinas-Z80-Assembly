 533  94B7              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 534  94B7
 535  94B7 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 536  94B8 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 537  94B9 00           Cola_de_desplazamiento db 0									; Este byte indica:
 538  94BA
 539  94BA              ;
 540  94BA              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 541  94BA              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 542  94BA              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 543  94BA              ;
 544  94BA              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 545  94BA              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 546  94BA              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 547  94BA              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 548  94BA              ;
 549  94BA              ;															;	"$ff" ..... Bucle infinito de repetición.
 550  94BA              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 551  94BA              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 552  94BA
 553  94BA 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 554  94BB
 555  94BB              ;																DESCRIPCIÓN:
 556  94BB              ;
 557  94BB              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 558  94BB              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 559  94BB              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 560  94BB              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 561  94BB              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 562  94BB              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 563  94BB
 564  94BB              ;															BIT 3, Recarga de nueva oleada.
 565  94BB              ;															BIT 4, Recarga de nueva oleada.
 566  94BB              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 567  94BB              ;															BIT 6, **** Frame completo.
 568  94BB              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 569  94BB
 570  94BB 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 571  94BD              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 572  94BD              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 573  94BD              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
