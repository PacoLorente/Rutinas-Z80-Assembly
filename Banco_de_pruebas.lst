 720+ B567              ;
 721+ B567              ;   NextScan.
 722+ B567              ;
 723+ B567              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 724+ B567              ;
 725+ B567              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 726+ B567              ;
 727+ B567              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 728+ B567              ;
 729+ B567              ;       DESTRUIDOS: AF y HL !!!
 730+ B567              ;
 731+ B567              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 732+ B567              ;
 733+ B567
 734+ B567              NextScan:
 735+ B567
 736+ B567 24           	inc h          							; Incrementamos el scanline.
 737+ B568 7C               ld a,h
 738+ B569 E6 07            and 7
 739+ B56B C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 740+ B56C
 741+ B56C 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 742+ B56D C6 20            add a,$20           							; Vamos a comprobarlo...
 743+ B56F 6F               ld l,a
 744+ B570 D8               ret c               							; Salimos si se produce el cambio de tercio.
 745+ B571
 746+ B571 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 747+ B572 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 748+ B574 67               ld h,a
 749+ B575 C9               ret
 750+ B576
 751+ B576              ;----------------------------------------------------------------------------------------------------------------
 752+ B576              ;
 753+ B576              ;	5/08/22
 754+ B576              ;
 755+ B576              ;   PreviousScan.
 756+ B576              ;
 757+ B576              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 758+ B576              ;
 759+ B576              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 760+ B576              ;
 761+ B576              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 762+ B576              ;
 763+ B576              ;       DESTRUIDOS: AF y HL !!!
 764+ B576              ;
 765+ B576              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 766+ B576              ;
 767+ B576
 768+ B576              PreviousScan:
 769+ B576
 770+ B576 7C           	ld a,h
 771+ B577 25               dec h               							; Dec H.
 772+ B578 E6 07            and 7
 773+ B57A C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 774+ B57B
 775+ B57B 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 776+ B57C D6 20            sub $20             							; Vamos a comprobarlo...
 777+ B57E 6F               ld l,a
 778+ B57F D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 779+ B580
 780+ B580 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 781+ B581 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 782+ B583 67               ld h,a
 783+ B584 C9               ret
