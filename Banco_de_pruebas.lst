 291+ 9E85
 292+ 9E85 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 293+ 9E86 C6 20            add a,$20           							; Vamos a comprobarlo...
 294+ 9E88 6F               ld l,a
 295+ 9E89 D8               ret c               							; Salimos si se produce el cambio de tercio.
 296+ 9E8A
 297+ 9E8A 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 298+ 9E8B D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 299+ 9E8D 67               ld h,a
 300+ 9E8E C9               ret
