   1+ 9729              ; ******************************************************************************************************************************************************************************************
   2+ 9729              ;
   3+ 9729              ;   3/4/25
   4+ 9729              ;
   5+ 9729              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9729              ;   (XOR) bit a bit.
   7+ 9729              ;
   8+ 9729              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9729              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9729
  11+ 9729              Derivando_RND
  12+ 9729
  13+ 9729 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 972B C5               push bc
  15+ 972C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 972C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 972F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 972F
  19+ 972F A7           6 and a                                 ; Carry a "0".
  20+ 9730 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9732 30 02            jr nc,1F
  22+ 9734
  23+ 9734 CB C1            set 0,c
  24+ 9736
  25+ 9736 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9737 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9739 5F               ld e,a
  28+ 973A
  29+ 973A 7A               ld a,d
  30+ 973B E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 973D 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 973F
  33+ 973F CB 3F            srl a
  34+ 9741
  35+ 9741 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9742
  37+ 9742 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9743 28 04            jr z,4F
  39+ 9745
  40+ 9745 CB FF            set 7,a
  41+ 9747 18 02            jr 5F
  42+ 9749
  43+ 9749 CB BF        4 res 7,a
  44+ 974B
  45+ 974B CB 21        5 sla c
  46+ 974D 10 E0            djnz 6B
  47+ 974F
  48+ 974F 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9750
