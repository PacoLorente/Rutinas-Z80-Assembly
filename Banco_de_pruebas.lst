 582+ AEC9
 583+ AEC9 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ AECA C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ AECC 6F               ld l,a
 586+ AECD D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ AECE
 588+ AECE 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ AECF D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ AED1 67               ld h,a
 591+ AED2 C9               ret
