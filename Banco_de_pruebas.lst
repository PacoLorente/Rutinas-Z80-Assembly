 623+ BB61 C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ BB63 6F               ld l,a
 625+ BB64 D8               ret c               							; Salimos si se produce el cambio de tercio.
 626+ BB65
 627+ BB65 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 628+ BB66 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 629+ BB68 67               ld h,a
