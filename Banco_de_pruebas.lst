 212+ C73F
 213+ C73F 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 214+ C740
 215+ C740 D1               pop de                                   ; Score_max_msg en DE.
 216+ C741
 217+ C741 CD 4A C7         call ASCII_CODE_de_KEYCODE
 218+ C744
 219+ C744 0C               inc c                                    ; Indica que a partir de ahora se imprimen todos los "0".
 220+ C745
 221+ C745              Next_digit:
 222+ C745
 223+ C745 13               inc de                                   ; Siguiente char del msg. que estamos creando.
