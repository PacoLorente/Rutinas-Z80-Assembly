  58+ C03C
  59+ C03C              Get_note:
  60+ C03C
  61+ C03C ED 73 B0 95      ld (Stack),sp
  62+ C040
  63+ C040 F9               ld sp,hl
  64+ C041
  65+ C041 C1               pop bc                                            ; (B) siempre "0", (C) indica duración de la nota, (n°de ondas).
  66+ C042 D1               pop de                                            ; (DE) siempre contendrá "0".
  67+ C043 E1               pop hl                                            ; (H) = "0", (L) contiene el valor de la nota.
  68+ C044
  69+ C044              ;   Tenemos la nota cargada en os registros.
