   3+ A699              ;
   4+ A699              ;	CLS.
   5+ A699              ;
   6+ A699              ;	Limpia la pantalla y define sus atributos.
   7+ A699              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A699              ;
   9+ A699              ;	COLORES: 0 ..... NEGRO
  10+ A699              ;    		 1 ..... AZUL
  11+ A699              ; 			 2 ..... ROJO
  12+ A699              ;			 3 ..... MAGENTA
  13+ A699              ; 			 4 ..... VERDE
  14+ A699              ; 			 5 ..... CIAN
  15+ A699              ;			 6 ..... AMARILLO
  16+ A699              ; 			 7 ..... BLANCO
  17+ A699              ;
  18+ A699              ;	INPUT: A contiene los atributos de pantalla.
  19+ A699              ;
  20+ A699              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A699
  22+ A699
  23+ A699 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A69C 11 01 40     	LD DE,$4001
  25+ A69F 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A6A2 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A6A4 ED B0        	LDIR
  28+ A6A6 01 FF 02     	LD BC,767
  29+ A6A9 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A6AA ED B0        	LDIR
  31+ A6AC
  32+ A6AC AF           	xor a
  33+ A6AD
  34+ A6AD C9           	ret
  35+ A6AE
