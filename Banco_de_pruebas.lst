1662  9938
1663  9938 38 01        	jr c,1F
1664  993A
1665  993A              ;	Por encima o igual que (Max_time_to_appear_entities).
1666  993A              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1667  993A
1668  993A 4E           	ld c,(hl)
1669  993B
1670  993B              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1671  993B              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1672  993B
