 293  8CA4 00 00        Puntero_mov defw 0								; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 294  8CA6 00 00        Puntero_indice_mov_bucle defw 0
 295  8CA8              ;
 296  8CA8              ;
 297  8CA8 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 298  8CA9              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 299  8CA9              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 300  8CA9
 301  8CA9 00           Incrementa_puntero_backup db 0
 302  8CAA 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 303  8CAB              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 304  8CAB
 305  8CAB 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 306  8CAC 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 307  8CAD 00           Cola_de_desplazamiento db 0						; Este byte indica:
 308  8CAE
 309  8CAE              ;
 310  8CAE              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 311  8CAE              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 312  8CAE              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 313  8CAE              ;
 314  8CAE              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 315  8CAE              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 316  8CAE              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 317  8CAE              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 318  8CAE              ;
 319  8CAE              ;																;	"$ff" ..... Bucle infinito de repetición.
 320  8CAE              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 321  8CAE              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
