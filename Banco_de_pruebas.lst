 702+ 9F59
 703+ 9F59              Loop:
 704+ 9F59
 705+ 9F59 ED 5F            ld a,r
 706+ 9F5B 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 707+ 9F5C
 708+ 9F5C 3E 10            ld a,%00010000          ; Borde negro.
 709+ 9F5E D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 710+ 9F60
 711+ 9F60 10 FE        Delay_1 djnz Delay_1        ; Aplica Delay.
 712+ 9F62
 713+ 9F62 AF               xor a
 714+ 9F63 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 715+ 9F65
 716+ 9F65 ED 5F            ld a,r
 717+ 9F67 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 718+ 9F68
 719+ 9F68 10 FE        Delay_2 djnz Delay_2        ; Aplica Delay.
 720+ 9F6A
 721+ 9F6A 25               dec h
 722+ 9F6B
 723+ 9F6B 0D               dec c                   ; Decrementa ondas completas generadas.
 724+ 9F6C
 725+ 9F6C 20 EB            jr nz,Loop
 726+ 9F6E
 727+ 9F6E 22 B6 94         ld (Sound),hl
 728+ 9F71
 729+ 9F71 C9               ret
