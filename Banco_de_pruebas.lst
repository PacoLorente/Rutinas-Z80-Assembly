 308  8EDE              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 309  8EDE
 310  8EDE 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 311  8EDF 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 312  8EE0 00           Cola_de_desplazamiento db 0									; Este byte indica:
 313  8EE1
 314  8EE1              ;
 315  8EE1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8EE1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8EE1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8EE1              ;
 319  8EE1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8EE1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 321  8EE1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8EE1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 323  8EE1              ;
 324  8EE1              ;															;	"$ff" ..... Bucle infinito de repetición.
 325  8EE1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 326  8EE1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 327  8EE1
 328  8EE1 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 329  8EE2
 330  8EE2              ;																DESCRIPCIÓN:
 331  8EE2              ;
 332  8EE2              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 333  8EE2              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 334  8EE2              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 335  8EE2              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 336  8EE2              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 337  8EE2              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 338  8EE2
 339  8EE2              ;															BIT 3, Recarga de nueva oleada.
 340  8EE2              ;															BIT 4, Recarga de nueva oleada.
 341  8EE2              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 342  8EE2              ;															BIT 6, **** Frame completo.
 343  8EE2              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 344  8EE2
