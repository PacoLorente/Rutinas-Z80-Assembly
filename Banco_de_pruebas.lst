 312  8E92 00           Cola_de_desplazamiento db 0									; Este byte indica:
 313  8E93
 314  8E93              ;
 315  8E93              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8E93              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8E93              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8E93              ;
 319  8E93              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8E93              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 321  8E93              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8E93              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 323  8E93              ;
 324  8E93              ;															;	"$ff" ..... Bucle infinito de repetición.
 325  8E93              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 326  8E93              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 327  8E93
