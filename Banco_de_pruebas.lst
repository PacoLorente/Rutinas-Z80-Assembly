 435+ C14E              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C14E              ;
 437+ C14E              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C14E              ;   _ [Sound_Generator].
 439+ C14E              ;
 440+ C14E              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C14E              ;
 442+ C14E              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C14E              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C14E              ;
 445+ C14E              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C14E              ;
 447+ C14E              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C14E              ;
 449+ C14E              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C14E
 451+ C14E              Play_burst_sound_effect:
 452+ C14E
 453+ C14E              ;   Exclusiones:
 454+ C14E
 455+ C14E 3A 8A 94         ld a,(Burst_sound)
 456+ C151 A7               and a
 457+ C152 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C153
 459+ C153 08               ex af,af
 460+ C154
 461+ C154 3A 5B 94         ld a,(Ctrl_6)
 462+ C157 CB 47            bit 0,a
 463+ C159 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C15A
 465+ C15A              ;   ----------------------
 466+ C15A
 467+ C15A CB C7            set 0,a
 468+ C15C 32 5B 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C15F
 470+ C15F 08               ex af,af                ; Restore (Burst_sound).
 471+ C160
 472+ C160 67               ld h,a
 473+ C161 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C163
 475+ C163 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C164
 477+ C164 22 84 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C167 0E 03            ld c,3
 479+ C169 CD 1D 9F         call Noise_efect
