  48+ 99D6              ; -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  49+ 99D6              ;
  50+ 99D6              ;   14/02/25
  51+ 99D6              ;
  52+ 99D6              ;	Calcula el cuadrante de pantalla donde se encuentra la entidad: (Cuad_objeto), "1", "2", "3" o "4".
  53+ 99D6              ;	Esta información es necesaria para poder calcular el (Puntero_de_impresion) de la entidad.
  54+ 99D6              ;
  55+ 99D6              ;	INPUT:  HL contiene (Posicion_actual).
  56+ 99D6              ;	OUTPUT: (Cuad_objeto) y A contienen "1", "2", "3" o "4" en función del cuadrante de pantalla en el que se encuentra la entidad.
  57+ 99D6              ;
  58+ 99D6              ;	MODIFY: A.
  59+ 99D6
  60+ 99D6
  61+ 99D6              Calcula_Cuad_objeto
  62+ 99D6
  63+ 99D6 CD D2 95     	call calcula_tercio
  64+ 99D9
  65+ 99D9              ;	Ahora tenemos "0", "1" o "2" en el acumulador en función del tercio de pantalla en el que nos encontremos.
  66+ 99D9
  67+ 99D9 28 12        	jr z,Primer_tercio
  68+ 99DB 3D           	dec a
  69+ 99DC 28 1C        	jr z,Segundo_tercio
  70+ 99DE
  71+ 99DE              Tercer_tercio
  72+ 99DE
  73+ 99DE CD 03 9A     	call Determina_lado_de_pantalla
  74+ 99E1 20 04        	jr nz,1F
  75+ 99E3 3E 04        	ld a,4
  76+ 99E5 18 02        	jr 2F
