   1+ A0CB              ; ******************************************************************************************************************************************************************************************
   2+ A0CB              ;
   3+ A0CB              ;   3/4/25
   4+ A0CB              ;
   5+ A0CB              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0CB              ;   (XOR) bit a bit.
   7+ A0CB              ;
   8+ A0CB              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0CB              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0CB
  11+ A0CB              Derivando_RND
  12+ A0CB
  13+ A0CB ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0CD C5               push bc
  15+ A0CE              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0CE 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0D1              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0D1
  19+ A0D1 A7           6 and a                                 ; Carry a "0".
  20+ A0D2 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0D4 30 02            jr nc,1F
  22+ A0D6
  23+ A0D6 CB C1            set 0,c
  24+ A0D8
  25+ A0D8 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0D9 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0DB 5F               ld e,a
  28+ A0DC
  29+ A0DC 7A               ld a,d
  30+ A0DD E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0DF 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0E1
  33+ A0E1 CB 3F            srl a
  34+ A0E3
  35+ A0E3 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0E4
  37+ A0E4 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0E5 28 04            jr z,4F
  39+ A0E7
  40+ A0E7 CB FF            set 7,a
  41+ A0E9 18 02            jr 5F
  42+ A0EB
  43+ A0EB CB BF        4 res 7,a
  44+ A0ED
  45+ A0ED CB 21        5 sla c
  46+ A0EF 10 E0            djnz 6B
  47+ A0F1
  48+ A0F1 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0F2
  50+ A0F2 77               ld (hl),a
  51+ A0F3 23               inc hl
  52+ A0F4 C1               pop bc
  53+ A0F5 10 D4            djnz 3B
  54+ A0F7
  55+ A0F7 C9               ret
  56+ A0F8
  57+ A0F8
  58+ A0F8
