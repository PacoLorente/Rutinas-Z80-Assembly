   1+ 909F
   2+ 909F
   3+ 909F              ;   07/07/23
   4+ 909F              ;
   5+ 909F              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 909F              ;
   7+ 909F              ;   Codificación:
   8+ 909F              ;
   9+ 909F              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 909F              ;
  11+ 909F              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 909F              ;
  13+ 909F              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 909F              ;
  15+ 909F              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 909F              ;
  17+ 909F              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 909F              ;                               ..... %01000010 Vel_up 4
  19+ 909F              ;                                               Vel_down 2
  20+ 909F              ;                               ..... $42
  21+ 909F              ;
  22+ 909F              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 909F              ;
  24+ 909F              ;                               ..... %01000010 Vel_left 4
  25+ 909F              ;                                               Vel_right 2
  26+ 909F              ;                               ..... $42
  27+ 909F              ;
  28+ 909F              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 909F              ;
  30+ 909F              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 909F              ;
  32+ 909F              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 909F              ;
  34+ 909F              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 909F              ;                                     $53
  36+ 909F              ;
  37+ 909F              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 909F              ;
  39+ 909F              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 909F              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 909F              ;
  42+ 909F              ;                       Arriba ..... $81
  43+ 909F              ;                       Arriba - izquierda ..... $a1
  44+ 909F              ;                       Arriba - derecha ..... $91
  45+ 909F              ;
  46+ 909F              ;                       Abajo ..... $41
  47+ 909F              ;                       Abajo - izquierda ..... $61
  48+ 909F              ;                       Abajo - derecha ..... $51
  49+ 909F              ;
  50+ 909F              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 909F              ;
  52+ 909F              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 909F              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 909F              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 909F              ;
  56+ 909F              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 909F              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 909F              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 909F              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 909F              ;
  61+ 909F              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 909F              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 909F              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 909F              ;
  65+ 909F              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 909F              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 909F              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 909F              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 909F
