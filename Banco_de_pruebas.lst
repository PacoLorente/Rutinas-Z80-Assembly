   5+ 9D38              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D38              ;   (XOR) bit a bit.
   7+ 9D38              ;
   8+ 9D38              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D38              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D38
  11+ 9D38              Derivando_RND
  12+ 9D38
  13+ 9D38 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D3A C5               push bc
  15+ 9D3B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D3B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D3E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D3E
  19+ 9D3E A7           6 and a                                 ; Carry a "0".
  20+ 9D3F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D41 30 02            jr nc,1F
  22+ 9D43
  23+ 9D43 CB C1            set 0,c
  24+ 9D45
  25+ 9D45 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D46 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D48 5F               ld e,a
  28+ 9D49
  29+ 9D49 7A               ld a,d
  30+ 9D4A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D4C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D4E
  33+ 9D4E CB 3F            srl a
  34+ 9D50
  35+ 9D50 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D51
  37+ 9D51 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D52 28 04            jr z,4F
  39+ 9D54
  40+ 9D54 CB FF            set 7,a
  41+ 9D56 18 02            jr 5F
  42+ 9D58
  43+ 9D58 CB BF        4 res 7,a
  44+ 9D5A
  45+ 9D5A CB 21        5 sla c
  46+ 9D5C 10 E0            djnz 6B
  47+ 9D5E
  48+ 9D5E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D5F
  50+ 9D5F 77               ld (hl),a
  51+ 9D60 23               inc hl
  52+ 9D61 C1               pop bc
  53+ 9D62 10 D4            djnz 3B
  54+ 9D64
  55+ 9D64 C9               ret
  56+ 9D65
  57+ 9D65
  58+ 9D65
