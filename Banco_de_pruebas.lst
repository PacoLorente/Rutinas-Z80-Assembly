 255  8C53              ;	COLORES: 0 ..... NEGRO
 256  8C53              ;    		 1 ..... AZUL
 257  8C53              ; 			 2 ..... ROJO
 258  8C53              ;			 3 ..... MAGENTA
 259  8C53              ; 			 4 ..... VERDE
 260  8C53              ; 			 5 ..... CIAN
 261  8C53              ;			 6 ..... AMARILLO
 262  8C53              ; 			 7 ..... BLANCO
 263  8C53
