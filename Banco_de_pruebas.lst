 598+ A1AC              ;
 599+ A1AC              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 600+ A1AC              ;
 601+ A1AC              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ A1AC              ;
 603+ A1AC              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ A1AC              ;
 605+ A1AC              ;       DESTRUIDOS: AF y HL !!!
 606+ A1AC              ;
 607+ A1AC              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ A1AC              ;
 609+ A1AC
 610+ A1AC 7C           PreviousScan ld a,h
 611+ A1AD 25               dec h               ; Dec H.
 612+ A1AE E6 07            and 7
 613+ A1B0 C0               ret nz              ; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ A1B1
 615+ A1B1 7D               ld a,l              ; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ A1B2 D6 20            sub $20             ; Vamos a comprobarlo...
 617+ A1B4 6F               ld l,a
 618+ A1B5 D8               ret c               ; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ A1B6
 620+ A1B6 7C               ld a,h              ; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ A1B7 C6 08            add a,8             ; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ A1B9 67               ld h,a
 623+ A1BA C9               ret
