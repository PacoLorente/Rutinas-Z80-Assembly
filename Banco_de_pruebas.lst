1729  99E5              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1730  99E5
1731  99E5 4E           	ld c,(hl)
1732  99E6
1733  99E6              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1734  99E6              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1735  99E6
1736  99E6 23           1 inc hl
1737  99E7 23           	inc hl
1738  99E8
1739  99E8 BE           	cp (hl)
