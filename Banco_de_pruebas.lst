 586  94C5 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 587  94C6 00           Cola_de_desplazamiento db 0									; Este byte indica:
 588  94C7
 589  94C7              ;
 590  94C7              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 591  94C7              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 592  94C7              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 593  94C7              ;
 594  94C7              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 595  94C7              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 596  94C7              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 597  94C7              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 598  94C7              ;
 599  94C7              ;															;	"$ff" ..... Bucle infinito de repetición.
 600  94C7              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 601  94C7              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 602  94C7
 603  94C7 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 604  94C8
 605  94C8              ;																DESCRIPCIÓN:
 606  94C8              ;
 607  94C8              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 608  94C8              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 609  94C8              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 610  94C8              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 611  94C8              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 612  94C8              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 613  94C8
 614  94C8              ;															BIT 3, Recarga de nueva oleada.
 615  94C8              ;															BIT 4, Recarga de nueva oleada.
 616  94C8              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 617  94C8              ;															BIT 6, **** Frame completo.
