 352+ C114              ; ----- ----- ----- ----- -----
 353+ C114              ;
 354+ C114              ;   23/9/26
 355+ C114              ;
 356+ C114              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C114              ;
 358+ C114              ;   HL define el sonido.
 359+ C114              ;
 360+ C114              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C114              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C114              ;
 363+ C114              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C114              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C114              ;
 366+ C114              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C114              ;
 368+ C114              ;   INPUTS: (Shot_sound) <> "0".
 369+ C114              ;
 370+ C114              ;   MODIFY: AF, HL y BC.
 371+ C114              ;
 372+ C114              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C114
 374+ C114              Play_shot_sound_effect:
 375+ C114
 376+ C114              ;   Exclusiones:
 377+ C114
 378+ C114 2A 89 94         ld hl,(Shot_sound)
 379+ C117 7C               ld a,h
 380+ C118 B5               or l
 381+ C119 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C11A
 383+ C11A 3A 5B 94         ld a,(Ctrl_6)
