 307  8C8A 00           Incrementa_puntero db 0									; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 308  8C8B              ;														; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 309  8C8B              ;														; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 310  8C8B 00           Incrementa_puntero_backup db 0
 311  8C8C 00           Repetimos_desplazamiento db 0							; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 312  8C8D              ;														; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 313  8C8D 00           Repetimos_desplazamiento_backup db 0					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 314  8C8E 00           Repetimos_movimiento db 0								; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 315  8C8F 00           Cola_de_desplazamiento db 0								; Este byte indica:
 316  8C90              ;
 317  8C90              ;														;	"$00" ..... Hemos finalizado la cadena de movimiento.
 318  8C90              ;														;				En este caso hemos de incrementar (Puntero_indice_mov)_
 319  8C90              ;														;				_ y pasar a la siguiente cadena de movimiento del índice.
 320  8C90              ;
 321  8C90              ;														;	"$01 - "$fe" ..... Repetición del movimiento.
 322  8C90              ;														;						Nº de veces que vamos a repetir el movimiento completo.
 323  8C90              ;														;						En este caso, volveremos a inicializar (Puntero_mov),_
 324  8C90              ;														;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 325  8C90              ;
 326  8C90              ;														;	"$ff" ..... Bucle infinito de repetición.
 327  8C90              ;														;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 328  8C90              ;														;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 329  8C90
 330  8C90 00           Ctrl_1 db 0 											; Byte de control de propósito general.
