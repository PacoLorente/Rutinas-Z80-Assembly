   1+ 972A              ; ******************************************************************************************************************************************************************************************
   2+ 972A              ;
   3+ 972A              ;   3/4/25
   4+ 972A              ;
   5+ 972A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 972A              ;   (XOR) bit a bit.
   7+ 972A              ;
   8+ 972A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 972A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 972A
  11+ 972A              Derivando_RND
  12+ 972A
  13+ 972A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 972C C5               push bc
  15+ 972D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 972D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9730              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9730
  19+ 9730 A7           6 and a                                 ; Carry a "0".
  20+ 9731 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9733 30 02            jr nc,1F
  22+ 9735
  23+ 9735 CB C1            set 0,c
  24+ 9737
  25+ 9737 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9738 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 973A 5F               ld e,a
  28+ 973B
  29+ 973B 7A               ld a,d
  30+ 973C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 973E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9740
  33+ 9740 CB 3F            srl a
  34+ 9742
  35+ 9742 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9743
  37+ 9743 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9744 28 04            jr z,4F
  39+ 9746
  40+ 9746 CB FF            set 7,a
  41+ 9748 18 02            jr 5F
  42+ 974A
