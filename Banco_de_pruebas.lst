 781+ B5AD              ;	5/08/22
 782+ B5AD              ;
 783+ B5AD              ;   NextScan.
 784+ B5AD              ;
 785+ B5AD              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B5AD              ;
 787+ B5AD              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B5AD              ;
 789+ B5AD              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B5AD              ;
 791+ B5AD              ;       DESTRUIDOS: AF y HL !!!
 792+ B5AD              ;
 793+ B5AD              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B5AD              ;
 795+ B5AD
 796+ B5AD              NextScan:
 797+ B5AD
 798+ B5AD 24           	inc h          							; Incrementamos el scanline.
 799+ B5AE 7C               ld a,h
 800+ B5AF E6 07            and 7
 801+ B5B1 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B5B2
 803+ B5B2 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B5B3 C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B5B5 6F               ld l,a
 806+ B5B6 D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B5B7
 808+ B5B7 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B5B8 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B5BA 67               ld h,a
 811+ B5BB C9               ret
 812+ B5BC
