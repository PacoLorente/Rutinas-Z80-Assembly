1601  9998 4E           	ld c,(hl)
1602  9999 18 06        	jr 2F
1603  999B
1604  999B              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1605  999B              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
