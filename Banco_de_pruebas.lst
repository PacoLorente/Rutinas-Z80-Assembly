 502+ C1BA
 503+ C1BA              ;   Init Burst_sound_efect.
 504+ C1BA
 505+ C1BA              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 506+ C1BA
 507+ C1BA 26 35            ld h,Burst_sound_init_value
 508+ C1BC
 509+ C1BC 3A CF 90         ld a,(Impacto_Amadeus)
 510+ C1BF A7               and a
 511+ C1C0 28 02            jr z,1F
 512+ C1C2
 513+ C1C2 26 75            ld h,Amadeus_Burst_sound_init_value
 514+ C1C4
 515+ C1C4 7C           1 ld a,h
 516+ C1C5
 517+ C1C5 32 EB 94         ld (Burst_sound),a
 518+ C1C8
 519+ C1C8 C9               ret
