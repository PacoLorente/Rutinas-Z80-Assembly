 614+ ACDB
 615+ ACDB 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ ACDC D6 20            sub $20             							; Vamos a comprobarlo...
 617+ ACDE 6F               ld l,a
