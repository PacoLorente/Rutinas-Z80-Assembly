   5+ 93FA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93FA              ;   (XOR) bit a bit.
   7+ 93FA              ;
   8+ 93FA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93FA
  10+ 93FA              Derivando_RND
  11+ 93FA
  12+ 93FA 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93FD
  14+ 93FD ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93FF C5               push bc
  16+ 9400              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9400 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9403              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9403
  20+ 9403 A7           6 and a                                 ; Carry a "0".
  21+ 9404 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9406 30 02            jr nc,1F
  23+ 9408
  24+ 9408 CB C1            set 0,c
  25+ 940A
  26+ 940A 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 940B E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 940D 5F               ld e,a
  29+ 940E
  30+ 940E 7A               ld a,d
  31+ 940F E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9411 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9413
  34+ 9413 CB 3F            srl a
  35+ 9415
  36+ 9415 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9416
  38+ 9416 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9417 28 04            jr z,4F
  40+ 9419
  41+ 9419 CB FF            set 7,a
  42+ 941B 18 02            jr 5F
  43+ 941D
  44+ 941D CB BF        4 res 7,a
  45+ 941F
  46+ 941F CB 21        5 sla c
  47+ 9421 10 E0            djnz 6B
  48+ 9423
  49+ 9423 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9424
  51+ 9424 77               ld (hl),a
  52+ 9425 23               inc hl
  53+ 9426 C1               pop bc
  54+ 9427 10 D4            djnz 3B
  55+ 9429
  56+ 9429 C9               ret
