   1+ 9F9A              ; ******************************************************************************************************************************************************************************************
   2+ 9F9A              ;
   3+ 9F9A              ;   3/4/25
   4+ 9F9A              ;
   5+ 9F9A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9F9A              ;   (XOR) bit a bit.
   7+ 9F9A              ;
   8+ 9F9A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9F9A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9F9A
  11+ 9F9A              Derivando_RND
  12+ 9F9A
  13+ 9F9A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9F9C C5               push bc
  15+ 9F9D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9F9D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9FA0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9FA0
  19+ 9FA0 A7           6 and a                                 ; Carry a "0".
  20+ 9FA1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9FA3 30 02            jr nc,1F
  22+ 9FA5
  23+ 9FA5 CB C1            set 0,c
  24+ 9FA7
  25+ 9FA7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9FA8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9FAA 5F               ld e,a
  28+ 9FAB
  29+ 9FAB 7A               ld a,d
  30+ 9FAC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9FAE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9FB0
  33+ 9FB0 CB 3F            srl a
  34+ 9FB2
  35+ 9FB2 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9FB3
  37+ 9FB3 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9FB4 28 04            jr z,4F
  39+ 9FB6
  40+ 9FB6 CB FF            set 7,a
  41+ 9FB8 18 02            jr 5F
  42+ 9FBA
  43+ 9FBA CB BF        4 res 7,a
  44+ 9FBC
  45+ 9FBC CB 21        5 sla c
  46+ 9FBE 10 E0            djnz 6B
  47+ 9FC0
  48+ 9FC0 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9FC1
  50+ 9FC1 77               ld (hl),a
  51+ 9FC2 23               inc hl
  52+ 9FC3 C1               pop bc
  53+ 9FC4 10 D4            djnz 3B
  54+ 9FC6
  55+ 9FC6 C9               ret
  56+ 9FC7
  57+ 9FC7
  58+ 9FC7
# file closed: RND_Derivando.asm
