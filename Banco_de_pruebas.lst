 352+ C15C              ; ----- ----- ----- ----- -----
 353+ C15C              ;
 354+ C15C              ;   23/9/26
 355+ C15C              ;
 356+ C15C              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C15C              ;
 358+ C15C              ;   HL define el sonido.
 359+ C15C              ;
 360+ C15C              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C15C              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C15C              ;
 363+ C15C              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C15C              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C15C              ;
 366+ C15C              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C15C              ;
 368+ C15C              ;   INPUTS: (Shot_sound) <> "0".
 369+ C15C              ;
 370+ C15C              ;   MODIFY: AF, HL y BC.
 371+ C15C              ;
 372+ C15C              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C15C
 374+ C15C              Play_shot_sound_effect:
 375+ C15C
 376+ C15C              ;   Exclusiones:
 377+ C15C
 378+ C15C 2A BA 94         ld hl,(Shot_sound)
 379+ C15F 7C               ld a,h
 380+ C160 B5               or l
 381+ C161 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C162
 383+ C162 3A 8D 94         ld a,(Ctrl_6)
 384+ C165 CB 47            bit 0,a
 385+ C167 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C168
 387+ C168 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C16A
 389+ C16A              Loop_1:
 390+ C16A
 391+ C16A 3E 10            ld a,%00010000          ; Borde negro.
 392+ C16C D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C16E
 394+ C16E 45               ld b,l
 395+ C16F
 396+ C16F 10 FE        Delay_3 djnz Delay_3
 397+ C171
 398+ C171 AF               xor a                   ; Borde negro.
 399+ C172 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C174
 401+ C174 45               ld b,l
 402+ C175
 403+ C175 10 FE        Delay_4 djnz Delay_4
 404+ C177
 405+ C177              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C177
 407+ C177 2C               inc l
 408+ C178 2C               inc l
 409+ C179 2C               inc l
 410+ C17A 2C               inc l
 411+ C17B
 412+ C17B 25               dec h
