   6+ 9958
   7+ 9958              Draw
   8+ 9958
   9+ 9958 CD ED 9B     	call Prepara_draw
  10+ 995B 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 995C A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 995D 28 05        	jr z,2F
  13+ 995F
  14+ 995F 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 9962 18 0C        	jr 1F
  16+ 9964
  17+ 9964              ;	Inicia entidad.
  18+ 9964
  19+ 9964 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 9967 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 996A CD F5 9A     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  22+ 996D              ;													; _la esquina superior izquierda de la pantalla.
  23+ 996D CD 83 A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  24+ 9970
  25+ 9970 3A F7 8B     1 ld a,(Ctrl_0)
  26+ 9973 CB 6F        	bit 5,a
  27+ 9975 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  28+ 9977
  29+ 9977 CD 8C 99     	call Comprueba_limite_horizontal
  30+ 997A CD 1C 9A     	call Comprueba_limite_vertical
  31+ 997D
  32+ 997D              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  33+ 997D              ; -----------------------
  34+ 997D              ; -----------------------
  35+ 997D              ; -----------------------
  36+ 997D
  37+ 997D CD 71 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  38+ 9980 CD 95 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  39+ 9983
  40+ 9983 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina REStauramos el bit5 de Ctrl_0 para que nos vuelva_
  41+ 9986 CB AF        	res 5,a											; _a ser de utilidad.
  42+ 9988 32 F7 8B     	ld (Ctrl_0),a
