 782+ B5C5              ;
 783+ B5C5              ;   NextScan.
 784+ B5C5              ;
 785+ B5C5              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B5C5              ;
 787+ B5C5              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B5C5              ;
 789+ B5C5              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B5C5              ;
 791+ B5C5              ;       DESTRUIDOS: AF y HL !!!
 792+ B5C5              ;
 793+ B5C5              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B5C5              ;
 795+ B5C5
 796+ B5C5              NextScan:
 797+ B5C5
 798+ B5C5 24           	inc h          							; Incrementamos el scanline.
 799+ B5C6 7C               ld a,h
 800+ B5C7 E6 07            and 7
 801+ B5C9 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B5CA
 803+ B5CA 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B5CB C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B5CD 6F               ld l,a
 806+ B5CE D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B5CF
 808+ B5CF 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B5D0 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B5D2 67               ld h,a
 811+ B5D3 C9               ret
 812+ B5D4
