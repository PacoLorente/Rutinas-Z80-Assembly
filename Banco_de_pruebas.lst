  21  AAEA              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ AAEA              ; ******************************************************************************************************************************************************************************************
   2+ AAEA              ;
   3+ AAEA              ;   3/4/25
   4+ AAEA              ;
   5+ AAEA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ AAEA              ;   (XOR) bit a bit.
   7+ AAEA              ;
   8+ AAEA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ AAEA              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ AAEA
  11+ AAEA              Derivando_RND
  12+ AAEA
  13+ AAEA ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ AAEC C5               push bc
  15+ AAED              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ AAED 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ AAF0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ AAF0
  19+ AAF0 A7           6 and a                                 ; Carry a "0".
  20+ AAF1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ AAF3 30 02            jr nc,1F
  22+ AAF5
  23+ AAF5 CB C1            set 0,c
  24+ AAF7
  25+ AAF7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ AAF8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ AAFA 5F               ld e,a
  28+ AAFB
  29+ AAFB 7A               ld a,d
  30+ AAFC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ AAFE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ AB00
  33+ AB00 CB 3F            srl a
  34+ AB02
  35+ AB02 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ AB03
  37+ AB03 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
