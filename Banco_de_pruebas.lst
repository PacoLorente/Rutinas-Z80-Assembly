  11+ 94D3              Derivando_RND
  12+ 94D3
  13+ 94D3 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94D5 C5               push bc
  15+ 94D6              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94D6 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94D9              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94D9
  19+ 94D9 A7           6 and a                                 ; Carry a "0".
  20+ 94DA CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94DC 30 02            jr nc,1F
  22+ 94DE
  23+ 94DE CB C1            set 0,c
  24+ 94E0
  25+ 94E0 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94E1 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94E3 5F               ld e,a
  28+ 94E4
  29+ 94E4 7A               ld a,d
  30+ 94E5 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94E7 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94E9
  33+ 94E9 CB 3F            srl a
  34+ 94EB
  35+ 94EB AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 94EC
  37+ 94EC 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 94ED 28 04            jr z,4F
  39+ 94EF
  40+ 94EF CB FF            set 7,a
  41+ 94F1 18 02            jr 5F
  42+ 94F3
  43+ 94F3 CB BF        4 res 7,a
  44+ 94F5
  45+ 94F5 CB 21        5 sla c
  46+ 94F7 10 E0            djnz 6B
  47+ 94F9
  48+ 94F9 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94FA
  50+ 94FA 77               ld (hl),a
  51+ 94FB 23               inc hl
  52+ 94FC C1               pop bc
  53+ 94FD 10 D4            djnz 3B
  54+ 94FF
  55+ 94FF C9               ret
