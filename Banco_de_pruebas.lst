 291  8C13
 292  8C13              ; Contadores de 16 bits.
 293  8C13
 294  8C13 00 00        Contador_general_de_mov_masticados_Entidad_1 defw 0
 295  8C15 00 00        Contador_general_de_mov_masticados_Entidad_2 defw 0
 296  8C17 00 00        Contador_general_de_mov_masticados_Entidad_3 defw 0
 297  8C19 00 00        Contador_general_de_mov_masticados_Entidad_4 defw 0
