1764  995E
1765  995E              ;	Por encima o igual que (Max_time_to_appear_entities).
1766  995E              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1767  995E
1768  995E 4E           	ld c,(hl)
1769  995F
1770  995F              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1771  995F              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
