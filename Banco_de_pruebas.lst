 343  91AD 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 344  91AE              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 345  91AE
 346  91AE 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 347  91AF 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 348  91B0 00           Cola_de_desplazamiento db 0									; Este byte indica:
 349  91B1
 350  91B1              ;
 351  91B1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 352  91B1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 353  91B1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 354  91B1              ;
 355  91B1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 356  91B1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 357  91B1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 358  91B1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 359  91B1              ;
 360  91B1              ;															;	"$ff" ..... Bucle infinito de repetición.
 361  91B1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 362  91B1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 363  91B1
 364  91B1 00           Ctrl_1 db 0 												; Byte de control de propósito general.
