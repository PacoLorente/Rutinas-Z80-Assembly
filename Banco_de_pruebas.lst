 868+ B5D6              ;
 869+ B5D6              ;	INPUTS:  HL apunta al 1er byte del espacio de memoria que queremos limpiar.
 870+ B5D6              ;				   BC indica el nº de bytes que vamos a poner a "0".
 871+ B5D6              ;
 872+ B5D6              ;	MODIFY: HL,DE,BC
 873+ B5D6
