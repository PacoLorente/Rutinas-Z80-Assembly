 780+ B612              ;
 781+ B612              ;	5/08/22
 782+ B612              ;
 783+ B612              ;   NextScan.
 784+ B612              ;
 785+ B612              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B612              ;
 787+ B612              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B612              ;
 789+ B612              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B612              ;
 791+ B612              ;       DESTRUIDOS: AF y HL !!!
 792+ B612              ;
 793+ B612              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B612              ;
 795+ B612
 796+ B612              NextScan:
 797+ B612
 798+ B612 24           	inc h          							; Incrementamos el scanline.
 799+ B613 7C               ld a,h
 800+ B614 E6 07            and 7
 801+ B616 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B617
 803+ B617 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B618 C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B61A 6F               ld l,a
 806+ B61B D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B61C
 808+ B61C 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B61D D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B61F 67               ld h,a
 811+ B620 C9               ret
 812+ B621
 813+ B621              NextScan_15:
 814+ B621
 815+ B621 06 0F        	ld b,15
 816+ B623 CD 12 B6     1 call NextScan
 817+ B626 10 FB        	djnz 1B
 818+ B628
 819+ B628 C9           	ret
