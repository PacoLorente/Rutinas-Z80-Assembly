1528  9846              ; 	21/11/25
1529  9846              ;
1530  9846              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
1531  9846              ;
1532  9846              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
1533  9846              ;
1534  9846              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
1535  9846              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
1536  9846              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
1537  9846              ;
1538  9846              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
1539  9846              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
1540  9846              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
1541  9846              ;				  _medida que transcurre el tiempo.
1542  9846              ;
1543  9846              ;	OUTPUT: Define (Clock_next_entity).
1544  9846
1545  9846              Define_Clock_next_entity:
1546  9846
1547  9846 21 5A 95     	ld hl,Max_time_to_appear_entities
1548  9849 BE           	cp (hl)
1549  984A 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1550  984B
1551  984B 38 01        	jr c,1F
1552  984D
1553  984D              ;	Por encima o igual que (Max_time_to_appear_entities).
1554  984D              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1555  984D
1556  984D 4E           	ld c,(hl)
1557  984E
1558  984E              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1559  984E              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1560  984E
1561  984E 23           1 inc hl
1562  984F 23           	inc hl
1563  9850
1564  9850 BE           	cp (hl)
1565  9851
