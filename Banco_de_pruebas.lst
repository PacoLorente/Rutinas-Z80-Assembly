 299  8C1B              ; Movimiento. ------------------------------------------------------------------------------------------------------
 300  8C1B
 301  8C1B 00 00        Puntero_indice_mov defw 0							    ; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 302  8C1D 00 00        Puntero_mov defw 0										; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 303  8C1F 00 00        Puntero_indice_mov_bucle defw 0							;
 304  8C21              ;
 305  8C21              ;
 306  8C21 00           Incrementa_puntero db 0									; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 307  8C22              ;														; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 308  8C22              ;														; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 309  8C22 00           Incrementa_puntero_backup db 0
 310  8C23 00           Repetimos_desplazamiento db 0							; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 311  8C24              ;														; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 312  8C24 00           Repetimos_desplazamiento_backup db 0					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 313  8C25 00           Repetimos_movimiento db 0								; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 314  8C26 00           Cola_de_desplazamiento db 0								; Este byte indica:
 315  8C27              ;
 316  8C27              ;														;	"$00" ..... Hemos finalizado la cadena de movimiento.
 317  8C27              ;														;				En este caso hemos de incrementar (Puntero_indice_mov)_
 318  8C27              ;														;				_ y pasar a la siguiente cadena de movimiento del índice.
 319  8C27              ;
 320  8C27              ;														;	"$01 - "$fe" ..... Repetición del movimiento.
 321  8C27              ;														;						Nº de veces que vamos a repetir el movimiento completo.
 322  8C27              ;														;						En este caso, volveremos a inicializar (Puntero_mov),_
 323  8C27              ;														;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 324  8C27              ;
 325  8C27              ;														;	"$ff" ..... Bucle infinito de repetición.
 326  8C27              ;														;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 327  8C27              ;														;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 328  8C27
 329  8C27 00           Ctrl_1 db 0 											; Byte de control de propósito general.
 330  8C28
 331  8C28              ;														DESCRIPCIÓN:
 332  8C28              ;
 333  8C28              ;														BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 334  8C28              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 335  8C28              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 336  8C28              ;														BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 337  8C28              ;														BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 338  8C28              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 339  8C28
 340  8C28              ;														BIT 3, Recarga de nueva oleada.
 341  8C28              ;														BIT 4, Recarga de nueva oleada.
 342  8C28              ;														BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 343  8C28              ;														BIT 6, **** Frame completo.
 344  8C28              ;														BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 345  8C28
 346  8C28 00 00        Repone_puntero_objeto defw 0							; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 347  8C2A              ; 														; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 348  8C2A              ; 														; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 349  8C2A              ;														; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 350  8C2A
 351  8C2A              ; Gestión de ENTIDADES y CAJAS.
 352  8C2A
 353  8C2A 00 00        Puntero_store_caja defw 0
 354  8C2C 00 00        Puntero_restore_caja defw 0
 355  8C2E 00 00        Indice_restore_caja defw 0
 356  8C30 00 00        Puntero_indice_master defw 0
