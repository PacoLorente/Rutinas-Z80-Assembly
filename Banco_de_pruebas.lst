 249  91B7              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 91B7
   2+ 91B7
   3+ 91B7              ;   07/07/23
   4+ 91B7              ;
   5+ 91B7              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 91B7              ;
   7+ 91B7              ;   Codificación:
   8+ 91B7              ;
   9+ 91B7              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 91B7              ;
  11+ 91B7              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 91B7              ;
  13+ 91B7              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 91B7              ;
  15+ 91B7              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 91B7              ;
  17+ 91B7              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 91B7              ;                               ..... %01000010 Vel_up 4
  19+ 91B7              ;                                               Vel_down 2
  20+ 91B7              ;                               ..... $42
  21+ 91B7              ;
  22+ 91B7              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 91B7              ;
  24+ 91B7              ;                               ..... %01000010 Vel_left 4
  25+ 91B7              ;                                               Vel_right 2
  26+ 91B7              ;                               ..... $42
  27+ 91B7              ;
  28+ 91B7              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 91B7              ;
  30+ 91B7              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 91B7              ;
  32+ 91B7              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 91B7              ;
  34+ 91B7              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 91B7              ;                                     $53
  36+ 91B7              ;
  37+ 91B7              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 91B7              ;
  39+ 91B7              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 91B7              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 91B7              ;
  42+ 91B7              ;                       Arriba ..... $81
  43+ 91B7              ;                       Arriba - izquierda ..... $a1
  44+ 91B7              ;                       Arriba - derecha ..... $91
  45+ 91B7              ;
  46+ 91B7              ;                       Abajo ..... $41
  47+ 91B7              ;                       Abajo - izquierda ..... $61
  48+ 91B7              ;                       Abajo - derecha ..... $51
  49+ 91B7              ;
  50+ 91B7              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 91B7              ;
  52+ 91B7              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 91B7              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 91B7              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 91B7              ;
  56+ 91B7              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 91B7              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 91B7              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 91B7              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 91B7              ;
  61+ 91B7              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 91B7              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 91B7              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 91B7              ;
  65+ 91B7              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 91B7              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 91B7              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 91B7              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 91B7
  70+ 91B7              ; ----- ----- ----- ----- -----
  71+ 91B7              ;
