   1+ A54F              ; *********************************** Limpia la pantalla, CLEAR SCREEN ****************************************************************
   2+ A54F              ;
   3+ A54F              ;
   4+ A54F              ;	CLS.
   5+ A54F              ;
   6+ A54F              ;	Limpia la pantalla y define sus atributos.
   7+ A54F              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A54F              ;
   9+ A54F              ;	COLORES: 0 ..... NEGRO
  10+ A54F              ;    		 1 ..... AZUL
  11+ A54F              ; 			 2 ..... ROJO
  12+ A54F              ;			 3 ..... MAGENTA
  13+ A54F              ; 			 4 ..... VERDE
  14+ A54F              ; 			 5 ..... CIAN
  15+ A54F              ;			 6 ..... AMARILLO
  16+ A54F              ; 			 7 ..... BLANCO
  17+ A54F              ;
  18+ A54F              ;	INPUT: A contiene los atributos de pantalla.
  19+ A54F              ;
  20+ A54F              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A54F
  22+ A54F
  23+ A54F 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A552 11 01 40     	LD DE,$4001
  25+ A555 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A558 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A55A ED B0        	LDIR
  28+ A55C 01 FF 02     	LD BC,767
  29+ A55F 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A560 ED B0        	LDIR
  31+ A562
  32+ A562 AF           	xor a
  33+ A563
  34+ A563 C9           	ret
  35+ A564
