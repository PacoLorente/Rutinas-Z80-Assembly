 592+ B463 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B465 6F               ld l,a
 594+ B466 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B467
 596+ B467 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B468 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B46A 67               ld h,a
 599+ B46B C9               ret
