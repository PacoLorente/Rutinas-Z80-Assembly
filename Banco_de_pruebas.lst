 229+ C2E8
 230+ C2E8 0C               inc c                                    ; Indica que a partir de ahora se imprimen todos los "0".
 231+ C2E9
 232+ C2E9              Next_digit:
 233+ C2E9
 234+ C2E9 13               inc de                                   ; Siguiente char del msg. que estamos creando.
