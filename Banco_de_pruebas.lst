 311  8F2F 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 312  8F30 00           Cola_de_desplazamiento db 0									; Este byte indica:
 313  8F31
 314  8F31              ;
 315  8F31              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8F31              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8F31              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8F31              ;
 319  8F31              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8F31              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 321  8F31              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8F31              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 323  8F31              ;
 324  8F31              ;															;	"$ff" ..... Bucle infinito de repetición.
 325  8F31              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 326  8F31              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
