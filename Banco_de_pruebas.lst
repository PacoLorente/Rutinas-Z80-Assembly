 273+ C130
 274+ C130              ; ----- ----- ----- ----- -----
 275+ C130              ;
 276+ C130              ;   23/9/26
 277+ C130              ;
 278+ C130              ;   El efecto del disparo de Amadeus es de tipo descendente.
 279+ C130              ;
 280+ C130              ;   HL define el sonido.
 281+ C130              ;
 282+ C130              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 283+ C130              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 284+ C130              ;
 285+ C130              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 286+ C130              ;   _ escudo tienen prioridad sobre este efecto.
 287+ C130              ;
 288+ C130              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 289+ C130              ;
 290+ C130              ;   INPUTS: (Shot_sound) <> "0".
 291+ C130              ;
 292+ C130              ;   MODIFY: AF, HL y BC.
 293+ C130              ;
 294+ C130              ;   OUTPUT: (Shot_sound) actualizado.
 295+ C130
 296+ C130              Play_shot_sound_effect:
 297+ C130
 298+ C130              ;   Exclusiones:
 299+ C130
 300+ C130 2A E9 94         ld hl,(Shot_sound)
 301+ C133 7C               ld a,h
 302+ C134 B5               or l
 303+ C135 C8               ret z                   ; RET si no se ha producido disparo.
 304+ C136
 305+ C136 3A BB 94         ld a,(Ctrl_6)
 306+ C139 CB 47            bit 0,a
 307+ C13B C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 308+ C13C
 309+ C13C 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 310+ C13E
 311+ C13E              Loop_1:
 312+ C13E
 313+ C13E 3E 10            ld a,%00010000          ; Borde negro.
 314+ C140 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 315+ C142
 316+ C142 45               ld b,l
 317+ C143
 318+ C143 10 FE        Delay_3 djnz Delay_3
 319+ C145
 320+ C145 AF               xor a                   ; Borde negro.
 321+ C146 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 322+ C148
 323+ C148 45               ld b,l
 324+ C149
 325+ C149 10 FE        Delay_4 djnz Delay_4
 326+ C14B
 327+ C14B              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 328+ C14B
 329+ C14B 2C               inc l
 330+ C14C 2C               inc l
 331+ C14D 2C               inc l
 332+ C14E 2C               inc l
