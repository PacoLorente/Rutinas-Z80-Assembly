   5+ 98B9              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 98B9              ;   (XOR) bit a bit.
   7+ 98B9              ;
   8+ 98B9              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 98B9              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 98B9
  11+ 98B9              Derivando_RND
  12+ 98B9
  13+ 98B9 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 98BB C5               push bc
  15+ 98BC              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 98BC 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 98BF              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 98BF
  19+ 98BF A7           6 and a                                 ; Carry a "0".
  20+ 98C0 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 98C2 30 02            jr nc,1F
  22+ 98C4
  23+ 98C4 CB C1            set 0,c
  24+ 98C6
  25+ 98C6 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 98C7 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 98C9 5F               ld e,a
  28+ 98CA
  29+ 98CA 7A               ld a,d
  30+ 98CB E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 98CD 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 98CF
  33+ 98CF CB 3F            srl a
  34+ 98D1
  35+ 98D1 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 98D2
  37+ 98D2 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 98D3 28 04            jr z,4F
  39+ 98D5
  40+ 98D5 CB FF            set 7,a
  41+ 98D7 18 02            jr 5F
  42+ 98D9
  43+ 98D9 CB BF        4 res 7,a
  44+ 98DB
  45+ 98DB CB 21        5 sla c
  46+ 98DD 10 E0            djnz 6B
  47+ 98DF
  48+ 98DF 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 98E0
  50+ 98E0 77               ld (hl),a
  51+ 98E1 23               inc hl
  52+ 98E2 C1               pop bc
  53+ 98E3 10 D4            djnz 3B
  54+ 98E5
  55+ 98E5 C9               ret
