   1+ 9D23              ; ******************************************************************************************************************************************************************************************
   2+ 9D23              ;
   3+ 9D23              ;   3/4/25
   4+ 9D23              ;
   5+ 9D23              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D23              ;   (XOR) bit a bit.
   7+ 9D23              ;
   8+ 9D23              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D23              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D23
  11+ 9D23              Derivando_RND
  12+ 9D23
  13+ 9D23 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D25 C5               push bc
  15+ 9D26              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D26 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D29              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D29
  19+ 9D29 A7           6 and a                                 ; Carry a "0".
  20+ 9D2A CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D2C 30 02            jr nc,1F
  22+ 9D2E
  23+ 9D2E CB C1            set 0,c
  24+ 9D30
  25+ 9D30 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D31 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D33 5F               ld e,a
  28+ 9D34
  29+ 9D34 7A               ld a,d
  30+ 9D35 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
