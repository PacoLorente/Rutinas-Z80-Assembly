 305  8E51              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8E51
 307  8E51 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8E52 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8E53 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8E54
 311  8E54              ;
 312  8E54              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8E54              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8E54              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8E54              ;
 316  8E54              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8E54              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8E54              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8E54              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8E54              ;
 321  8E54              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8E54              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8E54              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8E54
