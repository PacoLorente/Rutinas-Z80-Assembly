   1+ A037              ; ******************************************************************************************************************************************************************************************
   2+ A037              ;
   3+ A037              ;   3/4/25
   4+ A037              ;
   5+ A037              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A037              ;   (XOR) bit a bit.
   7+ A037              ;
   8+ A037              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A037              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A037
  11+ A037              Derivando_RND
  12+ A037
  13+ A037 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A039 C5               push bc
  15+ A03A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A03A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A03D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A03D
  19+ A03D A7           6 and a                                 ; Carry a "0".
  20+ A03E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A040 30 02            jr nc,1F
  22+ A042
  23+ A042 CB C1            set 0,c
  24+ A044
  25+ A044 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A045 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A047 5F               ld e,a
  28+ A048
  29+ A048 7A               ld a,d
  30+ A049 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A04B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A04D
  33+ A04D CB 3F            srl a
  34+ A04F
  35+ A04F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A050
  37+ A050 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A051 28 04            jr z,4F
  39+ A053
  40+ A053 CB FF            set 7,a
  41+ A055 18 02            jr 5F
  42+ A057
  43+ A057 CB BF        4 res 7,a
  44+ A059
  45+ A059 CB 21        5 sla c
  46+ A05B 10 E0            djnz 6B
  47+ A05D
  48+ A05D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A05E
  50+ A05E 77               ld (hl),a
  51+ A05F 23               inc hl
  52+ A060 C1               pop bc
  53+ A061 10 D4            djnz 3B
  54+ A063
  55+ A063 C9               ret
  56+ A064
  57+ A064
  58+ A064
