   5+ 9D4D              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D4D              ;   (XOR) bit a bit.
   7+ 9D4D              ;
   8+ 9D4D              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D4D              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D4D
  11+ 9D4D              Derivando_RND
  12+ 9D4D
  13+ 9D4D ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D4F C5               push bc
  15+ 9D50              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D50 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D53              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D53
  19+ 9D53 A7           6 and a                                 ; Carry a "0".
  20+ 9D54 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D56 30 02            jr nc,1F
  22+ 9D58
  23+ 9D58 CB C1            set 0,c
  24+ 9D5A
  25+ 9D5A 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D5B E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D5D 5F               ld e,a
  28+ 9D5E
  29+ 9D5E 7A               ld a,d
  30+ 9D5F E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D61 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D63
  33+ 9D63 CB 3F            srl a
  34+ 9D65
  35+ 9D65 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D66
  37+ 9D66 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D67 28 04            jr z,4F
  39+ 9D69
  40+ 9D69 CB FF            set 7,a
  41+ 9D6B 18 02            jr 5F
  42+ 9D6D
  43+ 9D6D CB BF        4 res 7,a
  44+ 9D6F
  45+ 9D6F CB 21        5 sla c
  46+ 9D71 10 E0            djnz 6B
  47+ 9D73
  48+ 9D73 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D74
  50+ 9D74 77               ld (hl),a
  51+ 9D75 23               inc hl
  52+ 9D76 C1               pop bc
  53+ 9D77 10 D4            djnz 3B
  54+ 9D79
  55+ 9D79 C9               ret
  56+ 9D7A
  57+ 9D7A
  58+ 9D7A
