 579+ C3F1              ; -----------------------------------------------------------------------------------------------------------
 580+ C3F1              ;
 581+ C3F1              ;   17/10/26
 582+ C3F1              ;
 583+ C3F1              ;   Asigna un nuevo KEYCODE y sustituye al contenido en la variable MOVE_xxx, (al que apunta H)L.
 584+ C3F1              ;   Nueva tecla para la función de movimiento, (KEYBOARD) a la que apunta HL.
 585+ C3F1              ;
 586+ C3F1              ;   Move_LEFT db $24
 587+ C3F1              ;   Move_RIGHT db $1c
 588+ C3F1              ;   Move_FIRE db $04
 589+ C3F1              ;   Move_SHIELD db $20
 590+ C3F1              ;
 591+ C3F1              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 592+ C3F1              ;
 593+ C3F1              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 594+ C3F1              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 595+ C3F1              ;
 596+ C3F1              ;   Special keys:
 597+ C3F1              ;
 598+ C3F1              ;   Symbol_key defm "SYMB.",0
 599+ C3F1              ;   Space_key defm "SPACE",0
 600+ C3F1              ;   Enter_key defm "ENTER",0
 601+ C3F1              ;   Caps_key defm "CAPS.",0
 602+ C3F1              ;
 603+ C3F1              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 604+ C3F1              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 605+ C3F1              ;
 606+ C3F1              ;           (No_repeat_key_code) contiene el n° de teclas YA DEFINIDAS.
 607+ C3F1              ;
 608+ C3F1              ;   MODIFY: AF, HL, BC y DE.
 609+ C3F1              ;
 610+ C3F1              ;   OUTPUT: (A) = "0".
 611+ C3F1
 612+ C3F1              Define_key:
 613+ C3F1
 614+ C3F1 E5               push hl                                                 ; PUSH Puntero KEYCODE.
 615+ C3F2 D5               push de                                                 ; PUSH Puntero ASCII_CODE.
 616+ C3F3
