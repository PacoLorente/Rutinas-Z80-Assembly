 587+ AE0F
 588+ AE0F 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ AE10 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ AE12 67               ld h,a
