  11+ 99FE              ; 			 2 ..... ROJO
  12+ 99FE              ;			 3 ..... MAGENTA
  13+ 99FE              ; 			 4 ..... VERDE
  14+ 99FE              ; 			 5 ..... CIAN
  15+ 99FE              ;			 6 ..... AMARILLO
  16+ 99FE              ; 			 7 ..... BLANCO
  17+ 99FE              ;
  18+ 99FE              ;	INPUT: A contiene los atributos de pantalla.
  19+ 99FE              ;
  20+ 99FE              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 99FE
  22+ 99FE
  23+ 99FE 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ 9A01 11 01 40     	LD DE,$4001
  25+ 9A04 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 9A07 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 9A09 ED B0        	LDIR
  28+ 9A0B 01 FF 02     	LD BC,767
  29+ 9A0E 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 9A0F ED B0        	LDIR
  31+ 9A11 C9           	ret
  32+ 9A12
