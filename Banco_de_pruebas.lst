 583+ A6E1 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A6E2 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A6E4 6F               ld l,a
 586+ A6E5 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A6E6
 588+ A6E6 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A6E7 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A6E9 67               ld h,a
 591+ A6EA C9               ret
