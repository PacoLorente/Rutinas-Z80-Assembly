 305  8DD6              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8DD6
 307  8DD6 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8DD7 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8DD8 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8DD9
 311  8DD9              ;
 312  8DD9              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8DD9              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8DD9              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8DD9              ;
 316  8DD9              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8DD9              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8DD9              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8DD9              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8DD9              ;
 321  8DD9              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8DD9              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8DD9              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8DD9
