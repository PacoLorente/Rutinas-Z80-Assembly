 302  8F13              ;
 303  8F13              ;
 304  8F13 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 305  8F14              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
