 809  D10C
 810  D10C              ;	Por DEBAJO de (Min_time_to_appear_entities).
 811  D10C
 812  D10C 4E           	ld c,(hl)
 813  D10D
 814  D10D 3A 78 5C     2 ld a,(FRAMES)
