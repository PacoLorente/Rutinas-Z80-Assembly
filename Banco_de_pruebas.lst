   5+ 9998              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9998              ;   (XOR) bit a bit.
   7+ 9998              ;
   8+ 9998              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9998              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9998
  11+ 9998              Derivando_RND
  12+ 9998
  13+ 9998 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 999A C5               push bc
  15+ 999B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 999B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 999E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 999E
  19+ 999E A7           6 and a                                 ; Carry a "0".
  20+ 999F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99A1 30 02            jr nc,1F
  22+ 99A3
  23+ 99A3 CB C1            set 0,c
  24+ 99A5
  25+ 99A5 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99A6 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99A8 5F               ld e,a
  28+ 99A9
  29+ 99A9 7A               ld a,d
  30+ 99AA E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99AC 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99AE
  33+ 99AE CB 3F            srl a
  34+ 99B0
  35+ 99B0 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99B1
  37+ 99B1 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99B2 28 04            jr z,4F
  39+ 99B4
  40+ 99B4 CB FF            set 7,a
  41+ 99B6 18 02            jr 5F
  42+ 99B8
  43+ 99B8 CB BF        4 res 7,a
  44+ 99BA
  45+ 99BA CB 21        5 sla c
  46+ 99BC 10 E0            djnz 6B
  47+ 99BE
  48+ 99BE 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99BF
  50+ 99BF 77               ld (hl),a
  51+ 99C0 23               inc hl
  52+ 99C1 C1               pop bc
  53+ 99C2 10 D4            djnz 3B
  54+ 99C4
  55+ 99C4 C9               ret
  56+ 99C5
  57+ 99C5
  58+ 99C5
