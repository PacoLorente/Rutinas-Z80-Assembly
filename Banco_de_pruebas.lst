 431+ C128              ;   -------------------------------------------------------------------------------------------
 432+ C128              ;
 433+ C128              ;   23/9/26
 434+ C128              ;
 435+ C128              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C128              ;
 437+ C128              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C128              ;   _ [Sound_Generator].
 439+ C128              ;
 440+ C128              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C128              ;
 442+ C128              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C128              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C128              ;
 445+ C128              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C128              ;
 447+ C128              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C128              ;
 449+ C128              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C128
 451+ C128              Play_burst_sound_effect:
 452+ C128
 453+ C128              ;   Exclusiones:
 454+ C128
 455+ C128 3A 7E 94         ld a,(Burst_sound)
 456+ C12B A7               and a
 457+ C12C C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C12D
 459+ C12D 08               ex af,af
 460+ C12E
 461+ C12E 3A 4F 94         ld a,(Ctrl_6)
 462+ C131 CB 47            bit 0,a
 463+ C133 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C134
 465+ C134              ;   ----------------------
 466+ C134
 467+ C134 CB C7            set 0,a
 468+ C136 32 4F 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C139
 470+ C139 08               ex af,af                ; Restore (Burst_sound).
 471+ C13A
 472+ C13A 67               ld h,a
 473+ C13B 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C13D
 475+ C13D E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C13E
 477+ C13E 22 78 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C141 0E 03            ld c,3
 479+ C143 CD 20 9F         call Noise_efect
 480+ C146
 481+ C146 D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C147
 483+ C147 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C148 94               sub h
 485+ C149
 486+ C149 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C14B
 488+ C14B 7C               ld a,h
 489+ C14C 32 7E 94         ld (Burst_sound),a
 490+ C14F
 491+ C14F C9               ret
 492+ C150
