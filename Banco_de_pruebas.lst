 416+ C188
 417+ C188 AF               xor a
 418+ C189 32 EB 94         ld (Burst_sound),a
 419+ C18C
 420+ C18C 3A BB 94         ld a,(Ctrl_6)
 421+ C18F CB 87            res 0,a
 422+ C191 32 BB 94         ld (Ctrl_6),a
 423+ C194
 424+ C194 C9               ret
