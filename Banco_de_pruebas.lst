   1+ 9D3D              ; ******************************************************************************************************************************************************************************************
   2+ 9D3D              ;
   3+ 9D3D              ;   3/4/25
   4+ 9D3D              ;
   5+ 9D3D              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D3D              ;   (XOR) bit a bit.
   7+ 9D3D              ;
   8+ 9D3D              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D3D              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D3D
  11+ 9D3D              Derivando_RND
  12+ 9D3D
  13+ 9D3D ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D3F C5               push bc
  15+ 9D40              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D40 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D43              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D43
  19+ 9D43 A7           6 and a                                 ; Carry a "0".
  20+ 9D44 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D46 30 02            jr nc,1F
  22+ 9D48
