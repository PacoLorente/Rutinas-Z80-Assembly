 432+ A3FE 3A 18 94     	ld a,(Tipo)
 433+ A401 CD 39 A6     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
