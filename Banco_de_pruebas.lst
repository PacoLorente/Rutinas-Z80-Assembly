 435+ ACFB E5           	push hl															; Push (Puntero_de_entidades).
 436+ ACFC C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 437+ ACFD
 438+ ACFD              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 439+ ACFD
