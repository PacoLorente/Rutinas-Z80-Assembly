# file opened: RND_Derivando.asm
   1+ 9495              ; ******************************************************************************************************************************************************************************************
   2+ 9495              ;
   3+ 9495              ;   3/4/25
   4+ 9495              ;
   5+ 9495              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9495              ;   (XOR) bit a bit.
   7+ 9495              ;
   8+ 9495              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9495              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9495
  11+ 9495              Derivando_RND
  12+ 9495
  13+ 9495 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9497 C5               push bc
  15+ 9498              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9498 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 949B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 949B
  19+ 949B A7           6 and a                                 ; Carry a "0".
  20+ 949C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 949E 30 02            jr nc,1F
  22+ 94A0
  23+ 94A0 CB C1            set 0,c
  24+ 94A2
  25+ 94A2 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94A3 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94A5 5F               ld e,a
  28+ 94A6
  29+ 94A6 7A               ld a,d
  30+ 94A7 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94A9 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94AB
