 268  8C5C
 269  8C5C 00 00        Posicion_inicio defw 0									; Dirección de pantalla donde aparece el objeto. [DRAW].
 270  8C5E 00           Cuad_objeto db 0										; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 271  8C5F 00           Columnas db 0
 272  8C60
 273  8C60              ;Limite_horizontal db 0	 								; Dirección de pantalla, (scanline), calculado en función del tamaño del Sprite. Si el objeto llega a esta línea se modifica_
 274  8C60              ; 														; _(Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 275  8C60 00           Limite_vertical db 0 									; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
