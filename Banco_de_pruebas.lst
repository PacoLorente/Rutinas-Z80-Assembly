   6+ 9996
   7+ 9996              Draw
   8+ 9996
   9+ 9996 CD 2B 9C     	call Prepara_draw
  10+ 9999 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 999A A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 999B 28 05        	jr z,2F
  13+ 999D
  14+ 999D 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99A0 18 0C        	jr 1F
  16+ 99A2
  17+ 99A2              ;	Inicia entidad.
  18+ 99A2
  19+ 99A2 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99A5 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99A8 CD 33 9B     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  22+ 99AB              ;													; _la esquina superior izquierda de la pantalla.
  23+ 99AB CD C1 A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  24+ 99AE
  25+ 99AE 3A F7 8B     1 ld a,(Ctrl_0)
  26+ 99B1 CB 6F        	bit 5,a
  27+ 99B3 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  28+ 99B5
  29+ 99B5 CD CA 99     	call Comprueba_limite_horizontal
  30+ 99B8 CD 5A 9A     	call Comprueba_limite_vertical
  31+ 99BB
  32+ 99BB              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  33+ 99BB              ; -----------------------
  34+ 99BB              ; -----------------------
  35+ 99BB              ; -----------------------
  36+ 99BB
  37+ 99BB CD AF 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  38+ 99BE CD D3 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  39+ 99C1
  40+ 99C1 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina REStauramos el bit5 de Ctrl_0 para que nos vuelva_
  41+ 99C4 CB AF        	res 5,a											; _a ser de utilidad.
  42+ 99C6 32 F7 8B     	ld (Ctrl_0),a
  43+ 99C9
  44+ 99C9 C9           	ret
