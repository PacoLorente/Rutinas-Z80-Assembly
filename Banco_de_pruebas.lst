 370+ A369              ;
 371+ A369              ;   9/9/26
 372+ A369              ;
 373+ A369              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 374+ A369              ;
 375+ A369              ;	INPUTS:		B contiene (Numero_de_entidades).
 376+ A369              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 377+ A369              ; 				HL contiene (Puntero_de_entidades).
 378+ A369
 379+ A369              Prepara_Cajas_Master:
 380+ A369
 381+ A369 E5           	push hl															; Push (Puntero_de_entidades).
 382+ A36A C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A36B
 384+ A36B              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A36B
 386+ A36B 79           	ld a,c
 387+ A36C 08           	ex af,af
 388+ A36D 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A36E
 390+ A36E CD 94 A5     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 391+ A371              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A371              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A371 A7           	and a
 394+ A372 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A374
 396+ A374              ; Generamos movimientos masticados.
 397+ A374
 398+ A374              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A374
 400+ A374 79           	ld a,c 															; (A) = (Clase).
 401+ A375 32 D9 93     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A378
 403+ A378 CD 6D A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A37B CD FF A6     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A37E
 406+ A37E              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 407+ A37E              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 408+ A37E              ;	coreografías distintas.
 409+ A37E
 410+ A37E 06 07        	ld b,7
 411+ A380 21 07 90     	ld hl,Numeros_aleatorios_baile
 412+ A383 CD 99 9D     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 413+ A386
 414+ A386              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 415+ A386
 416+ A386 3A DA 93     	ld a,(Tipo)
 417+ A389 CD C1 A5     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 418+ A38C CD 13 A5     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 419+ A38F
 420+ A38F              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 421+ A38F
 422+ A38F C1           	pop bc
 423+ A390 E1           	pop hl
 424+ A391
 425+ A391 E5           	push hl															; Push (Puntero_de_entidades).
 426+ A392 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 427+ A393
 428+ A393              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 429+ A393
 430+ A393 CD D0 A3     	call Determina_posicion_de_inicio 								; $941e ($78),($76),($72)
 431+ A396
 432+ A396 3A DA 93     	ld a,(Tipo)
 433+ A399 CD D1 A5     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
 434+ A39C
 435+ A39C              ;	Ya disponemos de una (Posicion_inicio) aleatoria y la definición de la entidad en la "Bandeja DRAW".
 436+ A39C              ;	Generamos "Movimientos masticados" de la entidad.
 437+ A39C
 438+ A39C CD 95 A4     	call Construye_movimientos_masticados_entidad
