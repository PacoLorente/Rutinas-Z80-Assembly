 179+ C0B0
 180+ C0B0 0E 14        	ld c,$14                                                ; Duración de la nueva nota.
 181+ C0B2 2E FA        	ld l,$fa                                                ; New note, (HL) = $00fa
 182+ C0B4              ;                                                           ; (E) = $00, no existe decremento. (sonido plano).
 183+ C0B4 22 06 96     	ld (Sound),hl
 184+ C0B7 CD 67 9F         call Sound_Generator 									; Ejecuta nota.
 185+ C0BA
 186+ C0BA              Note_5:
 187+ C0BA
 188+ C0BA 0E 21        	ld c,$21                                                ; Duración de la nueva nota.
 189+ C0BC 2E B7        	ld l,$b7                                                ; New note, (HL) = $00b7
 190+ C0BE              ;                                                           ; (E) = $00, no existe decremento. (sonido plano).
 191+ C0BE 22 06 96     	ld (Sound),hl
 192+ C0C1 CD 67 9F         call Sound_Generator 									; Ejecuta nota.
 193+ C0C4
 194+ C0C4              Pause_2:
 195+ C0C4
 196+ C0C4 01 00 40         ld bc,$4000
 197+ C0C7 CD 3A 9B     	call DELAY 												; PAUSE.
 198+ C0CA
 199+ C0CA              Note_6:
 200+ C0CA
 201+ C0CA 0E 14            ld c,$14                                                ; Duración de la nueva nota.
 202+ C0CC 2E FA        	ld l,$fa                                                ; New note, (HL) = $00fa
 203+ C0CE              ;                                                           ; (E) = $00, no existe decremento. (sonido plano).
 204+ C0CE 22 06 96     	ld (Sound),hl
 205+ C0D1 CD 67 9F         call Sound_Generator 			                        ; PLAY NOTE.
 206+ C0D4
 207+ C0D4              Note_7:
 208+ C0D4
 209+ C0D4 0E 24        	ld c,$24                                                ; Duración de la nueva nota.
 210+ C0D6 2E CD        	ld l,$cd                                                ; New note, (HL) = $00cd
 211+ C0D8              ;                                                           ; (E) = $00, no existe decremento. (sonido plano).
 212+ C0D8 22 06 96     	ld (Sound),hl
 213+ C0DB CD 67 9F         call Sound_Generator 									; PLAY NOTE.
 214+ C0DE
 215+ C0DE              Nota_8:
 216+ C0DE
 217+ C0DE 0E 2D            ld c,$2d                                                ; Duración de la nueva nota.
 218+ C0E0 11 01 01         ld de,$0101                                             ; Nota ascendente / 1 unid. increase..
 219+ C0E3              ;                                                           ; (HL) sigue siendo $00cd, (subirá hasta la siguiente nota).
 220+ C0E3 22 06 96         ld (Sound),hl
 221+ C0E6 CD 67 9F         call Sound_Generator                                    ; Down to Note_9: / PLAY NOTE.
 222+ C0E9
 223+ C0E9              Pause_3:
 224+ C0E9
 225+ C0E9 01 00 10         ld bc,$1000
 226+ C0EC CD 3A 9B     	call DELAY 												; PAUSE.
 227+ C0EF
 228+ C0EF              Note_9:
