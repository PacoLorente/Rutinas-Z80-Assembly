 394+ ACD8
 395+ ACD8              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 396+ ACD8
 397+ ACD8 79           	ld a,c
 398+ ACD9 08           	ex af,af
 399+ ACDA 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 400+ ACDB
 401+ ACDB CD FC AE     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 402+ ACDE              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 403+ ACDE              ; 																	; Saltaremos a la siguiente entidad del nivel.
 404+ ACDE A7           	and a
 405+ ACDF 20 41        	jr nz, Avanza_siguiente_entidad_del_nivel
