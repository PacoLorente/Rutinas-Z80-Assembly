 582+ B058
 583+ B058 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B059 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B05B 6F               ld l,a
 586+ B05C D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B05D
 588+ B05D 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B05E D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B060 67               ld h,a
 591+ B061 C9               ret
