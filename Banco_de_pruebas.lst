 780+ B5A8              ;
 781+ B5A8              ;	5/08/22
 782+ B5A8              ;
 783+ B5A8              ;   NextScan.
 784+ B5A8              ;
 785+ B5A8              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B5A8              ;
 787+ B5A8              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B5A8              ;
 789+ B5A8              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B5A8              ;
 791+ B5A8              ;       DESTRUIDOS: AF y HL !!!
 792+ B5A8              ;
 793+ B5A8              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B5A8              ;
 795+ B5A8
 796+ B5A8              NextScan:
 797+ B5A8
 798+ B5A8 24           	inc h          							; Incrementamos el scanline.
 799+ B5A9 7C               ld a,h
 800+ B5AA E6 07            and 7
 801+ B5AC C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B5AD
 803+ B5AD 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B5AE C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B5B0 6F               ld l,a
 806+ B5B1 D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B5B2
 808+ B5B2 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B5B3 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B5B5 67               ld h,a
 811+ B5B6 C9               ret
 812+ B5B7
 813+ B5B7              NextScan_15:
 814+ B5B7
 815+ B5B7 06 0F        	ld b,15
 816+ B5B9 CD A8 B5     1 call NextScan
 817+ B5BC 10 FB        	djnz 1B
 818+ B5BE
 819+ B5BE C9           	ret
 820+ B5BF
 821+ B5BF              ;----------------------------------------------------------------------------------------------------------------
 822+ B5BF              ;
 823+ B5BF              ;	5/08/22
 824+ B5BF              ;
 825+ B5BF              ;   PreviousScan.
 826+ B5BF              ;
 827+ B5BF              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B5BF              ;
 829+ B5BF              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B5BF              ;
 831+ B5BF              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B5BF              ;
 833+ B5BF              ;       DESTRUIDOS: AF y HL !!!
 834+ B5BF              ;
 835+ B5BF              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B5BF              ;
 837+ B5BF
 838+ B5BF              PreviousScan:
 839+ B5BF
 840+ B5BF 7C           	ld a,h
 841+ B5C0 25               dec h               							; Dec H.
 842+ B5C1 E6 07            and 7
 843+ B5C3 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B5C4
 845+ B5C4 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B5C5 D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B5C7 6F               ld l,a
 848+ B5C8 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B5C9
 850+ B5C9 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B5CA C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B5CC 67               ld h,a
 853+ B5CD C9               ret
 854+ B5CE
 855+ B5CE              PreviousScan_15:
 856+ B5CE
 857+ B5CE 06 0F        	ld b,15
 858+ B5D0 CD BF B5     1 call PreviousScan
 859+ B5D3 10 FB        	djnz 1B
 860+ B5D5
 861+ B5D5 C9           	ret
