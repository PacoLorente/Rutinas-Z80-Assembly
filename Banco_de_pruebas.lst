 564+ B1C7              ;
 565+ B1C7              ;   NextScan.
 566+ B1C7              ;
 567+ B1C7              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ B1C7              ;
 569+ B1C7              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ B1C7              ;
 571+ B1C7              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ B1C7              ;
 573+ B1C7              ;       DESTRUIDOS: AF y HL !!!
 574+ B1C7              ;
 575+ B1C7              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ B1C7              ;
 577+ B1C7
 578+ B1C7 24           NextScan inc h          							; Incrementamos el scanline.
 579+ B1C8 7C               ld a,h
 580+ B1C9 E6 07            and 7
 581+ B1CB C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ B1CC
 583+ B1CC 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1CD C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1CF 6F               ld l,a
 586+ B1D0 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1D1
 588+ B1D1 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1D2 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1D4 67               ld h,a
 591+ B1D5 C9               ret
 592+ B1D6
 593+ B1D6              ;----------------------------------------------------------------------------------------------------------------
 594+ B1D6              ;
 595+ B1D6              ;	5/08/22
 596+ B1D6              ;
 597+ B1D6              ;   PreviousScan.
 598+ B1D6              ;
 599+ B1D6              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 600+ B1D6              ;
 601+ B1D6              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ B1D6              ;
 603+ B1D6              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ B1D6              ;
 605+ B1D6              ;       DESTRUIDOS: AF y HL !!!
 606+ B1D6              ;
 607+ B1D6              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ B1D6              ;
 609+ B1D6
 610+ B1D6 7C           PreviousScan ld a,h
 611+ B1D7 25               dec h               							; Dec H.
 612+ B1D8 E6 07            and 7
 613+ B1DA C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ B1DB
 615+ B1DB 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B1DC D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B1DE 6F               ld l,a
 618+ B1DF D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ B1E0
 620+ B1E0 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ B1E1 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ B1E3 67               ld h,a
 623+ B1E4 C9               ret
