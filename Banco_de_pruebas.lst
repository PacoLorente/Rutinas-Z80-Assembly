   1+ 8A55
   2+ 8A55
   3+ 8A55              ;   07/07/23
   4+ 8A55              ;
   5+ 8A55              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8A55              ;
   7+ 8A55              ;   Codificación:
   8+ 8A55              ;
   9+ 8A55              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8A55              ;
  11+ 8A55              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8A55              ;
  13+ 8A55              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8A55              ;
  15+ 8A55              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8A55              ;
  17+ 8A55              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8A55              ;                               ..... %01000010 Vel_up 4
  19+ 8A55              ;                                               Vel_down 2
  20+ 8A55              ;                               ..... $42
  21+ 8A55              ;
  22+ 8A55              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8A55              ;
  24+ 8A55              ;                               ..... %01000010 Vel_left 4
  25+ 8A55              ;                                               Vel_right 2
  26+ 8A55              ;                               ..... $42
  27+ 8A55              ;
  28+ 8A55              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8A55              ;
  30+ 8A55              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8A55              ;
  32+ 8A55              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8A55              ;
  34+ 8A55              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8A55              ;                                     $53
  36+ 8A55              ;
  37+ 8A55              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8A55              ;
  39+ 8A55              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8A55              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8A55              ;
  42+ 8A55              ;                       Arriba ..... $81
  43+ 8A55              ;                       Arriba - izquierda ..... $a1
  44+ 8A55              ;                       Arriba - derecha ..... $91
  45+ 8A55              ;
  46+ 8A55              ;                       Abajo ..... $41
  47+ 8A55              ;                       Abajo - izquierda ..... $61
  48+ 8A55              ;                       Abajo - derecha ..... $51
  49+ 8A55              ;
  50+ 8A55              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8A55              ;
  52+ 8A55              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8A55              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8A55              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8A55              ;
  56+ 8A55              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8A55              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8A55              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8A55              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8A55              ;
  61+ 8A55              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8A55              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8A55              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8A55              ;
  65+ 8A55              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8A55              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8A55              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8A55              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8A55
