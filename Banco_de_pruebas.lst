 211+ C29D 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 212+ C29F
 213+ C29F D5           3 push de                                    ; PUSH Score_max_msg.
 214+ C2A0
 215+ C2A0 11 FD 94         ld de,Non_authorized_KEY_CODES+2         ; KEY_CODE numbers list.
