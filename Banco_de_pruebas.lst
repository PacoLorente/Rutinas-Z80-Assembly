 175+ C12A              Make_Score_max_msg:
 176+ C12A
 177+ C12A              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 178+ C12A
 179+ C12A              ;   Necesito fabricar un msg. con la máxima puntuación.
 180+ C12A              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 181+ C12A
 182+ C12A 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 183+ C12D 21 C7 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 184+ C130              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 185+ C130 11 D6 94         ld de,Score_max_msg
 186+ C133
 187+ C133              KEY_CODE_de_BCD:
 188+ C133
 189+ C133 7E           1 ld a,(hl)
 190+ C134 A7               and a
 191+ C135 20 07            jr nz,3F
 192+ C137
 193+ C137              ;   El dígito es "0".
 194+ C137
 195+ C137 0C               inc c
 196+ C138 0D               dec c
 197+ C139 20 03            jr nz,3F
 198+ C13B
 199+ C13B 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 200+ C13C 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 201+ C13E
 202+ C13E D5           3 push de                                    ; PUSH Score_max_msg.
 203+ C13F
 204+ C13F 11 E7 94         ld de,Non_authorized_KEY_CODES+2         ; KEY_CODE numbers list.
 205+ C142
 206+ C142 A7               and a
 207+ C143 28 04            jr z,4F
 208+ C145
 209+ C145 13           2 inc de
 210+ C146 3D               dec a
 211+ C147 20 FC            jr nz,2B                                 ; Nos situamos en el KEY_CODE correspondiente a este dígito.
 212+ C149
 213+ C149 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 214+ C14A
 215+ C14A D1               pop de                                   ; Score_max_msg en DE.
 216+ C14B
 217+ C14B CD 54 C1         call ASCII_CODE_de_KEYCODE
