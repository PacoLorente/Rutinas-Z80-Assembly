 372+ A3CF              ;
 373+ A3CF              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 374+ A3CF              ;
 375+ A3CF              ;	INPUTS:		B contiene (Numero_de_entidades).
 376+ A3CF              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 377+ A3CF              ; 				HL contiene (Puntero_de_entidades).
 378+ A3CF
 379+ A3CF              Prepara_Cajas_Master:
 380+ A3CF
 381+ A3CF E5           	push hl															; Push (Puntero_de_entidades).
 382+ A3D0 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A3D1
 384+ A3D1              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A3D1
 386+ A3D1 79           	ld a,c
 387+ A3D2 08           	ex af,af
 388+ A3D3 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A3D4
 390+ A3D4 CD FA A5     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 391+ A3D7              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A3D7              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A3D7 A7           	and a
 394+ A3D8 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A3DA
 396+ A3DA              ; Generamos movimientos masticados.
 397+ A3DA
 398+ A3DA              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A3DA
 400+ A3DA 79           	ld a,c 															; (A) = (Clase).
 401+ A3DB 32 17 94     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A3DE
 403+ A3DE CD D3 A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A3E1 CD 65 A7     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A3E4
 406+ A3E4              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 407+ A3E4              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 408+ A3E4              ;	coreografías distintas.
 409+ A3E4
 410+ A3E4 06 07        	ld b,7
 411+ A3E6 21 07 90     	ld hl,Numeros_aleatorios_baile
 412+ A3E9 CD FE A1     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 413+ A3EC
 414+ A3EC              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 415+ A3EC
 416+ A3EC 3A 18 94     	ld a,(Tipo)
 417+ A3EF CD 27 A6     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 418+ A3F2 CD 79 A5     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 419+ A3F5
 420+ A3F5              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 421+ A3F5
 422+ A3F5 C1           	pop bc
 423+ A3F6 E1           	pop hl
 424+ A3F7
 425+ A3F7 E5           	push hl															; Push (Puntero_de_entidades).
 426+ A3F8 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 427+ A3F9
 428+ A3F9              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 429+ A3F9
