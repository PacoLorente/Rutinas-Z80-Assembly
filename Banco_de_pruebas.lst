 795+ AFDD              ; ------------------------------------------------------------------------
 796+ AFDD              ;
 797+ AFDD              ;   26/10/26
 798+ AFDD              ;
 799+ AFDD              ;   Pinta un sprite de Amadeus en la parte superior izquierda de la pantalla. IT's a LIFE !!!
 800+ AFDD              ;
 801+ AFDD              ;   Los datos de pintado de la vida vienen dados por la tabla:
 802+ AFDD              ;
 803+ AFDD              ;   Tabla_marcador_de_vidas:
 804+ AFDD              ;
 805+ AFDD              ;	defw Vida_1,Amadeus       							; (Puntero_de_impresion), (Puntero_objeto)
 806+ AFDD              ;	defw Vida_2,Amadeus_Fb
 807+ AFDD              ;	defw Vida_3,Amadeus
 808+ AFDD              ;
 809+ AFDD              ;   (Puntero_de_vidas) almacenará el puntero SP que será el encargado de ir desplazandose por la tabla abasteciendo de datos_
 810+ AFDD              ;   _ a los registros HL y DE:
 811+ AFDD              ;
 812+ AFDD              ;    pop hl                                             ; Dirección de pantalla donde se imprime Vida_X, (Puntero_de_impresion).
 813+ AFDD              ;    pop de                                             ; Dirección de memoria donde se encuentran los .db que componen Amadeus, (Puntero_objeto).
 814+ AFDD              ;
 815+ AFDD              ;   Al ser el n° de (Columnas/Filas) una constante, ($0302) lo cargamos directamente en el par de registros (BC).
 816+ AFDD              ;   Los attrs. serían la 2a constante que será almacenada en (A).
 817+ AFDD              ;
 818+ AFDD              ;   Con estos datos, la rutina [Pinta_imagen] imprimirá la imagen en la parte superior izquierda de la pantalla.
 819+ AFDD              ;
 820+ AFDD              ;   MODIFY: A,HL,BC y DE
 821+ AFDD              ;           (Puntero_de_vidas)
 822+ AFDD
 823+ AFDD              Pinta_Vida:
 824+ AFDD
 825+ AFDD ED 73 0F 96      ld (Stack),sp                                       ; Guarda el vector (SP).
 826+ AFE1 ED 7B 7D 96      ld sp,(Puntero_de_vidas)                            ; Utilizaremos el puntero SP para extraer la información de la ((Tabla_marcador_de_vidas))_
 827+ AFE5              ;                                                       ; _ y abastecer REGs.
 828+ AFE5
 829+ AFE5 E1               pop hl                                              ; Dirección de pantalla donde se imprime Vida_X, (Puntero_de_impresion).
 830+ AFE6 D1               pop de                                              ; Dirección de memoria donde se encuentran los .db que componen Amadeus, (Puntero_objeto).
 831+ AFE7
 832+ AFE7 ED 73 7D 96      ld (Puntero_de_vidas),sp                            ; Sitúa (Puntero_de_vidas) en los datos de la tabla de la siguiente vida.
 833+ AFEB
 834+ AFEB ED 7B 0F 96      ld sp,(Stack)                                       ; Recupera la dirección que contenía el vector SP.
 835+ AFEF
 836+ AFEF 3E 45            ld a,%01000101                                      ; Attrs.: BRIGHT, BLACK PAPER, CYAN INK.
 837+ AFF1
 838+ AFF1 01 02 03         ld bc,$0302                                         ; (Columnas/Filas )
 839+ AFF4
 840+ AFF4 CD 08 9F         call Pinta_imagen   ; v2. Ok.                       ; Imprime AMADEUS.
 841+ AFF7
 842+ AFF7 C9               ret
 843+ AFF8
