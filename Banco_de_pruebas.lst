 177+ C162              Make_Score_max_msg:
 178+ C162
 179+ C162              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 180+ C162
 181+ C162              ;   Necesito fabricar un msg. con la máxima puntuación.
 182+ C162              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 183+ C162
 184+ C162 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 185+ C165 21 B8 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 186+ C168              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 187+ C168 11 D8 94         ld de,Score_max_msg
 188+ C16B
 189+ C16B              KEY_CODE_de_BCD:
 190+ C16B
 191+ C16B 7E           1 ld a,(hl)
 192+ C16C A7               and a
 193+ C16D 20 07            jr nz,3F
 194+ C16F
 195+ C16F              ;   El dígito es "0".
 196+ C16F
 197+ C16F 0C               inc c
 198+ C170 0D               dec c
 199+ C171 20 03            jr nz,3F
 200+ C173
 201+ C173 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 202+ C174 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 203+ C176
 204+ C176 D5           3 push de                                    ; PUSH Score_max_msg.
 205+ C177
 206+ C177 11 E9 94         ld de,Non_authorized_KEY_CODES+2         ; KEY_CODE numbers list.
 207+ C17A
