 643+ C441              ;   17/10/26
 644+ C441              ;
 645+ C441              ;   Asigna un nuevo KEYCODE y sustituye al contenido en la variable MOVE_xxx, (al que apunta H)L.
 646+ C441              ;   Nueva tecla para la función de movimiento, (KEYBOARD) a la que apunta HL.
 647+ C441              ;
 648+ C441              ;   Move_LEFT db $24
 649+ C441              ;   Move_RIGHT db $1c
 650+ C441              ;   Move_FIRE db $04
 651+ C441              ;   Move_SHIELD db $20
 652+ C441              ;
 653+ C441              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 654+ C441              ;
 655+ C441              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 656+ C441              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 657+ C441              ;
 658+ C441              ;   Special keys:
 659+ C441              ;
 660+ C441              ;   Symbol_key defm "SYMB.",0
 661+ C441              ;   Space_key defm "SPACE",0
 662+ C441              ;   Enter_key defm "ENTER",0
 663+ C441              ;   Caps_key defm "CAPS.",0
 664+ C441              ;
 665+ C441              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 666+ C441              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 667+ C441              ;
 668+ C441              ;           (Numero_de_teclas_definidas) contiene el n° de teclas YA DEFINIDAS.
 669+ C441              ;
 670+ C441              ;   MODIFY: AF, HL, BC y DE.
 671+ C441              ;
 672+ C441              ;   OUTPUT: (A) = "0".
 673+ C441
