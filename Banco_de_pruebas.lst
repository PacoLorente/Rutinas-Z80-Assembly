 185+ C726 11 1E CD         ld de,Score_max_msg
 186+ C729
 187+ C729              KEY_CODE_de_BCD:
 188+ C729
 189+ C729 7E           1 ld a,(hl)
 190+ C72A A7               and a
 191+ C72B 20 07            jr nz,3F
 192+ C72D
 193+ C72D              ;   El dígito es "0".
 194+ C72D
 195+ C72D 0C               inc c
 196+ C72E 0D               dec c
 197+ C72F 20 03            jr nz,3F
 198+ C731
 199+ C731 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 200+ C732 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 201+ C734
 202+ C734 D5           3 push de                                    ; PUSH Score_max_msg.
 203+ C735
