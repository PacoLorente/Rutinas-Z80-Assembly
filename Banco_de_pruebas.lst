   5+ 9BEC              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9BEC              ;   (XOR) bit a bit.
   7+ 9BEC              ;
   8+ 9BEC              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9BEC              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9BEC
  11+ 9BEC              Derivando_RND
  12+ 9BEC
  13+ 9BEC ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9BEE C5               push bc
  15+ 9BEF              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9BEF 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9BF2              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9BF2
  19+ 9BF2 A7           6 and a                                 ; Carry a "0".
  20+ 9BF3 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9BF5 30 02            jr nc,1F
  22+ 9BF7
  23+ 9BF7 CB C1            set 0,c
  24+ 9BF9
  25+ 9BF9 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9BFA E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9BFC 5F               ld e,a
  28+ 9BFD
  29+ 9BFD 7A               ld a,d
  30+ 9BFE E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9C00 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9C02
  33+ 9C02 CB 3F            srl a
  34+ 9C04
  35+ 9C04 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9C05
  37+ 9C05 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9C06 28 04            jr z,4F
  39+ 9C08
  40+ 9C08 CB FF            set 7,a
  41+ 9C0A 18 02            jr 5F
  42+ 9C0C
  43+ 9C0C CB BF        4 res 7,a
  44+ 9C0E
  45+ 9C0E CB 21        5 sla c
  46+ 9C10 10 E0            djnz 6B
  47+ 9C12
  48+ 9C12 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C13
  50+ 9C13 77               ld (hl),a
