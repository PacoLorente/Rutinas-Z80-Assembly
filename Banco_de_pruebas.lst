 127  FD01
 128  FD01              Entidades_disparos_scanlines_album equ $8288	;	($8288 - $82b9)		; 49 bytes, (7 disparos, 7 bytes cada uno), $31.
 129  FD01              Entidades_disparos_scanlines_album_2 equ $82bb	;	($82bb - $82ec)
