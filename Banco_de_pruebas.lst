 483  9445              ; --------------------------------------------------------------------------------
 484  9445              ;
 485  9445              ; 05/05/26
 486  9445              ;
 487  9445              ; Parámetros DRAW.
 488  9445              ;
 489  9445
 490  9445              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 491  9445
 492  9445 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 493  9446              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 494  9446              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 495  9446              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 496  9446
 497  9446 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 498  9447              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 499  9447
 500  9447 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 501  9448              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 502  9448              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 503  9448
 504  9448              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 505  9448              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 506  9448
 507  9448              ; Ejemplos:
 508  9448
 509  9448              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 510  9448              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 511  9448              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 512  9448              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 513  9448              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 514  9448
 515  9448 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 516  9449              ;															  _ que esta entidad haya colisionado con Amadeus.
 517  9449              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 518  9449
 519  9449 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 520  944B              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 521  944B
 522  944B 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 523  944D
 524  944D              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 525  944D
 526  944D 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 527  944F              ;															  _palabras que componen el "movimiento_masticado".
 528  944F
 529  944F              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 530  944F
 531  944F 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 532  9450              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 533  9450              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 534  9450              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 535  9450              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 536  9450
 537  9450 00           Attr db 0 													; Atributos de la entidad.
 538  9451
 539  9451              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 540  9451
 541  9451
 542  9451
 543  9451 00           Ctrl_2 db 0
 544  9452              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 545  9452              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 546  9452              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 547  9452              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 548  9452              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 549  9452              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 550  9452              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 551  9452              ;
 552  9452              ;															BIT 1, ???
 553  9452              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 554  9452              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 555  9452              ;															BIT 3, ???
 556  9452              ;															BIT 4, ???
 557  9452              ;															BIT 5, ???
 558  9452              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
 559  9452              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
 560  9452              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 561  9452              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 562  9452
 563  9452 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 564  9453              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_Sprite_completo],_
 565  9453              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 566  9453              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 567  9453              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 568  9453              ;
 569  9453              ; 															DESCRIPCIÖN:
 570  9453              ;
 571  9453              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 572  9453              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_Sprite_completo]).
 573  9453              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 574  9453              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_Sprite_completo]).
 575  9453              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 576  9453              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 577  9453              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 578  9453              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 579  9453              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 580  9453              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 581  9453              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 582  9453              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_Sprite_completo) justo después de `inicializar? un objeto.
 583  9453              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 584  9453              ;
 585  9453              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 586  9453              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 587  9453              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 588  9453
 589  9453 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 590  9454              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 591  9454              ;															; _rojo - amarillo.
 592  9454
 593  9454 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 594  9455              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 595  9455
 596  9455 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 597  9456 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 598  9457
 599  9457 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 600  9459 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
 601  945B
 602  945B              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 603  945B
 604  945B 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 605  945C              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 606  945C              ;
 607  945C              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
 608  945C
 609  945C              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 610  945C
 611  945C 00 00        Indice_Sprite_der defw 0
 612  945E 00 00        Indice_Sprite_izq defw 0
 613  9460 00 00        Puntero_DESPLZ_der defw 0
