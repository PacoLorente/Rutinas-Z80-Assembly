  16+ A54F              ;
  17+ A54F              ;   04/11/22
  18+ A54F              ;
  19+ A54F              ;   Entrega una dirección de ATRIBUTOS de pantalla en HL a partir de una dirección de pantalla, dada en HL.
  20+ A54F              ;
  21+ A54F              ;   INPUT: HL contiene la dirección de memoria de pantalla.
  22+ A54F              ;   OUTPUT: HL contiene la dirección de ATRIBUTOS de pantalla de la dirección que contenía HL.
  23+ A54F              ;
  24+ A54F              ;   DESTRUYE: HL y A. !!!!!
  25+ A54F
  26+ A54F CD 45 A5     Calcula_direccion_atributos: call calcula_tercio
  27+ A552 26 58            ld h,$58
  28+ A554 84               add h
  29+ A555 67               ld h,a
  30+ A556 C9               ret
  31+ A557
