 549+ 9F1F E1               pop hl                                  ;   Mensaje de texto.
 550+ 9F20
 551+ 9F20              ;   Suiguiente char.
 552+ 9F20
 553+ 9F20 23               inc hl                                  ;   Siguiente caracter a imprimir.
 554+ 9F21
 555+ 9F21 34               inc (hl)
 556+ 9F22 35               dec (hl)
 557+ 9F23
 558+ 9F23 28 24            jr z,Exit_01                            ;   RET, fin de msg.
 559+ 9F25
 560+ 9F25 1C               inc e                                   ;   Siguiente columna de pantalla.
 561+ 9F26
 562+ 9F26 C1               pop bc                                  ;   Carga el temporizador en B.
 563+ 9F27
 564+ 9F27 04               inc b
 565+ 9F28 05               dec b
