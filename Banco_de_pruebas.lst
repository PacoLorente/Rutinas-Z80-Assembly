# file opened: RND_Derivando.asm
   1+ A00E              ; ******************************************************************************************************************************************************************************************
   2+ A00E              ;
   3+ A00E              ;   3/4/25
   4+ A00E              ;
   5+ A00E              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A00E              ;   (XOR) bit a bit.
   7+ A00E              ;
   8+ A00E              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A00E              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A00E
  11+ A00E              Derivando_RND
  12+ A00E
  13+ A00E ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A010 C5               push bc
  15+ A011              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A011 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A014              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A014
  19+ A014 A7           6 and a                                 ; Carry a "0".
  20+ A015 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A017 30 02            jr nc,1F
  22+ A019
  23+ A019 CB C1            set 0,c
  24+ A01B
  25+ A01B 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A01C E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A01E 5F               ld e,a
  28+ A01F
  29+ A01F 7A               ld a,d
  30+ A020 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A022 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A024
  33+ A024 CB 3F            srl a
  34+ A026
  35+ A026 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A027
  37+ A027 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A028 28 04            jr z,4F
  39+ A02A
  40+ A02A CB FF            set 7,a
  41+ A02C 18 02            jr 5F
  42+ A02E
  43+ A02E CB BF        4 res 7,a
  44+ A030
  45+ A030 CB 21        5 sla c
  46+ A032 10 E0            djnz 6B
  47+ A034
  48+ A034 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A035
  50+ A035 77               ld (hl),a
  51+ A036 23               inc hl
  52+ A037 C1               pop bc
  53+ A038 10 D4            djnz 3B
  54+ A03A
  55+ A03A C9               ret
  56+ A03B
  57+ A03B
  58+ A03B
# file closed: RND_Derivando.asm
