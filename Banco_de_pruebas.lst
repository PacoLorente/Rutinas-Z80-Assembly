 295  8CA6 00 00        Puntero_mov defw 0								; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 296  8CA8 00 00        Puntero_indice_mov_bucle defw 0
 297  8CAA              ;
 298  8CAA              ;
 299  8CAA 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8CAB              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 301  8CAB              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 302  8CAB
 303  8CAB 00           Incrementa_puntero_backup db 0
 304  8CAC 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 305  8CAD              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8CAD
 307  8CAD 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8CAE 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CAF 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CB0
 311  8CB0              ;
 312  8CB0              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CB0              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CB0              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CB0              ;
 316  8CB0              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CB0              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CB0              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CB0              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CB0              ;
 321  8CB0              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CB0              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CB0              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8CB0
 325  8CB0 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 326  8CB1
 327  8CB1              ;																DESCRIPCIÓN:
 328  8CB1              ;
 329  8CB1              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 330  8CB1              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 331  8CB1              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 332  8CB1              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 333  8CB1              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 334  8CB1              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 335  8CB1
 336  8CB1              ;																BIT 3, Recarga de nueva oleada.
 337  8CB1              ;																BIT 4, Recarga de nueva oleada.
 338  8CB1              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 339  8CB1              ;																BIT 6, **** Frame completo.
 340  8CB1              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 341  8CB1
 342  8CB1 00 00        Repone_puntero_objeto defw 0				; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 343  8CB3              ; 																; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 344  8CB3              ; 																; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 345  8CB3              ;																; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 346  8CB3
