 295  8CA4 00 00        Puntero_mov defw 0								; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 296  8CA6 00 00        Puntero_indice_mov_bucle defw 0
 297  8CA8              ;
 298  8CA8              ;
 299  8CA8 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8CA9              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 301  8CA9              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 302  8CA9
 303  8CA9 00           Incrementa_puntero_backup db 0
 304  8CAA 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 305  8CAB              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8CAB
 307  8CAB 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8CAC 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CAD 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CAE
 311  8CAE              ;
 312  8CAE              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CAE              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CAE              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CAE              ;
 316  8CAE              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CAE              ;																;						Nº de veces que vamos a repetir el movimiento completo.
