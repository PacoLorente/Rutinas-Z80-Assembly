 420+ A407              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 421+ A407
 422+ A407 C1           	pop bc
 423+ A408 E1           	pop hl
 424+ A409
 425+ A409 E5           	push hl															; Push (Puntero_de_entidades).
 426+ A40A C5           	push bc															; Push (Numero_de_entidades)/(Clase).
