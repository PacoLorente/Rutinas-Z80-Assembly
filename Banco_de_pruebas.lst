   5+ 9675              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9675              ;   (XOR) bit a bit.
   7+ 9675              ;
   8+ 9675              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9675              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9675
  11+ 9675              Derivando_RND
  12+ 9675
  13+ 9675 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9677 C5               push bc
  15+ 9678              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9678 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 967B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 967B
  19+ 967B A7           6 and a                                 ; Carry a "0".
  20+ 967C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 967E 30 02            jr nc,1F
  22+ 9680
  23+ 9680 CB C1            set 0,c
  24+ 9682
  25+ 9682 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9683 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9685 5F               ld e,a
  28+ 9686
  29+ 9686 7A               ld a,d
  30+ 9687 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9689 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 968B
  33+ 968B CB 3F            srl a
  34+ 968D
  35+ 968D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 968E
  37+ 968E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 968F 28 04            jr z,4F
  39+ 9691
  40+ 9691 CB FF            set 7,a
  41+ 9693 18 02            jr 5F
  42+ 9695
  43+ 9695 CB BF        4 res 7,a
  44+ 9697
  45+ 9697 CB 21        5 sla c
  46+ 9699 10 E0            djnz 6B
  47+ 969B
  48+ 969B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 969C
  50+ 969C 77               ld (hl),a
  51+ 969D 23               inc hl
  52+ 969E C1               pop bc
  53+ 969F 10 D4            djnz 3B
  54+ 96A1
  55+ 96A1 C9               ret
