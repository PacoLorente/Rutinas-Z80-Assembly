 336  91AE              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 337  91AE
 338  91AE 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 339  91AF 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 340  91B0 00           Cola_de_desplazamiento db 0									; Este byte indica:
 341  91B1
 342  91B1              ;
 343  91B1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 344  91B1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 345  91B1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 346  91B1              ;
 347  91B1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 348  91B1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 349  91B1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 350  91B1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 351  91B1              ;
 352  91B1              ;															;	"$ff" ..... Bucle infinito de repetición.
 353  91B1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 354  91B1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 355  91B1
