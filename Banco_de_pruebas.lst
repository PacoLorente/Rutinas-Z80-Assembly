 463  93FF              ;
 464  93FF              ; 05/05/26
 465  93FF              ;
 466  93FF              ; Parámetros DRAW.
 467  93FF              ;
 468  93FF
 469  93FF              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 470  93FF
 471  93FF 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 472  9400              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 473  9400              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 474  9400              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 475  9400
 476  9400 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 477  9401              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 478  9401 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 479  9402 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 480  9403
 481  9403 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 482  9404              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 483  9404              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 484  9404
 485  9404              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 486  9404              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 487  9404
 488  9404              ; Ejemplos:
 489  9404
 490  9404              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 491  9404              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 492  9404              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 493  9404              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 494  9404              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 495  9404
 496  9404 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 497  9405              ;															  _ que esta entidad haya colisionado con Amadeus.
 498  9405              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 499  9405
 500  9405 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 501  9407              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 502  9407
 503  9407 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 504  9409
 505  9409              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 506  9409
 507  9409 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 508  940B              ;															  _palabras que componen el "movimiento_masticado".
 509  940B
 510  940B              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 511  940B
 512  940B 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 513  940C              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 514  940C              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 515  940C              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 516  940C              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 517  940C
 518  940C 00           Attr db 0 													; Atributos de la entidad.
 519  940D
 520  940D              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 521  940D
 522  940D
 523  940D
 524  940D 00           Ctrl_2 db 0
 525  940E              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 526  940E              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 527  940E              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 528  940E              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 529  940E              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 530  940E              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 531  940E              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 532  940E              ;
 533  940E              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 534  940E              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 535  940E              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 536  940E              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 537  940E              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 538  940E              ;															BIT 4, ???
 539  940E              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 540  940E              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
 541  940E              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
 542  940E              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 543  940E              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 544  940E
 545  940E 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 546  940F              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 547  940F              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 548  940F              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 549  940F              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 550  940F              ;
 551  940F              ; 															DESCRIPCIÖN:
 552  940F              ;
 553  940F              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 554  940F              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 555  940F              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 556  940F              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 557  940F              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 558  940F              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 559  940F              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 560  940F              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 561  940F              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 562  940F              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 563  940F              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 564  940F              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 565  940F              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 566  940F              ;
 567  940F              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 568  940F              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 569  940F              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 570  940F
 571  940F 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 572  9410              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 573  9410              ;															; _rojo - amarillo.
 574  9410
 575  9410 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 576  9411              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 577  9411
 578  9411 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 579  9413 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
 580  9415
 581  9415              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 582  9415
 583  9415 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 584  9416              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 585  9416              ;
 586  9416              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
 587  9416
 588  9416              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 589  9416
 590  9416              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
 591  9416              ;
 592  9416              ;	COLORES: 0 ..... NEGRO
 593  9416              ;    		 1 ..... AZUL    jr $
 594  9416              ; 			 2 ..... ROJO
 595  9416              ;			 3 ..... MAGENTA
 596  9416              ; 			 4 ..... VERDE
 597  9416              ; 			 5 ..... CIAN
 598  9416              ;			 6 ..... AMARILLO
 599  9416              ; 			 7 ..... BLANCO
 600  9416
 601  9416
 602  9416 00 00        Indice_Sprite_der defw 0
 603  9418 00 00        Indice_Sprite_izq defw 0
 604  941A 00 00        Puntero_DESPLZ_der defw 0
 605  941C 00 00        Puntero_DESPLZ_izq defw 0
 606  941E 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 607  9420
 608  9420 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 609  9421              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 610  9421              ;															; _baja de la pantalla cuando hemos superado el nivel.
 611  9421
 612  9421 00           Columnas db 0
 613  9422 00           Limite_vertical db 0 										; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 614  9423              ;															; 2ª Función de (Limite_vertical):
 615  9423              ;															; Se inicializa a "0" cada vez que ejecutamos el bucle de entidades. Se utiliza como contador; se incrementa (+1) cada vez que se añade una_
 616  9423              ;															; _descripción a la (Tabla_de_pintado). Este valor lo utiliza la rutina [Ordena_tabla_de_pintado] para ordenar la tabla antes de imprimir.
 617  9423
 618  9423
 619  9423
 620  9423              ; Variables de control general.
 621  9423
 622  9423 00           Frames_explosion db 0 										; Nº de Frames que tiene la explosión.
 623  9424
 624  9424              ; Variables de funcionamiento, (No incluidas en base de datos de entidades), a partir de aquí!!!!!
 625  9424
 626  9424              Perfiles_de_velocidad
 627  9424
 628  9424 00           Vel_left db 0 												; Velocidad izquierda. Nº de píxeles que desplazamos el objeto a izquierda. 1, 2, 4 u 8 px.
 629  9425 00           Vel_right db 0 												; Velocidad derecha. Nº de píxeles que desplazamos el objeto a derecha. 1, 2, 4 u 8 px.
 630  9426 00           Vel_up db 0 												; Velocidad subida. Nº de píxeles que desplazamos el objeto hacia arriba. (De 1 a 7px).
 631  9427 00           Vel_down db 0 												; Velocidad bajada. Nº de píxeles que desplazamos el objeto hacia abajo. (De 1 a 7px).
 632  9428
 633  9428              ; Movimiento. ------------------------------------------------------------------------------------------------------
 634  9428
 635  9428 00 00        Puntero_tabla_Random defw 0
