 352+ C132              ; ----- ----- ----- ----- -----
 353+ C132              ;
 354+ C132              ;   23/9/26
 355+ C132              ;
 356+ C132              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C132              ;
 358+ C132              ;   HL define el sonido.
 359+ C132              ;
 360+ C132              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C132              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C132              ;
 363+ C132              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C132              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C132              ;
 366+ C132              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C132              ;
 368+ C132              ;   INPUTS: (Shot_sound) <> "0".
 369+ C132              ;
 370+ C132              ;   MODIFY: AF, HL y BC.
 371+ C132              ;
 372+ C132              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C132
 374+ C132              Play_shot_sound_effect:
 375+ C132
 376+ C132              ;   Exclusiones:
 377+ C132
 378+ C132 2A 2D 96         ld hl,(Shot_sound)
 379+ C135 7C               ld a,h
 380+ C136 B5               or l
 381+ C137 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C138
 383+ C138 3A 00 96         ld a,(Ctrl_6)
 384+ C13B CB 47            bit 0,a
 385+ C13D C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C13E
 387+ C13E 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
