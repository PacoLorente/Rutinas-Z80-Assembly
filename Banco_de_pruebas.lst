   5+ 99C0              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99C0              ;   (XOR) bit a bit.
   7+ 99C0              ;
   8+ 99C0              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99C0              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99C0
  11+ 99C0              Derivando_RND
  12+ 99C0
  13+ 99C0 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99C2 C5               push bc
  15+ 99C3              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99C3 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99C6              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99C6
  19+ 99C6 A7           6 and a                                 ; Carry a "0".
  20+ 99C7 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99C9 30 02            jr nc,1F
  22+ 99CB
  23+ 99CB CB C1            set 0,c
  24+ 99CD
  25+ 99CD 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99CE E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99D0 5F               ld e,a
  28+ 99D1
  29+ 99D1 7A               ld a,d
  30+ 99D2 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99D4 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99D6
  33+ 99D6 CB 3F            srl a
  34+ 99D8
  35+ 99D8 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99D9
  37+ 99D9 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99DA 28 04            jr z,4F
  39+ 99DC
  40+ 99DC CB FF            set 7,a
  41+ 99DE 18 02            jr 5F
  42+ 99E0
  43+ 99E0 CB BF        4 res 7,a
  44+ 99E2
  45+ 99E2 CB 21        5 sla c
  46+ 99E4 10 E0            djnz 6B
  47+ 99E6
  48+ 99E6 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99E7
  50+ 99E7 77               ld (hl),a
  51+ 99E8 23               inc hl
  52+ 99E9 C1               pop bc
  53+ 99EA 10 D4            djnz 3B
  54+ 99EC
  55+ 99EC C9               ret
