 355  9490
 356  9490              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 357  9490
 358  9490 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 359  9491              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 360  9491              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 361  9491              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 362  9491
 363  9491 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 364  9492              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 365  9492 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 366  9493 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 367  9494
 368  9494 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 369  9495              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 370  9495              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 371  9495
 372  9495              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 373  9495              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 374  9495
 375  9495              ; Ejemplos:
 376  9495
 377  9495              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 378  9495              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 379  9495              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 380  9495              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 381  9495              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 382  9495
