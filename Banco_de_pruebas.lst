   1+ A0DC              ; ******************************************************************************************************************************************************************************************
   2+ A0DC              ;
   3+ A0DC              ;   3/4/25
   4+ A0DC              ;
   5+ A0DC              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0DC              ;   (XOR) bit a bit.
   7+ A0DC              ;
   8+ A0DC              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0DC              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0DC
  11+ A0DC              Derivando_RND
  12+ A0DC
  13+ A0DC ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0DE C5               push bc
  15+ A0DF              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0DF 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0E2              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0E2
  19+ A0E2 A7           6 and a                                 ; Carry a "0".
  20+ A0E3 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0E5 30 02            jr nc,1F
  22+ A0E7
  23+ A0E7 CB C1            set 0,c
  24+ A0E9
  25+ A0E9 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0EA E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0EC 5F               ld e,a
  28+ A0ED
  29+ A0ED 7A               ld a,d
  30+ A0EE E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0F0 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0F2
  33+ A0F2 CB 3F            srl a
  34+ A0F4
  35+ A0F4 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0F5
  37+ A0F5 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0F6 28 04            jr z,4F
  39+ A0F8
  40+ A0F8 CB FF            set 7,a
  41+ A0FA 18 02            jr 5F
  42+ A0FC
  43+ A0FC CB BF        4 res 7,a
  44+ A0FE
  45+ A0FE CB 21        5 sla c
  46+ A100 10 E0            djnz 6B
  47+ A102
  48+ A102 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A103
  50+ A103 77               ld (hl),a
  51+ A104 23               inc hl
  52+ A105 C1               pop bc
  53+ A106 10 D4            djnz 3B
  54+ A108
  55+ A108 C9               ret
  56+ A109
  57+ A109
  58+ A109
# file closed: RND_Derivando.asm
