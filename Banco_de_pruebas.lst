  46+ A0A0              ;
  47+ A0A0              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
  48+ A0A0              ;
  49+ A0A0              ;	INPUTS:		B contiene (Numero_de_entidades).
  50+ A0A0              ;				C contiene la (Clase) de la 1ª entidad del nivel.
  51+ A0A0              ; 				HL contiene (Puntero_de_entidades).
  52+ A0A0
  53+ A0A0              Prepara_Cajas_Master
  54+ A0A0
  55+ A0A0 E5           	push hl															; Push (Puntero_de_entidades).
  56+ A0A1 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
  57+ A0A2
  58+ A0A2              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
  59+ A0A2
  60+ A0A2 79           	ld a,c
