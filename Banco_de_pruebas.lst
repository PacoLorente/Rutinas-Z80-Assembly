 448  93FF
 449  93FF 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 450  9400              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 451  9400              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 452  9400              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 453  9400
 454  9400 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 455  9401              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 456  9401 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 457  9402 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 458  9403
 459  9403 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 460  9404              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 461  9404              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 462  9404
 463  9404              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 464  9404              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 465  9404
 466  9404              ; Ejemplos:
 467  9404
 468  9404              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 469  9404              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 470  9404              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 471  9404              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 472  9404              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 473  9404
