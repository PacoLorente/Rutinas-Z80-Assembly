 780+ B5A7              ;
 781+ B5A7              ;	5/08/22
 782+ B5A7              ;
 783+ B5A7              ;   NextScan.
 784+ B5A7              ;
 785+ B5A7              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B5A7              ;
 787+ B5A7              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B5A7              ;
 789+ B5A7              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B5A7              ;
 791+ B5A7              ;       DESTRUIDOS: AF y HL !!!
 792+ B5A7              ;
 793+ B5A7              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B5A7              ;
 795+ B5A7
 796+ B5A7              NextScan:
 797+ B5A7
 798+ B5A7 24           	inc h          							; Incrementamos el scanline.
 799+ B5A8 7C               ld a,h
 800+ B5A9 E6 07            and 7
 801+ B5AB C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B5AC
 803+ B5AC 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B5AD C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B5AF 6F               ld l,a
 806+ B5B0 D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B5B1
 808+ B5B1 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B5B2 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B5B4 67               ld h,a
 811+ B5B5 C9               ret
 812+ B5B6
 813+ B5B6              NextScan_15:
 814+ B5B6
 815+ B5B6 06 0F        	ld b,15
 816+ B5B8 CD A7 B5     1 call NextScan
 817+ B5BB 10 FB        	djnz 1B
 818+ B5BD
 819+ B5BD C9           	ret
 820+ B5BE
 821+ B5BE              ;----------------------------------------------------------------------------------------------------------------
 822+ B5BE              ;
 823+ B5BE              ;	5/08/22
 824+ B5BE              ;
 825+ B5BE              ;   PreviousScan.
 826+ B5BE              ;
 827+ B5BE              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B5BE              ;
 829+ B5BE              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B5BE              ;
 831+ B5BE              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B5BE              ;
 833+ B5BE              ;       DESTRUIDOS: AF y HL !!!
 834+ B5BE              ;
 835+ B5BE              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B5BE              ;
 837+ B5BE
 838+ B5BE              PreviousScan:
 839+ B5BE
 840+ B5BE 7C           	ld a,h
 841+ B5BF 25               dec h               							; Dec H.
 842+ B5C0 E6 07            and 7
 843+ B5C2 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B5C3
 845+ B5C3 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B5C4 D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B5C6 6F               ld l,a
 848+ B5C7 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B5C8
 850+ B5C8 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B5C9 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B5CB 67               ld h,a
 853+ B5CC C9               ret
 854+ B5CD
