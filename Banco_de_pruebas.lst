1085+ C547 BE               cp (hl)
1086+ C548 28 0B            jr z,Retrocede_carro
1087+ C54A
1088+ C54A 3E 21            ld a,$21                                                ; "ENTER" KEYCODE.
1089+ C54C BE               cp (hl)
1090+ C54D 28 06            jr z,Retrocede_carro
1091+ C54F
1092+ C54F 3E 27            ld a,$27                                                ; "CAPS SHIFT" KEYCODE.
1093+ C551 BE               cp (hl)
1094+ C552 28 01            jr z,Retrocede_carro
1095+ C554
