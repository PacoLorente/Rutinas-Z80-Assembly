   5+ 9D50              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D50              ;   (XOR) bit a bit.
   7+ 9D50              ;
   8+ 9D50              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D50              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D50
  11+ 9D50              Derivando_RND
  12+ 9D50
  13+ 9D50 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D52 C5               push bc
  15+ 9D53              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D53 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D56              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D56
  19+ 9D56 A7           6 and a                                 ; Carry a "0".
  20+ 9D57 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D59 30 02            jr nc,1F
  22+ 9D5B
  23+ 9D5B CB C1            set 0,c
  24+ 9D5D
  25+ 9D5D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D5E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D60 5F               ld e,a
  28+ 9D61
  29+ 9D61 7A               ld a,d
  30+ 9D62 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D64 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D66
  33+ 9D66 CB 3F            srl a
  34+ 9D68
  35+ 9D68 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D69
  37+ 9D69 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D6A 28 04            jr z,4F
  39+ 9D6C
  40+ 9D6C CB FF            set 7,a
  41+ 9D6E 18 02            jr 5F
  42+ 9D70
  43+ 9D70 CB BF        4 res 7,a
  44+ 9D72
  45+ 9D72 CB 21        5 sla c
  46+ 9D74 10 E0            djnz 6B
  47+ 9D76
  48+ 9D76 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D77
  50+ 9D77 77               ld (hl),a
  51+ 9D78 23               inc hl
  52+ 9D79 C1               pop bc
  53+ 9D7A 10 D4            djnz 3B
  54+ 9D7C
  55+ 9D7C C9               ret
