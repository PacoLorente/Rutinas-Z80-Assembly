 580+ B382              ;
 581+ B382              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 582+ B382              ;
 583+ B382
 584+ B382              NextScan:
 585+ B382
 586+ B382 24           	inc h          							; Incrementamos el scanline.
 587+ B383 7C               ld a,h
 588+ B384 E6 07            and 7
 589+ B386 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 590+ B387
 591+ B387 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B388 C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B38A 6F               ld l,a
 594+ B38B D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B38C
 596+ B38C 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B38D D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B38F 67               ld h,a
 599+ B390 C9               ret
