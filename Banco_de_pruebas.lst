 584+ AECD C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ AECF 6F               ld l,a
 586+ AED0 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ AED1
 588+ AED1 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ AED2 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ AED4 67               ld h,a
 591+ AED5 C9               ret
