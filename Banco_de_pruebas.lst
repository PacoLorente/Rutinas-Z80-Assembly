   2+ 94AA              ;
   3+ 94AA              ;   3/4/25
   4+ 94AA              ;
   5+ 94AA              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 94AA              ;   (XOR) bit a bit.
   7+ 94AA              ;
   8+ 94AA              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 94AA              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 94AA
  11+ 94AA              Derivando_RND
  12+ 94AA
  13+ 94AA ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94AC C5               push bc
  15+ 94AD              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94AD 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94B0              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94B0
  19+ 94B0 A7           6 and a                                 ; Carry a "0".
  20+ 94B1 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94B3 30 02            jr nc,1F
  22+ 94B5
  23+ 94B5 CB C1            set 0,c
  24+ 94B7
  25+ 94B7 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94B8 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94BA 5F               ld e,a
  28+ 94BB
  29+ 94BB 7A               ld a,d
  30+ 94BC E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94BE 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94C0
  33+ 94C0 CB 3F            srl a
  34+ 94C2
  35+ 94C2 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 94C3
  37+ 94C3 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 94C4 28 04            jr z,4F
  39+ 94C6
  40+ 94C6 CB FF            set 7,a
  41+ 94C8 18 02            jr 5F
  42+ 94CA
  43+ 94CA CB BF        4 res 7,a
  44+ 94CC
  45+ 94CC CB 21        5 sla c
  46+ 94CE 10 E0            djnz 6B
  47+ 94D0
  48+ 94D0 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94D1
  50+ 94D1 77               ld (hl),a
  51+ 94D2 23               inc hl
  52+ 94D3 C1               pop bc
  53+ 94D4 10 D4            djnz 3B
  54+ 94D6
  55+ 94D6 C9               ret
  56+ 94D7
  57+ 94D7
  58+ 94D7
