 624+ B396
 625+ B396 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 626+ B397 D6 20            sub $20             							; Vamos a comprobarlo...
 627+ B399 6F               ld l,a
 628+ B39A D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 629+ B39B
 630+ B39B 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 631+ B39C C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 632+ B39E 67               ld h,a
 633+ B39F C9               ret
