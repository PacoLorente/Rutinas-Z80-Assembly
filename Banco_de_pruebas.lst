   5+ 999B              ; DRAW. ************************************************************************************************************************************************************************************
   6+ 999B
   7+ 999B              Draw
   8+ 999B
   9+ 999B CD 30 9C     	call Prepara_draw
  10+ 999E 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 999F A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 99A0 28 05        	jr z,2F
  13+ 99A2
  14+ 99A2 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99A5 18 0C        	jr 1F
  16+ 99A7
  17+ 99A7              ;	Inicia entidad.
  18+ 99A7
  19+ 99A7 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99AA 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99AD CD 38 9B     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  22+ 99B0              ;													; _la esquina superior izquierda de la pantalla.
  23+ 99B0 CD C6 A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  24+ 99B3
  25+ 99B3 3A F7 8B     1 ld a,(Ctrl_0)
  26+ 99B6 CB 6F        	bit 5,a
  27+ 99B8 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  28+ 99BA
  29+ 99BA CD CF 99     	call Comprueba_limite_horizontal
  30+ 99BD CD 5F 9A     	call Comprueba_limite_vertical
  31+ 99C0
  32+ 99C0              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  33+ 99C0              ; -----------------------
  34+ 99C0              ; -----------------------
  35+ 99C0              ; -----------------------
  36+ 99C0
  37+ 99C0 CD B4 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  38+ 99C3 CD D8 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  39+ 99C6
  40+ 99C6 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina REStauramos el bit5 de Ctrl_0 para que nos vuelva_
  41+ 99C9 CB AF        	res 5,a											; _a ser de utilidad.
  42+ 99CB 32 F7 8B     	ld (Ctrl_0),a
  43+ 99CE
  44+ 99CE C9           	ret
  45+ 99CF
  46+ 99CF              ; *******************************************************************************************************************************************************************************************
  47+ 99CF              ;	21/01/23
  48+ 99CF              ;
  49+ 99CF              ; 	Comprueba_limite_horizontal.
  50+ 99CF              ;
  51+ 99CF              ;	La rutina comprueba si hemos sobrepasado el (Limite_horizontal) definido en la rutina [Inicializacion]. Este será:_
  52+ 99CF              ;	_ $4fc0 si partimos de los cuadrantes 1 o 2 de pantalla o $4820 si partimos de los cuadrantes 3 o 4.
  53+ 99CF              ;
  54+ 99CF              ;	Si sobrepasamos o alcanzamos el límite horizontal establecido, la rutina cargará el registro E con un "1".
  55+ 99CF              ;	Si NO HEMOS SOBREPASADO (Limite_horizontal), E="0".
  56+ 99CF              ;	E="1" indica que HEMOS SOBREPASADO el (Limite_horizontal).
  57+ 99CF              ;	E="2" indica que NO HEMOS SOBREPASADO el (Limite_horizontal) pero hemos alcanzado o superado EL CENTRO DE PANTALLA.
  58+ 99CF
  59+ 99CF
  60+ 99CF
  61+ 99CF 3A F7 8B     Comprueba_limite_horizontal ld a,(Ctrl_0)          	; Si no hemos desaparecido por arriba o por abajo, saltamos a 1F para comprobar_
  62+ 99D2 CB 57        	bit 2,a                                         ; _si hemos llegado o sobrepasado (Limite_horizontal). Seguimos con la rutina.
  63+ 99D4 28 07        	jr z,1F                                         ; Si por el contrario hemos desaparecido por arriba o por abajo, (bit2/bit3 de (Ctrl_0)="1"))_
  64+ 99D6 E6 FB        	and $fb 										; _hay que modificar el puntero de posición. (E="1" y salimos de la rutina). Antes inicializaremos los_
