   4+ 9BE9              ;
   5+ 9BE9              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9BE9              ;   (XOR) bit a bit.
   7+ 9BE9              ;
   8+ 9BE9              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9BE9              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9BE9
  11+ 9BE9              Derivando_RND
  12+ 9BE9
  13+ 9BE9 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9BEB C5               push bc
  15+ 9BEC              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9BEC 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9BEF              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9BEF
  19+ 9BEF A7           6 and a                                 ; Carry a "0".
  20+ 9BF0 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9BF2 30 02            jr nc,1F
  22+ 9BF4
  23+ 9BF4 CB C1            set 0,c
  24+ 9BF6
  25+ 9BF6 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9BF7 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9BF9 5F               ld e,a
  28+ 9BFA
  29+ 9BFA 7A               ld a,d
  30+ 9BFB E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9BFD 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9BFF
  33+ 9BFF CB 3F            srl a
  34+ 9C01
  35+ 9C01 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9C02
  37+ 9C02 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9C03 28 04            jr z,4F
  39+ 9C05
  40+ 9C05 CB FF            set 7,a
  41+ 9C07 18 02            jr 5F
  42+ 9C09
  43+ 9C09 CB BF        4 res 7,a
  44+ 9C0B
  45+ 9C0B CB 21        5 sla c
  46+ 9C0D 10 E0            djnz 6B
  47+ 9C0F
  48+ 9C0F 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C10
  50+ 9C10 77               ld (hl),a
  51+ 9C11 23               inc hl
  52+ 9C12 C1               pop bc
  53+ 9C13 10 D4            djnz 3B
  54+ 9C15
  55+ 9C15 C9               ret
  56+ 9C16
  57+ 9C16
  58+ 9C16
