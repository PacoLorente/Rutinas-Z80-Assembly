   1+ 94AE              ; ******************************************************************************************************************************************************************************************
   2+ 94AE              ;
   3+ 94AE              ;   3/4/25
   4+ 94AE              ;
   5+ 94AE              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 94AE              ;   (XOR) bit a bit.
   7+ 94AE              ;
   8+ 94AE              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 94AE              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 94AE
  11+ 94AE              Derivando_RND
  12+ 94AE
  13+ 94AE ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 94B0 C5               push bc
  15+ 94B1              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 94B1 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 94B4              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 94B4
  19+ 94B4 A7           6 and a                                 ; Carry a "0".
  20+ 94B5 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 94B7 30 02            jr nc,1F
  22+ 94B9
  23+ 94B9 CB C1            set 0,c
  24+ 94BB
  25+ 94BB 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94BC E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94BE 5F               ld e,a
  28+ 94BF
  29+ 94BF 7A               ld a,d
  30+ 94C0 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94C2 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94C4
  33+ 94C4 CB 3F            srl a
  34+ 94C6
  35+ 94C6 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 94C7
  37+ 94C7 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 94C8 28 04            jr z,4F
  39+ 94CA
  40+ 94CA CB FF            set 7,a
  41+ 94CC 18 02            jr 5F
  42+ 94CE
  43+ 94CE CB BF        4 res 7,a
  44+ 94D0
  45+ 94D0 CB 21        5 sla c
  46+ 94D2 10 E0            djnz 6B
  47+ 94D4
  48+ 94D4 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94D5
  50+ 94D5 77               ld (hl),a
  51+ 94D6 23               inc hl
  52+ 94D7 C1               pop bc
  53+ 94D8 10 D4            djnz 3B
  54+ 94DA
  55+ 94DA C9               ret
  56+ 94DB
