 356  949B              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 357  949B
 358  949B 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 359  949C              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 360  949C              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 361  949C              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 362  949C
 363  949C 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 364  949D              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 365  949D 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 366  949E 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 367  949F
 368  949F 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 369  94A0              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 370  94A0              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 371  94A0
 372  94A0              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 373  94A0              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 374  94A0
 375  94A0              ; Ejemplos:
 376  94A0
 377  94A0              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 378  94A0              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 379  94A0              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 380  94A0              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 381  94A0              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 382  94A0
