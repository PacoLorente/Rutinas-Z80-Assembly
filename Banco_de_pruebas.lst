1504+ B0AA 36 01            ld (hl),1
1505+ B0AC 21 DD 91         ld hl,Impacto2                                 ; Cuando se produce Colisión, RES el bit2 de (Impacto2) y_
1506+ B0AF CB 96            res 2,(hl)                                     ; _ SET el bit3. El bit3 de (Impacto2) indica que hay contacto_
1507+ B0B1
1508+ B0B1 11 90 8B         ld de,Indice_Explosion_entidades
1509+ B0B4 2A DE 91         ld hl,(Entidad_sospechosa_de_colision)         ; Situamos el (Puntero_de_almacen_de_mov_masticados) de la entidad impactada en la primera palabra del índice de explosiones.
1510+ B0B7
1511+ B0B7 23               inc hl
1512+ B0B8 23               inc hl
1513+ B0B9 23               inc hl
1514+ B0BA
1515+ B0BA 73               ld (hl),e
1516+ B0BB 23               inc hl
1517+ B0BC 72               ld (hl),d
1518+ B0BD
1519+ B0BD              ; Situamos también el (Puntero_de_almacen_de_mov_masticados) de Amadeus en la primero explosión.
1520+ B0BD
1521+ B0BD 11 30 8C         ld de,Indice_Explosion_Amadeus
1522+ B0C0 21 DA 8D         ld hl,Pamm_Amadeus
1523+ B0C3
1524+ B0C3 73               ld (hl),e
1525+ B0C4 23               inc hl
1526+ B0C5 72               ld (hl),d
1527+ B0C6
1528+ B0C6 C9               ret
