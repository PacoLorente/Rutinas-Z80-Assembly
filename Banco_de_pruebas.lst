1340  D1BE              ; 	3/7/26
1341  D1BE              ;
1342  D1BE              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
1343  D1BE              ;
1344  D1BE              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
1345  D1BE              ;
1346  D1BE              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
1347  D1BE              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
1348  D1BE              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
1349  D1BE              ;
1350  D1BE              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
1351  D1BE              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
1352  D1BE              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
1353  D1BE              ;				  _medida que transcurre el tiempo.
1354  D1BE              ;
1355  D1BE              ;	OUTPUT: Define (Clock_next_entity).
1356  D1BE
1357  D1BE              Define_Clock_next_entity:
1358  D1BE
1359  D1BE 21 F3 CC     	ld hl,Max_time_to_appear_entities
1360  D1C1 BE           	cp (hl)
1361  D1C2
1362  D1C2 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1363  D1C3
1364  D1C3 38 03        	jr c,1F
1365  D1C5
1366  D1C5              ;	Por encima o igual que (Max_time_to_appear_entities).
1367  D1C5
1368  D1C5 4E           	ld c,(hl)
1369  D1C6 18 06        	jr 2F
1370  D1C8
1371  D1C8              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1372  D1C8              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1373  D1C8
1374  D1C8 23           1 inc hl
1375  D1C9 23           	inc hl
1376  D1CA
1377  D1CA BE           	cp (hl)
1378  D1CB
