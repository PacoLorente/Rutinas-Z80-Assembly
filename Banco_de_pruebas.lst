 563+ B1E5              ;	5/08/22
 564+ B1E5              ;
 565+ B1E5              ;   NextScan.
 566+ B1E5              ;
 567+ B1E5              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ B1E5              ;
 569+ B1E5              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ B1E5              ;
 571+ B1E5              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ B1E5              ;
 573+ B1E5              ;       DESTRUIDOS: AF y HL !!!
 574+ B1E5              ;
 575+ B1E5              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ B1E5              ;
 577+ B1E5
 578+ B1E5 24           NextScan inc h          							; Incrementamos el scanline.
 579+ B1E6 7C               ld a,h
 580+ B1E7 E6 07            and 7
 581+ B1E9 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ B1EA
 583+ B1EA 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1EB C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1ED 6F               ld l,a
 586+ B1EE D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1EF
 588+ B1EF 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1F0 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1F2 67               ld h,a
 591+ B1F3 C9               ret
 592+ B1F4
 593+ B1F4              ;----------------------------------------------------------------------------------------------------------------
 594+ B1F4              ;
 595+ B1F4              ;	5/08/22
 596+ B1F4              ;
 597+ B1F4              ;   PreviousScan.
 598+ B1F4              ;
 599+ B1F4              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 600+ B1F4              ;
 601+ B1F4              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ B1F4              ;
 603+ B1F4              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ B1F4              ;
 605+ B1F4              ;       DESTRUIDOS: AF y HL !!!
 606+ B1F4              ;
 607+ B1F4              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ B1F4              ;
 609+ B1F4
 610+ B1F4 7C           PreviousScan ld a,h
 611+ B1F5 25               dec h               							; Dec H.
 612+ B1F6 E6 07            and 7
 613+ B1F8 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ B1F9
 615+ B1F9 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B1FA D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B1FC 6F               ld l,a
 618+ B1FD D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ B1FE
