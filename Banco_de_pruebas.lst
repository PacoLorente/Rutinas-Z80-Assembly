3276  A0C1              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A0C1              ; ******************************************************************************************************************************************************************************************
   2+ A0C1              ;
   3+ A0C1              ;   3/4/25
   4+ A0C1              ;
   5+ A0C1              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0C1              ;   (XOR) bit a bit.
   7+ A0C1              ;
   8+ A0C1              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0C1              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0C1
  11+ A0C1              Derivando_RND
  12+ A0C1
  13+ A0C1 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0C3 C5               push bc
  15+ A0C4              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0C4 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0C7              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0C7
  19+ A0C7 A7           6 and a                                 ; Carry a "0".
  20+ A0C8 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0CA 30 02            jr nc,1F
  22+ A0CC
  23+ A0CC CB C1            set 0,c
  24+ A0CE
  25+ A0CE 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0CF E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0D1 5F               ld e,a
  28+ A0D2
  29+ A0D2 7A               ld a,d
  30+ A0D3 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0D5 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0D7
  33+ A0D7 CB 3F            srl a
  34+ A0D9
  35+ A0D9 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0DA
  37+ A0DA 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0DB 28 04            jr z,4F
  39+ A0DD
  40+ A0DD CB FF            set 7,a
  41+ A0DF 18 02            jr 5F
  42+ A0E1
  43+ A0E1 CB BF        4 res 7,a
  44+ A0E3
  45+ A0E3 CB 21        5 sla c
  46+ A0E5 10 E0            djnz 6B
  47+ A0E7
  48+ A0E7 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0E8
  50+ A0E8 77               ld (hl),a
  51+ A0E9 23               inc hl
  52+ A0EA C1               pop bc
  53+ A0EB 10 D4            djnz 3B
  54+ A0ED
  55+ A0ED C9               ret
  56+ A0EE
  57+ A0EE
  58+ A0EE
