   1+ 9757              ; *********************************** Limpia la pantalla, CLEAR SCREEN ****************************************************************
   2+ 9757              ;
   3+ 9757              ;
   4+ 9757              ;	CLS.
   5+ 9757              ;
   6+ 9757              ;	Limpia la pantalla y define sus atributos.
   7+ 9757              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ 9757              ;
   9+ 9757              ;	COLORES: 0 ..... NEGRO
  10+ 9757              ;    		 1 ..... AZUL
  11+ 9757              ; 			 2 ..... ROJO
  12+ 9757              ;			 3 ..... MAGENTA
  13+ 9757              ; 			 4 ..... VERDE
  14+ 9757              ; 			 5 ..... CIAN
  15+ 9757              ;			 6 ..... AMARILLO
  16+ 9757              ; 			 7 ..... BLANCO
  17+ 9757              ;
  18+ 9757              ;	INPUT: A contiene los atributos de pantalla.
  19+ 9757              ;
  20+ 9757              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 9757
  22+ 9757
  23+ 9757 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ 975A 11 01 40     	LD DE,$4001
  25+ 975D 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 9760 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 9762 ED B0        	LDIR
  28+ 9764 01 FF 02     	LD BC,767
  29+ 9767 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 9768 ED B0        	LDIR
  31+ 976A C9           	ret
  32+ 976B
