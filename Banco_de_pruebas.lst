 431+ C159              ;   -------------------------------------------------------------------------------------------
 432+ C159              ;
 433+ C159              ;   23/9/26
 434+ C159              ;
 435+ C159              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C159              ;
 437+ C159              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C159              ;   _ [Sound_Generator].
 439+ C159              ;
 440+ C159              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C159              ;
 442+ C159              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C159              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C159              ;
 445+ C159              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C159              ;
 447+ C159              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C159              ;
 449+ C159              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C159
 451+ C159              Play_burst_sound_effect:
 452+ C159
 453+ C159              ;   Exclusiones:
 454+ C159
 455+ C159 3A 0C 96         ld a,(Burst_sound)
 456+ C15C A7               and a
 457+ C15D C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C15E
 459+ C15E 08               ex af,af
 460+ C15F
 461+ C15F 3A DD 95         ld a,(Ctrl_6)
 462+ C162 CB 47            bit 0,a
 463+ C164 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C165
 465+ C165              ;   ----------------------
 466+ C165
 467+ C165 CB C7            set 0,a
 468+ C167 32 DD 95         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C16A
 470+ C16A 08               ex af,af                ; Restore (Burst_sound).
 471+ C16B
 472+ C16B 67               ld h,a
 473+ C16C 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C16E
 475+ C16E E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C16F
 477+ C16F 22 06 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C172 0E 03            ld c,3
 479+ C174 CD 97 9F         call Noise_efect
 480+ C177
 481+ C177 D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C178
 483+ C178 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C179 94               sub h
 485+ C17A
 486+ C17A 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C17C
 488+ C17C 7C               ld a,h
 489+ C17D 32 0C 96         ld (Burst_sound),a
 490+ C180
 491+ C180 C9               ret
 492+ C181
 493+ C181              Clean_burst_efect:
 494+ C181
 495+ C181 AF               xor a
 496+ C182 32 0C 96         ld (Burst_sound),a
 497+ C185
 498+ C185 3A DD 95         ld a,(Ctrl_6)
 499+ C188 CB 87            res 0,a
 500+ C18A 32 DD 95         ld (Ctrl_6),a
 501+ C18D
 502+ C18D C9               ret
 503+ C18E
 504+ C18E              ;   -------------------------------------------------------------------------------------------
 505+ C18E              ;
 506+ C18E              ;   23/9/26
 507+ C18E              ;
 508+ C18E              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C18E              ;   _ Shield_sound_effect.
 510+ C18E              ;
 511+ C18E              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C18E              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C18E              ;
 514+ C18E              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C18E              ;
 516+ C18E              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C18E              ;
 518+ C18E              ;   MODIFY: AF'y BC.
 519+ C18E
 520+ C18E              Play_Shield_sound_effect:
 521+ C18E
