 372+ A208              ;
 373+ A208              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 374+ A208              ;
 375+ A208              ;	INPUTS:		B contiene (Numero_de_entidades).
 376+ A208              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 377+ A208              ; 				HL contiene (Puntero_de_entidades).
 378+ A208
 379+ A208              Prepara_Cajas_Master:
 380+ A208
 381+ A208 E5           	push hl															; Push (Puntero_de_entidades).
 382+ A209 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A20A
 384+ A20A              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A20A
 386+ A20A 79           	ld a,c
 387+ A20B 08           	ex af,af
 388+ A20C 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A20D
 390+ A20D CD 33 A4     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 391+ A210              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A210              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A210 A7           	and a
 394+ A211 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A213
 396+ A213              ; Generamos movimientos masticados.
 397+ A213
 398+ A213              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A213
 400+ A213 79           	ld a,c 															; (A) = (Clase).
 401+ A214 32 B7 93     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A217
 403+ A217 CD 0C A5     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A21A CD 9E A5     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
