 309  8DC0 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8DC1
 311  8DC1              ;
 312  8DC1              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8DC1              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8DC1              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8DC1              ;
 316  8DC1              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8DC1              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8DC1              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8DC1              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8DC1              ;
 321  8DC1              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8DC1              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8DC1              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
