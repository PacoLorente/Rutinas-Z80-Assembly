   6+ B492              Draw:
   7+ B492
   8+ B492 2A 79 95     	ld hl,(Posicion_actual)
   9+ B495 7C           	ld a,h
  10+ B496 B5           	or l
  11+ B497 20 10        	jr nz,Entidad_iniciada 										; Si el contenido de (Posicion_actual) es distinto de "0" la entidad ya se ha iniciado.
  12+ B499
  13+ B499 CD 19 BB     	call Inicia_Puntero_mov
