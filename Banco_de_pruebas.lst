3249  A036              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A036              ; ******************************************************************************************************************************************************************************************
   2+ A036              ;
   3+ A036              ;   3/4/25
   4+ A036              ;
   5+ A036              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A036              ;   (XOR) bit a bit.
   7+ A036              ;
   8+ A036              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A036              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A036
  11+ A036              Derivando_RND
  12+ A036
  13+ A036 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A038 C5               push bc
  15+ A039              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A039 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A03C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A03C
  19+ A03C A7           6 and a                                 ; Carry a "0".
  20+ A03D CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A03F 30 02            jr nc,1F
  22+ A041
  23+ A041 CB C1            set 0,c
  24+ A043
  25+ A043 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A044 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A046 5F               ld e,a
  28+ A047
  29+ A047 7A               ld a,d
  30+ A048 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A04A 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A04C
  33+ A04C CB 3F            srl a
  34+ A04E
  35+ A04E AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A04F
  37+ A04F 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A050 28 04            jr z,4F
  39+ A052
  40+ A052 CB FF            set 7,a
  41+ A054 18 02            jr 5F
  42+ A056
  43+ A056 CB BF        4 res 7,a
  44+ A058
  45+ A058 CB 21        5 sla c
  46+ A05A 10 E0            djnz 6B
  47+ A05C
  48+ A05C 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A05D
  50+ A05D 77               ld (hl),a
  51+ A05E 23               inc hl
  52+ A05F C1               pop bc
  53+ A060 10 D4            djnz 3B
  54+ A062
  55+ A062 C9               ret
  56+ A063
  57+ A063
  58+ A063
# file closed: RND_Derivando.asm
