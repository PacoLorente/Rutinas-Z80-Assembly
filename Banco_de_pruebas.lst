 298  8C6E
 299  8C6E 00 00        Puntero_tabla_Random defw 0
 300  8C70 00 00        Puntero_indice_mov defw 0							    ; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 301  8C72 00 00        Puntero_mov defw 0										; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 302  8C74 00 00        Puntero_indice_mov_bucle defw 0							;
 303  8C76              ;
 304  8C76              ;
 305  8C76 00           Incrementa_puntero db 0									; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 306  8C77              ;														; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 307  8C77              ;														; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 308  8C77 00           Incrementa_puntero_backup db 0
 309  8C78 00           Repetimos_desplazamiento db 0							; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 310  8C79              ;														; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 311  8C79 00           Repetimos_desplazamiento_backup db 0					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 312  8C7A 00           Repetimos_movimiento db 0								; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 313  8C7B 00           Cola_de_desplazamiento db 0								; Este byte indica:
 314  8C7C              ;
 315  8C7C              ;														;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8C7C              ;														;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8C7C              ;														;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8C7C              ;
 319  8C7C              ;														;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8C7C              ;														;						Nº de veces que vamos a repetir el movimiento completo.
 321  8C7C              ;														;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8C7C              ;														;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 323  8C7C              ;
 324  8C7C              ;														;	"$ff" ..... Bucle infinito de repetición.
 325  8C7C              ;														;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 326  8C7C              ;														;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
