   1+ 9F3E              ; ******************************************************************************************************************************************************************************************
   2+ 9F3E              ;
   3+ 9F3E              ;   3/4/25
   4+ 9F3E              ;
   5+ 9F3E              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9F3E              ;   (XOR) bit a bit.
   7+ 9F3E              ;
   8+ 9F3E              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9F3E              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9F3E
  11+ 9F3E              Derivando_RND
  12+ 9F3E
  13+ 9F3E ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9F40 C5               push bc
  15+ 9F41              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9F41 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9F44              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9F44
  19+ 9F44 A7           6 and a                                 ; Carry a "0".
  20+ 9F45 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9F47 30 02            jr nc,1F
  22+ 9F49
  23+ 9F49 CB C1            set 0,c
  24+ 9F4B
  25+ 9F4B 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9F4C E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9F4E 5F               ld e,a
  28+ 9F4F
  29+ 9F4F 7A               ld a,d
  30+ 9F50 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9F52 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9F54
  33+ 9F54 CB 3F            srl a
  34+ 9F56
  35+ 9F56 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9F57
  37+ 9F57 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9F58 28 04            jr z,4F
  39+ 9F5A
  40+ 9F5A CB FF            set 7,a
  41+ 9F5C 18 02            jr 5F
  42+ 9F5E
  43+ 9F5E CB BF        4 res 7,a
  44+ 9F60
  45+ 9F60 CB 21        5 sla c
  46+ 9F62 10 E0            djnz 6B
  47+ 9F64
  48+ 9F64 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9F65
  50+ 9F65 77               ld (hl),a
  51+ 9F66 23               inc hl
  52+ 9F67 C1               pop bc
  53+ 9F68 10 D4            djnz 3B
  54+ 9F6A
  55+ 9F6A C9               ret
  56+ 9F6B
  57+ 9F6B
  58+ 9F6B
