3117  A21A              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A21A              ; ******************************************************************************************************************************************************************************************
   2+ A21A              ;
   3+ A21A              ;   3/4/25
   4+ A21A              ;
   5+ A21A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A21A              ;   (XOR) bit a bit.
   7+ A21A              ;
   8+ A21A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A21A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A21A
  11+ A21A              Derivando_RND
  12+ A21A
  13+ A21A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A21C C5               push bc
  15+ A21D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A21D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A220              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A220
  19+ A220 A7           6 and a                                 ; Carry a "0".
  20+ A221 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A223 30 02            jr nc,1F
  22+ A225
  23+ A225 CB C1            set 0,c
  24+ A227
  25+ A227 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A228 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A22A 5F               ld e,a
  28+ A22B
  29+ A22B 7A               ld a,d
  30+ A22C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A22E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A230
  33+ A230 CB 3F            srl a
  34+ A232
  35+ A232 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A233
  37+ A233 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A234 28 04            jr z,4F
  39+ A236
  40+ A236 CB FF            set 7,a
  41+ A238 18 02            jr 5F
  42+ A23A
  43+ A23A CB BF        4 res 7,a
  44+ A23C
  45+ A23C CB 21        5 sla c
  46+ A23E 10 E0            djnz 6B
  47+ A240
  48+ A240 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A241
  50+ A241 77               ld (hl),a
  51+ A242 23               inc hl
  52+ A243 C1               pop bc
  53+ A244 10 D4            djnz 3B
  54+ A246
  55+ A246 C9               ret
  56+ A247
  57+ A247
  58+ A247
# file closed: RND_Derivando.asm
