 372+ A3E3              ;
 373+ A3E3              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 374+ A3E3              ;
 375+ A3E3              ;	INPUTS:		B contiene (Numero_de_entidades).
 376+ A3E3              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 377+ A3E3              ; 				HL contiene (Puntero_de_entidades).
 378+ A3E3
 379+ A3E3              Prepara_Cajas_Master:
 380+ A3E3
 381+ A3E3 E5           	push hl															; Push (Puntero_de_entidades).
 382+ A3E4 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 383+ A3E5
 384+ A3E5              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A3E5
 386+ A3E5 79           	ld a,c
 387+ A3E6 08           	ex af,af
 388+ A3E7 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 389+ A3E8
 390+ A3E8 CD 0E A6     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 391+ A3EB              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A3EB              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A3EB A7           	and a
 394+ A3EC 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
 395+ A3EE
 396+ A3EE              ; Generamos movimientos masticados.
 397+ A3EE
 398+ A3EE              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A3EE
 400+ A3EE 79           	ld a,c 															; (A) = (Clase).
 401+ A3EF 32 67 95     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A3F2
 403+ A3F2 CD E7 A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A3F5 CD 79 A7     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 405+ A3F8
 406+ A3F8              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 407+ A3F8              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 408+ A3F8              ;	coreografías distintas.
