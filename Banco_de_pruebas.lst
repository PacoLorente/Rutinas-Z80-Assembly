 767  D323              ; ------------------------------------
 768  D323              ;
 769  D323              ; 	3/7/26
 770  D323              ;
 771  D323              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
 772  D323              ;
 773  D323              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
 774  D323              ;
 775  D323              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
 776  D323              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
 777  D323              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
 778  D323              ;
 779  D323              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
 780  D323              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
 781  D323              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
 782  D323              ;				  _medida que transcurre el tiempo.
 783  D323              ;
 784  D323              ;	OUTPUT: Define (Clock_next_entity).
 785  D323
 786  D323              Define_Clock_next_entity:
 787  D323
 788  D323 21 9B A5     	ld hl,Max_time_to_appear_entities
 789  D326 BE           	cp (hl)
 790  D327
 791  D327 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
 792  D328
 793  D328 38 03        	jr c,1F
 794  D32A
 795  D32A              ;	Por encima o igual que (Max_time_to_appear_entities).
 796  D32A
 797  D32A 4E           	ld c,(hl)
 798  D32B 18 06        	jr 2F
 799  D32D
 800  D32D              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
 801  D32D              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
 802  D32D
 803  D32D 23           1 inc hl
 804  D32E 23           	inc hl
 805  D32F
 806  D32F BE           	cp (hl)
 807  D330
 808  D330 30 01        	jr nc,2F
 809  D332
 810  D332              ;	Por DEBAJO de (Min_time_to_appear_entities).
 811  D332
 812  D332 4E           	ld c,(hl)
 813  D333
 814  D333 3A 78 5C     2 ld a,(FRAMES)
