 347+ 9EA0 D6 20            sub $20             							; Vamos a comprobarlo...
 348+ 9EA2 6F               ld l,a
 349+ 9EA3 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 350+ 9EA4
 351+ 9EA4 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 352+ 9EA5 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 353+ 9EA7 67               ld h,a
 354+ 9EA8 C9               ret
