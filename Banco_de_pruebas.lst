   5+ 9908              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9908              ;   (XOR) bit a bit.
   7+ 9908              ;
   8+ 9908              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9908              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9908
  11+ 9908              Derivando_RND
  12+ 9908
  13+ 9908 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 990A C5               push bc
  15+ 990B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 990B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 990E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 990E
  19+ 990E A7           6 and a                                 ; Carry a "0".
  20+ 990F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9911 30 02            jr nc,1F
  22+ 9913
  23+ 9913 CB C1            set 0,c
  24+ 9915
  25+ 9915 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9916 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9918 5F               ld e,a
  28+ 9919
  29+ 9919 7A               ld a,d
  30+ 991A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 991C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 991E
  33+ 991E CB 3F            srl a
  34+ 9920
  35+ 9920 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9921
  37+ 9921 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9922 28 04            jr z,4F
  39+ 9924
  40+ 9924 CB FF            set 7,a
  41+ 9926 18 02            jr 5F
  42+ 9928
  43+ 9928 CB BF        4 res 7,a
  44+ 992A
  45+ 992A CB 21        5 sla c
  46+ 992C 10 E0            djnz 6B
  47+ 992E
  48+ 992E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 992F
  50+ 992F 77               ld (hl),a
  51+ 9930 23               inc hl
  52+ 9931 C1               pop bc
  53+ 9932 10 D4            djnz 3B
  54+ 9934
  55+ 9934 C9               ret
