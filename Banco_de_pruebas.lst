  10+ A1A8              ;    		 1 ..... AZUL
  11+ A1A8              ; 			 2 ..... ROJO
  12+ A1A8              ;			 3 ..... MAGENTA
  13+ A1A8              ; 			 4 ..... VERDE
  14+ A1A8              ; 			 5 ..... CIAN
  15+ A1A8              ;			 6 ..... AMARILLO
  16+ A1A8              ; 			 7 ..... BLANCO
  17+ A1A8              ;
  18+ A1A8              ;	INPUT: A contiene los atributos de pantalla.
  19+ A1A8              ;
  20+ A1A8              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A1A8
  22+ A1A8
  23+ A1A8 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A1AB 11 01 40     	LD DE,$4001
  25+ A1AE 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A1B1 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A1B3 ED B0        	LDIR
  28+ A1B5 01 FF 02     	LD BC,767
  29+ A1B8 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A1B9 ED B0        	LDIR
  31+ A1BB
  32+ A1BB AF           	xor a
  33+ A1BC
  34+ A1BC C9           	ret
  35+ A1BD
