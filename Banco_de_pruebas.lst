 427  940C 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 428  940D              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 429  940D
 430  940D 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 431  940E 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 432  940F 00           Cola_de_desplazamiento db 0									; Este byte indica:
 433  9410
 434  9410              ;
 435  9410              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 436  9410              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 437  9410              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 438  9410              ;
 439  9410              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 440  9410              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 441  9410              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 442  9410              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 443  9410              ;
 444  9410              ;															;	"$ff" ..... Bucle infinito de repetición.
 445  9410              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 446  9410              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 447  9410
 448  9410 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 449  9411
 450  9411              ;																DESCRIPCIÓN:
 451  9411              ;
 452  9411              ;															BIT 0, "1" Habilita la impresión del msg. DONE en pantalla. La llamada a [Print_DONE] se efectúa desde el Reloj del juego,_
 453  9411              ; 															_ Rutina de interrupciones IM2.
 454  9411
 455  9411 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
