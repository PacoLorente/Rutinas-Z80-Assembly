 171  9175              ;
 172  9175              ; Parámetros DRAW.
 173  9175              ;
 174  9175
 175  9175              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 176  9175
 177  9175 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 178  9176              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 179  9176              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 180  9176              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 181  9176
 182  9176 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 183  9177              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 184  9177 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 185  9178 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 186  9179
 187  9179 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 188  917A              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 189  917A              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 190  917A
 191  917A              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 192  917A              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 193  917A
 194  917A              ; Ejemplos:
 195  917A
 196  917A              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 197  917A              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 198  917A              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 199  917A              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 200  917A              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 201  917A
 202  917A 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 203  917B              ;															  _ que esta entidad haya colisionado con Amadeus.
 204  917B              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 205  917B
 206  917B 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 207  917D              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 208  917D
 209  917D 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 210  917F
 211  917F              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 212  917F
 213  917F 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 214  9181              ;															  _palabras que componen el "movimiento_masticado".
 215  9181
 216  9181              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 217  9181
 218  9181 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 219  9182              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 220  9182              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 221  9182              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 222  9182              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 223  9182
 224  9182 00           Attr db 0 													; Atributos de la entidad.
 225  9183
 226  9183              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 227  9183
 228  9183
 229  9183
 230  9183 00           Ctrl_2 db 0
 231  9184              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 232  9184              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 233  9184              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 234  9184              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 235  9184              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 236  9184              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 237  9184              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 238  9184              ;
 239  9184              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 240  9184              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 241  9184              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 242  9184              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 243  9184              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 244  9184              ;															BIT 4, ???
 245  9184              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 246  9184              ;															BIT 6, "1" Indica que hemos iniciado la "-Transicion_de_salida-" de Amadeus.
 247  9184              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 248  9184              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 249  9184
 250  9184 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 251  9185              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 252  9185              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 253  9185              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 254  9185              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 255  9185              ;
 256  9185              ; 															DESCRIPCIÖN:
 257  9185              ;
 258  9185              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 259  9185              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 260  9185              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 261  9185              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 262  9185              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 263  9185              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 264  9185              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 265  9185              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 266  9185              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 267  9185              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 268  9185              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 269  9185              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 270  9185              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 271  9185              ;
 272  9185              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 273  9185              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 274  9185              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 275  9185
