 616  94C8 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 617  94C9              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 618  94C9
 619  94C9 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 620  94CA 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 621  94CB 00           Cola_de_desplazamiento db 0									; Este byte indica:
 622  94CC
 623  94CC              ;
 624  94CC              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 625  94CC              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 626  94CC              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 627  94CC              ;
 628  94CC              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 629  94CC              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 630  94CC              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 631  94CC              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 632  94CC              ;
 633  94CC              ;															;	"$ff" ..... Bucle infinito de repetición.
 634  94CC              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 635  94CC              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 636  94CC
 637  94CC 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 638  94CD
 639  94CD              ;																DESCRIPCIÓN:
 640  94CD              ;
 641  94CD              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 642  94CD              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 643  94CD              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 644  94CD              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 645  94CD              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 646  94CD              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 647  94CD
 648  94CD              ;															BIT 3, Recarga de nueva oleada.
 649  94CD              ;															BIT 4, Recarga de nueva oleada.
 650  94CD              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 651  94CD              ;															BIT 6, **** Frame completo.
 652  94CD              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 653  94CD
 654  94CD 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 655  94CF              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 656  94CF              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 657  94CF              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 658  94CF              ;
