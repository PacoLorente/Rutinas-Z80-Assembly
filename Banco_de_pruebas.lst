 183  8E30
 184  8E30              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 185  8E30
 186  8E30 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 187  8E31              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 188  8E31              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 189  8E31              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 190  8E31
 191  8E31 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 192  8E32              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 193  8E32 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 194  8E33 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 195  8E34
 196  8E34 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 197  8E35              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 198  8E35              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 199  8E35
 200  8E35              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 201  8E35              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 202  8E35
 203  8E35              ; Ejemplos:
 204  8E35
 205  8E35              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 206  8E35              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 207  8E35              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 208  8E35              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 209  8E35              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 210  8E35
 211  8E35 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 212  8E36              ;															  _ que esta entidad haya colisionado con Amadeus.
 213  8E36              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 214  8E36
 215  8E36 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 216  8E38              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 217  8E38
 218  8E38 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 219  8E3A
 220  8E3A              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 221  8E3A
 222  8E3A 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 223  8E3C              ;															  _palabras que componen el "movimiento_masticado".
 224  8E3C
 225  8E3C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 226  8E3C
 227  8E3C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 228  8E3D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 229  8E3D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 230  8E3D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 231  8E3D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 232  8E3D
