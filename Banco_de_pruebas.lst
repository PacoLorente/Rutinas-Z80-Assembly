  27+ A5C0 ED B0        	LDIR
  28+ A5C2 01 FF 02     	LD BC,767
  29+ A5C5 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A5C6 ED B0        	LDIR
  31+ A5C8
  32+ A5C8 AF           	xor a
  33+ A5C9
  34+ A5C9 C9           	ret
  35+ A5CA
