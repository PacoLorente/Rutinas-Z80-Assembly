  13+ C1E8              ;                                               ; _del menú principal.
  14+ C1E8
  15+ C1E8              ;   Imprime el nombre del campeón y la nueva puntuación máxima justo debajo del cartel Best_Score.
  16+ C1E8              ;   La rutina [Print_text_msg] requiere de los siguientes parámetros para imprimir texto:
  17+ C1E8
  18+ C1E8              ;           HL apunta al mensage a imprimir, (msg).
  19+ C1E8              ;           DE indica la fila de pantalla donde queremos imprimir el msg.
  20+ C1E8              ;            A contiene los attrs. del msg.
  21+ C1E8              ;            B Actúa como temporizador, ralentiza la impresión de caracteres, (simula una máquina de escribir).
  22+ C1E8              ;              No actua cuando su valor es "0".
  23+ C1E8
  24+ C1E8 11 C1 50         ld de,Line_22+1
  25+ C1EB
  26+ C1EB 3E 47            ld a,%01000111
  27+ C1ED 06 00            ld b,0
  28+ C1EF 21 42 96         ld hl,Nombre_del_campeon
  29+ C1F2 CD 04 9F         call Print_text_msg ; v2. Ok.
