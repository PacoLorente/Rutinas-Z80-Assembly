 411+ A3F8 21 07 90     	ld hl,Numeros_aleatorios_baile
 412+ A3FB CD 11 9E     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 413+ A3FE
 414+ A3FE              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 415+ A3FE
 416+ A3FE 3A 68 95     	ld a,(Tipo)
 417+ A401 CD 39 A6     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 418+ A404 CD 8B A5     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
