 689+ 9F5B
 690+ 9F5B              Delay_5:
 691+ 9F5B
 692+ 9F5B 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 693+ 9F5C
 694+ 9F5C 7C               ld a,h
 695+ 9F5D B5               or l
 696+ 9F5E 20 FB            jr nz,Delay_5
 697+ 9F60
 698+ 9F60 2A B6 94         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 699+ 9F63
 700+ 9F63 AF               xor a                   ; Borde negro.    ---     4 tstates
 701+ 9F64 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
