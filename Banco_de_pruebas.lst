 621  941E 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 622  9420
 623  9420 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 624  9421              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 625  9421              ;															; _baja de la pantalla cuando hemos superado el nivel.
 626  9421
 627  9421 00           Columnas db 0
 628  9422 00           Limite_vertical db 0 										; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 629  9423              ;															; 2ª Función de (Limite_vertical):
 630  9423              ;															; Se inicializa a "0" cada vez que ejecutamos el bucle de entidades. Se utiliza como contador; se incrementa (+1) cada vez que se añade una_
 631  9423              ;															; _descripción a la (Tabla_de_pintado). Este valor lo utiliza la rutina [Ordena_tabla_de_pintado] para ordenar la tabla antes de imprimir.
 632  9423
 633  9423
 634  9423
 635  9423              ; Variables de control general.
 636  9423
 637  9423 00           Frames_explosion db 0 										; Nº de Frames que tiene la explosión.
 638  9424
 639  9424              ; Variables de funcionamiento, (No incluidas en base de datos de entidades), a partir de aquí!!!!!
 640  9424
 641  9424              Perfiles_de_velocidad
 642  9424
 643  9424 00           Vel_left db 0 												; Velocidad izquierda. Nº de píxeles que desplazamos el objeto a izquierda. 1, 2, 4 u 8 px.
 644  9425 00           Vel_right db 0 												; Velocidad derecha. Nº de píxeles que desplazamos el objeto a derecha. 1, 2, 4 u 8 px.
 645  9426 00           Vel_up db 0 												; Velocidad subida. Nº de píxeles que desplazamos el objeto hacia arriba. (De 1 a 7px).
 646  9427 00           Vel_down db 0 												; Velocidad bajada. Nº de píxeles que desplazamos el objeto hacia abajo. (De 1 a 7px).
