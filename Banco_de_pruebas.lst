   5+ 95D1              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 95D1              ;   (XOR) bit a bit.
   7+ 95D1              ;
   8+ 95D1              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 95D1              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 95D1
  11+ 95D1              Derivando_RND
  12+ 95D1
  13+ 95D1 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 95D3 C5               push bc
  15+ 95D4              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 95D4 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 95D7              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 95D7
  19+ 95D7 A7           6 and a                                 ; Carry a "0".
  20+ 95D8 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 95DA 30 02            jr nc,1F
  22+ 95DC
  23+ 95DC CB C1            set 0,c
  24+ 95DE
  25+ 95DE 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 95DF E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 95E1 5F               ld e,a
  28+ 95E2
  29+ 95E2 7A               ld a,d
  30+ 95E3 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 95E5 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 95E7
  33+ 95E7 CB 3F            srl a
  34+ 95E9
  35+ 95E9 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 95EA
  37+ 95EA 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 95EB 28 04            jr z,4F
  39+ 95ED
  40+ 95ED CB FF            set 7,a
  41+ 95EF 18 02            jr 5F
  42+ 95F1
  43+ 95F1 CB BF        4 res 7,a
  44+ 95F3
  45+ 95F3 CB 21        5 sla c
  46+ 95F5 10 E0            djnz 6B
  47+ 95F7
  48+ 95F7 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 95F8
  50+ 95F8 77               ld (hl),a
  51+ 95F9 23               inc hl
  52+ 95FA C1               pop bc
  53+ 95FB 10 D4            djnz 3B
  54+ 95FD
  55+ 95FD C9               ret
  56+ 95FE
  57+ 95FE
  58+ 95FE
