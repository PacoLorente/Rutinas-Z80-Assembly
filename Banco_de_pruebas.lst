 843+ B61A C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B61B
 845+ B61B 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B61C D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B61E 6F               ld l,a
 848+ B61F D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B620
 850+ B620 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B621 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B623 67               ld h,a
 853+ B624 C9               ret
