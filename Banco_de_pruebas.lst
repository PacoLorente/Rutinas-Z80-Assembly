   4+ 948D              ;
   5+ 948D              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 948D              ;   (XOR) bit a bit.
   7+ 948D              ;
   8+ 948D              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 948D              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 948D
  11+ 948D              Derivando_RND
  12+ 948D
  13+ 948D ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 948F C5               push bc
  15+ 9490              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9490 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9493              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9493
  19+ 9493 A7           6 and a                                 ; Carry a "0".
  20+ 9494 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9496 30 02            jr nc,1F
  22+ 9498
  23+ 9498 CB C1            set 0,c
  24+ 949A
  25+ 949A 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 949B E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 949D 5F               ld e,a
  28+ 949E
  29+ 949E 7A               ld a,d
  30+ 949F E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94A1 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94A3
  33+ 94A3 CB 3F            srl a
  34+ 94A5
  35+ 94A5 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 94A6
  37+ 94A6 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 94A7 28 04            jr z,4F
  39+ 94A9
  40+ 94A9 CB FF            set 7,a
  41+ 94AB 18 02            jr 5F
  42+ 94AD
  43+ 94AD CB BF        4 res 7,a
  44+ 94AF
  45+ 94AF CB 21        5 sla c
  46+ 94B1 10 E0            djnz 6B
  47+ 94B3
  48+ 94B3 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94B4
  50+ 94B4 77               ld (hl),a
  51+ 94B5 23               inc hl
  52+ 94B6 C1               pop bc
  53+ 94B7 10 D4            djnz 3B
  54+ 94B9
  55+ 94B9 C9               ret
  56+ 94BA
  57+ 94BA
  58+ 94BA
