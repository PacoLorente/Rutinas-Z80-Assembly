   5+ 95D3              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 95D3              ;   (XOR) bit a bit.
   7+ 95D3              ;
   8+ 95D3              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 95D3              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 95D3
  11+ 95D3              Derivando_RND
  12+ 95D3
  13+ 95D3 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 95D5 C5               push bc
  15+ 95D6              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 95D6 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 95D9              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 95D9
  19+ 95D9 A7           6 and a                                 ; Carry a "0".
  20+ 95DA CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 95DC 30 02            jr nc,1F
  22+ 95DE
  23+ 95DE CB C1            set 0,c
  24+ 95E0
  25+ 95E0 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 95E1 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 95E3 5F               ld e,a
  28+ 95E4
  29+ 95E4 7A               ld a,d
  30+ 95E5 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 95E7 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 95E9
  33+ 95E9 CB 3F            srl a
  34+ 95EB
  35+ 95EB AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 95EC
  37+ 95EC 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 95ED 28 04            jr z,4F
  39+ 95EF
  40+ 95EF CB FF            set 7,a
  41+ 95F1 18 02            jr 5F
  42+ 95F3
  43+ 95F3 CB BF        4 res 7,a
  44+ 95F5
  45+ 95F5 CB 21        5 sla c
  46+ 95F7 10 E0            djnz 6B
  47+ 95F9
  48+ 95F9 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 95FA
  50+ 95FA 77               ld (hl),a
  51+ 95FB 23               inc hl
  52+ 95FC C1               pop bc
  53+ 95FD 10 D4            djnz 3B
  54+ 95FF
  55+ 95FF C9               ret
