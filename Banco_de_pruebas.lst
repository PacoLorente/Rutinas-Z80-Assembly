  53+ C03C
  54+ C03C 13               inc de
  55+ C03D 13               inc de
  56+ C03E
  57+ C03E ED 53 0F 96      ld (Puntero_game_over_noise),de                   ; Puntero situado en la siguiente nota del índice.
  58+ C042
  59+ C042              Get_note:
  60+ C042
  61+ C042 ED 73 B0 95      ld (Stack),sp
  62+ C046
  63+ C046 F9               ld sp,hl
  64+ C047
  65+ C047 C1               pop bc                                            ; (B) siempre "0", (C) indica duración de la nota, (n°de ondas).
  66+ C048 D1               pop de                                            ; (DE) siempre contendrá "0".
  67+ C049 E1               pop hl                                            ; (H) = "0", (L) contiene el valor de la nota.
  68+ C04A
  69+ C04A              ;   Tenemos la nota cargada en os registros.
