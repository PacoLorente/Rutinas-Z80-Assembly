 267+ A3A6
 268+ A3A6 21 7A 91     	ld hl,Numeros_aleatorios+7						; Dirección de memoria donde se almacena el último n° pseudo aleatorio generado +1.
 269+ A3A9 ED 5B 3B 96  	ld de,(RND_SP) 									; Puntero que se irá desplazando por el SET de nº aleatorios. Inicialmente apunta al 1°.
 270+ A3AD
 271+ A3AD              ;													; (HL) contiene la dirección del n° aleatorio que vamos a extraer.
 272+ A3AD              ;													; (DE)     "           "      "  último n° aleatorio +1, (detecta reinicio).
 273+ A3AD
 274+ A3AD A7           	and a 											; Carry a "0".
 275+ A3AE
 276+ A3AE ED 52        	sbc hl,de 										; Detecta el final de la caja de n° pseudo aleatorios.
 277+ A3B0 20 08        	jr nz,1F
 278+ A3B2
 279+ A3B2              ; 	Inicializa el puntero al principio de la caja de nº aleatorios pseudo aleatorios.
