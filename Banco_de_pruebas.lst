 489  93C6              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 490  93C6
 491  93C6 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 492  93C7 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 493  93C8 00           Cola_de_desplazamiento db 0									; Este byte indica:
 494  93C9
 495  93C9              ;
 496  93C9              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 497  93C9              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 498  93C9              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 499  93C9              ;
 500  93C9              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 501  93C9              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 502  93C9              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 503  93C9              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 504  93C9              ;
 505  93C9              ;															;	"$ff" ..... Bucle infinito de repetición.
 506  93C9              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 507  93C9              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 508  93C9
