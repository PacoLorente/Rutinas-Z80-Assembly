  12+ 9D61
  13+ 9D61 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D63 C5               push bc
  15+ 9D64              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D64 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D67              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D67
  19+ 9D67 A7           6 and a                                 ; Carry a "0".
  20+ 9D68 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D6A 30 02            jr nc,1F
  22+ 9D6C
  23+ 9D6C CB C1            set 0,c
  24+ 9D6E
  25+ 9D6E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D6F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D71 5F               ld e,a
  28+ 9D72
  29+ 9D72 7A               ld a,d
  30+ 9D73 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D75 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D77
  33+ 9D77 CB 3F            srl a
  34+ 9D79
  35+ 9D79 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D7A
  37+ 9D7A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D7B 28 04            jr z,4F
  39+ 9D7D
  40+ 9D7D CB FF            set 7,a
  41+ 9D7F 18 02            jr 5F
  42+ 9D81
  43+ 9D81 CB BF        4 res 7,a
  44+ 9D83
  45+ 9D83 CB 21        5 sla c
  46+ 9D85 10 E0            djnz 6B
  47+ 9D87
  48+ 9D87 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D88
  50+ 9D88 77               ld (hl),a
