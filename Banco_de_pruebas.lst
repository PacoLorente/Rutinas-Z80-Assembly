 138  8C09              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 8C09
   2+ 8C09
   3+ 8C09              ;   07/07/23
   4+ 8C09              ;
   5+ 8C09              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8C09              ;
   7+ 8C09              ;   Codificación:
   8+ 8C09              ;
   9+ 8C09              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8C09              ;
  11+ 8C09              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8C09              ;
  13+ 8C09              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8C09              ;
  15+ 8C09              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8C09              ;
  17+ 8C09              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8C09              ;                               ..... %01000010 Vel_up 4
  19+ 8C09              ;                                               Vel_down 2
  20+ 8C09              ;                               ..... $42
  21+ 8C09              ;
  22+ 8C09              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8C09              ;
  24+ 8C09              ;                               ..... %01000010 Vel_left 4
  25+ 8C09              ;                                               Vel_right 2
  26+ 8C09              ;                               ..... $42
  27+ 8C09              ;
  28+ 8C09              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8C09              ;
  30+ 8C09              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8C09              ;
  32+ 8C09              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8C09              ;
  34+ 8C09              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8C09              ;                                     $53
  36+ 8C09              ;
  37+ 8C09              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8C09              ;
  39+ 8C09              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8C09              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8C09              ;
  42+ 8C09              ;                       Arriba ..... $81
  43+ 8C09              ;                       Arriba - izquierda ..... $a1
  44+ 8C09              ;                       Arriba - derecha ..... $91
  45+ 8C09              ;
  46+ 8C09              ;                       Abajo ..... $41
  47+ 8C09              ;                       Abajo - izquierda ..... $61
  48+ 8C09              ;                       Abajo - derecha ..... $51
  49+ 8C09              ;
  50+ 8C09              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8C09              ;
  52+ 8C09              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8C09              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8C09              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8C09              ;
  56+ 8C09              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8C09              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8C09              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8C09              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8C09              ;
  61+ 8C09              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8C09              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8C09              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8C09              ;
  65+ 8C09              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8C09              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8C09              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8C09              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8C09
  70+ 8C09              ; ----- ----- ----- ----- -----
  71+ 8C09              Indice_mov_Baile_de_Badplate
  72+ 8C09
  73+ 8C09 0D 8C            defw Left_Ini82
  74+ 8C0B 17 8C            defw Right_Ini82
  75+ 8C0D
  76+ 8C0D 81 8C        Left_Ini82 defw Bajo_decelerando
  77+ 8C0F 89 8C            defw F_1
  78+ 8C11 93 8C            defw F_2
  79+ 8C13 EA A2            defw Desplaza_derecha
  80+ 8C15 00 00            defw 0
