   5+ 941D              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 941D              ;   (XOR) bit a bit.
   7+ 941D              ;
   8+ 941D              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 941D
  10+ 941D              Derivando_RND
  11+ 941D
  12+ 941D 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9420
  14+ 9420 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9422 C5               push bc
  16+ 9423              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9423 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9426              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9426
  20+ 9426 A7           6 and a                                 ; Carry a "0".
  21+ 9427 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9429 30 02            jr nc,1F
  23+ 942B
  24+ 942B CB C1            set 0,c
  25+ 942D
  26+ 942D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 942E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9430 5F               ld e,a
  29+ 9431
  30+ 9431 7A               ld a,d
  31+ 9432 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9434 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9436
  34+ 9436 CB 3F            srl a
  35+ 9438
  36+ 9438 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9439
  38+ 9439 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 943A 28 04            jr z,4F
  40+ 943C
  41+ 943C CB FF            set 7,a
  42+ 943E 18 02            jr 5F
  43+ 9440
  44+ 9440 CB BF        4 res 7,a
  45+ 9442
  46+ 9442 CB 21        5 sla c
  47+ 9444 10 E0            djnz 6B
  48+ 9446
  49+ 9446 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9447
  51+ 9447 77               ld (hl),a
  52+ 9448 23               inc hl
  53+ 9449 C1               pop bc
  54+ 944A 10 D4            djnz 3B
  55+ 944C
  56+ 944C C9               ret
  57+ 944D
  58+ 944D
  59+ 944D
