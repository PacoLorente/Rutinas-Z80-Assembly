   5+ 942B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 942B              ;   (XOR) bit a bit.
   7+ 942B              ;
   8+ 942B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 942B
  10+ 942B              Derivando_RND
  11+ 942B
  12+ 942B 21 F6 88         ld hl,Numeros_aleatorios
  13+ 942E
  14+ 942E ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9430 C5               push bc
  16+ 9431              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9431 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9434              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9434
  20+ 9434 A7           6 and a                                 ; Carry a "0".
  21+ 9435 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9437 30 02            jr nc,1F
  23+ 9439
  24+ 9439 CB C1            set 0,c
  25+ 943B
  26+ 943B 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 943C E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 943E 5F               ld e,a
  29+ 943F
  30+ 943F 7A               ld a,d
  31+ 9440 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9442 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9444
  34+ 9444 CB 3F            srl a
  35+ 9446
  36+ 9446 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9447
  38+ 9447 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9448 28 04            jr z,4F
  40+ 944A
  41+ 944A CB FF            set 7,a
  42+ 944C 18 02            jr 5F
  43+ 944E
  44+ 944E CB BF        4 res 7,a
  45+ 9450
  46+ 9450 CB 21        5 sla c
  47+ 9452 10 E0            djnz 6B
  48+ 9454
  49+ 9454 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9455
  51+ 9455 77               ld (hl),a
  52+ 9456 23               inc hl
  53+ 9457 C1               pop bc
  54+ 9458 10 D4            djnz 3B
  55+ 945A
  56+ 945A C9               ret
  57+ 945B
