 431+ C166              ;   -------------------------------------------------------------------------------------------
 432+ C166              ;
 433+ C166              ;   23/9/26
 434+ C166              ;
 435+ C166              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C166              ;
 437+ C166              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C166              ;   _ [Sound_Generator].
 439+ C166              ;
 440+ C166              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C166              ;
 442+ C166              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C166              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C166              ;
 445+ C166              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C166              ;
 447+ C166              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C166              ;
 449+ C166              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C166
 451+ C166              Play_burst_sound_effect:
 452+ C166
 453+ C166              ;   Exclusiones:
 454+ C166
 455+ C166 3A 98 94         ld a,(Burst_sound)
 456+ C169 A7               and a
 457+ C16A C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C16B
 459+ C16B 08               ex af,af
 460+ C16C
 461+ C16C 3A 69 94         ld a,(Ctrl_6)
 462+ C16F CB 47            bit 0,a
 463+ C171 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C172
 465+ C172              ;   ----------------------
 466+ C172
 467+ C172 CB C7            set 0,a
 468+ C174 32 69 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C177
 470+ C177 08               ex af,af                ; Restore (Burst_sound).
 471+ C178
 472+ C178 67               ld h,a
 473+ C179 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C17B
 475+ C17B E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C17C
 477+ C17C 22 92 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C17F 0E 03            ld c,3
 479+ C181 CD 35 9F         call Noise_efect
