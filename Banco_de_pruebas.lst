   5+ 9DAD              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9DAD              ;   (XOR) bit a bit.
   7+ 9DAD              ;
   8+ 9DAD              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9DAD              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9DAD
  11+ 9DAD              Derivando_RND
  12+ 9DAD
  13+ 9DAD ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9DAF C5               push bc
  15+ 9DB0              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9DB0 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9DB3              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9DB3
  19+ 9DB3 A7           6 and a                                 ; Carry a "0".
  20+ 9DB4 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9DB6 30 02            jr nc,1F
  22+ 9DB8
  23+ 9DB8 CB C1            set 0,c
  24+ 9DBA
  25+ 9DBA 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9DBB E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9DBD 5F               ld e,a
  28+ 9DBE
  29+ 9DBE 7A               ld a,d
  30+ 9DBF E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9DC1 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9DC3
  33+ 9DC3 CB 3F            srl a
  34+ 9DC5
  35+ 9DC5 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9DC6
  37+ 9DC6 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9DC7 28 04            jr z,4F
  39+ 9DC9
  40+ 9DC9 CB FF            set 7,a
  41+ 9DCB 18 02            jr 5F
  42+ 9DCD
  43+ 9DCD CB BF        4 res 7,a
  44+ 9DCF
  45+ 9DCF CB 21        5 sla c
  46+ 9DD1 10 E0            djnz 6B
  47+ 9DD3
  48+ 9DD3 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9DD4
  50+ 9DD4 77               ld (hl),a
  51+ 9DD5 23               inc hl
  52+ 9DD6 C1               pop bc
  53+ 9DD7 10 D4            djnz 3B
  54+ 9DD9
  55+ 9DD9 C9               ret
