 249  9185              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 9185
   2+ 9185
   3+ 9185              ;   07/07/23
   4+ 9185              ;
   5+ 9185              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 9185              ;
   7+ 9185              ;   Codificación:
   8+ 9185              ;
   9+ 9185              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 9185              ;
  11+ 9185              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 9185              ;
  13+ 9185              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 9185              ;
  15+ 9185              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 9185              ;
  17+ 9185              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 9185              ;                               ..... %01000010 Vel_up 4
  19+ 9185              ;                                               Vel_down 2
  20+ 9185              ;                               ..... $42
  21+ 9185              ;
  22+ 9185              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 9185              ;
  24+ 9185              ;                               ..... %01000010 Vel_left 4
  25+ 9185              ;                                               Vel_right 2
  26+ 9185              ;                               ..... $42
  27+ 9185              ;
  28+ 9185              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 9185              ;
  30+ 9185              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 9185              ;
  32+ 9185              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 9185              ;
  34+ 9185              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 9185              ;                                     $53
  36+ 9185              ;
  37+ 9185              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 9185              ;
  39+ 9185              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 9185              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 9185              ;
  42+ 9185              ;                       Arriba ..... $81
  43+ 9185              ;                       Arriba - izquierda ..... $a1
  44+ 9185              ;                       Arriba - derecha ..... $91
  45+ 9185              ;
  46+ 9185              ;                       Abajo ..... $41
  47+ 9185              ;                       Abajo - izquierda ..... $61
  48+ 9185              ;                       Abajo - derecha ..... $51
  49+ 9185              ;
  50+ 9185              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 9185              ;
  52+ 9185              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 9185              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 9185              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 9185              ;
  56+ 9185              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 9185              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 9185              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 9185              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 9185              ;
  61+ 9185              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 9185              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 9185              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 9185              ;
  65+ 9185              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 9185              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 9185              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 9185              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 9185
