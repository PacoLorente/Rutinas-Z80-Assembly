   1+ C024              ; ----------------------------------------------------------
   2+ C024              ;
   3+ C024              ;   26/09/26
   4+ C024              ;
   5+ C024              ;   Voy a utilizar los 6 bytes de las variables:
   6+ C024              ;
   7+ C024              ;   (Indice_Sprite_der)
   8+ C024              ;   (Indice_Sprite_izq)
   9+ C024              ;   (Puntero_DESPLZ_der)
  10+ C024              ;
  11+ C024              ;   Para almacenar el perfil de la nota que está en ejecución pues la rutina se ejecuta "IN GAME TIME" y sólo reproducirá 4 ondas_
  12+ C024              ;   _del total que forman la nota.
  13+ C024              ;
  14+ C024              ;   La rutina genera un "ruido" o especie de zumbido ascendente/descendente llamando a la rutina [Sound_Generator].
  15+ C024              ;   La melodía consta de dos notas incluidas en el índice: "Game_over_noise_index:". El puntero (Puntero_game_over_noise) avanza_
  16+ C024              ;   _ por el índice proporcionando los datos de las notas a la rutina.
  17+ C024              ;
  18+ C024              ;   La rutina [Sound_Generator] requiere que los parámetros de la nota a ejecutar se den de la siguiente forma:
  19+ C024              ;
  20+ C024              ;           C contiene el nº de veces que vamos a generar la onda del sonido.
  21+ C024              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
  22+ C024              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
  23+ C024              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
  24+ C024              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
  25+ C024              ;
  26+ C024              ;   MODIFY: AF, HL, BC y DE, (Puntero_game_over_noise).
  27+ C024
  28+ C024              Game_over_noise:
  29+ C024
  30+ C024              ;   Nota en ejecución??
  31+ C024
  32+ C024 21 7E 95         ld hl,Indice_Sprite_der                           ; Caja de nota en ejecución.
  33+ C027 7E               ld a,(hl)
  34+ C028 A7               and a
  35+ C029 28 02            jr z,New_note                                     ; Caja vacía o anterior nota finalizada. Adquiere una nueva nota del índice de notas de la canción.
  36+ C02B
  37+ C02B 18 0F            jr Get_note                                       ; No hemos terminado de ejecutar la nota. Recuperamos el 'resto' de la nota de la caja.
  38+ C02D
  39+ C02D              ;   Extrae una nueva, (o primera nota) del índice de notas de la canción.
  40+ C02D
  41+ C02D              New_note:
  42+ C02D
  43+ C02D 2A 0F 96         ld hl,(Puntero_game_over_noise)
  44+ C030 CD 36 9E         call Extrae_address
  45+ C033
