 192+ C1CE
 193+ C1CE              ;   El dígito es "0".
 194+ C1CE
 195+ C1CE 0C               inc c
 196+ C1CF 0D               dec c
 197+ C1D0 20 03            jr nz,3F
 198+ C1D2
 199+ C1D2 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 200+ C1D3 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 201+ C1D5
 202+ C1D5 D5           3 push de                                    ; PUSH Score_max_msg.
