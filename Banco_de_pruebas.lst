   5+ 99A2              ; DRAW. ************************************************************************************************************************************************************************************
   6+ 99A2
   7+ 99A2              Draw
   8+ 99A2
   9+ 99A2 CD 4F 9B     	call Prepara_draw
  10+ 99A5 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 99A6 A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 99A7 28 05        	jr z,2F
  13+ 99A9
  14+ 99A9 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99AC 18 0C        	jr 1F
  16+ 99AE
  17+ 99AE              ;	Inicia entidad.
  18+ 99AE
  19+ 99AE 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  20+ 99B1 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  21+ 99B4
  22+ 99B4 CD 8F 9A     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  23+ 99B7              ;													; _la esquina superior izquierda de la pantalla.
  24+ 99B7 CD E7 9F     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  25+ 99BA
  26+ 99BA 3A F7 8B     1 ld a,(Ctrl_0)
  27+ 99BD CB 6F        	bit 5,a
  28+ 99BF 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  29+ 99C1
  30+ 99C1 CD 0F 9A     	call Comprueba_limite_horizontal
  31+ 99C4 CD 44 9A     	call Comprueba_limite_vertical
  32+ 99C7
  33+ 99C7              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  34+ 99C7              ; -----------------------
  35+ 99C7              ; -----------------------
  36+ 99C7              ; -----------------------
  37+ 99C7
  38+ 99C7 CD C9 9A     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  39+ 99CA CD ED 9A     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  40+ 99CD
  41+ 99CD 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina restauramos los bits 0,1,2,3 y 5 de (Ctrl_0).
  42+ 99D0 E6 D0        	and $d0
  43+ 99D2 32 F7 8B     	ld (Ctrl_0),a
  44+ 99D5
  45+ 99D5 C9           	ret
