 308  9392              ;
 309  9392              ; Parámetros DRAW.
 310  9392              ;
 311  9392
 312  9392              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 313  9392
 314  9392 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 315  9393              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 316  9393              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 317  9393              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 318  9393
 319  9393 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 320  9394              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 321  9394 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 322  9395 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 323  9396
 324  9396 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 325  9397              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 326  9397              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 327  9397
 328  9397              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 329  9397              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 330  9397
 331  9397              ; Ejemplos:
 332  9397
 333  9397              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 334  9397              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 335  9397              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 336  9397              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 337  9397              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 338  9397
 339  9397 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 340  9398              ;															  _ que esta entidad haya colisionado con Amadeus.
 341  9398              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 342  9398
 343  9398 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 344  939A              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 345  939A
 346  939A 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 347  939C
 348  939C              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 349  939C
 350  939C 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 351  939E              ;															  _palabras que componen el "movimiento_masticado".
 352  939E
 353  939E              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 354  939E
 355  939E 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 356  939F              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 357  939F              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 358  939F              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 359  939F              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 360  939F
 361  939F 00           Attr db 0 													; Atributos de la entidad.
 362  93A0
 363  93A0              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 364  93A0
 365  93A0
 366  93A0
 367  93A0 00           Ctrl_2 db 0
 368  93A1              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 369  93A1              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 370  93A1              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 371  93A1              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 372  93A1              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 373  93A1              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 374  93A1              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 375  93A1              ;
 376  93A1              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 377  93A1              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 378  93A1              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 379  93A1              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 380  93A1              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 381  93A1              ;															BIT 4, ???
 382  93A1              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 383  93A1              ;															BIT 6, "1" Indica que hemos iniciado la "-Transicion_de_salida-" de Amadeus.
 384  93A1              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 385  93A1              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 386  93A1
 387  93A1 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 388  93A2              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 389  93A2              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 390  93A2              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 391  93A2              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 392  93A2              ;
 393  93A2              ; 															DESCRIPCIÖN:
 394  93A2              ;
 395  93A2              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 396  93A2              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 397  93A2              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 398  93A2              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 399  93A2              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 400  93A2              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 401  93A2              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 402  93A2              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 403  93A2              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 404  93A2              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 405  93A2              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 406  93A2              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 407  93A2              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 408  93A2              ;
 409  93A2              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 410  93A2              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 411  93A2              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 412  93A2
 413  93A2 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 414  93A3              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 415  93A3              ;															; _rojo - amarillo.
 416  93A3
 417  93A3 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 418  93A4              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 419  93A4
