 360  92BB 00 00        Puntero_tabla_Random defw 0
 361  92BD 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 362  92BF 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 363  92C1 00 00        Puntero_indice_mov_bucle defw 0
 364  92C3              ;
 365  92C3              ;
 366  92C3 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 367  92C4              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 368  92C4              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 369  92C4
 370  92C4 00           Incrementa_puntero_backup db 0
 371  92C5 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 372  92C6              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 373  92C6
 374  92C6 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 375  92C7 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 376  92C8 00           Cola_de_desplazamiento db 0									; Este byte indica:
 377  92C9
 378  92C9              ;
 379  92C9              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 380  92C9              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 381  92C9              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 382  92C9              ;
 383  92C9              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 384  92C9              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 385  92C9              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 386  92C9              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 387  92C9              ;
 388  92C9              ;															;	"$ff" ..... Bucle infinito de repetición.
 389  92C9              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 390  92C9              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 391  92C9
 392  92C9 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 393  92CA
 394  92CA              ;																DESCRIPCIÓN:
 395  92CA              ;
 396  92CA              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 397  92CA              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 398  92CA              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 399  92CA              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 400  92CA              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 401  92CA              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 402  92CA
