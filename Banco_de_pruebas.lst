 495+ A436              ;
 496+ A436              ;	20/07/26
 497+ A436              ;
 498+ A436              ;	Asigna una columna de inicio aleatoria y distinta a cada una de las 3 Clases como máximo que pueden aparecer en un nivel.
 499+ A436
 500+ A436              Determina_posicion_de_inicio:
 501+ A436
 502+ A436 21 0A 90     	ld hl,Numeros_aleatorios_baile+3
 503+ A439 7E           	ld a,(hl)
 504+ A43A E6 1F        	and $1f															; Define el nº de columna por el que va a aparecer la entidad.
 505+ A43C
 506+ A43C              ;	Tenemos un nº aleatorio, (Columna de inicio) en A.
 507+ A43C              ; 	No queremos que se repita la posición de inicio en dos clases distintas de entidades.
 508+ A43C
 509+ A43C 57           	ld d,a 															; $08,$12,$0c --- $08,$02,$12 --- $18,$1c,$18 --- $1e,$1c,$18
