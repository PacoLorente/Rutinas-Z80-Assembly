 651  942C 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 652  942E 00 00        Puntero_indice_mov_bucle defw 0
 653  9430              ;
 654  9430              ;
