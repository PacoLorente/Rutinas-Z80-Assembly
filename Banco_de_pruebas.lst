  79+ 9446              ;	El siguiente .defw indica:
  80+ 9446              ;
  81+ 9446              ;	Byte alto: Límite superior que puede tener como máximo nuestro nº rnd.
  82+ 9446              ;	Byte bajo: Límite inferior que puede tener como mínimo nuestro nº rnd.
  83+ 9446              ;
  84+ 9446              ;	Los sucesivos .defw indican la dirección o direcciones de memoria correspondientes donde se almacenará el nº aleatorio.
