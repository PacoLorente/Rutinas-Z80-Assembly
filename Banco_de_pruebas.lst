   1+ A0F0              ; ******************************************************************************************************************************************************************************************
   2+ A0F0              ;
   3+ A0F0              ;   3/4/25
   4+ A0F0              ;
   5+ A0F0              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0F0              ;   (XOR) bit a bit.
   7+ A0F0              ;
   8+ A0F0              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0F0              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0F0
  11+ A0F0              Derivando_RND
  12+ A0F0
  13+ A0F0 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0F2 C5               push bc
  15+ A0F3              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0F3 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0F6              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0F6
  19+ A0F6 A7           6 and a                                 ; Carry a "0".
  20+ A0F7 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0F9 30 02            jr nc,1F
  22+ A0FB
  23+ A0FB CB C1            set 0,c
  24+ A0FD
  25+ A0FD 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0FE E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A100 5F               ld e,a
  28+ A101
  29+ A101 7A               ld a,d
  30+ A102 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A104 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A106
  33+ A106 CB 3F            srl a
  34+ A108
  35+ A108 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A109
  37+ A109 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A10A 28 04            jr z,4F
  39+ A10C
  40+ A10C CB FF            set 7,a
  41+ A10E 18 02            jr 5F
  42+ A110
  43+ A110 CB BF        4 res 7,a
  44+ A112
  45+ A112 CB 21        5 sla c
  46+ A114 10 E0            djnz 6B
  47+ A116
  48+ A116 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A117
  50+ A117 77               ld (hl),a
  51+ A118 23               inc hl
  52+ A119 C1               pop bc
  53+ A11A 10 D4            djnz 3B
  54+ A11C
  55+ A11C C9               ret
  56+ A11D
  57+ A11D
  58+ A11D
# file closed: RND_Derivando.asm
