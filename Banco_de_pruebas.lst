 690+ 9F5C 06 08            ld b,8                                  ;   Nº de lineas que forman el caracter.
 691+ 9F5E
 692+ 9F5E E5               push hl
 693+ 9F5F
 694+ 9F5F 1A           1 ld a,(de)
 695+ 9F60 77               ld (hl),a                               ;   Print
 696+ 9F61
 697+ 9F61 24               inc h                                   ;   INC scanline.
 698+ 9F62 1C               inc e                                   ;   INC data address
 699+ 9F63
 700+ 9F63 10 FA            djnz 1B
 701+ 9F65
 702+ 9F65 E1               pop hl
 703+ 9F66
 704+ 9F66 C9               ret
