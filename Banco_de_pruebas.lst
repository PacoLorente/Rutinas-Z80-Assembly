1487+ B099 21 DD 91         ld hl,Impacto2
1488+ B09C CB 96            res 2,(hl)
1489+ B09E 2A DE 91         ld hl,(Entidad_sospechosa_de_colision)
1490+ B0A1 36 00            ld (hl),0                                       ; Coloca a "0" el .db (Impacto) de la (Entidad_sospechosa_de_colision).
1491+ B0A3 C9               ret
1492+ B0A4
1493+ B0A4              ;   COLISIÓN !!!!!.
1494+ B0A4              ;
1495+ B0A4              ;   .db (Impacto) de Amadeus a "1".
1496+ B0A4              ;   SET el bit3 de (Impacto2).
1497+ B0A4              ;
1498+ B0A4              ;   Nota: El .db (Impacto) de la entidad implicada lo puso a "1" la rutina [Compara_coordenadas_X].
1499+ B0A4
1500+ B0A4 E1           5 pop hl
1501+ B0A5 C1               pop bc
1502+ B0A6
1503+ B0A6 21 D7 8D         ld hl,Impacto_Amadeus
1504+ B0A9 36 01            ld (hl),1
1505+ B0AB 21 DD 91         ld hl,Impacto2                                 ; Cuando se produce Colisión, RES el bit2 de (Impacto2) y_
1506+ B0AE CB 96            res 2,(hl)                                     ; _ SET el bit3. El bit3 de (Impacto2) indica que hay contacto_
1507+ B0B0
1508+ B0B0 11 90 8B         ld de,Indice_Explosion_entidades
1509+ B0B3 2A DE 91         ld hl,(Entidad_sospechosa_de_colision)         ; Situamos el (Puntero_de_almacen_de_mov_masticados) de la entidad impactada en la primera palabra del índice de explosiones.
1510+ B0B6
1511+ B0B6 23               inc hl
1512+ B0B7 23               inc hl
1513+ B0B8 23               inc hl
1514+ B0B9
1515+ B0B9 73               ld (hl),e
1516+ B0BA 23               inc hl
1517+ B0BB 72               ld (hl),d
1518+ B0BC
1519+ B0BC              ; Situamos también el (Puntero_de_almacen_de_mov_masticados) de Amadeus en la primero explosión.
1520+ B0BC
1521+ B0BC 11 30 8C         ld de,Indice_Explosion_Amadeus
1522+ B0BF 21 DA 8D         ld hl,Pamm_Amadeus
1523+ B0C2
1524+ B0C2 73               ld (hl),e
1525+ B0C3 23               inc hl
1526+ B0C4 72               ld (hl),d
1527+ B0C5
1528+ B0C5 C9               ret
1529+ B0C6
1530+ B0C6
1531+ B0C6
1532+ B0C6
