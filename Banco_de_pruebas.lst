 624+ B471
 625+ B471 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 626+ B472 D6 20            sub $20             							; Vamos a comprobarlo...
 627+ B474 6F               ld l,a
