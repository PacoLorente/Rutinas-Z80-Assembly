   5+ 9433              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9433              ;   (XOR) bit a bit.
   7+ 9433              ;
   8+ 9433              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9433
  10+ 9433              Derivando_RND
  11+ 9433
  12+ 9433 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9436
  14+ 9436 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9438 C5               push bc
  16+ 9439              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9439 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 943C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 943C
  20+ 943C A7           6 and a                                 ; Carry a "0".
  21+ 943D CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 943F 30 02            jr nc,1F
  23+ 9441
  24+ 9441 CB C1            set 0,c
  25+ 9443
  26+ 9443 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9444 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9446 5F               ld e,a
  29+ 9447
  30+ 9447 7A               ld a,d
  31+ 9448 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 944A 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 944C
  34+ 944C CB 3F            srl a
  35+ 944E
  36+ 944E AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 944F
  38+ 944F 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9450 28 04            jr z,4F
  40+ 9452
  41+ 9452 CB FF            set 7,a
  42+ 9454 18 02            jr 5F
  43+ 9456
  44+ 9456 CB BF        4 res 7,a
  45+ 9458
  46+ 9458 CB 21        5 sla c
  47+ 945A 10 E0            djnz 6B
  48+ 945C
  49+ 945C 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 945D
  51+ 945D 77               ld (hl),a
  52+ 945E 23               inc hl
  53+ 945F C1               pop bc
  54+ 9460 10 D4            djnz 3B
  55+ 9462
  56+ 9462 C9               ret
