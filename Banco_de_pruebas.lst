 655+ C5B2
 656+ C5B2 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 657+ C5B3 D6 20            sub $20             							; Vamos a comprobarlo...
 658+ C5B5 6F               ld l,a
 659+ C5B6 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 660+ C5B7
