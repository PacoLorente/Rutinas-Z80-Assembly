1744  9966              ;
1745  9966              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
1746  9966              ;
1747  9966              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
1748  9966              ;
1749  9966              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
1750  9966              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
1751  9966              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
1752  9966              ;
1753  9966              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
1754  9966              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
1755  9966              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
1756  9966              ;				  _medida que transcurre el tiempo.
1757  9966              ;
1758  9966              ;	OUTPUT: Define (Clock_next_entity).
1759  9966
1760  9966              Define_Clock_next_entity:
1761  9966
1762  9966 21 D1 94     	ld hl,Max_time_to_appear_entities
1763  9969 BE           	cp (hl)
1764  996A 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1765  996B
1766  996B 38 01        	jr c,1F
1767  996D
1768  996D              ;	Por encima o igual que (Max_time_to_appear_entities).
1769  996D              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1770  996D
1771  996D 4E           	ld c,(hl)
1772  996E
1773  996E              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1774  996E              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
