 308+ C140              ; ----------------------------------------------------------------------------------------------
 309+ C140              ;
 310+ C140              ;   17/9/26
 311+ C140              ;
 312+ C140              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C140              ;
 314+ C140              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C140
 316+ C140              BEEP:
 317+ C140
 318+ C140 F5               push af
 319+ C141 C5               push bc
 320+ C142 D5               push de
 321+ C143 E5               push hl                                 ; STORE Regs.
 322+ C144
 323+ C144              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C144
 325+ C144              ;   Configuración de un BEEP.
 326+ C144
 327+ C144              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C144              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C144              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C144              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C144              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C144
 333+ C144
 334+ C144 01 02 00         ld bc,$0002
 335+ C147 11 00 00         ld de,0
 336+ C14A 21 D0 00         ld hl,$00d0
 337+ C14D
 338+ C14D 22 06 96         ld (Sound),hl
 339+ C150
 340+ C150 CD 67 9F         call Sound_Generator    ; v2. Ok.
 341+ C153
 342+ C153 21 00 00         ld hl,0
 343+ C156 22 06 96         ld (Sound),hl
 344+ C159
 345+ C159 E1               pop hl                                  ; RECOVERY Regs.
 346+ C15A D1               pop de
 347+ C15B C1               pop bc
 348+ C15C F1               pop af
 349+ C15D
 350+ C15D C9               ret
 351+ C15E
 352+ C15E              ; ----- ----- ----- ----- -----
 353+ C15E              ;
 354+ C15E              ;   23/9/26
 355+ C15E              ;
 356+ C15E              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C15E              ;
 358+ C15E              ;   HL define el sonido.
 359+ C15E              ;
 360+ C15E              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C15E              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C15E              ;
 363+ C15E              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C15E              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C15E              ;
 366+ C15E              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C15E              ;
 368+ C15E              ;   INPUTS: (Shot_sound) <> "0".
 369+ C15E              ;
 370+ C15E              ;   MODIFY: AF, HL y BC.
 371+ C15E              ;
 372+ C15E              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C15E
 374+ C15E              Play_shot_sound_effect:
 375+ C15E
 376+ C15E              ;   Exclusiones:
 377+ C15E
 378+ C15E 2A 0A 96         ld hl,(Shot_sound)
 379+ C161 7C               ld a,h
 380+ C162 B5               or l
 381+ C163 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C164
 383+ C164 3A DD 95         ld a,(Ctrl_6)
 384+ C167 CB 47            bit 0,a
 385+ C169 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C16A
 387+ C16A 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C16C
 389+ C16C              Loop_1:
 390+ C16C
 391+ C16C 3E 10            ld a,%00010000          ; Borde negro.
 392+ C16E D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C170
 394+ C170 45               ld b,l
 395+ C171
 396+ C171 10 FE        Delay_3 djnz Delay_3
 397+ C173
 398+ C173 AF               xor a                   ; Borde negro.
 399+ C174 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C176
 401+ C176 45               ld b,l
 402+ C177
 403+ C177 10 FE        Delay_4 djnz Delay_4
 404+ C179
 405+ C179              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C179
 407+ C179 2C               inc l
 408+ C17A 2C               inc l
 409+ C17B 2C               inc l
 410+ C17C 2C               inc l
 411+ C17D
 412+ C17D 25               dec h
 413+ C17E
 414+ C17E CC 88 C1         call z,Clean_shot_effect
 415+ C181
 416+ C181 0D               dec c
 417+ C182
 418+ C182 20 E8            jr nz,Loop_1
 419+ C184
 420+ C184 22 0A 96         ld (Shot_sound),hl
 421+ C187
 422+ C187 C9               ret
 423+ C188
 424+ C188              Clean_shot_effect:
 425+ C188
 426+ C188 21 00 00         ld hl,0
 427+ C18B 0E 01            ld c,1
 428+ C18D
 429+ C18D C9               ret
 430+ C18E
 431+ C18E              ;   -------------------------------------------------------------------------------------------
 432+ C18E              ;
 433+ C18E              ;   23/9/26
 434+ C18E              ;
 435+ C18E              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C18E              ;
 437+ C18E              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C18E              ;   _ [Sound_Generator].
 439+ C18E              ;
 440+ C18E              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C18E              ;
 442+ C18E              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C18E              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C18E              ;
 445+ C18E              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C18E              ;
 447+ C18E              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C18E              ;
 449+ C18E              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C18E
 451+ C18E              Play_burst_sound_effect:
 452+ C18E
 453+ C18E              ;   Exclusiones:
 454+ C18E
 455+ C18E 3A 0C 96         ld a,(Burst_sound)
 456+ C191 A7               and a
 457+ C192 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C193
 459+ C193 08               ex af,af
 460+ C194
 461+ C194 3A DD 95         ld a,(Ctrl_6)
 462+ C197 CB 47            bit 0,a
 463+ C199 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C19A
 465+ C19A              ;   ----------------------
 466+ C19A
 467+ C19A CB C7            set 0,a
 468+ C19C 32 DD 95         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C19F
 470+ C19F 08               ex af,af                ; Restore (Burst_sound).
 471+ C1A0
 472+ C1A0 67               ld h,a
 473+ C1A1 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1A3
 475+ C1A3 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1A4
 477+ C1A4 22 06 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1A7 0E 03            ld c,3
 479+ C1A9 CD A0 9F         call Noise_efect
 480+ C1AC
 481+ C1AC D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1AD
 483+ C1AD 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1AE 94               sub h
 485+ C1AF
 486+ C1AF 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1B1
 488+ C1B1 7C               ld a,h
 489+ C1B2 32 0C 96         ld (Burst_sound),a
 490+ C1B5
 491+ C1B5 C9               ret
 492+ C1B6
 493+ C1B6              Clean_burst_efect:
 494+ C1B6
 495+ C1B6 AF               xor a
 496+ C1B7 32 0C 96         ld (Burst_sound),a
 497+ C1BA
 498+ C1BA 3A DD 95         ld a,(Ctrl_6)
 499+ C1BD CB 87            res 0,a
 500+ C1BF 32 DD 95         ld (Ctrl_6),a
 501+ C1C2
 502+ C1C2 C9               ret
 503+ C1C3
 504+ C1C3              ;   -------------------------------------------------------------------------------------------
 505+ C1C3              ;
 506+ C1C3              ;   23/9/26
 507+ C1C3              ;
 508+ C1C3              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1C3              ;   _ Shield_sound_effect.
 510+ C1C3              ;
 511+ C1C3              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1C3              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1C3              ;
 514+ C1C3              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1C3              ;
 516+ C1C3              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1C3              ;
 518+ C1C3              ;   MODIFY: AF'y BC.
 519+ C1C3
 520+ C1C3              Play_Shield_sound_effect:
 521+ C1C3
 522+ C1C3 3A 0D 96         ld a,(Shield_sound)
 523+ C1C6 A7               and a
 524+ C1C7 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1C8
 526+ C1C8 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1CA
 528+ C1CA              Loop_3:
 529+ C1CA
 530+ C1CA 08               ex af,af
 531+ C1CB
 532+ C1CB 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1CD D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1CF
 535+ C1CF 08               ex af,af
 536+ C1D0
 537+ C1D0 47               ld b,a
 538+ C1D1
 539+ C1D1 10 FE        Delay_7 djnz Delay_7
 540+ C1D3
 541+ C1D3 08               ex af,af
 542+ C1D4
 543+ C1D4 AF               xor a                   ; Black BORDER.
 544+ C1D5 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1D7
 546+ C1D7 08               ex af,af
 547+ C1D8
 548+ C1D8 47               ld b,a
 549+ C1D9
 550+ C1D9 10 FE        Delay_8 djnz Delay_8
 551+ C1DB
 552+ C1DB 0D               dec c
 553+ C1DC
 554+ C1DC 20 EC            jr nz,Loop_3
 555+ C1DE
 556+ C1DE AF               xor a
 557+ C1DF 32 0D 96         ld (Shield_sound),a
 558+ C1E2
 559+ C1E2 C9               ret
 560+ C1E3
 561+ C1E3              ; ---------------------------------------------------------------
 562+ C1E3              ;
 563+ C1E3              ;   18/9/26
 564+ C1E3              ;
 565+ C1E3              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C1E3              ;
 567+ C1E3              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C1E3              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C1E3              ;
 570+ C1E3              ;   MODIFY: A y H.
 571+ C1E3              ;
 572+ C1E3              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C1E3
 574+ C1E3
 575+ C1E3              Init_Burst_sound:
 576+ C1E3
 577+ C1E3 3A 0C 96         ld a,(Burst_sound)
 578+ C1E6 A7               and a
 579+ C1E7 C0               ret nz                                           ; RET si ya está iniciado el efecto.
 580+ C1E8
 581+ C1E8              ;   Init Burst_sound_efect.
 582+ C1E8
 583+ C1E8              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C1E8
 585+ C1E8 26 35            ld h,Burst_sound_init_value
 586+ C1EA
 587+ C1EA 3A CF 90         ld a,(Impacto_Amadeus)
 588+ C1ED A7               and a
 589+ C1EE 28 02            jr z,1F
 590+ C1F0
 591+ C1F0 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C1F2
 593+ C1F2 7C           1 ld a,h
 594+ C1F3
 595+ C1F3 32 0C 96         ld (Burst_sound),a
 596+ C1F6
 597+ C1F6 C9               ret
