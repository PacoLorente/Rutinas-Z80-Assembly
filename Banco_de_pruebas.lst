 565+ A19F              ;   NextScan.
 566+ A19F              ;
 567+ A19F              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ A19F              ;
 569+ A19F              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ A19F              ;
 571+ A19F              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ A19F              ;
 573+ A19F              ;       DESTRUIDOS: AF y HL !!!
 574+ A19F              ;
 575+ A19F              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ A19F              ;
 577+ A19F
 578+ A19F 24           NextScan inc h          ; Incrementamos el scanline.
 579+ A1A0 7C               ld a,h
 580+ A1A1 E6 07            and 7
 581+ A1A3 C0               ret nz              ; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ A1A4
 583+ A1A4 7D           	ld a,l              ; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A1A5 C6 20            add a,$20           ; Vamos a comprobarlo...
 585+ A1A7 6F               ld l,a
 586+ A1A8 D8               ret c               ; Salimos si se produce el cambio de tercio.
 587+ A1A9
 588+ A1A9 7C               ld a,h              ; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A1AA D6 08            sub 8               ; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A1AC 67               ld h,a
 591+ A1AD C9               ret
