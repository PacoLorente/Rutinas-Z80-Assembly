 398  919F              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 919F
   2+ 919F
   3+ 919F              ;   07/07/23
   4+ 919F              ;
   5+ 919F              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 919F              ;
   7+ 919F              ;   Codificación:
   8+ 919F              ;
   9+ 919F              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 919F              ;
  11+ 919F              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 919F              ;
  13+ 919F              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 919F              ;
  15+ 919F              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 919F              ;
  17+ 919F              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 919F              ;                               ..... %01000010 Vel_up 4
  19+ 919F              ;                                               Vel_down 2
  20+ 919F              ;                               ..... $42
  21+ 919F              ;
  22+ 919F              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 919F              ;
  24+ 919F              ;                               ..... %01000010 Vel_left 4
  25+ 919F              ;                                               Vel_right 2
  26+ 919F              ;                               ..... $42
  27+ 919F              ;
  28+ 919F              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 919F              ;
  30+ 919F              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 919F              ;
  32+ 919F              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 919F              ;
  34+ 919F              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 919F              ;                                     $53
  36+ 919F              ;
  37+ 919F              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 919F              ;
  39+ 919F              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 919F              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 919F              ;
  42+ 919F              ;                       Arriba ..... $81
  43+ 919F              ;                       Arriba - izquierda ..... $a1
  44+ 919F              ;                       Arriba - derecha ..... $91
  45+ 919F              ;
  46+ 919F              ;                       Abajo ..... $41
  47+ 919F              ;                       Abajo - izquierda ..... $61
  48+ 919F              ;                       Abajo - derecha ..... $51
  49+ 919F              ;
  50+ 919F              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 919F              ;
  52+ 919F              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 919F              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 919F              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 919F              ;
  56+ 919F              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 919F              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 919F              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 919F              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 919F              ;
  61+ 919F              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 919F              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 919F              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 919F              ;
  65+ 919F              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 919F              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 919F              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 919F              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
