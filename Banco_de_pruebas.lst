  49+ 99D5              ; -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  50+ 99D5              ;
  51+ 99D5              ;   14/02/25
  52+ 99D5              ;
  53+ 99D5              ;	Calcula el cuadrante de pantalla donde se encuentra la entidad: (Cuad_objeto), "1", "2", "3" o "4".
  54+ 99D5              ;	Esta información es necesaria para poder calcular el (Puntero_de_impresion) de la entidad.
  55+ 99D5              ;
  56+ 99D5              ;	INPUT:  HL contiene (Posicion_actual).
  57+ 99D5              ;	OUTPUT: (Cuad_objeto) contiene "1", "2", "3" o "4" en función del cuadrante de pantalla en el que se encuentra la entidad.
  58+ 99D5              ;
  59+ 99D5              ;	MODIFY: A.
  60+ 99D5
  61+ 99D5
  62+ 99D5              Calcula_Cuad_objeto
  63+ 99D5
  64+ 99D5 CD D1 95     	call calcula_tercio
  65+ 99D8
  66+ 99D8              ;	Ahora tenemos "0", "1" o "2" en el acumulador en función del tercio de pantalla en el que nos encontremos.
  67+ 99D8
  68+ 99D8 28 12        	jr z,Primer_tercio
  69+ 99DA 3D           	dec a
  70+ 99DB 28 1C        	jr z,Segundo_tercio
  71+ 99DD
  72+ 99DD              Tercer_tercio
  73+ 99DD
