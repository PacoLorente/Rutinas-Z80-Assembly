 254+ 9E78 C6 20            add a,$20           							; Vamos a comprobarlo...
 255+ 9E7A 6F               ld l,a
 256+ 9E7B D8               ret c               							; Salimos si se produce el cambio de tercio.
 257+ 9E7C
 258+ 9E7C 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 259+ 9E7D D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
