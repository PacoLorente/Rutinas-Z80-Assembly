 306  939A              ;
 307  939A              ; 29/4/25
 308  939A              ;
 309  939A              ; Parámetros DRAW.
 310  939A              ;
 311  939A
 312  939A              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 313  939A
 314  939A 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 315  939B              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 316  939B              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 317  939B              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 318  939B
 319  939B 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 320  939C              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 321  939C 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 322  939D 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 323  939E
 324  939E 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 325  939F              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 326  939F              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 327  939F
 328  939F              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 329  939F              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 330  939F
 331  939F              ; Ejemplos:
 332  939F
 333  939F              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 334  939F              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 335  939F              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 336  939F              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 337  939F              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 338  939F
 339  939F 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 340  93A0              ;															  _ que esta entidad haya colisionado con Amadeus.
 341  93A0              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 342  93A0
 343  93A0 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 344  93A2              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 345  93A2
 346  93A2 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 347  93A4
 348  93A4              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 349  93A4
 350  93A4 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
