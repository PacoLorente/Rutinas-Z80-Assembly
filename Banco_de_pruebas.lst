 611+ B010 25               dec h               							; Dec H.
 612+ B011 E6 07            and 7
 613+ B013 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ B014
 615+ B014 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B015 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B017 6F               ld l,a
 618+ B018 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
