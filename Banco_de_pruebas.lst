 508+ AEA2              ;
 509+ AEA2              ;   29/10/26
 510+ AEA2              ;
 511+ AEA2              ;   Imprime el logo "Score:" en el marcador, (parte sup. de la pantalla).
 512+ AEA2              ;
 513+ AEA2              ;   Para ello haremos TRES llamadas a la rutina de pintado [Pinta_imagen].
 514+ AEA2              ;
 515+ AEA2              ;   El logo consta de tres grupos de datos de 2x2, (Columnas/Filas).
 516+ AEA2              ;
 517+ AEA2              ;   El 1er grupo construye el gráfico "Sc".
 518+ AEA2              ;   El 2° construye "or".
 519+ AEA2              ;   El 3er grupo de datos: "e:".
 520+ AEA2              ;
 521+ AEA2              ;   MODIFY: AF, HL, DE y BC.
 522+ AEA2
 523+ AEA2              Print_SCORE_Logo:
 524+ AEA2
 525+ AEA2 21 12 40         ld hl,Cartel_Score_address                          ; (HL) contendrá la dirección de pantalla donde imprimiremos el logo del panel marcador: "Score:".
 526+ AEA5 11 C0 8E         ld de,_Sc                                           ; (DE) contiene la dirección de memoria donde se encuentran los datos del primer bloque, ("Sc").
 527+ AEA8
 528+ AEA8 CD B8 AE         call Subroutine_001                                 ; [Subroutine_001] asigna (Columnas/Filas) en BC, Attrs. en (A) y pinta imagen, (call Pinta_imagen ).
 529+ AEAB
 530+ AEAB 11 E0 8A         ld de,_or                                           ; (DE) contiene la dirección de memoria donde se encuentran los datos del 2° bloque, ("or").
 531+ AEAE
 532+ AEAE CD B8 AE         call Subroutine_001                                 ; [Subroutine_001] asigna (Columnas/Filas) en BC, Attrs. en (A) y pinta imagen, (call Pinta_imagen ).
 533+ AEB1
 534+ AEB1 11 C0 8C         ld de,_e                                            ; (DE) contiene la dirección de memoria donde se encuentran los datos del 3er bloque, ("e:").
 535+ AEB4
 536+ AEB4 CD B8 AE         call Subroutine_001                                 ; [Subroutine_001] asigna (Columnas/Filas) en BC, Attrs. en (A) y pinta imagen, (call Pinta_imagen ).
 537+ AEB7
 538+ AEB7 C9               ret
 539+ AEB8
 540+ AEB8              Subroutine_001:
 541+ AEB8
 542+ AEB8 E5               push hl                                             ; PUSH Cartel_Score_address (actualizado).
 543+ AEB9
 544+ AEB9 01 02 02         ld bc,$0202                                         ; (BC) contiene (Columnas/Filas).
 545+ AEBC 3E 45            ld a,%01000101                                      ; Attrs.: BRIGHT, BLACK PAPER, CYAN INK.
 546+ AEBE
 547+ AEBE              ;   Parámetros necesarios antes de llamar a [Pinta_imagen]:
 548+ AEBE
 549+ AEBE              ;   INPUTS: HL contiene la dirección de memoria de pantalla donde queremos imprimir la imagen, (esquina superior izquierda).
 550+ AEBE              ;           DE contiene la dirección del 1er .db que conforman los datos de la imagen.
 551+ AEBE              ;            A contiene los Attr.
 552+ AEBE              ;            B contiene el nº de Columnas.
 553+ AEBE              ;            C contiene el nº de Filas.
 554+ AEBE
 555+ AEBE CD 08 9F         call Pinta_imagen   ; v2. Ok.
 556+ AEC1
 557+ AEC1 E1               pop hl                                              ; POP Cartel_Score_address (actualizado).
 558+ AEC2
