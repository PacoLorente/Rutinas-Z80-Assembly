 168+ C0AB 2E A5        	ld l,$a5                                                ; (HL) = $00a5. Nota, (duración de un semiciclo).
 169+ C0AD              ;                                                           ; (E) = $00, no existe decremento. (sonido plano).
 170+ C0AD 22 06 96     	ld (Sound),hl
 171+ C0B0 CD 61 9F         call Sound_Generator 									; Ejecuta nota.
