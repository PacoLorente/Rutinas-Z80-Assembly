 623  9433              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 624  9433
 625  9433 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 626  9434 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 627  9435 00           Cola_de_desplazamiento db 0									; Este byte indica:
 628  9436
 629  9436              ;
 630  9436              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 631  9436              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 632  9436              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 633  9436              ;
 634  9436              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 635  9436              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 636  9436              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 637  9436              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 638  9436              ;
 639  9436              ;															;	"$ff" ..... Bucle infinito de repetición.
 640  9436              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 641  9436              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 642  9436
 643  9436 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 644  9437
 645  9437              ;																DESCRIPCIÓN:
 646  9437              ;
 647  9437              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 648  9437              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 649  9437              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 650  9437              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 651  9437              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 652  9437              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 653  9437
 654  9437              ;															BIT 3, Recarga de nueva oleada.
 655  9437              ;															BIT 4, Recarga de nueva oleada.
 656  9437              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 657  9437              ;															BIT 6, **** Frame completo.
 658  9437              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 659  9437
