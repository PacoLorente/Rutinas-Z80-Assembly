3097  A044              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A044              ; ******************************************************************************************************************************************************************************************
   2+ A044              ;
   3+ A044              ;   3/4/25
   4+ A044              ;
   5+ A044              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A044              ;   (XOR) bit a bit.
   7+ A044              ;
   8+ A044              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A044              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A044
  11+ A044              Derivando_RND
  12+ A044
  13+ A044 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A046 C5               push bc
  15+ A047              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A047 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A04A              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A04A
  19+ A04A A7           6 and a                                 ; Carry a "0".
  20+ A04B CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A04D 30 02            jr nc,1F
  22+ A04F
  23+ A04F CB C1            set 0,c
  24+ A051
  25+ A051 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A052 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A054 5F               ld e,a
  28+ A055
  29+ A055 7A               ld a,d
  30+ A056 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A058 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A05A
  33+ A05A CB 3F            srl a
  34+ A05C
  35+ A05C AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A05D
  37+ A05D 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A05E 28 04            jr z,4F
  39+ A060
  40+ A060 CB FF            set 7,a
  41+ A062 18 02            jr 5F
  42+ A064
  43+ A064 CB BF        4 res 7,a
  44+ A066
  45+ A066 CB 21        5 sla c
  46+ A068 10 E0            djnz 6B
  47+ A06A
  48+ A06A 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A06B
  50+ A06B 77               ld (hl),a
  51+ A06C 23               inc hl
  52+ A06D C1               pop bc
  53+ A06E 10 D4            djnz 3B
  54+ A070
  55+ A070 C9               ret
  56+ A071
  57+ A071
  58+ A071
# file closed: RND_Derivando.asm
