 381+ AC8F              ;
 382+ AC8F              ;   23/6/25
 383+ AC8F              ;
 384+ AC8F              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 385+ AC8F              ;
 386+ AC8F              ;	INPUTS:		B contiene (Numero_de_entidades).
 387+ AC8F              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 388+ AC8F              ; 				HL contiene (Puntero_de_entidades).
 389+ AC8F
 390+ AC8F              Prepara_Cajas_Master:
 391+ AC8F
 392+ AC8F E5           	push hl															; PUSH (Puntero_de_entidades).
 393+ AC90 C5           	push bc															; PUSH (Numero_de_entidades)/(Clase).
 394+ AC91
 395+ AC91              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 396+ AC91
 397+ AC91 79           	ld a,c
 398+ AC92 08           	ex af,af
 399+ AC93 79           	ld a,c 															; (Clase) de la entidad en C, A y A´.
 400+ AC94
 401+ AC94 CD B3 AE     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 402+ AC97              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 403+ AC97              ; 																	; Saltaremos a la siguiente entidad del nivel.
 404+ AC97 A7           	and a
 405+ AC98 20 41        	jr nz, Avanza_siguiente_entidad_del_nivel
 406+ AC9A
 407+ AC9A              ; Generamos movimientos masticados.
 408+ AC9A
 409+ AC9A              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 410+ AC9A
 411+ AC9A 79           	ld a,c 															; (A) = (Clase).
 412+ AC9B
 413+ AC9B CD 7C AF     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 414+ AC9E CD 09 B0     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 415+ ACA1
 416+ ACA1              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 417+ ACA1              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 418+ ACA1              ;	coreografías distintas.
 419+ ACA1
 420+ ACA1 06 07        	ld b,7
 421+ ACA3 21 8C A2     	ld hl,Numeros_aleatorios_baile
 422+ ACA6 CD C9 AA     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 423+ ACA9
 424+ ACA9              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 425+ ACA9
 426+ ACA9 3A F4 A4     	ld a,(Tipo)
 427+ ACAC CD E0 AE     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 428+ ACAF CD 32 AE     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 429+ ACB2
 430+ ACB2              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 431+ ACB2
 432+ ACB2 C1           	pop bc 															; POP (Numero_de_entidades)/(Clase).
 433+ ACB3 E1           	pop hl 															; POP (Puntero_de_entidades).
 434+ ACB4
 435+ ACB4 E5           	push hl															; PUSH (Puntero_de_entidades).
 436+ ACB5 C5           	push bc															; PUSH (Numero_de_entidades)/(Clase).
 437+ ACB6
 438+ ACB6              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 439+ ACB6
 440+ ACB6 CD F3 AC     	call Determina_posicion_de_inicio 								; $941e ($78),($76),($72)
 441+ ACB9
 442+ ACB9 3A F4 A4     	ld a,(Tipo)
 443+ ACBC CD F0 AE     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
 444+ ACBF
 445+ ACBF              ;	Ya disponemos de una (Posicion_inicio) aleatoria y la definición de la entidad en la "Bandeja DRAW".
 446+ ACBF              ;	Generamos "Movimientos masticados" de la entidad.
 447+ ACBF
 448+ ACBF CD B6 AD     	call Construye_movimientos_masticados_entidad
 449+ ACC2
 450+ ACC2              Movimientos_masticados_construidos:
 451+ ACC2
 452+ ACC2 2A 33 A5     	ld hl,(Puntero_indice_master)
 453+ ACC5 CD B5 D2     	call Extrae_address
 454+ ACC8
 455+ ACC8 5D           	ld e,l
 456+ ACC9 54           	ld d,h
 457+ ACCA
 458+ ACCA CD 36 B0     	call Parametros_de_bandeja_DRAW_a_Caja_Master	 				; Caja de entidades Master completa.
 459+ ACCD
 460+ ACCD              ;	Limpiamos la bandeja_DRAW y las variables de movimiento para poder generar los mov. masticados_
 461+ ACCD              ;	_de otro (Tipo) de entidad.
 462+ ACCD              ;
 463+ ACCD              ;	Limpiamos bandeja y variables.
 464+ ACCD
 465+ ACCD AF           	xor a
 466+ ACCE 32 64 A5     	ld (Ctrl_3),a 													; (Ctrl_3) ha de inicializarse pués lo utilizamos para indicar_
 467+ ACD1              ;																	; _, (entre otras cosas) cuando finalizamos de generar los mov. masticados.
 468+ ACD1 21 F3 A4     	ld hl,Clase
 469+ ACD4 01 3A 00     	ld bc,Gestion_de_ENTIDADES_y_CAJAS-Bandeja_DRAW
 470+ ACD7
 471+ ACD7 0B           	dec bc
 472+ ACD8
 473+ ACD8 CD 18 BE     	call Clean_mem
 474+ ACDB
 475+ ACDB              ; 	Avanza a la siguiente entidad del nivel.
 476+ ACDB
 477+ ACDB              Avanza_siguiente_entidad_del_nivel:
 478+ ACDB
 479+ ACDB C1           	pop bc															; Pop (Numero_de_entidades)/(Tipo).
 480+ ACDC E1           	pop hl															; Pop (Puntero_de_entidades).
 481+ ACDD
 482+ ACDD 23           	inc hl															; Puntero_de_entidades +1 en HL.
 483+ ACDE 22 85 A5     	ld (Puntero_de_entidades),hl 									; Actualizamos (Puntero_de_entidades).
 484+ ACE1
 485+ ACE1 4E           	ld c,(hl)														; (Tipo) de la siguiente entidad en C.
 486+ ACE2 10 AB        	djnz Prepara_Cajas_Master 										; dec (Numero_de_entidades).
 487+ ACE4
 488+ ACE4              ; Una vez terminados los movimientos masticados de los distintos TIPOS de entidades,
 489+ ACE4              ; _ inicializamos el puntero (Puntero_de_entidades), situándolo en la 1ª entidad.
 490+ ACE4
 491+ ACE4 2A A0 A5     	ld hl,(Puntero_indice_NIVELES)
 492+ ACE7 CD B5 D2     	call Extrae_address
 493+ ACEA
 494+ ACEA 23           	inc hl
 495+ ACEB 23           	inc hl
 496+ ACEC 23           	inc hl
 497+ ACED 23           	inc hl
 498+ ACEE 23           	inc hl
 499+ ACEF
 500+ ACEF 22 85 A5     	ld (Puntero_de_entidades),hl
 501+ ACF2
 502+ ACF2 C9           	ret
