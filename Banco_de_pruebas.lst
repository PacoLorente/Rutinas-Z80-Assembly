 451+ ACC2
 452+ ACC2 2A 33 A5     	ld hl,(Puntero_indice_master)
 453+ ACC5 CD 80 D4     	call Extrae_address
 454+ ACC8
 455+ ACC8 5D           	ld e,l
 456+ ACC9 54           	ld d,h
 457+ ACCA
 458+ ACCA CD 34 B0     	call Parametros_de_bandeja_DRAW_a_Caja_Master	 				; Caja de entidades Master completa.
 459+ ACCD
 460+ ACCD              ;	Limpiamos la bandeja_DRAW y las variables de movimiento para poder generar los mov. masticados_
 461+ ACCD              ;	_de otro (Tipo) de entidad.
 462+ ACCD              ;
 463+ ACCD              ;	Limpiamos bandeja y variables.
 464+ ACCD
 465+ ACCD AF           	xor a
 466+ ACCE 32 64 A5     	ld (Ctrl_3),a 													; (Ctrl_3) ha de inicializarse pués lo utilizamos para indicar_
 467+ ACD1              ;																	; _, (entre otras cosas) cuando finalizamos de generar los mov. masticados.
 468+ ACD1 21 F3 A4     	ld hl,Clase
 469+ ACD4 01 3A 00     	ld bc,Gestion_de_ENTIDADES_y_CAJAS-Bandeja_DRAW
 470+ ACD7
 471+ ACD7 0B           	dec bc
 472+ ACD8
 473+ ACD8 CD AF BF     	call Clean_mem
 474+ ACDB
 475+ ACDB              ; 	Avanza a la siguiente entidad del nivel.
 476+ ACDB
 477+ ACDB              Avanza_siguiente_entidad_del_nivel:
 478+ ACDB
 479+ ACDB C1           	pop bc															; Pop (Numero_de_entidades)/(Tipo).
 480+ ACDC E1           	pop hl															; Pop (Puntero_de_entidades).
 481+ ACDD
 482+ ACDD 23           	inc hl															; Puntero_de_entidades +1 en HL.
 483+ ACDE 22 85 A5     	ld (Puntero_de_entidades),hl 									; Actualizamos (Puntero_de_entidades).
 484+ ACE1
 485+ ACE1 4E           	ld c,(hl)														; (Tipo) de la siguiente entidad en C.
 486+ ACE2 10 AB        	djnz Prepara_Cajas_Master 										; dec (Numero_de_entidades).
 487+ ACE4
 488+ ACE4              ; Una vez terminados los movimientos masticados de los distintos TIPOS de entidades,
 489+ ACE4              ; _ inicializamos el puntero (Puntero_de_entidades), situándolo en la 1ª entidad.
 490+ ACE4
 491+ ACE4 2A A0 A5     	ld hl,(Puntero_indice_NIVELES)
 492+ ACE7 CD 80 D4     	call Extrae_address
 493+ ACEA
 494+ ACEA 23           	inc hl
 495+ ACEB 23           	inc hl
 496+ ACEC 23           	inc hl
 497+ ACED 23           	inc hl
 498+ ACEE 23           	inc hl
 499+ ACEF
 500+ ACEF 22 85 A5     	ld (Puntero_de_entidades),hl
 501+ ACF2
 502+ ACF2 C9           	ret
 503+ ACF3
 504+ ACF3              ; -----------------------------------------------------------------------------------
 505+ ACF3              ;
 506+ ACF3              ;	12/8/26
 507+ ACF3              ;
 508+ ACF3              ;	Asigna una columna de inicio aleatoria y distinta a cada una de las 3 Clases como máximo que pueden aparecer en un nivel.
 509+ ACF3
 510+ ACF3              Determina_posicion_de_inicio:
 511+ ACF3
 512+ ACF3 21 8F A2     	ld hl,Numeros_aleatorios_baile+3
 513+ ACF6 7E           	ld a,(hl)
 514+ ACF7 E6 1F        	and $1f															; Define el nº de columna por el que va a aparecer la entidad.
 515+ ACF9
 516+ ACF9              ;	Tenemos un nº aleatorio, (Columna de inicio) en A.
 517+ ACF9              ; 	No queremos que se repita la posición de inicio en dos clases distintas de entidades.
 518+ ACF9
 519+ ACF9 57           	ld d,a 															; $08,$12,$0c --- $08,$02,$12 --- $18,$1c,$18 --- $1e,$1c,$18
 520+ ACFA
 521+ ACFA CD 14 AD     	call No_repeat
 522+ ACFD
 523+ ACFD 3A F4 A4     	ld a,(Tipo)														; (Tipo) $81 Badsat, $82 Badplate.
 524+ AD00 E6 02        	and 2
 525+ AD02 7A           	ld a,d
 526+ AD03 28 09        	jr z,1F
 527+ AD05
 528+ AD05              ; 	Entidad tipo Badplate. Si nuestro nº RND es "<= $0f" aparecerá por la izquierda. Si es superior iniciará por la derecha.
 529+ AD05
 530+ AD05 FE 0F        	cp $0f
 531+ AD07 38 04        	jr c,2F
 532+ AD09
 533+ AD09 3E 1F        	ld a,$1f
 534+ AD0B 18 01        	jr 1F
