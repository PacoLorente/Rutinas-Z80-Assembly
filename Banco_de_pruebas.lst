 578+ 9F34
 579+ 9F34 06 5A            ld b,90
 580+ 9F36 18 02            jr 1F
 581+ 9F38
 582+ 9F38 06 82        3 ld b,130
 583+ 9F3A
 584+ 9F3A 0E FF        1 ld c,$ff
