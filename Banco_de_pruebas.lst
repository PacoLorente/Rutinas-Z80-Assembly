 297  8CBB              ;
 298  8CBB              ;
 299  8CBB 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8CBC              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 301  8CBC              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
