1759  9932
1760  9932 4E           	ld c,(hl)
1761  9933
1762  9933              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1763  9933              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1764  9933
1765  9933 23           1 inc hl
