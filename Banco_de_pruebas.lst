   4+ C1EB              ;
   5+ C1EB              ;   Imprime el cartel "Best_Score", el nombre del campeón y la nueva puntuación máxima en la esquina inferior izquierda del _
   6+ C1EB              ;   _Menú Principal.
   7+ C1EB              ;
   8+ C1EB              ;   MODIFY: AF, HL, DE y BC.
   9+ C1EB
  10+ C1EB              Print_new_best_score:
  11+ C1EB
  12+ C1EB CD DC AC     	call Cartel_Best_Score ; v2. Ok.            ; Imprime el Cartel "Best Score" en la esquina inferior izquierda de la pantalla_
  13+ C1EE              ;                                               ; _del menú principal.
  14+ C1EE
  15+ C1EE              ;   Imprime el nombre del campeón y la nueva puntuación máxima justo debajo del cartel Best_Score.
  16+ C1EE              ;   La rutina [Print_text_msg] requiere de los siguientes parámetros para imprimir texto:
  17+ C1EE
  18+ C1EE              ;           HL apunta al mensage a imprimir, (msg).
  19+ C1EE              ;           DE indica la fila de pantalla donde queremos imprimir el msg.
  20+ C1EE              ;            A contiene los attrs. del msg.
  21+ C1EE              ;            B Actúa como temporizador, ralentiza la impresión de caracteres, (simula una máquina de escribir).
  22+ C1EE              ;              No actua cuando su valor es "0".
  23+ C1EE
  24+ C1EE 11 C1 50         ld de,Line_22+1
  25+ C1F1
  26+ C1F1 3E 47            ld a,%01000111
  27+ C1F3 06 00            ld b,0
  28+ C1F5 21 43 96         ld hl,Nombre_del_campeon
  29+ C1F8 CD 0A 9F         call Print_text_msg ; v2. Ok.
