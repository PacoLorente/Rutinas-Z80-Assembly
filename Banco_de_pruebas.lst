 618+ C3F6
 619+ C3F6              ;   Tras ejecutar[ROM_Key_Scan], (E) contiene el KEYCODE de la tecla pulsada.
 620+ C3F6
 621+ C3F6 3A 19 96         ld a,(No_repeat_key_code)
 622+ C3F9 A7               and a
 623+ C3FA 28 0B            jr z,2F                                                 ; (No_repeat_key_code)="0" Indica que estamos definiendo Move_LEFT.
 624+ C3FC              ;                                                           ; (No_repeat_key_code) se incrementa en una unidad cada vez que se define una tecla:
 625+ C3FC              ;
 626+ C3FC              ;                                                           ; Ej.: Si estamos definiendo Move_RIGHT, (No_repeat_key_code)="1"
 627+ C3FC              ;                                                           ;      Si estamos definiendo Move_FIRE, (No_repeat_key_code)="2"
 628+ C3FC              ;                                                           ;      Si estamos definiendo Move_SHIELD, (No_repeat_key_code)="3"
 629+ C3FC
 630+ C3FC 47               ld b,a                                                  ; Así, (B) contiene el nº de teclas definidas -1.
 631+ C3FD
 632+ C3FD              ;   (No_repeat_key_code) contiene el n° de comparativas que realizaremos entre el nuevo KEYCODE definido y los anteriormente definidos.
 633+ C3FD              ;   Así evitaremos que se asigne una misma tecla para varias funciones distintas.
