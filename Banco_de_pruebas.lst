   1+ 9479              ; ******************************************************************************************************************************************************************************************
   2+ 9479              ;
   3+ 9479              ;   3/4/25
   4+ 9479              ;
   5+ 9479              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9479              ;   (XOR) bit a bit.
   7+ 9479              ;
   8+ 9479              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9479              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9479
  11+ 9479              Derivando_RND
  12+ 9479
  13+ 9479 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 947B C5               push bc
  15+ 947C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 947C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 947F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 947F
  19+ 947F A7           6 and a                                 ; Carry a "0".
  20+ 9480 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9482 30 02            jr nc,1F
  22+ 9484
  23+ 9484 CB C1            set 0,c
  24+ 9486
  25+ 9486 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9487 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9489 5F               ld e,a
  28+ 948A
  29+ 948A 7A               ld a,d
  30+ 948B E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 948D 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 948F
  33+ 948F CB 3F            srl a
  34+ 9491
  35+ 9491 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9492
  37+ 9492 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9493 28 04            jr z,4F
  39+ 9495
  40+ 9495 CB FF            set 7,a
  41+ 9497 18 02            jr 5F
  42+ 9499
  43+ 9499 CB BF        4 res 7,a
  44+ 949B
  45+ 949B CB 21        5 sla c
  46+ 949D 10 E0            djnz 6B
  47+ 949F
  48+ 949F 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 94A0
  50+ 94A0 77               ld (hl),a
  51+ 94A1 23               inc hl
  52+ 94A2 C1               pop bc
  53+ 94A3 10 D4            djnz 3B
  54+ 94A5
  55+ 94A5 C9               ret
  56+ 94A6
  57+ 94A6
