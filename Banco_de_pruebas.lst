 575+ C3B8              ; -----------------------------------------------------------------------------------------------------------
 576+ C3B8              ;
 577+ C3B8              ;   17/10/26
 578+ C3B8              ;
 579+ C3B8              ;   Asigna un nuevo KEYCODE y sustituye al contenido en la variable MOVE_xxx, (al que apunta H)L.
 580+ C3B8              ;   Nueva tecla para la función de movimiento, (KEYBOARD) a la que apunta HL.
 581+ C3B8              ;
 582+ C3B8              ;   Move_LEFT db $24
 583+ C3B8              ;   Move_RIGHT db $1c
 584+ C3B8              ;   Move_FIRE db $04
 585+ C3B8              ;   Move_SHIELD db $20
 586+ C3B8              ;
 587+ C3B8              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 588+ C3B8              ;
 589+ C3B8              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3B8              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3B8              ;
 592+ C3B8              ;   Special keys:
 593+ C3B8              ;
 594+ C3B8              ;   Symbol_key defm "SYMB.",0
 595+ C3B8              ;   Space_key defm "SPACE",0
 596+ C3B8              ;   Enter_key defm "ENTER",0
 597+ C3B8              ;   Caps_key defm "CAPS.",0
 598+ C3B8              ;
 599+ C3B8              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 600+ C3B8              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 601+ C3B8              ;
 602+ C3B8              ;           (Numero_de_teclas_definidas) contiene el n° de teclas YA DEFINIDAS.
 603+ C3B8              ;
 604+ C3B8              ;   MODIFY: AF, HL, BC y DE.
 605+ C3B8              ;
 606+ C3B8              ;   OUTPUT: (A) = "0".
 607+ C3B8
 608+ C3B8              Define_key:
 609+ C3B8
 610+ C3B8 E5               push hl                                                 ; PUSH Puntero KEYCODE.
 611+ C3B9 D5               push de                                                 ; PUSH Puntero ASCII_CODE.
 612+ C3BA
 613+ C3BA CD 76 A0     3 call ROM_Key_Scan ; v2. Ok.                               ; Scan keyboard.
 614+ C3BD
 615+ C3BD              ;   Tras ejecutar[ROM_Key_Scan], (E) contiene el KEYCODE de la tecla pulsada.
 616+ C3BD
 617+ C3BD 3A 5E 96         ld a,(Numero_de_teclas_definidas)                       ; N° de teclas ya definidas.
 618+ C3C0 A7               and a
 619+ C3C1 28 0B            jr z,2F                                                 ; (Numero_de_teclas_definidas)="0" Indica que estamos definiendo Move_LEFT.
 620+ C3C3              ;                                                           ; (Numero_de_teclas_definidas) se incrementa en una unidad cada vez que se define una tecla:
 621+ C3C3              ;
 622+ C3C3              ;                                                           ; Ej.: Si estamos definiendo Move_RIGHT, (Numero_de_teclas_definidas)="1"
 623+ C3C3              ;                                                           ;      Si estamos definiendo Move_FIRE, (Numero_de_teclas_definidas)="2"
 624+ C3C3              ;                                                           ;      Si estamos definiendo Move_SHIELD, (Numero_de_teclas_definidas)="3"
 625+ C3C3
 626+ C3C3 47               ld b,a                                                  ; Así, (B) contiene el nº de teclas definidas -1.
 627+ C3C4
 628+ C3C4              ;   (Numero_de_teclas_definidas) contiene el n° de comparativas que realizaremos entre el nuevo KEYCODE definido y los anteriormente definidos.
 629+ C3C4              ;   Así evitaremos que se asigne una misma tecla para varias funciones distintas.
 630+ C3C4
 631+ C3C4 21 5F 96         ld hl,Move_LEFT                                         ; 1er KEYCODE a comparar.
 632+ C3C7
 633+ C3C7 7E           1 ld a,(hl)                                                 ; KEY_CODE de Move_LEFT en A.
 634+ C3C8 BB               cp e                                                    ; Comparo con el Key_code recién adquirido.
 635+ C3C9 28 EF            jr z,3B                                                 ; Esta tecla ya se definió anteriormente. Volvemos a escanear el teclado.
 636+ C3CB
 637+ C3CB 23               inc hl                                                  ; Next KEYCODE to compare.
 638+ C3CC
 639+ C3CC 10 F9            djnz 1B
 640+ C3CE
 641+ C3CE 7B           2 ld a,e                                                    ; KEY_code en A.
