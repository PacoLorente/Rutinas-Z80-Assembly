 235+ A1F1 0E 47            ld c,%01000111         ; (Attr). de los disparos.
 236+ A1F3
 237+ A1F3 06 07        3 ld b,7                           ; Nº máximo de disparos. Fuerza la salida del album cuando hemos pintado 7 veces_
 238+ A1F5              ;                                      _ aunque IYL+IYH+E no sea "0". (No hay separacíon entre el álbum de borrado y el de pintado).
