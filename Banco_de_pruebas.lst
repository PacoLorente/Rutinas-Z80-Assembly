 590+ C21E
 591+ C21E 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C220
 593+ C220 7C           1 ld a,h
 594+ C221
 595+ C221 32 AD 96         ld (Burst_sound),a
 596+ C224
 597+ C224 C9               ret
