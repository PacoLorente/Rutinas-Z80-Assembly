 249  9193              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 9193
   2+ 9193
   3+ 9193              ;   07/07/23
   4+ 9193              ;
   5+ 9193              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 9193              ;
   7+ 9193              ;   Codificación:
   8+ 9193              ;
   9+ 9193              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 9193              ;
  11+ 9193              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 9193              ;
  13+ 9193              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 9193              ;
  15+ 9193              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 9193              ;
  17+ 9193              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 9193              ;                               ..... %01000010 Vel_up 4
  19+ 9193              ;                                               Vel_down 2
  20+ 9193              ;                               ..... $42
  21+ 9193              ;
  22+ 9193              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 9193              ;
  24+ 9193              ;                               ..... %01000010 Vel_left 4
  25+ 9193              ;                                               Vel_right 2
  26+ 9193              ;                               ..... $42
  27+ 9193              ;
  28+ 9193              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 9193              ;
  30+ 9193              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 9193              ;
  32+ 9193              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 9193              ;
  34+ 9193              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 9193              ;                                     $53
  36+ 9193              ;
  37+ 9193              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 9193              ;
  39+ 9193              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 9193              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 9193              ;
  42+ 9193              ;                       Arriba ..... $81
  43+ 9193              ;                       Arriba - izquierda ..... $a1
  44+ 9193              ;                       Arriba - derecha ..... $91
  45+ 9193              ;
  46+ 9193              ;                       Abajo ..... $41
  47+ 9193              ;                       Abajo - izquierda ..... $61
  48+ 9193              ;                       Abajo - derecha ..... $51
  49+ 9193              ;
  50+ 9193              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 9193              ;
  52+ 9193              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 9193              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 9193              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 9193              ;
  56+ 9193              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 9193              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 9193              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 9193              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 9193              ;
  61+ 9193              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 9193              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 9193              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 9193              ;
  65+ 9193              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 9193              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 9193              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 9193              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 9193
