 615+ 9F03              ; Hemos generado una onda sonora.
 616+ 9F03              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 617+ 9F03
 618+ 9F03 2A 84 94         ld hl,(Sound)
 619+ 9F06
 620+ 9F06 1C               inc e
 621+ 9F07 1D               dec e
 622+ 9F08 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 623+ 9F0A              ;                           ; (E)="0" indica que no hay variación en el tono.
 624+ 9F0A
 625+ 9F0A 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 626+ 9F0B 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 627+ 9F0C
 628+ 9F0C              ; Rayo de entrada o de salida ???
 629+ 9F0C
 630+ 9F0C A7               and a
 631+ 9F0D 20 05            jr nz,Incrementa_delay
 632+ 9F0F
