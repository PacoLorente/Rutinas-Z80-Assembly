 294  8CC6 00 00        Puntero_indice_mov defw 0						; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 295  8CC8 00 00        Puntero_mov defw 0								; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 296  8CCA 00 00        Puntero_indice_mov_bucle defw 0
 297  8CCC              ;
 298  8CCC              ;
 299  8CCC 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8CCD              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 301  8CCD              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 302  8CCD
 303  8CCD 00           Incrementa_puntero_backup db 0
 304  8CCE 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 305  8CCF              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8CCF
 307  8CCF 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8CD0 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CD1 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CD2
 311  8CD2              ;
 312  8CD2              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CD2              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CD2              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CD2              ;
 316  8CD2              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CD2              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CD2              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CD2              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CD2              ;
 321  8CD2              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CD2              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CD2              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8CD2
 325  8CD2 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 326  8CD3
 327  8CD3              ;																DESCRIPCIÓN:
 328  8CD3              ;
 329  8CD3              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 330  8CD3              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 331  8CD3              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 332  8CD3              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 333  8CD3              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 334  8CD3              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 335  8CD3
 336  8CD3              ;																BIT 3, Recarga de nueva oleada.
 337  8CD3              ;																BIT 4, Recarga de nueva oleada.
 338  8CD3              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 339  8CD3              ;																BIT 6, **** Frame completo.
 340  8CD3              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 341  8CD3
 342  8CD3 00 00        Repone_puntero_objeto defw 0				; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 343  8CD5              ; 																; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 344  8CD5              ; 																; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 345  8CD5              ;																; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 346  8CD5
