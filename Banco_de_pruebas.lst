  17  A4EC              	include "Variables_de_programa.asm"
# file opened: Variables_de_programa.asm
   1+ A4EC              ;	Variables de programa.
   2+ A4EC
   3+ A4EC              Bandeja_DRAW:
   4+ A4EC
   5+ A4EC 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
   6+ A4ED              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
   7+ A4ED              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
   8+ A4ED              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
   9+ A4ED
  10+ A4ED 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
  11+ A4EE              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
  12+ A4EE 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
  13+ A4EF 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
  14+ A4F0
  15+ A4F0 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
  16+ A4F1              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
  17+ A4F1              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
  18+ A4F1
  19+ A4F1              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
  20+ A4F1              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
  21+ A4F1
  22+ A4F1              ; Ejemplos:
  23+ A4F1
  24+ A4F1              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
  25+ A4F1              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
  26+ A4F1              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
  27+ A4F1              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
  28+ A4F1              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
  29+ A4F1
  30+ A4F1 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
  31+ A4F2              ;															  _ que esta entidad haya colisionado con Amadeus.
  32+ A4F2              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
  33+ A4F2
  34+ A4F2 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
  35+ A4F4              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
  36+ A4F4
  37+ A4F4 00 00        Puntero_de_almacen_de_mov_masticados defw 0
  38+ A4F6
  39+ A4F6              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
  40+ A4F6
  41+ A4F6 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
  42+ A4F8              ;															  _palabras que componen el "movimiento_masticado".
  43+ A4F8
  44+ A4F8              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
  45+ A4F8
  46+ A4F8 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
  47+ A4F9              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
  48+ A4F9              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
  49+ A4F9              ;																							 8 - 2 (4ª vuelta - velocidad 2)
  50+ A4F9              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
  51+ A4F9
  52+ A4F9 00           Attr db 0 													; Atributos de la entidad.
  53+ A4FA
  54+ A4FA              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
  55+ A4FA
  56+ A4FA
  57+ A4FA
  58+ A4FA 00           Ctrl_2 db 0
  59+ A4FB              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
  60+ A4FB              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
  61+ A4FB              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
  62+ A4FB              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
  63+ A4FB              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
  64+ A4FB              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
  65+ A4FB              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
  66+ A4FB              ;
  67+ A4FB              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
  68+ A4FB              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
  69+ A4FB              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
  70+ A4FB              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
  71+ A4FB              ;															_ el último MOVIMIENTO que hayamos ejecutado.
  72+ A4FB              ;															BIT 4, ???
  73+ A4FB              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
  74+ A4FB              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
  75+ A4FB              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
  76+ A4FB              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
  77+ A4FB              ;															- La rutina [Borra_escudo], inicializará el FLAG.
  78+ A4FB
  79+ A4FB 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
  80+ A4FC              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
  81+ A4FC              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
  82+ A4FC              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
  83+ A4FC              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
  84+ A4FC              ;
  85+ A4FC              ; 															DESCRIPCIÖN:
  86+ A4FC              ;
  87+ A4FC              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
  88+ A4FC              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
  89+ A4FC              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
  90+ A4FC              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
  91+ A4FC              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
  92+ A4FC              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
  93+ A4FC              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
  94+ A4FC              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
  95+ A4FC              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
  96+ A4FC              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
  97+ A4FC              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
  98+ A4FC              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
  99+ A4FC              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 100+ A4FC              ;
 101+ A4FC              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 102+ A4FC              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 103+ A4FC              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 104+ A4FC
