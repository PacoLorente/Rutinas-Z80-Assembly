   4+ 9971              ;
   5+ 9971              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9971              ;   (XOR) bit a bit.
   7+ 9971              ;
   8+ 9971              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9971              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9971
  11+ 9971              Derivando_RND
  12+ 9971
  13+ 9971 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9973 C5               push bc
  15+ 9974              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9974 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9977              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9977
  19+ 9977 A7           6 and a                                 ; Carry a "0".
  20+ 9978 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 997A 30 02            jr nc,1F
  22+ 997C
  23+ 997C CB C1            set 0,c
  24+ 997E
  25+ 997E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 997F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9981 5F               ld e,a
  28+ 9982
  29+ 9982 7A               ld a,d
  30+ 9983 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9985 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9987
  33+ 9987 CB 3F            srl a
  34+ 9989
  35+ 9989 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 998A
  37+ 998A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 998B 28 04            jr z,4F
  39+ 998D
  40+ 998D CB FF            set 7,a
  41+ 998F 18 02            jr 5F
  42+ 9991
  43+ 9991 CB BF        4 res 7,a
  44+ 9993
  45+ 9993 CB 21        5 sla c
  46+ 9995 10 E0            djnz 6B
  47+ 9997
  48+ 9997 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9998
  50+ 9998 77               ld (hl),a
  51+ 9999 23               inc hl
  52+ 999A C1               pop bc
  53+ 999B 10 D4            djnz 3B
  54+ 999D
  55+ 999D C9               ret
  56+ 999E
  57+ 999E
  58+ 999E
