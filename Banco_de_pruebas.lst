 580  94F4 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 581  94F6
 582  94F6 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 583  94F7              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 584  94F7              ;															; _baja de la pantalla cuando hemos superado el nivel.
 585  94F7
 586  94F7 00           Columnas db 0
 587  94F8 00           Limite_vertical db 0 										; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 588  94F9              ;															; 2ª Función de (Limite_vertical):
 589  94F9              ;															; Se inicializa a "0" cada vez que ejecutamos el bucle de entidades. Se utiliza como contador; se incrementa (+1) cada vez que se añade una_
 590  94F9              ;															; _descripción a la (Tabla_de_pintado). Este valor lo utiliza la rutina [Ordena_tabla_de_pintado] para ordenar la tabla antes de imprimir.
 591  94F9
 592  94F9
