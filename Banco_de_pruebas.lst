   5+ 941F              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 941F              ;   (XOR) bit a bit.
   7+ 941F              ;
   8+ 941F              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 941F
  10+ 941F              Derivando_RND
  11+ 941F
  12+ 941F 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9422
  14+ 9422 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9424 C5               push bc
  16+ 9425              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9425 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9428              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9428
  20+ 9428 A7           6 and a                                 ; Carry a "0".
  21+ 9429 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 942B 30 02            jr nc,1F
  23+ 942D
  24+ 942D CB C1            set 0,c
  25+ 942F
  26+ 942F 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9430 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9432 5F               ld e,a
  29+ 9433
  30+ 9433 7A               ld a,d
  31+ 9434 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9436 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9438
  34+ 9438 CB 3F            srl a
  35+ 943A
  36+ 943A AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 943B
  38+ 943B 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 943C 28 04            jr z,4F
  40+ 943E
  41+ 943E CB FF            set 7,a
  42+ 9440 18 02            jr 5F
  43+ 9442
  44+ 9442 CB BF        4 res 7,a
  45+ 9444
  46+ 9444 CB 21        5 sla c
  47+ 9446 10 E0            djnz 6B
  48+ 9448
  49+ 9448 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9449
  51+ 9449 77               ld (hl),a
  52+ 944A 23               inc hl
  53+ 944B C1               pop bc
  54+ 944C 10 D4            djnz 3B
  55+ 944E
  56+ 944E C9               ret
  57+ 944F
  58+ 944F
  59+ 944F
