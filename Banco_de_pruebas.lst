 434  949C              ;															  _palabras que componen el "movimiento_masticado".
 435  949C
 436  949C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 437  949C
 438  949C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 439  949D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 440  949D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 441  949D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 442  949D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
