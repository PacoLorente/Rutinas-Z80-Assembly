 582+ 9EEF              Loop_2:
 583+ 9EEF
 584+ 9EEF              ;   %xxxabccc
 585+ 9EEF
 586+ 9EEF              ;   %a ... Salida SPEAKER.
 587+ 9EEF              ;   %b ... MIC/EAR.
 588+ 9EEF              ;   %c ... BORDER Colour.
 589+ 9EEF
 590+ 9EEF
 591+ 9EEF 3E 10            ld a,%00010000          ; Borde negro.
 592+ 9EF1 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 593+ 9EF3
 594+ 9EF3              Delay_5:
 595+ 9EF3
 596+ 9EF3 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 597+ 9EF4
 598+ 9EF4 7C               ld a,h
 599+ 9EF5 B5               or l
 600+ 9EF6 20 FB            jr nz,Delay_5
 601+ 9EF8
 602+ 9EF8 2A 84 94         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 603+ 9EFB
 604+ 9EFB AF               xor a                   ; Borde negro.    ---     4 tstates
 605+ 9EFC D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 606+ 9EFE
 607+ 9EFE              Delay_6:
 608+ 9EFE
 609+ 9EFE 2B               dec hl
 610+ 9EFF
 611+ 9EFF 7C               ld a,h
 612+ 9F00 B5               or l
 613+ 9F01 20 FB            jr nz,Delay_6
