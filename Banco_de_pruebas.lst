  12  A3FF
  13  A3FF              	; --------------------------------------------------------------------------------
  14  A3FF              ;
  15  A3FF              ; 05/05/26
  16  A3FF              ;
  17  A3FF              ; Parámetros DRAW.
  18  A3FF              ;
  19  A3FF
  20  A3FF              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
  21  A3FF
  22  A3FF 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
  23  A400              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
  24  A400              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
  25  A400              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
  26  A400
  27  A400 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
  28  A401              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
  29  A401 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
  30  A402 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
  31  A403
  32  A403 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
  33  A404              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
  34  A404              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
  35  A404
  36  A404              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
  37  A404              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
  38  A404
  39  A404              ; Ejemplos:
  40  A404
  41  A404              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
  42  A404              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
  43  A404              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
  44  A404              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
  45  A404              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
  46  A404
  47  A404 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
  48  A405              ;															  _ que esta entidad haya colisionado con Amadeus.
  49  A405              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
  50  A405
  51  A405 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
  52  A407              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
  53  A407
  54  A407 00 00        Puntero_de_almacen_de_mov_masticados defw 0
  55  A409
  56  A409              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
  57  A409
  58  A409 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
  59  A40B              ;															  _palabras que componen el "movimiento_masticado".
  60  A40B
  61  A40B              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
  62  A40B
  63  A40B 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
  64  A40C              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
  65  A40C              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
  66  A40C              ;																							 8 - 2 (4ª vuelta - velocidad 2)
  67  A40C              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
  68  A40C
  69  A40C 00           Attr db 0 													; Atributos de la entidad.
  70  A40D
  71  A40D              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
  72  A40D
  73  A40D
  74  A40D
  75  A40D 00           Ctrl_2 db 0
  76  A40E              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
  77  A40E              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
  78  A40E              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
  79  A40E              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
  80  A40E              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
  81  A40E              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
  82  A40E              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
  83  A40E              ;
  84  A40E              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
  85  A40E              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
  86  A40E              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
  87  A40E              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
  88  A40E              ;															_ el último MOVIMIENTO que hayamos ejecutado.
  89  A40E              ;															BIT 4, ???
  90  A40E              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
  91  A40E              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
  92  A40E              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
  93  A40E              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
  94  A40E              ;															- La rutina [Borra_escudo], inicializará el FLAG.
  95  A40E
  96  A40E 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
  97  A40F              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
  98  A40F              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
  99  A40F              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 100  A40F              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 101  A40F              ;
 102  A40F              ; 															DESCRIPCIÖN:
 103  A40F              ;
 104  A40F              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 105  A40F              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 106  A40F              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 107  A40F              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 108  A40F              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 109  A40F              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 110  A40F              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 111  A40F              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 112  A40F              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 113  A40F              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 114  A40F              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 115  A40F              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 116  A40F              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 117  A40F              ;
 118  A40F              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 119  A40F              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 120  A40F              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 121  A40F
 122  A40F 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 123  A410              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 124  A410              ;															; _rojo - amarillo.
 125  A410
 126  A410 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 127  A411              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 128  A411
 129  A411 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 130  A413 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
 131  A415
 132  A415              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 133  A415
 134  A415 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 135  A416              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 136  A416              ;
 137  A416              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
 138  A416
 139  A416              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 140  A416
 141  A416              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
 142  A416              ;
 143  A416              ;	COLORES: 0 ..... NEGRO
 144  A416              ;    		 1 ..... AZUL    jr $
 145  A416              ; 			 2 ..... ROJO
 146  A416              ;			 3 ..... MAGENTA
 147  A416              ; 			 4 ..... VERDE
 148  A416              ; 			 5 ..... CIAN
 149  A416              ;			 6 ..... AMARILLO
 150  A416              ; 			 7 ..... BLANCO
 151  A416
 152  A416
 153  A416 00 00        Indice_Sprite_der defw 0
 154  A418 00 00        Indice_Sprite_izq defw 0
 155  A41A 00 00        Puntero_DESPLZ_der defw 0
 156  A41C 00 00        Puntero_DESPLZ_izq defw 0
 157  A41E 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 158  A420
 159  A420 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 160  A421              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 161  A421              ;															; _baja de la pantalla cuando hemos superado el nivel.
 162  A421
 163  A421 00           Columnas db 0
 164  A422 00           Limite_vertical db 0 										; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
