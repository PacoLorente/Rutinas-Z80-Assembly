 448  9645 00           Cola_de_desplazamiento db 0									; Este byte indica:
 449  9646
 450  9646              ;
 451  9646              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 452  9646              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 453  9646              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 454  9646              ;
 455  9646              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 456  9646              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 457  9646              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 458  9646              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 459  9646              ;
 460  9646              ;															;	"$ff" ..... Bucle infinito de repetición.
 461  9646              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 462  9646              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
