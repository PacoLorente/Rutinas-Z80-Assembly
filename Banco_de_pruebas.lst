 584+ A2EC C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A2EE 6F               ld l,a
 586+ A2EF D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A2F0
 588+ A2F0 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A2F1 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A2F3 67               ld h,a
