 307+ C150
 308+ C150              ; ----------------------------------------------------------------------------------------------
 309+ C150              ;
 310+ C150              ;   17/9/26
 311+ C150              ;
 312+ C150              ;   Emite un BEEP utilizando el núcleo de audio [Sound_Generator].
 313+ C150              ;
 314+ C150              ;   NO MODIFICA NINGÚN REGISTRO.
 315+ C150
 316+ C150              BEEP:
 317+ C150
 318+ C150 F5               push af
 319+ C151 C5               push bc
 320+ C152 D5               push de
 321+ C153 E5               push hl                                 ; STORE Regs.
 322+ C154
 323+ C154              ;   Parámetros de entrada para ejecutar [Sound_Generator].
 324+ C154
 325+ C154              ;   Configuración de un BEEP.
 326+ C154
 327+ C154              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 328+ C154              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 329+ C154              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 330+ C154              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 331+ C154              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 332+ C154
 333+ C154
 334+ C154 01 02 00         ld bc,$0002
 335+ C157 11 00 00         ld de,0
 336+ C15A 21 D0 00         ld hl,$00d0
 337+ C15D
 338+ C15D 22 06 96         ld (Sound),hl
 339+ C160
 340+ C160 CD 5F 9F         call Sound_Generator    ; v2. Ok.
 341+ C163
 342+ C163 21 00 00         ld hl,0
 343+ C166 22 06 96         ld (Sound),hl
 344+ C169
 345+ C169 E1               pop hl                                  ; RECOVERY Regs.
 346+ C16A D1               pop de
 347+ C16B C1               pop bc
 348+ C16C F1               pop af
 349+ C16D
 350+ C16D C9               ret
 351+ C16E
 352+ C16E              ; ----- ----- ----- ----- -----
 353+ C16E              ;
 354+ C16E              ;   23/9/26
 355+ C16E              ;
 356+ C16E              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C16E              ;
 358+ C16E              ;   HL define el sonido.
 359+ C16E              ;
 360+ C16E              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C16E              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C16E              ;
 363+ C16E              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C16E              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C16E              ;
 366+ C16E              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C16E              ;
 368+ C16E              ;   INPUTS: (Shot_sound) <> "0".
 369+ C16E              ;
 370+ C16E              ;   MODIFY: AF, HL y BC.
 371+ C16E              ;
 372+ C16E              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C16E
 374+ C16E              Play_shot_sound_effect:
 375+ C16E
 376+ C16E              ;   Exclusiones:
 377+ C16E
 378+ C16E 2A 0A 96         ld hl,(Shot_sound)
 379+ C171 7C               ld a,h
 380+ C172 B5               or l
 381+ C173 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C174
 383+ C174 3A DD 95         ld a,(Ctrl_6)
 384+ C177 CB 47            bit 0,a
 385+ C179 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C17A
 387+ C17A 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C17C
 389+ C17C              Loop_1:
 390+ C17C
 391+ C17C 3E 10            ld a,%00010000          ; Borde negro.
 392+ C17E D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C180
 394+ C180 45               ld b,l
 395+ C181
 396+ C181 10 FE        Delay_3 djnz Delay_3
 397+ C183
 398+ C183 AF               xor a                   ; Borde negro.
 399+ C184 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C186
 401+ C186 45               ld b,l
 402+ C187
 403+ C187 10 FE        Delay_4 djnz Delay_4
 404+ C189
 405+ C189              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C189
 407+ C189 2C               inc l
 408+ C18A 2C               inc l
 409+ C18B 2C               inc l
 410+ C18C 2C               inc l
 411+ C18D
 412+ C18D 25               dec h
 413+ C18E
 414+ C18E CC 98 C1         call z,Clean_shot_effect
 415+ C191
 416+ C191 0D               dec c
 417+ C192
 418+ C192 20 E8            jr nz,Loop_1
 419+ C194
 420+ C194 22 0A 96         ld (Shot_sound),hl
 421+ C197
 422+ C197 C9               ret
 423+ C198
 424+ C198              Clean_shot_effect:
 425+ C198
 426+ C198 21 00 00         ld hl,0
 427+ C19B 0E 01            ld c,1
 428+ C19D
 429+ C19D C9               ret
 430+ C19E
 431+ C19E              ;   -------------------------------------------------------------------------------------------
 432+ C19E              ;
 433+ C19E              ;   23/9/26
 434+ C19E              ;
 435+ C19E              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C19E              ;
 437+ C19E              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C19E              ;   _ [Sound_Generator].
 439+ C19E              ;
 440+ C19E              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C19E              ;
 442+ C19E              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C19E              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C19E              ;
 445+ C19E              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C19E              ;
 447+ C19E              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C19E              ;
 449+ C19E              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C19E
 451+ C19E              Play_burst_sound_effect:
 452+ C19E
 453+ C19E              ;   Exclusiones:
 454+ C19E
 455+ C19E 3A 0C 96         ld a,(Burst_sound)
 456+ C1A1 A7               and a
 457+ C1A2 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C1A3
 459+ C1A3 08               ex af,af
 460+ C1A4
 461+ C1A4 3A DD 95         ld a,(Ctrl_6)
 462+ C1A7 CB 47            bit 0,a
 463+ C1A9 C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C1AA
 465+ C1AA              ;   ----------------------
 466+ C1AA
 467+ C1AA CB C7            set 0,a
 468+ C1AC 32 DD 95         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C1AF
 470+ C1AF 08               ex af,af                ; Restore (Burst_sound).
 471+ C1B0
 472+ C1B0 67               ld h,a
 473+ C1B1 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C1B3
 475+ C1B3 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C1B4
 477+ C1B4 22 06 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C1B7 0E 03            ld c,3
 479+ C1B9 CD 98 9F         call Noise_efect
 480+ C1BC
 481+ C1BC D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C1BD
 483+ C1BD 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C1BE 94               sub h
 485+ C1BF
 486+ C1BF 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C1C1
 488+ C1C1 7C               ld a,h
 489+ C1C2 32 0C 96         ld (Burst_sound),a
 490+ C1C5
 491+ C1C5 C9               ret
 492+ C1C6
 493+ C1C6              Clean_burst_efect:
 494+ C1C6
 495+ C1C6 AF               xor a
 496+ C1C7 32 0C 96         ld (Burst_sound),a
 497+ C1CA
 498+ C1CA 3A DD 95         ld a,(Ctrl_6)
 499+ C1CD CB 87            res 0,a
 500+ C1CF 32 DD 95         ld (Ctrl_6),a
 501+ C1D2
 502+ C1D2 C9               ret
 503+ C1D3
 504+ C1D3              ;   -------------------------------------------------------------------------------------------
 505+ C1D3              ;
 506+ C1D3              ;   23/9/26
 507+ C1D3              ;
 508+ C1D3              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C1D3              ;   _ Shield_sound_effect.
 510+ C1D3              ;
 511+ C1D3              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C1D3              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C1D3              ;
 514+ C1D3              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C1D3              ;
 516+ C1D3              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C1D3              ;
 518+ C1D3              ;   MODIFY: AF'y BC.
 519+ C1D3
 520+ C1D3              Play_Shield_sound_effect:
 521+ C1D3
 522+ C1D3 3A 0D 96         ld a,(Shield_sound)
 523+ C1D6 A7               and a
 524+ C1D7 C8               ret z                   ; RET si no se ha iniciado SHIELD.
 525+ C1D8
 526+ C1D8 0E 02            ld c,2                  ; 2 ondas completas per frame.
 527+ C1DA
 528+ C1DA              Loop_3:
 529+ C1DA
 530+ C1DA 08               ex af,af
 531+ C1DB
 532+ C1DB 3E 10            ld a,%00010000          ; Black BORDER.
 533+ C1DD D3 FE            out ($fe),a             ; Beeper ON.
 534+ C1DF
 535+ C1DF 08               ex af,af
 536+ C1E0
 537+ C1E0 47               ld b,a
 538+ C1E1
 539+ C1E1 10 FE        Delay_7 djnz Delay_7
 540+ C1E3
 541+ C1E3 08               ex af,af
 542+ C1E4
 543+ C1E4 AF               xor a                   ; Black BORDER.
 544+ C1E5 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 545+ C1E7
 546+ C1E7 08               ex af,af
 547+ C1E8
 548+ C1E8 47               ld b,a
 549+ C1E9
 550+ C1E9 10 FE        Delay_8 djnz Delay_8
 551+ C1EB
 552+ C1EB 0D               dec c
 553+ C1EC
 554+ C1EC 20 EC            jr nz,Loop_3
 555+ C1EE
 556+ C1EE AF               xor a
 557+ C1EF 32 0D 96         ld (Shield_sound),a
 558+ C1F2
 559+ C1F2 C9               ret
 560+ C1F3
 561+ C1F3              ; ---------------------------------------------------------------
 562+ C1F3              ;
 563+ C1F3              ;   18/9/26
 564+ C1F3              ;
 565+ C1F3              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C1F3              ;
 567+ C1F3              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C1F3              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C1F3              ;
 570+ C1F3              ;   MODIFY: A y H.
 571+ C1F3              ;
 572+ C1F3              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C1F3
 574+ C1F3
 575+ C1F3              Init_Burst_sound:
 576+ C1F3
 577+ C1F3 3A 0C 96         ld a,(Burst_sound)
 578+ C1F6 A7               and a
 579+ C1F7 C0               ret nz                                           ; RET si ya está iniciado el efecto.
 580+ C1F8
 581+ C1F8              ;   Init Burst_sound_efect.
 582+ C1F8
 583+ C1F8              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C1F8
 585+ C1F8 26 35            ld h,Burst_sound_init_value
 586+ C1FA
 587+ C1FA 3A CF 90         ld a,(Impacto_Amadeus)
 588+ C1FD A7               and a
 589+ C1FE 28 02            jr z,1F
 590+ C200
 591+ C200 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C202
 593+ C202 7C           1 ld a,h
 594+ C203
 595+ C203 32 0C 96         ld (Burst_sound),a
 596+ C206
 597+ C206 C9               ret
