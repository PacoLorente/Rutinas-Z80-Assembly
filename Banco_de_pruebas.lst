3100  A030              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A030              ; ******************************************************************************************************************************************************************************************
   2+ A030              ;
   3+ A030              ;   3/4/25
   4+ A030              ;
   5+ A030              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A030              ;   (XOR) bit a bit.
   7+ A030              ;
   8+ A030              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A030              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A030
  11+ A030              Derivando_RND
  12+ A030
  13+ A030 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A032 C5               push bc
  15+ A033              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A033 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A036              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A036
  19+ A036 A7           6 and a                                 ; Carry a "0".
  20+ A037 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A039 30 02            jr nc,1F
  22+ A03B
  23+ A03B CB C1            set 0,c
  24+ A03D
  25+ A03D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A03E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A040 5F               ld e,a
  28+ A041
  29+ A041 7A               ld a,d
  30+ A042 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A044 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A046
  33+ A046 CB 3F            srl a
  34+ A048
  35+ A048 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A049
  37+ A049 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A04A 28 04            jr z,4F
  39+ A04C
  40+ A04C CB FF            set 7,a
  41+ A04E 18 02            jr 5F
  42+ A050
  43+ A050 CB BF        4 res 7,a
  44+ A052
  45+ A052 CB 21        5 sla c
  46+ A054 10 E0            djnz 6B
  47+ A056
  48+ A056 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A057
  50+ A057 77               ld (hl),a
  51+ A058 23               inc hl
  52+ A059 C1               pop bc
  53+ A05A 10 D4            djnz 3B
  54+ A05C
  55+ A05C C9               ret
  56+ A05D
  57+ A05D
  58+ A05D
# file closed: RND_Derivando.asm
