 731+ B5D5              ;----------------------------------------------------------------------------------------------------------------
 732+ B5D5              ;
 733+ B5D5              ;	5/08/22
 734+ B5D5              ;
 735+ B5D5              ;   NextScan.
 736+ B5D5              ;
 737+ B5D5              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 738+ B5D5              ;
 739+ B5D5              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 740+ B5D5              ;
 741+ B5D5              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 742+ B5D5              ;
 743+ B5D5              ;       DESTRUIDOS: AF y HL !!!
 744+ B5D5              ;
 745+ B5D5              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 746+ B5D5              ;
 747+ B5D5
 748+ B5D5              NextScan:
 749+ B5D5
 750+ B5D5 24           	inc h          							; Incrementamos el scanline.
 751+ B5D6 7C               ld a,h
 752+ B5D7 E6 07            and 7
 753+ B5D9 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 754+ B5DA
 755+ B5DA 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 756+ B5DB C6 20            add a,$20           							; Vamos a comprobarlo...
 757+ B5DD 6F               ld l,a
 758+ B5DE D8               ret c               							; Salimos si se produce el cambio de tercio.
 759+ B5DF
 760+ B5DF 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 761+ B5E0 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 762+ B5E2 67               ld h,a
 763+ B5E3 C9               ret
 764+ B5E4
 765+ B5E4              NextScan_15:
 766+ B5E4
 767+ B5E4 06 0F        	ld b,15
 768+ B5E6 CD D5 B5     1 call NextScan
 769+ B5E9 10 FB        	djnz 1B
 770+ B5EB
 771+ B5EB C9           	ret
 772+ B5EC
 773+ B5EC              ;----------------------------------------------------------------------------------------------------------------
 774+ B5EC              ;
 775+ B5EC              ;	5/08/22
 776+ B5EC              ;
 777+ B5EC              ;   PreviousScan.
 778+ B5EC              ;
 779+ B5EC              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 780+ B5EC              ;
 781+ B5EC              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 782+ B5EC              ;
 783+ B5EC              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 784+ B5EC              ;
 785+ B5EC              ;       DESTRUIDOS: AF y HL !!!
 786+ B5EC              ;
 787+ B5EC              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 788+ B5EC              ;
 789+ B5EC
 790+ B5EC              PreviousScan:
 791+ B5EC
 792+ B5EC 7C           	ld a,h
 793+ B5ED 25               dec h               							; Dec H.
 794+ B5EE E6 07            and 7
 795+ B5F0 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 796+ B5F1
 797+ B5F1 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 798+ B5F2 D6 20            sub $20             							; Vamos a comprobarlo...
 799+ B5F4 6F               ld l,a
 800+ B5F5 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 801+ B5F6
 802+ B5F6 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 803+ B5F7 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 804+ B5F9 67               ld h,a
 805+ B5FA C9               ret
 806+ B5FB
 807+ B5FB              PreviousScan_15:
 808+ B5FB
 809+ B5FB 06 0F        	ld b,15
 810+ B5FD CD EC B5     1 call PreviousScan
 811+ B600 10 FB        	djnz 1B
 812+ B602
 813+ B602 C9           	ret
 814+ B603
