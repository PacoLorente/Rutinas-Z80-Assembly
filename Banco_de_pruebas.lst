 298  8DC2              ;
 299  8DC2 00           Incrementa_puntero db 0						; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 300  8DC3              ;																; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 301  8DC3              ;																; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 302  8DC3
 303  8DC3 00           Incrementa_puntero_backup db 0
 304  8DC4 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 305  8DC5              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8DC5
 307  8DC5 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8DC6 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8DC7 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8DC8
 311  8DC8              ;
 312  8DC8              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8DC8              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8DC8              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8DC8              ;
 316  8DC8              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8DC8              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8DC8              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8DC8              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8DC8              ;
 321  8DC8              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8DC8              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8DC8              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 324  8DC8
 325  8DC8 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 326  8DC9
 327  8DC9              ;																DESCRIPCIÓN:
 328  8DC9              ;
 329  8DC9              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 330  8DC9              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 331  8DC9              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 332  8DC9              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 333  8DC9              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 334  8DC9              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 335  8DC9
 336  8DC9              ;																BIT 3, Recarga de nueva oleada.
 337  8DC9              ;																BIT 4, Recarga de nueva oleada.
 338  8DC9              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 339  8DC9              ;																BIT 6, **** Frame completo.
 340  8DC9              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 341  8DC9
