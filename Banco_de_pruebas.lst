 240+ C0F9 0E 21        	ld c,$21
 241+ C0FB 2E CD        	ld l,$cd
 242+ C0FD
 243+ C0FD 22 06 96     	ld (Sound),hl
 244+ C100 CD 67 9F         call Sound_Generator
 245+ C103
 246+ C103              Pause_4:
 247+ C103
 248+ C103 01 00 40         ld bc,$4000
 249+ C106 CD 3A 9B         call DELAY 												; PAUSE.
