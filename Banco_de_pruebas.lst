   6+ A1B5              ;	Limpia la pantalla y define sus atributos.
   7+ A1B5              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A1B5              ;
   9+ A1B5              ;	COLORES: 0 ..... NEGRO
  10+ A1B5              ;    		 1 ..... AZUL
  11+ A1B5              ; 			 2 ..... ROJO
  12+ A1B5              ;			 3 ..... MAGENTA
  13+ A1B5              ; 			 4 ..... VERDE
  14+ A1B5              ; 			 5 ..... CIAN
  15+ A1B5              ;			 6 ..... AMARILLO
  16+ A1B5              ; 			 7 ..... BLANCO
  17+ A1B5              ;
  18+ A1B5              ;	INPUT: A contiene los atributos de pantalla.
  19+ A1B5              ;
  20+ A1B5              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A1B5
  22+ A1B5
  23+ A1B5 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A1B8 11 01 40     	LD DE,$4001
  25+ A1BB 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A1BE 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A1C0 ED B0        	LDIR
  28+ A1C2 01 FF 02     	LD BC,767
  29+ A1C5 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A1C6 ED B0        	LDIR
  31+ A1C8
  32+ A1C8 AF           	xor a
  33+ A1C9
  34+ A1C9 C9           	ret
  35+ A1CA
