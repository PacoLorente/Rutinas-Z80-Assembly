 349  91AD 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 350  91AE              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 351  91AE
 352  91AE 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 353  91AF 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 354  91B0 00           Cola_de_desplazamiento db 0									; Este byte indica:
 355  91B1
 356  91B1              ;
 357  91B1              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 358  91B1              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 359  91B1              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 360  91B1              ;
 361  91B1              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 362  91B1              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 363  91B1              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 364  91B1              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 365  91B1              ;
 366  91B1              ;															;	"$ff" ..... Bucle infinito de repetición.
 367  91B1              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 368  91B1              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 369  91B1
 370  91B1 00           Ctrl_1 db 0 												; Byte de control de propósito general.
