 564+ B000              ;
 565+ B000              ;   NextScan.
 566+ B000              ;
 567+ B000              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ B000              ;
 569+ B000              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ B000              ;
 571+ B000              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ B000              ;
 573+ B000              ;       DESTRUIDOS: AF y HL !!!
 574+ B000              ;
 575+ B000              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ B000              ;
 577+ B000
 578+ B000 24           NextScan inc h          							; Incrementamos el scanline.
 579+ B001 7C               ld a,h
 580+ B002 E6 07            and 7
 581+ B004 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ B005
 583+ B005 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B006 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B008 6F               ld l,a
 586+ B009 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B00A
 588+ B00A 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B00B D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B00D 67               ld h,a
 591+ B00E C9               ret
