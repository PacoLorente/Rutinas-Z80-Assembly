   5+ 9BDB              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9BDB              ;   (XOR) bit a bit.
   7+ 9BDB              ;
   8+ 9BDB              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9BDB              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9BDB
  11+ 9BDB              Derivando_RND
  12+ 9BDB
  13+ 9BDB ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9BDD C5               push bc
  15+ 9BDE              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9BDE 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9BE1              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9BE1
  19+ 9BE1 A7           6 and a                                 ; Carry a "0".
  20+ 9BE2 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9BE4 30 02            jr nc,1F
  22+ 9BE6
  23+ 9BE6 CB C1            set 0,c
  24+ 9BE8
  25+ 9BE8 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9BE9 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9BEB 5F               ld e,a
  28+ 9BEC
  29+ 9BEC 7A               ld a,d
  30+ 9BED E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9BEF 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9BF1
  33+ 9BF1 CB 3F            srl a
  34+ 9BF3
  35+ 9BF3 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9BF4
  37+ 9BF4 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9BF5 28 04            jr z,4F
  39+ 9BF7
  40+ 9BF7 CB FF            set 7,a
  41+ 9BF9 18 02            jr 5F
  42+ 9BFB
  43+ 9BFB CB BF        4 res 7,a
  44+ 9BFD
  45+ 9BFD CB 21        5 sla c
  46+ 9BFF 10 E0            djnz 6B
  47+ 9C01
  48+ 9C01 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C02
  50+ 9C02 77               ld (hl),a
  51+ 9C03 23               inc hl
  52+ 9C04 C1               pop bc
  53+ 9C05 10 D4            djnz 3B
  54+ 9C07
  55+ 9C07 C9               ret
