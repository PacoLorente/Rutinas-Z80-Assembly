 151  8EFA 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 152  8EFB              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 153  8EFB              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 154  8EFB              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 155  8EFB
 156  8EFB 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 157  8EFC              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 158  8EFC 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 159  8EFD 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 160  8EFE
 161  8EFE 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 162  8EFF              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 163  8EFF              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 164  8EFF
 165  8EFF              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 166  8EFF              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 167  8EFF
 168  8EFF              ; Ejemplos:
 169  8EFF
 170  8EFF              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 171  8EFF              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 172  8EFF              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 173  8EFF              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 174  8EFF              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 175  8EFF
 176  8EFF 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 177  8F00              ;															  _ que esta entidad haya colisionado con Amadeus.
 178  8F00              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 179  8F00
 180  8F00 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 181  8F02              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 182  8F02
 183  8F02 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 184  8F04
 185  8F04              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 186  8F04
 187  8F04 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 188  8F06              ;															  _palabras que componen el "movimiento_masticado".
 189  8F06
 190  8F06              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 191  8F06
 192  8F06 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 193  8F07              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 194  8F07              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 195  8F07              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 196  8F07              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 197  8F07
 198  8F07 00           Attr db 0 													; Atributos de la entidad.
