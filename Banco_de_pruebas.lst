 393+ C17B
 394+ C17B 45               ld b,l
 395+ C17C
 396+ C17C 10 FE        Delay_3 djnz Delay_3
 397+ C17E
 398+ C17E AF               xor a                   ; Borde negro.
 399+ C17F D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
