 256  95C6              ;
 257  95C6              ; 05/05/26
 258  95C6              ;
 259  95C6              ; Parámetros DRAW.
 260  95C6              ;
 261  95C6
 262  95C6              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 263  95C6
 264  95C6 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 265  95C7              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 266  95C7              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 267  95C7              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 268  95C7
 269  95C7 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 270  95C8              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 271  95C8
 272  95C8 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 273  95C9              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 274  95C9              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 275  95C9
 276  95C9              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 277  95C9              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 278  95C9
 279  95C9              ; Ejemplos:
 280  95C9
 281  95C9              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 282  95C9              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 283  95C9              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 284  95C9              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 285  95C9              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 286  95C9
 287  95C9 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 288  95CA              ;															  _ que esta entidad haya colisionado con Amadeus.
 289  95CA              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 290  95CA
 291  95CA 00 00        Puntero_de_impresion defw 0									; Esta variable tiene dos funciones, la primera:
 292  95CC              ;
 293  95CC              ;															; Es utilizada por la rutina [Define_menu] para almacenar el puntero indicial: Define_menu_index_parameters.
 294  95CC              ;
 295  95CC              ;															; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 296  95CC              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 297  95CC
 298  95CC 00 40        Puntero_de_almacen_de_mov_masticados defw Line_0
 299  95CE
