 679+ 9F57
 680+ 9F57              ;   %xxxabccc
 681+ 9F57
 682+ 9F57              ;   %a ... Salida SPEAKER.
 683+ 9F57              ;   %b ... MIC/EAR.
 684+ 9F57              ;   %c ... BORDER Colour.
 685+ 9F57
 686+ 9F57
 687+ 9F57 3E 10            ld a,%00010000          ; Borde negro.
