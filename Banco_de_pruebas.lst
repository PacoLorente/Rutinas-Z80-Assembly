   1+ B0C3              ; ******************************************************************************************************************************************************************************************
   2+ B0C3              ;
   3+ B0C3              ;   3/4/25
   4+ B0C3              ;
   5+ B0C3              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ B0C3              ;   (XOR) bit a bit.
   7+ B0C3              ;
   8+ B0C3              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ B0C3              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ B0C3
  11+ B0C3              Derivando_RND
  12+ B0C3
  13+ B0C3 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ B0C5 C5               push bc
  15+ B0C6              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ B0C6 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ B0C9              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ B0C9
  19+ B0C9 A7           6 and a                                 ; Carry a "0".
  20+ B0CA CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ B0CC 30 02            jr nc,1F
  22+ B0CE
  23+ B0CE CB C1            set 0,c
  24+ B0D0
  25+ B0D0 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ B0D1 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ B0D3 5F               ld e,a
  28+ B0D4
  29+ B0D4 7A               ld a,d
  30+ B0D5 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ B0D7 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ B0D9
  33+ B0D9 CB 3F            srl a
  34+ B0DB
  35+ B0DB AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ B0DC
  37+ B0DC 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ B0DD 28 04            jr z,4F
  39+ B0DF
  40+ B0DF CB FF            set 7,a
  41+ B0E1 18 02            jr 5F
  42+ B0E3
  43+ B0E3 CB BF        4 res 7,a
  44+ B0E5
  45+ B0E5 CB 21        5 sla c
  46+ B0E7 10 E0            djnz 6B
  47+ B0E9
  48+ B0E9 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ B0EA
  50+ B0EA 77               ld (hl),a
  51+ B0EB 23               inc hl
  52+ B0EC C1               pop bc
  53+ B0ED 10 D4            djnz 3B
  54+ B0EF
  55+ B0EF C9               ret
  56+ B0F0
  57+ B0F0
  58+ B0F0
# file closed: RND_Derivando.asm
