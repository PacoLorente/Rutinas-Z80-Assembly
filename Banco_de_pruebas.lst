 338  91A9
 339  91A9 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 340  91AA 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 341  91AB 00           Cola_de_desplazamiento db 0									; Este byte indica:
 342  91AC
 343  91AC              ;
 344  91AC              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 345  91AC              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 346  91AC              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 347  91AC              ;
 348  91AC              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 349  91AC              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 350  91AC              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 351  91AC              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 352  91AC              ;
 353  91AC              ;															;	"$ff" ..... Bucle infinito de repetición.
 354  91AC              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 355  91AC              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 356  91AC
