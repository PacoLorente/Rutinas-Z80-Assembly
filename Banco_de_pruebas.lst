 345+ C18E E1               pop hl                                  ; RECOVERY Regs.
 346+ C18F D1               pop de
 347+ C190 C1               pop bc
 348+ C191 F1               pop af
 349+ C192
 350+ C192 C9               ret
 351+ C193
 352+ C193              ; ----- ----- ----- ----- -----
 353+ C193              ;
 354+ C193              ;   23/9/26
 355+ C193              ;
 356+ C193              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C193              ;
 358+ C193              ;   HL define el sonido.
 359+ C193              ;
 360+ C193              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C193              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C193              ;
 363+ C193              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C193              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C193              ;
 366+ C193              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C193              ;
 368+ C193              ;   INPUTS: (Shot_sound) <> "0".
 369+ C193              ;
 370+ C193              ;   MODIFY: AF, HL y BC.
 371+ C193              ;
 372+ C193              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C193
 374+ C193              Play_shot_sound_effect:
 375+ C193
 376+ C193              ;   Exclusiones:
 377+ C193
 378+ C193 2A B2 96         ld hl,(Shot_sound)
 379+ C196 7C               ld a,h
 380+ C197 B5               or l
 381+ C198 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C199
 383+ C199 3A 85 96         ld a,(Ctrl_6)
 384+ C19C CB 47            bit 0,a
 385+ C19E C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C19F
 387+ C19F 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C1A1
 389+ C1A1              Loop_1:
 390+ C1A1
 391+ C1A1 3E 10            ld a,%00010000          ; Borde negro.
 392+ C1A3 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C1A5
 394+ C1A5 45               ld b,l
 395+ C1A6
 396+ C1A6 10 FE        Delay_3 djnz Delay_3
 397+ C1A8
 398+ C1A8 AF               xor a                   ; Borde negro.
 399+ C1A9 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C1AB
 401+ C1AB 45               ld b,l
 402+ C1AC
 403+ C1AC 10 FE        Delay_4 djnz Delay_4
 404+ C1AE
 405+ C1AE              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C1AE
 407+ C1AE 2C               inc l
 408+ C1AF 2C               inc l
 409+ C1B0 2C               inc l
 410+ C1B1 2C               inc l
 411+ C1B2
 412+ C1B2 25               dec h
 413+ C1B3
 414+ C1B3 CC BD C1         call z,Clean_shot_effect
 415+ C1B6
 416+ C1B6 0D               dec c
 417+ C1B7
 418+ C1B7 20 E8            jr nz,Loop_1
 419+ C1B9
 420+ C1B9 22 B2 96         ld (Shot_sound),hl
