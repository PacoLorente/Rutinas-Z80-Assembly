   5+ 9D3F              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D3F              ;   (XOR) bit a bit.
   7+ 9D3F              ;
   8+ 9D3F              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D3F              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D3F
  11+ 9D3F              Derivando_RND
  12+ 9D3F
  13+ 9D3F ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D41 C5               push bc
  15+ 9D42              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D42 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D45              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D45
  19+ 9D45 A7           6 and a                                 ; Carry a "0".
  20+ 9D46 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D48 30 02            jr nc,1F
  22+ 9D4A
  23+ 9D4A CB C1            set 0,c
  24+ 9D4C
  25+ 9D4C 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D4D E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D4F 5F               ld e,a
  28+ 9D50
  29+ 9D50 7A               ld a,d
  30+ 9D51 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D53 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D55
  33+ 9D55 CB 3F            srl a
  34+ 9D57
  35+ 9D57 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D58
  37+ 9D58 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D59 28 04            jr z,4F
  39+ 9D5B
  40+ 9D5B CB FF            set 7,a
  41+ 9D5D 18 02            jr 5F
  42+ 9D5F
  43+ 9D5F CB BF        4 res 7,a
  44+ 9D61
  45+ 9D61 CB 21        5 sla c
  46+ 9D63 10 E0            djnz 6B
  47+ 9D65
  48+ 9D65 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D66
  50+ 9D66 77               ld (hl),a
  51+ 9D67 23               inc hl
  52+ 9D68 C1               pop bc
  53+ 9D69 10 D4            djnz 3B
  54+ 9D6B
  55+ 9D6B C9               ret
