 357  90D9              ;																DESCRIPCIÓN:
 358  90D9              ;
 359  90D9              ;															BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 360  90D9              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 361  90D9              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos? en lugar de `Scanlines_album?.
 362  90D9              ;															BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 363  90D9              ;															BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 364  90D9              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 365  90D9
 366  90D9              ;															BIT 3, Recarga de nueva oleada.
 367  90D9              ;															BIT 4, Recarga de nueva oleada.
 368  90D9              ;															BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 369  90D9              ;															BIT 6, **** Frame completo.
 370  90D9              ;															BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 371  90D9
