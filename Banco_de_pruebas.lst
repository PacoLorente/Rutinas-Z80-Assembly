 183+ C1CD 21 7C 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 184+ C1D0              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 185+ C1D0 11 8B 94         ld de,Score_max_msg
