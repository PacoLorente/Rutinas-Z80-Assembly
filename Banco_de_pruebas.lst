# file opened: Patrones_de_mov.asm
   1+ A19F
   2+ A19F
   3+ A19F              ;   07/07/23
   4+ A19F              ;
   5+ A19F              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ A19F              ;
   7+ A19F              ;   Codificación:
   8+ A19F              ;
   9+ A19F              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ A19F              ;
  11+ A19F              ;   Un desplazamiento tiene la siguiente estructura:
  12+ A19F              ;
  13+ A19F              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ A19F              ;
  15+ A19F              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ A19F              ;
  17+ A19F              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ A19F              ;                               ..... %01000010 Vel_up 4
  19+ A19F              ;                                               Vel_down 2
  20+ A19F              ;                               ..... $42
  21+ A19F              ;
  22+ A19F              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ A19F              ;
  24+ A19F              ;                               ..... %01000010 Vel_left 4
  25+ A19F              ;                                               Vel_right 2
  26+ A19F              ;                               ..... $42
  27+ A19F              ;
  28+ A19F              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ A19F              ;
  30+ A19F              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ A19F              ;
  32+ A19F              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ A19F              ;
  34+ A19F              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ A19F              ;                                     $53
  36+ A19F              ;
  37+ A19F              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ A19F              ;
  39+ A19F              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ A19F              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ A19F              ;
  42+ A19F              ;                       Arriba ..... $81
  43+ A19F              ;                       Arriba - izquierda ..... $a1
  44+ A19F              ;                       Arriba - derecha ..... $91
  45+ A19F              ;
  46+ A19F              ;                       Abajo ..... $41
  47+ A19F              ;                       Abajo - izquierda ..... $61
  48+ A19F              ;                       Abajo - derecha ..... $51
  49+ A19F              ;
  50+ A19F              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ A19F              ;
  52+ A19F              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ A19F              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ A19F              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ A19F              ;
  56+ A19F              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ A19F              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ A19F              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ A19F              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ A19F              ;
  61+ A19F              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ A19F              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ A19F              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ A19F              ;
  65+ A19F              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ A19F              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ A19F              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ A19F              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ A19F
