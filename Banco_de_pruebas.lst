 248  8F0B 00           Columns db 0 												; Nº de columnas. [DRAW]
 249  8F0C 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 250  8F0E 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
