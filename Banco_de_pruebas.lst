 555+ 9EEB              ;
 556+ 9EEB              ;   17/9/26
 557+ 9EEB              ;
 558+ 9EEB              ;   Herramienta para construir melodías y ruido con el SPEAKER.
 559+ 9EEB
 560+ 9EEB              Sound_Generator:
 561+ 9EEB
 562+ 9EEB              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 563+ 9EEB              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 564+ 9EEB              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 565+ 9EEB              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 566+ 9EEB              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 567+ 9EEB              ;
 568+ 9EEB
 569+ 9EEB              ;   MODIFY: A,HL,BC y DE.
 570+ 9EEB
 571+ 9EEB              ;   Exclusión:
 572+ 9EEB
 573+ 9EEB 2A 8A 94         ld hl,(Sound)
 574+ 9EEE 7C               ld a,h
 575+ 9EEF B5               or l
 576+ 9EF0 C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 577+ 9EF1
 578+ 9EF1 04               inc b
 579+ 9EF2 05               dec b
 580+ 9EF3 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
 581+ 9EF5
 582+ 9EF5              Loop_2:
 583+ 9EF5
 584+ 9EF5              ;   %xxxabccc
 585+ 9EF5
 586+ 9EF5              ;   %a ... Salida SPEAKER.
 587+ 9EF5              ;   %b ... MIC/EAR.
 588+ 9EF5              ;   %c ... BORDER Colour.
 589+ 9EF5
 590+ 9EF5
 591+ 9EF5 3E 10            ld a,%00010000          ; Borde negro.
 592+ 9EF7 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 593+ 9EF9
 594+ 9EF9              Delay_5:
 595+ 9EF9
 596+ 9EF9 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 597+ 9EFA
 598+ 9EFA 7C               ld a,h
 599+ 9EFB B5               or l
 600+ 9EFC 20 FB            jr nz,Delay_5
 601+ 9EFE
 602+ 9EFE 2A 8A 94         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 603+ 9F01
 604+ 9F01 AF               xor a                   ; Borde negro.    ---     4 tstates
 605+ 9F02 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 606+ 9F04
 607+ 9F04              Delay_6:
 608+ 9F04
 609+ 9F04 2B               dec hl
 610+ 9F05
 611+ 9F05 7C               ld a,h
 612+ 9F06 B5               or l
 613+ 9F07 20 FB            jr nz,Delay_6
 614+ 9F09
 615+ 9F09              ; Hemos generado una onda sonora.
 616+ 9F09              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 617+ 9F09
 618+ 9F09 2A 8A 94         ld hl,(Sound)
 619+ 9F0C
 620+ 9F0C 1C               inc e
 621+ 9F0D 1D               dec e
 622+ 9F0E 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 623+ 9F10              ;                           ; (E)="0" indica que no hay variación en el tono.
 624+ 9F10
 625+ 9F10 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 626+ 9F11 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 627+ 9F12
 628+ 9F12              ; Rayo de entrada o de salida ???
 629+ 9F12
 630+ 9F12 A7               and a
 631+ 9F13 20 05            jr nz,Incrementa_delay
 632+ 9F15
 633+ 9F15              Decrementa_delay:
 634+ 9F15
 635+ 9F15 2B               dec hl
 636+ 9F16 10 FD            djnz Decrementa_delay
 637+ 9F18
 638+ 9F18 18 03            jr 1F
 639+ 9F1A
 640+ 9F1A              Incrementa_delay:
 641+ 9F1A
 642+ 9F1A 23               inc hl
 643+ 9F1B 10 FD            djnz Incrementa_delay
 644+ 9F1D
 645+ 9F1D              ; Descontamos la onda generada del total de ondas que tiene el efecto, (Sound).
 646+ 9F1D
 647+ 9F1D 0D           1 dec c                     ; Decrementa nº de ondas.
 648+ 9F1E
 649+ 9F1E 22 8A 94         ld (Sound),hl
 650+ 9F21
 651+ 9F21 20 D2            jr nz,Loop_2
 652+ 9F23
 653+ 9F23 C9               ret
 654+ 9F24
 655+ 9F24              ;   Efecto de ruido, se puede utilizar, (entre otras cosas) para generar explosiones, disparos, etc.
 656+ 9F24              ;   Este tipo de onda NO ES SIMÉTRICA, el semiciclo positivo y el negativo tienen una duración distinta.
 657+ 9F24              ;   Cada onda completa que compone el sonido es distinta a la anterior siendo el registro (C) el que contiene el_
 658+ 9F24              ;   _nº de ondas que vamos a ejecutar.
 659+ 9F24              ;   El registro R proporciona el nº pseudo aleatorio que construye los dos semiciclos de la onda.
 660+ 9F24
 661+ 9F24              Noise_efect:
 662+ 9F24
 663+ 9F24              Loop:
 664+ 9F24
 665+ 9F24 ED 5F            ld a,r
 666+ 9F26 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 667+ 9F27
 668+ 9F27 3E 10            ld a,%00010000          ; Borde negro.
 669+ 9F29 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 670+ 9F2B
 671+ 9F2B 10 FE        Delay_1 djnz Delay_1        ; Aplica Delay.
 672+ 9F2D
 673+ 9F2D AF               xor a
 674+ 9F2E D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 675+ 9F30
 676+ 9F30 ED 5F            ld a,r
 677+ 9F32 47               ld b,a                  ; (B) contiene un nº pseudo aleatorio ($00 - $ff).
 678+ 9F33
 679+ 9F33 10 FE        Delay_2 djnz Delay_2        ; Aplica Delay.
 680+ 9F35
 681+ 9F35 25               dec h
 682+ 9F36
 683+ 9F36 0D               dec c                   ; Decrementa ondas completas generadas.
 684+ 9F37
 685+ 9F37 20 EB            jr nz,Loop
 686+ 9F39
 687+ 9F39 22 8A 94         ld (Sound),hl
 688+ 9F3C
 689+ 9F3C C9               ret
 690+ 9F3D
