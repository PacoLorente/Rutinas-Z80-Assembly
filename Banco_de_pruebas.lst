 352+ C160
 353+ C160              ;   -------------------------------------------------------------------------------------------
 354+ C160              ;
 355+ C160              ;   23/9/26
 356+ C160              ;
 357+ C160              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 358+ C160              ;
 359+ C160              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 360+ C160              ;   _ [Sound_Generator].
 361+ C160              ;
 362+ C160              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 363+ C160              ;
 364+ C160              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 365+ C160              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 366+ C160              ;
 367+ C160              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 368+ C160              ;
 369+ C160              ;   MODIFY: AF',AF, HL, DE y BC.
 370+ C160              ;
 371+ C160              ;   OUTPUT: Actualiza (Burst_sound).
 372+ C160
 373+ C160              Play_burst_sound_effect:
 374+ C160
 375+ C160              ;   Exclusiones:
 376+ C160
 377+ C160 3A EB 94         ld a,(Burst_sound)
 378+ C163 A7               and a
 379+ C164 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 380+ C165
 381+ C165 08               ex af,af
 382+ C166
 383+ C166 3A BB 94         ld a,(Ctrl_6)
 384+ C169 CB 47            bit 0,a
 385+ C16B C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 386+ C16C
 387+ C16C              ;   ----------------------
 388+ C16C
 389+ C16C CB C7            set 0,a
 390+ C16E 32 BB 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 391+ C171
 392+ C171 08               ex af,af                ; Restore (Burst_sound).
 393+ C172
 394+ C172 67               ld h,a
 395+ C173 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 396+ C175
 397+ C175 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 398+ C176
 399+ C176 22 E4 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 400+ C179 0E 03            ld c,3
 401+ C17B CD 7B 9F         call Noise_efect
 402+ C17E
 403+ C17E D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 404+ C17F
 405+ C17F 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 406+ C180 94               sub h
 407+ C181
 408+ C181 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 409+ C183
 410+ C183 7C               ld a,h
 411+ C184 32 EB 94         ld (Burst_sound),a
 412+ C187
 413+ C187 C9               ret
