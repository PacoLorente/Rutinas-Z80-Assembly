  10+ 96BE              ;    		 1 ..... AZUL
  11+ 96BE              ; 			 2 ..... ROJO
  12+ 96BE              ;			 3 ..... MAGENTA
  13+ 96BE              ; 			 4 ..... VERDE
  14+ 96BE              ; 			 5 ..... CIAN
  15+ 96BE              ;			 6 ..... AMARILLO
