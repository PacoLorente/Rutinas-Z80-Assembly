3099  A047              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A047              ; ******************************************************************************************************************************************************************************************
   2+ A047              ;
   3+ A047              ;   3/4/25
   4+ A047              ;
   5+ A047              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A047              ;   (XOR) bit a bit.
   7+ A047              ;
   8+ A047              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A047              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A047
  11+ A047              Derivando_RND
  12+ A047
  13+ A047 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A049 C5               push bc
  15+ A04A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A04A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A04D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A04D
  19+ A04D A7           6 and a                                 ; Carry a "0".
  20+ A04E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A050 30 02            jr nc,1F
  22+ A052
  23+ A052 CB C1            set 0,c
  24+ A054
  25+ A054 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A055 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A057 5F               ld e,a
  28+ A058
  29+ A058 7A               ld a,d
  30+ A059 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A05B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A05D
  33+ A05D CB 3F            srl a
  34+ A05F
  35+ A05F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A060
  37+ A060 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A061 28 04            jr z,4F
  39+ A063
  40+ A063 CB FF            set 7,a
  41+ A065 18 02            jr 5F
  42+ A067
  43+ A067 CB BF        4 res 7,a
  44+ A069
  45+ A069 CB 21        5 sla c
  46+ A06B 10 E0            djnz 6B
  47+ A06D
  48+ A06D 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A06E
  50+ A06E 77               ld (hl),a
  51+ A06F 23               inc hl
  52+ A070 C1               pop bc
  53+ A071 10 D4            djnz 3B
  54+ A073
  55+ A073 C9               ret
  56+ A074
  57+ A074
  58+ A074
# file closed: RND_Derivando.asm
