   5+ 96CD              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 96CD              ;   (XOR) bit a bit.
   7+ 96CD              ;
   8+ 96CD              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 96CD              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 96CD
  11+ 96CD              Derivando_RND
  12+ 96CD
  13+ 96CD ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 96CF C5               push bc
  15+ 96D0              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 96D0 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 96D3              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 96D3
  19+ 96D3 A7           6 and a                                 ; Carry a "0".
  20+ 96D4 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 96D6 30 02            jr nc,1F
  22+ 96D8
  23+ 96D8 CB C1            set 0,c
  24+ 96DA
  25+ 96DA 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 96DB E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 96DD 5F               ld e,a
  28+ 96DE
  29+ 96DE 7A               ld a,d
  30+ 96DF E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 96E1 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 96E3
  33+ 96E3 CB 3F            srl a
  34+ 96E5
  35+ 96E5 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 96E6
  37+ 96E6 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 96E7 28 04            jr z,4F
  39+ 96E9
  40+ 96E9 CB FF            set 7,a
  41+ 96EB 18 02            jr 5F
  42+ 96ED
  43+ 96ED CB BF        4 res 7,a
  44+ 96EF
  45+ 96EF CB 21        5 sla c
  46+ 96F1 10 E0            djnz 6B
  47+ 96F3
  48+ 96F3 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 96F4
  50+ 96F4 77               ld (hl),a
  51+ 96F5 23               inc hl
  52+ 96F6 C1               pop bc
  53+ 96F7 10 D4            djnz 3B
  54+ 96F9
  55+ 96F9 C9               ret
