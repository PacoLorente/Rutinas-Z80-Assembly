   1+ A04D              ; ******************************************************************************************************************************************************************************************
   2+ A04D              ;
   3+ A04D              ;   3/4/25
   4+ A04D              ;
   5+ A04D              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A04D              ;   (XOR) bit a bit.
   7+ A04D              ;
   8+ A04D              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A04D              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A04D
  11+ A04D              Derivando_RND
  12+ A04D
  13+ A04D ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A04F C5               push bc
  15+ A050              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A050 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A053              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A053
  19+ A053 A7           6 and a                                 ; Carry a "0".
  20+ A054 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A056 30 02            jr nc,1F
  22+ A058
  23+ A058 CB C1            set 0,c
  24+ A05A
  25+ A05A 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A05B E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A05D 5F               ld e,a
  28+ A05E
  29+ A05E 7A               ld a,d
  30+ A05F E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A061 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A063
  33+ A063 CB 3F            srl a
  34+ A065
  35+ A065 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A066
  37+ A066 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A067 28 04            jr z,4F
  39+ A069
  40+ A069 CB FF            set 7,a
  41+ A06B 18 02            jr 5F
  42+ A06D
  43+ A06D CB BF        4 res 7,a
  44+ A06F
  45+ A06F CB 21        5 sla c
  46+ A071 10 E0            djnz 6B
  47+ A073
  48+ A073 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A074
  50+ A074 77               ld (hl),a
  51+ A075 23               inc hl
  52+ A076 C1               pop bc
  53+ A077 10 D4            djnz 3B
  54+ A079
  55+ A079 C9               ret
  56+ A07A
  57+ A07A
  58+ A07A
# file closed: RND_Derivando.asm
