 555  94EB              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 556  94EB
 557  94EB 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 558  94EC              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 559  94EC              ;
 560  94EC              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
