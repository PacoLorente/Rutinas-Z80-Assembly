 150  8C63 00           Tipo db 0												; Clase de la entidad. Cada `tipo´ de Entidad tiene unas características únicas que lo distinguen de otros tipos:
 151  8C64              ;
 152  8C64 00           Coordenada_X db 0 							; Coordenada X del objeto. (En chars.)
 153  8C65 00           Coordenada_y db 0 								; Coordenada Y del objeto. (En chars.)
 154  8C66
 155  8C66 00           Contador_de_vueltas db 0					; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición a la izquierda cada vez que la entidad_
 156  8C67              ;															; _desaparece por la parte baja de la pantalla. Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 157  8C67
 158  8C67              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 159  8C67              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 160  8C67              ; Ejemplos.
 161  8C67
 162  8C67              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 163  8C67              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 164  8C67              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 165  8C67              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 166  8C67              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 167  8C67
 168  8C67 00           Impacto db 0											; Si después del movimiento de la entidad, (Impacto) se coloca a "1",_
 169  8C68              ;																; _ existen muchas posibilidades de que esta entidad haya colisionado con Amadeus.
 170  8C68              ; 																; Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 171  8C68
 172  8C68 00 00        Puntero_de_impresion defw 0					; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 173  8C6A              ;																; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 174  8C6A
 175  8C6A 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 176  8C6C
 177  8C6C              ;																; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 178  8C6C
 179  8C6C 00 00        Contador_de_mov_masticados defw 0	; Contador de 16bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 180  8C6E              ;																; _palabras que componen el "movimiento_masticado".
 181  8C6E
 182  8C6E              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 183  8C6E
 184  8C6E 00           Velocidad db 0 										; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 185  8C6F              ;																					 2 - 0 (2ª vuelta - velocidad 0)
 186  8C6F              ;																					 4 - 1 (3ª vuelta - velocidad 1)
 187  8C6F              ;																					 8 - 2 (4ª vuelta - velocidad 2)
 188  8C6F              ;																				 $10 - 4 (5ª vuelta - velocidad 3)
 189  8C6F
