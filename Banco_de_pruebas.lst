   5+ 99E1              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99E1              ;   (XOR) bit a bit.
   7+ 99E1              ;
   8+ 99E1              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99E1              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99E1
  11+ 99E1              Derivando_RND
  12+ 99E1
  13+ 99E1 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99E3 C5               push bc
  15+ 99E4              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99E4 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99E7              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99E7
  19+ 99E7 A7           6 and a                                 ; Carry a "0".
  20+ 99E8 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99EA 30 02            jr nc,1F
  22+ 99EC
  23+ 99EC CB C1            set 0,c
  24+ 99EE
  25+ 99EE 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99EF E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99F1 5F               ld e,a
  28+ 99F2
  29+ 99F2 7A               ld a,d
  30+ 99F3 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99F5 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99F7
  33+ 99F7 CB 3F            srl a
  34+ 99F9
  35+ 99F9 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99FA
  37+ 99FA 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99FB 28 04            jr z,4F
  39+ 99FD
  40+ 99FD CB FF            set 7,a
  41+ 99FF 18 02            jr 5F
  42+ 9A01
  43+ 9A01 CB BF        4 res 7,a
  44+ 9A03
  45+ 9A03 CB 21        5 sla c
  46+ 9A05 10 E0            djnz 6B
  47+ 9A07
  48+ 9A07 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9A08
  50+ 9A08 77               ld (hl),a
  51+ 9A09 23               inc hl
  52+ 9A0A C1               pop bc
  53+ 9A0B 10 D4            djnz 3B
  54+ 9A0D
  55+ 9A0D C9               ret
