 616+ C3CE
 617+ C3CE 3A 5D 96         ld a,(Numero_de_teclas_definidas)                       ; N° de teclas ya definidas.
 618+ C3D1 A7               and a
 619+ C3D2 28 0B            jr z,2F                                                 ; (Numero_de_teclas_definidas)="0" Indica que estamos definiendo Move_LEFT.
 620+ C3D4              ;                                                           ; (Numero_de_teclas_definidas) se incrementa en una unidad cada vez que se define una tecla:
 621+ C3D4              ;
 622+ C3D4              ;                                                           ; Ej.: Si estamos definiendo Move_RIGHT, (Numero_de_teclas_definidas)="1"
 623+ C3D4              ;                                                           ;      Si estamos definiendo Move_FIRE, (Numero_de_teclas_definidas)="2"
 624+ C3D4              ;                                                           ;      Si estamos definiendo Move_SHIELD, (Numero_de_teclas_definidas)="3"
 625+ C3D4
 626+ C3D4 47               ld b,a                                                  ; Así, (B) contiene el nº de teclas definidas -1.
 627+ C3D5
 628+ C3D5              ;   (Numero_de_teclas_definidas) contiene el n° de comparativas que realizaremos entre el nuevo KEYCODE definido y los anteriormente definidos.
 629+ C3D5              ;   Así evitaremos que se asigne una misma tecla para varias funciones distintas.
