   5+ 9D9E              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D9E              ;   (XOR) bit a bit.
   7+ 9D9E              ;
   8+ 9D9E              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D9E              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D9E
  11+ 9D9E              Derivando_RND
  12+ 9D9E
  13+ 9D9E ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9DA0 C5               push bc
  15+ 9DA1              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9DA1 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9DA4              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9DA4
  19+ 9DA4 A7           6 and a                                 ; Carry a "0".
  20+ 9DA5 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9DA7 30 02            jr nc,1F
  22+ 9DA9
  23+ 9DA9 CB C1            set 0,c
  24+ 9DAB
  25+ 9DAB 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9DAC E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9DAE 5F               ld e,a
  28+ 9DAF
  29+ 9DAF 7A               ld a,d
  30+ 9DB0 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9DB2 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9DB4
  33+ 9DB4 CB 3F            srl a
  34+ 9DB6
  35+ 9DB6 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9DB7
  37+ 9DB7 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9DB8 28 04            jr z,4F
  39+ 9DBA
  40+ 9DBA CB FF            set 7,a
  41+ 9DBC 18 02            jr 5F
  42+ 9DBE
  43+ 9DBE CB BF        4 res 7,a
  44+ 9DC0
  45+ 9DC0 CB 21        5 sla c
  46+ 9DC2 10 E0            djnz 6B
  47+ 9DC4
  48+ 9DC4 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9DC5
  50+ 9DC5 77               ld (hl),a
  51+ 9DC6 23               inc hl
  52+ 9DC7 C1               pop bc
  53+ 9DC8 10 D4            djnz 3B
  54+ 9DCA
  55+ 9DCA C9               ret
