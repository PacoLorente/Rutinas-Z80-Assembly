 381+ A848              ;
 382+ A848              ;   23/6/25
 383+ A848              ;
 384+ A848              ;	Prepara las CAJAS MASTER y genera los movimientos masticados de todos los (Tipo)s de entidades que conforman el nivel.
 385+ A848              ;
 386+ A848              ;	INPUTS:		B contiene (Numero_de_entidades).
 387+ A848              ;				C contiene la (Clase) de la 1ª entidad del nivel.
 388+ A848              ; 				HL contiene (Puntero_de_entidades).
 389+ A848
 390+ A848              Prepara_Cajas_Master:
 391+ A848
 392+ A848 E5           	push hl															; Push (Puntero_de_entidades).
 393+ A849 C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 394+ A84A
 395+ A84A              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 396+ A84A
 397+ A84A 79           	ld a,c
 398+ A84B 08           	ex af,af
 399+ A84C 79           	ld a,c 															; (Clase) de la entidad en A y A´.
 400+ A84D
 401+ A84D CD 6E AA     	call Situa_en_Caja_Master										; A="0" Indica que hemos de generar los movimientos masticados de esta (Clase) de entidad.
 402+ A850              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 403+ A850              ; 																	; Saltaremos a la siguiente entidad del nivel.
 404+ A850 A7           	and a
 405+ A851 20 41        	jr nz, Avanza_siguiente_entidad_del_nivel
 406+ A853
 407+ A853              ; Generamos movimientos masticados.
 408+ A853
 409+ A853              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 410+ A853
 411+ A853 79           	ld a,c 															; (A) = (Clase).
 412+ A854
 413+ A854 CD 37 AB     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 414+ A857 CD C7 AB     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 415+ A85A
 416+ A85A              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 417+ A85A              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 418+ A85A              ;	coreografías distintas.
 419+ A85A
 420+ A85A 06 07        	ld b,7
 421+ A85C 21 07 A0     	ld hl,Numeros_aleatorios_baile
 422+ A85F CD 80 A6     	call Derivando_RND 										 		; Generamos 7 nº RND para construir los mov. masticados.
 423+ A862
 424+ A862              ;> Comentando las 3 siguientes líneas eliminamos la aleatoriedad de la danza de la entidad.	---------------------------------------------------------------------------------
 425+ A862
 426+ A862 3A 4A CC     	ld a,(Tipo)
 427+ A865 CD 9B AA     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 428+ A868 CD ED A9     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
 429+ A86B
 430+ A86B              ;> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 431+ A86B
 432+ A86B C1           	pop bc
 433+ A86C E1           	pop hl
 434+ A86D
 435+ A86D E5           	push hl															; Push (Puntero_de_entidades).
 436+ A86E C5           	push bc															; Push (Numero_de_entidades)/(Clase).
 437+ A86F
 438+ A86F              ; 	Antes de empezar a generar los "movimientos masticados" de esta entidad necesitamos determinar su (Posicion_inicio).
 439+ A86F
 440+ A86F CD AC A8     	call Determina_posicion_de_inicio 								; $941e ($78),($76),($72)
 441+ A872
 442+ A872 3A 4A CC     	ld a,(Tipo)
 443+ A875 CD AB AA     	call Situa_Puntero_indice_mov			 	 					; Sitúa (Puntero_indice_mov) según el (Tipo) de entidad en el 1er .defw del índice de su coreogradía.
 444+ A878
 445+ A878              ;	Ya disponemos de una (Posicion_inicio) aleatoria y la definición de la entidad en la "Bandeja DRAW".
 446+ A878              ;	Generamos "Movimientos masticados" de la entidad.
 447+ A878
 448+ A878 CD 71 A9     	call Construye_movimientos_masticados_entidad
 449+ A87B
 450+ A87B              Movimientos_masticados_construidos:
 451+ A87B
 452+ A87B 2A 89 CC     	ld hl,(Puntero_indice_master)
 453+ A87E CD 76 D3     	call Extrae_address
 454+ A881
 455+ A881 5D           	ld e,l
 456+ A882 54           	ld d,h
 457+ A883
 458+ A883 CD FB AB     	call Parametros_de_bandeja_DRAW_a_Caja_Master	 				; Caja de entidades Master completa.
 459+ A886
 460+ A886              ;	Limpiamos la bandeja_DRAW y las variables de movimiento para poder generar los mov. masticados_
 461+ A886              ;	_de otro (Tipo) de entidad.
 462+ A886              ;
 463+ A886              ;	Limpiamos bandeja y variables.
 464+ A886
 465+ A886 AF           	xor a
 466+ A887 32 BC CC     	ld (Ctrl_3),a 													; (Ctrl_3) ha de inicializarse pués lo utilizamos para indicar_
 467+ A88A              ;																	; _, (entre otras cosas) cuando finalizamos de generar los mov. masticados.
 468+ A88A 21 49 CC     	ld hl,Clase
 469+ A88D 01 3A 00     	ld bc,Gestion_de_ENTIDADES_y_CAJAS-Bandeja_DRAW
 470+ A890
 471+ A890 0B           	dec bc
