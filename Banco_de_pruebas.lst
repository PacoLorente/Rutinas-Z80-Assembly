 572+ AFCA              ;
 573+ AFCA              ;       DESTRUIDOS: AF y HL !!!
 574+ AFCA              ;
 575+ AFCA              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ AFCA              ;
 577+ AFCA
 578+ AFCA 24           NextScan inc h          							; Incrementamos el scanline.
 579+ AFCB 7C               ld a,h
 580+ AFCC E6 07            and 7
 581+ AFCE C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ AFCF
 583+ AFCF 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ AFD0 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ AFD2 6F               ld l,a
 586+ AFD3 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ AFD4
 588+ AFD4 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ AFD5 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ AFD7 67               ld h,a
 591+ AFD8 C9               ret
