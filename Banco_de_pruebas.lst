 315  90CE 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 316  90D0 00 00        Puntero_indice_mov_bucle defw 0
 317  90D2              ;
 318  90D2              ;
 319  90D2 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 320  90D3              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 321  90D3              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
