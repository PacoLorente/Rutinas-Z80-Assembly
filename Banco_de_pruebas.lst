3117  A1AC              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A1AC              ; ******************************************************************************************************************************************************************************************
   2+ A1AC              ;
   3+ A1AC              ;   3/4/25
   4+ A1AC              ;
   5+ A1AC              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A1AC              ;   (XOR) bit a bit.
   7+ A1AC              ;
   8+ A1AC              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A1AC              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A1AC
  11+ A1AC              Derivando_RND
  12+ A1AC
  13+ A1AC ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A1AE C5               push bc
  15+ A1AF              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A1AF 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A1B2              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A1B2
  19+ A1B2 A7           6 and a                                 ; Carry a "0".
  20+ A1B3 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A1B5 30 02            jr nc,1F
  22+ A1B7
  23+ A1B7 CB C1            set 0,c
  24+ A1B9
  25+ A1B9 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A1BA E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A1BC 5F               ld e,a
  28+ A1BD
  29+ A1BD 7A               ld a,d
  30+ A1BE E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A1C0 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A1C2
  33+ A1C2 CB 3F            srl a
  34+ A1C4
  35+ A1C4 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A1C5
  37+ A1C5 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A1C6 28 04            jr z,4F
  39+ A1C8
  40+ A1C8 CB FF            set 7,a
  41+ A1CA 18 02            jr 5F
  42+ A1CC
  43+ A1CC CB BF        4 res 7,a
  44+ A1CE
  45+ A1CE CB 21        5 sla c
  46+ A1D0 10 E0            djnz 6B
  47+ A1D2
  48+ A1D2 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A1D3
  50+ A1D3 77               ld (hl),a
  51+ A1D4 23               inc hl
  52+ A1D5 C1               pop bc
  53+ A1D6 10 D4            djnz 3B
  54+ A1D8
  55+ A1D8 C9               ret
  56+ A1D9
  57+ A1D9
  58+ A1D9
# file closed: RND_Derivando.asm
