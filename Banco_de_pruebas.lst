   3+ 9796              ;
   4+ 9796              ;	CLS.
   5+ 9796              ;
   6+ 9796              ;	Limpia la pantalla y define sus atributos.
   7+ 9796              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ 9796              ;
   9+ 9796              ;	COLORES: 0 ..... NEGRO
  10+ 9796              ;    		 1 ..... AZUL
  11+ 9796              ; 			 2 ..... ROJO
  12+ 9796              ;			 3 ..... MAGENTA
  13+ 9796              ; 			 4 ..... VERDE
  14+ 9796              ; 			 5 ..... CIAN
  15+ 9796              ;			 6 ..... AMARILLO
  16+ 9796              ; 			 7 ..... BLANCO
  17+ 9796              ;
  18+ 9796              ;	INPUT: A contiene los atributos de pantalla.
  19+ 9796              ;
  20+ 9796              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 9796
  22+ 9796
  23+ 9796 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ 9799 11 01 40     	LD DE,$4001
  25+ 979C 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 979F 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 97A1 ED B0        	LDIR
  28+ 97A3 01 FF 02     	LD BC,767
  29+ 97A6 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 97A7 ED B0        	LDIR
  31+ 97A9 C9           	ret
  32+ 97AA
