  28+ A1D7 01 FF 02     	LD BC,767
  29+ A1DA 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A1DB ED B0        	LDIR
  31+ A1DD
  32+ A1DD AF           	xor a
  33+ A1DE
  34+ A1DE C9           	ret
  35+ A1DF
