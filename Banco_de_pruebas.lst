 232  8E30
 233  8E30 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 234  8E31              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 235  8E31              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 236  8E31              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 237  8E31
 238  8E31 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 239  8E32              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 240  8E32 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 241  8E33 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 242  8E34
 243  8E34 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 244  8E35              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 245  8E35              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 246  8E35
 247  8E35              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 248  8E35              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 249  8E35
 250  8E35              ; Ejemplos:
 251  8E35
 252  8E35              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 253  8E35              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
