  24+ A5D2 11 01 40     	LD DE,$4001
  25+ A5D5 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A5D8 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A5DA ED B0        	LDIR
  28+ A5DC 01 FF 02     	LD BC,767
  29+ A5DF 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A5E0 ED B0        	LDIR
  31+ A5E2
  32+ A5E2 AF           	xor a
  33+ A5E3
  34+ A5E3 C9           	ret
  35+ A5E4
