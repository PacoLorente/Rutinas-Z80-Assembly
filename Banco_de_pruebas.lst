 775+ A259              ;	"2" Derecha   ..... Key code $1c
 776+ A259              ;	"3" Abajo     ..... Key code $14
 777+ A259              ;	"4" Arriba    ..... Key code $0c
 778+ A259              ;	"5" Disparo   ..... Key code $04
 779+ A259              ;
 780+ A259              ;	Funcionamiento de la rutina:
 781+ A259              ;
