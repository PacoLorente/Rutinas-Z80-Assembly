 421+ C130 CC 3A C1         call z,Clean_shot_effect
 422+ C133
 423+ C133 0D               dec c
 424+ C134
 425+ C134 20 E8            jr nz,Loop_1
 426+ C136
 427+ C136 22 7D 94         ld (Shot_sound),hl
