 248  8EF4 00           Columns db 0 												; Nº de columnas. [DRAW]
 249  8EF5 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 250  8EF7 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
