 153  8C52              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 154  8C52
 155  8C52 00           Tipo db 0												; Clase de la entidad. Cada `tipo´ de Entidad tiene unas características únicas que lo distinguen de otros tipos:
 156  8C53              ;															- Patrón de movimiento.
 157  8C53 00           Coordenada_X db 0 										; Coordenada X del objeto. (En chars.)
 158  8C54 00           Coordenada_y db 0 										; Coordenada Y del objeto. (En chars.)
 159  8C55
 160  8C55 00           Contador_de_vueltas db 0								; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición a la izquierda cada vez que la entidad_
 161  8C56              ;														; _desaparece por la parte baja de la pantalla. Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 162  8C56
 163  8C56              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 164  8C56              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 165  8C56              ; Ejemplos.
 166  8C56
 167  8C56              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 168  8C56              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 169  8C56              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 170  8C56              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 171  8C56              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 172  8C56
 173  8C56 00           Impacto db 0											; Si después del movimiento de la entidad, (Impacto) se coloca a "1",_
 174  8C57              ;														; _ existen muchas posibilidades de que esta entidad haya colisionado con Amadeus.
 175  8C57              ; 														; Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 176  8C57
 177  8C57 00 00        Puntero_de_impresion defw 0								; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 178  8C59              ;														; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 179  8C59
 180  8C59 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 181  8C5B
 182  8C5B              ;	Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 183  8C5B
 184  8C5B 00 00        Contador_de_mov_masticados defw 0						; Contador de 16bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 185  8C5D              ;														; _palabras que componen el "movimiento_masticado".
 186  8C5D
 187  8C5D              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 188  8C5D
 189  8C5D 00           Velocidad db 0 											; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 190  8C5E              ;																						 2 - 0 (2ª vuelta - velocidad 0)
 191  8C5E              ;																						 4 - 1 (3ª vuelta - velocidad 1)
 192  8C5E              ;																						 8 - 2 (4ª vuelta - velocidad 2)
 193  8C5E              ;																					   $10 - 4 (5ª vuelta - velocidad 3)
 194  8C5E
 195  8C5E 00           Attr db 0 												; Atributos de la entidad.
 196  8C5F
 197  8C5F 00           Ctrl_2 db 0
 198  8C60              ;														BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 199  8C60              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 200  8C60              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 201  8C60              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 202  8C60              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 203  8C60              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 204  8C60              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 205  8C60              ;
 206  8C60              ;														BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 207  8C60              ;														BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 208  8C60              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 209  8C60              ;														BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 210  8C60              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 211  8C60              ;														BIT 4, ???
 212  8C60              ;														BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 213  8C60
 214  8C60 00           Ctrl_0 db 0 											; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 215  8C61              ;														; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 216  8C61              ; 														; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer´ por el contrario.
 217  8C61              ; 														; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 218  8C61              ; 														; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición´ por un extremo del cuadrante y la `reaparición´ por el otro.
 219  8C61              ;
 220  8C61              ; 														DESCRIPCIÖN:
 221  8C61              ;
 222  8C61              ; 														SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido´ por el_
 223  8C61              ; 																_lado izquierdo de la pantalla y ha de `reaparecer´ por el derecho. ([Comprueba_limite_vertical]).
 224  8C61              ; 														SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido´ por el_
 225  8C61              ; 																_lado derecho de la pantalla y ha de `reaparecer´ por el izquierdo. ([Comprueba_limite_vertical]).
 226  8C61              ; 														SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido´ por la_
 227  8C61              ; 																_parte superior de la pantalla y ha de `reaparecer´ por el inferior. ([Comprueba_limite_horizontal]).
 228  8C61              ; 														SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido´ por la_
 229  8C61              ; 																_parte inferior de la pantalla y ha de `reaparecer´ por la superior. ([Comprueba_limite_horizontal]).
 230  8C61              ; 														SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 231  8C61              ;												                _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 232  8C61              ;														SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 233  8C61              ;																_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar´ un objeto.
 234  8C61              ; 														SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine´ es AMADEUS.
 235  8C61              ;
 236  8C61              ; 														SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 237  8C61              ; 															   _ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 238  8C61              ; 															   _ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 239  8C61
