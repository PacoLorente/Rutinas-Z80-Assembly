 630  9433              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 631  9433
 632  9433 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 633  9434 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 634  9435 00           Cola_de_desplazamiento db 0									; Este byte indica:
 635  9436
 636  9436              ;
 637  9436              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 638  9436              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 639  9436              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 640  9436              ;
 641  9436              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 642  9436              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 643  9436              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 644  9436              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 645  9436              ;
 646  9436              ;															;	"$ff" ..... Bucle infinito de repetición.
 647  9436              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 648  9436              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 649  9436
