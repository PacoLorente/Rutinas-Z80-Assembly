   1+ A512              ;	Variables de programa.
   2+ A512
   3+ A512              Bandeja_DRAW:
   4+ A512
   5+ A512 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
   6+ A513              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
   7+ A513              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
   8+ A513              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
   9+ A513
  10+ A513 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
  11+ A514              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
  12+ A514 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
  13+ A515 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
  14+ A516
  15+ A516 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
  16+ A517              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
  17+ A517              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
  18+ A517
  19+ A517              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
  20+ A517              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
  21+ A517
  22+ A517              ; Ejemplos:
  23+ A517
  24+ A517              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
  25+ A517              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
  26+ A517              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
  27+ A517              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
  28+ A517              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
  29+ A517
  30+ A517 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
  31+ A518              ;															  _ que esta entidad haya colisionado con Amadeus.
  32+ A518              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
  33+ A518
  34+ A518 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
  35+ A51A              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
  36+ A51A
  37+ A51A 00 00        Puntero_de_almacen_de_mov_masticados defw 0
  38+ A51C
  39+ A51C              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
  40+ A51C
  41+ A51C 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
  42+ A51E              ;															  _palabras que componen el "movimiento_masticado".
  43+ A51E
  44+ A51E              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
  45+ A51E
  46+ A51E 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
  47+ A51F              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
  48+ A51F              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
  49+ A51F              ;																							 8 - 2 (4ª vuelta - velocidad 2)
