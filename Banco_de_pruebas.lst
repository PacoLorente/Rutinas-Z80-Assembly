   1+ 948F              ; ******************************************************************************************************************************************************************************************
   2+ 948F              ;
   3+ 948F              ;   3/4/25
   4+ 948F              ;
   5+ 948F              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 948F              ;   (XOR) bit a bit.
   7+ 948F              ;
   8+ 948F              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 948F              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 948F
  11+ 948F              Derivando_RND
  12+ 948F
  13+ 948F ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9491 C5               push bc
  15+ 9492              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9492 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9495              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9495
  19+ 9495 A7           6 and a                                 ; Carry a "0".
  20+ 9496 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9498 30 02            jr nc,1F
  22+ 949A
  23+ 949A CB C1            set 0,c
  24+ 949C
  25+ 949C 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 949D E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 949F 5F               ld e,a
  28+ 94A0
  29+ 94A0 7A               ld a,d
  30+ 94A1 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 94A3 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 94A5
  33+ 94A5 CB 3F            srl a
  34+ 94A7
