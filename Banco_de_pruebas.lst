 161  8E34 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 162  8E35              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 163  8E35              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 164  8E35
 165  8E35              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 166  8E35              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 167  8E35
 168  8E35              ; Ejemplos:
 169  8E35
 170  8E35              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 171  8E35              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 172  8E35              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 173  8E35              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 174  8E35              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 175  8E35
 176  8E35 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 177  8E36              ;															  _ que esta entidad haya colisionado con Amadeus.
 178  8E36              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 179  8E36
 180  8E36 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 181  8E38              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 182  8E38
 183  8E38 00 00        Puntero_de_almacen_de_mov_masticados defw 0
