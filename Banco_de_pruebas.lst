 409+ ACE1              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 410+ ACE1
 411+ ACE1 79           	ld a,c 															; (A) = (Clase).
 412+ ACE2
 413+ ACE2 CD C5 AF     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 414+ ACE5 CD 55 B0     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
 415+ ACE8
 416+ ACE8              ;	Antes de fabricar los movimientos masticados de una entidad generaremos un set de 7 nº aleatorios.
 417+ ACE8              ;	Así nos aseguramos de que dos entidades `del mismo (Tipo)', (que comparten PATRÓN_DE_MOV) tengan_
 418+ ACE8              ;	coreografías distintas.
