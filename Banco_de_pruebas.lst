 161  8E60 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 162  8E61              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 163  8E61              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 164  8E61
 165  8E61              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 166  8E61              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 167  8E61
 168  8E61              ; Ejemplos:
 169  8E61
 170  8E61              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 171  8E61              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 172  8E61              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 173  8E61              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 174  8E61              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 175  8E61
