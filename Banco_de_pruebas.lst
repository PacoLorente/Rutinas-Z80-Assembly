 179  8C85
 180  8C85 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 181  8C87
 182  8C87              ;																; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 183  8C87
 184  8C87 00 00        Contador_de_mov_masticados defw 0	; Contador de 16bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 185  8C89              ;																; _palabras que componen el "movimiento_masticado".
 186  8C89
 187  8C89              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 188  8C89
 189  8C89 00           Velocidad db 0 										; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 190  8C8A              ;																					 2 - 0 (2ª vuelta - velocidad 0)
 191  8C8A              ;																					 4 - 1 (3ª vuelta - velocidad 1)
 192  8C8A              ;																					 8 - 2 (4ª vuelta - velocidad 2)
 193  8C8A              ;																				 $10 - 4 (5ª vuelta - velocidad 3)
 194  8C8A
