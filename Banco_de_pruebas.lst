1398+ A9A8
1399+ A9A8              ;   NO HAY COLISIÓN !!!!!.
1400+ A9A8              ;
1401+ A9A8              ;   .db (Impacto) de Amadeus a "0".
1402+ A9A8              ;   RES el bit2 de (Impacto2).
1403+ A9A8              ;
1404+ A9A8              ;   Nota: El .db (Impacto) de la entidad implicada lo puso a "1" la rutina [Compara_coordenadas_X].
1405+ A9A8              ;   Lo colocamos a "0".
1406+ A9A8
1407+ A9A8 21 0B 8D         ld hl,Impacto2
1408+ A9AB CB 96            res 2,(hl)
1409+ A9AD 2A 0C 8D         ld hl,(Entidad_sospechosa_de_colision)
1410+ A9B0 36 00            ld (hl),0                                       ; Coloca a "0" el .db (Impacto) de la (Entidad_sospechosa_de_colision).
1411+ A9B2 C9               ret
1412+ A9B3
1413+ A9B3              ;   COLISIÓN !!!!!.
1414+ A9B3              ;
1415+ A9B3              ;   .db (Impacto) de Amadeus a "1".
1416+ A9B3              ;   SET el bit3 de (Impacto2).
1417+ A9B3              ;
1418+ A9B3              ;   Nota: El .db (Impacto) de la entidad implicada lo puso a "1" la rutina [Compara_coordenadas_X].
1419+ A9B3
1420+ A9B3 E1           5 pop hl
1421+ A9B4 C1               pop bc
1422+ A9B5
1423+ A9B5 21 D5 89         ld hl,Impacto_Amadeus
1424+ A9B8 36 01            ld (hl),1
1425+ A9BA 21 0B 8D         ld hl,Impacto2                                 ; Cuando se produce Colisión, RES el bit2 de (Impacto2) y_
1426+ A9BD CB 96            res 2,(hl)                                     ; _ SET el bit3. El bit3 de (Impacto2) indica que hay contacto_
1427+ A9BF
1428+ A9BF 11 C0 87         ld de,Indice_Explosion_entidades
1429+ A9C2 2A 0C 8D         ld hl,(Entidad_sospechosa_de_colision)         ; Situamos el (Puntero_de_almacen_de_mov_masticados) de la entidad impactada en la primera palabra del índice de explosiones.
1430+ A9C5
1431+ A9C5 23               inc hl
1432+ A9C6 23               inc hl
1433+ A9C7 23               inc hl
1434+ A9C8
1435+ A9C8 73               ld (hl),e
1436+ A9C9 23               inc hl
1437+ A9CA 72               ld (hl),d
