  19  A609              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ A609
   2+ A609
   3+ A609              ;   07/07/23
   4+ A609              ;
   5+ A609              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ A609              ;
   7+ A609              ;   Codificación:
   8+ A609              ;
   9+ A609              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ A609              ;
  11+ A609              ;   Un desplazamiento tiene la siguiente estructura:
  12+ A609              ;
  13+ A609              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ A609              ;
  15+ A609              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ A609              ;
  17+ A609              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ A609              ;                               ..... %01000010 Vel_up 4
  19+ A609              ;                                               Vel_down 2
  20+ A609              ;                               ..... $42
  21+ A609              ;
  22+ A609              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ A609              ;
  24+ A609              ;                               ..... %01000010 Vel_left 4
  25+ A609              ;                                               Vel_right 2
  26+ A609              ;                               ..... $42
  27+ A609              ;
  28+ A609              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ A609              ;
  30+ A609              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ A609              ;
  32+ A609              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ A609              ;
  34+ A609              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ A609              ;                                     $53
  36+ A609              ;
  37+ A609              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ A609              ;
  39+ A609              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ A609              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ A609              ;
  42+ A609              ;                       Arriba ..... $81
  43+ A609              ;                       Arriba - izquierda ..... $a1
  44+ A609              ;                       Arriba - derecha ..... $91
  45+ A609              ;
  46+ A609              ;                       Abajo ..... $41
  47+ A609              ;                       Abajo - izquierda ..... $61
  48+ A609              ;                       Abajo - derecha ..... $51
  49+ A609              ;
  50+ A609              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ A609              ;
  52+ A609              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ A609              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ A609              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ A609              ;
  56+ A609              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ A609              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ A609              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ A609              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ A609              ;
  61+ A609              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ A609              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ A609              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ A609              ;
  65+ A609              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ A609              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ A609              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ A609              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ A609
