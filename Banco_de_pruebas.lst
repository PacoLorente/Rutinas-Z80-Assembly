   4+ 9987              ;
   5+ 9987              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9987              ;   (XOR) bit a bit.
   7+ 9987              ;
   8+ 9987              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9987              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9987
  11+ 9987              Derivando_RND
  12+ 9987
  13+ 9987 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9989 C5               push bc
  15+ 998A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 998A 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 998D              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 998D
  19+ 998D A7           6 and a                                 ; Carry a "0".
  20+ 998E CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9990 30 02            jr nc,1F
  22+ 9992
  23+ 9992 CB C1            set 0,c
  24+ 9994
  25+ 9994 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9995 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9997 5F               ld e,a
  28+ 9998
  29+ 9998 7A               ld a,d
  30+ 9999 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 999B 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 999D
  33+ 999D CB 3F            srl a
  34+ 999F
  35+ 999F AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99A0
  37+ 99A0 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99A1 28 04            jr z,4F
  39+ 99A3
  40+ 99A3 CB FF            set 7,a
  41+ 99A5 18 02            jr 5F
  42+ 99A7
  43+ 99A7 CB BF        4 res 7,a
  44+ 99A9
  45+ 99A9 CB 21        5 sla c
  46+ 99AB 10 E0            djnz 6B
  47+ 99AD
  48+ 99AD 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99AE
  50+ 99AE 77               ld (hl),a
  51+ 99AF 23               inc hl
  52+ 99B0 C1               pop bc
  53+ 99B1 10 D4            djnz 3B
  54+ 99B3
  55+ 99B3 C9               ret
  56+ 99B4
  57+ 99B4
  58+ 99B4
