 415+ A3EC
 416+ A3EC 3A 18 94     	ld a,(Tipo)
 417+ A3EF CD 27 A6     	call Situa_en_Tabla_Random 										; Sitúa HL en el 1er .db de la `Tabla_Random´ del (Tipo) de entidad correspondiente.
 418+ A3F2 CD 79 A5     	call Aplica_rnd_al_baile 										; Esta rutina es la encargada de aplicar aleatoriedad a la danza de esta (Clase) de enemigo.;
