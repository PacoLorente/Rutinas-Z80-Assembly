   5+ 9D5B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D5B              ;   (XOR) bit a bit.
   7+ 9D5B              ;
   8+ 9D5B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D5B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D5B
  11+ 9D5B              Derivando_RND
  12+ 9D5B
  13+ 9D5B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D5D C5               push bc
  15+ 9D5E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D5E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D61              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D61
  19+ 9D61 A7           6 and a                                 ; Carry a "0".
  20+ 9D62 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D64 30 02            jr nc,1F
  22+ 9D66
  23+ 9D66 CB C1            set 0,c
  24+ 9D68
  25+ 9D68 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D69 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D6B 5F               ld e,a
  28+ 9D6C
  29+ 9D6C 7A               ld a,d
  30+ 9D6D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D6F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D71
  33+ 9D71 CB 3F            srl a
  34+ 9D73
  35+ 9D73 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D74
  37+ 9D74 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D75 28 04            jr z,4F
  39+ 9D77
  40+ 9D77 CB FF            set 7,a
  41+ 9D79 18 02            jr 5F
  42+ 9D7B
  43+ 9D7B CB BF        4 res 7,a
  44+ 9D7D
  45+ 9D7D CB 21        5 sla c
  46+ 9D7F 10 E0            djnz 6B
  47+ 9D81
  48+ 9D81 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D82
  50+ 9D82 77               ld (hl),a
  51+ 9D83 23               inc hl
  52+ 9D84 C1               pop bc
  53+ 9D85 10 D4            djnz 3B
  54+ 9D87
  55+ 9D87 C9               ret
