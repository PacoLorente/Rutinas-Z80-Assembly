   5+ 99DE              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99DE              ;   (XOR) bit a bit.
   7+ 99DE              ;
   8+ 99DE              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99DE              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99DE
  11+ 99DE              Derivando_RND
  12+ 99DE
  13+ 99DE ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99E0 C5               push bc
  15+ 99E1              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99E1 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99E4              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99E4
  19+ 99E4 A7           6 and a                                 ; Carry a "0".
  20+ 99E5 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99E7 30 02            jr nc,1F
  22+ 99E9
  23+ 99E9 CB C1            set 0,c
  24+ 99EB
  25+ 99EB 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99EC E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99EE 5F               ld e,a
  28+ 99EF
  29+ 99EF 7A               ld a,d
  30+ 99F0 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99F2 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99F4
  33+ 99F4 CB 3F            srl a
  34+ 99F6
  35+ 99F6 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99F7
  37+ 99F7 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99F8 28 04            jr z,4F
  39+ 99FA
  40+ 99FA CB FF            set 7,a
  41+ 99FC 18 02            jr 5F
  42+ 99FE
  43+ 99FE CB BF        4 res 7,a
  44+ 9A00
  45+ 9A00 CB 21        5 sla c
  46+ 9A02 10 E0            djnz 6B
  47+ 9A04
  48+ 9A04 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9A05
  50+ 9A05 77               ld (hl),a
  51+ 9A06 23               inc hl
  52+ 9A07 C1               pop bc
  53+ 9A08 10 D4            djnz 3B
