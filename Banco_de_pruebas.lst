# file opened: RND_Derivando.asm
   1+ 9496              ; ******************************************************************************************************************************************************************************************
   2+ 9496              ;
   3+ 9496              ;   3/4/25
   4+ 9496              ;
   5+ 9496              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9496              ;   (XOR) bit a bit.
   7+ 9496              ;
   8+ 9496              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9496              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9496
  11+ 9496              Derivando_RND
  12+ 9496
  13+ 9496 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9498 C5               push bc
  15+ 9499              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9499 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 949C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 949C
  19+ 949C A7           6 and a                                 ; Carry a "0".
  20+ 949D CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 949F 30 02            jr nc,1F
  22+ 94A1
  23+ 94A1 CB C1            set 0,c
  24+ 94A3
  25+ 94A3 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 94A4 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 94A6 5F               ld e,a
  28+ 94A7
  29+ 94A7 7A               ld a,d
  30+ 94A8 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
