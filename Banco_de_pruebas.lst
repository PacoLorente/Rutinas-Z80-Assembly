 147  905F              ; 29/4/25
 148  905F              ;
 149  905F              ; Parámetros DRAW.
 150  905F              ;
 151  905F
 152  905F              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 153  905F
 154  905F 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 155  9060              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 156  9060              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 157  9060              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 158  9060
 159  9060 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 160  9061              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 161  9061 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 162  9062 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 163  9063
 164  9063 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 165  9064              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 166  9064              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 167  9064
 168  9064              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 169  9064              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 170  9064
 171  9064              ; Ejemplos:
 172  9064
 173  9064              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 174  9064              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 175  9064              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 176  9064              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 177  9064              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 178  9064
 179  9064 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 180  9065              ;															  _ que esta entidad haya colisionado con Amadeus.
 181  9065              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 182  9065
 183  9065 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 184  9067              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 185  9067
 186  9067 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 187  9069
 188  9069              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 189  9069
 190  9069 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 191  906B              ;															  _palabras que componen el "movimiento_masticado".
 192  906B
 193  906B              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 194  906B
 195  906B 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 196  906C              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 197  906C              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 198  906C              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 199  906C              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 200  906C
 201  906C 00           Attr db 0 													; Atributos de la entidad.
 202  906D
 203  906D              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 204  906D
 205  906D
 206  906D
 207  906D 00           Ctrl_2 db 0
 208  906E              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 209  906E              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 210  906E              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 211  906E              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 212  906E              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 213  906E              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 214  906E              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 215  906E              ;
 216  906E              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 217  906E              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 218  906E              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 219  906E              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 220  906E              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 221  906E              ;															BIT 4, ???
 222  906E              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 223  906E              ;															BIT 6, "1" Indica que hemos iniciado la "-Transicion_de_salida-" de Amadeus.
 224  906E
 225  906E
 226  906E 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 227  906F              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 228  906F              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 229  906F              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 230  906F              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 231  906F              ;
 232  906F              ; 															DESCRIPCIÖN:
 233  906F              ;
 234  906F              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 235  906F              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 236  906F              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 237  906F              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 238  906F              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 239  906F              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 240  906F              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 241  906F              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 242  906F              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 243  906F              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 244  906F              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 245  906F              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 246  906F              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 247  906F              ;
 248  906F              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 249  906F              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 250  906F              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
