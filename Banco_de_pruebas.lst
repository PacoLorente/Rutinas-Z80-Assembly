# file opened: RND_Derivando.asm
   1+ 9482              ; ******************************************************************************************************************************************************************************************
   2+ 9482              ;
   3+ 9482              ;   3/4/25
   4+ 9482              ;
   5+ 9482              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9482              ;   (XOR) bit a bit.
   7+ 9482              ;
   8+ 9482              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9482              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9482
  11+ 9482              Derivando_RND
  12+ 9482
  13+ 9482 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9484 C5               push bc
  15+ 9485              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9485 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9488              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9488
  19+ 9488 A7           6 and a                                 ; Carry a "0".
  20+ 9489 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 948B 30 02            jr nc,1F
  22+ 948D
  23+ 948D CB C1            set 0,c
  24+ 948F
  25+ 948F 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9490 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9492 5F               ld e,a
  28+ 9493
  29+ 9493 7A               ld a,d
  30+ 9494 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9496 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9498
  33+ 9498 CB 3F            srl a
  34+ 949A
  35+ 949A AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 949B
