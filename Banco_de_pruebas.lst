   5+ 9BCC              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9BCC              ;   (XOR) bit a bit.
   7+ 9BCC              ;
   8+ 9BCC              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9BCC              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9BCC
  11+ 9BCC              Derivando_RND
  12+ 9BCC
  13+ 9BCC ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9BCE C5               push bc
  15+ 9BCF              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9BCF 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9BD2              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9BD2
  19+ 9BD2 A7           6 and a                                 ; Carry a "0".
  20+ 9BD3 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9BD5 30 02            jr nc,1F
  22+ 9BD7
  23+ 9BD7 CB C1            set 0,c
  24+ 9BD9
  25+ 9BD9 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9BDA E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9BDC 5F               ld e,a
  28+ 9BDD
  29+ 9BDD 7A               ld a,d
  30+ 9BDE E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9BE0 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9BE2
  33+ 9BE2 CB 3F            srl a
  34+ 9BE4
  35+ 9BE4 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9BE5
  37+ 9BE5 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9BE6 28 04            jr z,4F
  39+ 9BE8
  40+ 9BE8 CB FF            set 7,a
  41+ 9BEA 18 02            jr 5F
  42+ 9BEC
  43+ 9BEC CB BF        4 res 7,a
  44+ 9BEE
  45+ 9BEE CB 21        5 sla c
  46+ 9BF0 10 E0            djnz 6B
  47+ 9BF2
  48+ 9BF2 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9BF3
  50+ 9BF3 77               ld (hl),a
  51+ 9BF4 23               inc hl
  52+ 9BF5 C1               pop bc
  53+ 9BF6 10 D4            djnz 3B
  54+ 9BF8
  55+ 9BF8 C9               ret
