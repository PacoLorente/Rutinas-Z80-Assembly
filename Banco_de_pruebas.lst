 747  9A1D              ; ------------------------------------
 748  9A1D              ;
 749  9A1D              ; 	3/7/26
 750  9A1D              ;
 751  9A1D              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
 752  9A1D              ;
 753  9A1D              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
 754  9A1D              ;
 755  9A1D              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
 756  9A1D              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
 757  9A1D              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
 758  9A1D              ;
 759  9A1D              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
 760  9A1D              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
 761  9A1D              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
 762  9A1D              ;				  _medida que transcurre el tiempo.
 763  9A1D              ;
 764  9A1D              ;	OUTPUT: Define (Clock_next_entity).
 765  9A1D
 766  9A1D              Define_Clock_next_entity:
 767  9A1D
 768  9A1D 21 B2 96     	ld hl,Max_time_to_appear_entities
 769  9A20 BE           	cp (hl)
 770  9A21
 771  9A21 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
 772  9A22
 773  9A22 38 03        	jr c,1F
 774  9A24
 775  9A24              ;	Por encima o igual que (Max_time_to_appear_entities).
 776  9A24
 777  9A24 4E           	ld c,(hl)
 778  9A25 18 06        	jr 2F
 779  9A27
 780  9A27              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
 781  9A27              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
 782  9A27
 783  9A27 23           1 inc hl
 784  9A28 23           	inc hl
 785  9A29
 786  9A29 BE           	cp (hl)
 787  9A2A
 788  9A2A 30 01        	jr nc,2F
 789  9A2C
 790  9A2C              ;	Por DEBAJO de (Min_time_to_appear_entities).
 791  9A2C
 792  9A2C 4E           	ld c,(hl)
 793  9A2D
 794  9A2D 3A 78 5C     2 ld a,(FRAMES)
 795  9A30 81           	add c
 796  9A31 32 94 96     	ld (Clock_next_entity),a
 797  9A34
 798  9A34 C9           	ret
