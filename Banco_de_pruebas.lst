 142+ C088              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 143+ C088
 144+ C088              ;   Necesito fabricar un msg. con la máxima puntuación.
