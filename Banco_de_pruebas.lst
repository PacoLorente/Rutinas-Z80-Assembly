  48+ 99D5              ; -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  49+ 99D5              ;
  50+ 99D5              ;   14/02/25
  51+ 99D5              ;
  52+ 99D5              ;	Calcula el cuadrante de pantalla donde se encuentra la entidad: (Cuad_objeto), "1", "2", "3" o "4".
  53+ 99D5              ;	Esta información es necesaria para poder calcular el (Puntero_de_impresion) de la entidad.
  54+ 99D5              ;
  55+ 99D5              ;	INPUT:  HL contiene (Posicion_actual).
  56+ 99D5              ;	OUTPUT: (Cuad_objeto) contiene "1", "2", "3" o "4" en función del cuadrante de pantalla en el que se encuentra la entidad.
  57+ 99D5              ;
  58+ 99D5              ;	MODIFY: A.
  59+ 99D5
  60+ 99D5
  61+ 99D5              Calcula_Cuad_objeto
  62+ 99D5
  63+ 99D5 CD D1 95     	call calcula_tercio
  64+ 99D8
  65+ 99D8              ;	Ahora tenemos "0", "1" o "2" en el acumulador en función del tercio de pantalla en el que nos encontremos.
  66+ 99D8
  67+ 99D8 28 12        	jr z,Primer_tercio
  68+ 99DA 3D           	dec a
  69+ 99DB 28 1C        	jr z,Segundo_tercio
  70+ 99DD
  71+ 99DD              Tercer_tercio
  72+ 99DD
