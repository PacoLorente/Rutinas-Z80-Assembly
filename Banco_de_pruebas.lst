  15+ A569              ;			 6 ..... AMARILLO
  16+ A569              ; 			 7 ..... BLANCO
  17+ A569              ;
  18+ A569              ;	INPUT: A contiene los atributos de pantalla.
  19+ A569              ;
  20+ A569              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A569
  22+ A569
  23+ A569 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A56C 11 01 40     	LD DE,$4001
  25+ A56F 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A572 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A574 ED B0        	LDIR
  28+ A576 01 FF 02     	LD BC,767
  29+ A579 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A57A ED B0        	LDIR
  31+ A57C
  32+ A57C AF           	xor a
  33+ A57D
  34+ A57D C9           	ret
  35+ A57E
