 378+ C30C              ;   Move_RIGHT_ASCII_CODE db "2"
 379+ C30C              ;   ds 5
 380+ C30C              ;   Move_FIRE_ASCII_CODE db "5"
 381+ C30C              ;   ds 5
 382+ C30C              ;   Move_SHIELD_ASCII_CODE db "SPACE"
 383+ C30C              ;   ds 1
 384+ C30C              ;
 385+ C30C              ;   Hemos creado una tabla de punteros con los .defw que contienen los datos necesarios para definir e imprimir_
 386+ C30C              ;   _ cada uno de los 4 controles.
