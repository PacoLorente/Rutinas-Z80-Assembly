   5+ 98B1              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 98B1              ;   (XOR) bit a bit.
   7+ 98B1              ;
   8+ 98B1              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 98B1              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 98B1
  11+ 98B1              Derivando_RND
  12+ 98B1
  13+ 98B1 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 98B3 C5               push bc
  15+ 98B4              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 98B4 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 98B7              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 98B7
  19+ 98B7 A7           6 and a                                 ; Carry a "0".
  20+ 98B8 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 98BA 30 02            jr nc,1F
  22+ 98BC
  23+ 98BC CB C1            set 0,c
  24+ 98BE
  25+ 98BE 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 98BF E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 98C1 5F               ld e,a
  28+ 98C2
  29+ 98C2 7A               ld a,d
  30+ 98C3 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 98C5 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 98C7
  33+ 98C7 CB 3F            srl a
  34+ 98C9
  35+ 98C9 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 98CA
  37+ 98CA 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 98CB 28 04            jr z,4F
  39+ 98CD
  40+ 98CD CB FF            set 7,a
  41+ 98CF 18 02            jr 5F
  42+ 98D1
  43+ 98D1 CB BF        4 res 7,a
  44+ 98D3
  45+ 98D3 CB 21        5 sla c
  46+ 98D5 10 E0            djnz 6B
  47+ 98D7
  48+ 98D7 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 98D8
  50+ 98D8 77               ld (hl),a
  51+ 98D9 23               inc hl
  52+ 98DA C1               pop bc
  53+ 98DB 10 D4            djnz 3B
  54+ 98DD
  55+ 98DD C9               ret
