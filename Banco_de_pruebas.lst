 590+ B54C
 591+ B54C 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B54D C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B54F 6F               ld l,a
 594+ B550 D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B551
 596+ B551 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B552 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B554 67               ld h,a
 599+ B555 C9               ret
