 614+ A867
 615+ A867 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ A868 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ A86A 6F               ld l,a
