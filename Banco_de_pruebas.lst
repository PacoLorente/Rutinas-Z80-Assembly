 575+ C3A6              ; -----------------------------------------------------------------------------------------------------------
 576+ C3A6              ;
 577+ C3A6              ;   17/10/26
 578+ C3A6              ;
 579+ C3A6              ;   Asigna un nuevo KEYCODE y sustituye al contenido en la variable MOVE_xxx, (al que apunta H)L.
 580+ C3A6              ;   Nueva tecla para la función de movimiento, (KEYBOARD) a la que apunta HL.
 581+ C3A6              ;
 582+ C3A6              ;   Move_LEFT db $24
 583+ C3A6              ;   Move_RIGHT db $1c
 584+ C3A6              ;   Move_FIRE db $04
 585+ C3A6              ;   Move_SHIELD db $20
 586+ C3A6              ;
 587+ C3A6              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 588+ C3A6              ;
 589+ C3A6              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3A6              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3A6              ;
 592+ C3A6              ;   Special keys:
 593+ C3A6              ;
 594+ C3A6              ;   Symbol_key defm "SYMB.",0
 595+ C3A6              ;   Space_key defm "SPACE",0
 596+ C3A6              ;   Enter_key defm "ENTER",0
 597+ C3A6              ;   Caps_key defm "CAPS.",0
 598+ C3A6              ;
 599+ C3A6              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 600+ C3A6              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 601+ C3A6              ;
 602+ C3A6              ;           (Numero_de_teclas_definidas) contiene el n° de teclas YA DEFINIDAS.
 603+ C3A6              ;
 604+ C3A6              ;   MODIFY: AF, HL, BC y DE.
 605+ C3A6              ;
 606+ C3A6              ;   OUTPUT: (A) = "0".
 607+ C3A6
 608+ C3A6              Define_key:
 609+ C3A6
 610+ C3A6 E5               push hl                                                 ; PUSH Puntero KEYCODE.
 611+ C3A7 D5               push de                                                 ; PUSH Puntero ASCII_CODE.
 612+ C3A8
 613+ C3A8 CD 66 A0     3 call ROM_Key_Scan ; v2. Ok.                               ; Scan keyboard.
 614+ C3AB
 615+ C3AB              ;   Tras ejecutar[ROM_Key_Scan], (E) contiene el KEYCODE de la tecla pulsada.
 616+ C3AB
 617+ C3AB 3A 5D 96         ld a,(Numero_de_teclas_definidas)                       ; N° de teclas ya definidas.
 618+ C3AE A7               and a
 619+ C3AF 28 0B            jr z,2F                                                 ; (Numero_de_teclas_definidas)="0" Indica que estamos definiendo Move_LEFT.
 620+ C3B1              ;                                                           ; (Numero_de_teclas_definidas) se incrementa en una unidad cada vez que se define una tecla:
 621+ C3B1              ;
 622+ C3B1              ;                                                           ; Ej.: Si estamos definiendo Move_RIGHT, (Numero_de_teclas_definidas)="1"
 623+ C3B1              ;                                                           ;      Si estamos definiendo Move_FIRE, (Numero_de_teclas_definidas)="2"
 624+ C3B1              ;                                                           ;      Si estamos definiendo Move_SHIELD, (Numero_de_teclas_definidas)="3"
 625+ C3B1
 626+ C3B1 47               ld b,a                                                  ; Así, (B) contiene el nº de teclas definidas -1.
 627+ C3B2
 628+ C3B2              ;   (Numero_de_teclas_definidas) contiene el n° de comparativas que realizaremos entre el nuevo KEYCODE definido y los anteriormente definidos.
 629+ C3B2              ;   Así evitaremos que se asigne una misma tecla para varias funciones distintas.
 630+ C3B2
 631+ C3B2 21 5E 96         ld hl,Move_LEFT                                         ; 1er KEYCODE a comparar.
 632+ C3B5
 633+ C3B5 7E           1 ld a,(hl)                                                 ; KEY_CODE de Move_LEFT en A.
 634+ C3B6 BB               cp e                                                    ; Comparo con el Key_code recién adquirido.
 635+ C3B7 28 EF            jr z,3B                                                 ; Esta tecla ya se definió anteriormente. Volvemos a escanear el teclado.
 636+ C3B9
 637+ C3B9 23               inc hl                                                  ; Next KEYCODE to compare.
 638+ C3BA
 639+ C3BA 10 F9            djnz 1B
 640+ C3BC
 641+ C3BC 7B           2 ld a,e                                                    ; KEY_code en A.
 642+ C3BD
 643+ C3BD D1               pop de                                                  ; POP Puntero ASCII_CODE.
 644+ C3BE E1               pop hl                                                  ; POP Puntero KEYCODE.
 645+ C3BF
 646+ C3BF 77               ld (hl),a                                               ; Key_code almacenado.
 647+ C3C0
 648+ C3C0              ;   Sonido, (BEEP) de la pulsación de las teclas, (cuando está autorizada). No se ejecuta [BEEP] si la tecla ya está definida.
