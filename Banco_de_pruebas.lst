1299  D18A              ;
1300  D18A              ; 	3/7/26
1301  D18A              ;
1302  D18A              ;	INPUTS: A contiene un nº aleatorio comprendido entre ($00 y $ff).
1303  D18A              ;
1304  D18A              ;			La rutina sumará este valor a (FRAMES) siendo este nuevo valor el tiempo que tardará en aparecer una nueva entidad, (Clock_next_entity).
1305  D18A              ;
1306  D18A              ;			Antes de sumar el valor de (A) a (FRAMES), la rutina "filtra" esa cantidad manteniéndola entre 2 valores:
1307  D18A              ;			(Max_time_to_appear_entities) ... Valor máximo de tiempo. (A) no podrá superar nunca este valor.
1308  D18A              ;			(Min_time_to_appear_entities) ... Valor mínimo. (A) no podrá tener un valor más bajo que este.
1309  D18A              ;
1310  D18A              ;			Nota: Se puede dar el caso de que (Max_time_to_appear_entities) y (Min_time_to_appear_entities) contengan el mismo valor debido a que_
1311  D18A              ;				  _la rutina [Decrementa_techo] irá decrementando el valor de (Max_time_to_appear_entities) un nº de unidades definido por:
1312  D18A              ;				  _(Decrease_top_time_entities) cada vez que eliminamos a una entidad. De esta manera iremos aumentando la dificultad del nivel a_
1313  D18A              ;				  _medida que transcurre el tiempo.
1314  D18A              ;
1315  D18A              ;	OUTPUT: Define (Clock_next_entity).
1316  D18A
1317  D18A              Define_Clock_next_entity:
1318  D18A
1319  D18A 21 F3 CC     	ld hl,Max_time_to_appear_entities
1320  D18D BE           	cp (hl)
1321  D18E
1322  D18E 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1323  D18F
1324  D18F 38 03        	jr c,1F
1325  D191
1326  D191              ;	Por encima o igual que (Max_time_to_appear_entities).
1327  D191
1328  D191 4E           	ld c,(hl)
1329  D192 18 06        	jr 2F
1330  D194
1331  D194              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1332  D194              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1333  D194
1334  D194 23           1 inc hl
1335  D195 23           	inc hl
1336  D196
1337  D196 BE           	cp (hl)
1338  D197
1339  D197 30 01        	jr nc,2F
1340  D199
1341  D199              ;	Por DEBAJO de (Min_time_to_appear_entities).
1342  D199
1343  D199 4E           	ld c,(hl)
1344  D19A
1345  D19A 3A 78 5C     2 ld a,(FRAMES)
1346  D19D 81           	add c
1347  D19E 32 D5 CC     	ld (Clock_next_entity),a
