   1+ A120              ; ******************************************************************************************************************************************************************************************
   2+ A120              ;
   3+ A120              ;   3/4/25
   4+ A120              ;
   5+ A120              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A120              ;   (XOR) bit a bit.
   7+ A120              ;
   8+ A120              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A120              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A120
  11+ A120              Derivando_RND
  12+ A120
  13+ A120 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A122 C5               push bc
  15+ A123              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A123 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A126              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A126
  19+ A126 A7           6 and a                                 ; Carry a "0".
  20+ A127 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A129 30 02            jr nc,1F
  22+ A12B
  23+ A12B CB C1            set 0,c
  24+ A12D
  25+ A12D 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A12E E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A130 5F               ld e,a
  28+ A131
  29+ A131 7A               ld a,d
  30+ A132 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A134 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A136
  33+ A136 CB 3F            srl a
  34+ A138
  35+ A138 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A139
  37+ A139 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A13A 28 04            jr z,4F
  39+ A13C
  40+ A13C CB FF            set 7,a
  41+ A13E 18 02            jr 5F
  42+ A140
  43+ A140 CB BF        4 res 7,a
  44+ A142
  45+ A142 CB 21        5 sla c
  46+ A144 10 E0            djnz 6B
  47+ A146
  48+ A146 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A147
  50+ A147 77               ld (hl),a
  51+ A148 23               inc hl
  52+ A149 C1               pop bc
  53+ A14A 10 D4            djnz 3B
  54+ A14C
  55+ A14C C9               ret
  56+ A14D
  57+ A14D
  58+ A14D
