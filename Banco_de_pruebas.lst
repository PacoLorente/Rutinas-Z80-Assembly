 383+ A2C3
 384+ A2C3              ;	Preparamos el puntero_master para que apunte al .defw correspondiente del índice según el (Tipo) de entidad.
 385+ A2C3
 386+ A2C3 79           	ld a,c
 387+ A2C4 08           	ex af,af
