 564+ AE02              ;
 565+ AE02              ;   NextScan.
 566+ AE02              ;
 567+ AE02              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ AE02              ;
 569+ AE02              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ AE02              ;
 571+ AE02              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ AE02              ;
 573+ AE02              ;       DESTRUIDOS: AF y HL !!!
 574+ AE02              ;
 575+ AE02              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ AE02              ;
 577+ AE02
 578+ AE02 24           NextScan inc h          							; Incrementamos el scanline.
 579+ AE03 7C               ld a,h
 580+ AE04 E6 07            and 7
 581+ AE06 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ AE07
 583+ AE07 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ AE08 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ AE0A 6F               ld l,a
 586+ AE0B D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ AE0C
 588+ AE0C 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ AE0D D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ AE0F 67               ld h,a
 591+ AE10 C9               ret
