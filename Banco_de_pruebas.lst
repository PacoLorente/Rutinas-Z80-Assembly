3262  A03A              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A03A              ; ******************************************************************************************************************************************************************************************
   2+ A03A              ;
   3+ A03A              ;   3/4/25
   4+ A03A              ;
   5+ A03A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A03A              ;   (XOR) bit a bit.
   7+ A03A              ;
   8+ A03A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A03A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A03A
  11+ A03A              Derivando_RND
  12+ A03A
  13+ A03A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A03C C5               push bc
  15+ A03D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A03D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A040              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A040
  19+ A040 A7           6 and a                                 ; Carry a "0".
  20+ A041 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A043 30 02            jr nc,1F
  22+ A045
  23+ A045 CB C1            set 0,c
  24+ A047
  25+ A047 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A048 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A04A 5F               ld e,a
  28+ A04B
  29+ A04B 7A               ld a,d
  30+ A04C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A04E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A050
  33+ A050 CB 3F            srl a
  34+ A052
  35+ A052 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A053
  37+ A053 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A054 28 04            jr z,4F
  39+ A056
  40+ A056 CB FF            set 7,a
  41+ A058 18 02            jr 5F
  42+ A05A
  43+ A05A CB BF        4 res 7,a
  44+ A05C
  45+ A05C CB 21        5 sla c
  46+ A05E 10 E0            djnz 6B
  47+ A060
  48+ A060 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A061
  50+ A061 77               ld (hl),a
  51+ A062 23               inc hl
  52+ A063 C1               pop bc
  53+ A064 10 D4            djnz 3B
  54+ A066
  55+ A066 C9               ret
  56+ A067
  57+ A067
  58+ A067
# file closed: RND_Derivando.asm
