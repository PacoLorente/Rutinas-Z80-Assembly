 814+ B5CA
 815+ B5CA 06 0F        	ld b,15
 816+ B5CC CD BB B5     1 call NextScan
 817+ B5CF 10 FB        	djnz 1B
 818+ B5D1
 819+ B5D1 C9           	ret
 820+ B5D2
 821+ B5D2              ;----------------------------------------------------------------------------------------------------------------
 822+ B5D2              ;
 823+ B5D2              ;	5/08/22
 824+ B5D2              ;
 825+ B5D2              ;   PreviousScan.
 826+ B5D2              ;
 827+ B5D2              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B5D2              ;
 829+ B5D2              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B5D2              ;
 831+ B5D2              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B5D2              ;
 833+ B5D2              ;       DESTRUIDOS: AF y HL !!!
 834+ B5D2              ;
 835+ B5D2              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B5D2              ;
 837+ B5D2
 838+ B5D2              PreviousScan:
 839+ B5D2
 840+ B5D2 7C           	ld a,h
 841+ B5D3 25               dec h               							; Dec H.
 842+ B5D4 E6 07            and 7
 843+ B5D6 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B5D7
 845+ B5D7 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B5D8 D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B5DA 6F               ld l,a
 848+ B5DB D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B5DC
 850+ B5DC 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B5DD C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B5DF 67               ld h,a
 853+ B5E0 C9               ret
