# file opened: RND_Derivando.asm
   1+ A03D              ; ******************************************************************************************************************************************************************************************
   2+ A03D              ;
   3+ A03D              ;   3/4/25
   4+ A03D              ;
   5+ A03D              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A03D              ;   (XOR) bit a bit.
   7+ A03D              ;
   8+ A03D              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A03D              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A03D
  11+ A03D              Derivando_RND
  12+ A03D
  13+ A03D ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A03F C5               push bc
  15+ A040              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A040 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A043              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A043
  19+ A043 A7           6 and a                                 ; Carry a "0".
  20+ A044 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A046 30 02            jr nc,1F
  22+ A048
  23+ A048 CB C1            set 0,c
  24+ A04A
  25+ A04A 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A04B E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A04D 5F               ld e,a
  28+ A04E
  29+ A04E 7A               ld a,d
  30+ A04F E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A051 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A053
  33+ A053 CB 3F            srl a
  34+ A055
  35+ A055 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A056
  37+ A056 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A057 28 04            jr z,4F
  39+ A059
  40+ A059 CB FF            set 7,a
  41+ A05B 18 02            jr 5F
  42+ A05D
  43+ A05D CB BF        4 res 7,a
  44+ A05F
  45+ A05F CB 21        5 sla c
  46+ A061 10 E0            djnz 6B
  47+ A063
  48+ A063 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A064
  50+ A064 77               ld (hl),a
  51+ A065 23               inc hl
  52+ A066 C1               pop bc
  53+ A067 10 D4            djnz 3B
  54+ A069
  55+ A069 C9               ret
  56+ A06A
  57+ A06A
  58+ A06A
# file closed: RND_Derivando.asm
