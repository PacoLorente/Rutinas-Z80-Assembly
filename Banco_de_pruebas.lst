   1+ 9481              ; ******************************************************************************************************************************************************************************************
   2+ 9481              ;
   3+ 9481              ;   3/4/25
   4+ 9481              ;
   5+ 9481              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9481              ;   (XOR) bit a bit.
   7+ 9481              ;
   8+ 9481              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9481              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9481
  11+ 9481              Derivando_RND
  12+ 9481
  13+ 9481 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9483 C5               push bc
  15+ 9484              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9484 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9487              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9487
  19+ 9487 A7           6 and a                                 ; Carry a "0".
  20+ 9488 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 948A 30 02            jr nc,1F
  22+ 948C
  23+ 948C CB C1            set 0,c
  24+ 948E
  25+ 948E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 948F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9491 5F               ld e,a
  28+ 9492
  29+ 9492 7A               ld a,d
  30+ 9493 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9495 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9497
  33+ 9497 CB 3F            srl a
  34+ 9499
  35+ 9499 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 949A
  37+ 949A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 949B 28 04            jr z,4F
  39+ 949D
  40+ 949D CB FF            set 7,a
  41+ 949F 18 02            jr 5F
  42+ 94A1
  43+ 94A1 CB BF        4 res 7,a
  44+ 94A3
