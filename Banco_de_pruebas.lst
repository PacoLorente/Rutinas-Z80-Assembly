 253  932A              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 932A
   2+ 932A
   3+ 932A              ;   07/07/23
   4+ 932A              ;
   5+ 932A              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 932A              ;
   7+ 932A              ;   Codificación:
   8+ 932A              ;
   9+ 932A              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 932A              ;
  11+ 932A              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 932A              ;
  13+ 932A              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 932A              ;
  15+ 932A              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 932A              ;
  17+ 932A              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 932A              ;                               ..... %01000010 Vel_up 4
  19+ 932A              ;                                               Vel_down 2
  20+ 932A              ;                               ..... $42
  21+ 932A              ;
  22+ 932A              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 932A              ;
  24+ 932A              ;                               ..... %01000010 Vel_left 4
  25+ 932A              ;                                               Vel_right 2
  26+ 932A              ;                               ..... $42
  27+ 932A              ;
  28+ 932A              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 932A              ;
  30+ 932A              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 932A              ;
  32+ 932A              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 932A              ;
  34+ 932A              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 932A              ;                                     $53
  36+ 932A              ;
  37+ 932A              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 932A              ;
  39+ 932A              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 932A              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 932A              ;
  42+ 932A              ;                       Arriba ..... $81
  43+ 932A              ;                       Arriba - izquierda ..... $a1
  44+ 932A              ;                       Arriba - derecha ..... $91
  45+ 932A              ;
  46+ 932A              ;                       Abajo ..... $41
  47+ 932A              ;                       Abajo - izquierda ..... $61
  48+ 932A              ;                       Abajo - derecha ..... $51
  49+ 932A              ;
  50+ 932A              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 932A              ;
  52+ 932A              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 932A              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 932A              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 932A              ;
  56+ 932A              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 932A              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 932A              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 932A              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 932A              ;
  61+ 932A              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 932A              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 932A              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 932A              ;
  65+ 932A              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 932A              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 932A              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 932A              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 932A
  70+ 932A              ; ----- ----- ----- ----- -----
  71+ 932A              ;
  72+ 932A              ;   Factor RANDOM --- BadSat.
  73+ 932A
