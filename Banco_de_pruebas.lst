 650  9435 00           Cola_de_desplazamiento db 0									; Este byte indica:
 651  9436
 652  9436              ;
 653  9436              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 654  9436              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 655  9436              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 656  9436              ;
 657  9436              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 658  9436              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 659  9436              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 660  9436              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 661  9436              ;
 662  9436              ;															;	"$ff" ..... Bucle infinito de repetición.
 663  9436              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 664  9436              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 665  9436
