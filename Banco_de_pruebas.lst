   5+ 9911              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9911              ;   (XOR) bit a bit.
   7+ 9911              ;
   8+ 9911              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9911              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9911
  11+ 9911              Derivando_RND
  12+ 9911
  13+ 9911 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9913 C5               push bc
  15+ 9914              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9914 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9917              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9917
  19+ 9917 A7           6 and a                                 ; Carry a "0".
  20+ 9918 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 991A 30 02            jr nc,1F
  22+ 991C
  23+ 991C CB C1            set 0,c
  24+ 991E
  25+ 991E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 991F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9921 5F               ld e,a
  28+ 9922
  29+ 9922 7A               ld a,d
  30+ 9923 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9925 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9927
  33+ 9927 CB 3F            srl a
  34+ 9929
  35+ 9929 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 992A
  37+ 992A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 992B 28 04            jr z,4F
  39+ 992D
  40+ 992D CB FF            set 7,a
  41+ 992F 18 02            jr 5F
  42+ 9931
  43+ 9931 CB BF        4 res 7,a
  44+ 9933
  45+ 9933 CB 21        5 sla c
  46+ 9935 10 E0            djnz 6B
  47+ 9937
  48+ 9937 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9938
  50+ 9938 77               ld (hl),a
  51+ 9939 23               inc hl
  52+ 993A C1               pop bc
  53+ 993B 10 D4            djnz 3B
