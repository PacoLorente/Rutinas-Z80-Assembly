 300  8C1A              ; Movimiento. ------------------------------------------------------------------------------------------------------
 301  8C1A
 302  8C1A 00 00        Puntero_indice_mov defw 0							    ; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 303  8C1C 00 00        Puntero_mov defw 0										; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 304  8C1E 00 00        Puntero_indice_mov_bucle defw 0							;
 305  8C20              ;
 306  8C20              ;
 307  8C20 00           Incrementa_puntero db 0									; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 308  8C21              ;														; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 309  8C21              ;														; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 310  8C21 00           Incrementa_puntero_backup db 0
 311  8C22 00           Repetimos_desplazamiento db 0							; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 312  8C23              ;														; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 313  8C23 00           Repetimos_desplazamiento_backup db 0					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 314  8C24 00           Repetimos_movimiento db 0								; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 315  8C25 00           Cola_de_desplazamiento db 0								; Este byte indica:
 316  8C26              ;
 317  8C26              ;														;	"$00" ..... Hemos finalizado la cadena de movimiento.
 318  8C26              ;														;				En este caso hemos de incrementar (Puntero_indice_mov)_
 319  8C26              ;														;				_ y pasar a la siguiente cadena de movimiento del índice.
 320  8C26              ;
 321  8C26              ;														;	"$01 - "$fe" ..... Repetición del movimiento.
 322  8C26              ;														;						Nº de veces que vamos a repetir el movimiento completo.
 323  8C26              ;														;						En este caso, volveremos a inicializar (Puntero_mov),_
 324  8C26              ;														;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 325  8C26              ;
 326  8C26              ;														;	"$ff" ..... Bucle infinito de repetición.
 327  8C26              ;														;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 328  8C26              ;														;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 329  8C26
 330  8C26 00           Ctrl_1 db 0 											; Byte de control de propósito general.
 331  8C27
 332  8C27              ;														DESCRIPCIÓN:
 333  8C27              ;
 334  8C27              ;														BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 335  8C27              ;															_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 336  8C27              ;															_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 337  8C27              ;														BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 338  8C27              ;														BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 339  8C27              ;															_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 340  8C27
 341  8C27              ;														BIT 3, Recarga de nueva oleada.
 342  8C27              ;														BIT 4, Recarga de nueva oleada.
 343  8C27              ;														BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 344  8C27              ;														BIT 6, **** Frame completo.
 345  8C27              ;														BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 346  8C27
 347  8C27 00 00        Repone_puntero_objeto defw 0							; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 348  8C29              ; 														; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 349  8C29              ; 														; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 350  8C29              ;														; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
 351  8C29
 352  8C29              ; Gestión de ENTIDADES y CAJAS.
 353  8C29
