 779+ B60F              ;----------------------------------------------------------------------------------------------------------------
 780+ B60F              ;
 781+ B60F              ;	5/08/22
 782+ B60F              ;
 783+ B60F              ;   NextScan.
 784+ B60F              ;
 785+ B60F              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B60F              ;
 787+ B60F              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B60F              ;
 789+ B60F              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B60F              ;
 791+ B60F              ;       DESTRUIDOS: AF y HL !!!
 792+ B60F              ;
 793+ B60F              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B60F              ;
 795+ B60F
 796+ B60F              NextScan:
 797+ B60F
 798+ B60F 24           	inc h          							; Incrementamos el scanline.
 799+ B610 7C               ld a,h
 800+ B611 E6 07            and 7
 801+ B613 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B614
 803+ B614 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B615 C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B617 6F               ld l,a
 806+ B618 D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B619
 808+ B619 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B61A D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B61C 67               ld h,a
 811+ B61D C9               ret
 812+ B61E
 813+ B61E              NextScan_15:
 814+ B61E
 815+ B61E 06 0F        	ld b,15
 816+ B620 CD 0F B6     1 call NextScan
 817+ B623 10 FB        	djnz 1B
 818+ B625
 819+ B625 C9           	ret
 820+ B626
 821+ B626              ;----------------------------------------------------------------------------------------------------------------
 822+ B626              ;
 823+ B626              ;	5/08/22
 824+ B626              ;
 825+ B626              ;   PreviousScan.
 826+ B626              ;
 827+ B626              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B626              ;
 829+ B626              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B626              ;
 831+ B626              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B626              ;
 833+ B626              ;       DESTRUIDOS: AF y HL !!!
 834+ B626              ;
 835+ B626              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B626              ;
 837+ B626
 838+ B626              PreviousScan:
 839+ B626
 840+ B626 7C           	ld a,h
 841+ B627 25               dec h               							; Dec H.
 842+ B628 E6 07            and 7
 843+ B62A C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B62B
 845+ B62B 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B62C D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B62E 6F               ld l,a
 848+ B62F D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B630
 850+ B630 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B631 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B633 67               ld h,a
 853+ B634 C9               ret
 854+ B635
 855+ B635              PreviousScan_15:
 856+ B635
 857+ B635 06 0F        	ld b,15
 858+ B637 CD 26 B6     1 call PreviousScan
 859+ B63A 10 FB        	djnz 1B
 860+ B63C
 861+ B63C C9           	ret
