 424  949C              ;															  _palabras que componen el "movimiento_masticado".
 425  949C
 426  949C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 427  949C
 428  949C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 429  949D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 430  949D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 431  949D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 432  949D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
