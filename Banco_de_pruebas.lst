 779+ B606              ;----------------------------------------------------------------------------------------------------------------
 780+ B606              ;
 781+ B606              ;	5/08/22
 782+ B606              ;
 783+ B606              ;   NextScan.
 784+ B606              ;
 785+ B606              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B606              ;
 787+ B606              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B606              ;
 789+ B606              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B606              ;
 791+ B606              ;       DESTRUIDOS: AF y HL !!!
 792+ B606              ;
 793+ B606              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B606              ;
 795+ B606
 796+ B606              NextScan:
 797+ B606
 798+ B606 24           	inc h          							; Incrementamos el scanline.
 799+ B607 7C               ld a,h
 800+ B608 E6 07            and 7
 801+ B60A C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B60B
 803+ B60B 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B60C C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B60E 6F               ld l,a
 806+ B60F D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B610
 808+ B610 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B611 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B613 67               ld h,a
 811+ B614 C9               ret
 812+ B615
 813+ B615              NextScan_15:
 814+ B615
 815+ B615 06 0F        	ld b,15
 816+ B617 CD 06 B6     1 call NextScan
 817+ B61A 10 FB        	djnz 1B
 818+ B61C
 819+ B61C C9           	ret
 820+ B61D
 821+ B61D              ;----------------------------------------------------------------------------------------------------------------
 822+ B61D              ;
 823+ B61D              ;	5/08/22
 824+ B61D              ;
 825+ B61D              ;   PreviousScan.
 826+ B61D              ;
 827+ B61D              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B61D              ;
 829+ B61D              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B61D              ;
 831+ B61D              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B61D              ;
 833+ B61D              ;       DESTRUIDOS: AF y HL !!!
 834+ B61D              ;
 835+ B61D              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B61D              ;
 837+ B61D
 838+ B61D              PreviousScan:
 839+ B61D
 840+ B61D 7C           	ld a,h
 841+ B61E 25               dec h               							; Dec H.
 842+ B61F E6 07            and 7
 843+ B621 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B622
 845+ B622 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B623 D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B625 6F               ld l,a
 848+ B626 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B627
 850+ B627 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B628 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B62A 67               ld h,a
 853+ B62B C9               ret
 854+ B62C
 855+ B62C              PreviousScan_15:
