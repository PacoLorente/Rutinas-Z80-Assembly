# file opened: RND_Derivando.asm
   1+ 9479              ; ******************************************************************************************************************************************************************************************
   2+ 9479              ;
   3+ 9479              ;   21/04/24
   4+ 9479              ;
   5+ 9479              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9479              ;   (XOR) bit a bit.
   7+ 9479              ;
   8+ 9479              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9479
  10+ 9479              Derivando_RND
  11+ 9479
  12+ 9479 21 F6 88         ld hl,Numeros_aleatorios
  13+ 947C
  14+ 947C ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 947E C5               push bc
  16+ 947F              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 947F 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9482              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9482
  20+ 9482 A7           6 and a                                 ; Carry a "0".
  21+ 9483 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9485 30 02            jr nc,1F
  23+ 9487
  24+ 9487 CB C1            set 0,c
  25+ 9489
  26+ 9489 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 948A E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 948C 5F               ld e,a
  29+ 948D
