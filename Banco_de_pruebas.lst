   4+ 9E12              ;
   5+ 9E12              ;   Construyo un nº pseudo aleatorio. Método "DERIVANDO":
   6+ 9E12              ;
   7+ 9E12              ;   Inicialmente nuestra semilla será la contenida en el registro R. A partir de ahí irá mutando y la almacenaremos en la variable: (Semilla).
   8+ 9E12              ;
   9+ 9E12              ;   Para construir nuestro n° pseudo aleatorio necesitamos 8 bits que iremos adquiriendo del último bit, (bit_0) de la semilla.
  10+ 9E12              ;
  11+ 9E12              ;   Después de adquirir el bit de la semilla, desplazamos a la derecha los bits de la misma y realizamos una función lógica XOR entre los_
  12+ 9E12              ;   _ bits 0 y 1, (los dos últimos).
  13+ 9E12              ;
  14+ 9E12              ;   Si el resultado de la operación XOR es "1" pondremos a "1" el bit_7 de la semilla. Si es "0" no realizamos cambios.
  15+ 9E12              ;
  16+ 9E12              ;   Desplazamos los bits del número que estamos generando una posición a la izquierda con el fin de adquirir un nuevo bit de la semilla.
  17+ 9E12              ;
  18+ 9E12              ;   Repetimos proceso hasta que hayamos adquirido los 8 bits necesarios de la semilla.
  19+ 9E12              ;
  20+ 9E12              ;   Guardamos la semilla en la variable (Semilla) y el número generado en (HL).
  21+ 9E12              ;
  22+ 9E12              ;   Incrementamos el puntero HL para situarlo en la siguiente dirección de memoria, (donde almacenaremos el siguiente n° pseudo aleatorio a generar).
  23+ 9E12              ;
  24+ 9E12              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
  25+ 9E12              ;          HL contendrá la dirección de mem. donde vamos a almacenar el 1er n° de los (B) números pseudo aleatorios a generar.
  26+ 9E12              ;
  27+ 9E12              ;   MODIFY: (Semilla), AF, HL, DE y B.
  28+ 9E12
  29+ 9E12              Derivando_RND:
  30+ 9E12
  31+ 9E12              ;   En 1er lugar comprobamos si disponemos de semilla.
  32+ 9E12
  33+ 9E12 3A 39 96         ld a,(Semilla)
  34+ 9E15
  35+ 9E15 A7               and a
  36+ 9E16
  37+ 9E16 20 02            jr nz,Semilla_iniciada
  38+ 9E18
  39+ 9E18              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  40+ 9E18 ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  41+ 9E1A
  42+ 9E1A              Semilla_iniciada:
  43+ 9E1A
  44+ 9E1A 57               ld d,a                              ; A partir de ahora, (D) contendrá nuestra semilla.
  45+ 9E1B
  46+ 9E1B C5               push bc                             ; PUSH N° de números que queremos generar.
  47+ 9E1C
  48+ 9E1C 01 00 08         ld bc,$0800                         ; C contendrá nuestro nº aleatorio: ($0 - $ff). Inicialmente está a "0".
  49+ 9E1F              ;                                       ; B actuará como contador de bits, (números de bits a generar), 8 bits.
  50+ 9E1F
  51+ 9E1F CB 21        3 sla c                                 ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  52+ 9E21
  53+ 9E21 7A               ld a,d
  54+ 9E22
  55+ 9E22              ;   El último bit de la semilla, (bit_0) será el 1° del número pseudo aleatorio generado, (bit_7).
  56+ 9E22
  57+ 9E22 E6 01            and %00000001
  58+ 9E24
  59+ 9E24 28 02            jr z,4F
  60+ 9E26
  61+ 9E26 CB C1            set 0,c                             ; One bit generated.
  62+ 9E28
  63+ 9E28              ;   Rotamos los bits de la semilla una posición a la derecha.
  64+ 9E28
  65+ 9E28 CB 1A        4  rr d                                 ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  66+ 9E2A
  67+ 9E2A 7A               ld a,d
  68+ 9E2B
  69+ 9E2B              Xor_bit_1_bit_2:
  70+ 9E2B
  71+ 9E2B E6 01            and %00000001                       ; Bit_0 en (E).
  72+ 9E2D 5F               ld e,a
  73+ 9E2E
  74+ 9E2E 7A               ld a,d
  75+ 9E2F E6 02            and %00000010                       ; Bit_1 en (A).
  76+ 9E31
  77+ 9E31 28 02            jr z,1F
  78+ 9E33
  79+ 9E33 3E 01            ld a,1
  80+ 9E35
  81+ 9E35 AB           1 xor e
  82+ 9E36
  83+ 9E36              ;   FUNCIÓN XOR entre el bit_0 y el bit_1 de la semilla después de una rotación de 1 bit a la derecha.
  84+ 9E36
  85+ 9E36              ;   0 0 ..... 0
  86+ 9E36              ;   0 1 ..... 1
  87+ 9E36              ;   1 0 ..... 1
  88+ 9E36              ;   1 1 ..... 0
  89+ 9E36
  90+ 9E36 28 02            jr z,2F
  91+ 9E38
  92+ 9E38 CB FA            set 7,d                             ; Cuando la función XOR entre los dos últimos bits de la semilla resulta "1",_
  93+ 9E3A              ;                                       ; _ seteamos a "1" el bit_7 de la misma.
  94+ 9E3A
  95+ 9E3A 10 E3        2 djnz 3B
  96+ 9E3C
  97+ 9E3C              Number_generated:
  98+ 9E3C
  99+ 9E3C 7A               ld a,d
