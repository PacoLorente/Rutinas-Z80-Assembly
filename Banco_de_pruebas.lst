 171  9162              ;
 172  9162              ; Parámetros DRAW.
 173  9162              ;
 174  9162
 175  9162              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 176  9162
 177  9162 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 178  9163              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 179  9163              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 180  9163              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 181  9163
 182  9163 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 183  9164              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 184  9164 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 185  9165 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 186  9166
 187  9166 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 188  9167              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 189  9167              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 190  9167
 191  9167              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 192  9167              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 193  9167
 194  9167              ; Ejemplos:
 195  9167
 196  9167              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 197  9167              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 198  9167              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 199  9167              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 200  9167              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 201  9167
 202  9167 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 203  9168              ;															  _ que esta entidad haya colisionado con Amadeus.
 204  9168              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 205  9168
 206  9168 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 207  916A              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 208  916A
 209  916A 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 210  916C
 211  916C              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 212  916C
 213  916C 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 214  916E              ;															  _palabras que componen el "movimiento_masticado".
 215  916E
 216  916E              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 217  916E
 218  916E 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 219  916F              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 220  916F              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 221  916F              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 222  916F              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 223  916F
 224  916F 00           Attr db 0 													; Atributos de la entidad.
 225  9170
 226  9170              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 227  9170
 228  9170
 229  9170
 230  9170 00           Ctrl_2 db 0
 231  9171              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 232  9171              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 233  9171              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 234  9171              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 235  9171              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 236  9171              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 237  9171              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 238  9171              ;
 239  9171              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 240  9171              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 241  9171              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 242  9171              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 243  9171              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 244  9171              ;															BIT 4, ???
 245  9171              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 246  9171              ;															BIT 6, "1" Indica que hemos iniciado la "-Transicion_de_salida-" de Amadeus.
 247  9171              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 248  9171              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 249  9171
 250  9171 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 251  9172              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 252  9172              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 253  9172              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 254  9172              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 255  9172              ;
 256  9172              ; 															DESCRIPCIÖN:
 257  9172              ;
 258  9172              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 259  9172              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 260  9172              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 261  9172              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 262  9172              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 263  9172              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 264  9172              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 265  9172              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 266  9172              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 267  9172              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 268  9172              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 269  9172              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 270  9172              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 271  9172              ;
 272  9172              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 273  9172              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 274  9172              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 275  9172
