   5+ 9D9B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D9B              ;   (XOR) bit a bit.
   7+ 9D9B              ;
   8+ 9D9B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D9B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D9B
  11+ 9D9B              Derivando_RND
  12+ 9D9B
  13+ 9D9B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D9D C5               push bc
  15+ 9D9E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D9E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9DA1              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9DA1
  19+ 9DA1 A7           6 and a                                 ; Carry a "0".
  20+ 9DA2 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9DA4 30 02            jr nc,1F
  22+ 9DA6
  23+ 9DA6 CB C1            set 0,c
  24+ 9DA8
  25+ 9DA8 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9DA9 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9DAB 5F               ld e,a
  28+ 9DAC
  29+ 9DAC 7A               ld a,d
  30+ 9DAD E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9DAF 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9DB1
  33+ 9DB1 CB 3F            srl a
  34+ 9DB3
  35+ 9DB3 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9DB4
  37+ 9DB4 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9DB5 28 04            jr z,4F
  39+ 9DB7
  40+ 9DB7 CB FF            set 7,a
  41+ 9DB9 18 02            jr 5F
  42+ 9DBB
  43+ 9DBB CB BF        4 res 7,a
  44+ 9DBD
  45+ 9DBD CB 21        5 sla c
  46+ 9DBF 10 E0            djnz 6B
  47+ 9DC1
  48+ 9DC1 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9DC2
  50+ 9DC2 77               ld (hl),a
  51+ 9DC3 23               inc hl
  52+ 9DC4 C1               pop bc
  53+ 9DC5 10 D4            djnz 3B
  54+ 9DC7
  55+ 9DC7 C9               ret
  56+ 9DC8
  57+ 9DC8
  58+ 9DC8
