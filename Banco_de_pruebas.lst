 620+ A1B8 7C               ld a,h              ; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ A1B9 C6 08            add a,8             ; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ A1BB 67               ld h,a
 623+ A1BC C9               ret
