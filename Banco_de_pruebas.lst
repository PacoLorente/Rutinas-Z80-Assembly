3249  A034              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A034              ; ******************************************************************************************************************************************************************************************
   2+ A034              ;
   3+ A034              ;   3/4/25
   4+ A034              ;
   5+ A034              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A034              ;   (XOR) bit a bit.
   7+ A034              ;
   8+ A034              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A034              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A034
  11+ A034              Derivando_RND
  12+ A034
  13+ A034 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A036 C5               push bc
  15+ A037              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A037 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A03A              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A03A
  19+ A03A A7           6 and a                                 ; Carry a "0".
  20+ A03B CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A03D 30 02            jr nc,1F
  22+ A03F
  23+ A03F CB C1            set 0,c
  24+ A041
  25+ A041 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A042 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A044 5F               ld e,a
  28+ A045
  29+ A045 7A               ld a,d
  30+ A046 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A048 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A04A
  33+ A04A CB 3F            srl a
  34+ A04C
  35+ A04C AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A04D
  37+ A04D 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A04E 28 04            jr z,4F
  39+ A050
  40+ A050 CB FF            set 7,a
  41+ A052 18 02            jr 5F
  42+ A054
  43+ A054 CB BF        4 res 7,a
  44+ A056
  45+ A056 CB 21        5 sla c
  46+ A058 10 E0            djnz 6B
  47+ A05A
  48+ A05A 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A05B
  50+ A05B 77               ld (hl),a
  51+ A05C 23               inc hl
  52+ A05D C1               pop bc
  53+ A05E 10 D4            djnz 3B
  54+ A060
  55+ A060 C9               ret
  56+ A061
  57+ A061
  58+ A061
# file closed: RND_Derivando.asm
