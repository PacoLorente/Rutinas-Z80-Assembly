 364  94B8              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 365  94B8 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 366  94B9 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 367  94BA
 368  94BA 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 369  94BB              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 370  94BB              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 371  94BB
 372  94BB              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 373  94BB              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 374  94BB
 375  94BB              ; Ejemplos:
 376  94BB
 377  94BB              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 378  94BB              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 379  94BB              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 380  94BB              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 381  94BB              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 382  94BB
