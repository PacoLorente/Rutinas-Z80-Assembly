# file opened: RND_Derivando.asm
   1+ 9741              ; ******************************************************************************************************************************************************************************************
   2+ 9741              ;
   3+ 9741              ;   3/4/25
   4+ 9741              ;
   5+ 9741              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9741              ;   (XOR) bit a bit.
   7+ 9741              ;
   8+ 9741              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9741              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9741
  11+ 9741              Derivando_RND
  12+ 9741
  13+ 9741 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9743 C5               push bc
  15+ 9744              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9744 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9747              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9747
  19+ 9747 A7           6 and a                                 ; Carry a "0".
  20+ 9748 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 974A 30 02            jr nc,1F
  22+ 974C
  23+ 974C CB C1            set 0,c
  24+ 974E
  25+ 974E 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 974F E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9751 5F               ld e,a
  28+ 9752
  29+ 9752 7A               ld a,d
  30+ 9753 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9755 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9757
  33+ 9757 CB 3F            srl a
  34+ 9759
  35+ 9759 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 975A
  37+ 975A 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 975B 28 04            jr z,4F
  39+ 975D
  40+ 975D CB FF            set 7,a
  41+ 975F 18 02            jr 5F
