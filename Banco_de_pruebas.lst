 143+ C037 20 03            jr nz,3F
 144+ C039
 145+ C039 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 146+ C03A 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 147+ C03C
 148+ C03C D5           3 push de                                    ; PUSH Score_max_msg.
 149+ C03D
 150+ C03D 11 E8 94         ld de,Non_authorized_KEY_CODES+2         ; KEY_CODE numbers list.
 151+ C040
 152+ C040 A7               and a
 153+ C041 28 04            jr z,4F
 154+ C043
 155+ C043 13           2 inc de
 156+ C044 3D               dec a
 157+ C045 20 FC            jr nz,2B                                 ; Nos situamos en el KEY_CODE correspondiente a este dígito.
 158+ C047
 159+ C047 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 160+ C048
 161+ C048 D1               pop de                                   ; Score_max_msg en DE.
 162+ C049
 163+ C049 CD 52 C0         call ASCII_CODE_de_KEYCODE
 164+ C04C
