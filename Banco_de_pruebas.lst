 322  961A              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 323  961A              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 324  961A              ;																							 8 - 2 (4ª vuelta - velocidad 2)
