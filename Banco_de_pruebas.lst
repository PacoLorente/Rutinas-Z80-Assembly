 567+ B1A8              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ B1A8              ;
 569+ B1A8              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ B1A8              ;
 571+ B1A8              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ B1A8              ;
 573+ B1A8              ;       DESTRUIDOS: AF y HL !!!
 574+ B1A8              ;
 575+ B1A8              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ B1A8              ;
 577+ B1A8
 578+ B1A8 24           NextScan inc h          							; Incrementamos el scanline.
 579+ B1A9 7C               ld a,h
 580+ B1AA E6 07            and 7
 581+ B1AC C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ B1AD
 583+ B1AD 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ B1AE C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ B1B0 6F               ld l,a
 586+ B1B1 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ B1B2
 588+ B1B2 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ B1B3 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ B1B5 67               ld h,a
 591+ B1B6 C9               ret
