 503+ A3D3 7E           	ld a,(hl)
 504+ A3D4 E6 1F        	and $1f															; Define el nº de columna por el que va a aparecer la entidad.
 505+ A3D6
 506+ A3D6              ;	Tenemos un nº aleatorio, (Columna de inicio) en A.
 507+ A3D6              ; 	No queremos que se repita la posición de inicio en dos clases distintas de entidades.
 508+ A3D6
 509+ A3D6 57           	ld d,a 															; $08,$12,$0c --- $08,$02,$12 --- $18,$1c,$18 --- $1e,$1c,$18
 510+ A3D7
 511+ A3D7 CD F1 A3     	call No_repeat
