3182  A0A9              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A0A9              ; ******************************************************************************************************************************************************************************************
   2+ A0A9              ;
   3+ A0A9              ;   3/4/25
   4+ A0A9              ;
   5+ A0A9              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0A9              ;   (XOR) bit a bit.
   7+ A0A9              ;
   8+ A0A9              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0A9              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0A9
  11+ A0A9              Derivando_RND
  12+ A0A9
  13+ A0A9 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0AB C5               push bc
  15+ A0AC              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0AC 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0AF              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0AF
  19+ A0AF A7           6 and a                                 ; Carry a "0".
  20+ A0B0 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0B2 30 02            jr nc,1F
  22+ A0B4
  23+ A0B4 CB C1            set 0,c
  24+ A0B6
  25+ A0B6 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0B7 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0B9 5F               ld e,a
  28+ A0BA
  29+ A0BA 7A               ld a,d
  30+ A0BB E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0BD 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0BF
  33+ A0BF CB 3F            srl a
  34+ A0C1
  35+ A0C1 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0C2
  37+ A0C2 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0C3 28 04            jr z,4F
  39+ A0C5
  40+ A0C5 CB FF            set 7,a
  41+ A0C7 18 02            jr 5F
  42+ A0C9
  43+ A0C9 CB BF        4 res 7,a
  44+ A0CB
  45+ A0CB CB 21        5 sla c
  46+ A0CD 10 E0            djnz 6B
  47+ A0CF
  48+ A0CF 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0D0
  50+ A0D0 77               ld (hl),a
  51+ A0D1 23               inc hl
  52+ A0D2 C1               pop bc
  53+ A0D3 10 D4            djnz 3B
  54+ A0D5
  55+ A0D5 C9               ret
  56+ A0D6
  57+ A0D6
  58+ A0D6
# file closed: RND_Derivando.asm
