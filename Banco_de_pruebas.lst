   5+ 938C              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 938C              ;   (XOR) bit a bit.
   7+ 938C              ;
   8+ 938C              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 938C
  10+ 938C              Derivando_RND
  11+ 938C
  12+ 938C 21 F6 88         ld hl,Numeros_aleatorios
  13+ 938F
  14+ 938F ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9391 C5               push bc
  16+ 9392              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9392 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9395              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9395
  20+ 9395 A7           6 and a                                 ; Carry a "0".
  21+ 9396 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9398 30 02            jr nc,1F
  23+ 939A
  24+ 939A CB C1            set 0,c
  25+ 939C
  26+ 939C 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 939D E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 939F 5F               ld e,a
  29+ 93A0
  30+ 93A0 7A               ld a,d
  31+ 93A1 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 93A3 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 93A5
  34+ 93A5 CB 3F            srl a
  35+ 93A7
  36+ 93A7 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 93A8
  38+ 93A8 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 93A9 28 04            jr z,4F
  40+ 93AB
  41+ 93AB CB FF            set 7,a
  42+ 93AD 18 02            jr 5F
  43+ 93AF
  44+ 93AF CB BF        4 res 7,a
  45+ 93B1
  46+ 93B1 CB 21        5 sla c
  47+ 93B3 10 E0            djnz 6B
  48+ 93B5
  49+ 93B5 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 93B6
  51+ 93B6 77               ld (hl),a
  52+ 93B7 23               inc hl
  53+ 93B8 C1               pop bc
  54+ 93B9 10 D4            djnz 3B
