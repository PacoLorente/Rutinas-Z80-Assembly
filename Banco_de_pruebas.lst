 614+ AED8
 615+ AED8 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ AED9 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ AEDB 6F               ld l,a
 618+ AEDC D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ AEDD
 620+ AEDD 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ AEDE C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ AEE0 67               ld h,a
