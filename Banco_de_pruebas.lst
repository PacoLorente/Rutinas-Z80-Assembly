 491  940C              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 492  940C              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 493  940C              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 494  940C              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 495  940C
 496  940C 00           Attr db 0 													; Atributos de la entidad.
