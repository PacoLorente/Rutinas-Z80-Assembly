 261  95B2
 262  95B2              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 263  95B2
 264  95B2 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 265  95B3              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 266  95B3              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 267  95B3              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 268  95B3
 269  95B3 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 270  95B4              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 271  95B4
 272  95B4 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 273  95B5              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 274  95B5              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 275  95B5
 276  95B5              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 277  95B5              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 278  95B5
 279  95B5              ; Ejemplos:
 280  95B5
 281  95B5              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 282  95B5              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 283  95B5              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 284  95B5              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 285  95B5              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 286  95B5
 287  95B5 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 288  95B6              ;															  _ que esta entidad haya colisionado con Amadeus.
 289  95B6              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 290  95B6
 291  95B6 00 00        Puntero_de_impresion defw 0									; Esta variable tiene dos funciones, la primera:
 292  95B8              ;
 293  95B8              ;															; Es utilizada por la rutina [Define_menu] para almacenar el puntero indicial: Define_menu_index_parameters.
 294  95B8              ;
 295  95B8              ;															; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 296  95B8              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 297  95B8
 298  95B8 00 40        Puntero_de_almacen_de_mov_masticados defw Line_0
