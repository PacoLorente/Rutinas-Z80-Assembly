   1+ 9E10              ; ******************************************************************************************************************************************************************************************
   2+ 9E10              ;
   3+ 9E10              ;   6/11/26
   4+ 9E10              ;
   5+ 9E10              ;   Construyo un nº pseudo aleatorio. Método "DERIVANDO":
   6+ 9E10              ;
   7+ 9E10              ;   Inicialmente nuestra semilla será la contenida en el registro R. A partir de ahí irá mutando y la almacenaremos en la variable: (Semilla).
   8+ 9E10              ;
   9+ 9E10              ;   Para construir nuestro n° pseudo aleatorio necesitamos 8 bits que iremos adquiriendo del último bit, (bit_0) de la semilla.
  10+ 9E10              ;
  11+ 9E10              ;   Después de adquirir el bit de la semilla, desplazamos a la derecha los bits de la misma y realizamos una función lógica XOR entre los_
  12+ 9E10              ;   _ bits 0 y 1, (los dos últimos).
  13+ 9E10              ;
  14+ 9E10              ;   Si el resultado de la operación XOR es "1" pondremos a "1" el bit_7 de la semilla. Si es "0" no realizamos cambios.
  15+ 9E10              ;
  16+ 9E10              ;   Desplazamos los bits del número que estamos generando una posición a la izquierda con el fin de adquirir un nuevo bit de la semilla.
  17+ 9E10              ;
  18+ 9E10              ;   Repetimos proceso hasta que hayamos adquirido los 8 bits necesarios de la semilla.
  19+ 9E10              ;
  20+ 9E10              ;   Guardamos la semilla en la variable (Semilla) y el número generado en (HL).
  21+ 9E10              ;
  22+ 9E10              ;   Incrementamos el puntero HL para situarlo en la siguiente dirección de memoria, (donde almacenaremos el siguiente n° pseudo aleatorio a generar).
  23+ 9E10              ;
  24+ 9E10              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
  25+ 9E10              ;          HL contendrá la dirección de mem. donde vamos a almacenar el 1er n° de los (B) números pseudo aleatorios a generar.
  26+ 9E10              ;
  27+ 9E10              ;   MODIFY: (Semilla), AF, HL, DE y B.
  28+ 9E10
  29+ 9E10              Derivando_RND:
  30+ 9E10
  31+ 9E10              ;   En 1er lugar comprobamos si disponemos de semilla.
  32+ 9E10
  33+ 9E10 3A 5C 96         ld a,(Semilla)
  34+ 9E13
  35+ 9E13 A7               and a
  36+ 9E14
  37+ 9E14 20 02            jr nz,Semilla_iniciada
  38+ 9E16
  39+ 9E16              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  40+ 9E16 ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  41+ 9E18
  42+ 9E18              Semilla_iniciada:
  43+ 9E18
  44+ 9E18 57               ld d,a                              ; A partir de ahora, (D) contendrá nuestra semilla.
  45+ 9E19
  46+ 9E19 C5               push bc                             ; PUSH N° de números que queremos generar.
  47+ 9E1A
  48+ 9E1A 01 00 08         ld bc,$0800                         ; C contendrá nuestro nº aleatorio: ($0 - $ff). Inicialmente está a "0".
  49+ 9E1D              ;                                       ; B actuará como contador de bits, (números de bits a generar), 8 bits.
  50+ 9E1D
  51+ 9E1D CB 21        3 sla c                                 ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  52+ 9E1F
  53+ 9E1F 7A               ld a,d
  54+ 9E20
  55+ 9E20              ;   El último bit de la semilla, (bit_0) será el 1° del número pseudo aleatorio generado, (bit_7).
  56+ 9E20
  57+ 9E20 E6 01            and %00000001
  58+ 9E22
  59+ 9E22 28 02            jr z,4F
  60+ 9E24
  61+ 9E24 CB C1            set 0,c                             ; One bit generated.
  62+ 9E26
  63+ 9E26              ;   Rotamos los bits de la semilla una posición a la derecha.
  64+ 9E26
  65+ 9E26 CB 1A        4  rr d                                 ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  66+ 9E28
  67+ 9E28 7A               ld a,d
  68+ 9E29
  69+ 9E29              Xor_bit_1_bit_2:
  70+ 9E29
  71+ 9E29 E6 01            and %00000001                       ; Bit_0 en (E).
  72+ 9E2B 5F               ld e,a
  73+ 9E2C
  74+ 9E2C 7A               ld a,d
  75+ 9E2D E6 02            and %00000010                       ; Bit_1 en (A).
  76+ 9E2F
  77+ 9E2F 28 02            jr z,1F
  78+ 9E31
  79+ 9E31 3E 01            ld a,1
  80+ 9E33
  81+ 9E33 AB           1 xor e
  82+ 9E34
  83+ 9E34              ;   FUNCIÓN XOR entre el bit_0 y el bit_1 de la semilla después de una rotación de 1 bit a la derecha.
  84+ 9E34
  85+ 9E34              ;   0 0 ..... 0
  86+ 9E34              ;   0 1 ..... 1
  87+ 9E34              ;   1 0 ..... 1
  88+ 9E34              ;   1 1 ..... 0
  89+ 9E34
  90+ 9E34 28 02            jr z,2F
  91+ 9E36
  92+ 9E36 CB FA            set 7,d                             ; Cuando la función XOR entre los dos últimos bits de la semilla resulta "1",_
  93+ 9E38              ;                                       ; _ seteamos a "1" el bit_7 de la misma.
  94+ 9E38
  95+ 9E38 10 E3        2 djnz 3B
  96+ 9E3A
  97+ 9E3A              Number_generated:
  98+ 9E3A
  99+ 9E3A 7A               ld a,d
 100+ 9E3B
 101+ 9E3B 32 5C 96         ld (Semilla),a                      ; Guarda la evolución de la semilla para seguir generando números.
 102+ 9E3E
 103+ 9E3E 71               ld (hl),c                           ; Guardamos el número pseudo aleatorio generado en su correspondiente dirección de memoria.
 104+ 9E3F
 105+ 9E3F 23               inc hl                              ; HL apunta a la dirección de memoria donde vamos a guardar el siguiente número a generar.
 106+ 9E40
 107+ 9E40 C1               pop bc
 108+ 9E41
 109+ 9E41 10 CD            djnz Derivando_RND
