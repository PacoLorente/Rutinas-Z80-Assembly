   2+ 95DB              ;
   3+ 95DB              ;
   4+ 95DB              ;	CLS.
   5+ 95DB              ;
   6+ 95DB              ;	Limpia la pantalla y define sus atributos.
   7+ 95DB              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ 95DB              ;
   9+ 95DB              ;	COLORES: 0 ..... NEGRO
  10+ 95DB              ;    		 1 ..... AZUL
  11+ 95DB              ; 			 2 ..... ROJO
  12+ 95DB              ;			 3 ..... MAGENTA
  13+ 95DB              ; 			 4 ..... VERDE
  14+ 95DB              ; 			 5 ..... CIAN
  15+ 95DB              ;			 6 ..... AMARILLO
  16+ 95DB              ; 			 7 ..... BLANCO
  17+ 95DB              ;
  18+ 95DB              ;	INPUT: A contiene los atributos de pantalla.
  19+ 95DB              ;
  20+ 95DB              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ 95DB
  22+ 95DB
  23+ 95DB 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ 95DE 11 01 40     	LD DE,$4001
  25+ 95E1 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ 95E4 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ 95E6 ED B0        	LDIR
  28+ 95E8 01 FF 02     	LD BC,767
  29+ 95EB 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ 95EC ED B0        	LDIR
  31+ 95EE C9           	ret
  32+ 95EF
