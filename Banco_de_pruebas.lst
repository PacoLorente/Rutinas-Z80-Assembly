  12+ A0A3
  13+ A0A3 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0A5 C5               push bc
  15+ A0A6              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0A6 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0A9              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0A9
  19+ A0A9 A7           6 and a                                 ; Carry a "0".
  20+ A0AA CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0AC 30 02            jr nc,1F
  22+ A0AE
  23+ A0AE CB C1            set 0,c
  24+ A0B0
  25+ A0B0 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0B1 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0B3 5F               ld e,a
  28+ A0B4
  29+ A0B4 7A               ld a,d
  30+ A0B5 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0B7 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0B9
  33+ A0B9 CB 3F            srl a
  34+ A0BB
  35+ A0BB AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0BC
  37+ A0BC 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0BD 28 04            jr z,4F
  39+ A0BF
  40+ A0BF CB FF            set 7,a
  41+ A0C1 18 02            jr 5F
  42+ A0C3
  43+ A0C3 CB BF        4 res 7,a
  44+ A0C5
  45+ A0C5 CB 21        5 sla c
  46+ A0C7 10 E0            djnz 6B
  47+ A0C9
  48+ A0C9 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0CA
  50+ A0CA 77               ld (hl),a
  51+ A0CB 23               inc hl
  52+ A0CC C1               pop bc
  53+ A0CD 10 D4            djnz 3B
  54+ A0CF
  55+ A0CF C9               ret
  56+ A0D0
  57+ A0D0
  58+ A0D0
