 521  8E59 21 00 8A     	ld hl,Numeros_aleatorios 									; Dirección de mem. donde almacenamos los nº RND.
 522  8E5C CD E9 95     	call Derivando_RND 										 	; Rutina de generación de nº aleatorios.
 523  8E5F
 524  8E5F CD 04 91     	call Extrae_numero_aleatorio_y_avanza
