 504  8E2D              START
 505  8E2D
 506  8E2D 31 00 00     	ld sp,0																	; Situamos el inicio de Stack.
 507  8E30 3E FC        	ld a,$fc 																; IM2 ON. Vector de interrupciones a $fcff, (defw debajo de la pila).
 508  8E32 ED 47        	ld i,a 																	; Byte alto de la dirección donde se encuentra nuestro vector de interrupciones en el registro I. ($a9). El byte bajo será siempre $ff.
 509  8E34 ED 5E        	IM 2 											   							; Habilitamos el modo 2 de INTERRUPCIONES.
 510  8E36 F3           	DI
