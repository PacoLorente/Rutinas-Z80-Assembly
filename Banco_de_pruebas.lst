3292  A143              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A143              ; ******************************************************************************************************************************************************************************************
   2+ A143              ;
   3+ A143              ;   3/4/25
   4+ A143              ;
   5+ A143              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A143              ;   (XOR) bit a bit.
   7+ A143              ;
   8+ A143              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A143              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A143
  11+ A143              Derivando_RND
  12+ A143
  13+ A143 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A145 C5               push bc
  15+ A146              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A146 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A149              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A149
  19+ A149 A7           6 and a                                 ; Carry a "0".
  20+ A14A CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A14C 30 02            jr nc,1F
  22+ A14E
  23+ A14E CB C1            set 0,c
  24+ A150
  25+ A150 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A151 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A153 5F               ld e,a
  28+ A154
  29+ A154 7A               ld a,d
  30+ A155 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A157 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A159
  33+ A159 CB 3F            srl a
  34+ A15B
  35+ A15B AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A15C
  37+ A15C 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A15D 28 04            jr z,4F
  39+ A15F
  40+ A15F CB FF            set 7,a
  41+ A161 18 02            jr 5F
  42+ A163
  43+ A163 CB BF        4 res 7,a
  44+ A165
  45+ A165 CB 21        5 sla c
  46+ A167 10 E0            djnz 6B
  47+ A169
  48+ A169 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A16A
  50+ A16A 77               ld (hl),a
  51+ A16B 23               inc hl
  52+ A16C C1               pop bc
  53+ A16D 10 D4            djnz 3B
  54+ A16F
  55+ A16F C9               ret
  56+ A170
  57+ A170
  58+ A170
# file closed: RND_Derivando.asm
