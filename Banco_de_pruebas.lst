   1+ 9469              ; ******************************************************************************************************************************************************************************************
   2+ 9469              ;
   3+ 9469              ;   21/04/24
   4+ 9469              ;
   5+ 9469              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9469              ;   (XOR) bit a bit.
   7+ 9469              ;
   8+ 9469              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9469
  10+ 9469              Derivando_RND
  11+ 9469
  12+ 9469 21 F6 88         ld hl,Numeros_aleatorios
  13+ 946C
  14+ 946C ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 946E C5               push bc
  16+ 946F              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 946F 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9472              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9472
  20+ 9472 A7           6 and a                                 ; Carry a "0".
  21+ 9473 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9475 30 02            jr nc,1F
  23+ 9477
  24+ 9477 CB C1            set 0,c
  25+ 9479
  26+ 9479 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 947A E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 947C 5F               ld e,a
  29+ 947D
  30+ 947D 7A               ld a,d
  31+ 947E E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9480 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9482
  34+ 9482 CB 3F            srl a
  35+ 9484
  36+ 9484 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9485
  38+ 9485 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9486 28 04            jr z,4F
  40+ 9488
  41+ 9488 CB FF            set 7,a
  42+ 948A 18 02            jr 5F
  43+ 948C
  44+ 948C CB BF        4 res 7,a
  45+ 948E
  46+ 948E CB 21        5 sla c
  47+ 9490 10 E0            djnz 6B
  48+ 9492
  49+ 9492 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9493
  51+ 9493 77               ld (hl),a
  52+ 9494 23               inc hl
  53+ 9495 C1               pop bc
  54+ 9496 10 D4            djnz 3B
  55+ 9498
  56+ 9498 C9               ret
  57+ 9499
  58+ 9499
