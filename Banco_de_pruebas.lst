 304  8CB0 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 305  8CB1              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 306  8CB1
 307  8CB1 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 308  8CB2 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 309  8CB3 00           Cola_de_desplazamiento db 0						; Este byte indica:
 310  8CB4
 311  8CB4              ;
 312  8CB4              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 313  8CB4              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 314  8CB4              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 315  8CB4              ;
 316  8CB4              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 317  8CB4              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 318  8CB4              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 319  8CB4              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 320  8CB4              ;
 321  8CB4              ;																;	"$ff" ..... Bucle infinito de repetición.
 322  8CB4              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 323  8CB4              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
