 582+ ACCC
 583+ ACCC 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ ACCD C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ ACCF 6F               ld l,a
 586+ ACD0 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ ACD1
 588+ ACD1 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ ACD2 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ ACD4 67               ld h,a
