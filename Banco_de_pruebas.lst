   5+ 99BC              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99BC              ;   (XOR) bit a bit.
   7+ 99BC              ;
   8+ 99BC              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99BC              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99BC
  11+ 99BC              Derivando_RND
  12+ 99BC
  13+ 99BC ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99BE C5               push bc
  15+ 99BF              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99BF 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99C2              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99C2
  19+ 99C2 A7           6 and a                                 ; Carry a "0".
  20+ 99C3 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99C5 30 02            jr nc,1F
  22+ 99C7
  23+ 99C7 CB C1            set 0,c
  24+ 99C9
  25+ 99C9 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99CA E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99CC 5F               ld e,a
  28+ 99CD
  29+ 99CD 7A               ld a,d
  30+ 99CE E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99D0 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99D2
  33+ 99D2 CB 3F            srl a
  34+ 99D4
  35+ 99D4 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99D5
  37+ 99D5 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99D6 28 04            jr z,4F
  39+ 99D8
  40+ 99D8 CB FF            set 7,a
  41+ 99DA 18 02            jr 5F
  42+ 99DC
  43+ 99DC CB BF        4 res 7,a
  44+ 99DE
  45+ 99DE CB 21        5 sla c
  46+ 99E0 10 E0            djnz 6B
  47+ 99E2
  48+ 99E2 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99E3
  50+ 99E3 77               ld (hl),a
  51+ 99E4 23               inc hl
  52+ 99E5 C1               pop bc
  53+ 99E6 10 D4            djnz 3B
  54+ 99E8
  55+ 99E8 C9               ret
