   9+ A546              ;	COLORES: 0 ..... NEGRO
  10+ A546              ;    		 1 ..... AZUL
  11+ A546              ; 			 2 ..... ROJO
  12+ A546              ;			 3 ..... MAGENTA
  13+ A546              ; 			 4 ..... VERDE
  14+ A546              ; 			 5 ..... CIAN
  15+ A546              ;			 6 ..... AMARILLO
  16+ A546              ; 			 7 ..... BLANCO
  17+ A546              ;
  18+ A546              ;	INPUT: A contiene los atributos de pantalla.
  19+ A546              ;
  20+ A546              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A546
  22+ A546
  23+ A546 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A549 11 01 40     	LD DE,$4001
  25+ A54C 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A54F 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A551 ED B0        	LDIR
  28+ A553 01 FF 02     	LD BC,767
  29+ A556 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A557 ED B0        	LDIR
  31+ A559
  32+ A559 AF           	xor a
  33+ A55A
  34+ A55A C9           	ret
  35+ A55B
