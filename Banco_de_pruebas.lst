 685+ B563              ;
 686+ B563              ;   NextScan.
 687+ B563              ;
 688+ B563              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 689+ B563              ;
 690+ B563              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 691+ B563              ;
 692+ B563              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 693+ B563              ;
 694+ B563              ;       DESTRUIDOS: AF y HL !!!
 695+ B563              ;
 696+ B563              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 697+ B563              ;
 698+ B563
 699+ B563              NextScan:
 700+ B563
 701+ B563 24           	inc h          							; Incrementamos el scanline.
 702+ B564 7C               ld a,h
 703+ B565 E6 07            and 7
 704+ B567 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 705+ B568
 706+ B568 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 707+ B569 C6 20            add a,$20           							; Vamos a comprobarlo...
 708+ B56B 6F               ld l,a
 709+ B56C D8               ret c               							; Salimos si se produce el cambio de tercio.
 710+ B56D
 711+ B56D 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 712+ B56E D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 713+ B570 67               ld h,a
 714+ B571 C9               ret
 715+ B572
 716+ B572              ;----------------------------------------------------------------------------------------------------------------
 717+ B572              ;
 718+ B572              ;	5/08/22
 719+ B572              ;
 720+ B572              ;   PreviousScan.
 721+ B572              ;
 722+ B572              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 723+ B572              ;
 724+ B572              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 725+ B572              ;
 726+ B572              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 727+ B572              ;
 728+ B572              ;       DESTRUIDOS: AF y HL !!!
 729+ B572              ;
 730+ B572              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 731+ B572              ;
 732+ B572
 733+ B572              PreviousScan:
 734+ B572
 735+ B572 7C           	ld a,h
 736+ B573 25               dec h               							; Dec H.
 737+ B574 E6 07            and 7
 738+ B576 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 739+ B577
 740+ B577 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 741+ B578 D6 20            sub $20             							; Vamos a comprobarlo...
 742+ B57A 6F               ld l,a
 743+ B57B D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 744+ B57C
 745+ B57C 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 746+ B57D C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 747+ B57F 67               ld h,a
 748+ B580 C9               ret
