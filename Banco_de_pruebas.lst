   1+ 9DD8              ; ******************************************************************************************************************************************************************************************
   2+ 9DD8              ;
   3+ 9DD8              ;   3/4/25
   4+ 9DD8              ;
   5+ 9DD8              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9DD8              ;   (XOR) bit a bit.
   7+ 9DD8              ;
   8+ 9DD8              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9DD8              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9DD8
  11+ 9DD8              Derivando_RND
  12+ 9DD8
  13+ 9DD8 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9DDA C5               push bc
  15+ 9DDB              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9DDB 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9DDE              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9DDE
  19+ 9DDE A7           6 and a                                 ; Carry a "0".
  20+ 9DDF CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9DE1 30 02            jr nc,1F
  22+ 9DE3
  23+ 9DE3 CB C1            set 0,c
  24+ 9DE5
  25+ 9DE5 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9DE6 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9DE8 5F               ld e,a
  28+ 9DE9
  29+ 9DE9 7A               ld a,d
  30+ 9DEA E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9DEC 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9DEE
  33+ 9DEE CB 3F            srl a
  34+ 9DF0
  35+ 9DF0 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9DF1
  37+ 9DF1 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9DF2 28 04            jr z,4F
  39+ 9DF4
  40+ 9DF4 CB FF            set 7,a
  41+ 9DF6 18 02            jr 5F
  42+ 9DF8
  43+ 9DF8 CB BF        4 res 7,a
  44+ 9DFA
  45+ 9DFA CB 21        5 sla c
  46+ 9DFC 10 E0            djnz 6B
  47+ 9DFE
  48+ 9DFE 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9DFF
  50+ 9DFF 77               ld (hl),a
  51+ 9E00 23               inc hl
  52+ 9E01 C1               pop bc
  53+ 9E02 10 D4            djnz 3B
  54+ 9E04
  55+ 9E04 C9               ret
  56+ 9E05
  57+ 9E05
  58+ 9E05
# file closed: RND_Derivando.asm
