 339+ 9EA3              PreviousScan:
 340+ 9EA3
 341+ 9EA3 7C           	ld a,h
 342+ 9EA4 25               dec h               							; Dec H.
 343+ 9EA5 E6 07            and 7
 344+ 9EA7 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 345+ 9EA8
 346+ 9EA8 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 347+ 9EA9 D6 20            sub $20             							; Vamos a comprobarlo...
 348+ 9EAB 6F               ld l,a
 349+ 9EAC D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 350+ 9EAD
 351+ 9EAD 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 352+ 9EAE C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 353+ 9EB0 67               ld h,a
 354+ 9EB1 C9               ret
