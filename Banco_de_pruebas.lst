 581+ A857 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ A858
 583+ A858 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A859 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A85B 6F               ld l,a
 586+ A85C D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A85D
 588+ A85D 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A85E D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A860 67               ld h,a
 591+ A861 C9               ret
