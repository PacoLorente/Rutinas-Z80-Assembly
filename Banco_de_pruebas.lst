 537  93B9 00           Cola_de_desplazamiento db 0									; Este byte indica:
 538  93BA
 539  93BA              ;
 540  93BA              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 541  93BA              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 542  93BA              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 543  93BA              ;
 544  93BA              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 545  93BA              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 546  93BA              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 547  93BA              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 548  93BA              ;
 549  93BA              ;															;	"$ff" ..... Bucle infinito de repetición.
 550  93BA              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 551  93BA              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
