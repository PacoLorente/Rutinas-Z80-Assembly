 557  94EC 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 558  94ED              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 559  94ED              ;
 560  94ED              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
