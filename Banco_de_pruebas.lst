  47+ C056
  48+ C056 7C               ld a,h
  49+ C057 B5               or l
  50+ C058 C8               ret z
  51+ C059
  52+ C059              ;   Actualiza el puntero de notas, (Puntero_musical).
  53+ C059
  54+ C059 13               inc de
  55+ C05A 13               inc de
  56+ C05B
  57+ C05B ED 53 0F 96      ld (Puntero_game_over_noise),de                   ; Puntero situado en la siguiente nota del índice.
  58+ C05F
  59+ C05F              Get_note:
  60+ C05F
  61+ C05F ED 73 B0 95      ld (Stack),sp
  62+ C063
  63+ C063 F9               ld sp,hl
  64+ C064
  65+ C064 C1               pop bc                                            ; (B) siempre "0", (C) indica duración de la nota, (n°de ondas).
  66+ C065 D1               pop de                                            ; (DE) siempre contendrá "0".
  67+ C066 E1               pop hl                                            ; (H) = "0", (L) contiene el valor de la nota.
  68+ C067
  69+ C067              ;   Tenemos la nota cargada en os registros.
