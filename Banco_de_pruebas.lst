 779+ B608              ;----------------------------------------------------------------------------------------------------------------
 780+ B608              ;
 781+ B608              ;	5/08/22
 782+ B608              ;
 783+ B608              ;   NextScan.
 784+ B608              ;
 785+ B608              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B608              ;
 787+ B608              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B608              ;
 789+ B608              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B608              ;
 791+ B608              ;       DESTRUIDOS: AF y HL !!!
 792+ B608              ;
 793+ B608              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B608              ;
 795+ B608
 796+ B608              NextScan:
 797+ B608
 798+ B608 24           	inc h          							; Incrementamos el scanline.
 799+ B609 7C               ld a,h
 800+ B60A E6 07            and 7
 801+ B60C C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B60D
 803+ B60D 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B60E C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B610 6F               ld l,a
 806+ B611 D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B612
 808+ B612 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B613 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B615 67               ld h,a
 811+ B616 C9               ret
 812+ B617
 813+ B617              NextScan_15:
 814+ B617
 815+ B617 06 0F        	ld b,15
 816+ B619 CD 08 B6     1 call NextScan
 817+ B61C 10 FB        	djnz 1B
 818+ B61E
 819+ B61E C9           	ret
 820+ B61F
 821+ B61F              ;----------------------------------------------------------------------------------------------------------------
 822+ B61F              ;
 823+ B61F              ;	5/08/22
 824+ B61F              ;
 825+ B61F              ;   PreviousScan.
 826+ B61F              ;
 827+ B61F              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B61F              ;
 829+ B61F              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B61F              ;
 831+ B61F              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B61F              ;
 833+ B61F              ;       DESTRUIDOS: AF y HL !!!
 834+ B61F              ;
 835+ B61F              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B61F              ;
 837+ B61F
 838+ B61F              PreviousScan:
 839+ B61F
 840+ B61F 7C           	ld a,h
 841+ B620 25               dec h               							; Dec H.
 842+ B621 E6 07            and 7
 843+ B623 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B624
 845+ B624 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B625 D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B627 6F               ld l,a
 848+ B628 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B629
 850+ B629 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B62A C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B62C 67               ld h,a
 853+ B62D C9               ret
 854+ B62E
 855+ B62E              PreviousScan_15:
 856+ B62E
 857+ B62E 06 0F        	ld b,15
