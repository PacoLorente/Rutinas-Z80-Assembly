 309  8F15 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 310  8F16              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 311  8F16
 312  8F16 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 313  8F17 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 314  8F18 00           Cola_de_desplazamiento db 0									; Este byte indica:
 315  8F19
 316  8F19              ;
 317  8F19              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 318  8F19              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 319  8F19              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 320  8F19              ;
 321  8F19              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 322  8F19              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 323  8F19              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
