 505+ A43C
 506+ A43C              ;	Tenemos un nº aleatorio, (Columna de inicio) en A.
 507+ A43C              ; 	No queremos que se repita la posición de inicio en dos clases distintas de entidades.
 508+ A43C
 509+ A43C 57           	ld d,a 															; $08,$12,$0c --- $08,$02,$12 --- $18,$1c,$18 --- $1e,$1c,$18
