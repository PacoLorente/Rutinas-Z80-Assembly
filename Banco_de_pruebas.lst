 625  941E 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 626  9420
 627  9420 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 628  9421              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 629  9421              ;															; _baja de la pantalla cuando hemos superado el nivel.
 630  9421
 631  9421 00           Columnas db 0
 632  9422
 633  9422              ;	DRIVE
 634  9422
 635  9422 00           Sprite_completo_0 db 0
 636  9423 00           Sprite_completo_1 db 0
 637  9424
 638  9424              ; Variables de control general.
 639  9424
 640  9424 00           Frames_explosion db 0 										; Nº de Frames que tiene la explosión.
 641  9425
 642  9425              ; Variables de funcionamiento, (No incluidas en base de datos de entidades), a partir de aquí!!!!!
 643  9425
 644  9425              Perfiles_de_velocidad
 645  9425
 646  9425 00           Vel_left db 0 												; Velocidad izquierda. Nº de píxeles que desplazamos el objeto a izquierda. 1, 2, 4 u 8 px.
 647  9426 00           Vel_right db 0 												; Velocidad derecha. Nº de píxeles que desplazamos el objeto a derecha. 1, 2, 4 u 8 px.
 648  9427 00           Vel_up db 0 												; Velocidad subida. Nº de píxeles que desplazamos el objeto hacia arriba. (De 1 a 7px).
 649  9428 00           Vel_down db 0 												; Velocidad bajada. Nº de píxeles que desplazamos el objeto hacia abajo. (De 1 a 7px).
 650  9429
 651  9429              ; Movimiento. ------------------------------------------------------------------------------------------------------
 652  9429
 653  9429 00 00        Puntero_tabla_Random defw 0
 654  942B 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 655  942D 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 656  942F 00 00        Puntero_indice_mov_bucle defw 0
 657  9431              ;
 658  9431              ;
 659  9431 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 660  9432              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
