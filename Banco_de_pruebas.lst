   5+ 9664              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9664              ;   (XOR) bit a bit.
   7+ 9664              ;
   8+ 9664              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9664              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9664
  11+ 9664              Derivando_RND
  12+ 9664
  13+ 9664 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9666 C5               push bc
  15+ 9667              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9667 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 966A              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 966A
  19+ 966A A7           6 and a                                 ; Carry a "0".
  20+ 966B CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 966D 30 02            jr nc,1F
  22+ 966F
  23+ 966F CB C1            set 0,c
  24+ 9671
  25+ 9671 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9672 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9674 5F               ld e,a
  28+ 9675
  29+ 9675 7A               ld a,d
  30+ 9676 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9678 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 967A
  33+ 967A CB 3F            srl a
  34+ 967C
  35+ 967C AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 967D
  37+ 967D 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 967E 28 04            jr z,4F
  39+ 9680
  40+ 9680 CB FF            set 7,a
  41+ 9682 18 02            jr 5F
  42+ 9684
  43+ 9684 CB BF        4 res 7,a
  44+ 9686
  45+ 9686 CB 21        5 sla c
  46+ 9688 10 E0            djnz 6B
  47+ 968A
  48+ 968A 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 968B
  50+ 968B 77               ld (hl),a
  51+ 968C 23               inc hl
  52+ 968D C1               pop bc
  53+ 968E 10 D4            djnz 3B
  54+ 9690
  55+ 9690 C9               ret
  56+ 9691
  57+ 9691
  58+ 9691
