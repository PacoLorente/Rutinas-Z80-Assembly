1080+ C578              ;
1081+ C578              ;   Special keys:
1082+ C578              ;
1083+ C578              ;   Symbol_key defm "SYMB."
1084+ C578              ;   Space_key defm "SPACE"
1085+ C578              ;   Enter_key defm "ENTER"
1086+ C578              ;   Caps_key defm "CAPS."
1087+ C578              ;
1088+ C578              ;   MODIFY: AF, E.
