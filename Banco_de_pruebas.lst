  28+ A37D 01 FF 02     	LD BC,767
  29+ A380 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A381 ED B0        	LDIR
  31+ A383
  32+ A383 AF           	xor a
  33+ A384
  34+ A384 C9           	ret
  35+ A385
