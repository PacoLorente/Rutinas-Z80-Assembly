1739  99F6
1740  99F6 4E           	ld c,(hl)
1741  99F7
1742  99F7              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1743  99F7              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
1744  99F7
1745  99F7 23           1 inc hl
