 191+ C155 20 07            jr nz,3F
 192+ C157
 193+ C157              ;   El dígito es "0".
 194+ C157
 195+ C157 0C               inc c
 196+ C158 0D               dec c
 197+ C159 20 03            jr nz,3F
 198+ C15B
 199+ C15B 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 200+ C15C 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 201+ C15E
 202+ C15E D5           3 push de                                    ; PUSH Score_max_msg.
 203+ C15F
