 822+ B5CF              ;
 823+ B5CF              ;	5/08/22
 824+ B5CF              ;
 825+ B5CF              ;   PreviousScan.
 826+ B5CF              ;
 827+ B5CF              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 828+ B5CF              ;
 829+ B5CF              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 830+ B5CF              ;
 831+ B5CF              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 832+ B5CF              ;
 833+ B5CF              ;       DESTRUIDOS: AF y HL !!!
 834+ B5CF              ;
 835+ B5CF              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 836+ B5CF              ;
 837+ B5CF
 838+ B5CF              PreviousScan:
 839+ B5CF
 840+ B5CF 7C           	ld a,h
 841+ B5D0 25               dec h               							; Dec H.
 842+ B5D1 E6 07            and 7
 843+ B5D3 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 844+ B5D4
 845+ B5D4 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 846+ B5D5 D6 20            sub $20             							; Vamos a comprobarlo...
 847+ B5D7 6F               ld l,a
 848+ B5D8 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 849+ B5D9
 850+ B5D9 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 851+ B5DA C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 852+ B5DC 67               ld h,a
 853+ B5DD C9               ret
 854+ B5DE
