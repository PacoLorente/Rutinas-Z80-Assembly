 473  93FF              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 474  93FF
 475  93FF 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 476  9400              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 477  9400              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 478  9400              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 479  9400
 480  9400 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 481  9401              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 482  9401 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 483  9402 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 484  9403
 485  9403 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 486  9404              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 487  9404              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 488  9404
 489  9404              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 490  9404              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 491  9404
 492  9404              ; Ejemplos:
 493  9404
 494  9404              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 495  9404              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 496  9404              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 497  9404              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 498  9404              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 499  9404
 500  9404 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 501  9405              ;															  _ que esta entidad haya colisionado con Amadeus.
 502  9405              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 503  9405
 504  9405 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 505  9407              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 506  9407
 507  9407 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 508  9409
 509  9409              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 510  9409
 511  9409 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 512  940B              ;															  _palabras que componen el "movimiento_masticado".
 513  940B
 514  940B              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 515  940B
 516  940B 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 517  940C              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 518  940C              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 519  940C              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 520  940C              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 521  940C
 522  940C 00           Attr db 0 													; Atributos de la entidad.
 523  940D
 524  940D              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 525  940D
 526  940D
 527  940D
 528  940D 00           Ctrl_2 db 0
 529  940E              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 530  940E              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 531  940E              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 532  940E              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 533  940E              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 534  940E              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 535  940E              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 536  940E              ;
 537  940E              ;															BIT 1, Este bit a "1" indica que se ha iniciado el proceso de EXPLOSIÓN en una entidad.
 538  940E              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 539  940E              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 540  940E              ;															BIT 3, Indica que (Cola_de_desplazamiento)="254". Esto quiere decir que repetiremos (1-255 veces),_
 541  940E              ;															_ el último MOVIMIENTO que hayamos ejecutado.
 542  940E              ;															BIT 4, ???
 543  940E              ;															BIT 5, Este bit a "1" indica que esta entidad es una "Entidad_guía".
 544  940E              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
 545  940E              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
 546  940E              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 547  940E              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 548  940E
 549  940E 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 550  940F              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_limite_vertical],_
 551  940F              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 552  940F              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 553  940F              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 554  940F              ;
 555  940F              ; 															DESCRIPCIÖN:
 556  940F              ;
 557  940F              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 558  940F              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_limite_vertical]).
 559  940F              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 560  940F              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_limite_vertical]).
 561  940F              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 562  940F              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 563  940F              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 564  940F              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 565  940F              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 566  940F              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 567  940F              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 568  940F              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_limite_vertical) justo después de `inicializar? un objeto.
 569  940F              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 570  940F              ;
 571  940F              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 572  940F              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 573  940F              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 574  940F
 575  940F 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 576  9410              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 577  9410              ;															; _rojo - amarillo.
 578  9410
 579  9410 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 580  9411              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 581  9411
 582  9411 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 583  9413 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
 584  9415
 585  9415              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 586  9415
 587  9415 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 588  9416              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 589  9416              ;
 590  9416              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
 591  9416
 592  9416              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 593  9416
 594  9416              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
 595  9416              ;
 596  9416              ;	COLORES: 0 ..... NEGRO
 597  9416              ;    		 1 ..... AZUL    jr $
 598  9416              ; 			 2 ..... ROJO
 599  9416              ;			 3 ..... MAGENTA
 600  9416              ; 			 4 ..... VERDE
 601  9416              ; 			 5 ..... CIAN
 602  9416              ;			 6 ..... AMARILLO
 603  9416              ; 			 7 ..... BLANCO
 604  9416
 605  9416
 606  9416 00 00        Indice_Sprite_der defw 0
 607  9418 00 00        Indice_Sprite_izq defw 0
 608  941A 00 00        Puntero_DESPLZ_der defw 0
 609  941C 00 00        Puntero_DESPLZ_izq defw 0
 610  941E 00 00        Posicion_inicio defw 0										; Dirección de pantalla donde aparece el objeto. [DRAW].
 611  9420
 612  9420 00           Cuad_objeto db 0											; Almacena el cuadrante de pantalla donde se encuentra el objeto, (1,2,3,4). [DRAW]
 613  9421              ;															; 2ª FUNCIÓN: Temporizador, define la velocidad de la animación de Amadeus por la parte_
 614  9421              ;															; _baja de la pantalla cuando hemos superado el nivel.
 615  9421
 616  9421 00           Columnas db 0
 617  9422 00           Limite_vertical db 0 										; Nº de columna. Si el objeto llega a esta columna se modifica (Posicion_actual) para poder asignar un nuevo (Cuad_objeto).
 618  9423              ;															; 2ª Función de (Limite_vertical):
 619  9423              ;															; Se inicializa a "0" cada vez que ejecutamos el bucle de entidades. Se utiliza como contador; se incrementa (+1) cada vez que se añade una_
 620  9423              ;															; _descripción a la (Tabla_de_pintado). Este valor lo utiliza la rutina [Ordena_tabla_de_pintado] para ordenar la tabla antes de imprimir.
 621  9423
 622  9423
 623  9423
 624  9423              ; Variables de control general.
 625  9423
 626  9423 00           Frames_explosion db 0 										; Nº de Frames que tiene la explosión.
 627  9424
 628  9424              ; Variables de funcionamiento, (No incluidas en base de datos de entidades), a partir de aquí!!!!!
 629  9424
 630  9424              Perfiles_de_velocidad
 631  9424
 632  9424 00           Vel_left db 0 												; Velocidad izquierda. Nº de píxeles que desplazamos el objeto a izquierda. 1, 2, 4 u 8 px.
 633  9425 00           Vel_right db 0 												; Velocidad derecha. Nº de píxeles que desplazamos el objeto a derecha. 1, 2, 4 u 8 px.
 634  9426 00           Vel_up db 0 												; Velocidad subida. Nº de píxeles que desplazamos el objeto hacia arriba. (De 1 a 7px).
 635  9427 00           Vel_down db 0 												; Velocidad bajada. Nº de píxeles que desplazamos el objeto hacia abajo. (De 1 a 7px).
 636  9428
 637  9428              ; Movimiento. ------------------------------------------------------------------------------------------------------
 638  9428
 639  9428 00 00        Puntero_tabla_Random defw 0
