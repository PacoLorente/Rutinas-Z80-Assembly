 639  9414
 640  9414              ; Movimiento. ------------------------------------------------------------------------------------------------------
 641  9414
 642  9414 00 00        Puntero_tabla_Random defw 0
 643  9416 00 00        Puntero_indice_mov defw 0									; Puntero índice del patrón de movimiento de la entidad. "0" No hay movimiento.
 644  9418 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 645  941A 00 00        Puntero_indice_mov_bucle defw 0
 646  941C              ;
 647  941C              ;
 648  941C 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 649  941D              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
 650  941D              ;															; Va aumentando su valor en saltos de 2 uds, (0,2,4,6,8).
 651  941D
 652  941D 00           Incrementa_puntero_backup db 0
 653  941E 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 654  941F              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 655  941F
 656  941F 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 657  9420 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 658  9421 00           Cola_de_desplazamiento db 0									; Este byte indica:
 659  9422
 660  9422              ;
 661  9422              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 662  9422              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 663  9422              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 664  9422              ;
 665  9422              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 666  9422              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 667  9422              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 668  9422              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 669  9422              ;
 670  9422              ;															;	"$ff" ..... Bucle infinito de repetición.
 671  9422              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 672  9422              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 673  9422
 674  9422 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 675  9423
 676  9423              ;																DESCRIPCIÓN:
 677  9423              ;
 678  9423              ;															BIT 0, "1" Habilita la impresión del msg. DONE en pantalla. La llamada a [Print_DONE] se efectúa desde el Reloj del juego,_
 679  9423              ; 															_ Rutina de interrupciones IM2.
 680  9423
 681  9423 00 00        Repone_puntero_objeto defw 0								; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 682  9425              ; 															; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 683  9425              ; 															; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 684  9425              ;															; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
