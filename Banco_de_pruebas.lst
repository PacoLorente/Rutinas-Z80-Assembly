 345+ C175              ; ----- ----- ----- ----- -----
 346+ C175              ;
 347+ C175              ;   23/9/26
 348+ C175              ;
 349+ C175              ;   El efecto del disparo de Amadeus es de tipo descendente.
 350+ C175              ;
 351+ C175              ;   HL define el sonido.
 352+ C175              ;
 353+ C175              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 354+ C175              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 355+ C175              ;
 356+ C175              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 357+ C175              ;   _ escudo tienen prioridad sobre este efecto.
 358+ C175              ;
 359+ C175              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 360+ C175              ;
 361+ C175              ;   INPUTS: (Shot_sound) <> "0".
 362+ C175              ;
 363+ C175              ;   MODIFY: AF, HL y BC.
 364+ C175              ;
 365+ C175              ;   OUTPUT: (Shot_sound) actualizado.
 366+ C175
 367+ C175              Play_shot_sound_effect:
 368+ C175
 369+ C175              ;   Exclusiones:
 370+ C175
 371+ C175 2A E9 94         ld hl,(Shot_sound)
 372+ C178 7C               ld a,h
 373+ C179 B5               or l
 374+ C17A C8               ret z                   ; RET si no se ha producido disparo.
 375+ C17B
 376+ C17B 3A BB 94         ld a,(Ctrl_6)
 377+ C17E CB 47            bit 0,a
 378+ C180 C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 379+ C181
 380+ C181 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
