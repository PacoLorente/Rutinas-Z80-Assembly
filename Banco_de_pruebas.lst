   4+ 9975              ;
   5+ 9975              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9975              ;   (XOR) bit a bit.
   7+ 9975              ;
   8+ 9975              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9975              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9975
  11+ 9975              Derivando_RND
  12+ 9975
  13+ 9975 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9977 C5               push bc
  15+ 9978              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9978 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 997B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 997B
  19+ 997B A7           6 and a                                 ; Carry a "0".
  20+ 997C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 997E 30 02            jr nc,1F
  22+ 9980
  23+ 9980 CB C1            set 0,c
  24+ 9982
  25+ 9982 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9983 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9985 5F               ld e,a
  28+ 9986
  29+ 9986 7A               ld a,d
  30+ 9987 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9989 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 998B
  33+ 998B CB 3F            srl a
  34+ 998D
  35+ 998D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 998E
  37+ 998E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 998F 28 04            jr z,4F
  39+ 9991
  40+ 9991 CB FF            set 7,a
  41+ 9993 18 02            jr 5F
  42+ 9995
  43+ 9995 CB BF        4 res 7,a
  44+ 9997
  45+ 9997 CB 21        5 sla c
  46+ 9999 10 E0            djnz 6B
  47+ 999B
  48+ 999B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 999C
  50+ 999C 77               ld (hl),a
  51+ 999D 23               inc hl
  52+ 999E C1               pop bc
  53+ 999F 10 D4            djnz 3B
  54+ 99A1
  55+ 99A1 C9               ret
  56+ 99A2
