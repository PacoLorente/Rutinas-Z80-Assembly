 616  94C3 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 617  94C4              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 618  94C4
 619  94C4 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 620  94C5 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 621  94C6 00           Cola_de_desplazamiento db 0									; Este byte indica:
 622  94C7
 623  94C7              ;
 624  94C7              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 625  94C7              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 626  94C7              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 627  94C7              ;
 628  94C7              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 629  94C7              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 630  94C7              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 631  94C7              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 632  94C7              ;
 633  94C7              ;															;	"$ff" ..... Bucle infinito de repetición.
 634  94C7              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 635  94C7              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
