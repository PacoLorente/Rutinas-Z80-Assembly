 614+ A7AE              ;   Attrs.
 615+ A7AE
 616+ A7AE C5           2 push bc
 617+ A7AF E5               push hl
 618+ A7B0
 619+ A7B0 08               ex af,af                                                        ; Salvo Attrs. [Calcula_direccion_atributos] destruye A.
 620+ A7B1 CD AB A1         call Calcula_direccion_atributos
 621+ A7B4 08               ex af,af
 622+ A7B5
 623+ A7B5 77           1 ld (hl),a
 624+ A7B6 2C               inc l
 625+ A7B7 10 FC            djnz 1B
 626+ A7B9
 627+ A7B9 E1               pop hl
 628+ A7BA 08               ex af,af
