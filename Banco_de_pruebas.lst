 216  CC7C 00           Repetimos_desplazamiento db 0								; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 217  CC7D              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 218  CC7D
 219  CC7D 00           Repetimos_desplazamiento_backup db 0	   					; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 220  CC7E 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 221  CC7F 00           Cola_de_desplazamiento db 0									; Este byte indica:
 222  CC80
 223  CC80              ;
 224  CC80              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 225  CC80              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 226  CC80              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 227  CC80              ;
 228  CC80              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 229  CC80              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 230  CC80              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 231  CC80              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 232  CC80              ;
 233  CC80              ;															;	"$ff" ..... Bucle infinito de repetición.
 234  CC80              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 235  CC80              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
