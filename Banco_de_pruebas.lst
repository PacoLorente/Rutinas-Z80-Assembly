 407  9490 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 408  9491              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 409  9491              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 410  9491              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 411  9491
 412  9491 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 413  9492              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 414  9492 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 415  9493 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 416  9494
 417  9494 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 418  9495              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 419  9495              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 420  9495
 421  9495              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 422  9495              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 423  9495
 424  9495              ; Ejemplos:
 425  9495
 426  9495              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 427  9495              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 428  9495              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 429  9495              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 430  9495              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 431  9495
 432  9495 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 433  9496              ;															  _ que esta entidad haya colisionado con Amadeus.
 434  9496              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 435  9496
