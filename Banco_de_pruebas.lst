 255  8C23              ;	COLORES: 0 ..... NEGRO
 256  8C23              ;    		 1 ..... AZUL
 257  8C23              ; 			 2 ..... ROJO
 258  8C23              ;			 3 ..... MAGENTA
 259  8C23              ; 			 4 ..... VERDE
 260  8C23              ; 			 5 ..... CIAN
 261  8C23              ;			 6 ..... AMARILLO
 262  8C23              ; 			 7 ..... BLANCO
 263  8C23
 264  8C23 00 00        Indice_Sprite_der defw 0
 265  8C25 00 00        Indice_Sprite_izq defw 0
 266  8C27 00 00        Puntero_DESPLZ_der defw 0
