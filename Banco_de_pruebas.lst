 479  9157              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 9157
   2+ 9157
   3+ 9157              ;   07/07/23
   4+ 9157              ;
   5+ 9157              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 9157              ;
   7+ 9157              ;   Codificación:
   8+ 9157              ;
   9+ 9157              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 9157              ;
  11+ 9157              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 9157              ;
  13+ 9157              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 9157              ;
  15+ 9157              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 9157              ;
  17+ 9157              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 9157              ;                               ..... %01000010 Vel_up 4
  19+ 9157              ;                                               Vel_down 2
  20+ 9157              ;                               ..... $42
  21+ 9157              ;
  22+ 9157              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 9157              ;
  24+ 9157              ;                               ..... %01000010 Vel_left 4
  25+ 9157              ;                                               Vel_right 2
  26+ 9157              ;                               ..... $42
  27+ 9157              ;
  28+ 9157              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 9157              ;
  30+ 9157              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 9157              ;
  32+ 9157              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 9157              ;
  34+ 9157              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 9157              ;                                     $53
  36+ 9157              ;
  37+ 9157              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 9157              ;
  39+ 9157              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 9157              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 9157              ;
  42+ 9157              ;                       Arriba ..... $81
  43+ 9157              ;                       Arriba - izquierda ..... $a1
  44+ 9157              ;                       Arriba - derecha ..... $91
  45+ 9157              ;
  46+ 9157              ;                       Abajo ..... $41
  47+ 9157              ;                       Abajo - izquierda ..... $61
  48+ 9157              ;                       Abajo - derecha ..... $51
  49+ 9157              ;
  50+ 9157              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 9157              ;
  52+ 9157              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 9157              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 9157              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 9157              ;
  56+ 9157              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 9157              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 9157              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 9157              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 9157              ;
  61+ 9157              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 9157              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 9157              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 9157              ;
  65+ 9157              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 9157              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 9157              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 9157              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 9157
