1484+ B0BF 36 00            ld (hl),0                                       ; Coloca a "0" el .db (Impacto) de la (Entidad_sospechosa_de_colision).
1485+ B0C1 C9               ret
1486+ B0C2
1487+ B0C2              ;   COLISIÓN !!!!!.
1488+ B0C2              ;
1489+ B0C2              ;   .db (Impacto) de Amadeus a "1".
1490+ B0C2              ;   SET el bit3 de (Impacto2).
1491+ B0C2              ;
1492+ B0C2              ;   Nota: El .db (Impacto) de la entidad implicada lo puso a "1" la rutina [Compara_coordenadas_X].
1493+ B0C2
1494+ B0C2 E1           5 pop hl
1495+ B0C3 C1               pop bc
1496+ B0C4
1497+ B0C4 21 D7 8D         ld hl,Impacto_Amadeus
1498+ B0C7 36 01            ld (hl),1
1499+ B0C9 21 F4 91         ld hl,Impacto2                                 ; Cuando se produce Colisión, RES el bit2 de (Impacto2) y_
1500+ B0CC CB 96            res 2,(hl)                                     ; _ SET el bit3. El bit3 de (Impacto2) indica que hay contacto_
1501+ B0CE
1502+ B0CE 11 90 8B         ld de,Indice_Explosion_entidades
1503+ B0D1 2A F5 91         ld hl,(Entidad_sospechosa_de_colision)         ; Situamos el (Puntero_de_almacen_de_mov_masticados) de la entidad impactada en la primera palabra del índice de explosiones.
1504+ B0D4
1505+ B0D4 23               inc hl
1506+ B0D5 23               inc hl
1507+ B0D6 23               inc hl
1508+ B0D7
1509+ B0D7 73               ld (hl),e
1510+ B0D8 23               inc hl
1511+ B0D9 72               ld (hl),d
1512+ B0DA
1513+ B0DA              ; Situamos también el (Puntero_de_almacen_de_mov_masticados) de Amadeus en la primero explosión.
1514+ B0DA
1515+ B0DA 11 30 8C         ld de,Indice_Explosion_Amadeus
1516+ B0DD 21 DA 8D         ld hl,Pamm_Amadeus
1517+ B0E0
1518+ B0E0 73               ld (hl),e
1519+ B0E1 23               inc hl
1520+ B0E2 72               ld (hl),d
1521+ B0E3
1522+ B0E3 C9               ret
1523+ B0E4
1524+ B0E4
1525+ B0E4
1526+ B0E4
