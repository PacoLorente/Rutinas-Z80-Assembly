  48+ 99D7              ; -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  49+ 99D7              ;
  50+ 99D7              ;   14/02/25
  51+ 99D7              ;
  52+ 99D7              ;	Calcula el cuadrante de pantalla donde se encuentra la entidad: (Cuad_objeto), "1", "2", "3" o "4".
  53+ 99D7              ;	Esta información es necesaria para poder calcular el (Puntero_de_impresion) de la entidad.
  54+ 99D7              ;
  55+ 99D7              ;	INPUT:  HL contiene (Posicion_actual).
  56+ 99D7              ;	OUTPUT: (Cuad_objeto) contiene "1", "2", "3" o "4" en función del cuadrante de pantalla en el que se encuentra la entidad.
  57+ 99D7              ;
  58+ 99D7              ;	MODIFY: A.
  59+ 99D7
  60+ 99D7
  61+ 99D7              Calcula_Cuad_objeto
  62+ 99D7
  63+ 99D7 CD D3 95     	call calcula_tercio
  64+ 99DA
  65+ 99DA              ;	Ahora tenemos "0", "1" o "2" en el acumulador en función del tercio de pantalla en el que nos encontremos.
