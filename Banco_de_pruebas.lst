   1+ 9725              ; ******************************************************************************************************************************************************************************************
   2+ 9725              ;
   3+ 9725              ;   3/4/25
   4+ 9725              ;
   5+ 9725              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9725              ;   (XOR) bit a bit.
   7+ 9725              ;
   8+ 9725              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9725              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9725
  11+ 9725              Derivando_RND
  12+ 9725
  13+ 9725 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9727 C5               push bc
  15+ 9728              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9728 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 972B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 972B
  19+ 972B A7           6 and a                                 ; Carry a "0".
  20+ 972C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 972E 30 02            jr nc,1F
  22+ 9730
  23+ 9730 CB C1            set 0,c
  24+ 9732
  25+ 9732 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9733 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9735 5F               ld e,a
  28+ 9736
  29+ 9736 7A               ld a,d
  30+ 9737 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9739 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 973B
  33+ 973B CB 3F            srl a
  34+ 973D
  35+ 973D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 973E
  37+ 973E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 973F 28 04            jr z,4F
  39+ 9741
  40+ 9741 CB FF            set 7,a
  41+ 9743 18 02            jr 5F
  42+ 9745
  43+ 9745 CB BF        4 res 7,a
  44+ 9747
  45+ 9747 CB 21        5 sla c
  46+ 9749 10 E0            djnz 6B
  47+ 974B
  48+ 974B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 974C
  50+ 974C 77               ld (hl),a
  51+ 974D 23               inc hl
  52+ 974E C1               pop bc
  53+ 974F 10 D4            djnz 3B
  54+ 9751
  55+ 9751 C9               ret
  56+ 9752
  57+ 9752
  58+ 9752
