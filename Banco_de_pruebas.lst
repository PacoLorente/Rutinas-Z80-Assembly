   1+ 972B              ; ******************************************************************************************************************************************************************************************
   2+ 972B              ;
   3+ 972B              ;   3/4/25
   4+ 972B              ;
   5+ 972B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 972B              ;   (XOR) bit a bit.
   7+ 972B              ;
   8+ 972B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 972B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 972B
  11+ 972B              Derivando_RND
  12+ 972B
  13+ 972B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 972D C5               push bc
  15+ 972E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 972E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9731              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9731
  19+ 9731 A7           6 and a                                 ; Carry a "0".
  20+ 9732 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9734 30 02            jr nc,1F
  22+ 9736
  23+ 9736 CB C1            set 0,c
  24+ 9738
  25+ 9738 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9739 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 973B 5F               ld e,a
  28+ 973C
  29+ 973C 7A               ld a,d
  30+ 973D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 973F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9741
  33+ 9741 CB 3F            srl a
  34+ 9743
  35+ 9743 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9744
  37+ 9744 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9745 28 04            jr z,4F
  39+ 9747
  40+ 9747 CB FF            set 7,a
  41+ 9749 18 02            jr 5F
  42+ 974B
  43+ 974B CB BF        4 res 7,a
  44+ 974D
  45+ 974D CB 21        5 sla c
  46+ 974F 10 E0            djnz 6B
  47+ 9751
  48+ 9751 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9752
  50+ 9752 77               ld (hl),a
  51+ 9753 23               inc hl
  52+ 9754 C1               pop bc
  53+ 9755 10 D4            djnz 3B
  54+ 9757
  55+ 9757 C9               ret
