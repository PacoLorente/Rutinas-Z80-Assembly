 245  8C88 00           Columns db 0 	  									  	; Nº de columnas. [DRAW]
 246  8C89 00 00        Posicion_actual defw 0							; Dirección actual del Sprite. [DRAW]
 247  8C8B 00 00        Puntero_objeto defw 0								; Donde están los datos para pintar el Sprite.
