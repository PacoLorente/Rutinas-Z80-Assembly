 352+ C130              ; ----- ----- ----- ----- -----
 353+ C130              ;
 354+ C130              ;   23/9/26
 355+ C130              ;
 356+ C130              ;   El efecto del disparo de Amadeus es de tipo descendente.
 357+ C130              ;
 358+ C130              ;   HL define el sonido.
 359+ C130              ;
 360+ C130              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 361+ C130              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 362+ C130              ;
 363+ C130              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 364+ C130              ;   _ escudo tienen prioridad sobre este efecto.
 365+ C130              ;
 366+ C130              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 367+ C130              ;
 368+ C130              ;   INPUTS: (Shot_sound) <> "0".
 369+ C130              ;
 370+ C130              ;   MODIFY: AF, HL y BC.
 371+ C130              ;
 372+ C130              ;   OUTPUT: (Shot_sound) actualizado.
 373+ C130
 374+ C130              Play_shot_sound_effect:
 375+ C130
 376+ C130              ;   Exclusiones:
 377+ C130
 378+ C130 2A 2D 96         ld hl,(Shot_sound)
 379+ C133 7C               ld a,h
 380+ C134 B5               or l
 381+ C135 C8               ret z                   ; RET si no se ha producido disparo.
 382+ C136
 383+ C136 3A 00 96         ld a,(Ctrl_6)
 384+ C139 CB 47            bit 0,a
 385+ C13B C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 386+ C13C
 387+ C13C 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 388+ C13E
 389+ C13E              Loop_1:
 390+ C13E
 391+ C13E 3E 10            ld a,%00010000          ; Borde negro.
 392+ C140 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 393+ C142
 394+ C142 45               ld b,l
 395+ C143
 396+ C143 10 FE        Delay_3 djnz Delay_3
 397+ C145
 398+ C145 AF               xor a                   ; Borde negro.
 399+ C146 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 400+ C148
 401+ C148 45               ld b,l
 402+ C149
 403+ C149 10 FE        Delay_4 djnz Delay_4
 404+ C14B
 405+ C14B              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 406+ C14B
 407+ C14B 2C               inc l
 408+ C14C 2C               inc l
 409+ C14D 2C               inc l
 410+ C14E 2C               inc l
 411+ C14F
 412+ C14F 25               dec h
 413+ C150
 414+ C150 CC 5A C1         call z,Clean_shot_effect
 415+ C153
 416+ C153 0D               dec c
 417+ C154
 418+ C154 20 E8            jr nz,Loop_1
 419+ C156
 420+ C156 22 2D 96         ld (Shot_sound),hl
 421+ C159
 422+ C159 C9               ret
 423+ C15A
 424+ C15A              Clean_shot_effect:
 425+ C15A
 426+ C15A 21 00 00         ld hl,0
 427+ C15D 0E 01            ld c,1
 428+ C15F
 429+ C15F C9               ret
 430+ C160
 431+ C160              ;   -------------------------------------------------------------------------------------------
 432+ C160              ;
 433+ C160              ;   23/9/26
 434+ C160              ;
 435+ C160              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 436+ C160              ;
 437+ C160              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 438+ C160              ;   _ [Sound_Generator].
 439+ C160              ;
 440+ C160              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 441+ C160              ;
 442+ C160              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 443+ C160              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 444+ C160              ;
 445+ C160              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 446+ C160              ;
 447+ C160              ;   MODIFY: AF',AF, HL, DE y BC.
 448+ C160              ;
 449+ C160              ;   OUTPUT: Actualiza (Burst_sound).
 450+ C160
 451+ C160              Play_burst_sound_effect:
 452+ C160
 453+ C160              ;   Exclusiones:
 454+ C160
 455+ C160 3A 2F 96         ld a,(Burst_sound)
 456+ C163 A7               and a
 457+ C164 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 458+ C165
 459+ C165 08               ex af,af
 460+ C166
 461+ C166 3A 00 96         ld a,(Ctrl_6)
 462+ C169 CB 47            bit 0,a
 463+ C16B C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 464+ C16C
 465+ C16C              ;   ----------------------
 466+ C16C
 467+ C16C CB C7            set 0,a
 468+ C16E 32 00 96         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 469+ C171
 470+ C171 08               ex af,af                ; Restore (Burst_sound).
 471+ C172
 472+ C172 67               ld h,a
 473+ C173 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 474+ C175
 475+ C175 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 476+ C176
 477+ C176 22 29 96         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 478+ C179 0E 03            ld c,3
 479+ C17B CD 9E 9F         call Noise_efect
 480+ C17E
 481+ C17E D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 482+ C17F
 483+ C17F 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 484+ C180 94               sub h
 485+ C181
 486+ C181 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 487+ C183
 488+ C183 7C               ld a,h
 489+ C184 32 2F 96         ld (Burst_sound),a
 490+ C187
 491+ C187 C9               ret
 492+ C188
 493+ C188              Clean_burst_efect:
 494+ C188
 495+ C188 AF               xor a
 496+ C189 32 2F 96         ld (Burst_sound),a
 497+ C18C
 498+ C18C 3A 00 96         ld a,(Ctrl_6)
 499+ C18F CB 87            res 0,a
 500+ C191 32 00 96         ld (Ctrl_6),a
 501+ C194
 502+ C194 C9               ret
 503+ C195
 504+ C195              ;   -------------------------------------------------------------------------------------------
 505+ C195              ;
 506+ C195              ;   23/9/26
 507+ C195              ;
 508+ C195              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 509+ C195              ;   _ Shield_sound_effect.
 510+ C195              ;
 511+ C195              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 512+ C195              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 513+ C195              ;
 514+ C195              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 515+ C195              ;
 516+ C195              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 517+ C195              ;
 518+ C195              ;   MODIFY: AF'y BC.
 519+ C195
 520+ C195              Play_Shield_sound_effect:
