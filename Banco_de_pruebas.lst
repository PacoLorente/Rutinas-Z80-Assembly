  20+ A5B5              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A5B5
  22+ A5B5
  23+ A5B5 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A5B8 11 01 40     	LD DE,$4001
  25+ A5BB 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
