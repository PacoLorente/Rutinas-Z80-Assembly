 682+ A7E1              ;
 683+ A7E1              ;   2/4/25
 684+ A7E1              ;
 685+ A7E1
 686+ A7E1              ;   Estructura de un disparo de entidades.
 687+ A7E1
 688+ A7E1              ;   Disparo_1 defw 0                                ; Puntero objeto.
 689+ A7E1              ;   defw 0                                          ; Puntero de impresión.
 690+ A7E1              ;   defw 0                                          ; Control.
 691+ A7E1
 692+ A7E1              ;   El byte bajo de Control indica la velocidad a la que fué lanzado el disparo, (Velocidad)_
 693+ A7E1              ;   _de la entidad en el momento de disparar.
 694+ A7E1
 695+ A7E1              ;   El byte de control muestra la siguiente información:
 696+ A7E1
 697+ A7E1              ;   Nibble alto    ..... Bits (6) y (7) ..... Indican si el disparo va hacia la derecha o hacia la izquierda.
 698+ A7E1              ;
 699+ A7E1              ;                        10xx ..... Izquierda.
 700+ A7E1              ;                        01xx ..... Derecha.
 701+ A7E1              ;                        00xx ..... Recto.
 702+ A7E1
 703+ A7E1              Pinta_disparos_Entidades:
 704+ A7E1
 705+ A7E1 ED 73 C6 94      ld (Stack),sp
 706+ A7E5 ED 7B D8 94      ld sp,(Album_de_borrado_disparos_Entidades)
 707+ A7E9
 708+ A7E9 3E 02            ld a,2
 709+ A7EB 08               ex af,af
 710+ A7EC
 711+ A7EC 0E 47            ld c,%01000111         ; (Attr). de los disparos.
 712+ A7EE
 713+ A7EE 06 07        3 ld b,7                           ; Nº máximo de disparos. Fuerza la salida del album cuando hemos pintado 7 veces_
 714+ A7F0              ;                                      _ aunque IYL+IYH+E no sea "0". (No hay separacíon entre el álbum de borrado y el de pintado).
 715+ A7F0              ;                                      _ No encontraría "0".
 716+ A7F0
 717+ A7F0 FD E1        4 pop iy
