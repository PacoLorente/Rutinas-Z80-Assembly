 575+ C3AC              ; -----------------------------------------------------------------------------------------------------------
 576+ C3AC              ;
 577+ C3AC              ;   17/10/26
 578+ C3AC              ;
 579+ C3AC              ;   Asigna un nuevo KEYCODE y sustituye al contenido en la variable MOVE_xxx, (al que apunta H)L.
 580+ C3AC              ;   Nueva tecla para la función de movimiento, (KEYBOARD) a la que apunta HL.
 581+ C3AC              ;
 582+ C3AC              ;   Move_LEFT db $24
 583+ C3AC              ;   Move_RIGHT db $1c
 584+ C3AC              ;   Move_FIRE db $04
 585+ C3AC              ;   Move_SHIELD db $20
 586+ C3AC              ;
 587+ C3AC              ;   El nuevo KEYCODE también modificará el msg. de texto contenido en la correspondiente caja ASCII.
 588+ C3AC              ;
 589+ C3AC              ;   El msg. de texto será de un char. si es una tecla normal, "q", "s", "2", ..., etc.
 590+ C3AC              ;   El msg. de texto será de 5 chars. si es una tecla especial.
 591+ C3AC              ;
 592+ C3AC              ;   Special keys:
 593+ C3AC              ;
 594+ C3AC              ;   Symbol_key defm "SYMB.",0
 595+ C3AC              ;   Space_key defm "SPACE",0
 596+ C3AC              ;   Enter_key defm "ENTER",0
 597+ C3AC              ;   Caps_key defm "CAPS.",0
 598+ C3AC              ;
 599+ C3AC              ;   INPUTS: HL apunta a la variable que almacenará el correspondiente (KEY_CODE), ej: Move_LEFT.
 600+ C3AC              ;           DE apunta a la variable que almacenará el correspondiente (ASCII_CODE), ej: Move_LEFT_ASCII_CODE.
 601+ C3AC              ;
 602+ C3AC              ;           (Numero_de_teclas_definidas) contiene el n° de teclas YA DEFINIDAS.
 603+ C3AC              ;
 604+ C3AC              ;   MODIFY: AF, HL, BC y DE.
 605+ C3AC              ;
 606+ C3AC              ;   OUTPUT: (A) = "0".
 607+ C3AC
 608+ C3AC              Define_key:
 609+ C3AC
 610+ C3AC E5               push hl                                                 ; PUSH Puntero KEYCODE.
 611+ C3AD D5               push de                                                 ; PUSH Puntero ASCII_CODE.
 612+ C3AE
 613+ C3AE CD 6C A0     3 call ROM_Key_Scan ; v2. Ok.                               ; Scan keyboard.
 614+ C3B1
 615+ C3B1              ;   Tras ejecutar[ROM_Key_Scan], (E) contiene el KEYCODE de la tecla pulsada.
 616+ C3B1
 617+ C3B1 3A 5E 96         ld a,(Numero_de_teclas_definidas)                       ; N° de teclas ya definidas.
 618+ C3B4 A7               and a
 619+ C3B5 28 0B            jr z,2F                                                 ; (Numero_de_teclas_definidas)="0" Indica que estamos definiendo Move_LEFT.
 620+ C3B7              ;                                                           ; (Numero_de_teclas_definidas) se incrementa en una unidad cada vez que se define una tecla:
 621+ C3B7              ;
 622+ C3B7              ;                                                           ; Ej.: Si estamos definiendo Move_RIGHT, (Numero_de_teclas_definidas)="1"
 623+ C3B7              ;                                                           ;      Si estamos definiendo Move_FIRE, (Numero_de_teclas_definidas)="2"
 624+ C3B7              ;                                                           ;      Si estamos definiendo Move_SHIELD, (Numero_de_teclas_definidas)="3"
 625+ C3B7
 626+ C3B7 47               ld b,a                                                  ; Así, (B) contiene el nº de teclas definidas -1.
 627+ C3B8
 628+ C3B8              ;   (Numero_de_teclas_definidas) contiene el n° de comparativas que realizaremos entre el nuevo KEYCODE definido y los anteriormente definidos.
 629+ C3B8              ;   Así evitaremos que se asigne una misma tecla para varias funciones distintas.
 630+ C3B8
 631+ C3B8 21 5F 96         ld hl,Move_LEFT                                         ; 1er KEYCODE a comparar.
 632+ C3BB
 633+ C3BB 7E           1 ld a,(hl)                                                 ; KEY_CODE de Move_LEFT en A.
 634+ C3BC BB               cp e                                                    ; Comparo con el Key_code recién adquirido.
 635+ C3BD 28 EF            jr z,3B                                                 ; Esta tecla ya se definió anteriormente. Volvemos a escanear el teclado.
 636+ C3BF
 637+ C3BF 23               inc hl                                                  ; Next KEYCODE to compare.
 638+ C3C0
 639+ C3C0 10 F9            djnz 1B
 640+ C3C2
 641+ C3C2 7B           2 ld a,e                                                    ; KEY_code en A.
 642+ C3C3
 643+ C3C3 D1               pop de                                                  ; POP Puntero ASCII_CODE.
 644+ C3C4 E1               pop hl                                                  ; POP Puntero KEYCODE.
 645+ C3C5
 646+ C3C5 77               ld (hl),a                                               ; Key_code almacenado.
 647+ C3C6
 648+ C3C6              ;   Sonido, (BEEP) de la pulsación de las teclas, (cuando está autorizada). No se ejecuta [BEEP] si la tecla ya está definida.
 649+ C3C6
 650+ C3C6 CD 34 C1         call BEEP   ; v2. Ok.
