   1+ A0E8              ; ******************************************************************************************************************************************************************************************
   2+ A0E8              ;
   3+ A0E8              ;   3/4/25
   4+ A0E8              ;
   5+ A0E8              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0E8              ;   (XOR) bit a bit.
   7+ A0E8              ;
   8+ A0E8              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0E8              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0E8
  11+ A0E8              Derivando_RND
  12+ A0E8
  13+ A0E8 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0EA C5               push bc
  15+ A0EB              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0EB 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0EE              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0EE
  19+ A0EE A7           6 and a                                 ; Carry a "0".
  20+ A0EF CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0F1 30 02            jr nc,1F
  22+ A0F3
  23+ A0F3 CB C1            set 0,c
  24+ A0F5
  25+ A0F5 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0F6 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0F8 5F               ld e,a
  28+ A0F9
  29+ A0F9 7A               ld a,d
  30+ A0FA E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0FC 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0FE
  33+ A0FE CB 3F            srl a
  34+ A100
  35+ A100 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A101
  37+ A101 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A102 28 04            jr z,4F
  39+ A104
  40+ A104 CB FF            set 7,a
  41+ A106 18 02            jr 5F
  42+ A108
  43+ A108 CB BF        4 res 7,a
  44+ A10A
  45+ A10A CB 21        5 sla c
  46+ A10C 10 E0            djnz 6B
  47+ A10E
  48+ A10E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A10F
  50+ A10F 77               ld (hl),a
  51+ A110 23               inc hl
  52+ A111 C1               pop bc
  53+ A112 10 D4            djnz 3B
  54+ A114
  55+ A114 C9               ret
  56+ A115
  57+ A115
  58+ A115
