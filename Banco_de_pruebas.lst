 356  93A7              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 357  93A7              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 358  93A7              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 359  93A7              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
