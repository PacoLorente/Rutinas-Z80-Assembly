   1+ 9E94              ; ******************************************************************************************************************************************************************************************
   2+ 9E94              ;
   3+ 9E94              ;   6/11/26
   4+ 9E94              ;
   5+ 9E94              ;   Construyo un nº pseudo aleatorio. Método "DERIVANDO":
   6+ 9E94              ;
   7+ 9E94              ;   Inicialmente nuestra semilla será la contenida en el registro R. A partir de ahí irá mutando y la almacenaremos en la variable: (Semilla).
   8+ 9E94              ;
   9+ 9E94              ;   Para construir nuestro n° pseudo aleatorio necesitamos 8 bits que iremos adquiriendo del último bit, (bit_0) de la semilla.
  10+ 9E94              ;
  11+ 9E94              ;   Después de adquirir el bit de la semilla, desplazamos a la derecha los bits de la misma y realizamos una función lógica XOR entre los_
  12+ 9E94              ;   _ bits 0 y 1, (los dos últimos).
  13+ 9E94              ;
  14+ 9E94              ;   Si el resultado de la operación XOR es "1" pondremos a "1" el bit_7 de la semilla. Si es "0" no realizamos cambios.
  15+ 9E94              ;
  16+ 9E94              ;   Desplazamos los bits del número que estamos generando una posición a la izquierda con el fin de adquirir un nuevo bit de la semilla.
  17+ 9E94              ;
  18+ 9E94              ;   Repetimos proceso hasta que hayamos adquirido los 8 bits necesarios de la semilla.
  19+ 9E94              ;
  20+ 9E94              ;   Guardamos la semilla en la variable (Semilla) y el número generado en (HL).
  21+ 9E94              ;
  22+ 9E94              ;   Incrementamos el puntero HL para situarlo en la siguiente dirección de memoria, (donde almacenaremos el siguiente n° pseudo aleatorio a generar).
  23+ 9E94              ;
  24+ 9E94              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
  25+ 9E94              ;          HL contendrá la dirección de mem. donde vamos a almacenar el 1er n° de los (B) números pseudo aleatorios a generar.
  26+ 9E94              ;
  27+ 9E94              ;   MODIFY: (Semilla), AF, HL, DE y B.
  28+ 9E94
  29+ 9E94              Derivando_RND:
  30+ 9E94
  31+ 9E94              ;   En 1er lugar comprobamos si disponemos de semilla.
  32+ 9E94
  33+ 9E94 3A E0 96         ld a,(Semilla)
  34+ 9E97
  35+ 9E97 A7               and a
  36+ 9E98
  37+ 9E98 20 02            jr nz,Semilla_iniciada
  38+ 9E9A
  39+ 9E9A              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  40+ 9E9A ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  41+ 9E9C
  42+ 9E9C              Semilla_iniciada:
  43+ 9E9C
  44+ 9E9C 57               ld d,a                              ; A partir de ahora, (D) contendrá nuestra semilla.
  45+ 9E9D
  46+ 9E9D C5               push bc                             ; PUSH N° de números que queremos generar.
  47+ 9E9E
  48+ 9E9E 01 00 08         ld bc,$0800                         ; C contendrá nuestro nº aleatorio: ($0 - $ff). Inicialmente está a "0".
  49+ 9EA1              ;                                       ; B actuará como contador de bits, (números de bits a generar), 8 bits.
  50+ 9EA1
  51+ 9EA1 CB 21        3 sla c                                 ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  52+ 9EA3
  53+ 9EA3 7A               ld a,d
  54+ 9EA4
  55+ 9EA4              ;   El último bit de la semilla, (bit_0) será el 1° del número pseudo aleatorio generado, (bit_7).
  56+ 9EA4
  57+ 9EA4 E6 01            and %00000001
  58+ 9EA6
  59+ 9EA6 28 02            jr z,4F
  60+ 9EA8
  61+ 9EA8 CB C1            set 0,c                             ; One bit generated.
  62+ 9EAA
  63+ 9EAA              ;   Rotamos los bits de la semilla una posición a la derecha.
  64+ 9EAA
  65+ 9EAA CB 1A        4  rr d                                 ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  66+ 9EAC
  67+ 9EAC 7A               ld a,d
  68+ 9EAD
  69+ 9EAD              Xor_bit_1_bit_2:
  70+ 9EAD
  71+ 9EAD E6 01            and %00000001                       ; Bit_0 en (E).
  72+ 9EAF 5F               ld e,a
  73+ 9EB0
  74+ 9EB0 7A               ld a,d
  75+ 9EB1 E6 02            and %00000010                       ; Bit_1 en (A).
  76+ 9EB3
  77+ 9EB3 28 02            jr z,1F
  78+ 9EB5
  79+ 9EB5 3E 01            ld a,1
  80+ 9EB7
  81+ 9EB7 AB           1 xor e
  82+ 9EB8
  83+ 9EB8              ;   FUNCIÓN XOR entre el bit_0 y el bit_1 de la semilla después de una rotación de 1 bit a la derecha.
  84+ 9EB8
  85+ 9EB8              ;   0 0 ..... 0
  86+ 9EB8              ;   0 1 ..... 1
  87+ 9EB8              ;   1 0 ..... 1
  88+ 9EB8              ;   1 1 ..... 0
  89+ 9EB8
  90+ 9EB8 28 02            jr z,2F
  91+ 9EBA
  92+ 9EBA CB FA            set 7,d                             ; Cuando la función XOR entre los dos últimos bits de la semilla resulta "1",_
  93+ 9EBC              ;                                       ; _ seteamos a "1" el bit_7 de la misma.
  94+ 9EBC
  95+ 9EBC 10 E3        2 djnz 3B
