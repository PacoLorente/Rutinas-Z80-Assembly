   1+ AAC9              ; ******************************************************************************************************************************************************************************************
   2+ AAC9              ;
   3+ AAC9              ;   9/8/26
   4+ AAC9              ;
   5+ AAC9              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ AAC9              ;   (XOR) bit a bit.
   7+ AAC9              ;
   8+ AAC9              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ AAC9              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ AAC9
  11+ AAC9              Derivando_RND:
  12+ AAC9
  13+ AAC9 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ AACB
  15+ AACB C5               push bc
  16+ AACC              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ AACC 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ AACF              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ AACF
  20+ AACF A7           6 and a                                 ; Carry a "0".
  21+ AAD0 CB 3F            srl a                               ; Rotación a la derecha.
  22+ AAD2 30 02            jr nc,1F
  23+ AAD4
  24+ AAD4 CB C1            set 0,c
  25+ AAD6
  26+ AAD6 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después de la rotación.
  27+ AAD7
  28+ AAD7 E6 01            and %00000001                       ; Extraigo bit(0) de r(srl) y lo guardo en E.
  29+ AAD9 5F               ld e,a
  30+ AADA
  31+ AADA 7A               ld a,d
  32+ AADB E6 02            and %00000010                       ; Extraigo bit(1) de r(srl).
  33+ AADD
  34+ AADD 28 02            jr z,2F
  35+ AADF
  36+ AADF CB 3F            srl a
  37+ AAE1
  38+ AAE1 AB           2 xor e                                 ; Realizamos una FUNCIÓN XOR entre el bit(0) y bit (1) de nuestro número aleatorio desplazado.
  39+ AAE2
  40+ AAE2              ;   FUNCIÓN XOR
  41+ AAE2
  42+ AAE2              ;   0 0 ..... 0
  43+ AAE2              ;   0 1 ..... 1
  44+ AAE2              ;   1 0 ..... 1
  45+ AAE2              ;   1 1 ..... 0
  46+ AAE2
  47+ AAE2 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  48+ AAE3
  49+ AAE3 28 04            jr z,4F
  50+ AAE5
  51+ AAE5 CB FF            set 7,a
  52+ AAE7 18 02            jr 5F
  53+ AAE9
  54+ AAE9 CB BF        4 res 7,a
  55+ AAEB
  56+ AAEB CB 21        5 sla c
  57+ AAED 10 E0            djnz 6B
  58+ AAEF
  59+ AAEF 71               ld (hl),c
  60+ AAF0
  61+ AAF0 23               inc hl
  62+ AAF1
  63+ AAF1 C1               pop bc
  64+ AAF2 10 D5            djnz 3B
  65+ AAF4
  66+ AAF4 C9               ret
  67+ AAF5
  68+ AAF5
  69+ AAF5
# file closed: RND_Derivando.asm
