3096  A046              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A046              ; ******************************************************************************************************************************************************************************************
   2+ A046              ;
   3+ A046              ;   3/4/25
   4+ A046              ;
   5+ A046              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A046              ;   (XOR) bit a bit.
   7+ A046              ;
   8+ A046              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A046              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A046
  11+ A046              Derivando_RND
  12+ A046
  13+ A046 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A048 C5               push bc
  15+ A049              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A049 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A04C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A04C
  19+ A04C A7           6 and a                                 ; Carry a "0".
  20+ A04D CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A04F 30 02            jr nc,1F
  22+ A051
  23+ A051 CB C1            set 0,c
  24+ A053
  25+ A053 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A054 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A056 5F               ld e,a
  28+ A057
  29+ A057 7A               ld a,d
  30+ A058 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A05A 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A05C
  33+ A05C CB 3F            srl a
  34+ A05E
  35+ A05E AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A05F
  37+ A05F 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A060 28 04            jr z,4F
  39+ A062
  40+ A062 CB FF            set 7,a
  41+ A064 18 02            jr 5F
  42+ A066
  43+ A066 CB BF        4 res 7,a
  44+ A068
  45+ A068 CB 21        5 sla c
  46+ A06A 10 E0            djnz 6B
  47+ A06C
  48+ A06C 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A06D
  50+ A06D 77               ld (hl),a
  51+ A06E 23               inc hl
  52+ A06F C1               pop bc
  53+ A070 10 D4            djnz 3B
  54+ A072
  55+ A072 C9               ret
  56+ A073
  57+ A073
  58+ A073
# file closed: RND_Derivando.asm
