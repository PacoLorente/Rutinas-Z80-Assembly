 339  91AA 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 340  91AB 00           Cola_de_desplazamiento db 0									; Este byte indica:
 341  91AC
 342  91AC              ;
 343  91AC              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 344  91AC              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 345  91AC              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 346  91AC              ;
 347  91AC              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 348  91AC              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 349  91AC              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 350  91AC              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 351  91AC              ;
 352  91AC              ;															;	"$ff" ..... Bucle infinito de repetición.
 353  91AC              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 354  91AC              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 355  91AC
