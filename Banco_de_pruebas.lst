 593+ B1D3              ;----------------------------------------------------------------------------------------------------------------
 594+ B1D3              ;
 595+ B1D3              ;	5/08/22
 596+ B1D3              ;
 597+ B1D3              ;   PreviousScan.
 598+ B1D3              ;
 599+ B1D3              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 600+ B1D3              ;
 601+ B1D3              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ B1D3              ;
 603+ B1D3              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ B1D3              ;
 605+ B1D3              ;       DESTRUIDOS: AF y HL !!!
 606+ B1D3              ;
 607+ B1D3              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ B1D3              ;
 609+ B1D3
 610+ B1D3 7C           PreviousScan ld a,h
 611+ B1D4 25               dec h               							; Dec H.
 612+ B1D5 E6 07            and 7
 613+ B1D7 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ B1D8
 615+ B1D8 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B1D9 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B1DB 6F               ld l,a
 618+ B1DC D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ B1DD
 620+ B1DD 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ B1DE C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ B1E0 67               ld h,a
 623+ B1E1 C9               ret
