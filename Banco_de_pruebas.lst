 565+ A588              ;   NextScan.
 566+ A588              ;
 567+ A588              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ A588              ;
 569+ A588              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ A588              ;
 571+ A588              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ A588              ;
 573+ A588              ;       DESTRUIDOS: AF y HL !!!
 574+ A588              ;
 575+ A588              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ A588              ;
 577+ A588
 578+ A588 24           NextScan inc h          							; Incrementamos el scanline.
 579+ A589 7C               ld a,h
 580+ A58A E6 07            and 7
 581+ A58C C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ A58D
 583+ A58D 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A58E C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A590 6F               ld l,a
 586+ A591 D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A592
 588+ A592 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A593 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A595 67               ld h,a
 591+ A596 C9               ret
 592+ A597
 593+ A597              ;----------------------------------------------------------------------------------------------------------------
 594+ A597              ;
 595+ A597              ;	5/08/22
 596+ A597              ;
 597+ A597              ;   PreviousScan.
 598+ A597              ;
