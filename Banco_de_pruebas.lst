 580+ C1F3
 581+ C1F3              ;   Init Burst_sound_efect.
 582+ C1F3
 583+ C1F3              ;   La explosión de Amadeus ha de ser más larga que la de las entidades.
 584+ C1F3
 585+ C1F3 26 35            ld h,Burst_sound_init_value
 586+ C1F5
 587+ C1F5 3A C8 90         ld a,(Impacto_Amadeus)
 588+ C1F8 A7               and a
 589+ C1F9 28 02            jr z,1F
 590+ C1FB
 591+ C1FB 26 75            ld h,Amadeus_Burst_sound_init_value
 592+ C1FD
 593+ C1FD 7C           1 ld a,h
 594+ C1FE
 595+ C1FE 32 6B 96         ld (Burst_sound),a
