 296  8CC2 00           Incrementa_puntero_backup db 0
 297  8CC3 00           Repetimos_desplazamiento db 0				; El nibble bajo del 3er byte que compone un desplazamiento, indica el nº de veces que_
 298  8CC4              ;																; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 299  8CC4
 300  8CC4 00           Repetimos_desplazamiento_backup db 0	; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 301  8CC5 00           Repetimos_movimiento db 0						; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 302  8CC6 00           Cola_de_desplazamiento db 0						; Este byte indica:
 303  8CC7
 304  8CC7              ;
 305  8CC7              ;																;	"$00" ..... Hemos finalizado la cadena de movimiento.
 306  8CC7              ;																;				En este caso hemos de incrementar (Puntero_indice_mov)_
 307  8CC7              ;																;				_ y pasar a la siguiente cadena de movimiento del índice.
 308  8CC7              ;
 309  8CC7              ;																;	"$01 - "$fe" ..... Repetición del movimiento.
 310  8CC7              ;																;						Nº de veces que vamos a repetir el movimiento completo.
 311  8CC7              ;																;						En este caso, volveremos a inicializar (Puntero_mov),_
 312  8CC7              ;																;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 313  8CC7              ;
 314  8CC7              ;																;	"$ff" ..... Bucle infinito de repetición.
 315  8CC7              ;																;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 316  8CC7              ;																;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 317  8CC7
 318  8CC7 00           Ctrl_1 db 0 												; Byte de control de propósito general.
 319  8CC8
 320  8CC8              ;																DESCRIPCIÓN:
 321  8CC8              ;
 322  8CC8              ;																BIT 0, La rutina de generación de disparos, [Genera_disparo], pone este bit a "1" para indicar a la_
 323  8CC8              ;																_ rutina [Genera_datos_de_impresion] que los datos a guardar pertenecen a un disparo y no a una entidad,_
 324  8CC8              ;																_ por lo tanto hemos de almacenarlos en `Scanlines_album_disparos´ en lugar de `Scanlines_album´.
 325  8CC8              ;																BIT 1, Este bit indica que el disparo sale de la pantalla, ($4000-$57ff).
 326  8CC8              ;																BIT 2, Este bit a "1" indica que un disparo de Amadeus ha alcanzado a una entidad. Como no sabemos cual,_
 327  8CC8              ;																_ hemos de comparar las coordenadas de (Coordenadas_disparo_certero) con las de cada entidad.
 328  8CC8
 329  8CC8              ;																BIT 3, Recarga de nueva oleada.
 330  8CC8              ;																BIT 4, Recarga de nueva oleada.
 331  8CC8              ;																BIT 5, FREEEEEEEEE !!!!!!!!!!!!!!!!!
 332  8CC8              ;																BIT 6, **** Frame completo.
 333  8CC8              ;																BIT 7, Indica que ya está tomada la foto de Amadeus. No tomaremos otra hasta el próximo FRAME.
 334  8CC8
 335  8CC8 00 00        Repone_puntero_objeto defw 0				; Almacena (Puntero_objeto). Cuando el Sprite se inicia por arriba o por abajo,_
 336  8CCA              ; 																; _ hay que sustituirlo por un `sprite vacío' para que no se vea el 1er o último scanline.
 337  8CCA              ; 																; _ Cuando hemos terminado de iniciarlo y guardado su foto, hemos de recuperar su (Puntero_objeto).
 338  8CCA              ;																; (Repone_puntero_objeto) es una copia de respaldo de (Puntero_objeto) y su función es restaurarlo.
