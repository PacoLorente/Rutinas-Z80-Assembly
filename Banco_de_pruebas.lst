 614+ A6F1
 615+ A6F1 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ A6F2 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ A6F4 6F               ld l,a
