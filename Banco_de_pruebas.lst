 456  9116              ;															BIT 1, (INVESTIGAR !!!)
 457  9116              ;															BIT 3, "1" Indica que se ha asignado un color RND a la entidad.
 458  9116              ; 																   _evita que se vuelva a asignar un nuevo color en la `segunda vuelta lenta?.
