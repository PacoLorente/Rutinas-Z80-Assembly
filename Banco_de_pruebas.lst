 395+ C323              ;       db 4                                                    ; N° de espacios que separan en pantalla la cadena de texto de la tecla definida.
 396+ C323              ;
 397+ C323              ;   Utilizaremos la variable: (Puntero_de_impresion) para guardar la posición del puntero indicial, (hl).
 398+ C323              ;   Nota: Antes de salir de la función restauraremos su valor a "$0000".
 399+ C323              ;
 400+ C323              ;   MODIFY: AF, HL, HL´, DE, DE´, BC, IX
 401+ C323              ;   OUTPUT: (Z), Set_1 (Ctrl_6).  Indica regreso al Menú Principal.
