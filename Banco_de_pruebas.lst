 752+ B5F4              ;	5/08/22
 753+ B5F4              ;
 754+ B5F4              ;   NextScan.
 755+ B5F4              ;
 756+ B5F4              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 757+ B5F4              ;
 758+ B5F4              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 759+ B5F4              ;
 760+ B5F4              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 761+ B5F4              ;
 762+ B5F4              ;       DESTRUIDOS: AF y HL !!!
 763+ B5F4              ;
 764+ B5F4              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 765+ B5F4              ;
 766+ B5F4
 767+ B5F4              NextScan:
 768+ B5F4
 769+ B5F4 24           	inc h          							; Incrementamos el scanline.
 770+ B5F5 7C               ld a,h
 771+ B5F6 E6 07            and 7
 772+ B5F8 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 773+ B5F9
 774+ B5F9 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 775+ B5FA C6 20            add a,$20           							; Vamos a comprobarlo...
 776+ B5FC 6F               ld l,a
 777+ B5FD D8               ret c               							; Salimos si se produce el cambio de tercio.
 778+ B5FE
 779+ B5FE 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 780+ B5FF D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 781+ B601 67               ld h,a
 782+ B602 C9               ret
 783+ B603
 784+ B603              NextScan_15:
 785+ B603
 786+ B603 06 0F        	ld b,15
 787+ B605 CD F4 B5     1 call NextScan
 788+ B608 10 FB        	djnz 1B
 789+ B60A
 790+ B60A C9           	ret
 791+ B60B
