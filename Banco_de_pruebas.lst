 856+ B5E1
 857+ B5E1 06 0F        	ld b,15
 858+ B5E3 CD D2 B5     1 call PreviousScan
 859+ B5E6 10 FB        	djnz 1B
 860+ B5E8
 861+ B5E8 C9           	ret
