   1+ A215              ; ******************************************************************************************************************************************************************************************
   2+ A215              ;
   3+ A215              ;   3/4/25
   4+ A215              ;
   5+ A215              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A215              ;   (XOR) bit a bit.
   7+ A215              ;
   8+ A215              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A215              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A215
  11+ A215              Derivando_RND
  12+ A215
  13+ A215 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A217 C5               push bc
  15+ A218              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A218 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A21B              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A21B
  19+ A21B A7           6 and a                                 ; Carry a "0".
  20+ A21C CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A21E 30 02            jr nc,1F
  22+ A220
  23+ A220 CB C1            set 0,c
  24+ A222
  25+ A222 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A223 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A225 5F               ld e,a
  28+ A226
  29+ A226 7A               ld a,d
  30+ A227 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A229 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A22B
  33+ A22B CB 3F            srl a
  34+ A22D
  35+ A22D AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A22E
  37+ A22E 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A22F 28 04            jr z,4F
  39+ A231
  40+ A231 CB FF            set 7,a
  41+ A233 18 02            jr 5F
  42+ A235
  43+ A235 CB BF        4 res 7,a
  44+ A237
  45+ A237 CB 21        5 sla c
  46+ A239 10 E0            djnz 6B
  47+ A23B
  48+ A23B 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A23C
  50+ A23C 77               ld (hl),a
  51+ A23D 23               inc hl
  52+ A23E C1               pop bc
  53+ A23F 10 D4            djnz 3B
  54+ A241
  55+ A241 C9               ret
  56+ A242
  57+ A242
  58+ A242
# file closed: RND_Derivando.asm
