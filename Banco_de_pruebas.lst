3096  A058              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A058              ; ******************************************************************************************************************************************************************************************
   2+ A058              ;
   3+ A058              ;   3/4/25
   4+ A058              ;
   5+ A058              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A058              ;   (XOR) bit a bit.
   7+ A058              ;
   8+ A058              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A058              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A058
  11+ A058              Derivando_RND
  12+ A058
  13+ A058 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A05A C5               push bc
  15+ A05B              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A05B 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A05E              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A05E
  19+ A05E A7           6 and a                                 ; Carry a "0".
  20+ A05F CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A061 30 02            jr nc,1F
  22+ A063
  23+ A063 CB C1            set 0,c
  24+ A065
  25+ A065 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A066 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A068 5F               ld e,a
  28+ A069
  29+ A069 7A               ld a,d
  30+ A06A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A06C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A06E
  33+ A06E CB 3F            srl a
  34+ A070
  35+ A070 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A071
  37+ A071 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A072 28 04            jr z,4F
  39+ A074
  40+ A074 CB FF            set 7,a
  41+ A076 18 02            jr 5F
  42+ A078
  43+ A078 CB BF        4 res 7,a
  44+ A07A
  45+ A07A CB 21        5 sla c
  46+ A07C 10 E0            djnz 6B
  47+ A07E
  48+ A07E 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A07F
  50+ A07F 77               ld (hl),a
  51+ A080 23               inc hl
  52+ A081 C1               pop bc
  53+ A082 10 D4            djnz 3B
  54+ A084
  55+ A084 C9               ret
  56+ A085
  57+ A085
  58+ A085
# file closed: RND_Derivando.asm
