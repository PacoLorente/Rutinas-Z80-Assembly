 614+ A6B0
 615+ A6B0 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ A6B1 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ A6B3 6F               ld l,a
