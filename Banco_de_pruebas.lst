2810  C008              	include "Sound.asm"
# file opened: Sound.asm
   1+ C008              ; ----------------------------------------------------------
   2+ C008              ;
   3+ C008              ;   26/09/26
   4+ C008              ;
   5+ C008              ;   Voy a utilizar los 6 bytes de las variables:
   6+ C008              ;
   7+ C008              ;   (Indice_Sprite_der)
   8+ C008              ;   (Indice_Sprite_izq)
   9+ C008              ;   (Puntero_DESPLZ_der)
  10+ C008              ;
  11+ C008              ;   Para almacenar el perfil de la nota que está en ejecución pues la rutina se ejecuta "IN GAME TIME" y sólo reproducirá 4 ondas_
  12+ C008              ;   _del total que forman la nota.
  13+ C008              ;
  14+ C008              ;   La rutina genera un "ruido" o especie de zumbido ascendente/descendente llamando a la rutina [Sound_Generator].
  15+ C008              ;   La melodía consta de dos notas incluidas en el índice: "Game_over_noise_index:". El puntero (Puntero_game_over_noise) avanza_
  16+ C008              ;   _ por el índice proporcionando los datos de las notas a la rutina.
  17+ C008              ;
  18+ C008              ;   La rutina [Sound_Generator] requiere que los parámetros de la nota a ejecutar se den de la siguiente forma:
  19+ C008              ;
