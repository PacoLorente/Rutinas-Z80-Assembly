   3+ A51A              ;
   4+ A51A              ;	CLS.
   5+ A51A              ;
   6+ A51A              ;	Limpia la pantalla y define sus atributos.
   7+ A51A              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A51A              ;
   9+ A51A              ;	COLORES: 0 ..... NEGRO
  10+ A51A              ;    		 1 ..... AZUL
  11+ A51A              ; 			 2 ..... ROJO
  12+ A51A              ;			 3 ..... MAGENTA
  13+ A51A              ; 			 4 ..... VERDE
  14+ A51A              ; 			 5 ..... CIAN
  15+ A51A              ;			 6 ..... AMARILLO
  16+ A51A              ; 			 7 ..... BLANCO
  17+ A51A              ;
  18+ A51A              ;	INPUT: A contiene los atributos de pantalla.
  19+ A51A              ;
  20+ A51A              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A51A
  22+ A51A
  23+ A51A 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A51D 11 01 40     	LD DE,$4001
  25+ A520 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A523 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A525 ED B0        	LDIR
  28+ A527 01 FF 02     	LD BC,767
  29+ A52A 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A52B ED B0        	LDIR
  31+ A52D
  32+ A52D AF           	xor a
  33+ A52E
  34+ A52E C9           	ret
  35+ A52F
