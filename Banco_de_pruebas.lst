   1+ 9460              ; ******************************************************************************************************************************************************************************************
   2+ 9460              ;
   3+ 9460              ;   21/04/24
   4+ 9460              ;
   5+ 9460              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9460              ;   (XOR) bit a bit.
   7+ 9460              ;
   8+ 9460              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9460
  10+ 9460              Derivando_RND
  11+ 9460
  12+ 9460 21 F6 88         ld hl,Numeros_aleatorios
  13+ 9463
  14+ 9463 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 9465 C5               push bc
  16+ 9466              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 9466 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9469              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9469
  20+ 9469 A7           6 and a                                 ; Carry a "0".
  21+ 946A CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 946C 30 02            jr nc,1F
  23+ 946E
  24+ 946E CB C1            set 0,c
  25+ 9470
  26+ 9470 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9471 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 9473 5F               ld e,a
  29+ 9474
  30+ 9474 7A               ld a,d
  31+ 9475 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 9477 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9479
  34+ 9479 CB 3F            srl a
  35+ 947B
  36+ 947B AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 947C
  38+ 947C 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 947D 28 04            jr z,4F
  40+ 947F
  41+ 947F CB FF            set 7,a
  42+ 9481 18 02            jr 5F
  43+ 9483
  44+ 9483 CB BF        4 res 7,a
  45+ 9485
  46+ 9485 CB 21        5 sla c
  47+ 9487 10 E0            djnz 6B
  48+ 9489
  49+ 9489 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 948A
  51+ 948A 77               ld (hl),a
  52+ 948B 23               inc hl
  53+ 948C C1               pop bc
