 378+ C34D              ;   Move_RIGHT_ASCII_CODE db "2"
 379+ C34D              ;   ds 5
 380+ C34D              ;   Move_FIRE_ASCII_CODE db "5"
 381+ C34D              ;   ds 5
 382+ C34D              ;   Move_SHIELD_ASCII_CODE db "SPACE"
 383+ C34D              ;   ds 1
 384+ C34D              ;
 385+ C34D              ;   Hemos creado una tabla de punteros con los .defw que contienen los datos necesarios para definir e imprimir_
 386+ C34D              ;   _ cada uno de los 4 controles.
 387+ C34D              ;
 388+ C34D              ;   Los datos son los siguientes:
 389+ C34D              ;
 390+ C34D              ;   Left_key_parameters: defw b1                                ; Cadena de texto: "LEFT".
 391+ C34D              ;       defw Line_12 + 12                                       ; Dirección de pantalla, Fila 12, columna 12.
 392+ C34D              ;       defw Move_LEFT
 393+ C34D              ;       defw Move_LEFT_ASCII_CODE
 394+ C34D              ;       db 4                                                    ; N° de chars. que forman la cadena de texto "LEFT".
 395+ C34D              ;       db 4                                                    ; N° de espacios que separan en pantalla la cadena de texto de la tecla definida.
 396+ C34D              ;
 397+ C34D              ;   Utilizaremos la variable: (Puntero_de_impresion) para guardar la posición del puntero indicial, (hl).
 398+ C34D              ;   Nota: Antes de salir de la función restauraremos su valor a "$0000".
 399+ C34D              ;
 400+ C34D              ;   MODIFY: AF, HL, HL´, DE, DE´, BC, IX
 401+ C34D              ;   OUTPUT: (Z), Set_1 (Ctrl_6).  Indica regreso al Menú Principal.
