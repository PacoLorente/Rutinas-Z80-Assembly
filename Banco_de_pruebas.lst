 797+ AFC6              ;   26/10/26
 798+ AFC6              ;
 799+ AFC6              ;   Pinta un sprite de Amadeus en la parte superior izquierda de la pantalla. IT's a LIFE !!!
 800+ AFC6              ;
 801+ AFC6              ;   Los datos de pintado de la vida vienen dados por la tabla:
 802+ AFC6              ;
 803+ AFC6              ;   Tabla_marcador_de_vidas:
 804+ AFC6              ;
 805+ AFC6              ;	defw Vida_1,Amadeus       							; (Puntero_de_impresion), (Puntero_objeto)
 806+ AFC6              ;	defw Vida_2,Amadeus_Fb
 807+ AFC6              ;	defw Vida_3,Amadeus
 808+ AFC6              ;
 809+ AFC6              ;   (Puntero_de_vidas) almacenará el puntero SP que será el encargado de ir desplazandose por la tabla abasteciendo de datos_
 810+ AFC6              ;   _ a los registros HL y DE:
 811+ AFC6              ;
 812+ AFC6              ;    pop hl                                             ; Dirección de pantalla donde se imprime Vida_X, (Puntero_de_impresion).
 813+ AFC6              ;    pop de                                             ; Dirección de memoria donde se encuentran los .db que componen Amadeus, (Puntero_objeto).
 814+ AFC6              ;
 815+ AFC6              ;   Al ser el n° de (Columnas/Filas) una constante, ($0302) lo cargamos directamente en el par de registros (BC).
 816+ AFC6              ;   Los attrs. serían la 2a constante que será almacenada en (A).
 817+ AFC6              ;
 818+ AFC6              ;   Con estos datos, la rutina [Pinta_imagen] imprimirá la imagen en la parte superior izquierda de la pantalla.
 819+ AFC6              ;
 820+ AFC6              ;   MODIFY: A,HL,BC y DE
 821+ AFC6              ;           (Puntero_de_vidas)
 822+ AFC6
 823+ AFC6              Pinta_Vida:
 824+ AFC6
 825+ AFC6 ED 73 B0 95      ld (Stack),sp                                       ; Guarda el vector (SP).
 826+ AFCA ED 7B 1E 96      ld sp,(Puntero_de_vidas)                            ; Utilizaremos el puntero SP para extraer la información de la ((Tabla_marcador_de_vidas))_
 827+ AFCE              ;                                                       ; _ y abastecer REGs.
 828+ AFCE
 829+ AFCE E1               pop hl                                              ; Dirección de pantalla donde se imprime Vida_X, (Puntero_de_impresion).
 830+ AFCF D1               pop de                                              ; Dirección de memoria donde se encuentran los .db que componen Amadeus, (Puntero_objeto).
 831+ AFD0
 832+ AFD0 ED 73 1E 96      ld (Puntero_de_vidas),sp                            ; Sitúa (Puntero_de_vidas) en los datos de la tabla de la siguiente vida.
 833+ AFD4
 834+ AFD4 ED 7B B0 95      ld sp,(Stack)                                       ; Recupera la dirección que contenía el vector SP.
 835+ AFD8
 836+ AFD8 3E 45            ld a,%01000101                                      ; Attrs.: BRIGHT, BLACK PAPER, CYAN INK.
 837+ AFDA
 838+ AFDA 01 02 03         ld bc,$0302                                         ; (Columnas/Filas )
 839+ AFDD
 840+ AFDD CD C2 9E         call Pinta_imagen   ; v2. Ok.                       ; Imprime AMADEUS.
 841+ AFE0
 842+ AFE0 C9               ret
