  15+ 9ECB              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9ECB 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9ECE              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9ECE
  19+ 9ECE A7           6 and a                                 ; Carry a "0".
  20+ 9ECF CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9ED1 30 02            jr nc,1F
  22+ 9ED3
  23+ 9ED3 CB C1            set 0,c
  24+ 9ED5
  25+ 9ED5 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9ED6 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9ED8 5F               ld e,a
  28+ 9ED9
  29+ 9ED9 7A               ld a,d
  30+ 9EDA E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9EDC 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9EDE
  33+ 9EDE CB 3F            srl a
  34+ 9EE0
  35+ 9EE0 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9EE1
  37+ 9EE1 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9EE2 28 04            jr z,4F
  39+ 9EE4
  40+ 9EE4 CB FF            set 7,a
  41+ 9EE6 18 02            jr 5F
  42+ 9EE8
  43+ 9EE8 CB BF        4 res 7,a
  44+ 9EEA
  45+ 9EEA CB 21        5 sla c
  46+ 9EEC 10 E0            djnz 6B
  47+ 9EEE
  48+ 9EEE 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9EEF
  50+ 9EEF 77               ld (hl),a
  51+ 9EF0 23               inc hl
  52+ 9EF1 C1               pop bc
  53+ 9EF2 10 D4            djnz 3B
