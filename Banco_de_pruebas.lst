 584+ ADF9 C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ ADFB 6F               ld l,a
 586+ ADFC D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ ADFD
 588+ ADFD 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ ADFE D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
