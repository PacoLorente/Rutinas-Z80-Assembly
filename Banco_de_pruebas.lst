 613+ BF9A              ;
 614+ BF9A
 615+ BF9A              NextScan:
 616+ BF9A
 617+ BF9A 24           	inc h          							; Incrementamos el scanline.
 618+ BF9B 7C               ld a,h
 619+ BF9C E6 07            and 7
 620+ BF9E C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 621+ BF9F
 622+ BF9F 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 623+ BFA0 C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ BFA2 6F               ld l,a
 625+ BFA3 D8               ret c               							; Salimos si se produce el cambio de tercio.
 626+ BFA4
 627+ BFA4 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 628+ BFA5 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 629+ BFA7 67               ld h,a
 630+ BFA8 C9               ret
