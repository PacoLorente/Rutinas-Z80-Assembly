 440  949C              ;															  _palabras que componen el "movimiento_masticado".
 441  949C
 442  949C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 443  949C
 444  949C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 445  949D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 446  949D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 447  949D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 448  949D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 449  949D
 450  949D 00           Attr db 0 													; Atributos de la entidad.
