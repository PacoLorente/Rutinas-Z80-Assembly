   5+ 9BEE              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9BEE              ;   (XOR) bit a bit.
   7+ 9BEE              ;
   8+ 9BEE              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9BEE              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9BEE
  11+ 9BEE              Derivando_RND
  12+ 9BEE
  13+ 9BEE ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9BF0 C5               push bc
  15+ 9BF1              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9BF1 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9BF4              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9BF4
  19+ 9BF4 A7           6 and a                                 ; Carry a "0".
  20+ 9BF5 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9BF7 30 02            jr nc,1F
  22+ 9BF9
  23+ 9BF9 CB C1            set 0,c
  24+ 9BFB
  25+ 9BFB 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9BFC E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9BFE 5F               ld e,a
  28+ 9BFF
  29+ 9BFF 7A               ld a,d
  30+ 9C00 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9C02 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9C04
  33+ 9C04 CB 3F            srl a
  34+ 9C06
  35+ 9C06 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9C07
  37+ 9C07 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9C08 28 04            jr z,4F
  39+ 9C0A
  40+ 9C0A CB FF            set 7,a
  41+ 9C0C 18 02            jr 5F
  42+ 9C0E
  43+ 9C0E CB BF        4 res 7,a
  44+ 9C10
  45+ 9C10 CB 21        5 sla c
  46+ 9C12 10 E0            djnz 6B
  47+ 9C14
  48+ 9C14 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9C15
  50+ 9C15 77               ld (hl),a
  51+ 9C16 23               inc hl
  52+ 9C17 C1               pop bc
  53+ 9C18 10 D4            djnz 3B
