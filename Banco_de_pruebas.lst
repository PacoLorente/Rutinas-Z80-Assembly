 496+ 9EE1
 497+ 9EE1 23               inc hl                                  ;   Siguiente caracter a imprimir.
 498+ 9EE2
 499+ 9EE2 34               inc (hl)
 500+ 9EE3 35               dec (hl)
 501+ 9EE4
 502+ 9EE4 28 24            jr z,Exit_01                            ;   RET, fin de msg.
 503+ 9EE6
 504+ 9EE6 1C               inc e                                   ;   Siguiente columna de pantalla.
 505+ 9EE7
 506+ 9EE7 C1               pop bc                                  ;   Carga el temporizador en B.
 507+ 9EE8
 508+ 9EE8 04               inc b
 509+ 9EE9 05               dec b
 510+ 9EEA
