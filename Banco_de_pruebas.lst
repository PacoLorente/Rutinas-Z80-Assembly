   1+ A0C4              ; ******************************************************************************************************************************************************************************************
   2+ A0C4              ;
   3+ A0C4              ;   3/4/25
   4+ A0C4              ;
   5+ A0C4              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A0C4              ;   (XOR) bit a bit.
   7+ A0C4              ;
   8+ A0C4              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A0C4              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A0C4
  11+ A0C4              Derivando_RND
  12+ A0C4
  13+ A0C4 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A0C6 C5               push bc
  15+ A0C7              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A0C7 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A0CA              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A0CA
  19+ A0CA A7           6 and a                                 ; Carry a "0".
  20+ A0CB CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A0CD 30 02            jr nc,1F
  22+ A0CF
  23+ A0CF CB C1            set 0,c
  24+ A0D1
  25+ A0D1 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A0D2 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A0D4 5F               ld e,a
  28+ A0D5
  29+ A0D5 7A               ld a,d
  30+ A0D6 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A0D8 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A0DA
  33+ A0DA CB 3F            srl a
  34+ A0DC
  35+ A0DC AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A0DD
  37+ A0DD 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A0DE 28 04            jr z,4F
  39+ A0E0
  40+ A0E0 CB FF            set 7,a
  41+ A0E2 18 02            jr 5F
  42+ A0E4
  43+ A0E4 CB BF        4 res 7,a
  44+ A0E6
  45+ A0E6 CB 21        5 sla c
  46+ A0E8 10 E0            djnz 6B
  47+ A0EA
  48+ A0EA 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A0EB
  50+ A0EB 77               ld (hl),a
  51+ A0EC 23               inc hl
  52+ A0ED C1               pop bc
  53+ A0EE 10 D4            djnz 3B
  54+ A0F0
  55+ A0F0 C9               ret
  56+ A0F1
  57+ A0F1
  58+ A0F1
# file closed: RND_Derivando.asm
