   2+ 9428              ;
   3+ 9428              ;   21/04/24
   4+ 9428              ;
   5+ 9428              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9428              ;   (XOR) bit a bit.
   7+ 9428              ;
   8+ 9428              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9428
  10+ 9428              Derivando_RND
  11+ 9428
  12+ 9428 21 F6 88         ld hl,Numeros_aleatorios
  13+ 942B
  14+ 942B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 942D C5               push bc
  16+ 942E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 942E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9431              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9431
  20+ 9431 A7           6 and a                                 ; Carry a "0".
  21+ 9432 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9434 30 02            jr nc,1F
  23+ 9436
  24+ 9436 CB C1            set 0,c
  25+ 9438
  26+ 9438 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9439 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 943B 5F               ld e,a
  29+ 943C
  30+ 943C 7A               ld a,d
  31+ 943D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 943F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9441
  34+ 9441 CB 3F            srl a
  35+ 9443
  36+ 9443 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9444
  38+ 9444 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9445 28 04            jr z,4F
  40+ 9447
  41+ 9447 CB FF            set 7,a
  42+ 9449 18 02            jr 5F
  43+ 944B
  44+ 944B CB BF        4 res 7,a
  45+ 944D
  46+ 944D CB 21        5 sla c
  47+ 944F 10 E0            djnz 6B
  48+ 9451
  49+ 9451 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9452
  51+ 9452 77               ld (hl),a
  52+ 9453 23               inc hl
  53+ 9454 C1               pop bc
  54+ 9455 10 D4            djnz 3B
  55+ 9457
  56+ 9457 C9               ret
  57+ 9458
  58+ 9458
  59+ 9458
