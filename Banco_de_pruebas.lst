 623+ B5A2 C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ B5A4 6F               ld l,a
 625+ B5A5 D8               ret c               							; Salimos si se produce el cambio de tercio.
 626+ B5A6
 627+ B5A6 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 628+ B5A7 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 629+ B5A9 67               ld h,a
 630+ B5AA C9               ret
