 598+ B1E1              ;
 599+ B1E1              ;   Calcula la dirección de mem. de pantalla donde se sitúa el scanline anterior. (Dec H, línea arriba).
 600+ B1E1              ;
 601+ B1E1              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ B1E1              ;
 603+ B1E1              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ B1E1              ;
 605+ B1E1              ;       DESTRUIDOS: AF y HL !!!
 606+ B1E1              ;
 607+ B1E1              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ B1E1              ;
 609+ B1E1
 610+ B1E1 7C           PreviousScan ld a,h
 611+ B1E2 25               dec h               							; Dec H.
 612+ B1E3 E6 07            and 7
 613+ B1E5 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ B1E6
 615+ B1E6 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ B1E7 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ B1E9 6F               ld l,a
 618+ B1EA D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ B1EB
 620+ B1EB 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ B1EC C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ B1EE 67               ld h,a
 623+ B1EF C9               ret
