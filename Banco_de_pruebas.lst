 398+ A326              ;	En 1er lugar cargaremos la bandeja DRAW con la definición de esta (Clase) de entidad para poder generar todos los movimientos masticados.
 399+ A326
 400+ A326 79           	ld a,c 															; (A) = (Clase).
 401+ A327 32 B7 93     	ld (Clase),a 													; (Clase) de la entidad en la Bandeja Draw. La definición de la entidad no contiene (Clase).
 402+ A32A
 403+ A32A CD 1F A6     	call Definicion_segun_tipo										; HL apunta al 1er .db que define la entidad.
 404+ A32D CD B1 A6     	call Definicion_de_entidad_a_bandeja_DRAW						; Vuelca los datos de la definición de entidad en DRAW.
