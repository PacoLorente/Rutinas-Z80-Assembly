 637  942C 00 00        Puntero_mov defw 0											; Guarda la posición de memoria en la que nos encontramos dentro de la cadena de movimiento.
 638  942E 00 00        Puntero_indice_mov_bucle defw 0
 639  9430              ;
 640  9430              ;
 641  9430 00           Incrementa_puntero db 0										; Byte que iremos sumando a (Puntero_indice_mov) para ir escalando por las_
 642  9431              ;															; _ distintas cadenas de movimiento del índice de movimiento de la entidad._
