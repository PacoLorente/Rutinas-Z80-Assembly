  12+ 9D73
  13+ 9D73 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D75 C5               push bc
  15+ 9D76              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D76 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D79              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D79
  19+ 9D79 A7           6 and a                                 ; Carry a "0".
  20+ 9D7A CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D7C 30 02            jr nc,1F
  22+ 9D7E
  23+ 9D7E CB C1            set 0,c
  24+ 9D80
  25+ 9D80 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D81 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D83 5F               ld e,a
  28+ 9D84
  29+ 9D84 7A               ld a,d
  30+ 9D85 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D87 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D89
  33+ 9D89 CB 3F            srl a
  34+ 9D8B
  35+ 9D8B AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D8C
  37+ 9D8C 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D8D 28 04            jr z,4F
  39+ 9D8F
  40+ 9D8F CB FF            set 7,a
  41+ 9D91 18 02            jr 5F
  42+ 9D93
  43+ 9D93 CB BF        4 res 7,a
  44+ 9D95
  45+ 9D95 CB 21        5 sla c
  46+ 9D97 10 E0            djnz 6B
  47+ 9D99
  48+ 9D99 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D9A
  50+ 9D9A 77               ld (hl),a
  51+ 9D9B 23               inc hl
  52+ 9D9C C1               pop bc
