 590+ B4E9
 591+ B4E9 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 592+ B4EA C6 20            add a,$20           							; Vamos a comprobarlo...
 593+ B4EC 6F               ld l,a
 594+ B4ED D8               ret c               							; Salimos si se produce el cambio de tercio.
 595+ B4EE
 596+ B4EE 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 597+ B4EF D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 598+ B4F1 67               ld h,a
 599+ B4F2 C9               ret
