   5+ 9966              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9966              ;   (XOR) bit a bit.
   7+ 9966              ;
   8+ 9966              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9966              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9966
  11+ 9966              Derivando_RND
  12+ 9966
  13+ 9966 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9968 C5               push bc
  15+ 9969              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9969 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 996C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 996C
  19+ 996C A7           6 and a                                 ; Carry a "0".
  20+ 996D CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 996F 30 02            jr nc,1F
  22+ 9971
  23+ 9971 CB C1            set 0,c
  24+ 9973
  25+ 9973 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9974 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9976 5F               ld e,a
  28+ 9977
  29+ 9977 7A               ld a,d
  30+ 9978 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 997A 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 997C
  33+ 997C CB 3F            srl a
  34+ 997E
  35+ 997E AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 997F
  37+ 997F 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9980 28 04            jr z,4F
  39+ 9982
  40+ 9982 CB FF            set 7,a
  41+ 9984 18 02            jr 5F
  42+ 9986
  43+ 9986 CB BF        4 res 7,a
  44+ 9988
  45+ 9988 CB 21        5 sla c
  46+ 998A 10 E0            djnz 6B
  47+ 998C
  48+ 998C 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 998D
  50+ 998D 77               ld (hl),a
  51+ 998E 23               inc hl
  52+ 998F C1               pop bc
  53+ 9990 10 D4            djnz 3B
  54+ 9992
  55+ 9992 C9               ret
