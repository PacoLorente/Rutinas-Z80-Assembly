   5+ 93D4              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93D4              ;   (XOR) bit a bit.
   7+ 93D4              ;
   8+ 93D4              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93D4
  10+ 93D4              Derivando_RND
  11+ 93D4
  12+ 93D4 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93D7
  14+ 93D7 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93D9 C5               push bc
  16+ 93DA              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93DA 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 93DD              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 93DD
  20+ 93DD A7           6 and a                                 ; Carry a "0".
  21+ 93DE CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 93E0 30 02            jr nc,1F
  23+ 93E2
  24+ 93E2 CB C1            set 0,c
  25+ 93E4
  26+ 93E4 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 93E5 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 93E7 5F               ld e,a
  29+ 93E8
  30+ 93E8 7A               ld a,d
  31+ 93E9 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 93EB 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 93ED
  34+ 93ED CB 3F            srl a
  35+ 93EF
  36+ 93EF AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 93F0
  38+ 93F0 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 93F1 28 04            jr z,4F
  40+ 93F3
  41+ 93F3 CB FF            set 7,a
  42+ 93F5 18 02            jr 5F
  43+ 93F7
  44+ 93F7 CB BF        4 res 7,a
  45+ 93F9
  46+ 93F9 CB 21        5 sla c
  47+ 93FB 10 E0            djnz 6B
  48+ 93FD
  49+ 93FD 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 93FE
  51+ 93FE 77               ld (hl),a
  52+ 93FF 23               inc hl
  53+ 9400 C1               pop bc
  54+ 9401 10 D4            djnz 3B
  55+ 9403
  56+ 9403 C9               ret
