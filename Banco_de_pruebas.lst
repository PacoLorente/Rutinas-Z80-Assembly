   1+ A18C              ; *********************************** Limpia la pantalla, CLEAR SCREEN ****************************************************************
   2+ A18C              ;
   3+ A18C              ;
   4+ A18C              ;	CLS.
   5+ A18C              ;
   6+ A18C              ;	Limpia la pantalla y define sus atributos.
   7+ A18C              ;	El formato: FBPPPIII (Flash, Brillo, Papel, Tinta).
   8+ A18C              ;
   9+ A18C              ;	COLORES: 0 ..... NEGRO
  10+ A18C              ;    		 1 ..... AZUL
  11+ A18C              ; 			 2 ..... ROJO
  12+ A18C              ;			 3 ..... MAGENTA
  13+ A18C              ; 			 4 ..... VERDE
  14+ A18C              ; 			 5 ..... CIAN
  15+ A18C              ;			 6 ..... AMARILLO
  16+ A18C              ; 			 7 ..... BLANCO
  17+ A18C              ;
  18+ A18C              ;	INPUT: A contiene los atributos de pantalla.
  19+ A18C              ;
  20+ A18C              ;	DESTRUIDOS: F,BC,DE,HL !!!!!
  21+ A18C
  22+ A18C
  23+ A18C 21 00 40     Cls LD HL,$4000											; HL => Comienzo de pantalla.
  24+ A18F 11 01 40     	LD DE,$4001
  25+ A192 01 00 18     	LD BC,6144											; Tamaño de la pantalla, $17ff
  26+ A195 36 00        	LD (HL),0 											; Ponemos a "0" todos los pixels de la pantalla.
  27+ A197 ED B0        	LDIR
  28+ A199 01 FF 02     	LD BC,767
  29+ A19C 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A19D ED B0        	LDIR
  31+ A19F
  32+ A19F AF           	xor a
  33+ A1A0
  34+ A1A0 C9           	ret
  35+ A1A1
