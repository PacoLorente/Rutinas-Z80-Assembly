 333  92A8 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 334  92A9              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 335  92A9              ;
 336  92A9              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
