   4+ 99BE              ;
   5+ 99BE              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 99BE              ;   (XOR) bit a bit.
   7+ 99BE              ;
   8+ 99BE              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 99BE              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 99BE
  11+ 99BE              Derivando_RND
  12+ 99BE
  13+ 99BE ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 99C0 C5               push bc
  15+ 99C1              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 99C1 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 99C4              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 99C4
  19+ 99C4 A7           6 and a                                 ; Carry a "0".
  20+ 99C5 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 99C7 30 02            jr nc,1F
  22+ 99C9
  23+ 99C9 CB C1            set 0,c
  24+ 99CB
  25+ 99CB 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 99CC E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 99CE 5F               ld e,a
  28+ 99CF
  29+ 99CF 7A               ld a,d
  30+ 99D0 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 99D2 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 99D4
  33+ 99D4 CB 3F            srl a
  34+ 99D6
  35+ 99D6 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 99D7
  37+ 99D7 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 99D8 28 04            jr z,4F
  39+ 99DA
  40+ 99DA CB FF            set 7,a
  41+ 99DC 18 02            jr 5F
  42+ 99DE
  43+ 99DE CB BF        4 res 7,a
  44+ 99E0
  45+ 99E0 CB 21        5 sla c
  46+ 99E2 10 E0            djnz 6B
  47+ 99E4
  48+ 99E4 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 99E5
  50+ 99E5 77               ld (hl),a
  51+ 99E6 23               inc hl
  52+ 99E7 C1               pop bc
  53+ 99E8 10 D4            djnz 3B
  54+ 99EA
  55+ 99EA C9               ret
  56+ 99EB
  57+ 99EB
  58+ 99EB
