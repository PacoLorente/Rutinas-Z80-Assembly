3095  A04A              	include "RND_Derivando.asm"
# file opened: RND_Derivando.asm
   1+ A04A              ; ******************************************************************************************************************************************************************************************
   2+ A04A              ;
   3+ A04A              ;   3/4/25
   4+ A04A              ;
   5+ A04A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A04A              ;   (XOR) bit a bit.
   7+ A04A              ;
   8+ A04A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A04A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A04A
  11+ A04A              Derivando_RND
  12+ A04A
  13+ A04A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A04C C5               push bc
  15+ A04D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A04D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A050              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A050
  19+ A050 A7           6 and a                                 ; Carry a "0".
  20+ A051 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A053 30 02            jr nc,1F
  22+ A055
  23+ A055 CB C1            set 0,c
  24+ A057
  25+ A057 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A058 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A05A 5F               ld e,a
  28+ A05B
  29+ A05B 7A               ld a,d
  30+ A05C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A05E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A060
  33+ A060 CB 3F            srl a
  34+ A062
  35+ A062 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A063
  37+ A063 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A064 28 04            jr z,4F
  39+ A066
  40+ A066 CB FF            set 7,a
  41+ A068 18 02            jr 5F
  42+ A06A
  43+ A06A CB BF        4 res 7,a
  44+ A06C
  45+ A06C CB 21        5 sla c
  46+ A06E 10 E0            djnz 6B
  47+ A070
  48+ A070 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A071
  50+ A071 77               ld (hl),a
  51+ A072 23               inc hl
  52+ A073 C1               pop bc
  53+ A074 10 D4            djnz 3B
  54+ A076
  55+ A076 C9               ret
  56+ A077
  57+ A077
  58+ A077
# file closed: RND_Derivando.asm
