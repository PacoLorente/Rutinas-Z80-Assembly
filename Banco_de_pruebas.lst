   4+ 9D36              ;
   5+ 9D36              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D36              ;   (XOR) bit a bit.
   7+ 9D36              ;
   8+ 9D36              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D36              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D36
  11+ 9D36              Derivando_RND
  12+ 9D36
  13+ 9D36 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D38 C5               push bc
  15+ 9D39              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D39 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D3C              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D3C
  19+ 9D3C A7           6 and a                                 ; Carry a "0".
  20+ 9D3D CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D3F 30 02            jr nc,1F
  22+ 9D41
  23+ 9D41 CB C1            set 0,c
  24+ 9D43
  25+ 9D43 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D44 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D46 5F               ld e,a
  28+ 9D47
  29+ 9D47 7A               ld a,d
  30+ 9D48 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D4A 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D4C
  33+ 9D4C CB 3F            srl a
  34+ 9D4E
  35+ 9D4E AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D4F
  37+ 9D4F 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D50 28 04            jr z,4F
  39+ 9D52
  40+ 9D52 CB FF            set 7,a
  41+ 9D54 18 02            jr 5F
  42+ 9D56
  43+ 9D56 CB BF        4 res 7,a
  44+ 9D58
  45+ 9D58 CB 21        5 sla c
  46+ 9D5A 10 E0            djnz 6B
  47+ 9D5C
  48+ 9D5C 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D5D
  50+ 9D5D 77               ld (hl),a
  51+ 9D5E 23               inc hl
  52+ 9D5F C1               pop bc
  53+ 9D60 10 D4            djnz 3B
