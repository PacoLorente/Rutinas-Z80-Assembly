 447+ A3A7
 448+ A3A7 CD 29 A7     	call Parametros_de_bandeja_DRAW_a_Caja_Master	 				; Caja de entidades Master completa.
 449+ A3AA
 450+ A3AA              ;	Limpiamos la bandeja_DRAW y las variables de movimiento para poder generar los mov. masticados_
 451+ A3AA              ;	_de otro (Tipo) de entidad.
 452+ A3AA              ;
 453+ A3AA              ;	Limpiamos bandeja y variables.
 454+ A3AA
 455+ A3AA AF           	xor a
 456+ A3AB 32 4C 94     	ld (Ctrl_3),a 													; (Ctrl_3) ha de inicializarse pués lo utilizamos para indicar_
 457+ A3AE              ;																	; _, (entre otras cosas) cuando finalizamos de generar los mov. masticados.
 458+ A3AE 21 D9 93     	ld hl,Clase
 459+ A3B1 01 3A 00     	ld bc,Gestion_de_ENTIDADES_y_CAJAS-Bandeja_DRAW
 460+ A3B4
 461+ A3B4 0B           	dec bc
 462+ A3B5
 463+ A3B5 CD 44 9E     	call Clean_mem
