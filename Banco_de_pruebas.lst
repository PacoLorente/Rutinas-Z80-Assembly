  27+ A35F ED B0        	LDIR
  28+ A361 01 FF 02     	LD BC,767
  29+ A364 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A365 ED B0        	LDIR
  31+ A367
  32+ A367 AF           	xor a
  33+ A368
  34+ A368 C9           	ret
  35+ A369
