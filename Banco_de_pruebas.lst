  28+ A4FE 01 FF 02     	LD BC,767
  29+ A501 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A502 ED B0        	LDIR
  31+ A504
  32+ A504 AF           	xor a
  33+ A505
  34+ A505 C9           	ret
  35+ A506
