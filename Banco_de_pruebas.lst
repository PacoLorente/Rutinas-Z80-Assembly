 724+ AFF7 08               ex af,af
 725+ AFF8
 726+ AFF8 0E 47            ld c,%01000111         ; (Attr). de los disparos.
 727+ AFFA
 728+ AFFA 06 07        3 ld b,7                           ; Nº máximo de disparos. Fuerza la salida del album cuando hemos pintado 7 veces_
 729+ AFFC              ;                                      _ aunque IYL+IYH+E no sea "0". (No hay separacíon entre el álbum de borrado y el de pintado).
 730+ AFFC              ;                                      _ No encontraría "0".
