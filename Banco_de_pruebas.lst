 575+ A5C6              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ A5C6              ;
 577+ A5C6
 578+ A5C6 24           NextScan inc h          							; Incrementamos el scanline.
 579+ A5C7 7C               ld a,h
 580+ A5C8 E6 07            and 7
 581+ A5CA C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ A5CB
 583+ A5CB 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A5CC C6 20            add a,$20           							; Vamos a comprobarlo...
 585+ A5CE 6F               ld l,a
 586+ A5CF D8               ret c               							; Salimos si se produce el cambio de tercio.
 587+ A5D0
 588+ A5D0 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 589+ A5D1 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 590+ A5D3 67               ld h,a
 591+ A5D4 C9               ret
