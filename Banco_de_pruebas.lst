 320+ AB5E              ;   1er Tercio de pantalla !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 321+ AB5E
 322+ AB5E 7D               ld a,l
 323+ AB5F FE 20            cp $20
 324+ AB61 38 39            jr c,No_scanlines                               ; Empezamos a generar scanlines a partir del segundo scanline de la 2ª fila de pantalla. (En la dirección $4120 se generaría 1 scan.).
 325+ AB63
 326+ AB63 7D               ld a,l
 327+ AB64 FE 60            cp $60
 328+ AB66 30 3D            jr nc,Completo_o_desapareciendo
 329+ AB68
 330+ AB68              ;   La entidad no se imprimirá entera. Va a ir apareciendo por la parte baja del marcador.
 331+ AB68              ;   Calculamos el nº de scanlines que vamos a imprimir.
 332+ AB68              ;   (Puntero_de_impresion) se encuentra en la 2ª o 3ª Fila de la pantalla.
 333+ AB68
 334+ AB68 7C               ld a,h
 335+ AB69 D6 40            sub $40
 336+ AB6B 47               ld b,a                                          ; Nº de scanlines en B. Si el 1er scanline es $40XX, siendo XX la segunda fila de pantalla: [No_scanlines].
 337+ AB6C 20 05            jr nz,2F
 338+ AB6E
 339+ AB6E              ;   Estamos en una línea $40 y apareciendo.
 340+ AB6E
 341+ AB6E 7D               ld a,l
 342+ AB6F FE 40            cp $40
 343+ AB71 38 29            jr c,No_scanlines                               ; Si estamos en la 2ª Fila la entidad quedaría oculta, jr [No_scanlines].
 344+ AB73
 345+ AB73 7D           2 ld a,l
 346+ AB74 C6 40            add $40
 347+ AB76 6F               ld l,a
