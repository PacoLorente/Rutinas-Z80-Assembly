 651+ 9EE7              ;
 652+ 9EE7              ;   17/9/26
 653+ 9EE7              ;
 654+ 9EE7              ;   Herramienta para construir melodías y ruido con el SPEAKER.
 655+ 9EE7
 656+ 9EE7              Sound_Generator:
 657+ 9EE7
 658+ 9EE7              ;   INPUTS: C contiene el nº de veces que vamos a generar la onda del sonido.
 659+ 9EE7              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
 660+ 9EE7              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 661+ 9EE7              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
 662+ 9EE7              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
 663+ 9EE7              ;
 664+ 9EE7
 665+ 9EE7              ;   MODIFY: A,HL,BC y DE.
 666+ 9EE7
 667+ 9EE7              ;   Exclusión:
 668+ 9EE7
 669+ 9EE7 2A 78 94         ld hl,(Sound)
 670+ 9EEA 7C               ld a,h
 671+ 9EEB B5               or l
 672+ 9EEC C8               ret z                   ; Salimos de la rutina si no hay sonido a ejecutar.
 673+ 9EED
 674+ 9EED 04               inc b
 675+ 9EEE 05               dec b
 676+ 9EEF 20 2F            jr nz,Noise_efect       ; Salta al módulo de ruido.
 677+ 9EF1
 678+ 9EF1              Loop_2:
 679+ 9EF1
 680+ 9EF1              ;   %xxxabccc
 681+ 9EF1
 682+ 9EF1              ;   %a ... Salida SPEAKER.
 683+ 9EF1              ;   %b ... MIC/EAR.
 684+ 9EF1              ;   %c ... BORDER Colour.
 685+ 9EF1
 686+ 9EF1
 687+ 9EF1 3E 10            ld a,%00010000          ; Borde negro.
 688+ 9EF3 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 689+ 9EF5
 690+ 9EF5              Delay_5:
 691+ 9EF5
 692+ 9EF5 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 693+ 9EF6
 694+ 9EF6 7C               ld a,h
 695+ 9EF7 B5               or l
 696+ 9EF8 20 FB            jr nz,Delay_5
 697+ 9EFA
 698+ 9EFA 2A 78 94         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 699+ 9EFD
 700+ 9EFD AF               xor a                   ; Borde negro.    ---     4 tstates
 701+ 9EFE D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 702+ 9F00
 703+ 9F00              Delay_6:
 704+ 9F00
 705+ 9F00 2B               dec hl
 706+ 9F01
 707+ 9F01 7C               ld a,h
 708+ 9F02 B5               or l
 709+ 9F03 20 FB            jr nz,Delay_6
 710+ 9F05
 711+ 9F05              ; Hemos generado una onda sonora.
 712+ 9F05              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 713+ 9F05
 714+ 9F05 2A 78 94         ld hl,(Sound)
 715+ 9F08
 716+ 9F08 1C               inc e
 717+ 9F09 1D               dec e
 718+ 9F0A 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 719+ 9F0C              ;                           ; (E)="0" indica que no hay variación en el tono.
 720+ 9F0C
 721+ 9F0C 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
 722+ 9F0D 7A               ld a,d                  ; (A) contiene ahora "1", si el sonido es ascendente y "0" si es descendente.
 723+ 9F0E
 724+ 9F0E              ; Rayo de entrada o de salida ???
 725+ 9F0E
 726+ 9F0E A7               and a
 727+ 9F0F 20 05            jr nz,Incrementa_delay
 728+ 9F11
 729+ 9F11              Decrementa_delay:
 730+ 9F11
 731+ 9F11 2B               dec hl
 732+ 9F12 10 FD            djnz Decrementa_delay
 733+ 9F14
 734+ 9F14 18 03            jr 1F
 735+ 9F16
 736+ 9F16              Incrementa_delay:
 737+ 9F16
 738+ 9F16 23               inc hl
 739+ 9F17 10 FD            djnz Incrementa_delay
 740+ 9F19
 741+ 9F19              ; Descontamos la onda generada del total de ondas que tiene el efecto, (Sound).
