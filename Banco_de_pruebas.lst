   5+ 96A1              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 96A1              ;   (XOR) bit a bit.
   7+ 96A1              ;
   8+ 96A1              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 96A1              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 96A1
  11+ 96A1              Derivando_RND
  12+ 96A1
  13+ 96A1 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 96A3 C5               push bc
  15+ 96A4              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 96A4 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 96A7              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 96A7
  19+ 96A7 A7           6 and a                                 ; Carry a "0".
  20+ 96A8 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 96AA 30 02            jr nc,1F
  22+ 96AC
  23+ 96AC CB C1            set 0,c
  24+ 96AE
  25+ 96AE 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 96AF E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 96B1 5F               ld e,a
  28+ 96B2
  29+ 96B2 7A               ld a,d
  30+ 96B3 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 96B5 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 96B7
  33+ 96B7 CB 3F            srl a
  34+ 96B9
  35+ 96B9 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 96BA
  37+ 96BA 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 96BB 28 04            jr z,4F
  39+ 96BD
  40+ 96BD CB FF            set 7,a
  41+ 96BF 18 02            jr 5F
  42+ 96C1
  43+ 96C1 CB BF        4 res 7,a
  44+ 96C3
  45+ 96C3 CB 21        5 sla c
  46+ 96C5 10 E0            djnz 6B
  47+ 96C7
  48+ 96C7 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 96C8
  50+ 96C8 77               ld (hl),a
  51+ 96C9 23               inc hl
  52+ 96CA C1               pop bc
  53+ 96CB 10 D4            djnz 3B
  54+ 96CD
  55+ 96CD C9               ret
  56+ 96CE
  57+ 96CE
  58+ 96CE
