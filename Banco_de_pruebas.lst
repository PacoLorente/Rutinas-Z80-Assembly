   3+ 8A48              ;   07/07/23
   4+ 8A48              ;
   5+ 8A48              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 8A48              ;
   7+ 8A48              ;   Codificación:
   8+ 8A48              ;
   9+ 8A48              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 8A48              ;
  11+ 8A48              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 8A48              ;
  13+ 8A48              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 8A48              ;
  15+ 8A48              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 8A48              ;
  17+ 8A48              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 8A48              ;                               ..... %01000010 Vel_up 4
  19+ 8A48              ;                                               Vel_down 2
  20+ 8A48              ;                               ..... $42
  21+ 8A48              ;
  22+ 8A48              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 8A48              ;
  24+ 8A48              ;                               ..... %01000010 Vel_left 4
  25+ 8A48              ;                                               Vel_right 2
  26+ 8A48              ;                               ..... $42
  27+ 8A48              ;
  28+ 8A48              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 8A48              ;
  30+ 8A48              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 8A48              ;
  32+ 8A48              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 8A48              ;
  34+ 8A48              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 8A48              ;                                     $53
  36+ 8A48              ;
  37+ 8A48              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 8A48              ;
  39+ 8A48              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 8A48              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 8A48              ;
  42+ 8A48              ;                       Arriba ..... $81
  43+ 8A48              ;                       Arriba - izquierda ..... $a1
  44+ 8A48              ;                       Arriba - derecha ..... $91
  45+ 8A48              ;
  46+ 8A48              ;                       Abajo ..... $41
  47+ 8A48              ;                       Abajo - izquierda ..... $61
  48+ 8A48              ;                       Abajo - derecha ..... $51
  49+ 8A48              ;
  50+ 8A48              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 8A48              ;
  52+ 8A48              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 8A48              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 8A48              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 8A48              ;
  56+ 8A48              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 8A48              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 8A48              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 8A48              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 8A48              ;
  61+ 8A48              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 8A48              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 8A48              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 8A48              ;
  65+ 8A48              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 8A48              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 8A48              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 8A48              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 8A48
