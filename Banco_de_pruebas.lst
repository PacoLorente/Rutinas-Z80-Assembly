# file opened: RND_Derivando.asm
   1+ 9483              ; ******************************************************************************************************************************************************************************************
   2+ 9483              ;
   3+ 9483              ;   3/4/25
   4+ 9483              ;
   5+ 9483              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9483              ;   (XOR) bit a bit.
   7+ 9483              ;
   8+ 9483              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9483              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9483
  11+ 9483              Derivando_RND
  12+ 9483
  13+ 9483 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9485 C5               push bc
  15+ 9486              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9486 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9489              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9489
  19+ 9489 A7           6 and a                                 ; Carry a "0".
  20+ 948A CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 948C 30 02            jr nc,1F
  22+ 948E
  23+ 948E CB C1            set 0,c
