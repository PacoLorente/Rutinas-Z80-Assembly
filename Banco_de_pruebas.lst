 424  9489              ;															  _palabras que componen el "movimiento_masticado".
 425  9489
 426  9489              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 427  9489
 428  9489 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 429  948A              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 430  948A              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 431  948A              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 432  948A              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 433  948A
 434  948A 00           Attr db 0 													; Atributos de la entidad.
 435  948B
 436  948B              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 437  948B
 438  948B
