1050+ C540              ;
1051+ C540              ;   Sitúa DOS columnas a la izquierda el comienzo de la línea de texto, (para que quede centrado), cuando el control_
1052+ C540              ;   _ a analizar, (HL) sea una TECLA ESPECIAL.
1053+ C540              ;
1054+ C540              ;   Las teclas especiales se mostrarán en pantalla como cadenas de texto de 5 caracteres:
1055+ C540              ;
1056+ C540              ;   Special keys:
1057+ C540              ;
1058+ C540              ;   Symbol_key defm "SYMB."
1059+ C540              ;   Space_key defm "SPACE"
1060+ C540              ;   Enter_key defm "ENTER"
1061+ C540              ;   Caps_key defm "CAPS."
1062+ C540              ;
1063+ C540              ;   MODIFY: AF, E.
1064+ C540              ;
1065+ C540              ;   INPUTS: HL apunta a la dirección que contiene el KEYCODE de la tecla de CONTROL a sondear:
1066+ C540              ;
1067+ C540              ;   Move_LEFT db $24
1068+ C540              ;   Move_RIGHT db $1c
1069+ C540              ;   Move_FIRE db $04
1070+ C540              ;   Move_SHIELD db $20
