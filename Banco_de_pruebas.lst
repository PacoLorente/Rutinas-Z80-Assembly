 614+ ACCF
 615+ ACCF 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ ACD0 D6 20            sub $20             							; Vamos a comprobarlo...
 617+ ACD2 6F               ld l,a
