 175+ C153              Make_Score_max_msg:
 176+ C153
 177+ C153              ;   Non_authorized_KEY_CODES db $18,$23,$24,$1c,$14,$0c,$04,$03,$0b,$13,$1b
 178+ C153
 179+ C153              ;   Necesito fabricar un msg. con la máxima puntuación.
 180+ C153              ;   Para ello necesitamos el ASCII CODE de cada dígito del marcador SCORE.
 181+ C153
 182+ C153 01 00 05         ld bc,$0500                              ; El marcador SCORE consta de 5 dígitos decimales.
 183+ C156 21 C7 94         ld hl,Score_BCD_decenas_de_millar        ; Para evitar imprimir "0", crearemos el mensaje de izquierda a derecha.
 184+ C159              ;                                            ; Inicialmente (Score_BCD_decenas_de_millar).
 185+ C159 11 D6 94         ld de,Score_max_msg
 186+ C15C
 187+ C15C              KEY_CODE_de_BCD:
 188+ C15C
 189+ C15C 7E           1 ld a,(hl)
 190+ C15D A7               and a
 191+ C15E 20 07            jr nz,3F
 192+ C160
 193+ C160              ;   El dígito es "0".
 194+ C160
 195+ C160 0C               inc c
 196+ C161 0D               dec c
 197+ C162 20 03            jr nz,3F
 198+ C164
 199+ C164 1B               dec de                                   ; No queremos "0"´s delante de la cantidad.
 200+ C165 18 11            jr Next_digit                            ; Aún no hemos impreso ningún dígito de mayor peso.
 201+ C167
 202+ C167 D5           3 push de                                    ; PUSH Score_max_msg.
 203+ C168
 204+ C168 11 E7 94         ld de,Non_authorized_KEY_CODES+2         ; KEY_CODE numbers list.
 205+ C16B
 206+ C16B A7               and a
 207+ C16C 28 04            jr z,4F
 208+ C16E
 209+ C16E 13           2 inc de
 210+ C16F 3D               dec a
 211+ C170 20 FC            jr nz,2B                                 ; Nos situamos en el KEY_CODE correspondiente a este dígito.
 212+ C172
 213+ C172 1A           4 ld a,(de)                                  ; KEY_CODE en A.
 214+ C173
 215+ C173 D1               pop de                                   ; Score_max_msg en DE.
 216+ C174
 217+ C174 CD 7D C1         call ASCII_CODE_de_KEYCODE
 218+ C177
 219+ C177 0C               inc c                                    ; Indica que a partir de ahora se imprimen todos los "0".
 220+ C178
 221+ C178              Next_digit:
 222+ C178
 223+ C178 13               inc de                                   ; Siguiente char del msg. que estamos creando.
 224+ C179 2B               dec hl                                   ; Siguiente díguito decimal a traducir, (centenas, decenas, ...).
 225+ C17A
 226+ C17A 10 E0            djnz 1B                                  ; Digit counter.
