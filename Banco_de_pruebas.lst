 561+ C17D              ; ---------------------------------------------------------------
 562+ C17D              ;
 563+ C17D              ;   18/9/26
 564+ C17D              ;
 565+ C17D              ;   Inicializa la variable (Burst_sound) con el valor de la longitud de la onda que genera la explosión a ejecutar:
 566+ C17D              ;
 567+ C17D              ;   Burst_sound_init_value equ $35                   - Longitud de la explosión de las entidades, (duración).
 568+ C17D              ;   Amadeus_Burst_sound_init_value equ $70           - Longitud de la explosión de Amadeus, (duración).
 569+ C17D              ;
 570+ C17D              ;   MODIFY: A y H.
 571+ C17D              ;
 572+ C17D              ;   OUTPUT: (Burst_sound) y H contienen la duración del semiciclo de la onda que ha de generar la explosión.
 573+ C17D
 574+ C17D
