 780+ B5FF              ;
 781+ B5FF              ;	5/08/22
 782+ B5FF              ;
 783+ B5FF              ;   NextScan.
 784+ B5FF              ;
 785+ B5FF              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 786+ B5FF              ;
 787+ B5FF              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 788+ B5FF              ;
 789+ B5FF              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 790+ B5FF              ;
 791+ B5FF              ;       DESTRUIDOS: AF y HL !!!
 792+ B5FF              ;
 793+ B5FF              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 794+ B5FF              ;
 795+ B5FF
 796+ B5FF              NextScan:
 797+ B5FF
 798+ B5FF 24           	inc h          							; Incrementamos el scanline.
 799+ B600 7C               ld a,h
 800+ B601 E6 07            and 7
 801+ B603 C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 802+ B604
 803+ B604 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 804+ B605 C6 20            add a,$20           							; Vamos a comprobarlo...
 805+ B607 6F               ld l,a
 806+ B608 D8               ret c               							; Salimos si se produce el cambio de tercio.
 807+ B609
 808+ B609 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 809+ B60A D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 810+ B60C 67               ld h,a
 811+ B60D C9               ret
 812+ B60E
