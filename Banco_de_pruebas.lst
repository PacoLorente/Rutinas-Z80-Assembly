   5+ 9998              ; DRAW. ************************************************************************************************************************************************************************************
   6+ 9998
   7+ 9998              Draw
   8+ 9998
   9+ 9998 CD 41 9C     	call Prepara_draw
  10+ 999B 7C           	ld a,h 						 					; El objeto existe, o se está iniciando?. Si se está iniciando, (Posicion_inicio = Posicion_actual) y saltamos_
  11+ 999C A7           	and a 											; _a la subrutina [Inicializacion] donde asignaremos cuadrante y límites.
  12+ 999D 28 05        	jr z,2F
  13+ 999F
  14+ 999F 3A 09 8C     	ld a,(Cuad_objeto)			 					; El objeto ya se inició. Cargamos en A el cuadrante de pantalla en el que lo hizo y saltamos a 1F.
  15+ 99A2 18 0C        	jr 1F
  16+ 99A4
  17+ 99A4 2A 07 8C     2 ld hl,(Posicion_inicio) 							; No hay (Posicion_actual), por lo que el objeto se está iniciando.
  18+ 99A7 22 FA 8B     	ld (Posicion_actual),hl							; Indicamos que (Posicion_actual) = (Posicion_inicio) y saltamos a la subrutina [Inicializacion], (donde asignaremos_
  19+ 99AA CD 36 9B     	call Inicializacion   							; _(Limite_horizontal), (Limite_vertical) y (Cuad_objeto). También asignaremos las coordenadas X e Y. (Posición 0,0)_
  20+ 99AD              ;													; _la esquina superior izquierda de la pantalla.
  21+ 99AD
  22+ 99AD CD BF A0     	call Inicia_Puntero_mov							; El objeto está inicializado. Antes de salir inicializamos tb el puntero de movimiento de la entidad.
  23+ 99B0
  24+ 99B0 3A F7 8B     1 ld a,(Ctrl_0)
  25+ 99B3 CB 6F        	bit 5,a
  26+ 99B5 20 06        	jr nz,3F										; Si acabamos de inicializar un objeto, NO COMPROBAMOS LÍMITES.
  27+ 99B7
  28+ 99B7 CD CC 99     	call Comprueba_limite_horizontal
  29+ 99BA CD 5C 9A     	call Comprueba_limite_vertical
  30+ 99BD
  31+ 99BD              ; Llegados a este punto, tengo Filas/Columnas en BC y (Cuad_objeto) en A´.
  32+ 99BD              ; -----------------------
  33+ 99BD              ; -----------------------
  34+ 99BD              ; -----------------------
  35+ 99BD
  36+ 99BD CD B2 9B     3 call calcula_CColumnass							; Define el valor de la variable (Columnas). Nº de columnas que se van a pintar de la entidad.
  37+ 99C0 CD E9 9B     	call Calcula_puntero_de_impresion				; Después de ejecutar esta rutina tenemos el puntero de impresión en HL.
  38+ 99C3
  39+ 99C3 3A F7 8B     	ld a,(Ctrl_0)									; Antes de salir de la rutina REStauramos el bit5 de Ctrl_0 para que nos vuelva_
  40+ 99C6 CB AF        	res 5,a											; _a ser de utilidad.
  41+ 99C8 32 F7 8B     	ld (Ctrl_0),a
  42+ 99CB
  43+ 99CB C9           	ret
