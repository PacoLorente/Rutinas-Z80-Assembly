  28+ 9488 5F               ld e,a
  29+ 9489
  30+ 9489 7A               ld a,d
  31+ 948A E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 948C 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 948E
  34+ 948E CB 3F            srl a
  35+ 9490
  36+ 9490 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9491
  38+ 9491 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9492 28 04            jr z,4F
