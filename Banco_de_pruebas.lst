   4+ 9EEE              ;
   5+ 9EEE              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9EEE              ;   (XOR) bit a bit.
   7+ 9EEE              ;
   8+ 9EEE              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9EEE              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9EEE
  11+ 9EEE              Derivando_RND
  12+ 9EEE
  13+ 9EEE ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9EF0 C5               push bc
  15+ 9EF1              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9EF1 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9EF4              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9EF4
  19+ 9EF4 A7           6 and a                                 ; Carry a "0".
  20+ 9EF5 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9EF7 30 02            jr nc,1F
  22+ 9EF9
  23+ 9EF9 CB C1            set 0,c
  24+ 9EFB
  25+ 9EFB 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9EFC E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9EFE 5F               ld e,a
  28+ 9EFF
  29+ 9EFF 7A               ld a,d
  30+ 9F00 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9F02 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9F04
  33+ 9F04 CB 3F            srl a
  34+ 9F06
  35+ 9F06 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9F07
  37+ 9F07 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9F08 28 04            jr z,4F
  39+ 9F0A
  40+ 9F0A CB FF            set 7,a
  41+ 9F0C 18 02            jr 5F
  42+ 9F0E
  43+ 9F0E CB BF        4 res 7,a
  44+ 9F10
  45+ 9F10 CB 21        5 sla c
  46+ 9F12 10 E0            djnz 6B
  47+ 9F14
  48+ 9F14 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9F15
  50+ 9F15 77               ld (hl),a
  51+ 9F16 23               inc hl
  52+ 9F17 C1               pop bc
  53+ 9F18 10 D4            djnz 3B
  54+ 9F1A
  55+ 9F1A C9               ret
  56+ 9F1B
  57+ 9F1B
  58+ 9F1B
