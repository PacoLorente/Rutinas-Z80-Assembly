 734+ 9FEC              Loop_2:
 735+ 9FEC
 736+ 9FEC              ;   %xxxabccc
 737+ 9FEC
 738+ 9FEC              ;   %a ... Salida SPEAKER.
 739+ 9FEC              ;   %b ... MIC/EAR.
 740+ 9FEC              ;   %c ... BORDER Colour.
 741+ 9FEC
 742+ 9FEC
 743+ 9FEC 3E 10            ld a,%00010000          ; Borde negro.
 744+ 9FEE D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 745+ 9FF0
 746+ 9FF0              Delay_5:
 747+ 9FF0
 748+ 9FF0 2B               dec hl                  ; 26 tstates mide el bucle Delay_5
 749+ 9FF1
 750+ 9FF1 7C               ld a,h
 751+ 9FF2 B5               or l
 752+ 9FF3 20 FB            jr nz,Delay_5
 753+ 9FF5
 754+ 9FF5 2A A7 96         ld hl,(Sound)           ; Recupera duración del semiciclo, 16 tstates.
 755+ 9FF8
 756+ 9FF8 AF               xor a                   ; Borde negro.    ---     4 tstates
 757+ 9FF9 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 758+ 9FFB
 759+ 9FFB              Delay_6:
 760+ 9FFB
 761+ 9FFB 2B               dec hl
 762+ 9FFC
 763+ 9FFC 7C               ld a,h
 764+ 9FFD B5               or l
 765+ 9FFE 20 FB            jr nz,Delay_6
 766+ A000
 767+ A000              ; Hemos generado una onda sonora.
 768+ A000              ; Averiguamos si existe incremento/decremento del delay; (variación del tono).
 769+ A000
 770+ A000 2A A7 96         ld hl,(Sound)
 771+ A003
 772+ A003 1C               inc e
 773+ A004 1D               dec e
 774+ A005 28 0D            jr z,1F                 ; E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
 775+ A007              ;                           ; (E)="0" indica que no hay variación en el tono.
 776+ A007
 777+ A007 43               ld b,e                  ; (B) contiene ahora el nº de incrementos/decrementos.
