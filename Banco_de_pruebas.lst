   1+ A1FE              ; ******************************************************************************************************************************************************************************************
   2+ A1FE              ;
   3+ A1FE              ;   3/4/25
   4+ A1FE              ;
   5+ A1FE              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A1FE              ;   (XOR) bit a bit.
   7+ A1FE              ;
   8+ A1FE              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A1FE              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A1FE
  11+ A1FE              Derivando_RND
  12+ A1FE
  13+ A1FE ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A200 C5               push bc
  15+ A201              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A201 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A204              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A204
  19+ A204 A7           6 and a                                 ; Carry a "0".
  20+ A205 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A207 30 02            jr nc,1F
  22+ A209
  23+ A209 CB C1            set 0,c
  24+ A20B
  25+ A20B 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A20C E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A20E 5F               ld e,a
  28+ A20F
  29+ A20F 7A               ld a,d
  30+ A210 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A212 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A214
  33+ A214 CB 3F            srl a
  34+ A216
  35+ A216 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A217
  37+ A217 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A218 28 04            jr z,4F
  39+ A21A
  40+ A21A CB FF            set 7,a
  41+ A21C 18 02            jr 5F
  42+ A21E
  43+ A21E CB BF        4 res 7,a
  44+ A220
  45+ A220 CB 21        5 sla c
  46+ A222 10 E0            djnz 6B
  47+ A224
  48+ A224 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A225
  50+ A225 77               ld (hl),a
  51+ A226 23               inc hl
  52+ A227 C1               pop bc
  53+ A228 10 D4            djnz 3B
  54+ A22A
  55+ A22A C9               ret
  56+ A22B
  57+ A22B
  58+ A22B
# file closed: RND_Derivando.asm
