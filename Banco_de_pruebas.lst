1739  9928 BE           	cp (hl)
1740  9929 4F           	ld c,a 												; Nº aleatorio ($00 - $ff) en A.
1741  992A
1742  992A 38 01        	jr c,1F
1743  992C
1744  992C              ;	Por encima o igual que (Max_time_to_appear_entities).
1745  992C              ;	Siempre que el nº aleatorio se encuentra por debajo del límite inferior, decrementamos el límite en 10 unidades.
1746  992C
1747  992C 4E           	ld c,(hl)
1748  992D
1749  992D              ;	El nº aleatorio no supera el valor de (Max_time_to_appear_entities).
1750  992D              ;	Por debajo del mínimo?, (Min_time_to_appear_entities)??.
