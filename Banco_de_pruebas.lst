 522  93BF              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 523  93BF
 524  93BF 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 525  93C1              ;															  _palabras que componen el "movimiento_masticado".
 526  93C1
 527  93C1              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 528  93C1
 529  93C1 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 530  93C2              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 531  93C2              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 532  93C2              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 533  93C2              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 534  93C2
