 482  9447
 483  9447              ; --------------------------------------------------------------------------------
 484  9447              ;
 485  9447              ; 05/05/26
 486  9447              ;
 487  9447              ; Parámetros DRAW.
 488  9447              ;
 489  9447
 490  9447              Bandeja_DRAW: 	; ---------------------------------------------------------------------------------------------------------------------------
 491  9447
 492  9447 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 493  9448              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 494  9448              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 495  9448              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 496  9448
 497  9448 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 498  9449              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 499  9449
 500  9449 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 501  944A              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 502  944A              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 503  944A
 504  944A              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 505  944A              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 506  944A
 507  944A              ; Ejemplos:
 508  944A
 509  944A              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 510  944A              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 511  944A              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 512  944A              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 513  944A              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 514  944A
 515  944A 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 516  944B              ;															  _ que esta entidad haya colisionado con Amadeus.
 517  944B              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 518  944B
 519  944B 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 520  944D              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 521  944D
 522  944D 00 00        Puntero_de_almacen_de_mov_masticados defw 0
 523  944F
 524  944F              ;															; Almacén donde la entidad guía va guardando comportamiento ya calculado, (rutinas DRAW).
 525  944F
 526  944F 00 00        Contador_de_mov_masticados defw 0							; Contador de 16 bits. La "Entidad_guía" lo aumenta en una unidad cada vez que hace el "pushado" de las tres_
 527  9451              ;															  _palabras que componen el "movimiento_masticado".
 528  9451
 529  9451              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 530  9451
 531  9451 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 532  9452              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 533  9452              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 534  9452              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 535  9452              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 536  9452
 537  9452 00           Attr db 0 													; Atributos de la entidad.
 538  9453
 539  9453              ; ----- ----- De aquí para arriba son los datos que se trasfieren a las cajas de entidades. ¡¡¡¡¡
 540  9453
 541  9453
 542  9453
 543  9453 00           Ctrl_2 db 0
 544  9454              ;															BIT 0, Los sprites se inician con un `sprite vacío', (sprite formado por "ceros"), cuando la rutina_
 545  9454              ;															_ [Genera_datos_de_impresion] guarda su 1ª imagen.
 546  9454              ;															_ Más adelante las rutinas [Mov_left] y [Mov_right] restauraran (Puntero_objeto). Si el 1er movimiento
 547  9454              ; 															_ que hace la entidad después de iniciarse es hacia arriba/abajo no se restaurará (Puntero_objeto), pués_
 548  9454              ; 															_ las rutinas [Mov_up] y [Mov_down] no necesitan modificar el sprite.
 549  9454              ;															_ El bit5 a "1" nos indica que el sprite se inicia por arriba o por abajo y por lo tanto hay que restaurar_
 550  9454              ;															_ (Puntero_objeto) con (Repone_puntero_objeto) una vez iniciado y realizada su 1ª `foto'.
 551  9454              ;
 552  9454              ;															BIT 1, ???
 553  9454              ;															BIT 2, Este bit es activado por [Movimiento]. Indica que hemos `iniciado un desplazamiento'._
 554  9454              ;															_ Evita que volvamos a iniciar el desplazamiento cada vez que ejecutemos [Movimiento].
 555  9454              ;															BIT 3, ???
 556  9454              ;															BIT 4, ???
 557  9454              ;															BIT 5, ???
 558  9454              ;															BIT 6, Habilita la transición: "Salida de Amadeus" por la parte baja de la pantalla cuando completamos un nivel.
 559  9454              ;																   La rutina [Dispara_salida_de_amadeus] pone este bit a "1" tras imprimir el msg. "DONE".
 560  9454              ;															BIT 7, "1" Detecta que hemos pulsado "SHIELD". ; "El reloj de juego, (IM2)", borrara un escudo siempre que este FLAG esté a "1".
 561  9454              ;															- La rutina [Borra_escudo], inicializará el FLAG.
 562  9454
 563  9454 00           Ctrl_0 db 0 												; Byte de control. A través de este byte de control. Las rutinas de desplazamiento: [Mov_right], [Mov_left], [Mov_up] y [Mov_down],_
 564  9455              ;															; _indican a las subrutinas de recolocación del objeto de la rutina [DRAW]: [Comprueba_limite_horizontal] y [Comprueba_Sprite_completo],_
 565  9455              ; 															; _que desaparecemos por un extremo de la pantalla y hemos de `reaparecer? por el contrario.
 566  9455              ; 															; Este dato es necesario debido a que las rutinas de recolocación, están ideadas para recolocar el puntero (Posicion_actual), cuando pasamos_
 567  9455              ; 															; _de un cuadrante a otro de la pantalla pero no preveen la `desaparición? por un extremo del cuadrante y la `reaparición? por el otro.
 568  9455              ;
 569  9455              ; 															DESCRIPCIÖN:
 570  9455              ;
 571  9455              ; 															SET 0, [Reaparece_derecha]. El bit 0 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_left] detecta que el objeto ha `desaparecido? por el_
 572  9455              ; 															_lado izquierdo de la pantalla y ha de `reaparecer? por el derecho. ([Comprueba_Sprite_completo]).
 573  9455              ; 															SET 1, [Reaparece_izquierda]. El bit 1 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_right] detecta que el objeto ha `desaparecido? por el_
 574  9455              ; 															_lado derecho de la pantalla y ha de `reaparecer? por el izquierdo. ([Comprueba_Sprite_completo]).
 575  9455              ; 															SET 2, [Reaparece_abajo]. El bit 2 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_up] detecta que el objeto ha `desaparecido? por la_
 576  9455              ; 															_parte superior de la pantalla y ha de `reaparecer? por el inferior. ([Comprueba_limite_horizontal]).
 577  9455              ; 															SET 3, [Reaparece_arriba]. El bit 3 de (Ctrl_0) se coloca a "1" cuando la rutina [Mov_down] detecta que el objeto ha `desaparecido? por la_
 578  9455              ; 															_parte inferior de la pantalla y ha de `reaparecer? por la superior. ([Comprueba_limite_horizontal]).
 579  9455              ; 															SET 4, El Bit4 a "1", indica que hubo movimiento de la entidad. Necesitamos esta información
 580  9455              ;												            _para "NO BORRAR/PINTAR" en objeto si NO hubo MOVIMIENTO.
 581  9455              ;															SET 5, La rutina [Inicializacion] de Draw_XOR.asm, pone este bit a "1". Con esta información evitamos ejecutar las
 582  9455              ;															_rutinas: (Comprueba_limite_horizontal) y (Comprueba_Sprite_completo) justo después de `inicializar? un objeto.
 583  9455              ; 															SET 6, Está a "1" si el Sprite que tenemos cargado en el `Engine? es AMADEUS.
 584  9455              ;
 585  9455              ; 															SET 7, El bit 7 se encuentra alto, ("1"), cuando el último movimiento horizontal se ha producido a la "DERECHA".
 586  9455              ; 															_ Utilizo la información que proporciona este BIT para modificar (CTRL_DESPLZ) si el siguiente movimiento_
 587  9455              ; 															_ se va a producir a la izquierda. "1" DERECHA - "0" IZQUIERDA.
 588  9455
 589  9455 00           Filas db 0												    ; Filas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 590  9456              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de las entidades,_
 591  9456              ;															; _rojo - amarillo.
 592  9456
 593  9456 00           Columns db 0 												; Nº de columnas. [DRAW]. - 2ª Funcion tras haber generado los movimientos masticados:
 594  9457              ;															; Almacena un bit que iremos alternando: "0" a "1" mediante una función XOR. Se utiliza para cambiar los attr. de la explosión de Amadeus, (rojo - amarillo).
 595  9457
 596  9457 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 597  9458 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 598  9459
 599  9459 00 00        Posicion_actual defw 0										; Dirección actual del Sprite. [DRAW]
 600  945B 00 00        Puntero_objeto defw 0										; Donde están los datos para pintar el Sprite.
 601  945D
 602  945D              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 603  945D
 604  945D 00           CTRL_DESPLZ db 0											; Este byte nos indica la posición que tiene el Sprite dentro del mapa de desplazamientos.
 605  945E              ;															; Una vez construidos los movimientos masticados del nivel esta variable:
 606  945E              ;
 607  945E              ;															; Almacena un contador de scanlines que se utiliza para hacer desaparecer Amadeus por la parte baja de la pantalla.
 608  945E
 609  945E              ; ---------- ---------- ---------- ---------;      ;--------- ---------- ---------- ----------
 610  945E
 611  945E 00 00        Indice_Sprite_der defw 0
