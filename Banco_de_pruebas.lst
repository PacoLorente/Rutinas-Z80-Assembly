 308  8E64              ;															; repetimos dicho desplazamiento. Ese valor se almacena en esta variable, ($1-$f). NUNCA SERÁ "0".
 309  8E64
 310  8E64 00           Repetimos_desplazamiento_backup db 0						; Restaura (Repetimos_desplazamiento) cuando este llega a "0".
 311  8E65 00           Repetimos_movimiento db 0									; Byte que indica el nº de veces que repetimos el último MOVIMIENTO.
 312  8E66 00           Cola_de_desplazamiento db 0									; Este byte indica:
 313  8E67
 314  8E67              ;
 315  8E67              ;															;	"$00" ..... Hemos finalizado la cadena de movimiento.
 316  8E67              ;															;				En este caso hemos de incrementar (Puntero_indice_mov)_
 317  8E67              ;															;				_ y pasar a la siguiente cadena de movimiento del índice.
 318  8E67              ;
 319  8E67              ;															;	"$01 - "$fe" ..... Repetición del movimiento.
 320  8E67              ;															;						Nº de veces que vamos a repetir el movimiento completo.
 321  8E67              ;															;						En este caso, volveremos a inicializar (Puntero_mov),_
 322  8E67              ;															;						_ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
 323  8E67              ;
 324  8E67              ;															;	"$ff" ..... Bucle infinito de repetición.
 325  8E67              ;															;				Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
 326  8E67              ;															;				,_ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
 327  8E67
