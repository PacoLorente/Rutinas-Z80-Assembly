 600+ A597              ;
 601+ A597              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el scanline anterior.
 602+ A597              ;
 603+ A597              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 604+ A597              ;
 605+ A597              ;       DESTRUIDOS: AF y HL !!!
 606+ A597              ;
 607+ A597              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 608+ A597              ;
 609+ A597
 610+ A597 7C           PreviousScan ld a,h
 611+ A598 25               dec h               							; Dec H.
 612+ A599 E6 07            and 7
 613+ A59B C0               ret nz              							; Salimos de la rutina si el scanline se encuentra entre (1-7).
 614+ A59C
 615+ A59C 7D               ld a,l              							; Estabamos en el scanline "0" y al decrementar nos situamos en el "7" y cambiamos de tercio.
 616+ A59D D6 20            sub $20             							; Vamos a comprobarlo...
 617+ A59F 6F               ld l,a
 618+ A5A0 D8               ret c               							; Salimos si estábamos en la primera línea y se produce el cambio de tercio.
 619+ A5A1
 620+ A5A1 7C               ld a,h              							; No estamos en la primera línea del tercio, por lo que inicializamos H sumando una_
 621+ A5A2 C6 08            add a,8             							; _unidad a los bits que definen el tercio TT, (add a,$08).
 622+ A5A4 67               ld h,a
 623+ A5A5 C9               ret
