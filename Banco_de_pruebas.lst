 562+ A1A4              ;
 563+ A1A4              ;	5/08/22
 564+ A1A4              ;
 565+ A1A4              ;   NextScan.
 566+ A1A4              ;
 567+ A1A4              ;   Calcula la dirección de mem. de pantalla donde se sitúa el siguiente scanline. (Inc H, línea abajo).
 568+ A1A4              ;
 569+ A1A4              ;   INPUT: HL contendra la dirección de mem. de video sobre la que queremos calcular el siguiente scanline.
 570+ A1A4              ;
 571+ A1A4              ;   OUTPUT: HL contendrá la nueva dirección de memoria de pantalla.
 572+ A1A4              ;
 573+ A1A4              ;       DESTRUIDOS: AF y HL !!!
 574+ A1A4              ;
 575+ A1A4              ;   010T TSSS LLLC CCCC (Codificación de la memoria de pantalla). $4000 - $57FF, (256 x 192 pixeles).
 576+ A1A4              ;
 577+ A1A4
 578+ A1A4 24           NextScan inc h          ; Incrementamos el scanline.
 579+ A1A5 7C               ld a,h
 580+ A1A6 E6 07            and 7
 581+ A1A8 C0               ret nz              ; Salimos de la rutina si el scanline se encuentra entre (1-7).
 582+ A1A9
 583+ A1A9 7D           	ld a,l              ; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 584+ A1AA C6 20            add a,$20           ; Vamos a comprobarlo...
 585+ A1AC 6F               ld l,a
 586+ A1AD D8               ret c               ; Salimos si se produce el cambio de tercio.
 587+ A1AE
