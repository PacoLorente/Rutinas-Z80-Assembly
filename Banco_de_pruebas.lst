   5+ 9D39              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D39              ;   (XOR) bit a bit.
   7+ 9D39              ;
   8+ 9D39              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D39              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D39
  11+ 9D39              Derivando_RND
  12+ 9D39
  13+ 9D39 ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D3B C5               push bc
  15+ 9D3C              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D3C 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D3F              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D3F
  19+ 9D3F A7           6 and a                                 ; Carry a "0".
  20+ 9D40 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D42 30 02            jr nc,1F
  22+ 9D44
  23+ 9D44 CB C1            set 0,c
  24+ 9D46
  25+ 9D46 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D47 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D49 5F               ld e,a
  28+ 9D4A
  29+ 9D4A 7A               ld a,d
  30+ 9D4B E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D4D 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D4F
  33+ 9D4F CB 3F            srl a
  34+ 9D51
  35+ 9D51 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D52
  37+ 9D52 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D53 28 04            jr z,4F
  39+ 9D55
  40+ 9D55 CB FF            set 7,a
  41+ 9D57 18 02            jr 5F
  42+ 9D59
  43+ 9D59 CB BF        4 res 7,a
  44+ 9D5B
  45+ 9D5B CB 21        5 sla c
  46+ 9D5D 10 E0            djnz 6B
  47+ 9D5F
  48+ 9D5F 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D60
  50+ 9D60 77               ld (hl),a
  51+ 9D61 23               inc hl
  52+ 9D62 C1               pop bc
  53+ 9D63 10 D4            djnz 3B
  54+ 9D65
  55+ 9D65 C9               ret
