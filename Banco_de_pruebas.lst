   5+ 9D2B              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9D2B              ;   (XOR) bit a bit.
   7+ 9D2B              ;
   8+ 9D2B              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9D2B              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9D2B
  11+ 9D2B              Derivando_RND
  12+ 9D2B
  13+ 9D2B ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9D2D C5               push bc
  15+ 9D2E              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9D2E 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9D31              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9D31
  19+ 9D31 A7           6 and a                                 ; Carry a "0".
  20+ 9D32 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9D34 30 02            jr nc,1F
  22+ 9D36
  23+ 9D36 CB C1            set 0,c
  24+ 9D38
  25+ 9D38 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9D39 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9D3B 5F               ld e,a
  28+ 9D3C
  29+ 9D3C 7A               ld a,d
  30+ 9D3D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9D3F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9D41
  33+ 9D41 CB 3F            srl a
  34+ 9D43
  35+ 9D43 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9D44
  37+ 9D44 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9D45 28 04            jr z,4F
  39+ 9D47
  40+ 9D47 CB FF            set 7,a
  41+ 9D49 18 02            jr 5F
  42+ 9D4B
  43+ 9D4B CB BF        4 res 7,a
  44+ 9D4D
  45+ 9D4D CB 21        5 sla c
  46+ 9D4F 10 E0            djnz 6B
  47+ 9D51
  48+ 9D51 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ 9D52
  50+ 9D52 77               ld (hl),a
  51+ 9D53 23               inc hl
  52+ 9D54 C1               pop bc
  53+ 9D55 10 D4            djnz 3B
  54+ 9D57
  55+ 9D57 C9               ret
