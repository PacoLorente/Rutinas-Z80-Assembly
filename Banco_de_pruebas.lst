 359+ C110              ; ----- ----- ----- ----- -----
 360+ C110              ;
 361+ C110              ;   23/9/26
 362+ C110              ;
 363+ C110              ;   El efecto del disparo de Amadeus es de tipo descendente.
 364+ C110              ;
 365+ C110              ;   HL define el sonido.
 366+ C110              ;
 367+ C110              ;   Valor inicial $1601. $16, (H) es el n° de ondas completas que mide el efecto, (duración).
 368+ C110              ;                        $01, (L) es la nota inicial del efecto, (longitud de cada semiciclo).
 369+ C110              ;
 370+ C110              ;   El efecto del disparo no activa el inhibidor de efectos de sonido, (Bit_0 Ctrl_6) pues el efecto de las explosiones y el del_
 371+ C110              ;   _ escudo tienen prioridad sobre este efecto.
 372+ C110              ;
 373+ C110              ;   La rutina no se ejecuta si se está reproduciendo una explosión o un efecto SHIELD.
 374+ C110              ;
 375+ C110              ;   INPUTS: (Shot_sound) <> "0".
 376+ C110              ;
 377+ C110              ;   MODIFY: AF, HL y BC.
 378+ C110              ;
 379+ C110              ;   OUTPUT: (Shot_sound) actualizado.
 380+ C110
 381+ C110              Play_shot_sound_effect:
 382+ C110
 383+ C110              ;   Exclusiones:
 384+ C110
 385+ C110 2A 7D 94         ld hl,(Shot_sound)
 386+ C113 7C               ld a,h
 387+ C114 B5               or l
 388+ C115 C8               ret z                   ; RET si no se ha producido disparo.
 389+ C116
 390+ C116 3A 4F 94         ld a,(Ctrl_6)
 391+ C119 CB 47            bit 0,a
 392+ C11B C0               ret nz                  ; RET si el inhibidor de sonido está activo, (se está ejecutando una explosión).
 393+ C11C
 394+ C11C 0E 02            ld c,2                  ; Nº de ondas de sonido que vamos a ejecutar por FRAME.
 395+ C11E
 396+ C11E              Loop_1:
 397+ C11E
 398+ C11E 3E 10            ld a,%00010000          ; Borde negro.
 399+ C120 D3 FE            out ($fe),a             ; Semiciclo POSITIVO de la onda, BEEPER ON.
 400+ C122
 401+ C122 45               ld b,l
 402+ C123
 403+ C123 10 FE        Delay_3 djnz Delay_3
 404+ C125
 405+ C125 AF               xor a                   ; Borde negro.
 406+ C126 D3 FE            out ($fe),a             ; Semiciclo NEGATIVO de la onda, BEEPER OFF.
 407+ C128
 408+ C128 45               ld b,l
 409+ C129
 410+ C129 10 FE        Delay_4 djnz Delay_4
 411+ C12B
 412+ C12B              ; Hemos generado una onda sonora. La siguiente onda generará un sonido más grave, para ello incrementamos el Delay de la señal.
 413+ C12B
 414+ C12B 2C               inc l
 415+ C12C 2C               inc l
 416+ C12D 2C               inc l
 417+ C12E 2C               inc l
 418+ C12F
 419+ C12F 25               dec h
