   1+ A14A              ; ******************************************************************************************************************************************************************************************
   2+ A14A              ;
   3+ A14A              ;   3/4/25
   4+ A14A              ;
   5+ A14A              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ A14A              ;   (XOR) bit a bit.
   7+ A14A              ;
   8+ A14A              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ A14A              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ A14A
  11+ A14A              Derivando_RND
  12+ A14A
  13+ A14A ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ A14C C5               push bc
  15+ A14D              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ A14D 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ A150              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ A150
  19+ A150 A7           6 and a                                 ; Carry a "0".
  20+ A151 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ A153 30 02            jr nc,1F
  22+ A155
  23+ A155 CB C1            set 0,c
  24+ A157
  25+ A157 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ A158 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ A15A 5F               ld e,a
  28+ A15B
  29+ A15B 7A               ld a,d
  30+ A15C E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ A15E 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ A160
  33+ A160 CB 3F            srl a
  34+ A162
  35+ A162 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ A163
  37+ A163 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ A164 28 04            jr z,4F
  39+ A166
  40+ A166 CB FF            set 7,a
  41+ A168 18 02            jr 5F
  42+ A16A
  43+ A16A CB BF        4 res 7,a
  44+ A16C
  45+ A16C CB 21        5 sla c
  46+ A16E 10 E0            djnz 6B
  47+ A170
  48+ A170 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  49+ A171
  50+ A171 77               ld (hl),a
  51+ A172 23               inc hl
  52+ A173 C1               pop bc
  53+ A174 10 D4            djnz 3B
  54+ A176
  55+ A176 C9               ret
  56+ A177
  57+ A177
  58+ A177
