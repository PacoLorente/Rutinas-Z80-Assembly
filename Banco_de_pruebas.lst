 489  93B7
 490  93B7 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 491  93B8              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 492  93B8              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 493  93B8              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 494  93B8
 495  93B8 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 496  93B9              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 497  93B9
 498  93B9 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 499  93BA              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 500  93BA              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 501  93BA
 502  93BA              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 503  93BA              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 504  93BA
 505  93BA              ; Ejemplos:
 506  93BA
 507  93BA              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 508  93BA              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 509  93BA              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 510  93BA              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 511  93BA              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 512  93BA
 513  93BA 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 514  93BB              ;															  _ que esta entidad haya colisionado con Amadeus.
 515  93BB              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 516  93BB
 517  93BB 00 00        Puntero_de_impresion defw 0									; Contiene el puntero de impresión, (calculado por DRAW). Esta dirección la utilizará la rutina_
 518  93BD              ;															; _ [Guarda_coordenadas_X] y [Compara_coordenadas_X] para detectar la colisión ENTIDAD-AMADEUS.
 519  93BD
 520  93BD 00 00        Puntero_de_almacen_de_mov_masticados defw 0
