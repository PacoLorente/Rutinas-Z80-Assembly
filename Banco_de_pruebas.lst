 431+ C13A              Clean_shot_effect:
 432+ C13A
 433+ C13A 21 00 00         ld hl,0
 434+ C13D 0E 01            ld c,1
 435+ C13F
 436+ C13F C9               ret
 437+ C140
 438+ C140              ;   -------------------------------------------------------------------------------------------
 439+ C140              ;
 440+ C140              ;   23/9/26
 441+ C140              ;
 442+ C140              ;   Ejecuta el sonido de una explosión siempre que (Burst_sound) se haya iniciado y no haya otra en curso, (Bit_0 Ctrl_6).
 443+ C140              ;
 444+ C140              ;   Las explosiones de las entidades y Amadeus se generan con el módulo [Noise_efect] de la herramienta_
 445+ C140              ;   _ [Sound_Generator].
 446+ C140              ;
 447+ C140              ;   La duración de la explosión está definido por el valor de (H), no es relevante el valor que contenga (L):
 448+ C140              ;
 449+ C140              ;   Burst_sound_init_value equ $35                ;   Longitud de la explosión de las entidades, (duración).
 450+ C140              ;   Amadeus_Burst_sound_init_value equ $75        ;   Longitud de la explosión de Amadeus, (duración).
 451+ C140              ;
 452+ C140              ;   INPUTS: (Burst_sound) iniciado, <> "0".
 453+ C140              ;
 454+ C140              ;   MODIFY: AF',AF, HL, DE y BC.
 455+ C140              ;
 456+ C140              ;   OUTPUT: Actualiza (Burst_sound).
 457+ C140
 458+ C140              Play_burst_sound_effect:
 459+ C140
 460+ C140              ;   Exclusiones:
 461+ C140
 462+ C140 3A 7F 94         ld a,(Burst_sound)
 463+ C143 A7               and a
 464+ C144 C8               ret z                   ; RET si (Burst_sound) no está iniciado, (no hay explosión).
 465+ C145
 466+ C145 08               ex af,af
 467+ C146
 468+ C146 3A 4F 94         ld a,(Ctrl_6)
 469+ C149 CB 47            bit 0,a
 470+ C14B C0               ret nz                  ; RET si está activo el bit "Inhibidor de efectos de sonido". (Explosión anterior en curso).
 471+ C14C
 472+ C14C              ;   ----------------------
 473+ C14C
 474+ C14C CB C7            set 0,a
 475+ C14E 32 4F 94         ld (Ctrl_6),a           ; Activa el inhibidor de sounds effects.
 476+ C151
 477+ C151 08               ex af,af                ; Restore (Burst_sound).
 478+ C152
 479+ C152 67               ld h,a
 480+ C153 2E 00            ld l,0                  ; (HL) contiene (Burst_sound).
 481+ C155
 482+ C155 E5               push hl                 ; Cantidad de explosión que queda por ejecutar.
 483+ C156
 484+ C156 22 78 94         ld (Sound),hl           ; Cargamos el sonido de la explosión en (Sound) y definimos el nº de ondas a reproducir.
 485+ C159 0E 03            ld c,3
 486+ C15B CD 12 9F         call Noise_efect
 487+ C15E
 488+ C15E D1               pop de                  ; Hemos de averiguar que la explosión no tiene valor negativo. Evitamos que entre en un bucle infinito de ejecución.
 489+ C15F
 490+ C15F 7A               ld a,d                  ; Así podemos ejecutar una explosión con la duración que queramos.
 491+ C160 94               sub h
 492+ C161
 493+ C161 38 05            jr c,Clean_burst_efect  ; Burst end, (Clean_burst_efect).
 494+ C163
 495+ C163 7C               ld a,h
 496+ C164 32 7F 94         ld (Burst_sound),a
 497+ C167
 498+ C167 C9               ret
 499+ C168
 500+ C168              Clean_burst_efect:
 501+ C168
 502+ C168 AF               xor a
 503+ C169 32 7F 94         ld (Burst_sound),a
 504+ C16C
 505+ C16C 3A 4F 94         ld a,(Ctrl_6)
 506+ C16F CB 87            res 0,a
 507+ C171 32 4F 94         ld (Ctrl_6),a
 508+ C174
 509+ C174 C9               ret
 510+ C175
 511+ C175              ;   -------------------------------------------------------------------------------------------
 512+ C175              ;
 513+ C175              ;   23/9/26
 514+ C175              ;
 515+ C175              ;   Shield_sound_effect es el efecto de sonido (in game time) con más prioridad de los tres, los otros dos efectos son: Burst_sound_efect y _
 516+ C175              ;   _ Shield_sound_effect.
 517+ C175              ;
 518+ C175              ;   La rutina se ejecuta siempre que (Shield_sound) se haya iniciado, (su valor no sea "0"). Ignora el inhibidor de efectos de sonido debido _
 519+ C175              ;   _a que el efecto se reproduce completamente cada vez que se ejecuta la rutina.
 520+ C175              ;
 521+ C175              ;   El efecto es una especie de BEEP corto. Su duración es de dos ondas completas y la duración del semiciclo está contenida en 1 byte.
 522+ C175              ;
 523+ C175              ;   INPUT: (Shield_sound) contiene (Shield_sound_init_value), ($c0).
 524+ C175              ;
 525+ C175              ;   MODIFY: AF'y BC.
 526+ C175
 527+ C175              Play_Shield_sound_effect:
 528+ C175
 529+ C175 3A 80 94         ld a,(Shield_sound)
 530+ C178 A7               and a
