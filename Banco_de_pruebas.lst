 438  949C              ;															  _palabras que componen el "movimiento_masticado".
 439  949C
 440  949C              ; Variables de funcionamiento de las rutinas de movimiento. (Mov_left), (Mov_right), (Mov_up), (Mov_down).
 441  949C
 442  949C 00           Velocidad db 0 												; 5 vueltas max. 5 vueltas       1 - 0 (1ª vuelta - velocidad 0)
 443  949D              ;																					 		 2 - 0 (2ª vuelta - velocidad 0)
 444  949D              ;																					 		 4 - 1 (3ª vuelta - velocidad 1)
 445  949D              ;																							 8 - 2 (4ª vuelta - velocidad 2)
 446  949D              ;																				 		   $10 - 4 (5ª vuelta - velocidad 3)
 447  949D
 448  949D 00           Attr db 0 													; Atributos de la entidad.
