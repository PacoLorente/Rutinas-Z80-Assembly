 481  918B              	include "Patrones_de_mov.asm"
# file opened: Patrones_de_mov.asm
   1+ 918B
   2+ 918B
   3+ 918B              ;   07/07/23
   4+ 918B              ;
   5+ 918B              ;   Base de datos. PATRONES DE MOVIMIENTO.
   6+ 918B              ;
   7+ 918B              ;   Codificación:
   8+ 918B              ;
   9+ 918B              ;   La descripción de un movimiento consta de 1 o más desplazamientos.
  10+ 918B              ;
  11+ 918B              ;   Un desplazamiento tiene la siguiente estructura:
  12+ 918B              ;
  13+ 918B              ;   (Byte1),(Byte2),(Byte3),(Cola_de_desplazamiento).   (4 Bytes).
  14+ 918B              ;
  15+ 918B              ;                       Los bytes 1 y 2 definen la velocidad del desplazamiento.
  16+ 918B              ;
  17+ 918B              ;                       (Byte1) ..... % (Vel_up),(Vel_down)
  18+ 918B              ;                               ..... %01000010 Vel_up 4
  19+ 918B              ;                                               Vel_down 2
  20+ 918B              ;                               ..... $42
  21+ 918B              ;
  22+ 918B              ;                       (Byte2) ..... % (Vel_left),(Vel_right)
  23+ 918B              ;
  24+ 918B              ;                               ..... %01000010 Vel_left 4
  25+ 918B              ;                                               Vel_right 2
  26+ 918B              ;                               ..... $42
  27+ 918B              ;
  28+ 918B              ;                       El 3er byte describe la dirección y repeticiones del desplazamiento.
  29+ 918B              ;
  30+ 918B              ;                       (Byte3) ..... Descripción del desplazamiento.
  31+ 918B              ;
  32+ 918B              ;                       % up,down,left,right, Repetición del desplazamiento, (1-15).
  33+ 918B              ;
  34+ 918B              ;                                     %01010011 ..... (Abajo-derecha), 3 veces.
  35+ 918B              ;                                     $53
  36+ 918B              ;
  37+ 918B              ;                       Nota: (Repetimos_desplazamiento) nunca será "0".
  38+ 918B              ;
  39+ 918B              ;                       Esta tabla nos ayudará a codificar rápido los desplazamientos del mov.
  40+ 918B              ;                       Supongamos que solo ejecutamos 1 vez, cada desplazamiento:
  41+ 918B              ;
  42+ 918B              ;                       Arriba ..... $81
  43+ 918B              ;                       Arriba - izquierda ..... $a1
  44+ 918B              ;                       Arriba - derecha ..... $91
  45+ 918B              ;
  46+ 918B              ;                       Abajo ..... $41
  47+ 918B              ;                       Abajo - izquierda ..... $61
  48+ 918B              ;                       Abajo - derecha ..... $51
  49+ 918B              ;
  50+ 918B              ;   (Cola_de_desplazamiento) db 0			; Este byte indica:
  51+ 918B              ;
  52+ 918B              ;											;	"$00" , "0" ..... Hemos finalizado la cadena de movimiento.
  53+ 918B              ;											;				En este caso hemos de incrementar (Puntero_indice_mov)_
  54+ 918B              ;											;				_ y pasar a la siguiente cadena de movimiento del índice.
  55+ 918B              ;
  56+ 918B              ;											;	"$fd" , "1-253" ..... Repetición del MOVIMIENTO.
  57+ 918B              ;											;						         Nº de veces que vamos a repetir el movimiento completo.
  58+ 918B              ;											;					             En este caso, volveremos a inicializar (Puntero_mov),_
  59+ 918B              ;							    			;						         _ con (Puntero_indice_mov) y decrementaremos (Cola_de_desplazamiento).
  60+ 918B              ;
  61+ 918B              ;											;	"$ff"  , "255" ..... Bucle infinito de repetición del último MOVIMIENTO.
  62+ 918B              ;											;				         Nunca vamos a saltar a la siguiente cadena de movimiento del índice,_
  63+ 918B              ;											;				         _ (si es que la hay). Volvemos a inicializar (Puntero_mov) con (Puntero_indice_mov).
  64+ 918B              ;
  65+ 918B              ;                                           ;   "$fe" ..... Activamos el bucle principal del patrón de movimiento. La direccíon de memoria_
  66+ 918B              ;                                           ;               _ del siguiente MOVIMIENTO del índice se almacenará en la variable (Puntero_indice_mov_bucle).
  67+ 918B              ;                                           ;               La subrutina [Inicializa_Puntero_indice_mov] inicializará (Puntero_indice_mov) con_
  68+ 918B              ;                                           ;               _ esta dirección y no se situará al comienzo del índice del patrón de movimiento.
  69+ 918B
