   2+ 9E09              ;
   3+ 9E09              ;   6/11/26
   4+ 9E09              ;
   5+ 9E09              ;   Construyo un nº pseudo aleatorio. Método "DERIVANDO":
   6+ 9E09              ;
   7+ 9E09              ;   Inicialmente nuestra semilla será la contenida en el registro R. A partir de ahí irá mutando y la almacenaremos en la variable: (Semilla).
   8+ 9E09              ;
   9+ 9E09              ;   Para construir nuestro n° pseudo aleatorio necesitamos 8 bits que iremos adquiriendo del último bit, (bit_0) de la semilla.
  10+ 9E09              ;
  11+ 9E09              ;   Después de adquirir el bit de la semilla, desplazamos a la derecha los bits de la misma y realizamos una función lógica XOR entre los_
  12+ 9E09              ;   _ bits 0 y 1, (los dos últimos).
  13+ 9E09              ;
  14+ 9E09              ;   Si el resultado de la operación XOR es "1" pondremos a "1" el bit_7 de la semilla. Si es "0" no realizamos cambios.
  15+ 9E09              ;
  16+ 9E09              ;   Desplazamos los bits del número que estamos generando una posición a la izquierda con el fin de adquirir un nuevo bit de la semilla.
  17+ 9E09              ;
  18+ 9E09              ;   Repetimos proceso hasta que hayamos adquirido los 8 bits necesarios de la semilla.
  19+ 9E09              ;
  20+ 9E09              ;   Guardamos la semilla en la variable (Semilla) y el número generado en (HL).
  21+ 9E09              ;
  22+ 9E09              ;   Incrementamos el puntero HL para situarlo en la siguiente dirección de memoria, (donde almacenaremos el siguiente n° pseudo aleatorio a generar).
  23+ 9E09              ;
  24+ 9E09              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
  25+ 9E09              ;          HL contendrá la dirección de mem. donde vamos a almacenar el 1er n° de los (B) números pseudo aleatorios a generar.
  26+ 9E09              ;
  27+ 9E09              ;   MODIFY: (Semilla), AF, HL, DE y B.
  28+ 9E09
  29+ 9E09              Derivando_RND:
  30+ 9E09
  31+ 9E09              ;   En 1er lugar comprobamos si disponemos de semilla.
  32+ 9E09
  33+ 9E09 3A 39 96         ld a,(Semilla)
  34+ 9E0C
  35+ 9E0C A7               and a
  36+ 9E0D
  37+ 9E0D 20 02            jr nz,Semilla_iniciada
  38+ 9E0F
  39+ 9E0F              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  40+ 9E0F ED 5F            ld a,r      			            ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  41+ 9E11
  42+ 9E11              Semilla_iniciada:
  43+ 9E11
  44+ 9E11 57               ld d,a                              ; A partir de ahora, (D) contendrá nuestra semilla.
  45+ 9E12
  46+ 9E12 C5               push bc                             ; PUSH N° de números que queremos generar.
  47+ 9E13
  48+ 9E13 01 00 08         ld bc,$0800                         ; C contendrá nuestro nº aleatorio: ($0 - $ff). Inicialmente está a "0".
  49+ 9E16              ;                                       ; B actuará como contador de bits, (números de bits a generar), 8 bits.
  50+ 9E16
  51+ 9E16 CB 21        3 sla c                                 ; Shift left; "0" >> Bit_0 >> Bit_7 >> "C".
  52+ 9E18
  53+ 9E18 7A               ld a,d
  54+ 9E19
  55+ 9E19              ;   El último bit de la semilla, (bit_0) será el 1° del número pseudo aleatorio generado, (bit_7).
  56+ 9E19
  57+ 9E19 E6 01            and %00000001
  58+ 9E1B
  59+ 9E1B 28 02            jr z,4F
  60+ 9E1D
  61+ 9E1D CB C1            set 0,c                             ; One bit generated.
  62+ 9E1F
  63+ 9E1F              ;   Rotamos los bits de la semilla una posición a la derecha.
  64+ 9E1F
  65+ 9E1F CB 1A        4  rr d                                 ; Right Rotate. Bit_0 >> "C" >> Bit_7.
  66+ 9E21
  67+ 9E21 7A               ld a,d
  68+ 9E22
  69+ 9E22              Xor_bit_1_bit_2:
  70+ 9E22
  71+ 9E22 E6 01            and %00000001                       ; Bit_0 en (E).
  72+ 9E24 5F               ld e,a
  73+ 9E25
  74+ 9E25 7A               ld a,d
  75+ 9E26 E6 02            and %00000010                       ; Bit_1 en (A).
  76+ 9E28
  77+ 9E28 28 02            jr z,1F
  78+ 9E2A
  79+ 9E2A 3E 01            ld a,1
  80+ 9E2C
  81+ 9E2C AB           1 xor e
  82+ 9E2D
  83+ 9E2D              ;   FUNCIÓN XOR entre el bit_0 y el bit_1 de la semilla después de una rotación de 1 bit a la derecha.
  84+ 9E2D
  85+ 9E2D              ;   0 0 ..... 0
  86+ 9E2D              ;   0 1 ..... 1
  87+ 9E2D              ;   1 0 ..... 1
  88+ 9E2D              ;   1 1 ..... 0
  89+ 9E2D
  90+ 9E2D 28 02            jr z,2F
  91+ 9E2F
  92+ 9E2F CB FA            set 7,d                             ; Cuando la función XOR entre los dos últimos bits de la semilla resulta "1",_
  93+ 9E31              ;                                       ; _ seteamos a "1" el bit_7 de la misma.
  94+ 9E31
  95+ 9E31 10 E3        2 djnz 3B
  96+ 9E33
  97+ 9E33              Number_generated:
  98+ 9E33
  99+ 9E33 7A               ld a,d
 100+ 9E34
 101+ 9E34 32 39 96         ld (Semilla),a                      ; Guarda la evolución de la semilla para seguir generando números.
 102+ 9E37
 103+ 9E37 71               ld (hl),c                           ; Guardamos el número pseudo aleatorio generado en su correspondiente dirección de memoria.
 104+ 9E38
 105+ 9E38 23               inc hl                              ; HL apunta a la dirección de memoria donde vamos a guardar el siguiente número a generar.
 106+ 9E39
 107+ 9E39 C1               pop bc
 108+ 9E3A
 109+ 9E3A 10 CD            djnz Derivando_RND
 110+ 9E3C
 111+ 9E3C C9               ret
