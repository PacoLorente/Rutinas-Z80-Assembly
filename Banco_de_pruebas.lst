  50+ 99D5              ;
  51+ 99D5              ;	Calcula el cuadrante de pantalla donde se encuentra la entidad: (Cuad_objeto), "1", "2", "3" o "4".
  52+ 99D5              ;	Esta información es necesaria para poder calcular el (Puntero_de_impresion) de la entidad.
  53+ 99D5              ;
  54+ 99D5              ;	INPUT:  HL contiene (Posicion_actual).
  55+ 99D5              ;	OUTPUT: (Cuad_objeto) contiene "1", "2", "3" o "4" en función del cuadrante de pantalla en el que se encuentra la entidad.
  56+ 99D5              ;
  57+ 99D5              ;	MODIFY: A.
  58+ 99D5
  59+ 99D5
  60+ 99D5              Calcula_Cuad_objeto
