   5+ 93F8              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 93F8              ;   (XOR) bit a bit.
   7+ 93F8              ;
   8+ 93F8              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 93F8
  10+ 93F8              Derivando_RND
  11+ 93F8
  12+ 93F8 21 F6 88         ld hl,Numeros_aleatorios
  13+ 93FB
  14+ 93FB ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  15+ 93FD C5               push bc
  16+ 93FE              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  17+ 93FE 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  18+ 9401              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  19+ 9401
  20+ 9401 A7           6 and a                                 ; Carry a "0".
  21+ 9402 CB 3F            srl a                               ; Desplazamiento a la derecha.
  22+ 9404 30 02            jr nc,1F
  23+ 9406
  24+ 9406 CB C1            set 0,c
  25+ 9408
  26+ 9408 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  27+ 9409 E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  28+ 940B 5F               ld e,a
  29+ 940C
  30+ 940C 7A               ld a,d
  31+ 940D E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  32+ 940F 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  33+ 9411
  34+ 9411 CB 3F            srl a
  35+ 9413
  36+ 9413 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  37+ 9414
  38+ 9414 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  39+ 9415 28 04            jr z,4F
  40+ 9417
  41+ 9417 CB FF            set 7,a
  42+ 9419 18 02            jr 5F
  43+ 941B
  44+ 941B CB BF        4 res 7,a
  45+ 941D
  46+ 941D CB 21        5 sla c
  47+ 941F 10 E0            djnz 6B
  48+ 9421
  49+ 9421 79               ld a,c                              ; Nº aleatorio (1 Byte) en A.
  50+ 9422
  51+ 9422 77               ld (hl),a
  52+ 9423 23               inc hl
  53+ 9424 C1               pop bc
  54+ 9425 10 D4            djnz 3B
  55+ 9427
  56+ 9427 C9               ret
  57+ 9428
  58+ 9428
  59+ 9428
