 350  9383              ;
 351  9383              ; 29/4/25
 352  9383              ;
 353  9383              ; Parámetros DRAW.
 354  9383              ;
 355  9383
 356  9383              Bandeja_DRAW ; -----------------------------------------------------------------------------------------------
 357  9383
 358  9383 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 359  9384              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 360  9384              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 361  9384              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 362  9384
 363  9384 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 364  9385              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 365  9385 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 366  9386 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 367  9387
 368  9387 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 369  9388              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 370  9388              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 371  9388
 372  9388              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 373  9388              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 374  9388
 375  9388              ; Ejemplos:
 376  9388
 377  9388              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 378  9388              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
