 391+ A3D9              ; 																	; A=NZ indica que esta (Clase) de entidad ya tiene generados los mov_masticados.
 392+ A3D9              ; 																	; Saltaremos a la siguiente entidad del nivel.
 393+ A3D9 A7           	and a
 394+ A3DA 20 44        	jr nz, Avanza_siguiente_entidad_del_nivel
