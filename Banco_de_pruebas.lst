 470  93FF 00           Clase db 0  												; A cada entidad se le asigna un nº o (Clase) para poder asignarle una de las 3 Cajas_Master.
 471  9400              ; 															; En cada (Nivel) sólo puede haber 3 (Clases) diferentes de entidad pués sólo dispondremos de_
 472  9400              ; 															; _tres almacenes de Mov_masticados y 3 Cajas_Master.
 473  9400              ; 															; Las entidades de (Clase) 1, 2 y 3 son de (Tipo) 1, (BadSat).
 474  9400
 475  9400 00           Tipo db 0													; Cada `tipo? de Entidad tiene unas características únicas que lo distinguen de otros tipos.
 476  9401              ; 															; Las entidades del mismo (Tipo) comparte el MISMO PATRÓN DE MOVIMIENTO.
 477  9401 00           Coordenada_X db 0 											; Coordenada X del objeto. (En chars.)
 478  9402 00           Coordenada_y db 0 											; Coordenada Y del objeto. (En chars.)
 479  9403
 480  9403 00           Contador_de_vueltas db 0									; Contador de vueltas de entidades. Inicialmente su valor es "1". El bit se desplaza una posición_
 481  9404              ; 															  _a la izquierda cada vez que la entidaddesaparece por la parte baja de la pantalla.
 482  9404              ;															  Esta variable se utiliza para incrementar el perfil de velocidad de las entidades.
 483  9404
 484  9404              ; Incrementa el contador de vueltas, (el contador cuenta 4 vueltas máximo).
 485  9404              ; El perfil de velocidad de la entidad será: (Contador_de_vueltas)/8.
 486  9404
 487  9404              ; Ejemplos:
 488  9404
 489  9404              ;	1ª vuelta: (Contador_de_vueltas)="$02" --- (Velocidad)="0".
 490  9404              ;	2ª vuelta: 	""	""	""	""	""  ="$04" ---   ""	 ""	  ="1".
 491  9404              ;	3ª vuelta: 	""	""	""	""	""  ="$08" ---   ""	 ""	  ="2".
 492  9404              ;	4ª vuelta: 	""	""	""	""	""  ="$10" ---   ""	 ""	  ="4".
 493  9404              ;	5ª vuelta: 	""	""	""	""	""  ="$20" ---   ""	 ""	  ="8".
 494  9404
 495  9404 00           Impacto db 0												; Si después del movimiento de la entidad, (Impacto) se coloca a "1", existen muchas posibilidades de_
 496  9405              ;															  _ que esta entidad haya colisionado con Amadeus.
 497  9405              ; 																Hay que comprobar la posible colisión después de mover Amadeus. En este caso, (Impacto2)="3".
 498  9405
