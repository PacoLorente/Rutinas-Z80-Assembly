   5+ 9DFF              ;   Construyo un nº aleatorio. Método: "DERIVANDO."
   6+ 9DFF              ;   (XOR) bit a bit.
   7+ 9DFF              ;
   8+ 9DFF              ;   INPUTS: B contendrá el nº de números aleatorios que queremos generar, (0-$ff).
   9+ 9DFF              ;                 HL contendrá la dirección de mem. donde vamos a almacenar los (B) nº RND.
  10+ 9DFF
  11+ 9DFF              Derivando_RND
  12+ 9DFF
  13+ 9DFF ED 5F        3 ld a,r      			                ; La semilla inicial de nuestro nº aleatorio la proporciona el registro `R´. Cargamos A con R.
  14+ 9E01 C5               push bc
  15+ 9E02              ;                                       ; El registro R, es un registro de 8 bits que actúa como contador de refresco de la memoria dinámica. ($00 - $ff).
  16+ 9E02 01 00 07         ld bc,$0700                         ; C contendrá nuestro nº aleatorio: $0 - $ff. Inicialmente está a "0".
  17+ 9E05              ;                                       ; B actuará como contador de bits. Requerimos de 1 byte, ($ff).
  18+ 9E05
  19+ 9E05 A7           6 and a                                 ; Carry a "0".
  20+ 9E06 CB 3F            srl a                               ; Desplazamiento a la derecha.
  21+ 9E08 30 02            jr nc,1F
  22+ 9E0A
  23+ 9E0A CB C1            set 0,c
  24+ 9E0C
  25+ 9E0C 57           1 ld d,a                                ; D contiene la copia de nuestra semilla después del DESPLAZAMIENTO.
  26+ 9E0D E6 01            and %00000001                       ; Extraigo el último bit de A y lo guardamos en E.
  27+ 9E0F 5F               ld e,a
  28+ 9E10
  29+ 9E10 7A               ld a,d
  30+ 9E11 E6 02            and %00000010                       ; Extraigo el penúltimo bit de A y lo `traslado´ al último bit de A. El objetivo es implementar una función XOR_
  31+ 9E13 28 02            jr z,2F                             ; _con el último y penúltimo bit de nuestra semilla.
  32+ 9E15
  33+ 9E15 CB 3F            srl a
  34+ 9E17
  35+ 9E17 AB           2 xor e                                 ; XOR entre el último y penúltimo bit de A.
  36+ 9E18
  37+ 9E18 7A               ld a,d                              ; A vuelve a contener la copia de nuestra semilla después del DESPLAZAMIENTO.
  38+ 9E19 28 04            jr z,4F
