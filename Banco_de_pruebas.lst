 621+ B5A3
 622+ B5A3 7D           	ld a,l              							; Scanlines a "0", cambiamos de tercio. (Siempre que estemos en la última línea, LLL).
 623+ B5A4 C6 20            add a,$20           							; Vamos a comprobarlo...
 624+ B5A6 6F               ld l,a
 625+ B5A7 D8               ret c               							; Salimos si se produce el cambio de tercio.
 626+ B5A8
 627+ B5A8 7C               ld a,h              							; No estamos en la última línea del tercio, por lo que inicializamos H restando una_
 628+ B5A9 D6 08            sub 8               							; _unidad a los bits que definen el tercio TT, (sub $08).
 629+ B5AB 67               ld h,a
 630+ B5AC C9               ret
