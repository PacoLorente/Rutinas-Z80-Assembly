   1+ C02A              ; ----------------------------------------------------------
   2+ C02A              ;
   3+ C02A              ;   26/09/26
   4+ C02A              ;
   5+ C02A              ;   Voy a utilizar los 6 bytes de las variables:
   6+ C02A              ;
   7+ C02A              ;   (Indice_Sprite_der)
   8+ C02A              ;   (Indice_Sprite_izq)
   9+ C02A              ;   (Puntero_DESPLZ_der)
  10+ C02A              ;
  11+ C02A              ;   Para almacenar el perfil de la nota que está en ejecución pues la rutina se ejecuta "IN GAME TIME" y sólo reproducirá 4 ondas_
  12+ C02A              ;   _del total que forman la nota.
  13+ C02A              ;
  14+ C02A              ;   La rutina genera un "ruido" o especie de zumbido ascendente/descendente llamando a la rutina [Sound_Generator].
  15+ C02A              ;   La melodía consta de dos notas incluidas en el índice: "Game_over_noise_index:". El puntero (Puntero_game_over_noise) avanza_
  16+ C02A              ;   _ por el índice proporcionando los datos de las notas a la rutina.
  17+ C02A              ;
  18+ C02A              ;   La rutina [Sound_Generator] requiere que los parámetros de la nota a ejecutar se den de la siguiente forma:
  19+ C02A              ;
  20+ C02A              ;           C contiene el nº de veces que vamos a generar la onda del sonido.
  21+ C02A              ;           D Indica si el sonido es ascendente, "1" o descendente, "0".
  22+ C02A              ;           E Indica el nº de incrementos/decrementos que sumeremos/restaremos al delay inicial.
  23+ C02A              ;           B = "1". Indica que vamos a generar un efecto de ruido, (pseudo RND).
  24+ C02A              ;        (HL) = Contiene el sonido, (duración del semiciclo), NOTA.
  25+ C02A              ;
  26+ C02A              ;   MODIFY: AF, HL, BC y DE, (Puntero_game_over_noise).
  27+ C02A
  28+ C02A              Game_over_noise:
  29+ C02A
  30+ C02A              ;   Nota en ejecución??
  31+ C02A
  32+ C02A 21 7E 95         ld hl,Indice_Sprite_der                           ; Caja de nota en ejecución.
  33+ C02D 7E               ld a,(hl)
  34+ C02E A7               and a
  35+ C02F 28 02            jr z,New_note                                     ; Caja vacía o anterior nota finalizada. Adquiere una nueva nota del índice de notas de la canción.
  36+ C031
  37+ C031 18 0F            jr Get_note                                       ; No hemos terminado de ejecutar la nota. Recuperamos el 'resto' de la nota de la caja.
  38+ C033
  39+ C033              ;   Extrae una nueva, (o primera nota) del índice de notas de la canción.
  40+ C033
  41+ C033              New_note:
  42+ C033
  43+ C033 2A 0F 96         ld hl,(Puntero_game_over_noise)
  44+ C036 CD 3C 9E         call Extrae_address
