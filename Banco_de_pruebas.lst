  28+ A688 01 FF 02     	LD BC,767
  29+ A68B 77           	LD (HL),a						 					; Atributos de pantalla, % 00 xxx xxx en [A].
  30+ A68C ED B0        	LDIR
  31+ A68E
  32+ A68E AF           	xor a
  33+ A68F
  34+ A68F C9           	ret
